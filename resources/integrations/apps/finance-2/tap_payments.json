{
  "key": "tap_payments",
  "name": "Tap Payments",
  "category": "Payments & Finance",
  "description": "Create charges and customers, fetch charges and issue refunds with Tap.",
  "brand": "tap",
  "website": "https://www.tap.company",
  "docs_url": "https://developers.tap.company/reference/api-endpoint",
  "base_url": "https://api.tap.company/v2",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "Secret key (sk_live_… / sk_test_…)",
          "type": "password",
          "required": true,
          "help": "Dashboard > goSell > API credentials."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "create_charge",
      "name": "Create charge",
      "method": "POST",
      "endpoint": "/charges",
      "body": {
        "amount": "{{ inputs.amount }}",
        "currency": "{{ inputs.currency }}",
        "description": "{{ inputs.description }}",
        "reference": {
          "transaction": "{{ inputs.transaction_ref }}",
          "order": "{{ inputs.order_ref }}"
        },
        "receipt": {
          "email": "{{ inputs.receipt_email }}"
        },
        "customer": {
          "id": "{{ inputs.customer_id }}",
          "first_name": "{{ inputs.first_name }}",
          "last_name": "{{ inputs.last_name }}",
          "email": "{{ inputs.email }}",
          "phone": {
            "country_code": "{{ inputs.phone_country_code }}",
            "number": "{{ inputs.phone }}"
          }
        },
        "source": {
          "id": "{{ inputs.source }}"
        },
        "post": {
          "url": "{{ inputs.post_url }}"
        },
        "redirect": {
          "url": "{{ inputs.redirect_url }}"
        },
        "metadata": "{{ inputs.metadata }}"
      },
      "output_fields": {
        "url": "transaction.url"
      },
      "inputs": [
        {
          "key": "amount",
          "label": "Amount",
          "type": "number",
          "required": true
        },
        {
          "key": "currency",
          "label": "Currency",
          "type": "string",
          "required": true,
          "default": "KWD"
        },
        {
          "key": "description",
          "label": "Description",
          "type": "string"
        },
        {
          "key": "customer_id",
          "label": "Customer ID",
          "type": "string",
          "placeholder": "cus_…"
        },
        {
          "key": "first_name",
          "label": "First name",
          "type": "string"
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string"
        },
        {
          "key": "phone_country_code",
          "label": "Phone country code",
          "type": "string",
          "placeholder": "965"
        },
        {
          "key": "phone",
          "label": "Phone number",
          "type": "string"
        },
        {
          "key": "source",
          "label": "Source",
          "type": "string",
          "required": true,
          "default": "src_all",
          "help": "src_all shows every payment method on Tap's hosted page."
        },
        {
          "key": "redirect_url",
          "label": "Redirect URL",
          "type": "string",
          "required": true
        },
        {
          "key": "post_url",
          "label": "Webhook (post) URL",
          "type": "string"
        },
        {
          "key": "transaction_ref",
          "label": "Transaction reference",
          "type": "string"
        },
        {
          "key": "order_ref",
          "label": "Order reference",
          "type": "string"
        },
        {
          "key": "receipt_email",
          "label": "Email receipt",
          "type": "boolean"
        },
        {
          "key": "metadata",
          "label": "Metadata",
          "type": "keyvalue"
        }
      ]
    },
    {
      "key": "get_charge",
      "name": "Get charge",
      "method": "GET",
      "endpoint": "/charges/{{ inputs.charge_id }}",
      "inputs": [
        {
          "key": "charge_id",
          "label": "Charge ID",
          "type": "string",
          "required": true,
          "placeholder": "chg_…"
        }
      ]
    },
    {
      "key": "create_refund",
      "name": "Refund charge",
      "method": "POST",
      "endpoint": "/refunds",
      "body": {
        "charge_id": "{{ inputs.charge_id }}",
        "amount": "{{ inputs.amount }}",
        "currency": "{{ inputs.currency }}",
        "reason": "{{ inputs.reason }}",
        "post": {
          "url": "{{ inputs.post_url }}"
        }
      },
      "inputs": [
        {
          "key": "charge_id",
          "label": "Charge ID",
          "type": "string",
          "required": true
        },
        {
          "key": "amount",
          "label": "Amount",
          "type": "number",
          "required": true
        },
        {
          "key": "currency",
          "label": "Currency",
          "type": "string",
          "required": true,
          "default": "KWD"
        },
        {
          "key": "reason",
          "label": "Reason",
          "type": "string",
          "required": true,
          "default": "requested_by_customer"
        },
        {
          "key": "post_url",
          "label": "Webhook (post) URL",
          "type": "string"
        }
      ]
    },
    {
      "key": "create_customer",
      "name": "Create customer",
      "method": "POST",
      "endpoint": "/customers",
      "body": {
        "first_name": "{{ inputs.first_name }}",
        "last_name": "{{ inputs.last_name }}",
        "email": "{{ inputs.email }}",
        "phone": {
          "country_code": "{{ inputs.phone_country_code }}",
          "number": "{{ inputs.phone }}"
        },
        "currency": "{{ inputs.currency }}"
      },
      "inputs": [
        {
          "key": "first_name",
          "label": "First name",
          "type": "string",
          "required": true
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string"
        },
        {
          "key": "phone_country_code",
          "label": "Phone country code",
          "type": "string",
          "placeholder": "965"
        },
        {
          "key": "phone",
          "label": "Phone number",
          "type": "string"
        },
        {
          "key": "currency",
          "label": "Currency",
          "type": "string"
        }
      ]
    }
  ]
}
