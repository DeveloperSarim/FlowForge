{
  "key": "ordoro",
  "name": "Ordoro",
  "category": "E-commerce",
  "description": "List and look up orders and products in Ordoro.",
  "brand": "ordoro",
  "website": "https://www.ordoro.com",
  "docs_url": "https://docs.ordoro.com",
  "base_url": "https://api.ordoro.com",
  "auth": [
    {
      "type": "basic",
      "fields": [
        {
          "key": "username",
          "label": "API key (client ID)",
          "type": "string",
          "required": true,
          "help": "Settings > Account Settings > API Keys."
        },
        {
          "key": "password",
          "label": "API secret",
          "type": "password",
          "required": true
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_orders",
      "name": "List orders",
      "method": "GET",
      "endpoint": "/v3/order",
      "query": {
        "status": "{{ inputs.status }}",
        "limit": "{{ inputs.limit }}",
        "offset": "{{ inputs.offset }}"
      },
      "output_path": "order",
      "inputs": [
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "options": [
            {
              "value": "awaiting_fulfillment",
              "label": "Awaiting fulfillment"
            },
            {
              "value": "dropshipment_requested",
              "label": "Dropshipment requested"
            },
            {
              "value": "shipped",
              "label": "Shipped"
            },
            {
              "value": "cancelled",
              "label": "Cancelled"
            },
            {
              "value": "all",
              "label": "All"
            }
          ]
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "help": "Max 100."
        },
        {
          "key": "offset",
          "label": "Offset",
          "type": "number"
        }
      ]
    },
    {
      "key": "get_order",
      "name": "Get order",
      "method": "GET",
      "endpoint": "/v3/order/{{ inputs.order_number }}",
      "inputs": [
        {
          "key": "order_number",
          "label": "Order number",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_products",
      "name": "List products",
      "method": "GET",
      "endpoint": "/product/",
      "query": {
        "limit": "{{ inputs.limit }}",
        "offset": "{{ inputs.offset }}"
      },
      "output_path": "product",
      "inputs": [
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50
        },
        {
          "key": "offset",
          "label": "Offset",
          "type": "number"
        }
      ]
    }
  ]
}
