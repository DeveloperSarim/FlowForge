{
  "key": "cutout_pro",
  "name": "Cutout.Pro",
  "category": "Video & Media",
  "description": "Remove the background from an image URL; returns a base64 PNG.",
  "brand": "cutoutpro",
  "website": "https://www.cutout.pro",
  "docs_url": "https://www.cutout.pro/api-document/bg-remover",
  "base_url": "https://www.cutout.pro/api/v1",
  "auth": { "type": "api_key", "in": "header", "name": "APIKEY" },
  "actions": [
    {
      "key": "remove_background",
      "name": "Remove background",
      "description": "Returns data.imageBase64.",
      "method": "GET",
      "endpoint": "/mattingByUrl",
      "timeout": 60,
      "query": { "mattingType": 6, "url": "{{ inputs.url }}", "bgcolor": "{{ inputs.bgcolor }}" },
      "inputs": [
        { "key": "url", "label": "Image URL", "type": "string", "required": true },
        { "key": "bgcolor", "label": "Background colour (hex)", "type": "string", "placeholder": "FFFFFF", "help": "Leave empty for a transparent background." }
      ]
    }
  ]
}
