{
  "key": "outscraper",
  "name": "Outscraper",
  "category": "Ads & SEO",
  "description": "Scrape Google search results, Google Maps places and contact emails.",
  "website": "https://outscraper.com",
  "docs_url": "https://app.outscraper.com/api-docs",
  "base_url": "https://api.app.outscraper.com",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "X-API-KEY",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Outscraper → Profile → API usage → copy your API key."
      }
    ]
  },
  "actions": [
    {
      "key": "google_search",
      "name": "Google search",
      "description": "Organic results for a query.",
      "method": "GET",
      "endpoint": "/google-search-v3",
      "query": {
        "query": "{{ inputs.q }}",
        "pagesPerQuery": "1",
        "async": "false"
      },
      "output_fields": {
        "status": "status",
        "results": "data.0.0.organic_results"
      },
      "inputs": [
        {
          "key": "q",
          "label": "Search query",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "maps_search",
      "name": "Google Maps search",
      "description": "Businesses on Google Maps (e.g. \"dentists, Austin\").",
      "method": "GET",
      "endpoint": "/maps/search-v3",
      "query": {
        "query": "{{ inputs.q }}",
        "limit": "{{ inputs.limit }}",
        "async": "false"
      },
      "output_fields": {
        "status": "status",
        "places": "data.0"
      },
      "inputs": [
        {
          "key": "q",
          "label": "Search query",
          "type": "string",
          "required": true
        },
        {
          "key": "limit",
          "label": "Max places",
          "type": "number",
          "default": 20
        }
      ]
    },
    {
      "key": "emails_contacts",
      "name": "Emails and contacts",
      "description": "Find emails and social links for websites.",
      "method": "GET",
      "endpoint": "/emails-and-contacts",
      "query": {
        "query": "{{ inputs.query }}",
        "async": "false"
      },
      "output_fields": {
        "status": "status",
        "contacts": "data.0"
      },
      "inputs": [
        {
          "key": "query",
          "label": "Website or domain",
          "type": "string",
          "required": true,
          "placeholder": "example.com"
        }
      ]
    }
  ]
}
