{
  "key": "moyasar",
  "name": "Moyasar",
  "category": "Payments & Finance",
  "description": "Create invoices, list payments and refund them with Moyasar.",
  "brand": "moyasar",
  "website": "https://moyasar.com",
  "docs_url": "https://docs.moyasar.com/api/",
  "base_url": "https://api.moyasar.com/v1",
  "auth": [
    {
      "type": "basic",
      "fields": [
        {
          "key": "username",
          "label": "Secret key (sk_…)",
          "type": "password",
          "required": true,
          "help": "Dashboard > Settings > API keys."
        },
        {
          "key": "password",
          "label": "Password",
          "type": "password",
          "required": false,
          "default": "",
          "help": "Leave blank."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "create_invoice",
      "name": "Create invoice",
      "method": "POST",
      "endpoint": "/invoices",
      "body": {
        "amount": "{{ inputs.amount }}",
        "currency": "{{ inputs.currency }}",
        "description": "{{ inputs.description }}",
        "callback_url": "{{ inputs.callback_url }}",
        "success_url": "{{ inputs.success_url }}",
        "back_url": "{{ inputs.back_url }}",
        "expired_at": "{{ inputs.expired_at }}",
        "metadata": "{{ inputs.metadata }}"
      },
      "output_fields": {
        "url": "url"
      },
      "inputs": [
        {
          "key": "amount",
          "label": "Amount (halalas)",
          "type": "number",
          "required": true,
          "help": "1000 = 10.00 SAR."
        },
        {
          "key": "currency",
          "label": "Currency",
          "type": "string",
          "required": true,
          "default": "SAR"
        },
        {
          "key": "description",
          "label": "Description",
          "type": "string",
          "required": true
        },
        {
          "key": "callback_url",
          "label": "Callback URL",
          "type": "string"
        },
        {
          "key": "success_url",
          "label": "Success URL",
          "type": "string"
        },
        {
          "key": "back_url",
          "label": "Back URL",
          "type": "string"
        },
        {
          "key": "expired_at",
          "label": "Expires at",
          "type": "string",
          "placeholder": "2026-12-31T23:59:59Z"
        },
        {
          "key": "metadata",
          "label": "Metadata",
          "type": "keyvalue"
        }
      ]
    },
    {
      "key": "get_invoice",
      "name": "Get invoice",
      "method": "GET",
      "endpoint": "/invoices/{{ inputs.invoice_id }}",
      "inputs": [
        {
          "key": "invoice_id",
          "label": "Invoice ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_payments",
      "name": "List payments",
      "method": "GET",
      "endpoint": "/payments",
      "query": {
        "page": "{{ inputs.page }}",
        "status": "{{ inputs.status }}"
      },
      "output_path": "payments",
      "inputs": [
        {
          "key": "page",
          "label": "Page",
          "type": "number"
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "options": [
            {
              "value": "paid",
              "label": "Paid"
            },
            {
              "value": "initiated",
              "label": "Initiated"
            },
            {
              "value": "failed",
              "label": "Failed"
            },
            {
              "value": "authorized",
              "label": "Authorized"
            },
            {
              "value": "captured",
              "label": "Captured"
            },
            {
              "value": "refunded",
              "label": "Refunded"
            },
            {
              "value": "voided",
              "label": "Voided"
            }
          ]
        }
      ]
    },
    {
      "key": "get_payment",
      "name": "Get payment",
      "method": "GET",
      "endpoint": "/payments/{{ inputs.payment_id }}",
      "inputs": [
        {
          "key": "payment_id",
          "label": "Payment ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "refund_payment",
      "name": "Refund payment",
      "method": "POST",
      "endpoint": "/payments/{{ inputs.payment_id }}/refund",
      "body": {
        "amount": "{{ inputs.amount }}"
      },
      "inputs": [
        {
          "key": "payment_id",
          "label": "Payment ID",
          "type": "string",
          "required": true
        },
        {
          "key": "amount",
          "label": "Amount (halalas)",
          "type": "number",
          "help": "Blank = full refund."
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "Dashboard > Settings > Webhooks: add this URL and select events.",
      "data_path": "data",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
