{
  "key": "indexnow",
  "name": "IndexNow",
  "category": "Ads & SEO",
  "description": "Tell Bing, Yandex and others instantly when your pages are new or changed.",
  "website": "https://www.indexnow.org",
  "docs_url": "https://www.indexnow.org/documentation",
  "base_url": "https://api.indexnow.org",
  "auth": {
    "type": "none",
    "fields": []
  },
  "actions": [
    {
      "key": "submit_urls",
      "name": "Submit URLs",
      "description": "Notify search engines about up to 10,000 changed URLs on one site.",
      "method": "POST",
      "endpoint": "/IndexNow",
      "body": {
        "host": "{{ inputs.host }}",
        "key": "{{ inputs.key }}",
        "keyLocation": "https://{{ inputs.host }}/{{ inputs.key }}.txt",
        "urlList": "{{ inputs.urls }}"
      },
      "inputs": [
        {
          "key": "host",
          "label": "Your domain",
          "type": "string",
          "required": true,
          "placeholder": "www.example.com"
        },
        {
          "key": "key",
          "label": "IndexNow key",
          "type": "string",
          "required": true,
          "help": "Make up a key (8-128 letters/numbers) and host it as a .txt file at your site root named <key>.txt."
        },
        {
          "key": "urls",
          "label": "URLs",
          "type": "list",
          "required": true,
          "help": "Full page URLs on that domain."
        }
      ]
    },
    {
      "key": "submit_url",
      "name": "Submit one URL",
      "description": "Notify search engines about one changed URL.",
      "method": "GET",
      "endpoint": "/IndexNow",
      "query": {
        "url": "{{ inputs.url }}",
        "key": "{{ inputs.key }}"
      },
      "inputs": [
        {
          "key": "url",
          "label": "Page URL",
          "type": "string",
          "required": true
        },
        {
          "key": "key",
          "label": "IndexNow key",
          "type": "string",
          "required": true,
          "help": "The key whose <key>.txt file is hosted at your site root."
        }
      ]
    }
  ]
}
