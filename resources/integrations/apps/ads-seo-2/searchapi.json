{
  "key": "searchapi",
  "name": "SearchApi",
  "category": "Ads & SEO",
  "description": "SERP API: Google, Google News, Maps, YouTube and Bing results as JSON.",
  "website": "https://www.searchapi.io",
  "docs_url": "https://www.searchapi.io/docs/google",
  "base_url": "https://www.searchapi.io/api/v1",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "SearchApi dashboard → copy your API key."
      }
    ]
  },
  "actions": [
    {
      "key": "google_search",
      "name": "Google search",
      "description": "Organic Google results.",
      "method": "GET",
      "endpoint": "/search",
      "query": {
        "engine": "google",
        "q": "{{ inputs.q }}",
        "location": "{{ inputs.location }}",
        "gl": "{{ inputs.gl }}",
        "num": "{{ inputs.num }}"
      },
      "output_fields": {
        "results": "organic_results",
        "first_title": "organic_results.0.title",
        "first_link": "organic_results.0.link",
        "related_searches": "related_searches"
      },
      "inputs": [
        {
          "key": "q",
          "label": "Search query",
          "type": "string",
          "required": true
        },
        {
          "key": "location",
          "label": "Location",
          "type": "string",
          "help": "e.g. \"United States\" or \"Austin,Texas\". Leave empty for default."
        },
        {
          "key": "gl",
          "label": "Country code",
          "type": "string",
          "help": "Two letters, e.g. us."
        },
        {
          "key": "num",
          "label": "Results",
          "type": "number",
          "default": 10
        }
      ]
    },
    {
      "key": "google_news",
      "name": "Google News",
      "description": "News results for a query.",
      "method": "GET",
      "endpoint": "/search",
      "query": {
        "engine": "google_news",
        "q": "{{ inputs.q }}"
      },
      "output_fields": {
        "results": "organic_results"
      },
      "inputs": [
        {
          "key": "q",
          "label": "Search query",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "google_maps",
      "name": "Google Maps",
      "description": "Local businesses for a query.",
      "method": "GET",
      "endpoint": "/search",
      "query": {
        "engine": "google_maps",
        "q": "{{ inputs.q }}"
      },
      "output_fields": {
        "places": "local_results"
      },
      "inputs": [
        {
          "key": "q",
          "label": "Search query",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "youtube_search",
      "name": "YouTube search",
      "description": "Videos for a query.",
      "method": "GET",
      "endpoint": "/search",
      "query": {
        "engine": "youtube",
        "q": "{{ inputs.q }}"
      },
      "output_fields": {
        "videos": "videos"
      },
      "inputs": [
        {
          "key": "q",
          "label": "Search query",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
