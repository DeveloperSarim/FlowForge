{
  "key": "gem",
  "name": "Gem",
  "category": "HR & Recruiting",
  "description": "Read candidates, projects and recruiters from Gem, the recruiting CRM.",
  "website": "https://www.gem.com",
  "docs_url": "https://api.gem.com/v0/reference",
  "base_url": "https://api.gem.com/v0",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "X-API-Key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "In Gem go to Settings → Integrations → API → Generate API key."
      }
    ]
  },
  "actions": [
    {
      "key": "list_candidates",
      "name": "List candidates",
      "description": "List candidates, most recently created first.",
      "method": "GET",
      "endpoint": "/candidates",
      "query": {
        "page_size": "{{ inputs.limit }}",
        "email": "{{ inputs.email }}",
        "sort": "desc"
      },
      "output_fields": {
        "first_id": "0.id",
        "first_name": "0.first_name",
        "first_email": "0.emails.0.email_address"
      },
      "inputs": [
        {
          "key": "limit",
          "label": "How many",
          "type": "number",
          "default": 50
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "help": "Only candidates with this email."
        }
      ]
    },
    {
      "key": "get_candidate",
      "name": "Get candidate",
      "description": "Read one candidate.",
      "method": "GET",
      "endpoint": "/candidates/{{ inputs.candidate_id }}",
      "output_fields": {
        "id": "id",
        "first_name": "first_name",
        "last_name": "last_name",
        "title": "title",
        "company": "company"
      },
      "inputs": [
        {
          "key": "candidate_id",
          "label": "Candidate ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_projects",
      "name": "List projects",
      "description": "List recruiting projects (talent pools).",
      "method": "GET",
      "endpoint": "/projects",
      "query": {
        "page_size": "{{ inputs.limit }}"
      },
      "output_fields": {
        "first_id": "0.id",
        "first_name": "0.name"
      },
      "inputs": [
        {
          "key": "limit",
          "label": "How many",
          "type": "number",
          "default": 50
        }
      ]
    },
    {
      "key": "list_users",
      "name": "List users",
      "description": "List recruiters and users in your Gem account.",
      "method": "GET",
      "endpoint": "/users",
      "query": {
        "page_size": "{{ inputs.limit }}"
      },
      "output_fields": {
        "first_id": "0.id",
        "first_email": "0.email"
      },
      "inputs": [
        {
          "key": "limit",
          "label": "How many",
          "type": "number",
          "default": 50
        }
      ]
    }
  ]
}
