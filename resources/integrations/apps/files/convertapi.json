{
  "key": "convertapi",
  "name": "ConvertAPI",
  "category": "Files & Documents",
  "description": "Convert documents, spreadsheets and images between formats.",
  "brand": "convertapi",
  "website": "https://www.convertapi.com",
  "docs_url": "https://docs.convertapi.com/",
  "base_url": "https://v2.convertapi.com",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "API token",
          "type": "password",
          "required": true
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "convert",
      "name": "Convert file from URL",
      "method": "POST",
      "endpoint": "/convert/{{ inputs.from }}/to/{{ inputs.to }}",
      "body": {
        "Parameters": [
          {
            "Name": "File",
            "FileValue": {
              "Url": "{{ inputs.url }}"
            }
          },
          {
            "Name": "StoreFile",
            "Value": true
          }
        ]
      },
      "output_fields": {
        "file_url": "Files.0.Url"
      },
      "timeout": 120,
      "inputs": [
        {
          "key": "url",
          "label": "File URL",
          "type": "string",
          "required": true
        },
        {
          "key": "from",
          "label": "From format",
          "type": "string",
          "required": true,
          "placeholder": "docx"
        },
        {
          "key": "to",
          "label": "To format",
          "type": "string",
          "required": true,
          "placeholder": "pdf"
        }
      ]
    },
    {
      "key": "get_user",
      "name": "Get account info",
      "method": "GET",
      "endpoint": "/user",
      "inputs": []
    }
  ]
}
