{
  "key": "google_books",
  "name": "Google Books",
  "category": "Utilities",
  "description": "Search books by title, author or ISBN and get book details.",
  "brand": "googlebooks",
  "website": "https://books.google.com",
  "docs_url": "https://developers.google.com/books/docs/v1/using",
  "base_url": "https://www.googleapis.com/books/v1",
  "auth": { "type": "api_key", "in": "query", "name": "key", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true, "help": "Google Cloud console → Credentials, with the Books API enabled." }
  ] },
  "actions": [
    {
      "key": "search_books",
      "name": "Search books",
      "method": "GET",
      "endpoint": "/volumes",
      "query": { "q": "{{ inputs.q }}", "maxResults": "{{ inputs.max_results }}", "startIndex": "{{ inputs.start_index }}", "orderBy": "{{ inputs.order_by }}", "printType": "{{ inputs.print_type }}", "langRestrict": "{{ inputs.lang }}" },
      "output_path": "items",
      "inputs": [
        { "key": "q", "label": "Search", "type": "string", "required": true, "placeholder": "intitle:dune inauthor:herbert", "help": "Supports intitle:, inauthor:, inpublisher:, subject: and isbn:." },
        { "key": "max_results", "label": "Max results", "type": "number", "default": 10, "help": "Max 40." },
        { "key": "start_index", "label": "Start index", "type": "number" },
        { "key": "order_by", "label": "Sort", "type": "select", "default": "relevance", "options": [{ "value": "relevance", "label": "Relevance" }, { "value": "newest", "label": "Newest" }] },
        { "key": "print_type", "label": "Type", "type": "select", "default": "all", "options": [{ "value": "all", "label": "All" }, { "value": "books", "label": "Books" }, { "value": "magazines", "label": "Magazines" }] },
        { "key": "lang", "label": "Language", "type": "string", "placeholder": "en" }
      ]
    },
    {
      "key": "get_book",
      "name": "Get book",
      "method": "GET",
      "endpoint": "/volumes/{{ inputs.volume_id }}",
      "inputs": [{ "key": "volume_id", "label": "Volume ID", "type": "string", "required": true, "placeholder": "zyTCAlFPjgYC" }]
    }
  ]
}
