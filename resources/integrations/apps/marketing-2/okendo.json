{
  "key": "okendo",
  "name": "Okendo",
  "category": "Marketing & Email",
  "description": "Read your store's published Okendo product reviews.",
  "brand": "okendo",
  "website": "https://www.okendo.io",
  "docs_url": "https://docs.okendo.io/",
  "base_url": "https://api.okendo.io/v1",
  "auth": {
    "type": "none"
  },
  "actions": [
    {
      "key": "list_store_reviews",
      "name": "List store reviews",
      "method": "GET",
      "endpoint": "/stores/{{ inputs.subscriber_id }}/reviews",
      "query": {
        "limit": "{{ inputs.limit }}"
      },
      "inputs": [
        {
          "key": "subscriber_id",
          "label": "Store (subscriber) ID",
          "type": "string",
          "required": true,
          "help": "Okendo admin > Settings > Integrations > API."
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 25
        }
      ],
      "output_path": "reviews"
    }
  ]
}