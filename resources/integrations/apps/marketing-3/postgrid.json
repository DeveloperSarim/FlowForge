{
  "key": "postgrid",
  "name": "PostGrid",
  "category": "Marketing & Email",
  "description": "Send letters and postcards by mail and keep a contact address book.",
  "website": "https://www.postgrid.com",
  "docs_url": "https://docs.postgrid.com/",
  "base_url": "https://api.postgrid.com/print-mail/v1",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "x-api-key",
    "fields": [
      {
        "key": "api_key",
        "label": "Print & Mail API key",
        "type": "password",
        "required": true,
        "help": "PostGrid dashboard → Settings → API Keys. Test keys (test_sk_…) never mail anything; live keys (live_sk_…) do."
      }
    ]
  },
  "actions": [
    {
      "key": "create_contact",
      "name": "Create contact",
      "description": "Save a recipient or sender address.",
      "method": "POST",
      "endpoint": "/contacts",
      "body": {
        "firstName": "{{ inputs.first_name }}",
        "lastName": "{{ inputs.last_name }}",
        "companyName": "{{ inputs.company_name }}",
        "email": "{{ inputs.email }}",
        "phoneNumber": "{{ inputs.phone }}",
        "addressLine1": "{{ inputs.address_line1 }}",
        "addressLine2": "{{ inputs.address_line2 }}",
        "city": "{{ inputs.city }}",
        "provinceOrState": "{{ inputs.state }}",
        "postalOrZip": "{{ inputs.zip }}",
        "countryCode": "{{ inputs.country }}"
      },
      "output_fields": {
        "id": "id",
        "address_status": "addressStatus"
      },
      "inputs": [
        {
          "key": "first_name",
          "label": "First name",
          "type": "string",
          "help": "Fill the first name or the company name."
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "company_name",
          "label": "Company",
          "type": "string"
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string"
        },
        {
          "key": "phone",
          "label": "Phone",
          "type": "string"
        },
        {
          "key": "address_line1",
          "label": "Street address",
          "type": "string",
          "required": true
        },
        {
          "key": "address_line2",
          "label": "Apartment, suite, unit",
          "type": "string"
        },
        {
          "key": "city",
          "label": "City",
          "type": "string"
        },
        {
          "key": "state",
          "label": "State / province",
          "type": "string"
        },
        {
          "key": "zip",
          "label": "ZIP / postal code",
          "type": "string"
        },
        {
          "key": "country",
          "label": "Country code",
          "type": "string",
          "required": true,
          "default": "US",
          "help": "Two-letter code, e.g. US, CA, GB."
        }
      ]
    },
    {
      "key": "send_letter",
      "name": "Send letter",
      "description": "Print and mail an HTML letter.",
      "method": "POST",
      "endpoint": "/letters",
      "body": {
        "to": {
          "firstName": "{{ inputs.to_first_name }}",
          "lastName": "{{ inputs.to_last_name }}",
          "companyName": "{{ inputs.to_company }}",
          "addressLine1": "{{ inputs.to_address_line1 }}",
          "addressLine2": "{{ inputs.to_address_line2 }}",
          "city": "{{ inputs.to_city }}",
          "provinceOrState": "{{ inputs.to_state }}",
          "postalOrZip": "{{ inputs.to_zip }}",
          "countryCode": "{{ inputs.to_country }}"
        },
        "from": {
          "companyName": "{{ inputs.from_name }}",
          "addressLine1": "{{ inputs.from_address_line1 }}",
          "city": "{{ inputs.from_city }}",
          "provinceOrState": "{{ inputs.from_state }}",
          "postalOrZip": "{{ inputs.from_zip }}",
          "countryCode": "{{ inputs.from_country }}"
        },
        "html": "{{ inputs.html }}",
        "template": "{{ inputs.template }}",
        "color": "{{ inputs.color }}",
        "doubleSided": "{{ inputs.double_sided }}",
        "mergeVariables": "{{ inputs.merge_variables }}",
        "description": "{{ inputs.description }}",
        "sendDate": "{{ inputs.send_date }}"
      },
      "output_fields": {
        "id": "id",
        "status": "status",
        "send_date": "sendDate"
      },
      "inputs": [
        {
          "key": "to_first_name",
          "label": "Recipient first name",
          "type": "string",
          "help": "Fill the first name or the company."
        },
        {
          "key": "to_last_name",
          "label": "Recipient last name",
          "type": "string"
        },
        {
          "key": "to_company",
          "label": "Recipient company",
          "type": "string"
        },
        {
          "key": "to_address_line1",
          "label": "Street address",
          "type": "string",
          "required": true
        },
        {
          "key": "to_address_line2",
          "label": "Apartment, suite, unit",
          "type": "string"
        },
        {
          "key": "to_city",
          "label": "City",
          "type": "string"
        },
        {
          "key": "to_state",
          "label": "State / province",
          "type": "string"
        },
        {
          "key": "to_zip",
          "label": "ZIP / postal code",
          "type": "string"
        },
        {
          "key": "to_country",
          "label": "Country code",
          "type": "string",
          "required": true,
          "default": "US"
        },
        {
          "key": "from_name",
          "label": "Your name or business",
          "type": "string",
          "required": true
        },
        {
          "key": "from_address_line1",
          "label": "Your street address",
          "type": "string",
          "required": true
        },
        {
          "key": "from_city",
          "label": "Your city",
          "type": "string"
        },
        {
          "key": "from_state",
          "label": "Your state / province",
          "type": "string"
        },
        {
          "key": "from_zip",
          "label": "Your ZIP / postal code",
          "type": "string"
        },
        {
          "key": "from_country",
          "label": "Your country code",
          "type": "string",
          "required": true,
          "default": "US"
        },
        {
          "key": "html",
          "label": "Letter (HTML)",
          "type": "text",
          "help": "Fill this or a template ID."
        },
        {
          "key": "template",
          "label": "Template ID",
          "type": "string",
          "placeholder": "template_…",
          "help": "Optional: a template designed in PostGrid → Templates. Its merge fields are filled from Merge variables."
        },
        {
          "key": "color",
          "label": "Print in color",
          "type": "boolean",
          "default": false
        },
        {
          "key": "double_sided",
          "label": "Double-sided",
          "type": "boolean",
          "default": false
        },
        {
          "key": "merge_variables",
          "label": "Merge variables",
          "type": "keyvalue"
        },
        {
          "key": "send_date",
          "label": "Send on",
          "type": "string",
          "placeholder": "2026-12-01",
          "help": "Optional. Leave empty to send as soon as possible."
        },
        {
          "key": "description",
          "label": "Internal description",
          "type": "string"
        }
      ]
    },
    {
      "key": "send_postcard",
      "name": "Send postcard",
      "description": "Print and mail a postcard from HTML.",
      "method": "POST",
      "endpoint": "/postcards",
      "body": {
        "to": {
          "firstName": "{{ inputs.to_first_name }}",
          "lastName": "{{ inputs.to_last_name }}",
          "companyName": "{{ inputs.to_company }}",
          "addressLine1": "{{ inputs.to_address_line1 }}",
          "addressLine2": "{{ inputs.to_address_line2 }}",
          "city": "{{ inputs.to_city }}",
          "provinceOrState": "{{ inputs.to_state }}",
          "postalOrZip": "{{ inputs.to_zip }}",
          "countryCode": "{{ inputs.to_country }}"
        },
        "size": "{{ inputs.size }}",
        "frontHTML": "{{ inputs.front_html }}",
        "backHTML": "{{ inputs.back_html }}",
        "mergeVariables": "{{ inputs.merge_variables }}",
        "description": "{{ inputs.description }}"
      },
      "output_fields": {
        "id": "id",
        "status": "status",
        "send_date": "sendDate"
      },
      "inputs": [
        {
          "key": "to_first_name",
          "label": "Recipient first name",
          "type": "string",
          "help": "Fill the first name or the company."
        },
        {
          "key": "to_last_name",
          "label": "Recipient last name",
          "type": "string"
        },
        {
          "key": "to_company",
          "label": "Recipient company",
          "type": "string"
        },
        {
          "key": "to_address_line1",
          "label": "Street address",
          "type": "string",
          "required": true
        },
        {
          "key": "to_address_line2",
          "label": "Apartment, suite, unit",
          "type": "string"
        },
        {
          "key": "to_city",
          "label": "City",
          "type": "string"
        },
        {
          "key": "to_state",
          "label": "State / province",
          "type": "string"
        },
        {
          "key": "to_zip",
          "label": "ZIP / postal code",
          "type": "string"
        },
        {
          "key": "to_country",
          "label": "Country code",
          "type": "string",
          "required": true,
          "default": "US"
        },
        {
          "key": "size",
          "label": "Size",
          "type": "select",
          "required": true,
          "default": "6x4",
          "options": [
            {
              "value": "6x4",
              "label": "6 × 4 in"
            },
            {
              "value": "9x6",
              "label": "9 × 6 in"
            },
            {
              "value": "11x6",
              "label": "11 × 6 in"
            }
          ]
        },
        {
          "key": "front_html",
          "label": "Front (HTML)",
          "type": "text",
          "required": true
        },
        {
          "key": "back_html",
          "label": "Back (HTML)",
          "type": "text",
          "required": true
        },
        {
          "key": "merge_variables",
          "label": "Merge variables",
          "type": "keyvalue"
        },
        {
          "key": "description",
          "label": "Internal description",
          "type": "string"
        }
      ]
    },
    {
      "key": "get_letter",
      "name": "Get letter",
      "description": "Check the status of a letter.",
      "method": "GET",
      "endpoint": "/letters/{{ inputs.id }}",
      "output_fields": {
        "id": "id",
        "status": "status",
        "send_date": "sendDate",
        "tracking_number": "trackingNumber"
      },
      "inputs": [
        {
          "key": "id",
          "label": "Letter ID",
          "type": "string",
          "required": true,
          "placeholder": "letter_…",
          "help": "The ID returned by \"Send letter\"."
        }
      ]
    },
    {
      "key": "cancel_letter",
      "name": "Cancel letter",
      "description": "Cancel a letter before it is printed.",
      "method": "DELETE",
      "endpoint": "/letters/{{ inputs.id }}",
      "output_fields": {
        "id": "id",
        "status": "status"
      },
      "inputs": [
        {
          "key": "id",
          "label": "Letter ID",
          "type": "string",
          "required": true,
          "placeholder": "letter_…"
        }
      ]
    },
    {
      "key": "list_letters",
      "name": "List letters",
      "description": "Letters you have sent, newest first.",
      "method": "GET",
      "endpoint": "/letters",
      "query": {
        "limit": "{{ inputs.limit }}",
        "search": "{{ inputs.search }}"
      },
      "output_fields": {
        "letters": "data",
        "total": "totalCount"
      },
      "inputs": [
        {
          "key": "limit",
          "label": "How many",
          "type": "number",
          "default": 10
        },
        {
          "key": "search",
          "label": "Search",
          "type": "string"
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json",
          "help": "PostGrid dashboard → Webhooks → add this URL and pick events such as letter.updated."
        }
      ]
    }
  ]
}
