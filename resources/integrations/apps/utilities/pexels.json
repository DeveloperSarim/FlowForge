{
  "key": "pexels",
  "name": "Pexels",
  "category": "Utilities",
  "description": "Search free stock photos and videos.",
  "brand": "pexels",
  "website": "https://www.pexels.com",
  "docs_url": "https://www.pexels.com/api/documentation/",
  "base_url": "https://api.pexels.com",
  "auth": { "type": "api_key", "in": "header", "name": "Authorization", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true, "help": "From pexels.com/api." }
  ] },
  "actions": [
    {
      "key": "search_photos",
      "name": "Search photos",
      "method": "GET",
      "endpoint": "/v1/search",
      "query": { "query": "{{ inputs.query }}", "orientation": "{{ inputs.orientation }}", "size": "{{ inputs.size }}", "color": "{{ inputs.color }}", "locale": "{{ inputs.locale }}", "per_page": "{{ inputs.per_page }}", "page": "{{ inputs.page }}" },
      "output_path": "photos",
      "inputs": [
        { "key": "query", "label": "Search", "type": "string", "required": true, "placeholder": "ocean" },
        { "key": "orientation", "label": "Orientation", "type": "select", "options": [
          { "value": "", "label": "Any" }, { "value": "landscape", "label": "Landscape" }, { "value": "portrait", "label": "Portrait" }, { "value": "square", "label": "Square" }
        ] },
        { "key": "size", "label": "Minimum size", "type": "select", "options": [
          { "value": "", "label": "Any" }, { "value": "large", "label": "Large (24MP)" }, { "value": "medium", "label": "Medium (12MP)" }, { "value": "small", "label": "Small (4MP)" }
        ] },
        { "key": "color", "label": "Color", "type": "string", "placeholder": "red or #ffffff" },
        { "key": "locale", "label": "Locale", "type": "string", "placeholder": "en-US" },
        { "key": "per_page", "label": "Per page", "type": "number", "default": 15, "help": "Max 80." },
        { "key": "page", "label": "Page", "type": "number" }
      ]
    },
    {
      "key": "curated_photos",
      "name": "Get curated photos",
      "method": "GET",
      "endpoint": "/v1/curated",
      "query": { "per_page": "{{ inputs.per_page }}", "page": "{{ inputs.page }}" },
      "output_path": "photos",
      "inputs": [
        { "key": "per_page", "label": "Per page", "type": "number", "default": 15 },
        { "key": "page", "label": "Page", "type": "number" }
      ]
    },
    {
      "key": "get_photo",
      "name": "Get photo",
      "method": "GET",
      "endpoint": "/v1/photos/{{ inputs.photo_id }}",
      "inputs": [{ "key": "photo_id", "label": "Photo ID", "type": "string", "required": true }]
    },
    {
      "key": "search_videos",
      "name": "Search videos",
      "method": "GET",
      "endpoint": "/videos/search",
      "query": { "query": "{{ inputs.query }}", "orientation": "{{ inputs.orientation }}", "size": "{{ inputs.size }}", "per_page": "{{ inputs.per_page }}", "page": "{{ inputs.page }}" },
      "output_path": "videos",
      "inputs": [
        { "key": "query", "label": "Search", "type": "string", "required": true },
        { "key": "orientation", "label": "Orientation", "type": "select", "options": [
          { "value": "", "label": "Any" }, { "value": "landscape", "label": "Landscape" }, { "value": "portrait", "label": "Portrait" }, { "value": "square", "label": "Square" }
        ] },
        { "key": "size", "label": "Minimum size", "type": "select", "options": [
          { "value": "", "label": "Any" }, { "value": "large", "label": "Large (4K)" }, { "value": "medium", "label": "Medium (Full HD)" }, { "value": "small", "label": "Small (HD)" }
        ] },
        { "key": "per_page", "label": "Per page", "type": "number", "default": 15 },
        { "key": "page", "label": "Page", "type": "number" }
      ]
    }
  ]
}
