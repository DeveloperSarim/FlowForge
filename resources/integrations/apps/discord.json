{
  "key": "discord",
  "name": "Discord",
  "category": "Communication",
  "description": "Post to a channel through an incoming webhook URL.",
  "actions": [
    {
      "key": "webhook_message",
      "name": "Send webhook message",
      "method": "POST",
      "endpoint": "{{ inputs.webhook_url }}",
      "query": { "wait": "true" },
      "body": { "content": "{{ inputs.content }}", "username": "{{ inputs.username }}" },
      "inputs": [
        { "key": "webhook_url", "label": "Webhook URL", "type": "password", "required": true, "help": "Channel settings → Integrations → Webhooks." },
        { "key": "content", "label": "Message", "type": "text", "required": true },
        { "key": "username", "label": "Display name override", "type": "string" }
      ]
    }
  ]
}
