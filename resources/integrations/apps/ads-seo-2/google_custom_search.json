{
  "key": "google_custom_search",
  "name": "Google Custom Search",
  "category": "Ads & SEO",
  "description": "Run Google web or image searches through a Programmable Search Engine.",
  "website": "https://programmablesearchengine.google.com",
  "docs_url": "https://developers.google.com/custom-search/v1/overview",
  "base_url": "https://www.googleapis.com/customsearch",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Google Cloud Console → APIs & Services → Credentials → create an API key and enable \"Custom Search API\"."
      }
    ]
  },
  "actions": [
    {
      "key": "web_search",
      "name": "Web search",
      "description": "Search the web (or your own site) and get titles, links and snippets.",
      "method": "GET",
      "endpoint": "/v1",
      "query": {
        "q": "{{ inputs.q }}",
        "cx": "{{ inputs.cx }}",
        "num": "{{ inputs.num }}",
        "start": "{{ inputs.start }}"
      },
      "output_fields": {
        "items": "items",
        "total_results": "searchInformation.totalResults",
        "first_title": "items.0.title",
        "first_link": "items.0.link"
      },
      "inputs": [
        {
          "key": "q",
          "label": "Search query",
          "type": "string",
          "required": true
        },
        {
          "key": "cx",
          "label": "Search engine ID",
          "type": "string",
          "required": true,
          "help": "Programmable Search Engine control panel → your engine → \"Search engine ID\"."
        },
        {
          "key": "num",
          "label": "Results (1-10)",
          "type": "number",
          "default": 10
        },
        {
          "key": "start",
          "label": "Start at result",
          "type": "number",
          "default": 1
        }
      ]
    },
    {
      "key": "image_search",
      "name": "Image search",
      "description": "Search for images.",
      "method": "GET",
      "endpoint": "/v1",
      "query": {
        "q": "{{ inputs.q }}",
        "cx": "{{ inputs.cx }}",
        "num": "{{ inputs.num }}",
        "searchType": "image"
      },
      "output_fields": {
        "items": "items",
        "first_image": "items.0.link"
      },
      "inputs": [
        {
          "key": "q",
          "label": "Search query",
          "type": "string",
          "required": true
        },
        {
          "key": "cx",
          "label": "Search engine ID",
          "type": "string",
          "required": true,
          "help": "Programmable Search Engine control panel → \"Search engine ID\"."
        },
        {
          "key": "num",
          "label": "Results (1-10)",
          "type": "number",
          "default": 10
        }
      ]
    }
  ]
}
