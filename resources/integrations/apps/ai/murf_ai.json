{
  "key": "murf_ai",
  "name": "Murf AI",
  "category": "AI",
  "description": "Generate voice-overs from text with Murf voices.",
  "brand": "murf",
  "website": "https://murf.ai",
  "docs_url": "https://murf.ai/api/docs/introduction/overview",
  "base_url": "https://api.murf.ai/v1",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "api-key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "generate_speech",
      "name": "Generate speech",
      "method": "POST",
      "endpoint": "/speech/generate",
      "timeout": 120,
      "body": {
        "text": "{{ inputs.text }}",
        "voiceId": "{{ inputs.voice_id }}",
        "format": "{{ inputs.format }}"
      },
      "output_fields": {
        "audio_url": "audioFile"
      },
      "inputs": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "required": true
        },
        {
          "key": "voice_id",
          "label": "Voice ID",
          "type": "string",
          "required": true,
          "default": "en-US-natalie"
        },
        {
          "key": "format",
          "label": "Format",
          "type": "select",
          "options": [
            {
              "value": "MP3",
              "label": "MP3"
            },
            {
              "value": "WAV",
              "label": "WAV"
            },
            {
              "value": "FLAC",
              "label": "FLAC"
            }
          ]
        }
      ]
    },
    {
      "key": "list_voices",
      "name": "List voices",
      "method": "GET",
      "endpoint": "/speech/voices",
      "inputs": []
    }
  ]
}
