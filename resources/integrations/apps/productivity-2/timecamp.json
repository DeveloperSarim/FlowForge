{
  "key": "timecamp",
  "name": "TimeCamp",
  "category": "Productivity",
  "description": "Log and list TimeCamp time entries and tasks.",
  "brand": "timecamp",
  "website": "https://www.timecamp.com",
  "docs_url": "https://developer.timecamp.com",
  "base_url": "https://app.timecamp.com/third_party/api",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "API token",
          "type": "password",
          "required": true,
          "help": "Profile settings > Your programming API token."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_entries",
      "name": "List time entries",
      "method": "GET",
      "endpoint": "/entries",
      "query": {
        "from": "{{ inputs.from }}",
        "to": "{{ inputs.to }}",
        "user_ids": "{{ inputs.user_ids }}"
      },
      "inputs": [
        {
          "key": "from",
          "label": "From date",
          "type": "string",
          "required": true,
          "placeholder": "2026-10-01"
        },
        {
          "key": "to",
          "label": "To date",
          "type": "string",
          "required": true,
          "placeholder": "2026-10-31"
        },
        {
          "key": "user_ids",
          "label": "User IDs",
          "type": "string",
          "placeholder": "me",
          "help": "Comma-separated; \"me\" for yourself."
        }
      ]
    },
    {
      "key": "create_entry",
      "name": "Create time entry",
      "method": "POST",
      "endpoint": "/entries",
      "body": {
        "date": "{{ inputs.date }}",
        "duration": "{{ inputs.duration }}",
        "start_time": "{{ inputs.start_time }}",
        "end_time": "{{ inputs.end_time }}",
        "note": "{{ inputs.note }}",
        "task_id": "{{ inputs.task_id }}"
      },
      "inputs": [
        {
          "key": "date",
          "label": "Date",
          "type": "string",
          "required": true,
          "placeholder": "2026-10-12"
        },
        {
          "key": "duration",
          "label": "Duration (seconds)",
          "type": "number",
          "required": true
        },
        {
          "key": "start_time",
          "label": "Start time",
          "type": "string",
          "placeholder": "09:00:00"
        },
        {
          "key": "end_time",
          "label": "End time",
          "type": "string",
          "placeholder": "10:00:00"
        },
        {
          "key": "note",
          "label": "Note",
          "type": "string"
        },
        {
          "key": "task_id",
          "label": "Task ID",
          "type": "number"
        }
      ]
    },
    {
      "key": "list_tasks",
      "name": "List tasks",
      "method": "GET",
      "endpoint": "/tasks",
      "inputs": []
    }
  ]
}
