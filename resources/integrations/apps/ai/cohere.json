{
  "key": "cohere",
  "name": "Cohere",
  "category": "AI",
  "description": "Chat with Command models, embed text and rerank search results.",
  "brand": "cohere",
  "website": "https://cohere.com",
  "docs_url": "https://docs.cohere.com/reference/about",
  "base_url": "https://api.cohere.com",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "chat_completion",
      "name": "Chat completion",
      "description": "Send a prompt and get the reply as {{ steps.<id>.text }}.",
      "method": "POST",
      "endpoint": "/v2/chat",
      "timeout": 300,
      "body": {
        "model": "{{ inputs.model }}",
        "messages": [
          {
            "role": "system",
            "content": "{{ inputs.system }}"
          },
          {
            "role": "user",
            "content": "{{ inputs.prompt }}"
          }
        ],
        "temperature": "{{ inputs.temperature }}",
        "max_tokens": "{{ inputs.max_tokens }}"
      },
      "output_fields": {
        "text": "message.content.0.text"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "default": "command-a-03-2025"
        },
        {
          "key": "prompt",
          "label": "Prompt",
          "type": "text",
          "required": true
        },
        {
          "key": "system",
          "label": "System prompt",
          "type": "text",
          "required": true,
          "default": "You are a helpful assistant.",
          "help": "Sent as the system message."
        },
        {
          "key": "temperature",
          "label": "Temperature",
          "type": "number",
          "placeholder": "0.7"
        },
        {
          "key": "max_tokens",
          "label": "Max output tokens",
          "type": "number"
        }
      ]
    },
    {
      "key": "create_embedding",
      "name": "Create embedding",
      "method": "POST",
      "endpoint": "/v2/embed",
      "body": {
        "model": "{{ inputs.model }}",
        "texts": [
          "{{ inputs.text }}"
        ],
        "input_type": "{{ inputs.input_type }}",
        "embedding_types": [
          "float"
        ]
      },
      "output_fields": {
        "embedding": "embeddings.float.0"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "default": "embed-v4.0"
        },
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "required": true
        },
        {
          "key": "input_type",
          "label": "Input type",
          "type": "select",
          "options": [
            {
              "value": "search_document",
              "label": "Search document"
            },
            {
              "value": "search_query",
              "label": "Search query"
            },
            {
              "value": "classification",
              "label": "Classification"
            },
            {
              "value": "clustering",
              "label": "Clustering"
            }
          ],
          "required": true,
          "default": "search_document"
        }
      ]
    },
    {
      "key": "rerank",
      "name": "Rerank documents",
      "description": "Order documents by relevance to a query.",
      "method": "POST",
      "endpoint": "/v2/rerank",
      "body": {
        "model": "{{ inputs.model }}",
        "query": "{{ inputs.query }}",
        "documents": "{{ inputs.documents }}",
        "top_n": "{{ inputs.top_n }}"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "default": "rerank-v3.5"
        },
        {
          "key": "query",
          "label": "Query",
          "type": "string",
          "required": true
        },
        {
          "key": "documents",
          "label": "Documents",
          "type": "list",
          "required": true
        },
        {
          "key": "top_n",
          "label": "Top N",
          "type": "number"
        }
      ]
    }
  ]
}
