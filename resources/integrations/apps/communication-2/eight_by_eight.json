{
  "key": "eight_by_eight",
  "name": "8x8",
  "category": "Communication",
  "description": "Send SMS through the 8x8 CPaaS (Connect) SMS API.",
  "brand": "8x8",
  "website": "https://www.8x8.com",
  "docs_url": "https://developer.8x8.com/connect/reference/send-sms-single",
  "base_url": "https://sms.8x8.com/api/v1/subaccounts/{{ credentials.subaccount_id }}",
  "auth": [
    { "type": "bearer", "fields": [
      { "key": "subaccount_id", "label": "Subaccount ID", "type": "string", "required": true },
      { "key": "token", "label": "API key", "type": "password", "required": true, "help": "8x8 Connect → API keys." }
    ] }
  ],
  "actions": [
    {
      "key": "send_sms",
      "name": "Send SMS",
      "method": "POST",
      "endpoint": "/messages",
      "body": {
        "destination": "{{ inputs.destination }}",
        "text": "{{ inputs.text }}",
        "source": "{{ inputs.source }}",
        "clientMessageId": "{{ inputs.client_message_id }}"
      },
      "inputs": [
        { "key": "destination", "label": "To (E.164)", "type": "string", "required": true, "placeholder": "+6512345678" },
        { "key": "text", "label": "Message", "type": "text", "required": true },
        { "key": "source", "label": "Sender ID", "type": "string" },
        { "key": "client_message_id", "label": "Your reference", "type": "string" }
      ]
    }
  ]
}
