{
  "key": "hr_partner",
  "name": "HR Partner",
  "category": "HR & Recruiting",
  "description": "Look up employees and absences in HR Partner.",
  "brand": "hrpartner",
  "website": "https://www.hrpartner.io",
  "docs_url": "https://developer.hrpartner.io",
  "base_url": "https://api.hrpartner.io",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "x-api-key",
      "fields": [
        {
          "key": "api_key",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Setup > Company Settings > API."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_employees",
      "name": "List employees",
      "method": "GET",
      "endpoint": "/employees",
      "query": {
        "search": "{{ inputs.search }}",
        "department": "{{ inputs.department }}",
        "is_active": "{{ inputs.is_active }}"
      },
      "inputs": [
        {
          "key": "search",
          "label": "Search",
          "type": "string"
        },
        {
          "key": "department",
          "label": "Department",
          "type": "string"
        },
        {
          "key": "is_active",
          "label": "Active only",
          "type": "boolean"
        }
      ]
    },
    {
      "key": "get_employee",
      "name": "Get employee",
      "method": "GET",
      "endpoint": "/employee/{{ inputs.code }}",
      "inputs": [
        {
          "key": "code",
          "label": "Employee code",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_absences",
      "name": "List absences",
      "method": "GET",
      "endpoint": "/absences",
      "inputs": []
    }
  ]
}
