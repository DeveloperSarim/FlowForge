{
  "key": "builtwith",
  "name": "BuiltWith",
  "category": "Ads & SEO",
  "description": "Look up the technologies a website uses.",
  "brand": "builtwith",
  "website": "https://builtwith.com",
  "docs_url": "https://api.builtwith.com/domain-api",
  "base_url": "https://api.builtwith.com",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "KEY"
  },
  "actions": [
    {
      "key": "domain_lookup",
      "name": "Look up domain",
      "description": "Current and historical technologies (Domain API, paid).",
      "method": "GET",
      "endpoint": "/v21/api.json",
      "query": {
        "LOOKUP": "{{ inputs.domain }}"
      },
      "error_path": "Errors",
      "inputs": [
        {
          "key": "domain",
          "label": "Domain",
          "type": "string",
          "required": true,
          "placeholder": "example.com"
        }
      ]
    },
    {
      "key": "free_lookup",
      "name": "Look up domain (free API)",
      "description": "Technology group counts and last-updated dates.",
      "method": "GET",
      "endpoint": "/free1/api.json",
      "query": {
        "LOOKUP": "{{ inputs.domain }}"
      },
      "error_path": "Errors",
      "inputs": [
        {
          "key": "domain",
          "label": "Domain",
          "type": "string",
          "required": true,
          "placeholder": "example.com"
        }
      ]
    }
  ]
}