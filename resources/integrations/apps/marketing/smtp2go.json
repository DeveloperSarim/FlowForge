{
  "key": "smtp2go",
  "name": "SMTP2GO",
  "category": "Marketing & Email",
  "description": "Send email through the SMTP2GO API.",
  "brand": "smtp2go",
  "website": "https://www.smtp2go.com",
  "docs_url": "https://developers.smtp2go.com/docs/introduction-guide",
  "base_url": "https://api.smtp2go.com/v3",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "X-Smtp2go-Api-Key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "send_email",
      "name": "Send email",
      "method": "POST",
      "endpoint": "/email/send",
      "output_path": "data",
      "body": {
        "sender": "{{ inputs.sender }}",
        "to": "{{ inputs.to }}",
        "subject": "{{ inputs.subject }}",
        "html_body": "{{ inputs.html_body }}",
        "text_body": "{{ inputs.text_body }}",
        "template_id": "{{ inputs.template_id }}",
        "template_data": "{{ inputs.template_data }}"
      },
      "inputs": [
        {
          "key": "sender",
          "label": "Sender",
          "type": "string",
          "required": true,
          "placeholder": "Acme <hello@example.com>"
        },
        {
          "key": "to",
          "label": "To",
          "type": "list",
          "required": true
        },
        {
          "key": "subject",
          "label": "Subject",
          "type": "string"
        },
        {
          "key": "html_body",
          "label": "HTML body",
          "type": "text"
        },
        {
          "key": "text_body",
          "label": "Text body",
          "type": "text"
        },
        {
          "key": "template_id",
          "label": "Template ID",
          "type": "string"
        },
        {
          "key": "template_data",
          "label": "Template data",
          "type": "json"
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "Settings → Webhooks (delivered, open, click, bounce, unsubscribe…).",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
