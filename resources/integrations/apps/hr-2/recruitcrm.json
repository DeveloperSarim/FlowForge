{
  "key": "recruitcrm",
  "name": "Recruit CRM",
  "category": "HR & Recruiting",
  "description": "Create and search candidates, contacts and companies in Recruit CRM.",
  "brand": "recruitcrm",
  "website": "https://recruitcrm.io",
  "docs_url": "https://docs.recruitcrm.io",
  "base_url": "https://api.recruitcrm.io/v1",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "API token",
          "type": "password",
          "required": true,
          "help": "Admin settings > API & integrations."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_candidates",
      "name": "List candidates",
      "description": "Newest first.",
      "method": "GET",
      "endpoint": "/candidates",
      "query": {
        "sort_by": "createdon",
        "sort_order": "desc",
        "limit": "{{ inputs.limit }}",
        "page": "{{ inputs.page }}"
      },
      "output_path": "data",
      "inputs": [
        {
          "key": "limit",
          "label": "Max results",
          "type": "number",
          "default": 50
        },
        {
          "key": "page",
          "label": "Page",
          "type": "number"
        }
      ]
    },
    {
      "key": "search_candidates",
      "name": "Search candidates",
      "method": "GET",
      "endpoint": "/candidates/search",
      "query": {
        "email": "{{ inputs.email }}",
        "created_from": "{{ inputs.created_from }}"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string"
        },
        {
          "key": "created_from",
          "label": "Created from",
          "type": "string",
          "placeholder": "2026-10-01"
        }
      ]
    },
    {
      "key": "create_candidate",
      "name": "Create candidate",
      "method": "POST",
      "endpoint": "/candidates",
      "body": {
        "first_name": "{{ inputs.first_name }}",
        "last_name": "{{ inputs.last_name }}",
        "email": "{{ inputs.email }}",
        "contact_number": "{{ inputs.contact_number }}",
        "position": "{{ inputs.position }}",
        "city": "{{ inputs.city }}",
        "...": "{{ inputs.extra }}"
      },
      "inputs": [
        {
          "key": "first_name",
          "label": "First name",
          "type": "string",
          "required": true
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string"
        },
        {
          "key": "contact_number",
          "label": "Phone",
          "type": "string"
        },
        {
          "key": "position",
          "label": "Current position",
          "type": "string"
        },
        {
          "key": "city",
          "label": "City",
          "type": "string"
        },
        {
          "key": "extra",
          "label": "Other fields",
          "type": "keyvalue"
        }
      ]
    },
    {
      "key": "create_contact",
      "name": "Create contact",
      "method": "POST",
      "endpoint": "/contacts",
      "body": {
        "first_name": "{{ inputs.first_name }}",
        "last_name": "{{ inputs.last_name }}",
        "email": "{{ inputs.email }}",
        "...": "{{ inputs.extra }}"
      },
      "inputs": [
        {
          "key": "first_name",
          "label": "First name",
          "type": "string",
          "required": true
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string"
        },
        {
          "key": "extra",
          "label": "Other fields",
          "type": "keyvalue"
        }
      ]
    },
    {
      "key": "create_company",
      "name": "Create company",
      "method": "POST",
      "endpoint": "/companies",
      "body": {
        "company_name": "{{ inputs.company_name }}",
        "...": "{{ inputs.extra }}"
      },
      "inputs": [
        {
          "key": "company_name",
          "label": "Company name",
          "type": "string",
          "required": true
        },
        {
          "key": "extra",
          "label": "Other fields",
          "type": "keyvalue"
        }
      ]
    },
    {
      "key": "list_jobs",
      "name": "List jobs",
      "method": "GET",
      "endpoint": "/jobs",
      "query": {
        "sort_by": "createdon",
        "sort_order": "desc",
        "limit": "{{ inputs.limit }}"
      },
      "output_path": "data",
      "inputs": [
        {
          "key": "limit",
          "label": "Max results",
          "type": "number",
          "default": 50
        }
      ]
    },
    {
      "key": "create_webhook",
      "name": "Subscribe webhook",
      "method": "POST",
      "endpoint": "/subscriptions",
      "body": {
        "event": "{{ inputs.event }}",
        "target_url": "{{ inputs.target_url }}"
      },
      "inputs": [
        {
          "key": "event",
          "label": "Event",
          "type": "string",
          "required": true,
          "placeholder": "candidate.created"
        },
        {
          "key": "target_url",
          "label": "Target URL",
          "type": "string",
          "required": true,
          "help": "Paste a workflow's Recruit CRM webhook trigger URL."
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "new_candidate",
      "name": "New candidate",
      "type": "polling",
      "method": "GET",
      "endpoint": "/candidates",
      "query": {
        "sort_by": "createdon",
        "sort_order": "desc",
        "limit": 50
      },
      "items_path": "data",
      "id_field": "slug",
      "inputs": [
        {
          "key": "poll_interval",
          "label": "Check every (minutes)",
          "type": "number",
          "default": 5
        }
      ]
    },
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "Register the URL with Subscribe webhook (candidate.created, job.updated…).",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
