{
  "key": "transform",
  "name": "Transform",
  "icon": "wand-sparkles",
  "category": "Data transformation",
  "description": "Parse JSON and format text between steps.",
  "actions": [
    {
      "key": "json_parse",
      "name": "Parse JSON",
      "description": "Turn a JSON string into structured data.",
      "handler": "json_parse",
      "inputs": [
        { "key": "source", "label": "JSON string", "type": "text", "required": true, "placeholder": "{{ steps.step_1.body }}" }
      ]
    },
    {
      "key": "text_format",
      "output": ["text", "length"],
      "name": "Format text",
      "description": "Build a string from variables and transform it.",
      "handler": "text_format",
      "inputs": [
        { "key": "text", "label": "Text", "type": "text", "required": true },
        { "key": "operation", "label": "Transform", "type": "select", "default": "none", "options": [
          { "value": "none", "label": "None" }, { "value": "upper", "label": "UPPERCASE" }, { "value": "lower", "label": "lowercase" },
          { "value": "title", "label": "Title Case" }, { "value": "trim", "label": "Trim whitespace" }, { "value": "slug", "label": "slug-ify" },
          { "value": "strip_html", "label": "Strip HTML" }, { "value": "truncate", "label": "Truncate" }, { "value": "replace", "label": "Find & replace" },
          { "value": "url_encode", "label": "URL-encode" }, { "value": "base64_encode", "label": "Base64 encode" }, { "value": "base64_decode", "label": "Base64 decode" }
        ] },
        { "key": "length", "label": "Max length (truncate)", "type": "number", "default": 100 },
        { "key": "search", "label": "Find (replace)", "type": "string" },
        { "key": "replace", "label": "Replace with (replace)", "type": "string" }
      ]
    }
  ]
}
