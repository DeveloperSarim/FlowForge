{
  "key": "udemy_instructor",
  "name": "Udemy Instructor",
  "category": "Education",
  "description": "Read your Udemy courses, student questions and reviews, and reply to questions.",
  "brand": "udemy",
  "website": "https://www.udemy.com",
  "docs_url": "https://www.udemy.com/developers/instructor/",
  "base_url": "https://www.udemy.com/instructor-api/v1",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "Instructor API token",
          "type": "password",
          "required": true,
          "help": "Udemy profile > Account settings > API clients > Request instructor API client."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_courses",
      "name": "List my courses",
      "method": "GET",
      "endpoint": "/taught-courses/courses/",
      "query": {
        "page_size": "{{ inputs.page_size }}"
      },
      "inputs": [
        {
          "key": "page_size",
          "label": "Per page",
          "type": "number",
          "default": 50
        }
      ]
    },
    {
      "key": "list_questions",
      "name": "List questions",
      "method": "GET",
      "endpoint": "/taught-courses/questions/",
      "query": {
        "course": "{{ inputs.course }}",
        "status": "{{ inputs.status }}",
        "ordering": "{{ inputs.ordering }}",
        "page_size": "{{ inputs.page_size }}"
      },
      "inputs": [
        {
          "key": "course",
          "label": "Course ID",
          "type": "string"
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "options": [
            {
              "value": "unread",
              "label": "Unread"
            },
            {
              "value": "read",
              "label": "Read"
            },
            {
              "value": "unanswered",
              "label": "Unanswered"
            },
            {
              "value": "unresponded",
              "label": "Unresponded"
            }
          ]
        },
        {
          "key": "ordering",
          "label": "Order",
          "type": "string",
          "placeholder": "-created"
        },
        {
          "key": "page_size",
          "label": "Per page",
          "type": "number",
          "default": 50
        }
      ]
    },
    {
      "key": "list_reviews",
      "name": "List reviews",
      "method": "GET",
      "endpoint": "/taught-courses/reviews/",
      "query": {
        "course": "{{ inputs.course }}",
        "star": "{{ inputs.star }}",
        "ordering": "{{ inputs.ordering }}",
        "page_size": "{{ inputs.page_size }}"
      },
      "inputs": [
        {
          "key": "course",
          "label": "Course ID",
          "type": "string"
        },
        {
          "key": "star",
          "label": "Stars",
          "type": "number"
        },
        {
          "key": "ordering",
          "label": "Order",
          "type": "string",
          "placeholder": "-created"
        },
        {
          "key": "page_size",
          "label": "Per page",
          "type": "number",
          "default": 50
        }
      ]
    },
    {
      "key": "reply_question",
      "name": "Reply to question",
      "method": "POST",
      "endpoint": "/courses/{{ inputs.course_id }}/questions/{{ inputs.question_id }}/replies/",
      "body_format": "form",
      "body": {
        "body": "{{ inputs.body }}"
      },
      "inputs": [
        {
          "key": "course_id",
          "label": "Course ID",
          "type": "string",
          "required": true
        },
        {
          "key": "question_id",
          "label": "Question ID",
          "type": "string",
          "required": true
        },
        {
          "key": "body",
          "label": "Reply (HTML)",
          "type": "text",
          "required": true
        }
      ]
    }
  ]
}
