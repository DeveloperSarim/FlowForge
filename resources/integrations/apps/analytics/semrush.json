{
  "key": "semrush",
  "name": "Semrush",
  "category": "Analytics",
  "description": "Domain overview, organic keywords, keyword metrics and backlink overview (CSV).",
  "brand": "semrush",
  "website": "https://www.semrush.com",
  "docs_url": "https://developer.semrush.com/api/v3/analytics/basic-docs/",
  "base_url": "https://api.semrush.com",
  "auth": { "type": "api_key", "in": "query", "name": "key", "fields": [{ "key": "api_key", "label": "API key", "type": "password", "required": true, "help": "Subscription info > API units. Responses are semicolon-separated CSV text." }] },
  "actions": [
    {
      "key": "domain_overview",
      "name": "Domain overview",
      "method": "GET",
      "endpoint": "/",
      "query": { "type": "domain_rank", "domain": "{{ inputs.domain }}", "database": "{{ inputs.database }}", "export_columns": "{{ inputs.export_columns }}" },
      "inputs": [
        { "key": "domain", "label": "Domain", "type": "string", "required": true, "placeholder": "example.com" },
        { "key": "database", "label": "Database", "type": "string", "required": true, "default": "us", "help": "Regional database: us, uk, de, fr, …" },
        { "key": "export_columns", "label": "Columns", "type": "string", "placeholder": "Dn,Rk,Or,Ot,Oc,Ad,At,Ac" }
      ]
    },
    {
      "key": "domain_organic_keywords",
      "name": "Domain organic keywords",
      "method": "GET",
      "endpoint": "/",
      "query": { "type": "domain_organic", "domain": "{{ inputs.domain }}", "database": "{{ inputs.database }}", "display_limit": "{{ inputs.limit }}", "display_sort": "{{ inputs.sort }}", "export_columns": "{{ inputs.export_columns }}" },
      "inputs": [
        { "key": "domain", "label": "Domain", "type": "string", "required": true },
        { "key": "database", "label": "Database", "type": "string", "required": true, "default": "us" },
        { "key": "limit", "label": "Rows", "type": "number", "default": 100 },
        { "key": "sort", "label": "Sort", "type": "string", "placeholder": "tr_desc" },
        { "key": "export_columns", "label": "Columns", "type": "string", "placeholder": "Ph,Po,Nq,Cp,Ur,Tr" }
      ]
    },
    {
      "key": "keyword_overview",
      "name": "Keyword overview",
      "method": "GET",
      "endpoint": "/",
      "query": { "type": "phrase_this", "phrase": "{{ inputs.phrase }}", "database": "{{ inputs.database }}", "export_columns": "{{ inputs.export_columns }}" },
      "inputs": [
        { "key": "phrase", "label": "Keyword", "type": "string", "required": true },
        { "key": "database", "label": "Database", "type": "string", "required": true, "default": "us" },
        { "key": "export_columns", "label": "Columns", "type": "string", "placeholder": "Ph,Nq,Cp,Co,Nr,Td" }
      ]
    },
    {
      "key": "backlinks_overview",
      "name": "Backlinks overview",
      "method": "GET",
      "endpoint": "/analytics/v1/",
      "query": { "type": "backlinks_overview", "target": "{{ inputs.target }}", "target_type": "{{ inputs.target_type }}" },
      "inputs": [
        { "key": "target", "label": "Target", "type": "string", "required": true },
        { "key": "target_type", "label": "Target type", "type": "select", "required": true, "default": "root_domain", "options": [
          { "value": "root_domain", "label": "Root domain" }, { "value": "domain", "label": "Domain" }, { "value": "url", "label": "URL" }
        ] }
      ]
    }
  ]
}
