{
  "key": "everhour",
  "name": "Everhour",
  "category": "Productivity",
  "description": "Start and stop Everhour timers and list projects.",
  "brand": "everhour",
  "website": "https://everhour.com",
  "docs_url": "https://developers.everhour.com",
  "base_url": "https://api.everhour.com",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "X-Api-Key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Bottom of your profile page."
      }
    ]
  },
  "actions": [
    {
      "key": "get_me",
      "name": "Get current user",
      "method": "GET",
      "endpoint": "/users/me",
      "inputs": []
    },
    {
      "key": "list_projects",
      "name": "List projects",
      "method": "GET",
      "endpoint": "/projects",
      "query": {
        "query": "{{ inputs.query }}",
        "limit": "{{ inputs.limit }}"
      },
      "inputs": [
        {
          "key": "query",
          "label": "Search",
          "type": "string"
        },
        {
          "key": "limit",
          "label": "Max results",
          "type": "number"
        }
      ]
    },
    {
      "key": "start_timer",
      "name": "Start timer",
      "method": "POST",
      "endpoint": "/timers",
      "body": {
        "task": "{{ inputs.task }}",
        "comment": "{{ inputs.comment }}",
        "userDate": "{{ inputs.user_date }}"
      },
      "inputs": [
        {
          "key": "task",
          "label": "Task ID",
          "type": "string",
          "required": true,
          "placeholder": "ev:9876543210"
        },
        {
          "key": "comment",
          "label": "Comment",
          "type": "string"
        },
        {
          "key": "user_date",
          "label": "Date",
          "type": "string",
          "placeholder": "2026-10-12"
        }
      ]
    },
    {
      "key": "stop_timer",
      "name": "Stop timer",
      "description": "Stops your running timer and records the time.",
      "method": "DELETE",
      "endpoint": "/timers/current",
      "inputs": []
    },
    {
      "key": "get_running_timer",
      "name": "Get running timer",
      "method": "GET",
      "endpoint": "/timers/current",
      "inputs": []
    }
  ]
}
