{
  "key": "hive",
  "name": "Hive",
  "category": "Project Management",
  "description": "Call the Hive REST API with your API key and user ID.",
  "brand": "hive",
  "website": "https://hive.com",
  "docs_url": "https://developers.hive.com/reference",
  "base_url": "https://app.hive.com/api/v1",
  "headers": {
    "api_key": "{{ credentials.hive_api_key }}"
  },
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "user_id",
    "fields": [
      {
        "key": "api_key",
        "label": "User ID",
        "type": "string",
        "required": true,
        "help": "My profile > API info."
      },
      {
        "key": "hive_api_key",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  }
}
