{
  "key": "mistral",
  "name": "Mistral AI",
  "category": "AI",
  "description": "Chat with Mistral models, embed text and OCR documents.",
  "brand": "mistralai",
  "website": "https://mistral.ai",
  "docs_url": "https://docs.mistral.ai/api/",
  "popular": true,
  "base_url": "https://api.mistral.ai/v1",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "chat_completion",
      "name": "Chat completion",
      "description": "Send a prompt and get the reply as {{ steps.<id>.text }}.",
      "method": "POST",
      "endpoint": "/chat/completions",
      "timeout": 300,
      "body": {
        "model": "{{ inputs.model }}",
        "messages": [
          {
            "role": "system",
            "content": "{{ inputs.system }}"
          },
          {
            "role": "user",
            "content": "{{ inputs.prompt }}"
          }
        ],
        "temperature": "{{ inputs.temperature }}",
        "max_tokens": "{{ inputs.max_tokens }}"
      },
      "output_fields": {
        "text": "choices.0.message.content"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "default": "mistral-large-latest"
        },
        {
          "key": "prompt",
          "label": "Prompt",
          "type": "text",
          "required": true
        },
        {
          "key": "system",
          "label": "System prompt",
          "type": "text",
          "required": true,
          "default": "You are a helpful assistant.",
          "help": "Sent as the system message."
        },
        {
          "key": "temperature",
          "label": "Temperature",
          "type": "number",
          "placeholder": "0.7"
        },
        {
          "key": "max_tokens",
          "label": "Max output tokens",
          "type": "number"
        }
      ]
    },
    {
      "key": "create_embedding",
      "name": "Create embedding",
      "method": "POST",
      "endpoint": "/embeddings",
      "body": {
        "model": "{{ inputs.model }}",
        "input": [
          "{{ inputs.input }}"
        ]
      },
      "output_fields": {
        "embedding": "data.0.embedding"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "default": "mistral-embed"
        },
        {
          "key": "input",
          "label": "Text",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "key": "ocr_document",
      "name": "OCR document",
      "description": "Extract Markdown text from a PDF or image URL.",
      "method": "POST",
      "endpoint": "/ocr",
      "timeout": 300,
      "body": {
        "model": "{{ inputs.model }}",
        "document": {
          "type": "document_url",
          "document_url": "{{ inputs.document_url }}"
        }
      },
      "output_fields": {
        "text": "pages.*.markdown"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "default": "mistral-ocr-latest"
        },
        {
          "key": "document_url",
          "label": "Document URL",
          "type": "string",
          "required": true,
          "placeholder": "https://example.com/file.pdf"
        }
      ]
    }
  ]
}
