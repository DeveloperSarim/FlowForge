{
  "key": "motion",
  "name": "Motion",
  "category": "Productivity",
  "description": "Create and list tasks in Motion's AI calendar and task manager.",
  "brand": "motion",
  "website": "https://www.usemotion.com",
  "docs_url": "https://docs.usemotion.com/api-reference",
  "base_url": "https://api.usemotion.com/v1",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "X-API-Key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Settings > API."
      }
    ]
  },
  "actions": [
    {
      "key": "create_task",
      "name": "Create task",
      "method": "POST",
      "endpoint": "/tasks",
      "body": {
        "name": "{{ inputs.name }}",
        "workspaceId": "{{ inputs.workspace_id }}",
        "description": "{{ inputs.description }}",
        "dueDate": "{{ inputs.due_date }}",
        "duration": "{{ inputs.duration }}",
        "priority": "{{ inputs.priority }}",
        "projectId": "{{ inputs.project_id }}",
        "assigneeId": "{{ inputs.assignee_id }}",
        "labels": "{{ inputs.labels }}"
      },
      "inputs": [
        {
          "key": "name",
          "label": "Name",
          "type": "string",
          "required": true
        },
        {
          "key": "workspace_id",
          "label": "Workspace ID",
          "type": "string",
          "required": true
        },
        {
          "key": "description",
          "label": "Description (Markdown)",
          "type": "text"
        },
        {
          "key": "due_date",
          "label": "Due date",
          "type": "string",
          "placeholder": "2026-10-12T17:00:00Z"
        },
        {
          "key": "duration",
          "label": "Duration (minutes)",
          "type": "number"
        },
        {
          "key": "priority",
          "label": "Priority",
          "type": "select",
          "options": [
            {
              "value": "ASAP",
              "label": "ASAP"
            },
            {
              "value": "HIGH",
              "label": "HIGH"
            },
            {
              "value": "MEDIUM",
              "label": "MEDIUM"
            },
            {
              "value": "LOW",
              "label": "LOW"
            }
          ]
        },
        {
          "key": "project_id",
          "label": "Project ID",
          "type": "string"
        },
        {
          "key": "assignee_id",
          "label": "Assignee ID",
          "type": "string"
        },
        {
          "key": "labels",
          "label": "Labels",
          "type": "list"
        }
      ]
    },
    {
      "key": "list_tasks",
      "name": "List tasks",
      "method": "GET",
      "endpoint": "/tasks",
      "query": {
        "workspaceId": "{{ inputs.workspace_id }}",
        "projectId": "{{ inputs.project_id }}",
        "assigneeId": "{{ inputs.assignee_id }}"
      },
      "output_path": "tasks",
      "inputs": [
        {
          "key": "workspace_id",
          "label": "Workspace ID",
          "type": "string"
        },
        {
          "key": "project_id",
          "label": "Project ID",
          "type": "string"
        },
        {
          "key": "assignee_id",
          "label": "Assignee ID",
          "type": "string"
        }
      ]
    },
    {
      "key": "get_task",
      "name": "Get task",
      "method": "GET",
      "endpoint": "/tasks/{{ inputs.task_id }}",
      "inputs": [
        {
          "key": "task_id",
          "label": "Task ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_workspaces",
      "name": "List workspaces",
      "method": "GET",
      "endpoint": "/workspaces",
      "output_path": "workspaces",
      "inputs": []
    },
    {
      "key": "list_projects",
      "name": "List projects",
      "method": "GET",
      "endpoint": "/projects",
      "query": {
        "workspaceId": "{{ inputs.workspace_id }}"
      },
      "output_path": "projects",
      "inputs": [
        {
          "key": "workspace_id",
          "label": "Workspace ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
