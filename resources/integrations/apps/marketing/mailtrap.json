{
  "key": "mailtrap",
  "name": "Mailtrap",
  "category": "Marketing & Email",
  "description": "Send transactional email through Mailtrap Email Sending.",
  "brand": "mailtrap",
  "website": "https://mailtrap.io",
  "docs_url": "https://api-docs.mailtrap.io/",
  "base_url": "https://send.api.mailtrap.io/api",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API token",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "send_email",
      "name": "Send email",
      "method": "POST",
      "endpoint": "/send",
      "body": {
        "from": {
          "email": "{{ inputs.from_email }}",
          "name": "{{ inputs.from_name }}"
        },
        "to": [
          {
            "email": "{{ inputs.to }}"
          }
        ],
        "subject": "{{ inputs.subject }}",
        "html": "{{ inputs.html }}",
        "text": "{{ inputs.text }}",
        "category": "{{ inputs.category }}"
      },
      "inputs": [
        {
          "key": "from_email",
          "label": "From email",
          "type": "string",
          "required": true
        },
        {
          "key": "from_name",
          "label": "From name",
          "type": "string"
        },
        {
          "key": "to",
          "label": "To",
          "type": "string",
          "required": true
        },
        {
          "key": "subject",
          "label": "Subject",
          "type": "string",
          "required": true
        },
        {
          "key": "html",
          "label": "HTML",
          "type": "text"
        },
        {
          "key": "text",
          "label": "Text",
          "type": "text"
        },
        {
          "key": "category",
          "label": "Category",
          "type": "string"
        }
      ]
    },
    {
      "key": "send_template",
      "name": "Send template email",
      "method": "POST",
      "endpoint": "/send",
      "body": {
        "from": {
          "email": "{{ inputs.from_email }}",
          "name": "{{ inputs.from_name }}"
        },
        "to": [
          {
            "email": "{{ inputs.to }}"
          }
        ],
        "template_uuid": "{{ inputs.template_uuid }}",
        "template_variables": "{{ inputs.template_variables }}"
      },
      "inputs": [
        {
          "key": "from_email",
          "label": "From email",
          "type": "string",
          "required": true
        },
        {
          "key": "from_name",
          "label": "From name",
          "type": "string"
        },
        {
          "key": "to",
          "label": "To",
          "type": "string",
          "required": true
        },
        {
          "key": "template_uuid",
          "label": "Template UUID",
          "type": "string",
          "required": true
        },
        {
          "key": "template_variables",
          "label": "Template variables",
          "type": "json"
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "Sending Domains → Webhooks (delivery, open, click, bounce…).",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
