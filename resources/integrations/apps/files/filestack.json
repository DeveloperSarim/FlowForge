{
  "key": "filestack",
  "name": "Filestack",
  "category": "Files & Documents",
  "description": "Store files from a URL and read file metadata.",
  "brand": "filestack",
  "website": "https://www.filestack.com",
  "docs_url": "https://www.filestack.com/docs/api/file/",
  "base_url": "https://www.filestackapi.com/api",
  "auth": [
    {
      "type": "api_key",
      "in": "query",
      "name": "key"
    }
  ],
  "actions": [
    {
      "key": "store_from_url",
      "name": "Store file from URL",
      "method": "POST",
      "endpoint": "/store/S3",
      "query": {
        "filename": "{{ inputs.filename }}",
        "path": "{{ inputs.path }}"
      },
      "body_format": "form",
      "body": {
        "url": "{{ inputs.url }}"
      },
      "inputs": [
        {
          "key": "url",
          "label": "File URL",
          "type": "string",
          "required": true
        },
        {
          "key": "filename",
          "label": "File name",
          "type": "string"
        },
        {
          "key": "path",
          "label": "Storage path",
          "type": "string",
          "placeholder": "/uploads/"
        }
      ]
    },
    {
      "key": "get_metadata",
      "name": "Get file metadata",
      "method": "GET",
      "endpoint": "/file/{{ inputs.handle }}/metadata",
      "inputs": [
        {
          "key": "handle",
          "label": "File handle",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
