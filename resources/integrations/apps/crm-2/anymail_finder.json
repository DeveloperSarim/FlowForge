{
  "key": "anymail_finder",
  "name": "Anymail Finder",
  "category": "CRM & Sales",
  "description": "Find a person's or decision maker's work email and verify emails.",
  "brand": "anymailfinder",
  "website": "https://anymailfinder.com",
  "docs_url": "https://anymailfinder.com/email-finder-api/docs",
  "base_url": "https://api.anymailfinder.com/v5.1",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "Authorization",
    "fields": [{ "key": "api_key", "label": "API key", "type": "password", "required": true }]
  },
  "actions": [
    {
      "key": "find_person_email",
      "name": "Find person's email",
      "method": "POST",
      "endpoint": "/find-email/person",
      "timeout": 180,
      "body": {
        "full_name": "{{ inputs.full_name }}",
        "first_name": "{{ inputs.first_name }}",
        "last_name": "{{ inputs.last_name }}",
        "domain": "{{ inputs.domain }}",
        "company_name": "{{ inputs.company_name }}"
      },
      "inputs": [
        { "key": "full_name", "label": "Full name", "type": "string" },
        { "key": "first_name", "label": "First name", "type": "string" },
        { "key": "last_name", "label": "Last name", "type": "string" },
        { "key": "domain", "label": "Company domain", "type": "string" },
        { "key": "company_name", "label": "Company name", "type": "string" }
      ]
    },
    {
      "key": "find_email_by_linkedin",
      "name": "Find email from LinkedIn",
      "method": "POST",
      "endpoint": "/find-email/linkedin-url",
      "timeout": 180,
      "body": { "linkedin_url": "{{ inputs.linkedin_url }}" },
      "inputs": [{ "key": "linkedin_url", "label": "LinkedIn profile URL", "type": "string", "required": true }]
    },
    {
      "key": "find_decision_maker",
      "name": "Find decision maker's email",
      "method": "POST",
      "endpoint": "/find-email/decision-maker",
      "timeout": 180,
      "body": {
        "decision_maker_category": "{{ inputs.category }}",
        "domain": "{{ inputs.domain }}",
        "company_name": "{{ inputs.company_name }}"
      },
      "inputs": [
        { "key": "category", "label": "Decision maker category", "type": "string", "required": true, "placeholder": "ceo" },
        { "key": "domain", "label": "Company domain", "type": "string" },
        { "key": "company_name", "label": "Company name", "type": "string" }
      ]
    },
    {
      "key": "verify_email",
      "name": "Verify email",
      "method": "POST",
      "endpoint": "/verify-email",
      "timeout": 120,
      "body": { "email": "{{ inputs.email }}" },
      "inputs": [{ "key": "email", "label": "Email", "type": "string", "required": true }]
    }
  ]
}
