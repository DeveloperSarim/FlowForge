{
  "key": "flock",
  "name": "Flock",
  "category": "Communication",
  "description": "Send Flock messages to users and groups with a bot or app token.",
  "brand": "flock",
  "website": "https://flock.com",
  "docs_url": "https://docs.flock.com/display/flockos/chat.sendMessage",
  "base_url": "https://api.flock.co/v1",
  "auth": [
    {
      "type": "api_key",
      "in": "query",
      "name": "token",
      "fields": [
        {
          "key": "api_key",
          "label": "Bot or user token",
          "type": "password",
          "required": true,
          "help": "From your app in dev.flock.com (bot token), or a user token received on app install."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "send_message",
      "name": "Send message",
      "method": "POST",
      "endpoint": "/chat.sendMessage",
      "body_format": "form",
      "body": {
        "to": "{{ inputs.to }}",
        "text": "{{ inputs.text }}"
      },
      "inputs": [
        {
          "key": "to",
          "label": "To (user or group ID)",
          "type": "string",
          "required": true,
          "placeholder": "u:abc123 or g:xyz789"
        },
        {
          "key": "text",
          "label": "Message",
          "type": "text",
          "required": true
        }
      ]
    }
  ]
}
