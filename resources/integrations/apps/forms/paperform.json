{
  "key": "paperform",
  "name": "Paperform",
  "category": "Forms & Surveys",
  "description": "Read Paperform forms and submissions; trigger on new submissions.",
  "brand": "paperform",
  "website": "https://paperform.co",
  "base_url": "https://api.paperform.co/v1",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Account > Developer > API key"
      }
    ]
  },
  "actions": [
    {
      "key": "list_forms",
      "name": "List forms",
      "method": "GET",
      "endpoint": "/forms",
      "inputs": []
    },
    {
      "key": "list_submissions",
      "name": "List submissions",
      "method": "GET",
      "endpoint": "/forms/{{ inputs.form }}/submissions",
      "query": {
        "limit": "{{ inputs.limit }}"
      },
      "inputs": [
        {
          "key": "form",
          "label": "Form slug or ID",
          "type": "string",
          "required": true
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 20
        }
      ]
    },
    {
      "key": "get_submission",
      "name": "Get submission",
      "method": "GET",
      "endpoint": "/submissions/{{ inputs.submission_id }}",
      "inputs": [
        {
          "key": "submission_id",
          "label": "Submission ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "new_submission",
      "name": "New submission (webhook)",
      "type": "webhook",
      "description": "Form > After Submission > Integrations > Webhooks, paste this URL.",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
