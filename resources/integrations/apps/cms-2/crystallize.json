{
  "key": "crystallize",
  "name": "Crystallize",
  "category": "CMS & Websites",
  "description": "Query catalogue and discovery data and run Core API mutations.",
  "brand": "crystallize",
  "website": "https://crystallize.com",
  "docs_url": "https://crystallize.com/learn/developer-guides/api-overview",
  "base_url": "https://api.crystallize.com",
  "headers": {
    "X-Crystallize-Access-Token-Id": "{{ credentials.token_id }}",
    "X-Crystallize-Access-Token-Secret": "{{ credentials.api_key }}"
  },
  "auth": [
    {
      "type": "api_key",
      "fields": [
        {
          "key": "tenant",
          "label": "Tenant identifier",
          "type": "string",
          "required": true
        },
        {
          "key": "token_id",
          "label": "Access token ID",
          "type": "string",
          "required": true
        },
        {
          "key": "api_key",
          "label": "Access token secret",
          "type": "password",
          "required": true,
          "help": "Settings > Access tokens."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "catalogue_query",
      "name": "Query Catalogue API",
      "description": "Reads published products, documents and folders.",
      "method": "POST",
      "endpoint": "/{{ credentials.tenant }}/catalogue",
      "body": {
        "query": "{{ inputs.query }}",
        "variables": "{{ inputs.variables }}"
      },
      "inputs": [
        {
          "key": "query",
          "label": "Query",
          "type": "code",
          "required": true,
          "placeholder": "query { ... }"
        },
        {
          "key": "variables",
          "label": "Variables",
          "type": "json"
        }
      ]
    },
    {
      "key": "discovery_query",
      "name": "Query Discovery API",
      "description": "Searches and filters the catalogue.",
      "method": "POST",
      "endpoint": "/{{ credentials.tenant }}/discovery",
      "body": {
        "query": "{{ inputs.query }}",
        "variables": "{{ inputs.variables }}"
      },
      "inputs": [
        {
          "key": "query",
          "label": "Query",
          "type": "code",
          "required": true,
          "placeholder": "query { ... }"
        },
        {
          "key": "variables",
          "label": "Variables",
          "type": "json"
        }
      ]
    },
    {
      "key": "core_query",
      "name": "Run Core API query",
      "description": "Creates and updates items, orders and customers.",
      "method": "POST",
      "endpoint": "/@{{ credentials.tenant }}",
      "body": {
        "query": "{{ inputs.query }}",
        "variables": "{{ inputs.variables }}"
      },
      "inputs": [
        {
          "key": "query",
          "label": "Query",
          "type": "code",
          "required": true,
          "placeholder": "query { ... }"
        },
        {
          "key": "variables",
          "label": "Variables",
          "type": "json"
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
