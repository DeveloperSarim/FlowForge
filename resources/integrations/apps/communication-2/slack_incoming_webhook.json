{
  "key": "slack_incoming_webhook",
  "name": "Slack Incoming Webhooks",
  "category": "Communication",
  "description": "Post messages to a Slack channel through an incoming webhook URL, no bot token needed.",
  "brand": "slack",
  "website": "https://api.slack.com/messaging/webhooks",
  "docs_url": "https://api.slack.com/messaging/webhooks",
  "actions": [
    {
      "key": "send_message",
      "name": "Send webhook message",
      "method": "POST",
      "endpoint": "{{ inputs.webhook_url }}",
      "body": { "text": "{{ inputs.text }}", "blocks": "{{ inputs.blocks }}", "unfurl_links": "{{ inputs.unfurl_links }}" },
      "inputs": [
        { "key": "webhook_url", "label": "Webhook URL", "type": "password", "required": true, "placeholder": "https://hooks.slack.com/services/…", "help": "Your Slack app → Incoming Webhooks → Add New Webhook to Workspace. Each URL posts to one channel." },
        { "key": "text", "label": "Message", "type": "text", "required": true, "help": "Slack mrkdwn. Used as the notification fallback when blocks are set." },
        { "key": "blocks", "label": "Blocks (JSON)", "type": "json", "placeholder": "[{\"type\":\"section\",\"text\":{\"type\":\"mrkdwn\",\"text\":\"*Hello*\"}}]", "help": "Optional Block Kit layout." },
        { "key": "unfurl_links", "label": "Unfurl links", "type": "boolean" }
      ]
    }
  ]
}
