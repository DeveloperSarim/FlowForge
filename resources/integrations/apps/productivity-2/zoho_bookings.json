{
  "key": "zoho_bookings",
  "name": "Zoho Bookings",
  "category": "Productivity",
  "description": "Look up Zoho Bookings services, staff, free slots and appointments.",
  "brand": "zoho",
  "website": "https://www.zoho.com/bookings/",
  "docs_url": "https://www.zoho.com/bookings/help/api/v1/oauthauthentication.html",
  "base_url": "https://www.zohoapis.{{ credentials.dc }}/bookings/v1/json",
  "auth": [
    {
      "type": "oauth2",
      "authorize_url": "https://accounts.zoho.{{ credentials.dc }}/oauth/v2/auth",
      "token_url": "https://accounts.zoho.{{ credentials.dc }}/oauth/v2/token",
      "scopes": [
        "zohobookings.data.CREATE"
      ],
      "scope_separator": ",",
      "authorize_params": {
        "access_type": "offline",
        "prompt": "consent"
      },
      "token_type": "Zoho-oauthtoken",
      "fields": [
        {
          "key": "dc",
          "label": "Data center",
          "type": "select",
          "required": true,
          "default": "com",
          "options": [
            {
              "value": "com",
              "label": "US (.com)"
            },
            {
              "value": "eu",
              "label": "EU (.eu)"
            },
            {
              "value": "in",
              "label": "India (.in)"
            },
            {
              "value": "com.au",
              "label": "Australia (.com.au)"
            },
            {
              "value": "jp",
              "label": "Japan (.jp)"
            },
            {
              "value": "com.cn",
              "label": "China (.com.cn)"
            },
            {
              "value": "sa",
              "label": "Saudi Arabia (.sa)"
            }
          ],
          "help": "The domain your Zoho account lives on."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_workspaces",
      "name": "List workspaces",
      "method": "GET",
      "endpoint": "/workspaces",
      "inputs": []
    },
    {
      "key": "list_services",
      "name": "List services",
      "method": "GET",
      "endpoint": "/services",
      "query": {
        "workspace_id": "{{ inputs.workspace_id }}"
      },
      "inputs": [
        {
          "key": "workspace_id",
          "label": "Workspace ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_staff",
      "name": "List staff",
      "method": "GET",
      "endpoint": "/staffs",
      "query": {
        "service_id": "{{ inputs.service_id }}"
      },
      "inputs": [
        {
          "key": "service_id",
          "label": "Service ID",
          "type": "string"
        }
      ]
    },
    {
      "key": "get_available_slots",
      "name": "Get available slots",
      "method": "GET",
      "endpoint": "/availableslots",
      "query": {
        "service_id": "{{ inputs.service_id }}",
        "staff_id": "{{ inputs.staff_id }}",
        "selected_date": "{{ inputs.selected_date }}"
      },
      "inputs": [
        {
          "key": "service_id",
          "label": "Service ID",
          "type": "string",
          "required": true
        },
        {
          "key": "staff_id",
          "label": "Staff ID",
          "type": "string",
          "required": true
        },
        {
          "key": "selected_date",
          "label": "Date",
          "type": "string",
          "required": true,
          "placeholder": "30-Apr-2026"
        }
      ]
    },
    {
      "key": "get_appointment",
      "name": "Get appointment",
      "method": "GET",
      "endpoint": "/getappointment",
      "query": {
        "booking_id": "{{ inputs.booking_id }}"
      },
      "inputs": [
        {
          "key": "booking_id",
          "label": "Booking ID",
          "type": "string",
          "required": true,
          "placeholder": "#AN-00014"
        }
      ]
    }
  ]
}
