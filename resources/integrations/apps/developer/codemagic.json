{
  "key": "codemagic",
  "name": "Codemagic",
  "category": "Developer Tools",
  "description": "Start, check and cancel Codemagic CI/CD builds.",
  "brand": "codemagic",
  "website": "https://codemagic.io",
  "docs_url": "https://docs.codemagic.io/rest-api/codemagic-rest-api/",
  "base_url": "https://api.codemagic.io",
  "auth": { "type": "api_key", "in": "header", "name": "x-auth-token", "fields": [
    { "key": "api_key", "label": "API token", "type": "password", "required": true, "help": "Teams → Personal Account → Integrations → Codemagic API." }
  ] },
  "actions": [
    {
      "key": "start_build",
      "name": "Start build",
      "method": "POST",
      "endpoint": "/builds",
      "body": {
        "appId": "{{ inputs.app_id }}",
        "workflowId": "{{ inputs.workflow_id }}",
        "branch": "{{ inputs.branch }}",
        "tag": "{{ inputs.tag }}",
        "environment": { "variables": "{{ inputs.variables }}" }
      },
      "inputs": [
        { "key": "app_id", "label": "App ID", "type": "string", "required": true },
        { "key": "workflow_id", "label": "Workflow ID", "type": "string", "required": true },
        { "key": "branch", "label": "Branch", "type": "string", "help": "Set a branch or a tag." },
        { "key": "tag", "label": "Tag", "type": "string" },
        { "key": "variables", "label": "Environment variables", "type": "keyvalue" }
      ]
    },
    {
      "key": "get_build",
      "name": "Get build",
      "method": "GET",
      "endpoint": "/builds/{{ inputs.build_id }}",
      "inputs": [{ "key": "build_id", "label": "Build ID", "type": "string", "required": true }]
    },
    {
      "key": "cancel_build",
      "name": "Cancel build",
      "method": "POST",
      "endpoint": "/builds/{{ inputs.build_id }}/cancel",
      "inputs": [{ "key": "build_id", "label": "Build ID", "type": "string", "required": true }]
    },
    {
      "key": "list_apps",
      "name": "List apps",
      "method": "GET",
      "endpoint": "/apps",
      "output_path": "applications",
      "inputs": []
    }
  ]
}
