{
  "key": "heap",
  "name": "Heap",
  "category": "Analytics",
  "description": "Send server-side events and set user or account properties.",
  "brand": "heap",
  "website": "https://www.heap.io",
  "docs_url": "https://developers.heap.io/reference/server-side-apis-overview",
  "base_url": "https://heapanalytics.com/api",
  "auth": { "type": "api_key", "fields": [{ "key": "api_key", "label": "App ID (environment ID)", "type": "string", "required": true, "help": "Account > Manage > Projects." }] },
  "actions": [
    {
      "key": "track",
      "name": "Track event",
      "method": "POST",
      "endpoint": "/track",
      "body": { "app_id": "{{ credentials.api_key }}", "identity": "{{ inputs.identity }}", "event": "{{ inputs.event }}", "properties": "{{ inputs.properties }}", "timestamp": "{{ inputs.timestamp }}" },
      "inputs": [
        { "key": "identity", "label": "Identity", "type": "string", "required": true, "help": "The identity you pass to heap.identify (e.g. email or user ID)." },
        { "key": "event", "label": "Event name", "type": "string", "required": true },
        { "key": "properties", "label": "Properties", "type": "json" },
        { "key": "timestamp", "label": "Timestamp (ISO 8601)", "type": "string" }
      ]
    },
    {
      "key": "add_user_properties",
      "name": "Add user properties",
      "method": "POST",
      "endpoint": "/add_user_properties",
      "body": { "app_id": "{{ credentials.api_key }}", "identity": "{{ inputs.identity }}", "properties": "{{ inputs.properties }}" },
      "inputs": [
        { "key": "identity", "label": "Identity", "type": "string", "required": true },
        { "key": "properties", "label": "Properties", "type": "json", "required": true, "placeholder": "{ \"plan\": \"pro\" }" }
      ]
    },
    {
      "key": "add_account_properties",
      "name": "Add account properties",
      "method": "POST",
      "endpoint": "/add_account_properties",
      "body": { "app_id": "{{ credentials.api_key }}", "account_id": "{{ inputs.account_id }}", "properties": "{{ inputs.properties }}" },
      "inputs": [
        { "key": "account_id", "label": "Account ID", "type": "string", "required": true },
        { "key": "properties", "label": "Properties", "type": "json", "required": true }
      ]
    }
  ]
}
