{
  "key": "tidycal",
  "name": "TidyCal",
  "category": "Productivity",
  "description": "List TidyCal bookings, booking types and contacts.",
  "brand": "tidycal",
  "website": "https://tidycal.com",
  "docs_url": "https://tidycal.com/developer/docs",
  "base_url": "https://tidycal.com/api",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "Personal access token",
          "type": "password",
          "required": true,
          "help": "Integrations > Advanced > Manage API keys."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_bookings",
      "name": "List bookings",
      "method": "GET",
