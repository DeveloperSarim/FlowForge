{
  "key": "tomorrow_io",
  "name": "Tomorrow.io",
  "category": "Utilities",
  "description": "Realtime weather and hourly or daily forecasts for any location.",
  "brand": "tomorrowio",
  "website": "https://www.tomorrow.io",
  "docs_url": "https://docs.tomorrow.io/reference/welcome",
  "base_url": "https://api.tomorrow.io/v4",
  "auth": { "type": "api_key", "in": "query", "name": "apikey", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "realtime_weather",
      "name": "Get realtime weather",
      "method": "GET",
      "endpoint": "/weather/realtime",
      "query": { "location": "{{ inputs.location }}", "units": "{{ inputs.units }}" },
      "inputs": [
        { "key": "location", "label": "Location", "type": "string", "required": true, "placeholder": "42.3478,-71.0466", "help": "lat,lon, a city name or a US zip code." },
        { "key": "units", "label": "Units", "type": "select", "default": "metric", "options": [{ "value": "metric", "label": "Metric" }, { "value": "imperial", "label": "Imperial" }] }
      ]
    },
    {
      "key": "forecast",
      "name": "Get forecast",
      "method": "GET",
      "endpoint": "/weather/forecast",
      "query": { "location": "{{ inputs.location }}", "timesteps": "{{ inputs.timesteps }}", "units": "{{ inputs.units }}" },
      "inputs": [
        { "key": "location", "label": "Location", "type": "string", "required": true, "placeholder": "42.3478,-71.0466", "help": "lat,lon, a city name or a US zip code." },
        { "key": "timesteps", "label": "Steps", "type": "select", "default": "1d", "options": [{ "value": "1h", "label": "Hourly" }, { "value": "1d", "label": "Daily" }] },
        { "key": "units", "label": "Units", "type": "select", "default": "metric", "options": [{ "value": "metric", "label": "Metric" }, { "value": "imperial", "label": "Imperial" }] }
      ]
    }
  ]
}
