{
  "key": "bunny_storage",
  "name": "Bunny Storage",
  "category": "Files & Documents",
  "description": "List, upload, read and delete files in a bunny.net storage zone.",
  "brand": "bunnydotnet",
  "website": "https://bunny.net/storage/",
  "docs_url": "https://docs.bunny.net/reference/storage-api",
  "base_url": "https://{{ credentials.host }}/{{ credentials.zone }}",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "AccessKey",
      "fields": [
        {
          "key": "host",
          "label": "Storage region",
          "type": "select",
          "required": true,
          "default": "storage.bunnycdn.com",
          "options": [
            {
              "value": "storage.bunnycdn.com",
              "label": "Falkenstein (DE)"
            },
            {
              "value": "uk.storage.bunnycdn.com",
              "label": "London (UK)"
            },
            {
              "value": "se.storage.bunnycdn.com",
              "label": "Stockholm (SE)"
            },
            {
              "value": "ny.storage.bunnycdn.com",
              "label": "New York (US)"
            },
            {
              "value": "la.storage.bunnycdn.com",
              "label": "Los Angeles (US)"
            },
            {
              "value": "sg.storage.bunnycdn.com",
              "label": "Singapore (SG)"
            },
            {
              "value": "syd.storage.bunnycdn.com",
              "label": "Sydney (AU)"
            },
            {
              "value": "br.storage.bunnycdn.com",
              "label": "Sao Paulo (BR)"
            },
            {
              "value": "jh.storage.bunnycdn.com",
              "label": "Johannesburg (ZA)"
            }
          ],
          "help": "Main region of the storage zone."
        },
        {
          "key": "zone",
          "label": "Storage zone name",
          "type": "string",
          "required": true
        },
        {
          "key": "api_key",
          "label": "Storage zone password",
          "type": "password",
          "required": true,
          "help": "Storage zone > FTP & API Access > Password."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_files",
      "name": "List files",
      "method": "GET",
      "endpoint": "/{{ inputs.folder }}/",
      "inputs": [
        {
          "key": "folder",
          "label": "Folder",
          "type": "string",
          "help": "Folder inside the zone; leave empty for the root."
        }
      ]
    },
    {
      "key": "upload_file",
      "name": "Upload file",
      "description": "Creates or replaces a file with text content.",
      "method": "PUT",
      "endpoint": "/{{ inputs.folder }}/{{ inputs.file_name }}",
      "headers": {
        "Content-Type": "application/octet-stream"
      },
      "body": "{{ inputs.content }}",
      "inputs": [
        {
          "key": "folder",
          "label": "Folder",
          "type": "string",
          "help": "Folder inside the zone; leave empty for the root."
        },
        {
          "key": "file_name",
          "label": "File name",
          "type": "string",
          "required": true,
          "placeholder": "export.csv"
        },
        {
          "key": "content",
          "label": "Content",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "key": "get_file",
      "name": "Get file content",
      "method": "GET",
      "endpoint": "/{{ inputs.folder }}/{{ inputs.file_name }}",
      "inputs": [
        {
          "key": "folder",
          "label": "Folder",
          "type": "string",
          "help": "Folder inside the zone; leave empty for the root."
        },
        {
          "key": "file_name",
          "label": "File name",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "delete_file",
      "name": "Delete file",
      "method": "DELETE",
      "endpoint": "/{{ inputs.folder }}/{{ inputs.file_name }}",
      "inputs": [
        {
          "key": "folder",
          "label": "Folder",
          "type": "string",
          "help": "Folder inside the zone; leave empty for the root."
        },
        {
          "key": "file_name",
          "label": "File name",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
