{
  "key": "dingtalk",
  "name": "DingTalk",
  "category": "Communication",
  "description": "Post text, Markdown and link messages to a DingTalk group via a custom robot.",
  "brand": "dingtalk",
  "website": "https://www.dingtalk.com",
  "docs_url": "https://open.dingtalk.com/document/robots/custom-robot-access",
  "popular": true,
  "actions": [
    {
      "key": "send_text",
      "name": "Send text message",
      "method": "POST",
      "endpoint": "{{ inputs.webhook_url }}",
      "error_path": "errcode",
      "body": {
        "msgtype": "text",
        "text": { "content": "{{ inputs.content }}" },
        "at": { "atMobiles": "{{ inputs.at_mobiles }}", "isAtAll": "{{ inputs.at_all }}" }
      },
      "inputs": [
        { "key": "webhook_url", "label": "Robot webhook URL", "type": "password", "required": true, "placeholder": "https://oapi.dingtalk.com/robot/send?access_token=…", "help": "Group settings → Bots → Add Robot → Custom. Use keyword or IP security; signed (加签) robots are not supported." },
        { "key": "content", "label": "Message", "type": "text", "required": true, "help": "Must contain your keyword if the robot uses keyword security. To @mention, include @mobile in the text too." },
        { "key": "at_mobiles", "label": "Mention phone numbers", "type": "list" },
        { "key": "at_all", "label": "Mention everyone", "type": "boolean" }
      ]
    },
    {
      "key": "send_markdown",
      "name": "Send Markdown message",
      "method": "POST",
      "endpoint": "{{ inputs.webhook_url }}",
      "error_path": "errcode",
      "body": {
        "msgtype": "markdown",
        "markdown": { "title": "{{ inputs.title }}", "text": "{{ inputs.text }}" },
        "at": { "atMobiles": "{{ inputs.at_mobiles }}", "isAtAll": "{{ inputs.at_all }}" }
      },
      "inputs": [
        { "key": "webhook_url", "label": "Robot webhook URL", "type": "password", "required": true },
        { "key": "title", "label": "Title (shown in the chat list)", "type": "string", "required": true },
        { "key": "text", "label": "Markdown", "type": "text", "required": true },
        { "key": "at_mobiles", "label": "Mention phone numbers", "type": "list" },
        { "key": "at_all", "label": "Mention everyone", "type": "boolean" }
      ]
    },
    {
      "key": "send_link",
      "name": "Send link message",
      "method": "POST",
      "endpoint": "{{ inputs.webhook_url }}",
      "error_path": "errcode",
      "body": {
        "msgtype": "link",
        "link": { "title": "{{ inputs.title }}", "text": "{{ inputs.text }}", "messageUrl": "{{ inputs.message_url }}", "picUrl": "{{ inputs.pic_url }}" }
      },
      "inputs": [
        { "key": "webhook_url", "label": "Robot webhook URL", "type": "password", "required": true },
        { "key": "title", "label": "Title", "type": "string", "required": true },
        { "key": "text", "label": "Summary", "type": "text", "required": true },
        { "key": "message_url", "label": "Link URL", "type": "string", "required": true },
        { "key": "pic_url", "label": "Image URL", "type": "string" }
      ]
    }
  ]
}
