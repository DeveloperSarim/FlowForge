{
  "key": "firebase_cloud_messaging",
  "name": "Firebase Cloud Messaging",
  "category": "Communication",
  "description": "Send push notifications to app devices or topics with FCM HTTP v1.",
  "brand": "firebase",
  "website": "https://firebase.google.com/products/cloud-messaging",
  "docs_url": "https://firebase.google.com/docs/reference/fcm/rest/v1/projects.messages/send",
  "base_url": "https://fcm.googleapis.com/v1/projects/{{ credentials.project_id }}",
  "auth": [
    {
      "type": "google_service_account",
      "scopes": ["https://www.googleapis.com/auth/firebase.messaging"],
      "fields": [
        { "key": "project_id", "label": "Firebase project ID", "type": "string", "required": true },
        { "key": "service_account_json", "label": "Service Account JSON key", "type": "code", "required": true, "help": "Project settings > Service accounts > Generate new private key." }
      ]
    },
    {
      "type": "oauth2",
      "authorize_url": "https://accounts.google.com/o/oauth2/v2/auth",
      "token_url": "https://oauth2.googleapis.com/token",
      "scopes": ["https://www.googleapis.com/auth/firebase.messaging"],
      "authorize_params": { "access_type": "offline", "prompt": "consent" },
      "fields": [{ "key": "project_id", "label": "Firebase project ID", "type": "string", "required": true }]
    }
  ],
  "actions": [
    {
      "key": "send_message",
      "name": "Send notification",
      "method": "POST",
      "endpoint": "/messages:send",
      "body": {
        "message": {
          "token": "{{ inputs.token }}",
          "topic": "{{ inputs.topic }}",
          "condition": "{{ inputs.condition }}",
          "notification": { "title": "{{ inputs.title }}", "body": "{{ inputs.body }}", "image": "{{ inputs.image }}" },
          "data": "{{ inputs.data }}"
        }
      },
      "inputs": [
        { "key": "token", "label": "Device registration token", "type": "string", "help": "Set exactly one of token, topic or condition." },
        { "key": "topic", "label": "Or topic", "type": "string", "placeholder": "news" },
        { "key": "condition", "label": "Or condition", "type": "string", "placeholder": "'news' in topics && 'sports' in topics" },
        { "key": "title", "label": "Title", "type": "string" },
        { "key": "body", "label": "Body", "type": "text" },
        { "key": "image", "label": "Image URL", "type": "string" },
        { "key": "data", "label": "Data payload", "type": "keyvalue", "help": "String key/value pairs delivered to the app." }
      ]
    }
  ]
}
