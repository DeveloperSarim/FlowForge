{
  "key": "simplepush",
  "name": "Simplepush",
  "category": "Communication",
  "description": "Send push notifications to your phone with Simplepush.",
  "brand": "simplepush",
  "website": "https://simplepush.io",
  "docs_url": "https://simplepush.io/api",
  "base_url": "https://api.simplepush.io",
  "auth": [
    { "type": "api_key", "fields": [{ "key": "api_key", "label": "Simplepush key", "type": "password", "required": true, "help": "Shown in the Simplepush app." }] }
  ],
  "actions": [
    {
      "key": "send_notification",
      "name": "Send notification",
      "description": "End-to-end encrypted keys are not supported.",
      "method": "POST",
      "endpoint": "/send",
      "body_format": "form",
      "body": { "key": "{{ credentials.api_key }}", "title": "{{ inputs.title }}", "msg": "{{ inputs.message }}", "event": "{{ inputs.event }}" },
      "inputs": [
        { "key": "message", "label": "Message", "type": "text", "required": true },
        { "key": "title", "label": "Title", "type": "string" },
        { "key": "event", "label": "Event", "type": "string", "help": "Event name configured in the app (custom sound/vibration)." }
      ]
    }
  ]
}
