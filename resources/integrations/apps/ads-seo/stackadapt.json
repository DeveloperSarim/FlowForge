{
  "key": "stackadapt",
  "name": "StackAdapt",
  "category": "Ads & SEO",
  "description": "Query and manage StackAdapt campaigns and reports through its GraphQL API.",
  "brand": "stackadapt",
  "website": "https://www.stackadapt.com",
  "docs_url": "https://docs.stackadapt.com/",
  "base_url": "https://api.stackadapt.com",
  "auth": { "type": "bearer", "fields": [{ "key": "token", "label": "GraphQL API token", "type": "password", "required": true }] },
  "actions": [
    {
      "key": "graphql",
      "name": "Run GraphQL query",
      "method": "POST",
      "endpoint": "/graphql",
      "body": { "query": "{{ inputs.query }}", "variables": "{{ inputs.variables }}" },
      "error_path": "errors",
      "output_path": "data",
      "inputs": [
        { "key": "query", "label": "Query or mutation", "type": "code", "required": true },
        { "key": "variables", "label": "Variables", "type": "json" }
      ]
    }
  ]
}
