{
  "key": "hub_planner",
  "name": "Hub Planner",
  "category": "Project Management",
  "description": "Resource scheduling: list projects, resources and bookings, create projects.",
  "website": "https://hubplanner.com",
  "docs_url": "https://hubplanner.com/api/",
  "base_url": "https://api.hubplanner.com/v1",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "Authorization",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Hub Planner → Settings → Developer API → generate a key."
      }
    ]
  },
  "actions": [
    {
      "key": "list_projects",
      "name": "List projects",
      "description": "All projects.",
      "method": "GET",
      "endpoint": "/project",
      "query": {
        "limit": "{{ inputs.limit }}"
      },
      "output_fields": {
        "names": "*.name",
        "ids": "*._id"
      },
      "inputs": [
        {
          "key": "limit",
          "label": "Max results",
          "type": "number",
          "default": 50
        }
      ]
    },
    {
      "key": "create_project",
      "name": "Create project",
      "description": "Add a project.",
      "method": "POST",
      "endpoint": "/project",
      "body": {
        "name": "{{ inputs.name }}",
        "note": "{{ inputs.note }}"
      },
      "output_fields": {
        "id": "_id",
        "name": "name"
      },
      "inputs": [
        {
          "key": "name",
          "label": "Name",
          "type": "string",
          "required": true
        },
        {
          "key": "note",
          "label": "Note",
          "type": "text"
        }
      ]
    },
    {
      "key": "get_project",
      "name": "Get project",
      "description": "One project.",
      "method": "GET",
      "endpoint": "/project/{{ inputs.id }}",
      "output_fields": {
        "name": "name",
        "status": "status"
      },
      "inputs": [
        {
          "key": "id",
          "label": "Project ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_resources",
      "name": "List resources",
      "description": "People and equipment.",
      "method": "GET",
      "endpoint": "/resource",
      "query": {
        "limit": "{{ inputs.limit }}"
      },
      "output_fields": {
        "names": "*.name",
        "ids": "*._id"
      },
      "inputs": [
        {
          "key": "limit",
          "label": "Max results",
          "type": "number",
          "default": 50
        }
      ]
    },
    {
      "key": "list_bookings",
      "name": "List bookings",
      "description": "Scheduled bookings.",
      "method": "GET",
      "endpoint": "/booking",
      "query": {
        "limit": "{{ inputs.limit }}"
      },
      "output_fields": {
        "ids": "*._id"
      },
      "inputs": [
        {
          "key": "limit",
          "label": "Max results",
          "type": "number",
          "default": 50
        }
      ]
    }
  ]
}
