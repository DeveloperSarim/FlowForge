      "output_path": "data",
      "inputs": []
    },
    {
      "key": "list_booking_types",
      "name": "List booking types",
      "method": "GET",
      "endpoint": "/booking-types",
      "output_path": "data",
      "inputs": []
    },
    {
      "key": "list_contacts",
      "name": "List contacts",
      "method": "GET",
      "endpoint": "/contacts",
      "output_path": "data",
      "inputs": []
    }
  ]
}
