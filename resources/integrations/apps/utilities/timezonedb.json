{
  "key": "timezonedb",
  "name": "TimeZoneDB",
  "category": "Utilities",
  "description": "Look up time zones by name or coordinates and convert times between zones.",
  "brand": "timezonedb",
  "website": "https://timezonedb.com",
  "docs_url": "https://timezonedb.com/api",
  "base_url": "https://api.timezonedb.com/v2.1",
  "auth": { "type": "api_key", "in": "query", "name": "key", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "get_time_zone",
      "name": "Get time zone",
      "description": "Local time, offset and DST for a zone name or coordinates.",
      "method": "GET",
      "endpoint": "/get-time-zone",
      "query": { "format": "json", "by": "{{ inputs.by }}", "zone": "{{ inputs.zone }}", "lat": "{{ inputs.lat }}", "lng": "{{ inputs.lng }}", "time": "{{ inputs.time }}" },
      "inputs": [
        { "key": "by", "label": "Look up by", "type": "select", "required": true, "default": "zone", "options": [{ "value": "zone", "label": "Zone name" }, { "value": "position", "label": "Coordinates" }] },
        { "key": "zone", "label": "Zone name", "type": "string", "placeholder": "America/Chicago" },
        { "key": "lat", "label": "Latitude", "type": "number" },
        { "key": "lng", "label": "Longitude", "type": "number" },
        { "key": "time", "label": "At Unix time", "type": "number", "help": "Leave empty for now." }
      ]
    },
    {
      "key": "convert_time_zone",
      "name": "Convert time between zones",
      "method": "GET",
      "endpoint": "/convert-time-zone",
      "query": { "format": "json", "from": "{{ inputs.from }}", "to": "{{ inputs.to }}", "time": "{{ inputs.time }}" },
      "inputs": [
        { "key": "from", "label": "From zone", "type": "string", "required": true, "placeholder": "America/Los_Angeles" },
        { "key": "to", "label": "To zone", "type": "string", "required": true, "placeholder": "Australia/Sydney" },
        { "key": "time", "label": "Unix time", "type": "number", "help": "Leave empty for now." }
      ]
    },
    {
      "key": "list_time_zones",
      "name": "List time zones",
      "method": "GET",
      "endpoint": "/list-time-zone",
      "query": { "format": "json", "country": "{{ inputs.country }}", "zone": "{{ inputs.zone }}" },
      "output_path": "zones",
      "inputs": [
        { "key": "country", "label": "Country (ISO code)", "type": "string", "placeholder": "US" },
        { "key": "zone", "label": "Zone filter", "type": "string", "placeholder": "*New*" }
      ]
    }
  ]
}
