{
  "key": "frankfurter",
  "name": "Frankfurter",
  "category": "Utilities",
  "description": "Free ECB currency exchange rates: latest, historical and time series. No key needed.",
  "brand": "frankfurter",
  "website": "https://frankfurter.dev",
  "docs_url": "https://frankfurter.dev",
  "popular": true,
  "base_url": "https://api.frankfurter.dev/v1",
  "actions": [
    {
      "key": "latest_rates",
      "name": "Get latest rates",
      "method": "GET",
      "endpoint": "/latest",
      "query": { "base": "{{ inputs.base }}", "symbols": "{{ inputs.symbols }}", "amount": "{{ inputs.amount }}" },
      "inputs": [
        { "key": "base", "label": "Base currency", "type": "string", "placeholder": "EUR" },
        { "key": "symbols", "label": "Only these currencies", "type": "string", "placeholder": "USD,GBP" },
        { "key": "amount", "label": "Amount to convert", "type": "number" }
      ]
    },
    {
      "key": "historical_rates",
      "name": "Get rates on a date",
      "method": "GET",
      "endpoint": "/{{ inputs.date }}",
      "query": { "base": "{{ inputs.base }}", "symbols": "{{ inputs.symbols }}", "amount": "{{ inputs.amount }}" },
      "inputs": [
        { "key": "date", "label": "Date", "type": "string", "required": true, "placeholder": "2024-01-02" },
        { "key": "base", "label": "Base currency", "type": "string", "placeholder": "EUR" },
        { "key": "symbols", "label": "Only these currencies", "type": "string", "placeholder": "USD,GBP" },
        { "key": "amount", "label": "Amount to convert", "type": "number" }
      ]
    },
    {
      "key": "time_series",
      "name": "Get rates for a period",
      "method": "GET",
      "endpoint": "/{{ inputs.start_date }}..{{ inputs.end_date }}",
      "query": { "base": "{{ inputs.base }}", "symbols": "{{ inputs.symbols }}" },
      "inputs": [
        { "key": "start_date", "label": "Start date", "type": "string", "required": true, "placeholder": "2024-01-02" },
        { "key": "end_date", "label": "End date", "type": "string", "placeholder": "2024-01-31", "help": "Leave empty for up to today." },
        { "key": "base", "label": "Base currency", "type": "string", "placeholder": "EUR" },
        { "key": "symbols", "label": "Only these currencies", "type": "string", "placeholder": "USD" }
      ]
    },
    {
      "key": "currencies",
      "name": "List currencies",
      "method": "GET",
      "endpoint": "/currencies",
      "inputs": []
    }
  ]
}
