{
  "key": "weatherbit",
  "name": "Weatherbit",
  "category": "Utilities",
  "description": "Current weather, daily forecasts, severe weather alerts and air quality.",
  "brand": "weatherbit",
  "website": "https://www.weatherbit.io",
  "docs_url": "https://www.weatherbit.io/api",
  "base_url": "https://api.weatherbit.io/v2.0",
  "auth": { "type": "api_key", "in": "query", "name": "key", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "current",
      "name": "Get current weather",
      "method": "GET",
      "endpoint": "/current",
      "query": { "city": "{{ inputs.city }}", "lat": "{{ inputs.lat }}", "lon": "{{ inputs.lon }}", "postal_code": "{{ inputs.postal_code }}", "country": "{{ inputs.country }}", "units": "{{ inputs.units }}", "lang": "{{ inputs.lang }}" },
      "inputs": [
        { "key": "city", "label": "City", "type": "string", "placeholder": "Raleigh,NC", "help": "Give a city, lat + lon, or a postal code." },
        { "key": "lat", "label": "Latitude", "type": "number" },
        { "key": "lon", "label": "Longitude", "type": "number" },
        { "key": "postal_code", "label": "Postal code", "type": "string" },
        { "key": "country", "label": "Country", "type": "string", "placeholder": "US" },
        { "key": "units", "label": "Units", "type": "select", "options": [
          { "value": "M", "label": "Metric" }, { "value": "I", "label": "Imperial" }, { "value": "S", "label": "Scientific" }
        ] },
        { "key": "lang", "label": "Language", "type": "string" }
      ]
    },
    {
      "key": "daily_forecast",
      "name": "Get daily forecast",
      "method": "GET",
      "endpoint": "/forecast/daily",
      "query": { "city": "{{ inputs.city }}", "lat": "{{ inputs.lat }}", "lon": "{{ inputs.lon }}", "postal_code": "{{ inputs.postal_code }}", "country": "{{ inputs.country }}", "days": "{{ inputs.days }}", "units": "{{ inputs.units }}" },
      "inputs": [
        { "key": "city", "label": "City", "type": "string" },
        { "key": "lat", "label": "Latitude", "type": "number" },
        { "key": "lon", "label": "Longitude", "type": "number" },
        { "key": "postal_code", "label": "Postal code", "type": "string" },
        { "key": "country", "label": "Country", "type": "string" },
        { "key": "days", "label": "Days (1-16)", "type": "number" },
        { "key": "units", "label": "Units", "type": "select", "options": [
          { "value": "M", "label": "Metric" }, { "value": "I", "label": "Imperial" }, { "value": "S", "label": "Scientific" }
        ] }
      ]
    },
    {
      "key": "alerts",
      "name": "Get severe weather alerts",
      "method": "GET",
      "endpoint": "/alerts",
      "query": { "lat": "{{ inputs.lat }}", "lon": "{{ inputs.lon }}" },
      "inputs": [
        { "key": "lat", "label": "Latitude", "type": "number", "required": true },
        { "key": "lon", "label": "Longitude", "type": "number", "required": true }
      ]
    },
    {
      "key": "air_quality",
      "name": "Get current air quality",
      "method": "GET",
      "endpoint": "/current/airquality",
      "query": { "lat": "{{ inputs.lat }}", "lon": "{{ inputs.lon }}", "city": "{{ inputs.city }}", "postal_code": "{{ inputs.postal_code }}" },
      "inputs": [
        { "key": "lat", "label": "Latitude", "type": "number" },
        { "key": "lon", "label": "Longitude", "type": "number" },
        { "key": "city", "label": "City", "type": "string" },
        { "key": "postal_code", "label": "Postal code", "type": "string" }
      ]
    }
  ]
}
