{
  "key": "hygraph",
  "name": "Hygraph",
  "category": "CMS & Websites",
  "description": "Query and mutate content with the Hygraph GraphQL Content API.",
  "brand": "hygraph",
  "website": "https://hygraph.com",
  "docs_url": "https://hygraph.com/docs/api-reference",
  "base_url": "{{ credentials.endpoint }}",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "endpoint",
          "label": "Content API endpoint",
          "type": "string",
          "required": true,
          "placeholder": "https://<region>.cdn.hygraph.com/content/<id>/master",
          "help": "Project settings > Endpoints."
        },
        {
          "key": "token",
          "label": "Permanent auth token",
          "type": "password",
          "required": true
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "graphql",
      "name": "Run GraphQL query",
      "description": "Runs a GraphQL query or mutation.",
      "method": "POST",
      "endpoint": "{{ credentials.endpoint }}",
      "error_path": "errors",
      "output_path": "data",
      "body": {
        "query": "{{ inputs.query }}",
        "variables": "{{ inputs.variables }}"
      },
      "inputs": [
        {
          "key": "query",
          "label": "Query",
          "type": "code",
          "required": true
        },
        {
          "key": "variables",
          "label": "Variables (JSON)",
          "type": "json"
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "Hygraph webhooks (entry created, updated, published...).",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
