{
  "key": "craft_cms",
  "name": "Craft CMS",
  "category": "CMS & Websites",
  "description": "Query and mutate Craft CMS content through its GraphQL API.",
  "brand": "craftcms",
  "website": "https://craftcms.com",
  "docs_url": "https://craftcms.com/docs/5.x/development/graphql.html",
  "base_url": "{{ credentials.endpoint }}",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "endpoint",
          "label": "GraphQL endpoint",
          "type": "string",
          "required": true,
          "placeholder": "https://example.com/api",
          "help": "The route mapped to graphql/api (usually /api)."
        },
        {
          "key": "token",
          "label": "Schema access token",
          "type": "password",
          "required": true,
          "help": "GraphQL > Tokens."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "graphql",
      "name": "Run GraphQL query",
      "description": "Runs a GraphQL query or mutation.",
      "method": "POST",
      "endpoint": "{{ credentials.endpoint }}",
      "error_path": "errors",
      "output_path": "data",
      "body": {
        "query": "{{ inputs.query }}",
        "variables": "{{ inputs.variables }}"
      },
      "inputs": [
        {
          "key": "query",
          "label": "Query",
          "type": "code",
          "required": true
        },
        {
          "key": "variables",
          "label": "Variables (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
