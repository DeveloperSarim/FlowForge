{
  "key": "pdf_co",
  "name": "PDF.co",
  "category": "Files & Documents",
  "description": "Convert HTML or URLs to PDF, merge PDFs and extract text.",
  "brand": "pdfco",
  "website": "https://pdf.co",
  "docs_url": "https://developer.pdf.co/",
  "base_url": "https://api.pdf.co/v1",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "x-api-key"
    }
  ],
  "actions": [
    {
      "key": "html_to_pdf",
      "name": "HTML to PDF",
      "method": "POST",
      "endpoint": "/pdf/convert/from/html",
      "error_path": "error",
      "output_fields": {
        "file_url": "url"
      },
      "body": {
        "html": "{{ inputs.html }}",
        "name": "{{ inputs.name }}",
        "paperSize": "{{ inputs.paper_size }}",
        "orientation": "{{ inputs.orientation }}",
        "async": false
      },
      "inputs": [
        {
          "key": "html",
          "label": "HTML",
          "type": "code",
          "required": true
        },
        {
          "key": "name",
          "label": "File name",
          "type": "string",
          "placeholder": "invoice.pdf"
        },
        {
          "key": "paper_size",
          "label": "Paper size",
          "type": "select",
          "options": [
            {
              "value": "Letter",
              "label": "Letter"
            },
            {
              "value": "A4",
              "label": "A4"
            },
            {
              "value": "Legal",
              "label": "Legal"
            }
          ]
        },
        {
          "key": "orientation",
          "label": "Orientation",
          "type": "select",
          "options": [
            {
              "value": "Portrait",
              "label": "Portrait"
            },
            {
              "value": "Landscape",
              "label": "Landscape"
            }
          ]
        }
      ]
    },
    {
      "key": "url_to_pdf",
      "name": "URL to PDF",
      "method": "POST",
      "endpoint": "/pdf/convert/from/url",
      "error_path": "error",
      "body": {
        "url": "{{ inputs.url }}",
        "name": "{{ inputs.name }}",
        "paperSize": "{{ inputs.paper_size }}",
        "orientation": "{{ inputs.orientation }}",
        "async": false
      },
      "inputs": [
        {
          "key": "url",
          "label": "Page URL",
          "type": "string",
          "required": true
        },
        {
          "key": "name",
          "label": "File name",
          "type": "string"
        },
        {
          "key": "paper_size",
          "label": "Paper size",
          "type": "select",
          "options": [
            {
              "value": "Letter",
              "label": "Letter"
            },
            {
              "value": "A4",
              "label": "A4"
            },
            {
              "value": "Legal",
              "label": "Legal"
            }
          ]
        },
        {
          "key": "orientation",
          "label": "Orientation",
          "type": "select",
          "options": [
            {
              "value": "Portrait",
              "label": "Portrait"
            },
            {
              "value": "Landscape",
              "label": "Landscape"
            }
          ]
        }
      ]
    },
    {
      "key": "pdf_to_text",
      "name": "Extract text from PDF",
      "method": "POST",
      "endpoint": "/pdf/convert/to/text",
      "error_path": "error",
      "body": {
        "url": "{{ inputs.url }}",
        "pages": "{{ inputs.pages }}",
        "inline": true,
        "async": false
      },
      "inputs": [
        {
          "key": "url",
          "label": "PDF URL",
          "type": "string",
          "required": true
        },
        {
          "key": "pages",
          "label": "Pages",
          "type": "string",
          "placeholder": "0-2",
          "help": "0-based. Empty = all pages."
        }
      ]
    },
    {
      "key": "merge_pdfs",
      "name": "Merge PDFs",
      "method": "POST",
      "endpoint": "/pdf/merge",
      "error_path": "error",
      "body": {
        "url": "{{ inputs.urls }}",
        "name": "{{ inputs.name }}",
        "async": false
      },
      "inputs": [
        {
          "key": "urls",
          "label": "PDF URLs (comma-separated)",
          "type": "string",
          "required": true
        },
        {
          "key": "name",
          "label": "File name",
          "type": "string"
        }
      ]
    },
    {
      "key": "pdf_info",
      "name": "Get PDF info",
      "method": "POST",
      "endpoint": "/pdf/info",
      "error_path": "error",
      "body": {
        "url": "{{ inputs.url }}"
      },
      "inputs": [
        {
          "key": "url",
          "label": "PDF URL",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
