{
  "key": "opensign",
  "name": "OpenSign",
  "category": "Files & Documents",
  "description": "Read templates, documents and account info from OpenSign.",
  "brand": "opensign",
  "website": "https://www.opensignlabs.com",
  "docs_url": "https://docs.opensignlabs.com/docs/API-docs/v1.2/intro",
  "base_url": "{{ credentials.base_url }}",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "x-api-token",
      "fields": [
        {
          "key": "base_url",
          "label": "API URL",
          "type": "string",
          "required": true,
          "default": "https://app.opensignlabs.com/api/v1.2",
          "help": "Use https://sandbox.opensignlabs.com/api/v1.2 for sandbox tokens."
        },
        {
          "key": "api_key",
          "label": "API token",
          "type": "password",
          "required": true,
          "help": "Settings > API token."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "get_user",
      "name": "Get account",
      "method": "GET",
      "endpoint": "/getuser",
      "inputs": []
    },
    {
      "key": "list_templates",
      "name": "List templates",
      "method": "GET",
      "endpoint": "/templatelist",
      "inputs": []
    },
    {
      "key": "get_document",
      "name": "Get document",
      "method": "GET",
      "endpoint": "/document/{{ inputs.document_id }}",
      "inputs": [
        {
          "key": "document_id",
          "label": "Document ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
