{
  "key": "papertrail",
  "name": "Papertrail",
  "category": "Developer Tools",
  "description": "Search log events and list systems, groups and saved searches.",
  "brand": "papertrail",
  "website": "https://www.papertrail.com",
  "docs_url": "https://www.papertrail.com/help/http-api/",
  "base_url": "https://papertrailapp.com/api/v1",
  "auth": { "type": "api_key", "in": "header", "name": "X-Papertrail-Token", "fields": [
    { "key": "api_key", "label": "API token", "type": "password", "required": true, "help": "Settings → Profile → API Token." }
  ] },
  "actions": [
    {
      "key": "search_events",
      "name": "Search events",
      "method": "GET",
      "endpoint": "/events/search.json",
      "query": { "q": "{{ inputs.q }}", "system_id": "{{ inputs.system_id }}", "group_id": "{{ inputs.group_id }}", "min_time": "{{ inputs.min_time }}", "max_time": "{{ inputs.max_time }}", "limit": "{{ inputs.limit }}" },
      "output_path": "events",
      "inputs": [
        { "key": "q", "label": "Search query", "type": "string", "placeholder": "error OR \"timed out\"" },
        { "key": "system_id", "label": "System ID", "type": "string" },
        { "key": "group_id", "label": "Group ID", "type": "string" },
        { "key": "min_time", "label": "From (Unix seconds)", "type": "number" },
        { "key": "max_time", "label": "To (Unix seconds)", "type": "number" },
        { "key": "limit", "label": "Limit", "type": "number", "help": "Up to 10000." }
      ]
    },
    {
      "key": "list_systems",
      "name": "List systems",
      "method": "GET",
      "endpoint": "/systems.json",
      "inputs": []
    },
    {
      "key": "list_groups",
      "name": "List groups",
      "method": "GET",
      "endpoint": "/groups.json",
      "inputs": []
    },
    {
      "key": "list_saved_searches",
      "name": "List saved searches",
      "method": "GET",
      "endpoint": "/saved_searches.json",
      "inputs": []
    }
  ],
  "triggers": [
    {
      "key": "search_alert",
      "name": "Search alert (webhook)",
      "type": "webhook",
      "inputs": [{ "key": "sample_payload", "label": "Test payload (JSON)", "type": "json" }]
    }
  ]
}
