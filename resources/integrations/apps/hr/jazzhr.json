{
  "key": "jazzhr",
  "name": "JazzHR",
  "category": "HR & Recruiting",
  "description": "Read jobs and applicants from JazzHR.",
  "brand": "jazzhr",
  "website": "https://www.jazzhr.com",
  "docs_url": "https://www.resumatorapi.com/v1/",
  "base_url": "https://api.resumatorapi.com/v1",
  "auth": [
    {
      "type": "api_key",
      "in": "query",
      "name": "apikey",
      "fields": [
        {
          "key": "api_key",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Settings > Integrations."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_jobs",
      "name": "List jobs",
      "method": "GET",
      "endpoint": "/jobs",
      "inputs": []
    },
    {
      "key": "list_applicants",
      "name": "List applicants",
      "method": "GET",
      "endpoint": "/applicants",
      "inputs": []
    },
    {
      "key": "get_applicant",
      "name": "Get applicant",
      "method": "GET",
      "endpoint": "/applicants/{{ inputs.applicant_id }}",
      "inputs": [
        {
          "key": "applicant_id",
          "label": "Applicant ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
