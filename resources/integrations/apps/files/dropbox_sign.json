{
  "key": "dropbox_sign",
  "name": "Dropbox Sign",
  "category": "Files & Documents",
  "description": "Send documents or templates for e-signature and track requests.",
  "brand": "dropbox",
  "website": "https://sign.dropbox.com",
  "docs_url": "https://developers.hellosign.com/api/reference/",
  "base_url": "https://api.hellosign.com/v3",
  "auth": [
    {
      "type": "basic",
      "fields": [
        {
          "key": "username",
          "label": "API key",
          "type": "password",
          "required": true
        },
        {
          "key": "password",
          "label": "Password",
          "type": "password",
          "required": false,
          "default": "",
          "help": "Leave empty."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "send_signature_request",
      "name": "Send signature request",
      "method": "POST",
      "endpoint": "/signature_request/send",
      "body": {
        "title": "{{ inputs.title }}",
        "subject": "{{ inputs.subject }}",
        "message": "{{ inputs.message }}",
        "signers": "{{ inputs.signers }}",
        "file_urls": "{{ inputs.file_urls }}",
        "test_mode": "{{ inputs.test_mode }}"
      },
      "inputs": [
        {
          "key": "file_urls",
          "label": "File URLs",
          "type": "list",
          "required": true,
          "help": "Public URLs of the PDFs to sign."
        },
        {
          "key": "signers",
          "label": "Signers (JSON)",
          "type": "json",
          "required": true,
          "placeholder": "[{ \"email_address\": \"jane@example.com\", \"name\": \"Jane Doe\" }]"
        },
        {
          "key": "title",
          "label": "Title",
          "type": "string"
        },
        {
          "key": "subject",
          "label": "Email subject",
          "type": "string"
        },
        {
          "key": "message",
          "label": "Message",
          "type": "text"
        },
        {
          "key": "test_mode",
          "label": "Test mode",
          "type": "boolean",
          "default": false
        }
      ]
    },
    {
      "key": "send_with_template",
      "name": "Send with template",
      "method": "POST",
      "endpoint": "/signature_request/send_with_template",
      "body": {
        "template_ids": "{{ inputs.template_ids }}",
        "subject": "{{ inputs.subject }}",
        "message": "{{ inputs.message }}",
        "signers": "{{ inputs.signers }}",
        "custom_fields": "{{ inputs.custom_fields }}",
        "test_mode": "{{ inputs.test_mode }}"
      },
      "inputs": [
        {
          "key": "template_ids",
          "label": "Template IDs",
          "type": "list",
          "required": true
        },
        {
          "key": "signers",
          "label": "Signers (JSON)",
          "type": "json",
          "required": true,
          "placeholder": "[{ \"role\": \"Client\", \"email_address\": \"jane@example.com\", \"name\": \"Jane Doe\" }]"
        },
        {
          "key": "custom_fields",
          "label": "Custom fields (JSON)",
          "type": "json",
          "placeholder": "[{ \"name\": \"Company\", \"value\": \"Acme\" }]"
        },
        {
          "key": "subject",
          "label": "Email subject",
          "type": "string"
        },
        {
          "key": "message",
          "label": "Message",
          "type": "text"
        },
        {
          "key": "test_mode",
          "label": "Test mode",
          "type": "boolean",
          "default": false
        }
      ]
    },
    {
      "key": "get_signature_request",
      "name": "Get signature request",
      "method": "GET",
      "endpoint": "/signature_request/{{ inputs.signature_request_id }}",
      "output_path": "signature_request",
      "inputs": [
        {
          "key": "signature_request_id",
          "label": "Signature request ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_signature_requests",
      "name": "List signature requests",
      "method": "GET",
      "endpoint": "/signature_request/list",
      "query": {
        "query": "{{ inputs.query }}",
        "page_size": "{{ inputs.page_size }}"
      },
      "output_path": "signature_requests",
      "inputs": [
        {
          "key": "query",
          "label": "Search",
          "type": "string",
          "placeholder": "complete:true"
        },
        {
          "key": "page_size",
          "label": "Page size",
          "type": "number",
          "default": 20
        }
      ]
    },
    {
      "key": "cancel_signature_request",
      "name": "Cancel signature request",
      "method": "POST",
      "endpoint": "/signature_request/cancel/{{ inputs.signature_request_id }}",
      "inputs": [
        {
          "key": "signature_request_id",
          "label": "Signature request ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
