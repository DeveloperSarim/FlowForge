{
  "key": "moz",
  "name": "Moz",
  "category": "Analytics",
  "description": "Domain Authority, URL metrics, backlinks and linking domains (Links API v2).",
  "brand": "moz",
  "website": "https://moz.com",
  "docs_url": "https://moz.com/api/docs/links/getting-started",
  "base_url": "https://lsapi.seomoz.com/v2",
  "auth": { "type": "basic", "fields": [
    { "key": "username", "label": "Access ID", "type": "string", "required": true },
    { "key": "password", "label": "Secret key", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "url_metrics",
      "name": "URL metrics",
      "description": "Domain/Page Authority, spam score and link counts for up to 50 targets.",
      "method": "POST",
      "endpoint": "/url_metrics",
      "body": { "targets": "{{ inputs.targets }}" },
      "output_path": "results",
      "inputs": [{ "key": "targets", "label": "Targets", "type": "list", "required": true, "placeholder": "moz.com" }]
    },
    {
      "key": "links",
      "name": "Get backlinks",
      "method": "POST",
      "endpoint": "/links",
      "body": { "target": "{{ inputs.target }}", "target_scope": "{{ inputs.target_scope }}", "limit": "{{ inputs.limit }}" },
      "output_path": "results",
      "inputs": [
        { "key": "target", "label": "Target", "type": "string", "required": true },
        { "key": "target_scope", "label": "Scope", "type": "select", "required": true, "default": "root_domain", "options": [
          { "value": "page", "label": "Page" }, { "value": "subdomain", "label": "Subdomain" }, { "value": "root_domain", "label": "Root domain" }
        ] },
        { "key": "limit", "label": "Limit (max 50)", "type": "number", "default": 25 }
      ]
    },
    {
      "key": "linking_root_domains",
      "name": "Get linking root domains",
      "method": "POST",
      "endpoint": "/linking_root_domains",
      "body": { "target": "{{ inputs.target }}", "target_scope": "{{ inputs.target_scope }}", "limit": "{{ inputs.limit }}" },
      "output_path": "results",
      "inputs": [
        { "key": "target", "label": "Target", "type": "string", "required": true },
        { "key": "target_scope", "label": "Scope", "type": "select", "required": true, "default": "root_domain", "options": [
          { "value": "page", "label": "Page" }, { "value": "subdomain", "label": "Subdomain" }, { "value": "root_domain", "label": "Root domain" }
        ] },
        { "key": "limit", "label": "Limit (max 50)", "type": "number", "default": 25 }
      ]
    }
  ]
}
