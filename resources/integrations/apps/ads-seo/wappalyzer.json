{
  "key": "wappalyzer",
  "name": "Wappalyzer",
  "category": "Ads & SEO",
  "description": "Identify the technologies on websites and check your credit balance.",
  "brand": "wappalyzer",
  "website": "https://www.wappalyzer.com",
  "docs_url": "https://www.wappalyzer.com/docs/api/v2/lookup/",
  "base_url": "https://api.wappalyzer.com/v2",
  "auth": { "type": "api_key", "in": "header", "name": "x-api-key" },
  "actions": [
    {
      "key": "lookup",
      "name": "Look up technologies",
      "method": "GET",
      "endpoint": "/lookup/",
      "query": { "urls": "{{ inputs.urls }}", "live": "{{ inputs.live }}" },
      "timeout": 60,
      "inputs": [
        { "key": "urls", "label": "URLs (comma-separated, max 10)", "type": "string", "required": true, "placeholder": "https://example.com" },
        { "key": "live", "label": "Live scan", "type": "select", "default": "false", "options": [
          { "value": "false", "label": "No, use cached data" }, { "value": "true", "label": "Yes, scan now" }
        ] }
      ]
    },
    {
      "key": "credit_balance",
      "name": "Get credit balance",
      "method": "GET",
      "endpoint": "/credits/balance/",
      "inputs": []
    }
  ]
}
