{
  "key": "tavily",
  "name": "Tavily",
  "category": "AI",
  "description": "Web search and page extraction built for AI agents.",
  "brand": "tavily",
  "website": "https://tavily.com",
  "docs_url": "https://docs.tavily.com/documentation/api-reference/endpoint/search",
  "base_url": "https://api.tavily.com",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key (tvly-...)",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "search",
      "name": "Search",
      "method": "POST",
      "endpoint": "/search",
      "timeout": 120,
      "body": {
        "query": "{{ inputs.query }}",
        "topic": "{{ inputs.topic }}",
        "search_depth": "{{ inputs.search_depth }}",
        "max_results": "{{ inputs.max_results }}",
        "include_answer": "{{ inputs.include_answer }}"
      },
      "output_fields": {
        "answer": "answer"
      },
      "inputs": [
        {
          "key": "query",
          "label": "Query",
          "type": "string",
          "required": true
        },
        {
          "key": "topic",
          "label": "Topic",
          "type": "select",
          "options": [
            {
              "value": "general",
              "label": "General"
            },
            {
              "value": "news",
              "label": "News"
            },
            {
              "value": "finance",
              "label": "Finance"
            }
          ]
        },
        {
          "key": "search_depth",
          "label": "Depth",
          "type": "select",
          "options": [
            {
              "value": "basic",
              "label": "Basic"
            },
            {
              "value": "advanced",
              "label": "Advanced"
            }
          ]
        },
        {
          "key": "max_results",
          "label": "Max results",
          "type": "number",
          "default": 5
        },
        {
          "key": "include_answer",
          "label": "Include AI answer",
          "type": "boolean"
        }
      ]
    },
    {
      "key": "extract",
      "name": "Extract pages",
      "method": "POST",
      "endpoint": "/extract",
      "timeout": 120,
      "body": {
        "urls": "{{ inputs.urls }}"
      },
      "inputs": [
        {
          "key": "urls",
          "label": "URLs",
          "type": "list",
          "required": true
        }
      ]
    }
  ]
}
