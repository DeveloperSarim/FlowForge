{
  "key": "kustomer",
  "name": "Kustomer",
  "category": "Customer Support",
  "description": "Create and look up Kustomer customers and conversations.",
  "brand": "kustomer",
  "website": "https://www.kustomer.com",
  "docs_url": "https://developer.kustomer.com/",
  "base_url": "https://api.kustomerapp.com/v1",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Settings > Security > API Keys"
      }
    ]
  },
  "actions": [
    {
      "key": "create_customer",
      "name": "Create customer",
      "method": "POST",
      "endpoint": "/customers",
      "output_path": "data",
      "body": {
        "name": "{{ inputs.name }}",
        "externalId": "{{ inputs.external_id }}",
        "emails": [
          {
            "type": "home",
            "email": "{{ inputs.email }}"
          }
        ]
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "name",
          "label": "Name",
          "type": "string"
        },
        {
          "key": "external_id",
          "label": "External ID",
          "type": "string"
        }
      ]
    },
    {
      "key": "get_customer",
      "name": "Get customer",
      "method": "GET",
      "endpoint": "/customers/{{ inputs.customer_id }}",
      "output_path": "data",
      "inputs": [
        {
          "key": "customer_id",
          "label": "Customer ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "get_conversation",
      "name": "Get conversation",
      "method": "GET",
      "endpoint": "/conversations/{{ inputs.conversation_id }}",
      "output_path": "data",
      "inputs": [
        {
          "key": "conversation_id",
          "label": "Conversation ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "Create an outbound webhook in Kustomer pointing at this URL.",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
