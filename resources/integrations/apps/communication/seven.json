{
  "key": "seven",
  "name": "seven",
  "category": "Communication",
  "description": "Send SMS and text-to-speech calls and check your balance with seven.io.",
  "brand": "seven",
  "website": "https://www.seven.io",
  "docs_url": "https://docs.seven.io/en/rest-api/endpoints/sms",
  "base_url": "https://gateway.seven.io/api",
  "auth": [
    { "type": "api_key", "in": "header", "name": "X-Api-Key", "fields": [{ "key": "api_key", "label": "API key", "type": "password", "required": true }] }
  ],
  "actions": [
    {
      "key": "send_sms",
      "name": "Send SMS",
      "method": "POST",
      "endpoint": "/sms",
      "body": { "to": "{{ inputs.to }}", "text": "{{ inputs.text }}", "from": "{{ inputs.from }}" },
      "inputs": [
        { "key": "to", "label": "To", "type": "string", "required": true, "placeholder": "+491771783130", "help": "Comma-separate several numbers." },
        { "key": "text", "label": "Message", "type": "text", "required": true },
        { "key": "from", "label": "From (sender ID)", "type": "string" }
      ]
    },
    {
      "key": "voice_call",
      "name": "Text-to-speech call",
      "method": "POST",
      "endpoint": "/voice",
      "body": { "to": "{{ inputs.to }}", "text": "{{ inputs.text }}", "from": "{{ inputs.from }}" },
      "inputs": [
        { "key": "to", "label": "To", "type": "string", "required": true },
        { "key": "text", "label": "Text to read out", "type": "text", "required": true },
        { "key": "from", "label": "From (caller ID)", "type": "string" }
      ]
    },
    {
      "key": "get_balance",
      "name": "Get balance",
      "method": "GET",
      "endpoint": "/balance",
      "inputs": []
    }
  ]
}
