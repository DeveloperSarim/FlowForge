{
  "key": "overseerr",
  "name": "Overseerr",
  "category": "Video & Media",
  "description": "Search movies and shows, make and approve media requests in your Overseerr.",
  "website": "https://overseerr.dev",
  "docs_url": "https://api-docs.overseerr.dev",
  "base_url": "{{ credentials.server_url }}/api/v1",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "X-Api-Key",
    "fields": [
      {
        "key": "server_url",
        "label": "Overseerr URL",
        "type": "string",
        "required": true,
        "placeholder": "http://192.168.1.10:5055",
        "help": "The address you open the app at, with http:// and the port, no trailing slash."
      },
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Overseerr > Settings > General > API Key."
      }
    ]
  },
  "actions": [
    {
      "key": "search",
      "name": "Search",
      "description": "Search movies, shows and people.",
      "method": "GET",
      "endpoint": "/search",
      "query": {
        "query": "{{ inputs.query }}"
      },
      "output_fields": {
        "results": "results",
        "ids": "results.*.id"
      },
      "inputs": [
        {
          "key": "query",
          "label": "Search",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_requests",
      "name": "List requests",
      "description": "Get media requests.",
      "method": "GET",
      "endpoint": "/request",
      "query": {
        "take": "{{ inputs.take }}",
        "filter": "{{ inputs.filter }}"
      },
      "output_fields": {
        "requests": "results",
        "ids": "results.*.id"
      },
      "inputs": [
        {
          "key": "take",
          "label": "Max results",
          "type": "number",
          "default": 20
        },
        {
          "key": "filter",
          "label": "Filter",
          "type": "select",
          "default": "all",
          "options": [
            {
              "value": "all",
              "label": "All"
            },
            {
              "value": "pending",
              "label": "Pending"
            },
            {
              "value": "approved",
              "label": "Approved"
            },
            {
              "value": "available",
              "label": "Available"
            },
            {
              "value": "processing",
              "label": "Processing"
            }
          ]
        }
      ]
    },
    {
      "key": "create_request",
      "name": "Request a movie or show",
      "description": "Request media (TMDB ID).",
      "method": "POST",
      "endpoint": "/request",
      "body": {
        "mediaType": "{{ inputs.media_type }}",
        "mediaId": "{{ inputs.media_id }}",
        "seasons": "{{ inputs.seasons }}"
      },
      "output_fields": {
        "id": "id",
        "status": "status"
      },
      "inputs": [
        {
          "key": "media_type",
          "label": "Type",
          "type": "select",
          "required": true,
          "default": "movie",
          "options": [
            {
              "value": "movie",
              "label": "Movie"
            },
            {
              "value": "tv",
              "label": "TV show"
            }
          ]
        },
        {
          "key": "media_id",
          "label": "TMDB ID",
          "type": "number",
          "required": true,
          "help": "The number in the TMDB address, e.g. 603 for The Matrix."
        },
        {
          "key": "seasons",
          "label": "Seasons",
          "type": "string",
          "help": "For shows: 'all' or a list like [1,2]. Leave empty for movies."
        }
      ]
    },
    {
      "key": "approve_request",
      "name": "Approve a request",
      "description": "Approve a pending request.",
      "method": "POST",
      "endpoint": "/request/{{ inputs.request_id }}/approve",
      "inputs": [
        {
          "key": "request_id",
          "label": "Request ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "status",
      "name": "Server status",
      "description": "Check Overseerr is up and its version.",
      "method": "GET",
      "endpoint": "/status",
      "output_fields": {
        "version": "version"
      },
      "inputs": []
    }
  ]
}
