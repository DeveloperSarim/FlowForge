{
  "key": "twist",
  "name": "Twist",
  "category": "Communication",
  "description": "Start threads, post comments and send conversation messages in Twist.",
  "brand": "twist",
  "website": "https://twist.com",
  "docs_url": "https://developer.twist.com/v3/",
  "base_url": "https://api.twist.com/api/v3",
  "auth": [
    { "type": "bearer", "fields": [{ "key": "token", "label": "OAuth test token", "type": "password", "required": true, "help": "Create a General integration in Twist → Integrations → Build, then copy its OAuth 2 test token." }] },
    {
      "type": "oauth2",
      "authorize_url": "https://twist.com/oauth/authorize",
      "token_url": "https://twist.com/oauth/access_token",
      "scopes": ["user:read", "workspaces:read", "channels:read", "threads:write", "comments:write", "messages:write"],
      "scope_separator": ","
    }
  ],
  "actions": [
    {
      "key": "create_thread",
      "name": "Create thread",
      "method": "POST",
      "endpoint": "/threads/add",
      "body_format": "form",
      "body": { "channel_id": "{{ inputs.channel_id }}", "title": "{{ inputs.title }}", "content": "{{ inputs.content }}" },
      "inputs": [
        { "key": "channel_id", "label": "Channel ID", "type": "number", "required": true },
        { "key": "title", "label": "Title", "type": "string", "required": true },
        { "key": "content", "label": "Content (Markdown)", "type": "text", "required": true }
      ]
    },
    {
      "key": "add_comment",
      "name": "Add comment to thread",
      "method": "POST",
      "endpoint": "/comments/add",
      "body_format": "form",
      "body": { "thread_id": "{{ inputs.thread_id }}", "content": "{{ inputs.content }}" },
      "inputs": [
        { "key": "thread_id", "label": "Thread ID", "type": "number", "required": true },
        { "key": "content", "label": "Comment (Markdown)", "type": "text", "required": true }
      ]
    },
    {
      "key": "send_conversation_message",
      "name": "Send conversation message",
      "method": "POST",
      "endpoint": "/conversation_messages/add",
      "body_format": "form",
      "body": { "conversation_id": "{{ inputs.conversation_id }}", "content": "{{ inputs.content }}" },
      "inputs": [
        { "key": "conversation_id", "label": "Conversation ID", "type": "number", "required": true },
        { "key": "content", "label": "Message (Markdown)", "type": "text", "required": true }
      ]
    },
    {
      "key": "list_channels",
      "name": "List channels",
      "method": "GET",
      "endpoint": "/channels/get",
      "query": { "workspace_id": "{{ inputs.workspace_id }}" },
      "inputs": [
        { "key": "workspace_id", "label": "Workspace ID", "type": "number", "required": true }
      ]
    },
    {
      "key": "list_workspaces",
      "name": "List workspaces",
      "method": "GET",
      "endpoint": "/workspaces/get",
      "inputs": []
    }
  ]
}
