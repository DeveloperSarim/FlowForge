{
  "key": "amazon_bedrock",
  "name": "Amazon Bedrock",
  "category": "AI",
  "description": "Chat with foundation models on Amazon Bedrock using a Bedrock API key.",
  "brand": "amazonaws",
  "website": "https://aws.amazon.com/bedrock/",
  "docs_url": "https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_Converse.html",
  "base_url": "https://bedrock-runtime.{{ credentials.region }}.amazonaws.com",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "region",
        "label": "Region",
        "type": "string",
        "required": true,
        "default": "us-east-1"
      },
      {
        "key": "token",
        "label": "Bedrock API key",
        "type": "password",
        "required": true,
        "help": "Bedrock console → API keys."
      }
    ]
  },
  "actions": [
    {
      "key": "converse",
      "name": "Chat completion",
      "description": "Send a prompt and get the reply as {{ steps.<id>.text }}.",
      "method": "POST",
      "endpoint": "/model/{{ inputs.model }}/converse",
      "timeout": 300,
      "body": {
        "messages": [
          {
            "role": "user",
            "content": [
              {
                "text": "{{ inputs.prompt }}"
              }
            ]
          }
        ],
        "system": [
          {
            "text": "{{ inputs.system }}"
          }
        ],
        "inferenceConfig": {
          "temperature": "{{ inputs.temperature }}",
          "maxTokens": "{{ inputs.max_tokens }}"
        }
      },
      "output_fields": {
        "text": "output.message.content.*.text"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "default": "us.anthropic.claude-sonnet-4-6",
          "help": "Model ID or inference profile ID available in your region."
        },
        {
          "key": "prompt",
          "label": "Prompt",
          "type": "text",
          "required": true
        },
        {
          "key": "system",
          "label": "System prompt",
          "type": "text",
          "required": true,
          "default": "You are a helpful assistant.",
          "help": "Sent as the system message."
        },
        {
          "key": "temperature",
          "label": "Temperature",
          "type": "number",
          "placeholder": "0.7"
        },
        {
          "key": "max_tokens",
          "label": "Max output tokens",
          "type": "number"
        }
      ]
    }
  ]
}
