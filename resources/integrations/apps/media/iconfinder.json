{
  "key": "iconfinder",
  "name": "Iconfinder",
  "category": "Video & Media",
  "description": "Search icons and look up icons and icon sets on Iconfinder.",
  "brand": "iconfinder",
  "website": "https://www.iconfinder.com",
  "docs_url": "https://developer.iconfinder.com/reference/overview-1",
  "base_url": "https://api.iconfinder.com/v4",
  "auth": { "type": "bearer", "fields": [
    { "key": "token", "label": "API key", "type": "password", "required": true, "help": "iconfinder.com/account/applications." }
  ] },
  "actions": [
    {
      "key": "search_icons",
      "name": "Search icons",
      "method": "GET",
      "endpoint": "/icons/search",
      "query": { "query": "{{ inputs.query }}", "count": "{{ inputs.count }}", "offset": "{{ inputs.offset }}" },
      "inputs": [
        { "key": "query", "label": "Search", "type": "string", "required": true },
        { "key": "count", "label": "Count (max 100)", "type": "number", "default": 20 },
        { "key": "offset", "label": "Offset", "type": "number" }
      ]
    },
    {
      "key": "get_icon",
      "name": "Get icon",
      "method": "GET",
      "endpoint": "/icons/{{ inputs.icon_id }}",
      "inputs": [{ "key": "icon_id", "label": "Icon ID", "type": "string", "required": true }]
    },
    {
      "key": "get_iconset",
      "name": "Get icon set",
      "method": "GET",
      "endpoint": "/iconsets/{{ inputs.iconset_id }}",
      "inputs": [{ "key": "iconset_id", "label": "Icon set ID", "type": "string", "required": true }]
    },
    {
      "key": "list_iconset_icons",
      "name": "List icons in a set",
      "method": "GET",
      "endpoint": "/iconsets/{{ inputs.iconset_id }}/icons",
      "query": { "count": "{{ inputs.count }}" },
      "inputs": [
        { "key": "iconset_id", "label": "Icon set ID", "type": "string", "required": true },
        { "key": "count", "label": "Count (max 100)", "type": "number", "default": 50 }
      ]
    }
  ]
}
