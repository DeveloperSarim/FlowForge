{
  "key": "cognito_forms",
  "name": "Cognito Forms",
  "category": "Forms & Surveys",
  "description": "List forms and create or read entries in Cognito Forms.",
  "brand": "cognitoforms",
  "website": "https://www.cognitoforms.com",
  "docs_url": "https://www.cognitoforms.com/support",
  "base_url": "https://www.cognitoforms.com/api",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Organization settings > Integrations > API keys"
      }
    ]
  },
  "actions": [
    {
      "key": "list_forms",
      "name": "List forms",
      "method": "GET",
      "endpoint": "/forms",
      "inputs": []
    },
    {
      "key": "get_entry",
      "name": "Get entry",
      "method": "GET",
      "endpoint": "/forms/{{ inputs.form }}/entries/{{ inputs.entry_id }}",
      "inputs": [
        {
          "key": "form",
          "label": "Form ID or internal name",
          "type": "string",
          "required": true
        },
        {
          "key": "entry_id",
          "label": "Entry number",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "create_entry",
      "name": "Create entry",
      "method": "POST",
      "endpoint": "/forms/{{ inputs.form }}/entries",
      "body": "{{ inputs.entry }}",
      "inputs": [
        {
          "key": "form",
          "label": "Form ID or internal name",
          "type": "string",
          "required": true
        },
        {
          "key": "entry",
          "label": "Entry (JSON)",
          "type": "json",
          "required": true,
          "placeholder": "{\"Name\": {\"First\": \"Ada\", \"Last\": \"Lovelace\"}, \"Email\": \"ada@example.com\"}",
          "help": "Keys are the fields' internal names."
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "new_entry",
      "name": "New entry (webhook)",
      "type": "webhook",
      "description": "Form > Build > Submission Settings > Post JSON Data to a Website.",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
