{
  "key": "ipregistry",
  "name": "Ipregistry",
  "category": "Utilities",
  "description": "Look up IP location, company and VPN/threat data, and parse user agents.",
  "website": "https://ipregistry.co",
  "docs_url": "https://ipregistry.co/docs",
  "base_url": "https://api.ipregistry.co",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "dashboard.ipregistry.co → API Keys."
      }
    ]
  },
  "actions": [
    {
      "key": "lookup_ip",
      "name": "Look up IP address",
      "description": "Get the country, city, time zone, company and security flags of an IP.",
      "method": "GET",
      "endpoint": "/{{ inputs.ip }}",
      "output_fields": {
        "country": "location.country.name",
        "country_code": "location.country.code",
        "region": "location.region.name",
        "city": "location.city",
        "postal": "location.postal",
        "latitude": "location.latitude",
        "longitude": "location.longitude",
        "timezone": "time_zone.id",
        "currency": "currency.code",
        "company": "company.name",
        "asn": "connection.asn",
        "is_vpn": "security.is_vpn",
        "is_threat": "security.is_threat"
      },
      "inputs": [
        {
          "key": "ip",
          "label": "IP address",
          "type": "string",
          "required": true,
          "placeholder": "8.8.8.8"
        }
      ]
    },
    {
      "key": "check_ip_security",
      "name": "Check if IP is risky",
      "description": "Only the security flags: VPN, proxy, Tor, abuser, threat.",
      "method": "GET",
      "endpoint": "/{{ inputs.ip }}",
      "query": {
        "fields": "security"
      },
      "output_fields": {
        "is_vpn": "security.is_vpn",
        "is_proxy": "security.is_proxy",
        "is_tor": "security.is_tor",
        "is_abuser": "security.is_abuser",
        "is_attacker": "security.is_attacker",
        "is_threat": "security.is_threat"
      },
      "inputs": [
        {
          "key": "ip",
          "label": "IP address",
          "type": "string",
          "required": true,
          "placeholder": "8.8.8.8"
        }
      ]
    },
    {
      "key": "parse_user_agent",
      "name": "Parse user agent",
      "description": "Turn browser user agent strings into browser, OS and device details.",
      "method": "POST",
      "endpoint": "/user_agent",
      "body": "{{ inputs.user_agents }}",
      "output_fields": {
        "browser": "results.0.name",
        "browser_version": "results.0.version",
        "os": "results.0.os.name",
        "device_type": "results.0.device.type"
      },
      "inputs": [
        {
          "key": "user_agents",
          "label": "User agent strings",
          "type": "list",
          "required": true,
          "help": "One user agent per row."
        }
      ]
    }
  ]
}
