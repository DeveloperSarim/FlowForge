{
  "key": "docspring",
  "name": "DocSpring",
  "category": "Files & Documents",
  "description": "Fill PDF templates with data and get the generated PDF.",
  "brand": "docspring",
  "website": "https://docspring.com",
  "docs_url": "https://docspring.com/docs/api/",
  "base_url": "https://api.docspring.com/api/v1",
  "auth": [
    {
      "type": "basic",
      "fields": [
        {
          "key": "username",
          "label": "API token ID",
          "type": "string",
          "required": true
        },
        {
          "key": "password",
          "label": "API token secret",
          "type": "password",
          "required": true
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "generate_pdf",
      "name": "Generate PDF",
      "method": "POST",
      "endpoint": "/templates/{{ inputs.template_id }}/submissions",
      "body": {
        "data": "{{ inputs.data }}",
        "test": "{{ inputs.test }}",
        "metadata": "{{ inputs.metadata }}"
      },
      "inputs": [
        {
          "key": "template_id",
          "label": "Template ID",
          "type": "string",
          "required": true
        },
        {
          "key": "data",
          "label": "Field values (JSON)",
          "type": "json",
          "required": true
        },
        {
          "key": "metadata",
          "label": "Metadata (JSON)",
          "type": "json"
        },
        {
          "key": "test",
          "label": "Test mode",
          "type": "boolean",
          "default": true
        }
      ]
    },
    {
      "key": "get_submission",
      "name": "Get submission",
      "method": "GET",
      "endpoint": "/submissions/{{ inputs.submission_id }}",
      "inputs": [
        {
          "key": "submission_id",
          "label": "Submission ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
