{
  "key": "survicate",
  "name": "Survicate",
  "category": "Forms & Surveys",
  "description": "Call the Survicate data export API and trigger on new survey responses.",
  "brand": "survicate",
  "website": "https://survicate.com",
  "docs_url": "https://developers.survicate.com/",
  "base_url": "https://data-api.survicate.com/v2",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "Authorization",
    "prefix": "Basic ",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Settings > Access keys > Data Export API"
      }
    ]
  },
  "triggers": [
    {
      "key": "new_response",
      "name": "New response (webhook)",
      "type": "webhook",
      "description": "Survey > Connect > Webhooks, paste this URL.",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ],
  "actions": []
}
