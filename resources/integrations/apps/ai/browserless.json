{
  "key": "browserless",
  "name": "Browserless",
  "category": "AI",
  "description": "Render pages in headless Chrome and scrape elements.",
  "brand": "browserless",
  "website": "https://www.browserless.io",
  "docs_url": "https://docs.browserless.io",
  "base_url": "https://production-sfo.browserless.io",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "token",
    "fields": [
      {
        "key": "api_key",
        "label": "API token",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "get_content",
      "name": "Get rendered HTML",
      "method": "POST",
      "endpoint": "/content",
      "timeout": 120,
      "body": {
        "url": "{{ inputs.url }}"
      },
      "inputs": [
        {
          "key": "url",
          "label": "URL",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "scrape",
      "name": "Scrape elements",
      "method": "POST",
      "endpoint": "/scrape",
      "timeout": 120,
      "body": {
        "url": "{{ inputs.url }}",
        "elements": "{{ inputs.elements }}"
      },
      "inputs": [
        {
          "key": "url",
          "label": "URL",
          "type": "string",
          "required": true
        },
        {
          "key": "elements",
          "label": "Elements (JSON)",
          "type": "json",
          "required": true,
          "placeholder": "[{\"selector\": \"h1\"}]"
        }
      ]
    }
  ]
}
