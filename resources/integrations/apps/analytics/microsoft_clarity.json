{
  "key": "microsoft_clarity",
  "name": "Microsoft Clarity",
  "category": "Analytics",
  "description": "Export dashboard insights (traffic, scroll depth, rage clicks) for the last 1-3 days.",
  "brand": "microsoftclarity",
  "website": "https://clarity.microsoft.com",
  "docs_url": "https://learn.microsoft.com/en-us/clarity/setup-and-installation/clarity-data-export-api",
  "base_url": "https://www.clarity.ms/export-data/api/v1",
  "auth": { "type": "bearer", "fields": [{ "key": "token", "label": "API token", "type": "password", "required": true, "help": "Project Settings > Data Export > Generate new API token (admins only)." }] },
  "actions": [
    {
      "key": "get_live_insights",
      "name": "Get project insights",
      "description": "Limited to 10 calls per project per day.",
      "method": "GET",
      "endpoint": "/project-live-insights",
      "query": { "numOfDays": "{{ inputs.num_of_days }}", "dimension1": "{{ inputs.dimension1 }}", "dimension2": "{{ inputs.dimension2 }}", "dimension3": "{{ inputs.dimension3 }}" },
      "inputs": [
        { "key": "num_of_days", "label": "Period", "type": "select", "required": true, "default": "1", "options": [
          { "value": "1", "label": "Last 24 hours" }, { "value": "2", "label": "Last 48 hours" }, { "value": "3", "label": "Last 72 hours" }
        ] },
        { "key": "dimension1", "label": "Break down by", "type": "string", "placeholder": "OS", "help": "Browser, Device, Country/Region, OS, Source, Medium, Campaign, Channel or URL" },
        { "key": "dimension2", "label": "Second dimension", "type": "string" },
        { "key": "dimension3", "label": "Third dimension", "type": "string" }
      ]
    }
  ]
}
