{
  "key": "teamleader",
  "name": "Teamleader Focus",
  "category": "CRM & Sales",
  "description": "Add and look up contacts and companies in Teamleader Focus.",
  "brand": "teamleader",
  "website": "https://www.teamleader.eu",
  "docs_url": "https://developer.focus.teamleader.eu/",
  "base_url": "https://api.focus.teamleader.eu",
  "auth": [
    {
      "type": "oauth2",
      "authorize_url": "https://focus.teamleader.eu/oauth2/authorize",
      "token_url": "https://focus.teamleader.eu/oauth2/access_token",
      "scopes": []
    }
  ],
  "actions": [
    {
      "key": "add_contact",
      "name": "Add contact",
      "method": "POST",
      "endpoint": "/contacts.add",
      "body": {
        "first_name": "{{ inputs.first_name }}",
        "last_name": "{{ inputs.last_name }}",
        "emails": [
          {
            "type": "primary",
            "email": "{{ inputs.email }}"
          }
        ]
      },
      "output_path": "data",
      "inputs": [
        {
          "key": "first_name",
          "label": "First name",
          "type": "string"
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "get_contact",
      "name": "Get contact",
      "method": "POST",
      "endpoint": "/contacts.info",
      "body": {
        "id": "{{ inputs.id }}"
      },
      "output_path": "data",
      "inputs": [
        {
          "key": "id",
          "label": "Contact ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "find_contact",
      "name": "Find contacts by email",
      "method": "POST",
      "endpoint": "/contacts.list",
      "body": {
        "filter": {
          "email": {
            "type": "primary",
            "email": "{{ inputs.email }}"
          }
        }
      },
      "output_path": "data",
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "add_company",
      "name": "Add company",
      "method": "POST",
      "endpoint": "/companies.add",
      "body": {
        "name": "{{ inputs.name }}",
        "website": "{{ inputs.website }}"
      },
      "output_path": "data",
      "inputs": [
        {
          "key": "name",
          "label": "Name",
          "type": "string",
          "required": true
        },
        {
          "key": "website",
          "label": "Website",
          "type": "string"
        }
      ]
    }
  ]
}
