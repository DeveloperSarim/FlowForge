{
  "key": "zenserp",
  "name": "Zenserp",
  "category": "Ads & SEO",
  "description": "Google and Bing search results (web, images, news, shopping) as JSON.",
  "brand": "zenserp",
  "website": "https://zenserp.com",
  "docs_url": "https://app.zenserp.com/documentation",
  "base_url": "https://app.zenserp.com/api/v2",
  "auth": { "type": "api_key", "in": "header", "name": "apikey" },
  "actions": [
    {
      "key": "search",
      "name": "Search",
      "method": "GET",
      "endpoint": "/search",
      "query": {
        "q": "{{ inputs.q }}",
        "search_engine": "{{ inputs.search_engine }}",
        "tbm": "{{ inputs.tbm }}",
        "location": "{{ inputs.location }}",
        "gl": "{{ inputs.gl }}",
        "hl": "{{ inputs.hl }}",
        "device": "{{ inputs.device }}",
        "num": "{{ inputs.num }}",
        "start": "{{ inputs.start }}"
      },
      "inputs": [
        { "key": "q", "label": "Search query", "type": "string", "required": true },
        { "key": "search_engine", "label": "Search engine", "type": "string", "placeholder": "google.com" },
        { "key": "tbm", "label": "Result type", "type": "select", "options": [
          { "value": "isch", "label": "Images" }, { "value": "nws", "label": "News" }, { "value": "shop", "label": "Shopping" }, { "value": "vid", "label": "Videos" }
        ], "help": "Leave empty for web results." },
        { "key": "location", "label": "Location", "type": "string", "placeholder": "Manhattan,New York,United States" },
        { "key": "gl", "label": "Country code", "type": "string", "placeholder": "US" },
        { "key": "hl", "label": "Language code", "type": "string", "placeholder": "en" },
        { "key": "device", "label": "Device", "type": "select", "default": "desktop", "options": [
          { "value": "desktop", "label": "Desktop" }, { "value": "mobile", "label": "Mobile" }
        ] },
        { "key": "num", "label": "Results", "type": "number", "default": 10 },
        { "key": "start", "label": "Offset", "type": "number" }
      ]
    },
    {
      "key": "get_status",
      "name": "Get remaining requests",
      "method": "GET",
      "endpoint": "/status",
      "inputs": []
    }
  ]
}
