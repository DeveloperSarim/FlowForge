{
  "key": "surveyhero",
  "name": "SurveyHero",
  "category": "Forms & Surveys",
  "description": "List SurveyHero surveys and read their collected responses.",
  "website": "https://www.surveyhero.com",
  "docs_url": "https://developer.surveyhero.com/api/",
  "base_url": "https://api.surveyhero.com/v1",
  "auth": {
    "type": "basic",
    "fields": [
      {
        "key": "username",
        "label": "API token",
        "type": "string",
        "required": true,
        "help": "SurveyHero > Account > Integrations > API: copy the API token."
      },
      {
        "key": "password",
        "label": "API secret",
        "type": "password",
        "required": true,
        "help": "Same page: the API secret."
      }
    ]
  },
  "actions": [
    {
      "key": "list_surveys",
      "name": "List surveys",
      "description": "Get your surveys.",
      "method": "GET",
      "endpoint": "/surveys",
      "output_fields": {
        "surveys": "surveys"
      },
      "inputs": []
    },
    {
      "key": "get_survey",
      "name": "Get a survey",
      "description": "Get the details of a survey.",
      "method": "GET",
      "endpoint": "/surveys/{{ inputs.survey_id }}",
      "inputs": [
        {
          "key": "survey_id",
          "label": "Survey ID",
          "type": "string",
          "required": true,
          "help": "The number in the survey's address in SurveyHero."
        }
      ]
    },
    {
      "key": "list_responses",
      "name": "List responses",
      "description": "Get the responses to a survey.",
      "method": "GET",
      "endpoint": "/surveys/{{ inputs.survey_id }}/responses",
      "query": {
        "page": "{{ inputs.page }}"
      },
      "inputs": [
        {
          "key": "survey_id",
          "label": "Survey ID",
          "type": "string",
          "required": true
        },
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "default": 1
        }
      ]
    },
    {
      "key": "list_questions",
      "name": "List questions",
      "description": "Get the questions of a survey.",
      "method": "GET",
      "endpoint": "/surveys/{{ inputs.survey_id }}/questions",
      "inputs": [
        {
          "key": "survey_id",
          "label": "Survey ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
