{
  "key": "sistrix",
  "name": "SISTRIX",
  "category": "Ads & SEO",
  "description": "SEO visibility index and keyword data for any domain.",
  "website": "https://www.sistrix.com",
  "docs_url": "https://www.sistrix.com/api/",
  "base_url": "https://api.sistrix.com",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "api_key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "SISTRIX → Account → API → copy your API key."
      }
    ]
  },
  "actions": [
    {
      "key": "visibility_index",
      "name": "Visibility index",
      "description": "Current SEO visibility index of a domain.",
      "method": "GET",
      "endpoint": "/domain.sichtbarkeitsindex",
      "query": {
        "format": "json",
        "domain": "{{ inputs.domain }}",
        "country": "{{ inputs.country }}"
      },
      "output_fields": {
        "visibility": "answer.0.sichtbarkeitsindex.0.value",
        "date": "answer.0.sichtbarkeitsindex.0.date"
      },
      "inputs": [
        {
          "key": "domain",
          "label": "Domain",
          "type": "string",
          "required": true,
          "placeholder": "example.com"
        },
        {
          "key": "country",
          "label": "Country code",
          "type": "string",
          "default": "us"
        }
      ]
    },
    {
      "key": "credits",
      "name": "Check credits",
      "description": "Remaining API credits.",
      "method": "GET",
      "endpoint": "/credits",
      "query": {
        "format": "json"
      },
      "output_fields": {
        "credits": "answer.0.credits.0.credits"
      },
      "inputs": []
    }
  ]
}
