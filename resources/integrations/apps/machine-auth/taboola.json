{
  "key": "taboola",
  "name": "Taboola",
  "category": "Ads & SEO",
  "brand": "taboola",
  "popular": false,
  "description": "Read campaigns and performance from Taboola Backstage.",
  "website": "https://www.taboola.com",
  "docs_url": "https://developers.taboola.com/backstage-api/reference",
  "base_url": "https://backstage.taboola.com/backstage/api/1.0",
  "auth": {
    "type": "oauth2_client_credentials",
    "token_url": "https://backstage.taboola.com/backstage/oauth/token"
  },
  "actions": [
    {
      "key": "current_account",
      "name": "Get current account",
      "method": "GET",
      "endpoint": "/users/current/account",
      "inputs": []
    },
    {
      "key": "list_campaigns",
      "name": "List campaigns",
      "method": "GET",
      "endpoint": "/{{ inputs.account_id }}/campaigns/",
      "inputs": [
        {
          "key": "account_id",
          "label": "Account ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "get_campaign",
      "name": "Get campaign",
      "method": "GET",
      "endpoint": "/{{ inputs.account_id }}/campaigns/{{ inputs.campaign_id }}",
      "inputs": [
        {
          "key": "account_id",
          "label": "Account ID",
          "type": "string",
          "required": true
        },
        {
          "key": "campaign_id",
          "label": "Campaign ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "campaign_summary_report",
      "name": "Campaign summary report",
      "method": "GET",
      "endpoint": "/{{ inputs.account_id }}/reports/campaign-summary/dimensions/{{ inputs.dimension }}",
      "query": {
        "start_date": "{{ inputs.start_date }}",
        "end_date": "{{ inputs.end_date }}"
      },
      "inputs": [
        {
          "key": "account_id",
          "label": "Account ID",
          "type": "string",
          "required": true
        },
        {
          "key": "dimension",
          "label": "Dimension",
          "type": "select",
          "default": "day",
          "options": [
            {
              "value": "day",
              "label": "Day"
            },
            {
              "value": "campaign_breakdown",
              "label": "Campaign"
            },
            {
              "value": "site_breakdown",
              "label": "Site"
            }
          ]
        },
        {
          "key": "start_date",
          "label": "Start date",
          "type": "string",
          "required": true,
          "placeholder": "2026-10-01"
        },
        {
          "key": "end_date",
          "label": "End date",
          "type": "string",
          "required": true,
          "placeholder": "2026-10-07"
        }
      ]
    }
  ]
}