{
  "key": "diffbot",
  "name": "Diffbot",
  "category": "AI",
  "description": "Turn any article, product or discussion page into clean structured data with AI.",
  "website": "https://www.diffbot.com",
  "docs_url": "https://docs.diffbot.com/reference/introduction-to-diffbot-apis",
  "base_url": "https://api.diffbot.com/v3",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "token",
    "fields": [
      {
        "key": "api_key",
        "label": "API token",
        "type": "password",
        "required": true,
        "help": "app.diffbot.com → your token is shown on the dashboard."
      }
    ]
  },
  "actions": [
    {
      "key": "extract_article",
      "name": "Extract article",
      "description": "Get the title, text, author, date and images of an article.",
      "method": "GET",
      "endpoint": "/article",
      "query": {
        "url": "{{ inputs.url }}"
      },
      "timeout": 60,
      "output_fields": {
        "title": "objects.0.title",
        "text": "objects.0.text",
        "author": "objects.0.author",
        "date": "objects.0.date",
        "image": "objects.0.images.0.url",
        "language": "objects.0.humanLanguage"
      },
      "inputs": [
        {
          "key": "url",
          "label": "Page URL",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "extract_product",
      "name": "Extract product",
      "description": "Get name, price, brand and images from a product page.",
      "method": "GET",
      "endpoint": "/product",
      "query": {
        "url": "{{ inputs.url }}"
      },
      "timeout": 60,
      "output_fields": {
        "title": "objects.0.title",
        "price": "objects.0.offerPrice",
        "brand": "objects.0.brand",
        "sku": "objects.0.sku",
        "image": "objects.0.images.0.url",
        "text": "objects.0.text"
      },
      "inputs": [
        {
          "key": "url",
          "label": "Page URL",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "extract_discussion",
      "name": "Extract discussion",
      "description": "Get the posts from a forum thread or comment section.",
      "method": "GET",
      "endpoint": "/discussion",
      "query": {
        "url": "{{ inputs.url }}"
      },
      "timeout": 60,
      "output_fields": {
        "title": "objects.0.title",
        "posts": "objects.0.posts"
      },
      "inputs": [
        {
          "key": "url",
          "label": "Page URL",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "analyze_page",
      "name": "Analyse any page",
      "description": "Detect the page type and extract it automatically.",
      "method": "GET",
      "endpoint": "/analyze",
      "query": {
        "url": "{{ inputs.url }}"
      },
      "timeout": 60,
      "output_fields": {
        "type": "type",
        "title": "objects.0.title",
        "objects": "objects"
      },
      "inputs": [
        {
          "key": "url",
          "label": "Page URL",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
