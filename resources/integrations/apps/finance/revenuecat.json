{
  "key": "revenuecat",
  "name": "RevenueCat",
  "category": "Payments & Finance",
  "description": "Look up in-app subscribers, entitlements and subscriptions in RevenueCat.",
  "brand": "revenuecat",
  "website": "https://www.revenuecat.com",
  "docs_url": "https://www.revenuecat.com/docs/api-v2",
  "base_url": "https://api.revenuecat.com",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "Secret API key",
          "type": "password",
          "required": true,
          "help": "Project settings > API keys (secret key, sk_…)."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "get_customer",
      "name": "Get customer (v2)",
      "method": "GET",
      "endpoint": "/v2/projects/{{ inputs.project_id }}/customers/{{ inputs.customer_id }}",
      "inputs": [
        {
          "key": "project_id",
          "label": "Project ID",
          "type": "string",
          "required": true
        },
        {
          "key": "customer_id",
          "label": "Customer (app user) ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_active_entitlements",
      "name": "List active entitlements (v2)",
      "method": "GET",
      "endpoint": "/v2/projects/{{ inputs.project_id }}/customers/{{ inputs.customer_id }}/active_entitlements",
      "output_path": "items",
      "inputs": [
        {
          "key": "project_id",
          "label": "Project ID",
          "type": "string",
          "required": true
        },
        {
          "key": "customer_id",
          "label": "Customer (app user) ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_subscriptions",
      "name": "List customer subscriptions (v2)",
      "method": "GET",
      "endpoint": "/v2/projects/{{ inputs.project_id }}/customers/{{ inputs.customer_id }}/subscriptions",
      "output_path": "items",
      "inputs": [
        {
          "key": "project_id",
          "label": "Project ID",
          "type": "string",
          "required": true
        },
        {
          "key": "customer_id",
          "label": "Customer (app user) ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "get_subscriber",
      "name": "Get subscriber (v1)",
      "description": "Needs a v1 secret key.",
      "method": "GET",
      "endpoint": "/v1/subscribers/{{ inputs.app_user_id }}",
      "output_path": "subscriber",
      "inputs": [
        {
          "key": "app_user_id",
          "label": "App user ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "Project > Integrations > Webhooks: add this URL.",
      "data_path": "event",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
