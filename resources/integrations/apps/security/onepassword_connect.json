{
  "key": "onepassword_connect",
  "name": "1Password Connect",
  "category": "Security & IT",
  "description": "Read, create and delete vault items through your 1Password Connect server.",
  "brand": "1password",
  "website": "https://1password.com",
  "docs_url": "https://developer.1password.com/docs/connect/api-reference/",
  "base_url": "{{ credentials.base_url }}/v1",
  "auth": { "type": "bearer", "fields": [
    { "key": "base_url", "label": "Connect server URL", "type": "string", "required": true, "placeholder": "http://op-connect:8080", "help": "Your self-hosted Connect server, without a trailing slash." },
    { "key": "token", "label": "Connect token", "type": "password", "required": true, "help": "Developer → Connect servers → Issue token." }
  ] },
  "actions": [
    {
      "key": "list_vaults",
      "name": "List vaults",
      "method": "GET",
      "endpoint": "/vaults",
      "query": { "filter": "{{ inputs.filter }}" },
      "inputs": [{ "key": "filter", "label": "Filter", "type": "string", "placeholder": "name eq \"Infrastructure\"" }]
    },
    {
      "key": "list_items",
      "name": "List items",
      "method": "GET",
      "endpoint": "/vaults/{{ inputs.vault_id }}/items",
      "query": { "filter": "{{ inputs.filter }}" },
      "inputs": [
        { "key": "vault_id", "label": "Vault ID", "type": "string", "required": true },
        { "key": "filter", "label": "Filter", "type": "string", "placeholder": "title eq \"Database\"" }
      ]
    },
    {
      "key": "get_item",
      "name": "Get item",
      "description": "Includes field values.",
      "method": "GET",
      "endpoint": "/vaults/{{ inputs.vault_id }}/items/{{ inputs.item_id }}",
      "inputs": [
        { "key": "vault_id", "label": "Vault ID", "type": "string", "required": true },
        { "key": "item_id", "label": "Item ID", "type": "string", "required": true }
      ]
    },
    {
      "key": "create_item",
      "name": "Create item",
      "method": "POST",
      "endpoint": "/vaults/{{ inputs.vault_id }}/items",
      "body": { "vault": { "id": "{{ inputs.vault_id }}" }, "title": "{{ inputs.title }}", "category": "{{ inputs.category }}", "fields": "{{ inputs.fields }}", "tags": "{{ inputs.tags }}" },
      "inputs": [
        { "key": "vault_id", "label": "Vault ID", "type": "string", "required": true },
        { "key": "title", "label": "Title", "type": "string", "required": true },
        { "key": "category", "label": "Category", "type": "select", "required": true, "default": "LOGIN", "options": [
          { "value": "LOGIN", "label": "Login" }, { "value": "PASSWORD", "label": "Password" }, { "value": "API_CREDENTIAL", "label": "API credential" },
          { "value": "SECURE_NOTE", "label": "Secure note" }, { "value": "DATABASE", "label": "Database" }, { "value": "SERVER", "label": "Server" }
        ] },
        { "key": "fields", "label": "Fields (JSON array)", "type": "json", "placeholder": "[{\"purpose\": \"USERNAME\", \"value\": \"svc-app\"}, {\"purpose\": \"PASSWORD\", \"generate\": true}]" },
        { "key": "tags", "label": "Tags", "type": "list" }
      ]
    },
    {
      "key": "delete_item",
      "name": "Delete item",
      "method": "DELETE",
      "endpoint": "/vaults/{{ inputs.vault_id }}/items/{{ inputs.item_id }}",
      "inputs": [
        { "key": "vault_id", "label": "Vault ID", "type": "string", "required": true },
        { "key": "item_id", "label": "Item ID", "type": "string", "required": true }
      ]
    }
  ]
}
