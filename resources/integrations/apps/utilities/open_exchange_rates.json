{
  "key": "open_exchange_rates",
  "name": "Open Exchange Rates",
  "category": "Utilities",
  "description": "Latest and historical currency exchange rates.",
  "brand": "openexchangerates",
  "website": "https://openexchangerates.org",
  "docs_url": "https://docs.openexchangerates.org",
  "base_url": "https://openexchangerates.org/api",
  "auth": { "type": "api_key", "in": "query", "name": "app_id", "fields": [
    { "key": "api_key", "label": "App ID", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "latest_rates",
      "name": "Get latest rates",
      "method": "GET",
      "endpoint": "/latest.json",
      "query": { "base": "{{ inputs.base }}", "symbols": "{{ inputs.symbols }}" },
      "inputs": [
        { "key": "base", "label": "Base currency", "type": "string", "placeholder": "USD", "help": "Changing the base needs a paid plan." },
        { "key": "symbols", "label": "Only these currencies", "type": "string", "placeholder": "EUR,GBP,JPY" }
      ]
    },
    {
      "key": "historical_rates",
      "name": "Get historical rates",
      "method": "GET",
      "endpoint": "/historical/{{ inputs.date }}.json",
      "query": { "base": "{{ inputs.base }}", "symbols": "{{ inputs.symbols }}" },
      "inputs": [
        { "key": "date", "label": "Date", "type": "string", "required": true, "placeholder": "2025-12-31" },
        { "key": "base", "label": "Base currency", "type": "string", "placeholder": "USD" },
        { "key": "symbols", "label": "Only these currencies", "type": "string", "placeholder": "EUR,GBP,JPY" }
      ]
    },
    {
      "key": "currencies",
      "name": "List currencies",
      "method": "GET",
      "endpoint": "/currencies.json",
      "inputs": []
    }
  ]
}
