{
  "key": "phantombuster",
  "name": "PhantomBuster",
  "category": "AI",
  "description": "Launch Phantoms and fetch their scraped output.",
  "brand": "phantombuster",
  "website": "https://phantombuster.com",
  "docs_url": "https://hub.phantombuster.com/reference",
  "base_url": "https://api.phantombuster.com/api/v2",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "X-Phantombuster-Key-1",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "launch_agent",
      "name": "Launch Phantom",
      "method": "POST",
      "endpoint": "/agents/launch",
      "body": {
        "id": "{{ inputs.agent_id }}",
        "argument": "{{ inputs.argument }}"
      },
      "inputs": [
        {
          "key": "agent_id",
          "label": "Phantom (agent) ID",
          "type": "string",
          "required": true
        },
        {
          "key": "argument",
          "label": "Argument (JSON)",
          "type": "json",
          "help": "Overrides the Phantom's saved settings for this run."
        }
      ]
    },
    {
      "key": "fetch_output",
      "name": "Get Phantom output",
      "method": "GET",
      "endpoint": "/agents/fetch-output",
      "query": {
        "id": "{{ inputs.agent_id }}"
      },
      "inputs": [
        {
          "key": "agent_id",
          "label": "Phantom (agent) ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "get_agent",
      "name": "Get Phantom",
      "method": "GET",
      "endpoint": "/agents/fetch",
      "query": {
        "id": "{{ inputs.agent_id }}"
      },
      "inputs": [
        {
          "key": "agent_id",
          "label": "Phantom (agent) ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_agents",
      "name": "List Phantoms",
      "method": "GET",
      "endpoint": "/agents/fetch-all",
      "inputs": []
    }
  ]
}
