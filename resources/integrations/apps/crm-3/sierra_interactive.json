{
  "key": "sierra_interactive",
  "name": "Sierra Interactive",
  "category": "CRM & Sales",
  "description": "Add and update real estate leads, notes and tasks in Sierra Interactive.",
  "website": "https://www.sierrainteractive.com",
  "docs_url": "https://api.sierrainteractivedev.com/",
  "base_url": "https://api.sierrainteractivedev.com",
  "headers": {
    "Sierra-OriginatingSystemName": "FlowForge"
  },
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "Sierra-ApiKey",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Your Sierra Interactive API key (ask your site admin or Sierra support to enable API access)."
      }
    ]
  },
  "actions": [
    {
      "key": "add_lead",
      "name": "Add lead",
      "description": "Registers a new lead; it is assigned by your distribution rules.",
      "method": "POST",
      "endpoint": "/leads",
      "body": {
        "email": "{{ inputs.email }}",
        "firstName": "{{ inputs.first_name }}",
        "lastName": "{{ inputs.last_name }}",
        "phone": "{{ inputs.phone }}",
        "password": "{{ inputs.password }}",
        "leadType": "{{ inputs.lead_type }}",
        "leadStatus": "{{ inputs.lead_status }}",
        "source": "{{ inputs.source }}",
        "tags": "{{ inputs.tags }}",
        "note": "{{ inputs.note }}",
        "sendRegistrationEmail": "{{ inputs.send_registration_email }}"
      },
      "output_fields": {
        "lead_id": "data.leadId",
        "agent_email": "data.agentUserEmail"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "first_name",
          "label": "First name",
          "type": "string"
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "phone",
          "label": "Phone",
          "type": "string"
        },
        {
          "key": "password",
          "label": "Site password",
          "type": "password",
          "required": true,
          "help": "Password the lead will use to log in to your website."
        },
        {
          "key": "lead_type",
          "label": "Lead type",
          "type": "select",
          "default": "1",
          "options": [
            {
              "value": "1",
              "label": "Buyer"
            },
            {
              "value": "2",
              "label": "Seller"
            },
            {
              "value": "3",
              "label": "Buyer and seller"
            }
          ]
        },
        {
          "key": "lead_status",
          "label": "Status",
          "type": "select",
          "default": "New",
          "options": [
            {
              "value": "New",
              "label": "New"
            },
            {
              "value": "Qualify",
              "label": "Qualify"
            },
            {
              "value": "Active",
              "label": "Active"
            },
            {
              "value": "Prime",
              "label": "Prime"
            },
            {
              "value": "Pending",
              "label": "Pending"
            },
            {
              "value": "Closed",
              "label": "Closed"
            },
            {
              "value": "Archived",
              "label": "Archived"
            },
            {
              "value": "Junk",
              "label": "Junk"
            },
            {
              "value": "DoNotContact",
              "label": "DoNotContact"
            },
            {
              "value": "Watch",
              "label": "Watch"
            },
            {
              "value": "Blocked",
              "label": "Blocked"
            }
          ]
        },
        {
          "key": "source",
          "label": "Source",
          "type": "string",
          "default": "FlowForge"
        },
        {
          "key": "tags",
          "label": "Tags",
          "type": "list"
        },
        {
          "key": "note",
          "label": "Note",
          "type": "text"
        },
        {
          "key": "send_registration_email",
          "label": "Send welcome email",
          "type": "boolean",
          "default": false
        }
      ]
    },
    {
      "key": "update_lead",
      "name": "Update lead",
      "method": "PUT",
      "endpoint": "/leads/{{ inputs.lead }}",
      "body": {
        "firstName": "{{ inputs.first_name }}",
        "lastName": "{{ inputs.last_name }}",
        "phone": "{{ inputs.phone }}",
        "email": "{{ inputs.new_email }}",
        "leadStatus": "{{ inputs.lead_status }}",
        "source": "{{ inputs.source }}"
      },
      "inputs": [
        {
          "key": "lead",
          "label": "Lead ID or email",
          "type": "string",
          "required": true
        },
        {
          "key": "first_name",
          "label": "First name",
          "type": "string"
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "phone",
          "label": "Phone",
          "type": "string"
        },
        {
          "key": "new_email",
          "label": "New email",
          "type": "string"
        },
        {
          "key": "lead_status",
          "label": "Status",
          "type": "select",
          "options": [
            {
              "value": "New",
              "label": "New"
            },
            {
              "value": "Qualify",
              "label": "Qualify"
            },
            {
              "value": "Active",
              "label": "Active"
            },
            {
              "value": "Prime",
              "label": "Prime"
            },
            {
              "value": "Pending",
              "label": "Pending"
            },
            {
              "value": "Closed",
              "label": "Closed"
            },
            {
              "value": "Archived",
              "label": "Archived"
            },
            {
              "value": "Junk",
              "label": "Junk"
            },
            {
              "value": "DoNotContact",
              "label": "DoNotContact"
            },
            {
              "value": "Watch",
              "label": "Watch"
            },
            {
              "value": "Blocked",
              "label": "Blocked"
            }
          ]
        },
        {
          "key": "source",
          "label": "Source",
          "type": "string"
        }
      ]
    },
    {
      "key": "get_lead",
      "name": "Get lead",
      "method": "GET",
      "endpoint": "/leads/get/{{ inputs.lead }}",
      "query": {
        "includeTags": "true"
      },
      "output_path": "data",
      "output_fields": {
        "id": "id",
        "email": "email"
      },
      "inputs": [
        {
          "key": "lead",
          "label": "Lead ID, email or phone",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "find_leads",
      "name": "Find leads",
      "method": "GET",
      "endpoint": "/leads/find",
      "query": {
        "email": "{{ inputs.email }}",
        "name": "{{ inputs.name }}",
        "phone": "{{ inputs.phone }}",
        "leadStatus": "{{ inputs.lead_status }}",
        "pageSize": "{{ inputs.page_size }}"
      },
      "output_path": "data",
      "output_fields": {
        "leads": "leads",
        "id": "leads.0.id",
        "total": "totalRecords"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string"
        },
        {
          "key": "name",
          "label": "Name",
          "type": "string"
        },
        {
          "key": "phone",
          "label": "Phone",
          "type": "string"
        },
        {
          "key": "lead_status",
          "label": "Status",
          "type": "select",
          "default": "AllActive",
          "options": [
            {
              "value": "AllActive",
              "label": "All active"
            },
            {
              "value": "AllExceptDeleted",
              "label": "All"
            },
            {
              "value": "New",
              "label": "New"
            },
            {
              "value": "Qualify",
              "label": "Qualify"
            },
            {
              "value": "Active",
              "label": "Active"
            },
            {
              "value": "Prime",
              "label": "Prime"
            },
            {
              "value": "Pending",
              "label": "Pending"
            },
            {
              "value": "Closed",
              "label": "Closed"
            },
            {
              "value": "Archived",
              "label": "Archived"
            },
            {
              "value": "Junk",
              "label": "Junk"
            },
            {
              "value": "DoNotContact",
              "label": "DoNotContact"
            },
            {
              "value": "Watch",
              "label": "Watch"
            },
            {
              "value": "Blocked",
              "label": "Blocked"
            }
          ]
        },
        {
          "key": "page_size",
          "label": "Max results",
          "type": "number",
          "default": 25
        }
      ]
    },
    {
      "key": "add_note",
      "name": "Add note",
      "method": "POST",
      "endpoint": "/leads/{{ inputs.lead }}/note",
      "body": {
        "message": "{{ inputs.message }}",
        "shouldNotify": "{{ inputs.notify_agent }}"
      },
      "output_fields": {
        "note_id": "data.id"
      },
      "inputs": [
        {
          "key": "lead",
          "label": "Lead ID or email",
          "type": "string",
          "required": true
        },
        {
          "key": "message",
          "label": "Note",
          "type": "text",
          "required": true
        },
        {
          "key": "notify_agent",
          "label": "Notify the lead's agent",
          "type": "boolean",
          "default": true
        }
      ]
    },
    {
      "key": "add_task",
      "name": "Add task",
      "method": "POST",
      "endpoint": "/leads/{{ inputs.lead }}/task",
      "body": {
        "toUserId": "{{ inputs.to_user_id }}",
        "dueOn": "{{ inputs.due_on }}",
        "taskType": "{{ inputs.task_type }}",
        "contents": "{{ inputs.contents }}"
      },
      "output_fields": {
        "task_id": "data.id"
      },
      "inputs": [
        {
          "key": "lead",
          "label": "Lead ID or email",
          "type": "string",
          "required": true
        },
        {
          "key": "to_user_id",
          "label": "Assign to user ID",
          "type": "number",
          "required": true,
          "help": "Sierra user ID of the agent who should do the task."
        },
        {
          "key": "due_on",
          "label": "Due (ISO date-time, UTC)",
          "type": "string",
          "required": true,
          "placeholder": "2026-01-31T15:00:00Z"
        },
        {
          "key": "task_type",
          "label": "Type",
          "type": "select",
          "default": "Other",
          "options": [
            {
              "value": "Other",
              "label": "Other"
            },
            {
              "value": "Email",
              "label": "Email"
            },
            {
              "value": "PhoneCall",
              "label": "Phone call"
            },
            {
              "value": "TextMessage",
              "label": "Text message"
            }
          ]
        },
        {
          "key": "contents",
          "label": "Description",
          "type": "text",
          "required": true
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "new_lead",
      "name": "New lead",
      "type": "polling",
      "method": "GET",
      "endpoint": "/leads/find",
      "query": {
        "sortColumn": "RegisteredDate",
        "sortOrder": "desc",
        "pageSize": 50
      },
      "items_path": "data.leads",
      "id_field": "id",
      "inputs": [
        {
          "key": "poll_interval",
          "label": "Check every (minutes)",
          "type": "number",
          "default": 5
        }
      ]
    }
  ]
}
