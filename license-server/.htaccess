# Everything goes through index.php; config, keys and the database are never served.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(config\.php|config\.example\.php|keys/|data/) - [F,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
<FilesMatch "\.(pem|sqlite|md)$">
    Require all denied
</FilesMatch>
