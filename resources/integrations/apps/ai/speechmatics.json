{
  "key": "speechmatics",
  "name": "Speechmatics",
  "category": "AI",
  "description": "Check batch transcription jobs and download transcripts.",
  "brand": "speechmatics",
  "website": "https://www.speechmatics.com",
  "docs_url": "https://docs.speechmatics.com/api-ref/batch/create-a-new-job",
  "base_url": "https://asr.api.speechmatics.com/v2",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "list_jobs",
      "name": "List jobs",
      "method": "GET",
      "endpoint": "/jobs",
      "inputs": []
    },
    {
      "key": "get_job",
      "name": "Get job",
      "method": "GET",
      "endpoint": "/jobs/{{ inputs.job_id }}",
      "inputs": [
        {
          "key": "job_id",
          "label": "Job ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "get_transcript",
      "name": "Get transcript",
      "method": "GET",
      "endpoint": "/jobs/{{ inputs.job_id }}/transcript",
      "headers": {
        "Accept": "*/*"
      },
      "query": {
        "format": "{{ inputs.format }}"
      },
      "inputs": [
        {
          "key": "job_id",
          "label": "Job ID",
          "type": "string",
          "required": true
        },
        {
          "key": "format",
          "label": "Format",
          "type": "select",
          "options": [
            {
              "value": "json-v2",
              "label": "JSON"
            },
            {
              "value": "txt",
              "label": "Plain text"
            },
            {
              "value": "srt",
              "label": "SRT subtitles"
            }
          ],
          "default": "txt"
        }
      ]
    }
  ]
}
