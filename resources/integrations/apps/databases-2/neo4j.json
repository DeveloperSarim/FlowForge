{
  "key": "neo4j",
  "name": "Neo4j",
  "category": "Databases",
  "description": "Run Cypher queries against Neo4j Aura or a self-managed Neo4j (Query API).",
  "brand": "neo4j",
  "website": "https://neo4j.com",
  "docs_url": "https://neo4j.com/docs/query-api/current/",
  "base_url": "{{ credentials.base_url }}",
  "auth": { "type": "basic", "fields": [
    { "key": "base_url", "label": "Instance URL", "type": "string", "required": true, "placeholder": "https://a1b2c3d4.databases.neo4j.io", "help": "HTTPS origin, no trailing slash (self-managed: http(s)://host:7474). Needs Neo4j 5.19+ or Aura." },
    { "key": "username", "label": "Username", "type": "string", "required": true },
    { "key": "password", "label": "Password", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "run_cypher",
      "name": "Run Cypher query",
      "method": "POST",
      "endpoint": "/db/{{ inputs.database }}/query/v2",
      "body": { "statement": "{{ inputs.statement }}", "parameters": "{{ inputs.parameters }}" },
      "inputs": [
        { "key": "statement", "label": "Cypher", "type": "code", "required": true, "placeholder": "MATCH (p:Person {name: $name}) RETURN p" },
        { "key": "parameters", "label": "Parameters (JSON)", "type": "json", "placeholder": "{ \"name\": \"Ada\" }" },
        { "key": "database", "label": "Database", "type": "string", "required": true, "default": "neo4j" }
      ]
    }
  ]
}
