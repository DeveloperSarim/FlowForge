{
  "key": "apitemplate",
  "name": "APITemplate.io",
  "category": "Files & Documents",
  "description": "Generate PDFs and images from templates with JSON data.",
  "brand": "apitemplate",
  "website": "https://apitemplate.io",
  "docs_url": "https://apitemplate.io/apiv2/",
  "base_url": "https://rest.apitemplate.io/v2",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "X-API-KEY"
    }
  ],
  "actions": [
    {
      "key": "create_pdf",
      "name": "Create PDF",
      "method": "POST",
      "endpoint": "/create-pdf",
      "query": {
        "template_id": "{{ inputs.template_id }}",
        "filename": "{{ inputs.filename }}",
        "expiration": "{{ inputs.expiration }}"
      },
      "body": "{{ inputs.data }}",
      "output_fields": {
        "url": "download_url"
      },
      "inputs": [
        {
          "key": "template_id",
          "label": "Template ID",
          "type": "string",
          "required": true
        },
        {
          "key": "data",
          "label": "Template data (JSON)",
          "type": "json",
          "required": true
        },
        {
          "key": "filename",
          "label": "File name",
          "type": "string"
        },
        {
          "key": "expiration",
          "label": "Link expires after (minutes)",
          "type": "number",
          "help": "0 keeps the file."
        }
      ]
    },
    {
      "key": "create_image",
      "name": "Create image",
      "method": "POST",
      "endpoint": "/create-image",
      "query": {
        "template_id": "{{ inputs.template_id }}"
      },
      "body": {
        "overrides": "{{ inputs.overrides }}"
      },
      "inputs": [
        {
          "key": "template_id",
          "label": "Template ID",
          "type": "string",
          "required": true
        },
        {
          "key": "overrides",
          "label": "Overrides (JSON)",
          "type": "json",
          "required": true,
          "placeholder": "[{ \"name\": \"text_1\", \"text\": \"Hello\" }]"
        }
      ]
    },
    {
      "key": "list_templates",
      "name": "List templates",
      "method": "GET",
      "endpoint": "/list-templates",
      "inputs": []
    }
  ]
}
