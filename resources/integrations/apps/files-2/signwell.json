{
  "key": "signwell",
  "name": "SignWell",
  "category": "Files & Documents",
  "description": "Send documents for e-signature from templates and send reminders.",
  "brand": "signwell",
  "website": "https://www.signwell.com",
  "docs_url": "https://developers.signwell.com/reference",
  "base_url": "https://www.signwell.com/api/v1",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "X-Api-Key",
      "fields": [
        {
          "key": "api_key",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Settings > API."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "create_from_template",
      "name": "Send document from template",
      "method": "POST",
      "endpoint": "/document_templates/documents",
      "body": {
        "template_id": "{{ inputs.template_id }}",
        "recipients": "{{ inputs.recipients }}",
        "name": "{{ inputs.name }}",
        "subject": "{{ inputs.subject }}",
        "message": "{{ inputs.message }}",
        "template_fields": "{{ inputs.template_fields }}",
        "draft": "{{ inputs.draft }}",
        "test_mode": "{{ inputs.test_mode }}"
      },
      "inputs": [
        {
          "key": "template_id",
          "label": "Template ID",
          "type": "string",
          "required": true
        },
        {
          "key": "recipients",
          "label": "Recipients",
          "type": "json",
          "required": true,
          "placeholder": "[{\"id\": \"1\", \"placeholder_name\": \"Client\", \"name\": \"Jane Doe\", \"email\": \"jane@example.com\"}]"
        },
        {
          "key": "name",
          "label": "Document name",
          "type": "string"
        },
        {
          "key": "subject",
          "label": "Email subject",
          "type": "string"
        },
        {
          "key": "message",
          "label": "Email message",
          "type": "text"
        },
        {
          "key": "template_fields",
          "label": "Prefilled fields",
          "type": "json",
          "placeholder": "[{\"api_id\": \"company\", \"value\": \"Acme\"}]"
        },
        {
          "key": "draft",
          "label": "Save as draft",
          "type": "boolean"
        },
        {
          "key": "test_mode",
          "label": "Test mode",
          "type": "boolean"
        }
      ]
    },
    {
      "key": "get_document",
      "name": "Get document",
      "method": "GET",
      "endpoint": "/documents/{{ inputs.document_id }}",
      "inputs": [
        {
          "key": "document_id",
          "label": "Document ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "send_reminder",
      "name": "Send reminder",
      "method": "POST",
      "endpoint": "/documents/{{ inputs.document_id }}/remind",
      "inputs": [
        {
          "key": "document_id",
          "label": "Document ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "delete_document",
      "name": "Delete document",
      "method": "DELETE",
      "endpoint": "/documents/{{ inputs.document_id }}",
      "inputs": [
        {
          "key": "document_id",
          "label": "Document ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "get_template",
      "name": "Get template",
      "method": "GET",
      "endpoint": "/document_templates/{{ inputs.template_id }}",
      "inputs": [
        {
          "key": "template_id",
          "label": "Template ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
