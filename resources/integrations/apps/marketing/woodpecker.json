{
  "key": "woodpecker",
  "name": "Woodpecker",
  "category": "Marketing & Email",
  "description": "Add prospects to cold email campaigns and list campaigns.",
  "brand": "woodpecker",
  "website": "https://woodpecker.co",
  "docs_url": "https://developers.woodpecker.co/",
  "base_url": "https://api.woodpecker.co/rest",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "x-api-key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "add_prospect",
      "name": "Add prospect to campaign",
      "method": "POST",
      "endpoint": "/v1/add_prospects_campaign",
      "body": {
        "campaign": {
          "campaign_id": "{{ inputs.campaign_id }}"
        },
        "update": "true",
        "prospects": [
          {
            "email": "{{ inputs.email }}",
            "first_name": "{{ inputs.first_name }}",
            "last_name": "{{ inputs.last_name }}",
            "company": "{{ inputs.company }}"
          }
        ]
      },
      "inputs": [
        {
          "key": "campaign_id",
          "label": "Campaign ID",
          "type": "number",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "first_name",
          "label": "First name",
          "type": "string"
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "company",
          "label": "Company",
          "type": "string"
        }
      ]
    },
    {
      "key": "list_campaigns",
      "name": "List campaigns",
      "method": "GET",
      "endpoint": "/v1/campaign_list",
      "inputs": []
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "Subscribe a URL to events (prospect_replied, email_opened…).",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
