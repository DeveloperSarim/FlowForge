{
  "key": "envato",
  "name": "Envato Market",
  "category": "E-commerce",
  "description": "For ThemeForest/CodeCanyon authors: verify purchase codes, sales and earnings.",
  "brand": "envato",
  "website": "https://www.envato.com",
  "docs_url": "https://build.envato.com/api/",
  "base_url": "https://api.envato.com",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "Personal token",
        "type": "password",
        "required": true,
        "help": "build.envato.com → Create a personal token; tick 'View your Envato Market sales history', 'Verify purchases of your items' and 'View your account profile details'."
      }
    ]
  },
  "actions": [
    {
      "key": "verify_purchase_code",
      "name": "Verify purchase code",
      "description": "Check a buyer's purchase code for one of your items.",
      "method": "GET",
      "endpoint": "/v3/market/author/sale",
      "query": {
        "code": "{{ inputs.code }}"
      },
      "output_fields": {
        "item_name": "item.name",
        "item_id": "item.id",
        "buyer": "buyer",
        "license": "license",
        "supported_until": "supported_until",
        "amount": "amount"
      },
      "error_hints": {
        "404": "The purchase code is not valid for your items."
      },
      "inputs": [
        {
          "key": "code",
          "label": "Purchase code",
          "type": "string",
          "required": true,
          "placeholder": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
        }
      ]
    },
    {
      "key": "list_sales",
      "name": "List sales",
      "description": "Your recent sales, newest first.",
      "method": "GET",
      "endpoint": "/v3/market/author/sales",
      "query": {
        "page": "{{ inputs.page }}"
      },
      "inputs": [
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "default": 1
        }
      ]
    },
    {
      "key": "get_account",
      "name": "Get account",
      "description": "Your name, balance and country.",
      "method": "GET",
      "endpoint": "/v1/market/private/user/account.json",
      "output_fields": {
        "balance": "account.balance",
        "firstname": "account.firstname",
        "surname": "account.surname"
      },
      "inputs": []
    },
    {
      "key": "monthly_earnings",
      "name": "Monthly earnings",
      "description": "Sales and earnings per month.",
      "method": "GET",
      "endpoint": "/v1/market/private/user/earnings-and-sales-by-month.json",
      "output_fields": {
        "months": "earnings-and-sales-by-month"
      },
      "inputs": []
    },
    {
      "key": "get_item",
      "name": "Get item",
      "description": "Details of an item on Envato Market.",
      "method": "GET",
      "endpoint": "/v3/market/catalog/item",
      "query": {
        "id": "{{ inputs.item_id }}"
      },
      "output_fields": {
        "name": "name",
        "sales": "number_of_sales",
        "rating": "rating",
        "price_cents": "price_cents",
        "url": "url"
      },
      "inputs": [
        {
          "key": "item_id",
          "label": "Item ID",
          "type": "number",
          "required": true
        }
      ]
    },
    {
      "key": "search_items",
      "name": "Search items",
      "description": "Search Envato Market items.",
      "method": "GET",
      "endpoint": "/v1/discovery/search/search/item",
      "query": {
        "term": "{{ inputs.term }}",
        "site": "{{ inputs.site }}",
        "page_size": "{{ inputs.page_size }}"
      },
      "output_fields": {
        "matches": "matches"
      },
      "inputs": [
        {
          "key": "term",
          "label": "Search",
          "type": "string",
          "required": true
        },
        {
          "key": "site",
          "label": "Site",
          "type": "select",
          "options": [
            {
              "value": "themeforest.net",
              "label": "themeforest.net"
            },
            {
              "value": "codecanyon.net",
              "label": "codecanyon.net"
            },
            {
              "value": "videohive.net",
              "label": "videohive.net"
            },
            {
              "value": "audiojungle.net",
              "label": "audiojungle.net"
            },
            {
              "value": "graphicriver.net",
              "label": "graphicriver.net"
            },
            {
              "value": "photodune.net",
              "label": "photodune.net"
            },
            {
              "value": "3docean.net",
              "label": "3docean.net"
            }
          ]
        },
        {
          "key": "page_size",
          "label": "How many",
          "type": "number",
          "default": 20
        }
      ]
    }
  ]
}
