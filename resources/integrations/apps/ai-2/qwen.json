{
  "key": "qwen",
  "name": "Qwen (Alibaba Cloud Model Studio)",
  "category": "AI",
  "description": "Chat with Qwen models and create text embeddings through Model Studio.",
  "brand": "alibabacloud",
  "website": "https://www.alibabacloud.com/en/product/modelstudio",
  "docs_url": "https://www.alibabacloud.com/help/en/model-studio/compatibility-of-openai-with-dashscope",
  "popular": true,
  "base_url": "{{ credentials.endpoint }}",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "endpoint",
        "label": "Region",
        "type": "select",
        "required": true,
        "default": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
        "options": [
          {
            "value": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
            "label": "International (Singapore)"
          },
          {
            "value": "https://dashscope-us.aliyuncs.com/compatible-mode/v1",
            "label": "US (Virginia)"
          },
          {
            "value": "https://dashscope.aliyuncs.com/compatible-mode/v1",
            "label": "China (Beijing)"
          }
        ],
        "help": "Must match the region of your API key."
      },
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Model Studio API key (sk-...). A key only works in the region it was created in."
      }
    ]
  },
  "actions": [
    {
      "key": "chat_completion",
      "name": "Chat completion",
      "description": "Send a prompt and get the reply as {{ steps.<id>.text }}.",
      "method": "POST",
      "endpoint": "/chat/completions",
      "timeout": 300,
      "body": {
        "model": "{{ inputs.model }}",
        "messages": [
          {
            "role": "system",
            "content": "{{ inputs.system }}"
          },
          {
            "role": "user",
            "content": "{{ inputs.prompt }}"
          }
        ],
        "temperature": "{{ inputs.temperature }}",
        "max_tokens": "{{ inputs.max_tokens }}"
      },
      "output_fields": {
        "text": "choices.0.message.content"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "default": "qwen-plus",
          "help": "e.g. qwen-plus, qwen-max, qwen-flash. See the Model Studio model list."
        },
        {
          "key": "prompt",
          "label": "Prompt",
          "type": "text",
          "required": true
        },
        {
          "key": "system",
          "label": "System prompt",
          "type": "text",
          "required": true,
          "default": "You are a helpful assistant.",
          "help": "Sent as the system message."
        },
        {
          "key": "temperature",
          "label": "Temperature",
          "type": "number",
          "placeholder": "0.7"
        },
        {
          "key": "max_tokens",
          "label": "Max output tokens",
          "type": "number"
        }
      ]
    },
    {
      "key": "create_embedding",
      "name": "Create embedding",
      "description": "Turn text into a vector, available as {{ steps.<id>.embedding }}.",
      "method": "POST",
      "endpoint": "/embeddings",
      "body": {
        "model": "{{ inputs.model }}",
        "input": "{{ inputs.input }}",
        "dimensions": "{{ inputs.dimensions }}"
      },
      "output_fields": {
        "embedding": "data.0.embedding"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "default": "text-embedding-v4"
        },
        {
          "key": "input",
          "label": "Text",
          "type": "text",
          "required": true
        },
        {
          "key": "dimensions",
          "label": "Dimensions",
          "type": "number",
          "placeholder": "1024"
        }
      ]
    }
  ]
}
