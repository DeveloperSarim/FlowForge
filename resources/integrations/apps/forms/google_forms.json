{
  "key": "google_forms",
  "name": "Google Forms",
  "category": "Forms & Surveys",
  "description": "Read Google Forms structure and responses.",
  "brand": "googleforms",
  "website": "https://www.google.com/forms/about/",
  "docs_url": "https://developers.google.com/forms/api/reference/rest",
  "popular": true,
  "base_url": "https://forms.googleapis.com/v1",
  "auth": [
    {
      "type": "oauth2",
      "authorize_url": "https://accounts.google.com/o/oauth2/v2/auth",
      "token_url": "https://oauth2.googleapis.com/token",
      "scopes": [
        "https://www.googleapis.com/auth/forms.body.readonly",
        "https://www.googleapis.com/auth/forms.responses.readonly"
      ],
      "authorize_params": {
        "access_type": "offline",
        "prompt": "consent"
      }
    },
    {
      "type": "google_service_account",
      "scopes": [
        "https://www.googleapis.com/auth/forms.body.readonly",
        "https://www.googleapis.com/auth/forms.responses.readonly"
      ]
    }
  ],
  "actions": [
    {
      "key": "get_form",
      "name": "Get form",
      "method": "GET",
      "endpoint": "/forms/{{ inputs.form_id }}",
      "inputs": [
        {
          "key": "form_id",
          "label": "Form ID",
          "type": "string",
          "required": true,
          "help": "The long id in the edit URL: /forms/d/<ID>/edit"
        }
      ]
    },
    {
      "key": "list_responses",
      "name": "List responses",
      "method": "GET",
      "endpoint": "/forms/{{ inputs.form_id }}/responses",
      "output_path": "responses",
      "query": {
        "filter": "{{ inputs.filter }}",
        "pageSize": "{{ inputs.page_size }}"
      },
      "inputs": [
        {
          "key": "form_id",
          "label": "Form ID",
          "type": "string",
          "required": true
        },
        {
          "key": "filter",
          "label": "Filter",
          "type": "string",
          "placeholder": "timestamp > 2024-01-31T00:00:00Z",
          "help": "Only timestamp > or >= an RFC 3339 time is supported."
        },
        {
          "key": "page_size",
          "label": "Page size",
          "type": "number"
        }
      ]
    },
    {
      "key": "get_response",
      "name": "Get response",
      "method": "GET",
      "endpoint": "/forms/{{ inputs.form_id }}/responses/{{ inputs.response_id }}",
      "inputs": [
        {
          "key": "form_id",
          "label": "Form ID",
          "type": "string",
          "required": true
        },
        {
          "key": "response_id",
          "label": "Response ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ],
  "triggers": []
}
