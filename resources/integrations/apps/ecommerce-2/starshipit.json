{
  "key": "starshipit",
  "name": "Starshipit",
  "category": "E-commerce",
  "description": "Create orders, search them and track shipments in Starshipit.",
  "brand": "starshipit",
  "website": "https://starshipit.com",
  "docs_url": "https://support.starshipit.com/developers",
  "base_url": "https://api.starshipit.com/api",
  "headers": {
    "StarShipIT-Api-Key": "{{ credentials.api_key }}",
    "Ocp-Apim-Subscription-Key": "{{ credentials.subscription_key }}"
  },
  "auth": [
    {
      "type": "api_key",
      "fields": [
        {
          "key": "api_key",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Starshipit > Settings > API."
        },
        {
          "key": "subscription_key",
          "label": "Subscription key",
          "type": "password",
          "required": true
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "create_order",
      "name": "Create order",
      "method": "POST",
      "endpoint": "/orders",
      "body": {
        "order": {
          "order_number": "{{ inputs.order_number }}",
          "reference": "{{ inputs.reference }}",
          "shipping_method": "{{ inputs.shipping_method }}",
          "destination": {
            "name": "{{ inputs.name }}",
            "email": "{{ inputs.email }}",
            "phone": "{{ inputs.phone }}",
            "company": "{{ inputs.company }}",
            "street": "{{ inputs.street }}",
            "suburb": "{{ inputs.suburb }}",
            "city": "{{ inputs.city }}",
            "state": "{{ inputs.state }}",
            "post_code": "{{ inputs.post_code }}",
            "country": "{{ inputs.country }}"
          },
          "items": "{{ inputs.items }}"
        }
      },
      "inputs": [
        {
          "key": "order_number",
          "label": "Order number",
          "type": "string",
          "required": true
        },
        {
          "key": "reference",
          "label": "Reference",
          "type": "string"
        },
        {
          "key": "shipping_method",
          "label": "Shipping method",
          "type": "string"
        },
        {
          "key": "name",
          "label": "Recipient name",
          "type": "string",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string"
        },
        {
          "key": "phone",
          "label": "Phone",
          "type": "string"
        },
        {
          "key": "company",
          "label": "Company",
          "type": "string"
        },
        {
          "key": "street",
          "label": "Street",
          "type": "string",
          "required": true
        },
        {
          "key": "suburb",
          "label": "Suburb",
          "type": "string"
        },
        {
          "key": "city",
          "label": "City",
          "type": "string"
        },
        {
          "key": "state",
          "label": "State",
          "type": "string"
        },
        {
          "key": "post_code",
          "label": "Post code",
          "type": "string",
          "required": true
        },
        {
          "key": "country",
          "label": "Country",
          "type": "string",
          "required": true,
          "placeholder": "Australia"
        },
        {
          "key": "items",
          "label": "Items",
          "type": "json",
          "placeholder": "[{\"description\": \"Rose\", \"sku\": \"ROSE-1\", \"quantity\": 1, \"weight\": 0.5, \"value\": 20}]"
        }
      ]
    },
    {
      "key": "get_order",
      "name": "Get order",
      "method": "GET",
      "endpoint": "/orders",
      "query": {
        "order_id": "{{ inputs.order_id }}",
        "order_number": "{{ inputs.order_number }}"
      },
      "inputs": [
        {
          "key": "order_id",
          "label": "Starshipit order ID",
          "type": "string"
        },
        {
          "key": "order_number",
          "label": "Order number",
          "type": "string"
        }
      ]
    },
    {
      "key": "search_orders",
      "name": "Search orders",
      "method": "GET",
      "endpoint": "/orders/search",
      "query": {
        "phrase": "{{ inputs.phrase }}"
      },
      "inputs": [
        {
          "key": "phrase",
          "label": "Search phrase",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_unshipped_orders",
      "name": "List unshipped orders",
      "method": "GET",
      "endpoint": "/orders/unshipped",
      "query": {
        "limit": "{{ inputs.limit }}",
        "page": "{{ inputs.page }}"
      },
      "output_path": "orders",
      "inputs": [
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50
        },
        {
          "key": "page",
          "label": "Page",
          "type": "number"
        }
      ]
    },
    {
      "key": "track_shipment",
      "name": "Track shipment",
      "method": "GET",
      "endpoint": "/track",
      "query": {
        "order_number": "{{ inputs.order_number }}",
        "tracking_number": "{{ inputs.tracking_number }}"
      },
      "inputs": [
        {
          "key": "order_number",
          "label": "Order number",
          "type": "string"
        },
        {
          "key": "tracking_number",
          "label": "Tracking number",
          "type": "string"
        }
      ]
    }
  ]
}
