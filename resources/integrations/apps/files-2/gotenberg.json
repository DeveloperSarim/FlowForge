{
  "key": "gotenberg",
  "name": "Gotenberg",
  "category": "Files & Documents",
  "description": "Self-hosted HTML, URL and Office to PDF converter (API call access).",
  "brand": "gotenberg",
  "website": "https://gotenberg.dev",
  "docs_url": "https://gotenberg.dev/docs/getting-started/introduction",
  "base_url": "{{ credentials.base_url }}",
  "auth": [
    {
      "type": "basic",
      "fields": [
        {
          "key": "base_url",
          "label": "Gotenberg URL",
          "type": "string",
          "required": true,
          "placeholder": "http://gotenberg:3000",
          "help": "No trailing slash."
        },
        {
          "key": "username",
          "label": "Username",
          "type": "string",
          "required": false,
          "help": "Only if basic auth is enabled on the server."
        },
        {
          "key": "password",
          "label": "Password",
          "type": "password",
          "required": false
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "health",
      "name": "Health check",
      "method": "GET",
      "endpoint": "/health",
      "inputs": []
    }
  ]
}
