{
  "key": "airtable",
  "name": "Airtable",
  "category": "Productivity",
  "description": "Create and list records in a base.",
  "base_url": "https://api.airtable.com/v0",
  "auth": { "type": "bearer", "fields": [{ "key": "token", "label": "Personal access token", "type": "password", "required": true }] },
  "actions": [
    {
      "key": "create_record",
      "name": "Create record",
      "method": "POST",
      "endpoint": "/{{ inputs.base_id }}/{{ inputs.table }}",
      "body": { "fields": "{{ inputs.fields }}", "typecast": true },
      "inputs": [
        { "key": "base_id", "label": "Base ID", "type": "string", "required": true, "placeholder": "appXXXXXXXXXXXXXX" },
        { "key": "table", "label": "Table name or ID", "type": "string", "required": true },
        { "key": "fields", "label": "Fields", "type": "keyvalue", "required": true }
      ]
    },
    {
      "key": "list_records",
      "name": "List records",
      "method": "GET",
      "endpoint": "/{{ inputs.base_id }}/{{ inputs.table }}",
      "query": { "maxRecords": "{{ inputs.max_records }}", "view": "{{ inputs.view }}", "filterByFormula": "{{ inputs.formula }}" },
      "inputs": [
        { "key": "base_id", "label": "Base ID", "type": "string", "required": true },
        { "key": "table", "label": "Table name or ID", "type": "string", "required": true },
        { "key": "view", "label": "View", "type": "string" },
        { "key": "formula", "label": "Filter formula", "type": "string", "placeholder": "{Status} = 'Open'" },
        { "key": "max_records", "label": "Max records", "type": "number", "default": 100 }
      ]
    }
  ]
}
