{
  "key": "visual_crossing",
  "name": "Visual Crossing Weather",
  "category": "Utilities",
  "description": "Weather forecasts and historical weather for any location and date range.",
  "brand": "visualcrossing",
  "website": "https://www.visualcrossing.com",
  "docs_url": "https://www.visualcrossing.com/resources/documentation/weather-api/timeline-weather-api/",
  "base_url": "https://weather.visualcrossing.com/VisualCrossingWebServices/rest/services",
  "auth": { "type": "api_key", "in": "query", "name": "key", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "forecast",
      "name": "Get 15-day forecast",
      "method": "GET",
      "endpoint": "/timeline/{{ inputs.location }}",
      "query": { "unitGroup": "{{ inputs.unit_group }}", "include": "{{ inputs.include }}", "elements": "{{ inputs.elements }}", "lang": "{{ inputs.lang }}" },
      "inputs": [
        { "key": "location", "label": "Location", "type": "string", "required": true, "placeholder": "London,UK or 38.96,-96.02" },
        { "key": "unit_group", "label": "Units", "type": "select", "options": [
          { "value": "us", "label": "US" }, { "value": "metric", "label": "Metric" }, { "value": "uk", "label": "UK" }, { "value": "base", "label": "Base (Kelvin)" }
        ] },
        { "key": "include", "label": "Include", "type": "string", "placeholder": "days,hours,current,alerts" },
        { "key": "elements", "label": "Only these elements", "type": "string", "placeholder": "datetime,tempmax,tempmin,precip" },
        { "key": "lang", "label": "Language", "type": "string" }
      ]
    },
    {
      "key": "weather_for_dates",
      "name": "Get weather for dates",
      "description": "Historical or forecast weather between two dates (use the same date twice for one day).",
      "method": "GET",
      "endpoint": "/timeline/{{ inputs.location }}/{{ inputs.start_date }}/{{ inputs.end_date }}",
      "query": { "unitGroup": "{{ inputs.unit_group }}", "include": "{{ inputs.include }}", "elements": "{{ inputs.elements }}" },
      "inputs": [
        { "key": "location", "label": "Location", "type": "string", "required": true },
        { "key": "start_date", "label": "Start date", "type": "string", "required": true, "placeholder": "2025-06-01" },
        { "key": "end_date", "label": "End date", "type": "string", "required": true, "placeholder": "2025-06-07" },
        { "key": "unit_group", "label": "Units", "type": "select", "options": [
          { "value": "us", "label": "US" }, { "value": "metric", "label": "Metric" }, { "value": "uk", "label": "UK" }, { "value": "base", "label": "Base (Kelvin)" }
        ] },
        { "key": "include", "label": "Include", "type": "string", "placeholder": "days,hours" },
        { "key": "elements", "label": "Only these elements", "type": "string" }
      ]
    }
  ]
}
