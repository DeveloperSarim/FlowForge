{
  "key": "less_annoying_crm",
  "name": "Less Annoying CRM",
  "category": "CRM & Sales",
  "description": "Search and read contacts, and add notes in Less Annoying CRM.",
  "brand": "lessannoyingcrm",
  "website": "https://www.lessannoyingcrm.com",
  "docs_url": "https://www.lessannoyingcrm.com/help/topic/API_Documentation",
  "base_url": "https://api.lessannoyingcrm.com/v2",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "Authorization",
      "fields": [
        {
          "key": "api_key",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Settings > Programmer API."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "search_contacts",
      "name": "Search contacts",
      "method": "POST",
      "endpoint": "/",
      "body": {
        "Function": "SearchContacts",
        "Parameters": {
          "SearchTerms": "{{ inputs.search_terms }}"
        }
      },
      "inputs": [
        {
          "key": "search_terms",
          "label": "Search",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "get_contact",
      "name": "Get contact",
      "method": "POST",
      "endpoint": "/",
      "body": {
        "Function": "GetContact",
        "Parameters": {
          "ContactId": "{{ inputs.contact_id }}"
        }
      },
      "inputs": [
        {
          "key": "contact_id",
          "label": "Contact ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "create_note",
      "name": "Create note",
      "method": "POST",
      "endpoint": "/",
      "body": {
        "Function": "CreateNote",
        "Parameters": {
          "ContactId": "{{ inputs.contact_id }}",
          "Note": "{{ inputs.note }}"
        }
      },
      "inputs": [
        {
          "key": "contact_id",
          "label": "Contact ID",
          "type": "string",
          "required": true
        },
        {
          "key": "note",
          "label": "Note",
          "type": "text",
          "required": true
        }
      ]
    }
  ]
}
