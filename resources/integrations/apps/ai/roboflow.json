{
  "key": "roboflow",
  "name": "Roboflow",
  "category": "AI",
  "description": "Run your Roboflow object-detection models on images.",
  "brand": "roboflow",
  "website": "https://roboflow.com",
  "docs_url": "https://docs.roboflow.com/api-reference/introduction",
  "base_url": "https://api.roboflow.com",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "api_key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "detect_objects",
      "name": "Detect objects",
      "method": "POST",
      "endpoint": "https://detect.roboflow.com/{{ inputs.project }}/{{ inputs.version }}",
      "query": {
        "image": "{{ inputs.image_url }}",
        "confidence": "{{ inputs.confidence }}"
      },
      "output_fields": {
        "predictions": "predictions"
      },
      "inputs": [
        {
          "key": "project",
          "label": "Project ID",
          "type": "string",
          "required": true
        },
        {
          "key": "version",
          "label": "Model version",
          "type": "number",
          "required": true
        },
        {
          "key": "image_url",
          "label": "Image URL",
          "type": "string",
          "required": true
        },
        {
          "key": "confidence",
          "label": "Min confidence (0-100)",
          "type": "number",
          "placeholder": "40"
        }
      ]
    },
    {
      "key": "get_workspace",
      "name": "Get workspace",
      "method": "GET",
      "endpoint": "/{{ inputs.workspace }}",
      "inputs": [
        {
          "key": "workspace",
          "label": "Workspace ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
