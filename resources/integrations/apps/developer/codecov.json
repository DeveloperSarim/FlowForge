{
  "key": "codecov",
  "name": "Codecov",
  "category": "Developer Tools",
  "description": "Read repository coverage totals and commit coverage.",
  "brand": "codecov",
  "website": "https://about.codecov.io",
  "docs_url": "https://docs.codecov.com/reference/overview",
  "base_url": "https://api.codecov.io/api/v2",
  "auth": { "type": "bearer", "fields": [{ "key": "token", "label": "API access token", "type": "password", "required": true, "help": "Settings → Access → Generate token." }] },
  "actions": [
    {
      "key": "get_repo",
      "name": "Get repository",
      "method": "GET",
      "endpoint": "/{{ inputs.service }}/{{ inputs.owner }}/repos/{{ inputs.repo }}/",
      "inputs": [
        { "key": "service", "label": "Git provider", "type": "select", "required": true, "default": "github", "options": [
          { "value": "github", "label": "GitHub" }, { "value": "gitlab", "label": "GitLab" }, { "value": "bitbucket", "label": "Bitbucket" }
        ] },
        { "key": "owner", "label": "Owner", "type": "string", "required": true },
        { "key": "repo", "label": "Repository", "type": "string", "required": true }
      ]
    },
    {
      "key": "get_totals",
      "name": "Get coverage totals",
      "method": "GET",
      "endpoint": "/{{ inputs.service }}/{{ inputs.owner }}/repos/{{ inputs.repo }}/totals/",
      "query": { "branch": "{{ inputs.branch }}", "sha": "{{ inputs.sha }}" },
      "inputs": [
        { "key": "service", "label": "Git provider", "type": "select", "required": true, "default": "github", "options": [
          { "value": "github", "label": "GitHub" }, { "value": "gitlab", "label": "GitLab" }, { "value": "bitbucket", "label": "Bitbucket" }
        ] },
        { "key": "owner", "label": "Owner", "type": "string", "required": true },
        { "key": "repo", "label": "Repository", "type": "string", "required": true },
        { "key": "branch", "label": "Branch", "type": "string" },
        { "key": "sha", "label": "Commit SHA", "type": "string" }
      ]
    },
    {
      "key": "list_commits",
      "name": "List commits",
      "method": "GET",
      "endpoint": "/{{ inputs.service }}/{{ inputs.owner }}/repos/{{ inputs.repo }}/commits/",
      "query": { "branch": "{{ inputs.branch }}" },
      "output_path": "results",
      "inputs": [
        { "key": "service", "label": "Git provider", "type": "select", "required": true, "default": "github", "options": [
          { "value": "github", "label": "GitHub" }, { "value": "gitlab", "label": "GitLab" }, { "value": "bitbucket", "label": "Bitbucket" }
        ] },
        { "key": "owner", "label": "Owner", "type": "string", "required": true },
        { "key": "repo", "label": "Repository", "type": "string", "required": true },
        { "key": "branch", "label": "Branch", "type": "string" }
      ]
    }
  ]
}
