{
  "key": "ona",
  "name": "Ona",
  "category": "Forms & Surveys",
  "description": "Mobile data collection: read Ona forms, projects and submitted data.",
  "website": "https://ona.io",
  "docs_url": "https://api.ona.io/api/v1/",
  "base_url": "https://api.ona.io/api/v1",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "Authorization",
    "prefix": "Token ",
    "fields": [
      {
        "key": "api_key",
        "label": "API token",
        "type": "password",
        "required": true,
        "help": "Ona > your profile > Settings > API Token: copy the token."
      }
    ]
  },
  "actions": [
    {
      "key": "list_forms",
      "name": "List forms",
      "description": "Get the forms you can access.",
      "method": "GET",
      "endpoint": "/forms",
      "output_fields": {
        "ids": "*.formid",
        "titles": "*.title"
      },
      "inputs": []
    },
    {
      "key": "list_data",
      "name": "List submissions",
      "description": "Get the submissions to a form.",
      "method": "GET",
      "endpoint": "/data/{{ inputs.form_id }}",
      "query": {
        "page": "{{ inputs.page }}",
        "page_size": "{{ inputs.page_size }}"
      },
      "inputs": [
        {
          "key": "form_id",
          "label": "Form ID",
          "type": "string",
          "required": true,
          "help": "The numeric form ID from List forms."
        },
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "default": 1
        },
        {
          "key": "page_size",
          "label": "Page size",
          "type": "number",
          "default": 50
        }
      ]
    },
    {
      "key": "get_submission",
      "name": "Get a submission",
      "description": "Get one submission.",
      "method": "GET",
      "endpoint": "/data/{{ inputs.form_id }}/{{ inputs.submission_id }}",
      "inputs": [
        {
          "key": "form_id",
          "label": "Form ID",
          "type": "string",
          "required": true
        },
        {
          "key": "submission_id",
          "label": "Submission ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_projects",
      "name": "List projects",
      "description": "Get your projects.",
      "method": "GET",
      "endpoint": "/projects",
      "output_fields": {
        "ids": "*.projectid",
        "names": "*.name"
      },
      "inputs": []
    }
  ]
}
