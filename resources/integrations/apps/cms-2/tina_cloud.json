{
  "key": "tina_cloud",
  "name": "TinaCloud",
  "category": "CMS & Websites",
  "description": "Query TinaCMS content in TinaCloud with GraphQL.",
  "brand": "tina",
  "website": "https://tina.io",
  "docs_url": "https://tina.io/docs/reference/content-api/content-delivery",
  "base_url": "https://content.tinajs.io/{{ credentials.version }}/content/{{ credentials.client_id }}/github",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "X-API-KEY",
      "fields": [
        {
          "key": "client_id",
          "label": "Client ID",
          "type": "string",
          "required": true
        },
        {
          "key": "version",
          "label": "GraphQL version",
          "type": "string",
          "required": true,
          "placeholder": "1.5",
          "help": "major.minor of @tinacms/graphql in your project."
        },
        {
          "key": "api_key",
          "label": "Read-only token",
          "type": "password",
          "required": true,
          "help": "TinaCloud project > Tokens."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "graphql_query",
      "name": "Run GraphQL query",
      "method": "POST",
      "endpoint": "/{{ inputs.branch }}",
      "body": {
        "query": "{{ inputs.query }}",
        "variables": "{{ inputs.variables }}"
      },
      "inputs": [
        {
          "key": "branch",
          "label": "Branch",
          "type": "string",
          "required": true,
          "default": "main"
        },
        {
          "key": "query",
          "label": "Query",
          "type": "code",
          "required": true,
          "placeholder": "query { postConnection { edges { node { title } } } }"
        },
        {
          "key": "variables",
          "label": "Variables",
          "type": "json"
        }
      ]
    }
  ]
}
