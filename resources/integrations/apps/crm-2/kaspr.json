{
  "key": "kaspr",
  "name": "Kaspr",
  "category": "CRM & Sales",
  "description": "Get emails and phone numbers for a LinkedIn profile.",
  "brand": "kaspr",
  "website": "https://www.kaspr.io",
  "base_url": "https://api.developers.kaspr.io",
  "auth": {
    "type": "bearer",
    "fields": [{ "key": "token", "label": "API key", "type": "password", "required": true }]
  },
  "actions": [
    {
      "key": "enrich_linkedin_profile",
      "name": "Enrich LinkedIn profile",
      "method": "POST",
      "endpoint": "/profile/linkedin",
      "output_path": "profile",
      "body": { "id": "{{ inputs.linkedin_id }}", "name": "{{ inputs.name }}", "isPhoneRequired": "{{ inputs.phone_required }}" },
      "inputs": [
        { "key": "linkedin_id", "label": "LinkedIn ID or URL", "type": "string", "required": true },
        { "key": "name", "label": "Full name", "type": "string", "required": true },
        { "key": "phone_required", "label": "Phone required", "type": "boolean" }
      ]
    }
  ]
}
