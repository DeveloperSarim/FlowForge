{
  "key": "tinypng",
  "name": "TinyPNG",
  "category": "Video & Media",
  "description": "Compress PNG, JPEG and WebP images from a URL with the Tinify API.",
  "brand": "tinypng",
  "website": "https://tinypng.com",
  "docs_url": "https://tinypng.com/developers/reference",
  "base_url": "https://api.tinify.com",
  "auth": { "type": "basic", "fields": [
    { "key": "username", "label": "Username", "type": "string", "required": true, "default": "api", "help": "Always \"api\"." },
    { "key": "password", "label": "API key", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "compress_image_url",
      "name": "Compress image from URL",
      "description": "output.url is the compressed image (valid for a limited time).",
      "method": "POST",
      "endpoint": "/shrink",
      "timeout": 60,
      "body": { "source": { "url": "{{ inputs.url }}" } },
      "inputs": [{ "key": "url", "label": "Image URL", "type": "string", "required": true }]
    }
  ]
}
