{
  "key": "kraken_io",
  "name": "Kraken.io",
  "category": "Video & Media",
  "description": "Optimise and resize images from a URL; returns the optimised image URL.",
  "brand": "krakenio",
  "website": "https://kraken.io",
  "docs_url": "https://kraken.io/docs/getting-started",
  "base_url": "https://api.kraken.io/v1",
  "auth": { "type": "api_key", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true },
    { "key": "api_secret", "label": "API secret", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "optimize_image_url",
      "name": "Optimise image from URL",
      "description": "Waits for the result; kraked_url holds the optimised image.",
      "method": "POST",
      "endpoint": "/url",
      "error_path": "message",
      "timeout": 90,
      "body": {
        "auth": { "api_key": "{{ credentials.api_key }}", "api_secret": "{{ credentials.api_secret }}" },
        "url": "{{ inputs.url }}",
        "wait": true,
        "lossy": "{{ inputs.lossy }}",
        "resize": "{{ inputs.resize }}"
      },
      "inputs": [
        { "key": "url", "label": "Image URL", "type": "string", "required": true },
        { "key": "lossy", "label": "Lossy compression", "type": "boolean" },
        { "key": "resize", "label": "Resize (JSON)", "type": "json", "placeholder": "{\"width\":800,\"height\":600,\"strategy\":\"auto\"}" }
      ]
    }
  ]
}
