{
  "key": "gusto",
  "name": "Gusto",
  "category": "HR & Recruiting",
  "description": "Read companies and employees from Gusto payroll.",
  "brand": "gusto",
  "website": "https://gusto.com",
  "docs_url": "https://docs.gusto.com/app-integrations/reference",
  "base_url": "https://api.gusto.com/v1",
  "auth": [
    {
      "type": "oauth2",
      "authorize_url": "https://api.gusto.com/oauth/authorize",
      "token_url": "https://api.gusto.com/oauth/token",
      "scopes": []
    }
  ],
  "actions": [
    {
      "key": "get_company",
      "name": "Get company",
      "method": "GET",
      "endpoint": "/companies/{{ inputs.company_uuid }}",
      "inputs": [
        {
          "key": "company_uuid",
          "label": "Company UUID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_employees",
      "name": "List employees",
      "method": "GET",
      "endpoint": "/companies/{{ inputs.company_uuid }}/employees",
      "query": {
        "terminated": "{{ inputs.terminated }}"
      },
      "inputs": [
        {
          "key": "company_uuid",
          "label": "Company UUID",
          "type": "string",
          "required": true
        },
        {
          "key": "terminated",
          "label": "Terminated only",
          "type": "boolean",
          "default": false
        }
      ]
    },
    {
      "key": "get_employee",
      "name": "Get employee",
      "method": "GET",
      "endpoint": "/employees/{{ inputs.employee_uuid }}",
      "inputs": [
        {
          "key": "employee_uuid",
          "label": "Employee UUID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
