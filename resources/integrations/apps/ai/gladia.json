{
  "key": "gladia",
  "name": "Gladia",
  "category": "AI",
  "description": "Transcribe audio from a URL with Gladia speech-to-text.",
  "brand": "gladia",
  "website": "https://www.gladia.io",
  "docs_url": "https://docs.gladia.io/api-reference",
  "base_url": "https://api.gladia.io/v2",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "x-gladia-key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "transcribe",
      "name": "Transcribe audio URL",
      "description": "Starts a job; fetch it with Get result.",
      "method": "POST",
      "endpoint": "/pre-recorded",
      "body": {
        "audio_url": "{{ inputs.audio_url }}",
        "diarization": "{{ inputs.diarization }}"
      },
      "inputs": [
        {
          "key": "audio_url",
          "label": "Audio URL",
          "type": "string",
          "required": true
        },
        {
          "key": "diarization",
          "label": "Identify speakers",
          "type": "boolean"
        }
      ]
    },
    {
      "key": "get_result",
      "name": "Get result",
      "method": "GET",
      "endpoint": "/pre-recorded/{{ inputs.job_id }}",
      "output_fields": {
        "text": "result.transcription.full_transcript"
      },
      "inputs": [
        {
          "key": "job_id",
          "label": "Job ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
