{
  "key": "zenrows",
  "name": "ZenRows",
  "category": "Utilities",
  "description": "Scrape any web page through rotating proxies, with JavaScript rendering and parsing.",
  "website": "https://www.zenrows.com",
  "docs_url": "https://docs.zenrows.com/universal-scraper-api/api-reference",
  "base_url": "https://api.zenrows.com/v1",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "apikey",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "app.zenrows.com → Builder (top right) → copy your API key."
      }
    ]
  },
  "actions": [
    {
      "key": "scrape_page",
      "name": "Scrape page",
      "description": "Download a page as Markdown, plain text or HTML.",
      "method": "GET",
      "endpoint": "/",
      "query": {
        "url": "{{ inputs.url }}",
        "js_render": "{{ inputs.js_render }}",
        "premium_proxy": "{{ inputs.premium_proxy }}",
        "proxy_country": "{{ inputs.proxy_country }}",
        "response_type": "{{ inputs.response_type }}",
        "wait_for": "{{ inputs.wait_for }}"
      },
      "timeout": 120,
      "inputs": [
        {
          "key": "url",
          "label": "Page URL",
          "type": "string",
          "required": true,
          "placeholder": "https://example.com"
        },
        {
          "key": "js_render",
          "label": "Render JavaScript",
          "type": "boolean",
          "default": false,
          "help": "Turn on for pages that load content with JavaScript."
        },
        {
          "key": "premium_proxy",
          "label": "Use premium (residential) proxies",
          "type": "boolean",
          "default": false,
          "help": "Helps with sites that block scrapers. Uses more credits."
        },
        {
          "key": "proxy_country",
          "label": "Proxy country",
          "type": "string",
          "placeholder": "us",
          "help": "Two-letter country code. Needs premium proxies."
        },
        {
          "key": "response_type",
          "label": "Return as",
          "type": "select",
          "default": "markdown",
          "options": [
            {
              "value": "markdown",
              "label": "Markdown"
            },
            {
              "value": "plaintext",
              "label": "Plain text"
            },
            {
              "value": "",
              "label": "Raw HTML"
            }
          ]
        },
        {
          "key": "wait_for",
          "label": "Wait for element (CSS selector)",
          "type": "string",
          "help": "With JavaScript rendering: wait until this element appears."
        }
      ]
    },
    {
      "key": "extract_with_css",
      "name": "Extract data with CSS selectors",
      "description": "Pull specific fields out of a page and get them back as JSON.",
      "method": "GET",
      "endpoint": "/",
      "query": {
        "url": "{{ inputs.url }}",
        "js_render": "{{ inputs.js_render }}",
        "premium_proxy": "{{ inputs.premium_proxy }}",
        "proxy_country": "{{ inputs.proxy_country }}",
        "css_extractor": "{{ inputs.css_extractor }}"
      },
      "timeout": 120,
      "inputs": [
        {
          "key": "url",
          "label": "Page URL",
          "type": "string",
          "required": true
        },
        {
          "key": "css_extractor",
          "label": "Fields to extract (JSON)",
          "type": "text",
          "required": true,
          "placeholder": "{\"title\": \"h1\", \"price\": \".price\"}",
          "help": "Field name → CSS selector."
        },
        {
          "key": "js_render",
          "label": "Render JavaScript",
          "type": "boolean",
          "default": false,
          "help": "Turn on for pages that load content with JavaScript."
        },
        {
          "key": "premium_proxy",
          "label": "Use premium (residential) proxies",
          "type": "boolean",
          "default": false,
          "help": "Helps with sites that block scrapers. Uses more credits."
        },
        {
          "key": "proxy_country",
          "label": "Proxy country",
          "type": "string",
          "placeholder": "us",
          "help": "Two-letter country code. Needs premium proxies."
        }
      ]
    },
    {
      "key": "auto_parse",
      "name": "Auto-parse page",
      "description": "Let ZenRows detect and return the structured data on supported sites.",
      "method": "GET",
      "endpoint": "/",
      "query": {
        "url": "{{ inputs.url }}",
        "js_render": "{{ inputs.js_render }}",
        "premium_proxy": "{{ inputs.premium_proxy }}",
        "proxy_country": "{{ inputs.proxy_country }}",
        "autoparse": "true"
      },
      "timeout": 120,
      "inputs": [
        {
          "key": "url",
          "label": "Page URL",
          "type": "string",
          "required": true
        },
        {
          "key": "js_render",
          "label": "Render JavaScript",
          "type": "boolean",
          "default": false,
          "help": "Turn on for pages that load content with JavaScript."
        },
        {
          "key": "premium_proxy",
          "label": "Use premium (residential) proxies",
          "type": "boolean",
          "default": false,
          "help": "Helps with sites that block scrapers. Uses more credits."
        },
        {
          "key": "proxy_country",
          "label": "Proxy country",
          "type": "string",
          "placeholder": "us",
          "help": "Two-letter country code. Needs premium proxies."
        }
      ]
    }
  ]
}
