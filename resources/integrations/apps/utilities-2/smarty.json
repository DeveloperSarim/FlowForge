{
  "key": "smarty",
  "name": "Smarty",
  "category": "Utilities",
  "description": "Verify and standardize US and international addresses, ZIP codes and autocomplete.",
  "brand": "smarty",
  "website": "https://www.smarty.com",
  "docs_url": "https://www.smarty.com/docs/cloud",
  "base_url": "https://us-street.api.smarty.com",
  "auth": { "type": "basic", "fields": [
    { "key": "username", "label": "Auth ID", "type": "string", "required": true, "help": "Account → API Keys → Secret keys." },
    { "key": "password", "label": "Auth token", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "verify_us_address",
      "name": "Verify US address",
      "method": "GET",
      "endpoint": "/street-address",
      "query": { "street": "{{ inputs.street }}", "secondary": "{{ inputs.secondary }}", "city": "{{ inputs.city }}", "state": "{{ inputs.state }}", "zipcode": "{{ inputs.zipcode }}", "candidates": "{{ inputs.candidates }}" },
      "inputs": [
        { "key": "street", "label": "Street (or full address)", "type": "string", "required": true, "placeholder": "1600 Amphitheatre Pkwy" },
        { "key": "secondary", "label": "Apartment / suite", "type": "string" },
        { "key": "city", "label": "City", "type": "string" },
        { "key": "state", "label": "State", "type": "string" },
        { "key": "zipcode", "label": "ZIP code", "type": "string" },
        { "key": "candidates", "label": "Max candidates", "type": "number" }
      ]
    },
    {
      "key": "lookup_zipcode",
      "name": "Look up US ZIP code / city",
      "method": "GET",
      "endpoint": "https://us-zipcode.api.smarty.com/lookup",
      "query": { "city": "{{ inputs.city }}", "state": "{{ inputs.state }}", "zipcode": "{{ inputs.zipcode }}" },
      "inputs": [
        { "key": "city", "label": "City", "type": "string" },
        { "key": "state", "label": "State", "type": "string" },
        { "key": "zipcode", "label": "ZIP code", "type": "string", "help": "Give a ZIP code, or a city + state." }
      ]
    },
    {
      "key": "verify_international_address",
      "name": "Verify international address",
      "method": "GET",
      "endpoint": "https://international-street.api.smarty.com/verify",
      "query": { "country": "{{ inputs.country }}", "address1": "{{ inputs.address1 }}", "address2": "{{ inputs.address2 }}", "locality": "{{ inputs.locality }}", "administrative_area": "{{ inputs.administrative_area }}", "postal_code": "{{ inputs.postal_code }}" },
      "inputs": [
        { "key": "country", "label": "Country", "type": "string", "required": true, "placeholder": "DEU" },
        { "key": "address1", "label": "Address line 1 (or full address)", "type": "string", "required": true },
        { "key": "address2", "label": "Address line 2", "type": "string" },
        { "key": "locality", "label": "City / locality", "type": "string" },
        { "key": "administrative_area", "label": "State / province", "type": "string" },
        { "key": "postal_code", "label": "Postal code", "type": "string" }
      ]
    },
    {
      "key": "autocomplete",
      "name": "Autocomplete US address",
      "method": "GET",
      "endpoint": "https://us-autocomplete-pro.api.smarty.com/lookup",
      "query": { "search": "{{ inputs.search }}", "max_results": "{{ inputs.max_results }}" },
      "inputs": [
        { "key": "search", "label": "Partial address", "type": "string", "required": true },
        { "key": "max_results", "label": "Max results", "type": "number" }
      ]
    }
  ]
}
