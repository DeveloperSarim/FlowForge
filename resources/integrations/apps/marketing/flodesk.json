{
  "key": "flodesk",
  "name": "Flodesk",
  "category": "Marketing & Email",
  "description": "Add subscribers and put them in segments.",
  "brand": "flodesk",
  "website": "https://flodesk.com",
  "docs_url": "https://developers.flodesk.com/",
  "base_url": "https://api.flodesk.com/v1",
  "auth": {
    "type": "basic",
    "fields": [
      {
        "key": "username",
        "label": "API key",
        "type": "password",
        "required": true
      },
      {
        "key": "password",
        "label": "Password",
        "type": "password",
        "required": false,
        "default": "",
        "help": "Leave blank."
      }
    ]
  },
  "actions": [
    {
      "key": "upsert_subscriber",
      "name": "Create or update subscriber",
      "method": "POST",
      "endpoint": "/subscribers",
      "body": {
        "email": "{{ inputs.email }}",
        "first_name": "{{ inputs.first_name }}",
        "last_name": "{{ inputs.last_name }}",
        "segment_ids": "{{ inputs.segment_ids }}",
        "custom_fields": "{{ inputs.custom_fields }}"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "first_name",
          "label": "First name",
          "type": "string"
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "segment_ids",
          "label": "Segment IDs",
          "type": "list"
        },
        {
          "key": "custom_fields",
          "label": "Custom fields",
          "type": "keyvalue"
        }
      ]
    },
    {
      "key": "add_to_segments",
      "name": "Add subscriber to segments",
      "method": "POST",
      "endpoint": "/subscribers/{{ inputs.email }}/segments",
      "body": {
        "segment_ids": "{{ inputs.segment_ids }}"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email or subscriber ID",
          "type": "string",
          "required": true
        },
        {
          "key": "segment_ids",
          "label": "Segment IDs",
          "type": "list",
          "required": true
        }
      ]
    },
    {
      "key": "list_segments",
      "name": "List segments",
      "method": "GET",
      "endpoint": "/segments",
      "output_path": "data",
      "inputs": []
    }
  ]
}
