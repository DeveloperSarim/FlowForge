{
  "key": "talentlms",
  "name": "TalentLMS",
  "category": "Education",
  "description": "Create users, enroll them in courses and list courses in TalentLMS.",
  "brand": "talentlms",
  "website": "https://www.talentlms.com",
  "docs_url": "https://help.talentlms.com",
  "base_url": "https://{{ credentials.domain }}.talentlms.com/api/v2",
  "headers": {
    "X-API-Version": "2025-01-01"
  },
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "X-API-Key",
      "fields": [
        {
          "key": "domain",
          "label": "Domain",
          "type": "string",
          "required": true,
          "placeholder": "acme",
          "help": "The part before .talentlms.com."
        },
        {
          "key": "api_key",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Account & Settings > Integrations > API."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_users",
      "name": "List users",
      "method": "GET",
      "endpoint": "/users",
      "output_path": "_data",
      "inputs": []
    },
    {
      "key": "create_user",
      "name": "Create user",
      "method": "POST",
      "endpoint": "/users",
      "body": {
        "name": "{{ inputs.name }}",
        "surname": "{{ inputs.surname }}",
        "email": "{{ inputs.email }}",
        "login": "{{ inputs.login }}",
        "password": "{{ inputs.password }}"
      },
      "inputs": [
        {
          "key": "name",
          "label": "First name",
          "type": "string",
          "required": true
        },
        {
          "key": "surname",
          "label": "Last name",
          "type": "string",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "login",
          "label": "Username",
          "type": "string",
          "required": true
        },
        {
          "key": "password",
          "label": "Password",
          "type": "password",
          "required": true
        }
      ]
    },
    {
      "key": "list_courses",
      "name": "List courses",
      "method": "GET",
      "endpoint": "/courses",
      "output_path": "_data",
      "inputs": []
    },
    {
      "key": "enroll_user",
      "name": "Enroll user in course",
      "method": "POST",
      "endpoint": "/enrollments",
      "body": {
        "user_id": "{{ inputs.user_id }}",
        "course_id": "{{ inputs.course_id }}"
      },
      "inputs": [
        {
          "key": "user_id",
          "label": "User ID",
          "type": "number",
          "required": true
        },
        {
          "key": "course_id",
          "label": "Course ID",
          "type": "number",
          "required": true
        }
      ]
    }
  ]
}
