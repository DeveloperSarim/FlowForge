{
  "key": "fastly",
  "name": "Fastly",
  "category": "Developer Tools",
  "description": "Purge cache by surrogate key or for a whole service and list services.",
  "brand": "fastly",
  "website": "https://www.fastly.com",
  "docs_url": "https://www.fastly.com/documentation/reference/api/",
  "base_url": "https://api.fastly.com",
  "auth": { "type": "api_key", "in": "header", "name": "Fastly-Key", "fields": [
    { "key": "api_key", "label": "API token", "type": "password", "required": true, "help": "Account → Personal API tokens, with the purge_select / purge_all or global scope." }
  ] },
  "actions": [
    {
      "key": "purge_key",
      "name": "Purge by surrogate key",
      "method": "POST",
      "endpoint": "/service/{{ inputs.service_id }}/purge/{{ inputs.surrogate_key }}",
      "headers": { "Fastly-Soft-Purge": "{{ inputs.soft }}" },
      "inputs": [
        { "key": "service_id", "label": "Service ID", "type": "string", "required": true },
        { "key": "surrogate_key", "label": "Surrogate key", "type": "string", "required": true },
        { "key": "soft", "label": "Soft purge", "type": "select", "options": [{ "value": "1", "label": "Yes, mark content stale instead of removing it" }] }
      ]
    },
    {
      "key": "purge_all",
      "name": "Purge everything",
      "method": "POST",
      "endpoint": "/service/{{ inputs.service_id }}/purge_all",
      "inputs": [{ "key": "service_id", "label": "Service ID", "type": "string", "required": true }]
    },
    {
      "key": "list_services",
      "name": "List services",
      "method": "GET",
      "endpoint": "/service",
      "inputs": []
    },
    {
      "key": "get_service_details",
      "name": "Get service details",
      "method": "GET",
      "endpoint": "/service/{{ inputs.service_id }}/details",
      "inputs": [{ "key": "service_id", "label": "Service ID", "type": "string", "required": true }]
    }
  ]
}
