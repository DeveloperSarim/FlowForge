{
  "key": "databox",
  "name": "Databox",
  "category": "Analytics",
  "description": "Push custom metric values to a Databox data source.",
  "brand": "databox",
  "website": "https://databox.com",
  "docs_url": "https://developers.databox.com",
  "base_url": "https://push.databox.com",
  "headers": { "Accept": "application/vnd.databox.v2+json" },
  "auth": { "type": "basic", "fields": [
    { "key": "username", "label": "Push token", "type": "password", "required": true, "help": "Data Manager > your Token/API data source." },
    { "key": "password", "label": "Password", "type": "password", "required": false, "default": "", "help": "Leave empty." }
  ] },
  "actions": [
    {
      "key": "push_data",
      "name": "Push metric values",
      "method": "POST",
      "endpoint": "/",
      "body": { "data": "{{ inputs.data }}" },
      "inputs": [
        { "key": "data", "label": "Data points (JSON array)", "type": "json", "required": true,
          "placeholder": "[{ \"$sales\": 123000, \"date\": \"2026-01-31\" }, { \"$visitors\": 812 }]",
          "help": "Metric keys start with $. Add date (ISO) and unit or dimension attributes as needed." }
      ]
    }
  ]
}
