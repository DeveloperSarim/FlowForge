{
  "key": "bulksms",
  "name": "BulkSMS",
  "category": "Communication",
  "description": "Send SMS and list sent or received messages with BulkSMS.com.",
  "brand": "bulksms",
  "website": "https://www.bulksms.com",
  "docs_url": "https://www.bulksms.com/developer/json/v1/",
  "base_url": "https://api.bulksms.com/v1",
  "auth": [
    {
      "type": "basic",
      "fields": [
        { "key": "username", "label": "Token ID", "type": "string", "required": true },
        { "key": "password", "label": "Token secret", "type": "password", "required": true }
      ]
    }
  ],
  "actions": [
    {
      "key": "send_sms",
      "name": "Send SMS",
      "method": "POST",
      "endpoint": "/messages",
      "body": { "to": "{{ inputs.to }}", "from": "{{ inputs.from }}", "body": "{{ inputs.body }}" },
      "inputs": [
        { "key": "to", "label": "To", "type": "string", "required": true, "placeholder": "+27001234567" },
        { "key": "from", "label": "From", "type": "string" },
        { "key": "body", "label": "Message", "type": "text", "required": true }
      ]
    },
    {
      "key": "list_messages",
      "name": "List messages",
      "method": "GET",
      "endpoint": "/messages",
      "query": { "filter": "{{ inputs.filter }}", "limit": "{{ inputs.limit }}" },
      "inputs": [
        { "key": "filter", "label": "Filter", "type": "string", "placeholder": "type=RECEIVED" },
        { "key": "limit", "label": "Max results", "type": "number", "default": 50 }
      ]
    },
    {
      "key": "get_profile",
      "name": "Get profile (credits)",
      "method": "GET",
      "endpoint": "/profile",
      "inputs": []
    }
  ]
}
