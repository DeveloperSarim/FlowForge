{
  "key": "weights_and_biases",
  "name": "Weights & Biases",
  "category": "AI",
  "description": "Query W&B projects, runs and artifacts through the GraphQL API.",
  "brand": "weightsandbiases",
  "website": "https://wandb.ai",
  "docs_url": "https://docs.wandb.ai/ref/",
  "base_url": "https://api.wandb.ai",
  "auth": {
    "type": "basic",
    "fields": [
      {
        "key": "username",
        "label": "Username",
        "type": "string",
        "required": true,
        "default": "api",
        "help": "Always \"api\" for API-key access."
      },
      {
        "key": "password",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "wandb.ai/authorize"
      }
    ]
  },
  "actions": [
    {
      "key": "graphql_query",
      "name": "Run GraphQL query",
      "method": "POST",
      "endpoint": "/graphql",
      "error_path": "errors",
      "body": {
        "query": "{{ inputs.query }}",
        "variables": "{{ inputs.variables }}"
      },
      "inputs": [
        {
          "key": "query",
          "label": "Query",
          "type": "code",
          "required": true,
          "placeholder": "query { project(name: \"my-project\", entityName: \"my-team\") { runs(first: 10) { edges { node { name state } } } } }"
        },
        {
          "key": "variables",
          "label": "Variables (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
