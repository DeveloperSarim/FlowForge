{
  "key": "portkey",
  "name": "Portkey",
  "category": "AI",
  "description": "Route LLM calls through the Portkey AI gateway and run saved prompts.",
  "brand": "portkey",
  "website": "https://portkey.ai",
  "docs_url": "https://portkey.ai/docs/api-reference/inference-api/introduction",
  "base_url": "https://api.portkey.ai/v1",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "x-portkey-api-key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "chat_completion",
      "name": "Chat completion",
      "description": "Send a prompt and get the reply as {{ steps.<id>.text }}.",
      "method": "POST",
      "endpoint": "/chat/completions",
      "timeout": 300,
      "headers": {
        "x-portkey-config": "{{ inputs.config }}"
      },
      "body": {
        "model": "{{ inputs.model }}",
        "messages": [
          {
            "role": "system",
            "content": "{{ inputs.system }}"
          },
          {
            "role": "user",
            "content": "{{ inputs.prompt }}"
          }
        ],
        "temperature": "{{ inputs.temperature }}",
        "max_tokens": "{{ inputs.max_tokens }}"
      },
      "output_fields": {
        "text": "choices.0.message.content"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "placeholder": "@openai-prod/gpt-4o-mini",
          "help": "@provider-slug/model from your Model Catalog."
        },
        {
          "key": "prompt",
          "label": "Prompt",
          "type": "text",
          "required": true
        },
        {
          "key": "system",
          "label": "System prompt",
          "type": "text",
          "required": true,
          "default": "You are a helpful assistant.",
          "help": "Sent as the system message."
        },
        {
          "key": "temperature",
          "label": "Temperature",
          "type": "number",
          "placeholder": "0.7"
        },
        {
          "key": "max_tokens",
          "label": "Max output tokens",
          "type": "number"
        },
        {
          "key": "config",
          "label": "Config ID",
          "type": "string",
          "placeholder": "pc-...",
          "help": "Optional saved gateway config (fallbacks, caching, …)."
        }
      ]
    },
    {
      "key": "run_prompt",
      "name": "Run prompt",
      "description": "Render a saved prompt template and get the reply as {{ steps.<id>.text }}.",
      "method": "POST",
      "endpoint": "/prompts/{{ inputs.prompt_id }}/completions",
      "timeout": 300,
      "body": {
        "variables": "{{ inputs.variables }}",
        "stream": false
      },
      "output_fields": {
        "text": "choices.0.message.content"
      },
      "inputs": [
        {
          "key": "prompt_id",
          "label": "Prompt ID",
          "type": "string",
          "required": true
        },
        {
          "key": "variables",
          "label": "Variables",
          "type": "keyvalue",
          "required": true
        }
      ]
    },
    {
      "key": "send_feedback",
      "name": "Send feedback",
      "method": "POST",
      "endpoint": "/feedback",
      "body": {
        "trace_id": "{{ inputs.trace_id }}",
        "value": "{{ inputs.value }}",
        "weight": "{{ inputs.weight }}"
      },
      "inputs": [
        {
          "key": "trace_id",
          "label": "Trace ID",
          "type": "string",
          "required": true
        },
        {
          "key": "value",
          "label": "Value (-10 to 10)",
          "type": "number",
          "required": true
        },
        {
          "key": "weight",
          "label": "Weight (0-1)",
          "type": "number"
        }
      ]
    }
  ]
}
