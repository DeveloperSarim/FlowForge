{
  "key": "process_street",
  "name": "Process Street",
  "category": "Project Management",
  "description": "Receive Process Street webhooks and call its public API.",
  "brand": "processstreet",
  "website": "https://www.process.st",
  "docs_url": "https://public-api.process.st/api/v1.1/docs/index.html",
  "base_url": "https://public-api.process.st/api/v1.1",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "X-API-Key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Organization settings > Integrations (admins only)."
      }
    ]
  },
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "Add this URL under Settings > Integrations > Webhooks.",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
