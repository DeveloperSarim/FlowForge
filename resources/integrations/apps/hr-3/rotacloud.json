{
  "key": "rotacloud",
  "name": "RotaCloud",
  "category": "HR & Recruiting",
  "description": "Read staff, rota shifts, leave and locations from RotaCloud.",
  "website": "https://rotacloud.com",
  "docs_url": "https://rotacloud.com/api-docs",
  "base_url": "https://api.rotacloud.com/v1",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "In RotaCloud open Settings → Integrations → API → Generate API key."
      }
    ]
  },
  "actions": [
    {
      "key": "list_users",
      "name": "List staff",
      "description": "List staff members.",
      "method": "GET",
      "endpoint": "/users",
      "query": {
        "limit": "{{ inputs.limit }}"
      },
      "output_fields": {
        "first_id": "0.id",
        "first_name": "0.first_name",
        "first_email": "0.email"
      },
      "inputs": [
        {
          "key": "limit",
          "label": "How many",
          "type": "number",
          "default": 100
        }
      ]
    },
    {
      "key": "list_shifts",
      "name": "List shifts",
      "description": "List rota shifts in a date range.",
      "method": "GET",
      "endpoint": "/shifts",
      "query": {
        "start": "{{ inputs.start }}",
        "end": "{{ inputs.end }}"
      },
      "output_fields": {
        "first_id": "0.id",
        "first_start": "0.start_time",
        "first_user": "0.user"
      },
      "inputs": [
        {
          "key": "start",
          "label": "From date",
          "type": "string",
          "required": true,
          "help": "YYYY-MM-DD"
        },
        {
          "key": "end",
          "label": "To date",
          "type": "string",
          "required": true,
          "help": "YYYY-MM-DD"
        }
      ]
    },
    {
      "key": "list_leave",
      "name": "List leave",
      "description": "List leave in a date range.",
      "method": "GET",
      "endpoint": "/leave",
      "query": {
        "start": "{{ inputs.start }}",
        "end": "{{ inputs.end }}"
      },
      "output_fields": {
        "first_id": "0.id",
        "first_user": "0.user"
      },
      "inputs": [
        {
          "key": "start",
          "label": "From date",
          "type": "string",
          "required": true,
          "help": "YYYY-MM-DD"
        },
        {
          "key": "end",
          "label": "To date",
          "type": "string",
          "required": true,
          "help": "YYYY-MM-DD"
        }
      ]
    },
    {
      "key": "list_locations",
      "name": "List locations",
      "description": "List locations.",
      "method": "GET",
      "endpoint": "/locations",
      "output_fields": {
        "first_id": "0.id",
        "first_name": "0.name"
      },
      "inputs": []
    }
  ]
}
