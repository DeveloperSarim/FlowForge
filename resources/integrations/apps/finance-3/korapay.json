{
  "key": "korapay",
  "name": "Kora (Korapay)",
  "category": "Payments & Finance",
  "description": "African payments: create checkout links, verify charges and pay out to banks.",
  "website": "https://www.korahq.com",
  "docs_url": "https://developers.korapay.com/docs",
  "base_url": "https://api.korapay.com/merchant/api/v1",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "Secret key (sk_…)",
        "type": "password",
        "required": true,
        "help": "Kora dashboard → Settings → API Configuration → Secret key (test or live)."
      }
    ]
  },
  "actions": [
    {
      "key": "initialize_charge",
      "name": "Create checkout link",
      "description": "Start a payment and get the checkout URL.",
      "method": "POST",
      "endpoint": "/charges/initialize",
      "body": {
        "amount": "{{ inputs.amount }}",
        "currency": "{{ inputs.currency }}",
        "reference": "{{ inputs.reference }}",
        "narration": "{{ inputs.narration }}",
        "redirect_url": "{{ inputs.redirect_url }}",
        "notification_url": "{{ inputs.notification_url }}",
        "customer": {
          "name": "{{ inputs.customer_name }}",
          "email": "{{ inputs.customer_email }}"
        }
      },
      "output_fields": {
        "checkout_url": "data.checkout_url",
        "reference": "data.reference"
      },
      "inputs": [
        {
          "key": "amount",
          "label": "Amount",
          "type": "number",
          "required": true
        },
        {
          "key": "currency",
          "label": "Currency",
          "type": "select",
          "required": true,
          "default": "NGN",
          "options": [
            {
              "value": "NGN",
              "label": "NGN"
            },
            {
              "value": "KES",
              "label": "KES"
            },
            {
              "value": "GHS",
              "label": "GHS"
            },
            {
              "value": "ZAR",
              "label": "ZAR"
            },
            {
              "value": "XOF",
              "label": "XOF"
            },
            {
              "value": "XAF",
              "label": "XAF"
            },
            {
              "value": "EGP",
              "label": "EGP"
            },
            {
              "value": "USD",
              "label": "USD"
            }
          ]
        },
        {
          "key": "reference",
          "label": "Reference",
          "type": "string",
          "required": true,
          "help": "Your unique reference for this payment."
        },
        {
          "key": "customer_email",
          "label": "Customer email",
          "type": "string",
          "required": true
        },
        {
          "key": "customer_name",
          "label": "Customer name",
          "type": "string"
        },
        {
          "key": "narration",
          "label": "Narration",
          "type": "string"
        },
        {
          "key": "redirect_url",
          "label": "Redirect URL",
          "type": "string"
        },
        {
          "key": "notification_url",
          "label": "Notification URL",
          "type": "string",
          "help": "Paste a FlowForge webhook URL to receive the result."
        }
      ]
    },
    {
      "key": "get_charge",
      "name": "Get charge",
      "description": "Check a payment by its reference.",
      "method": "GET",
      "endpoint": "/charges/{{ inputs.reference }}",
      "output_fields": {
        "status": "data.status",
        "amount": "data.amount",
        "currency": "data.currency"
      },
      "inputs": [
        {
          "key": "reference",
          "label": "Reference",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "payout_to_bank",
      "name": "Pay out to bank account",
      "description": "Send money to a bank account.",
      "method": "POST",
      "endpoint": "/transactions/disburse",
      "body": {
        "reference": "{{ inputs.reference }}",
        "destination": {
          "type": "bank_account",
          "amount": "{{ inputs.amount }}",
          "currency": "{{ inputs.currency }}",
          "narration": "{{ inputs.narration }}",
          "bank_account": {
            "bank": "{{ inputs.bank_code }}",
            "account": "{{ inputs.account_number }}"
          },
          "customer": {
            "name": "{{ inputs.customer_name }}",
            "email": "{{ inputs.customer_email }}"
          }
        }
      },
      "output_fields": {
        "status": "data.status",
        "reference": "data.reference",
        "fee": "data.fee"
      },
      "inputs": [
        {
          "key": "reference",
          "label": "Reference",
          "type": "string",
          "required": true
        },
        {
          "key": "amount",
          "label": "Amount",
          "type": "number",
          "required": true
        },
        {
          "key": "currency",
          "label": "Currency",
          "type": "string",
          "default": "NGN"
        },
        {
          "key": "bank_code",
          "label": "Bank code",
          "type": "string",
          "required": true,
          "placeholder": "033"
        },
        {
          "key": "account_number",
          "label": "Account number",
          "type": "string",
          "required": true
        },
        {
          "key": "customer_email",
          "label": "Recipient email",
          "type": "string",
          "required": true
        },
        {
          "key": "customer_name",
          "label": "Recipient name",
          "type": "string"
        },
        {
          "key": "narration",
          "label": "Narration",
          "type": "string"
        }
      ]
    },
    {
      "key": "get_payout",
      "name": "Get payout",
      "description": "Check the status of a payout.",
      "method": "GET",
      "endpoint": "/transactions/{{ inputs.reference }}",
      "output_fields": {
        "status": "data.status",
        "amount": "data.amount"
      },
      "inputs": [
        {
          "key": "reference",
          "label": "Reference",
          "type": "string",
          "required": true
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "Kora dashboard → Settings → API Configuration → Webhook URL.",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
