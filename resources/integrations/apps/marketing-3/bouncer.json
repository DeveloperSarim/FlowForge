{
  "key": "bouncer",
  "name": "Bouncer",
  "category": "Marketing & Email",
  "description": "Verify email addresses and check how many credits you have left.",
  "website": "https://www.usebouncer.com",
  "docs_url": "https://docs.usebouncer.com/",
  "base_url": "https://api.usebouncer.com/v1.1",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "x-api-key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Bouncer → API → create an API key and copy it."
      }
    ]
  },
  "actions": [
    {
      "key": "verify",
      "name": "Verify email",
      "description": "Deliverability status, reason and score.",
      "method": "GET",
      "endpoint": "/email/verify",
      "query": {
        "email": "{{ inputs.email }}",
        "timeout": "{{ inputs.timeout }}"
      },
      "output_fields": {
        "status": "status",
        "reason": "reason",
        "score": "score",
        "provider": "provider",
        "disposable": "domain.disposable",
        "free": "domain.free",
        "role": "account.role"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true,
          "help": "The contact's email address."
        },
        {
          "key": "timeout",
          "label": "Timeout (seconds)",
          "type": "number",
          "default": 10
        }
      ]
    },
    {
      "key": "credits",
      "name": "Check credits",
      "description": "Remaining credits.",
      "method": "GET",
      "endpoint": "/credits",
      "output_fields": {
        "credits": "credits"
      },
      "inputs": []
    }
  ]
}
