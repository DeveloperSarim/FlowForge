{
  "key": "swell",
  "name": "Swell",
  "category": "E-commerce",
  "description": "Read orders and products and create customer accounts in Swell.",
  "brand": "swell",
  "website": "https://www.swell.is",
  "docs_url": "https://developers.swell.is/backend-api",
  "base_url": "https://api.swell.store",
  "auth": [
    {
      "type": "basic",
      "fields": [
        {
          "key": "username",
          "label": "Store ID",
          "type": "string",
          "required": true,
          "help": "Developer > API keys in the Swell dashboard."
        },
        {
          "key": "password",
          "label": "Secret key",
          "type": "password",
          "required": true
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_orders",
      "name": "List orders",
      "method": "GET",
      "endpoint": "/orders",
      "output_path": "results",
      "query": {
        "limit": "{{ inputs.limit }}",
        "page": "{{ inputs.page }}"
      },
      "inputs": [
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 25
        },
        {
          "key": "page",
          "label": "Page",
          "type": "number"
        }
      ]
    },
    {
      "key": "get_order",
      "name": "Get order",
      "method": "GET",
      "endpoint": "/orders/{{ inputs.order_id }}",
      "inputs": [
        {
          "key": "order_id",
          "label": "Order ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "get_product",
      "name": "Get product",
      "method": "GET",
      "endpoint": "/products/{{ inputs.product_id }}",
      "inputs": [
        {
          "key": "product_id",
          "label": "Product ID or slug",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "create_account",
      "name": "Create customer account",
      "method": "POST",
      "endpoint": "/accounts",
      "body": {
        "email": "{{ inputs.email }}",
        "first_name": "{{ inputs.first_name }}",
        "last_name": "{{ inputs.last_name }}",
        "phone": "{{ inputs.phone }}"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "first_name",
          "label": "First name",
          "type": "string"
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "phone",
          "label": "Phone",
          "type": "string"
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "Developer > Webhooks: add this URL and pick events such as order.created.",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
