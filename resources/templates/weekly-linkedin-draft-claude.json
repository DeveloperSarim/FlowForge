{
  "key": "weekly-linkedin-draft-claude",
  "name": "Draft a weekly LinkedIn post with Claude",
  "description": "Every Monday Claude drafts a post from your notes; the draft lands in Slack for review before anyone publishes.",
  "category": "AI",
  "featured": false,
  "graph": {
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger",
        "position": {
          "x": 0,
          "y": 200
        },
        "data": {
          "integration": "schedule",
          "trigger": "cron",
          "label": "Mondays at 9:00",
          "config": {
            "cron": "0 9 * * 1"
          }
        }
      },
      {
        "id": "step_1",
        "type": "action",
        "position": {
          "x": 240,
          "y": 200
        },
        "data": {
          "integration": "anthropic",
          "action": "create_message",
          "label": "Draft post",
          "config": {
            "model": "claude-opus-5-5",
            "system": "You write concise, specific LinkedIn posts for a B2B software company. No hashtags spam, no emojis.",
            "prompt": "Write this week's post about: our new workflow templates and what customers automated with them."
          }
        }
      },
      {
        "id": "step_2",
        "type": "action",
        "position": {
          "x": 480,
          "y": 200
        },
        "data": {
          "integration": "slack",
          "action": "post_message",
          "label": "Send for review",
          "config": {
            "channel": "#marketing",
            "text": "Draft for this week:\n\n{{ steps.step_1.text }}"
          }
        }
      }
    ],
    "edges": [
      {
        "id": "e-trigger-step_1",
        "source": "trigger",
        "target": "step_1",
        "sourceHandle": null
      },
      {
        "id": "e-step_1-step_2",
        "source": "step_1",
        "target": "step_2",
        "sourceHandle": null
      }
    ]
  }
}