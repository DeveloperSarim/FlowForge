{
  "key": "pdfshift",
  "name": "PDFShift",
  "category": "Files & Documents",
  "description": "Convert HTML or a URL to PDF and get a hosted file URL.",
  "brand": "pdfshift",
  "website": "https://pdfshift.io",
  "docs_url": "https://docs.pdfshift.io/",
  "base_url": "https://api.pdfshift.io/v3",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "X-API-Key"
    }
  ],
  "actions": [
    {
      "key": "convert_to_pdf",
      "name": "Convert to PDF",
      "method": "POST",
      "endpoint": "/convert/pdf",
      "timeout": 120,
      "body": {
        "source": "{{ inputs.source }}",
        "filename": "{{ inputs.filename }}",
        "landscape": "{{ inputs.landscape }}",
        "use_print": "{{ inputs.use_print }}",
        "sandbox": "{{ inputs.sandbox }}"
      },
      "inputs": [
        {
          "key": "source",
          "label": "URL or HTML",
          "type": "text",
          "required": true
        },
        {
          "key": "filename",
          "label": "File name",
          "type": "string",
          "required": true,
          "default": "document.pdf",
          "help": "Needed to get a JSON response with the file URL."
        },
        {
          "key": "landscape",
          "label": "Landscape",
          "type": "boolean",
          "default": false
        },
        {
          "key": "use_print",
          "label": "Use print stylesheet",
          "type": "boolean",
          "default": false
        },
        {
          "key": "sandbox",
          "label": "Sandbox (free, watermarked)",
          "type": "boolean",
          "default": false
        }
      ]
    }
  ]
}
