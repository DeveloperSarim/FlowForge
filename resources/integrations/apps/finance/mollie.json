{
  "key": "mollie",
  "name": "Mollie",
  "category": "Payments & Finance",
  "description": "Create payments, payment links, customers and refunds with Mollie.",
  "brand": "mollie",
  "website": "https://www.mollie.com",
  "docs_url": "https://docs.mollie.com/reference/overview",
  "base_url": "https://api.mollie.com/v2",
  "idempotency_header": "Idempotency-Key",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Developers > API keys (live_… or test_…)."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "create_payment",
      "name": "Create payment",
      "method": "POST",
      "endpoint": "/payments",
      "output_fields": {
        "checkout_url": "_links.checkout.href"
      },
      "body": {
        "amount": {
          "currency": "{{ inputs.currency }}",
          "value": "{{ inputs.value }}"
        },
        "description": "{{ inputs.description }}",
        "redirectUrl": "{{ inputs.redirect_url }}",
        "webhookUrl": "{{ inputs.webhook_url }}",
        "metadata": "{{ inputs.metadata }}"
      },
      "inputs": [
        {
          "key": "value",
          "label": "Amount",
          "type": "string",
          "required": true,
          "placeholder": "10.00",
          "help": "String with exactly two decimals, e.g. 10.00."
        },
        {
          "key": "currency",
          "label": "Currency",
          "type": "string",
          "required": true,
          "default": "EUR"
        },
        {
          "key": "description",
          "label": "Description",
          "type": "string",
          "required": true
        },
        {
          "key": "redirect_url",
          "label": "Redirect URL",
          "type": "string"
        },
        {
          "key": "webhook_url",
          "label": "Webhook URL",
          "type": "string"
        },
        {
          "key": "metadata",
          "label": "Metadata",
          "type": "json"
        }
      ]
    },
    {
      "key": "get_payment",
      "name": "Get payment",
      "method": "GET",
      "endpoint": "/payments/{{ inputs.payment_id }}",
      "inputs": [
        {
          "key": "payment_id",
          "label": "Payment ID",
          "type": "string",
          "required": true,
          "placeholder": "tr_…"
        }
      ]
    },
    {
      "key": "create_payment_link",
      "name": "Create payment link",
      "method": "POST",
      "endpoint": "/payment-links",
      "output_fields": {
        "url": "_links.paymentLink.href"
      },
      "body": {
        "amount": {
          "currency": "{{ inputs.currency }}",
          "value": "{{ inputs.value }}"
        },
        "description": "{{ inputs.description }}",
        "redirectUrl": "{{ inputs.redirect_url }}",
        "expiresAt": "{{ inputs.expires_at }}"
      },
      "inputs": [
        {
          "key": "value",
          "label": "Amount",
          "type": "string",
          "required": true,
          "placeholder": "10.00",
          "help": "String with exactly two decimals, e.g. 10.00."
        },
        {
          "key": "currency",
          "label": "Currency",
          "type": "string",
          "required": true,
          "default": "EUR"
        },
        {
          "key": "description",
          "label": "Description",
          "type": "string",
          "required": true
        },
        {
          "key": "redirect_url",
          "label": "Redirect URL",
          "type": "string"
        },
        {
          "key": "expires_at",
          "label": "Expires at",
          "type": "string",
          "placeholder": "2025-12-31T12:00:00+00:00"
        }
      ]
    },
    {
      "key": "create_refund",
      "name": "Refund payment",
      "method": "POST",
      "endpoint": "/payments/{{ inputs.payment_id }}/refunds",
      "body": {
        "amount": {
          "currency": "{{ inputs.currency }}",
          "value": "{{ inputs.value }}"
        },
        "description": "{{ inputs.description }}"
      },
      "inputs": [
        {
          "key": "payment_id",
          "label": "Payment ID",
          "type": "string",
          "required": true
        },
        {
          "key": "value",
          "label": "Amount",
          "type": "string",
          "required": true,
          "help": "String with exactly two decimals, e.g. 10.00."
        },
        {
          "key": "currency",
          "label": "Currency",
          "type": "string",
          "required": true,
          "default": "EUR"
        },
        {
          "key": "description",
          "label": "Description",
          "type": "string"
        }
      ]
    },
    {
      "key": "create_customer",
      "name": "Create customer",
      "method": "POST",
      "endpoint": "/customers",
      "body": {
        "name": "{{ inputs.name }}",
        "email": "{{ inputs.email }}"
      },
      "inputs": [
        {
          "key": "name",
          "label": "Name",
          "type": "string"
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string"
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "new_payment",
      "name": "New payment",
      "type": "polling",
      "method": "GET",
      "endpoint": "/payments",
      "query": {
        "limit": 50
      },
      "items_path": "_embedded.payments",
      "id_field": "id",
      "inputs": [
        {
          "key": "poll_interval",
          "label": "Check every (minutes)",
          "type": "number",
          "default": 5
        }
      ]
    },
    {
      "key": "payment_status",
      "name": "Payment status changed",
      "type": "webhook",
      "description": "Use this URL as the payment's webhookUrl. Mollie posts only the payment id; fetch it with \"Get payment\".",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
