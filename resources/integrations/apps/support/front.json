{
  "key": "front",
  "name": "Front",
  "category": "Customer Support",
  "description": "Send messages, reply, comment and manage conversations in Front.",
  "brand": "front",
  "website": "https://front.com",
  "docs_url": "https://dev.frontapp.com/reference/introduction",
  "popular": true,
  "base_url": "https://api2.frontapp.com",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "API token",
          "type": "password",
          "required": true,
          "help": "Settings > Developers > API tokens"
        }
      ]
    },
    {
      "type": "oauth2",
      "authorize_url": "https://app.frontapp.com/oauth/authorize",
      "token_url": "https://app.frontapp.com/oauth/token",
      "scopes": [],
      "client_auth": "basic"
    }
  ],
  "actions": [
    {
      "key": "send_message",
      "name": "Send new message",
      "description": "Starts a new conversation from a channel.",
      "method": "POST",
      "endpoint": "/channels/{{ inputs.channel_id }}/messages",
      "body": {
        "to": "{{ inputs.to }}",
        "subject": "{{ inputs.subject }}",
        "body": "{{ inputs.body }}",
        "author_id": "{{ inputs.author_id }}"
      },
      "inputs": [
        {
          "key": "channel_id",
          "label": "Channel ID",
          "type": "string",
          "required": true,
          "placeholder": "cha_123"
        },
        {
          "key": "to",
          "label": "To",
          "type": "list",
          "required": true
        },
        {
          "key": "subject",
          "label": "Subject",
          "type": "string"
        },
        {
          "key": "body",
          "label": "Body (HTML)",
          "type": "text",
          "required": true
        },
        {
          "key": "author_id",
          "label": "Author (teammate) ID",
          "type": "string",
          "placeholder": "tea_123"
        }
      ]
    },
    {
      "key": "reply_conversation",
      "name": "Reply to conversation",
      "method": "POST",
      "endpoint": "/conversations/{{ inputs.conversation_id }}/messages",
      "body": {
        "body": "{{ inputs.body }}",
        "author_id": "{{ inputs.author_id }}"
      },
      "inputs": [
        {
          "key": "conversation_id",
          "label": "Conversation ID",
          "type": "string",
          "required": true,
          "placeholder": "cnv_123"
        },
        {
          "key": "body",
          "label": "Body (HTML)",
          "type": "text",
          "required": true
        },
        {
          "key": "author_id",
          "label": "Author (teammate) ID",
          "type": "string",
          "placeholder": "tea_123"
        }
      ]
    },
    {
      "key": "add_comment",
      "name": "Add comment",
      "description": "Adds an internal comment to a conversation.",
      "method": "POST",
      "endpoint": "/conversations/{{ inputs.conversation_id }}/comments",
      "body": {
        "body": "{{ inputs.body }}",
        "author_id": "{{ inputs.author_id }}"
      },
      "inputs": [
        {
          "key": "conversation_id",
          "label": "Conversation ID",
          "type": "string",
          "required": true,
          "placeholder": "cnv_123"
        },
        {
          "key": "body",
          "label": "Comment",
          "type": "text",
          "required": true
        },
        {
          "key": "author_id",
          "label": "Author (teammate) ID",
          "type": "string",
          "placeholder": "tea_123",
          "help": "Required with company API tokens."
        }
      ]
    },
    {
      "key": "update_conversation",
      "name": "Update conversation",
      "method": "PATCH",
      "endpoint": "/conversations/{{ inputs.conversation_id }}",
      "body": {
        "status": "{{ inputs.status }}",
        "assignee_id": "{{ inputs.assignee_id }}",
        "tag_ids": "{{ inputs.tag_ids }}"
      },
      "inputs": [
        {
          "key": "conversation_id",
          "label": "Conversation ID",
          "type": "string",
          "required": true,
          "placeholder": "cnv_123"
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "options": [
            {
              "value": "open",
              "label": "Open"
            },
            {
              "value": "archived",
              "label": "Archived"
            },
            {
              "value": "deleted",
              "label": "Deleted"
            },
            {
              "value": "spam",
              "label": "Spam"
            }
          ]
        },
        {
          "key": "assignee_id",
          "label": "Assignee (teammate) ID",
          "type": "string",
          "placeholder": "tea_123"
        },
        {
          "key": "tag_ids",
          "label": "Tag IDs",
          "type": "list"
        }
      ]
    },
    {
      "key": "get_conversation",
      "name": "Get conversation",
      "method": "GET",
      "endpoint": "/conversations/{{ inputs.conversation_id }}",
      "inputs": [
        {
          "key": "conversation_id",
          "label": "Conversation ID",
          "type": "string",
          "required": true,
          "placeholder": "cnv_123"
        }
      ]
    },
    {
      "key": "create_contact",
      "name": "Create contact",
      "method": "POST",
      "endpoint": "/contacts",
      "body": {
        "name": "{{ inputs.name }}",
        "description": "{{ inputs.description }}",
        "handles": [
          {
            "source": "email",
            "handle": "{{ inputs.email }}"
          }
        ]
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "name",
          "label": "Name",
          "type": "string"
        },
        {
          "key": "description",
          "label": "Description",
          "type": "string"
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "Use a rule with a 'Send to a webhook' action pointing at this URL.",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
