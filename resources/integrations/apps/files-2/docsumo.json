{
  "key": "docsumo",
  "name": "Docsumo",
  "category": "Files & Documents",
  "description": "List documents and get extracted data from Docsumo.",
  "brand": "docsumo",
  "website": "https://www.docsumo.com",
  "docs_url": "https://support.docsumo.com/reference/getting-started-with-your-api",
  "base_url": "https://app.docsumo.com/api/v1/eevee/apikey",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "apikey",
      "fields": [
        {
          "key": "api_key",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Settings > Webhook & API."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_documents",
      "name": "List documents",
      "method": "GET",
      "endpoint": "/documents/all/",
      "query": {
        "doc_type": "{{ inputs.doc_type }}",
        "status": "{{ inputs.status }}",
        "q": "{{ inputs.q }}",
        "folder_id": "{{ inputs.folder_id }}",
        "limit": "{{ inputs.limit }}",
        "offset": "{{ inputs.offset }}"
      },
      "inputs": [
        {
          "key": "doc_type",
          "label": "Document type",
          "type": "string"
        },
        {
          "key": "status",
          "label": "Status",
          "type": "string"
        },
        {
          "key": "q",
          "label": "Search",
          "type": "string"
        },
        {
          "key": "folder_id",
          "label": "Folder ID",
          "type": "string"
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number"
        },
        {
          "key": "offset",
          "label": "Offset",
          "type": "number"
        }
      ]
    },
    {
      "key": "get_document",
      "name": "Get document details",
      "method": "GET",
      "endpoint": "/documents/detail/{{ inputs.doc_id }}/",
      "inputs": [
        {
          "key": "doc_id",
          "label": "Document ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "get_extracted_data",
      "name": "Get extracted data",
      "method": "GET",
      "endpoint": "/data/simplified/{{ inputs.doc_id }}/",
      "inputs": [
        {
          "key": "doc_id",
          "label": "Document ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "get_account",
      "name": "Get account and document types",
      "method": "GET",
      "endpoint": "/limit/",
      "inputs": []
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Document processed",
      "type": "webhook",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
