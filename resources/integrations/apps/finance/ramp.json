{
  "key": "ramp",
  "name": "Ramp",
  "category": "Payments & Finance",
  "description": "Read Ramp card transactions, users, cards and reimbursements.",
  "brand": "ramp",
  "website": "https://ramp.com",
  "docs_url": "https://docs.ramp.com/developer-api/v1/overview/introduction",
  "base_url": "https://api.ramp.com/developer/v1",
  "auth": [
    {
      "type": "oauth2",
      "authorize_url": "https://app.ramp.com/v1/authorize",
      "token_url": "https://api.ramp.com/developer/v1/token",
      "client_auth": "basic",
      "scopes": [
        "transactions:read",
        "users:read",
        "cards:read",
        "reimbursements:read"
      ]
    },
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "Access token",
          "type": "password",
          "required": true,
          "help": "Token from the client-credentials grant of your Ramp developer app."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_transactions",
      "name": "List transactions",
      "method": "GET",
      "endpoint": "/transactions",
      "output_path": "data",
      "query": {
        "from_date": "{{ inputs.from_date }}",
        "to_date": "{{ inputs.to_date }}",
        "user_id": "{{ inputs.user_id }}",
        "page_size": "{{ inputs.page_size }}"
      },
      "inputs": [
        {
          "key": "from_date",
          "label": "From date",
          "type": "string",
          "placeholder": "2025-01-01T00:00:00Z"
        },
        {
          "key": "to_date",
          "label": "To date",
          "type": "string"
        },
        {
          "key": "user_id",
          "label": "User ID",
          "type": "string"
        },
        {
          "key": "page_size",
          "label": "Page size",
          "type": "number",
          "default": 50
        }
      ]
    },
    {
      "key": "get_transaction",
      "name": "Get transaction",
      "method": "GET",
      "endpoint": "/transactions/{{ inputs.transaction_id }}",
      "inputs": [
        {
          "key": "transaction_id",
          "label": "Transaction ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_users",
      "name": "List users",
      "method": "GET",
      "endpoint": "/users",
      "output_path": "data",
      "query": {
        "email": "{{ inputs.email }}"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string"
        }
      ]
    },
    {
      "key": "list_cards",
      "name": "List cards",
      "method": "GET",
      "endpoint": "/cards",
      "output_path": "data",
      "query": {
        "user_id": "{{ inputs.user_id }}"
      },
      "inputs": [
        {
          "key": "user_id",
          "label": "User ID",
          "type": "string"
        }
      ]
    },
    {
      "key": "list_reimbursements",
      "name": "List reimbursements",
      "method": "GET",
      "endpoint": "/reimbursements",
      "output_path": "data",
      "inputs": []
    }
  ],
  "triggers": []
}
