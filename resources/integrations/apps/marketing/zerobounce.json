{
  "key": "zerobounce",
  "name": "ZeroBounce",
  "category": "Marketing & Email",
  "description": "Validate email addresses and check credits.",
  "brand": "zerobounce",
  "website": "https://www.zerobounce.net",
  "docs_url": "https://www.zerobounce.net/docs/",
  "base_url": "https://api.zerobounce.net/v2",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "api_key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "validate",
      "name": "Validate email",
      "method": "GET",
      "endpoint": "/validate",
      "query": {
        "email": "{{ inputs.email }}",
        "ip_address": "{{ inputs.ip_address }}"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "ip_address",
          "label": "Signup IP address",
          "type": "string"
        }
      ]
    },
    {
      "key": "get_credits",
      "name": "Get credit balance",
      "method": "GET",
      "endpoint": "/getcredits",
      "inputs": []
    }
  ]
}
