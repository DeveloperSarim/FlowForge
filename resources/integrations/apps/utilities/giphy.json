{
  "key": "giphy",
  "name": "GIPHY",
  "category": "Utilities",
  "description": "Search, translate and fetch trending or random GIFs and stickers.",
  "brand": "giphy",
  "website": "https://giphy.com",
  "docs_url": "https://developers.giphy.com/docs/api/",
  "base_url": "https://api.giphy.com/v1",
  "auth": { "type": "api_key", "in": "query", "name": "api_key", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true, "help": "Create an app at developers.giphy.com/dashboard." }
  ] },
  "actions": [
    {
      "key": "search_gifs",
      "name": "Search GIFs",
      "method": "GET",
      "endpoint": "/gifs/search",
      "query": { "q": "{{ inputs.q }}", "limit": "{{ inputs.limit }}", "offset": "{{ inputs.offset }}", "rating": "{{ inputs.rating }}", "lang": "{{ inputs.lang }}" },
      "output_path": "data",
      "inputs": [
        { "key": "q", "label": "Search", "type": "string", "required": true, "placeholder": "happy dance" },
        { "key": "limit", "label": "Max results", "type": "number", "default": 10 },
        { "key": "offset", "label": "Offset", "type": "number" },
        { "key": "rating", "label": "Max rating", "type": "select", "default": "g", "options": [
          { "value": "g", "label": "G" }, { "value": "pg", "label": "PG" }, { "value": "pg-13", "label": "PG-13" }, { "value": "r", "label": "R" }
        ] },
        { "key": "lang", "label": "Language", "type": "string", "placeholder": "en" }
      ]
    },
    {
      "key": "trending_gifs",
      "name": "Get trending GIFs",
      "method": "GET",
      "endpoint": "/gifs/trending",
      "query": { "limit": "{{ inputs.limit }}", "rating": "{{ inputs.rating }}" },
      "output_path": "data",
      "inputs": [
        { "key": "limit", "label": "Max results", "type": "number", "default": 10 },
        { "key": "rating", "label": "Max rating", "type": "select", "default": "g", "options": [
          { "value": "g", "label": "G" }, { "value": "pg", "label": "PG" }, { "value": "pg-13", "label": "PG-13" }, { "value": "r", "label": "R" }
        ] }
      ]
    },
    {
      "key": "random_gif",
      "name": "Get random GIF",
      "method": "GET",
      "endpoint": "/gifs/random",
      "query": { "tag": "{{ inputs.tag }}", "rating": "{{ inputs.rating }}" },
      "output_path": "data",
      "inputs": [
        { "key": "tag", "label": "Tag", "type": "string", "placeholder": "cats" },
        { "key": "rating", "label": "Max rating", "type": "select", "default": "g", "options": [
          { "value": "g", "label": "G" }, { "value": "pg", "label": "PG" }, { "value": "pg-13", "label": "PG-13" }, { "value": "r", "label": "R" }
        ] }
      ]
    },
    {
      "key": "translate_gif",
      "name": "Translate text to GIF",
      "description": "Picks the single best GIF for a word or phrase.",
      "method": "GET",
      "endpoint": "/gifs/translate",
      "query": { "s": "{{ inputs.s }}", "weirdness": "{{ inputs.weirdness }}" },
      "output_path": "data",
      "inputs": [
        { "key": "s", "label": "Text", "type": "string", "required": true, "placeholder": "good job" },
        { "key": "weirdness", "label": "Weirdness (0-10)", "type": "number" }
      ]
    },
    {
      "key": "search_stickers",
      "name": "Search stickers",
      "method": "GET",
      "endpoint": "/stickers/search",
      "query": { "q": "{{ inputs.q }}", "limit": "{{ inputs.limit }}", "rating": "{{ inputs.rating }}" },
      "output_path": "data",
      "inputs": [
        { "key": "q", "label": "Search", "type": "string", "required": true },
        { "key": "limit", "label": "Max results", "type": "number", "default": 10 },
        { "key": "rating", "label": "Max rating", "type": "select", "default": "g", "options": [
          { "value": "g", "label": "G" }, { "value": "pg", "label": "PG" }, { "value": "pg-13", "label": "PG-13" }, { "value": "r", "label": "R" }
        ] }
      ]
    }
  ]
}
