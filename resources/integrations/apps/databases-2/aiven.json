{
  "key": "aiven",
  "name": "Aiven",
  "category": "Databases",
  "description": "List projects and managed database services, check status and power services on or off.",
  "brand": "aiven",
  "website": "https://aiven.io",
  "docs_url": "https://api.aiven.io/doc/",
  "base_url": "https://api.aiven.io/v1",
  "auth": { "type": "api_key", "in": "header", "name": "Authorization", "prefix": "aivenv1 ", "fields": [
    { "key": "api_key", "label": "Personal token", "type": "password", "required": true, "help": "User information → Tokens → Generate token." }
  ] },
  "actions": [
    {
      "key": "list_projects",
      "name": "List projects",
      "method": "GET",
      "endpoint": "/project",
      "output_path": "projects",
      "inputs": []
    },
    {
      "key": "list_services",
      "name": "List services",
      "method": "GET",
      "endpoint": "/project/{{ inputs.project }}/service",
      "output_path": "services",
      "inputs": [{ "key": "project", "label": "Project", "type": "string", "required": true }]
    },
    {
      "key": "get_service",
      "name": "Get service",
      "method": "GET",
      "endpoint": "/project/{{ inputs.project }}/service/{{ inputs.service_name }}",
      "output_path": "service",
      "inputs": [
        { "key": "project", "label": "Project", "type": "string", "required": true },
        { "key": "service_name", "label": "Service name", "type": "string", "required": true }
      ]
    },
    {
      "key": "power_service",
      "name": "Power service on / off",
      "method": "PUT",
      "endpoint": "/project/{{ inputs.project }}/service/{{ inputs.service_name }}",
      "body": { "powered": "{{ inputs.powered }}" },
      "output_path": "service",
      "inputs": [
        { "key": "project", "label": "Project", "type": "string", "required": true },
        { "key": "service_name", "label": "Service name", "type": "string", "required": true },
        { "key": "powered", "label": "Powered on", "type": "boolean", "required": true }
      ]
    }
  ]
}
