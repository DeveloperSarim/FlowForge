{
  "key": "constant_contact",
  "name": "Constant Contact",
  "category": "Marketing & Email",
  "description": "Create or update contacts and list lists and email campaigns.",
  "brand": "constantcontact",
  "website": "https://www.constantcontact.com",
  "docs_url": "https://developer.constantcontact.com/api_reference/index.html",
  "base_url": "https://api.cc.email/v3",
  "auth": {
    "type": "oauth2",
    "authorize_url": "https://authz.constantcontact.com/oauth2/default/v1/authorize",
    "token_url": "https://authz.constantcontact.com/oauth2/default/v1/token",
    "scopes": [
      "contact_data",
      "campaign_data",
      "offline_access"
    ],
    "client_auth": "basic"
  },
  "actions": [
    {
      "key": "upsert_contact",
      "name": "Create or update contact",
      "description": "Adds the contact to the given lists, creating or updating it.",
      "method": "POST",
      "endpoint": "/contacts/sign_up_form",
      "body": {
        "email_address": "{{ inputs.email }}",
        "first_name": "{{ inputs.first_name }}",
        "last_name": "{{ inputs.last_name }}",
        "list_memberships": "{{ inputs.list_ids }}"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "first_name",
          "label": "First name",
          "type": "string"
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "list_ids",
          "label": "List IDs",
          "type": "list",
          "required": true
        }
      ]
    },
    {
      "key": "find_contact",
      "name": "Find contact by email",
      "method": "GET",
      "endpoint": "/contacts",
      "query": {
        "email": "{{ inputs.email }}",
        "include": "list_memberships"
      },
      "output_path": "contacts",
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_lists",
      "name": "List contact lists",
      "method": "GET",
      "endpoint": "/contact_lists",
      "output_path": "lists",
      "inputs": []
    },
    {
      "key": "list_campaigns",
      "name": "List email campaigns",
      "method": "GET",
      "endpoint": "/emails",
      "output_path": "campaigns",
      "inputs": []
    }
  ]
}
