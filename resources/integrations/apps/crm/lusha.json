{
  "key": "lusha",
  "name": "Lusha",
  "category": "CRM & Sales",
  "description": "Enrich people and companies with Lusha contact data.",
  "brand": "lusha",
  "website": "https://www.lusha.com",
  "docs_url": "https://docs.lusha.com/",
  "base_url": "https://api.lusha.com",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "api_key",
      "fields": [
        {
          "key": "api_key",
          "label": "API key",
          "type": "password",
          "required": true
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "enrich_person",
      "name": "Enrich person",
      "description": "Pass an email, a LinkedIn URL, or name + company.",
      "method": "GET",
      "endpoint": "/v2/person",
      "query": {
        "email": "{{ inputs.email }}",
        "linkedinUrl": "{{ inputs.linkedin_url }}",
        "firstName": "{{ inputs.first_name }}",
        "lastName": "{{ inputs.last_name }}",
        "companyName": "{{ inputs.company_name }}",
        "companyDomain": "{{ inputs.company_domain }}"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string"
        },
        {
          "key": "linkedin_url",
          "label": "LinkedIn URL",
          "type": "string"
        },
        {
          "key": "first_name",
          "label": "First name",
          "type": "string"
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "company_name",
          "label": "Company name",
          "type": "string"
        },
        {
          "key": "company_domain",
          "label": "Company domain",
          "type": "string"
        }
      ]
    },
    {
      "key": "enrich_company",
      "name": "Enrich company",
      "method": "GET",
      "endpoint": "/v2/company",
      "query": {
        "domain": "{{ inputs.domain }}",
        "company": "{{ inputs.company }}"
      },
      "inputs": [
        {
          "key": "domain",
          "label": "Domain",
          "type": "string"
        },
        {
          "key": "company",
          "label": "Company name",
          "type": "string"
        }
      ]
    }
  ]
}
