{
  "key": "nasa",
  "name": "NASA Open APIs",
  "category": "Utilities",
  "description": "Astronomy Picture of the Day, near-Earth asteroids and EPIC Earth images.",
  "brand": "nasa",
  "website": "https://api.nasa.gov",
  "docs_url": "https://api.nasa.gov",
  "base_url": "https://api.nasa.gov",
  "auth": { "type": "api_key", "in": "query", "name": "api_key", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true, "help": "Free at api.nasa.gov. DEMO_KEY works for testing." }
  ] },
  "actions": [
    {
      "key": "apod",
      "name": "Get Astronomy Picture of the Day",
      "method": "GET",
      "endpoint": "/planetary/apod",
      "query": { "date": "{{ inputs.date }}", "start_date": "{{ inputs.start_date }}", "end_date": "{{ inputs.end_date }}", "count": "{{ inputs.count }}" },
      "inputs": [
        { "key": "date", "label": "Date", "type": "string", "placeholder": "2026-01-31", "help": "Leave empty for today." },
        { "key": "start_date", "label": "Start date (range)", "type": "string" },
        { "key": "end_date", "label": "End date (range)", "type": "string" },
        { "key": "count", "label": "Random count", "type": "number", "help": "Return this many random pictures. Don't combine with dates." }
      ]
    },
    {
      "key": "near_earth_objects",
      "name": "Get near-Earth asteroids",
      "description": "Asteroids by closest approach date (max 7-day range).",
      "method": "GET",
      "endpoint": "/neo/rest/v1/feed",
      "query": { "start_date": "{{ inputs.start_date }}", "end_date": "{{ inputs.end_date }}" },
      "inputs": [
        { "key": "start_date", "label": "Start date", "type": "string", "required": true, "placeholder": "2026-01-01" },
        { "key": "end_date", "label": "End date", "type": "string", "placeholder": "2026-01-07" }
      ]
    },
    {
      "key": "epic_latest",
      "name": "Get latest EPIC Earth images",
      "description": "Newest natural-color images of Earth from the DSCOVR satellite.",
      "method": "GET",
      "endpoint": "/EPIC/api/natural",
      "inputs": []
    }
  ]
}
