{
  "key": "insightly",
  "name": "Insightly",
  "category": "CRM & Sales",
  "description": "Create contacts, leads and organisations in Insightly.",
  "brand": "insightly",
  "website": "https://www.insightly.com",
  "docs_url": "https://api.insightly.com/v3.1/Help",
  "base_url": "https://api.{{ credentials.pod }}.insightly.com/v3.1",
  "auth": [
    {
      "type": "basic",
      "fields": [
        {
          "key": "pod",
          "label": "Pod",
          "type": "string",
          "required": true,
          "placeholder": "na1",
          "help": "From the API URL under User settings > API, e.g. na1."
        },
        {
          "key": "username",
          "label": "API key",
          "type": "password",
          "required": true
        },
        {
          "key": "password",
          "label": "Password",
          "type": "password",
          "required": false,
          "default": "",
          "help": "Leave empty."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "create_contact",
      "name": "Create contact",
      "method": "POST",
      "endpoint": "/Contacts",
      "body": {
        "FIRST_NAME": "{{ inputs.first_name }}",
        "LAST_NAME": "{{ inputs.last_name }}",
        "EMAIL_ADDRESS": "{{ inputs.email }}",
        "PHONE": "{{ inputs.phone }}",
        "TITLE": "{{ inputs.title }}"
      },
      "inputs": [
        {
          "key": "first_name",
          "label": "First name",
          "type": "string"
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string"
        },
        {
          "key": "phone",
          "label": "Phone",
          "type": "string"
        },
        {
          "key": "title",
          "label": "Title",
          "type": "string"
        }
      ]
    },
    {
      "key": "get_contact",
      "name": "Get contact",
      "method": "GET",
      "endpoint": "/Contacts/{{ inputs.contact_id }}",
      "inputs": [
        {
          "key": "contact_id",
          "label": "Contact ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "search_contacts",
      "name": "Search contacts by field",
      "method": "GET",
      "endpoint": "/Contacts/Search",
      "query": {
        "field_name": "{{ inputs.field_name }}",
        "field_value": "{{ inputs.field_value }}"
      },
      "inputs": [
        {
          "key": "field_name",
          "label": "Field",
          "type": "string",
          "required": true,
          "default": "EMAIL_ADDRESS"
        },
        {
          "key": "field_value",
          "label": "Value",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "create_lead",
      "name": "Create lead",
      "method": "POST",
      "endpoint": "/Leads",
      "body": {
        "FIRST_NAME": "{{ inputs.first_name }}",
        "LAST_NAME": "{{ inputs.last_name }}",
        "EMAIL": "{{ inputs.email }}",
        "PHONE": "{{ inputs.phone }}",
        "ORGANISATION_NAME": "{{ inputs.organisation_name }}",
        "TITLE": "{{ inputs.title }}"
      },
      "inputs": [
        {
          "key": "first_name",
          "label": "First name",
          "type": "string"
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string"
        },
        {
          "key": "phone",
          "label": "Phone",
          "type": "string"
        },
        {
          "key": "organisation_name",
          "label": "Organisation name",
          "type": "string"
        },
        {
          "key": "title",
          "label": "Title",
          "type": "string"
        }
      ]
    },
    {
      "key": "create_organisation",
      "name": "Create organisation",
      "method": "POST",
      "endpoint": "/Organisations",
      "body": {
        "ORGANISATION_NAME": "{{ inputs.name }}",
        "WEBSITE": "{{ inputs.website }}"
      },
      "inputs": [
        {
          "key": "name",
          "label": "Name",
          "type": "string",
          "required": true
        },
        {
          "key": "website",
          "label": "Website",
          "type": "string"
        }
      ]
    }
  ]
}
