{
  "key": "renderform",
  "name": "RenderForm",
  "category": "Files & Documents",
  "description": "Render images, PDFs and videos from RenderForm templates.",
  "brand": "renderform",
  "website": "https://renderform.io",
  "docs_url": "https://renderform.io/docs/api/render-image/",
  "base_url": "https://get.renderform.io/api/v2",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "X-API-KEY"
    }
  ],
  "actions": [
    {
      "key": "render",
      "name": "Render template",
      "method": "POST",
      "endpoint": "/render",
      "body": {
        "template": "{{ inputs.template }}",
        "data": "{{ inputs.data }}",
        "outputFormat": "{{ inputs.output_format }}",
        "fileName": "{{ inputs.file_name }}",
        "webhookUrl": "{{ inputs.webhook_url }}"
      },
      "timeout": 120,
      "inputs": [
        {
          "key": "template",
          "label": "Template ID",
          "type": "string",
          "required": true
        },
        {
          "key": "data",
          "label": "Data",
          "type": "keyvalue",
          "help": "Component properties, e.g. title.text = Hello."
        },
        {
          "key": "output_format",
          "label": "Output format",
          "type": "select",
          "options": [
            {
              "value": "jpeg",
              "label": "JPEG"
            },
            {
              "value": "png",
              "label": "PNG"
            },
            {
              "value": "webp",
              "label": "WebP"
            },
            {
              "value": "pdf",
              "label": "PDF"
            },
            {
              "value": "mp4",
              "label": "MP4"
            }
          ]
        },
        {
          "key": "file_name",
          "label": "File name",
          "type": "string"
        },
        {
          "key": "webhook_url",
          "label": "Webhook URL",
          "type": "string"
        }
      ]
    },
    {
      "key": "list_templates",
      "name": "List templates",
      "method": "GET",
      "endpoint": "/my-templates",
      "query": {
        "name": "{{ inputs.name }}",
        "page": "{{ inputs.page }}",
        "size": "{{ inputs.size }}"
      },
      "inputs": [
        {
          "key": "name",
          "label": "Name filter",
          "type": "string"
        },
        {
          "key": "page",
          "label": "Page",
          "type": "number"
        },
        {
          "key": "size",
          "label": "Page size",
          "type": "number"
        }
      ]
    }
  ]
}
