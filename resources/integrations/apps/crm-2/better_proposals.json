{
  "key": "better_proposals",
  "name": "Better Proposals",
  "category": "CRM & Sales",
  "description": "Look up proposals, signed proposals and templates in Better Proposals.",
  "brand": "betterproposals",
  "website": "https://betterproposals.io",
  "docs_url": "https://betterproposals.io/resources/api",
  "base_url": "https://api.betterproposals.io",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "Bptoken",
    "fields": [
      {
        "key": "api_key",
        "label": "API token",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "get_proposal",
      "name": "Get proposal",
      "method": "GET",
      "endpoint": "/proposal/{{ inputs.proposal_id }}",
      "output_path": "data",
      "inputs": [
        {
          "key": "proposal_id",
          "label": "Proposal ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_proposals",
      "name": "List proposals by status",
      "method": "GET",
      "endpoint": "/proposal/{{ inputs.status }}",
      "output_path": "data",
      "inputs": [
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "required": true,
          "default": "signed",
          "options": [
            {
              "value": "signed",
              "label": "Signed"
            },
            {
              "value": "sent",
              "label": "Sent"
            },
            {
              "value": "opened",
              "label": "Opened"
            },
            {
              "value": "paid",
              "label": "Paid"
            }
          ]
        }
      ]
    },
    {
      "key": "list_templates",
      "name": "List templates",
      "method": "GET",
      "endpoint": "/template",
      "output_path": "data",
      "inputs": []
    }
  ]
}
