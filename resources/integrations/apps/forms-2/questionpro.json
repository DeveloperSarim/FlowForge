{
  "key": "questionpro",
  "name": "QuestionPro",
  "category": "Forms & Surveys",
  "description": "List QuestionPro surveys and download their responses.",
  "website": "https://www.questionpro.com",
  "docs_url": "https://www.questionpro.com/api/",
  "base_url": "https://api.questionpro.com/a/api/v2",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "api-key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "QuestionPro > Account > Integrations > API: copy your API key."
      }
    ]
  },
  "actions": [
    {
      "key": "list_surveys",
      "name": "List surveys",
      "description": "Get your surveys.",
      "method": "GET",
      "endpoint": "/surveys",
      "query": {
        "page": "{{ inputs.page }}",
        "perPage": "{{ inputs.perPage }}"
      },
      "inputs": [
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "default": 1
        },
        {
          "key": "perPage",
          "label": "Per page",
          "type": "number",
          "default": 25
        }
      ]
    },
    {
      "key": "get_survey",
      "name": "Get a survey",
      "description": "Get the details of a survey.",
      "method": "GET",
      "endpoint": "/surveys/{{ inputs.survey_id }}",
      "inputs": [
        {
          "key": "survey_id",
          "label": "Survey ID",
          "type": "string",
          "required": true,
          "help": "The number in the survey's address in QuestionPro."
        }
      ]
    },
    {
      "key": "list_responses",
      "name": "List responses",
      "description": "Get the responses to a survey.",
      "method": "GET",
      "endpoint": "/surveys/{{ inputs.survey_id }}/responses",
      "query": {
        "page": "{{ inputs.page }}",
        "perPage": "{{ inputs.perPage }}"
      },
      "inputs": [
        {
          "key": "survey_id",
          "label": "Survey ID",
          "type": "string",
          "required": true
        },
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "default": 1
        },
        {
          "key": "perPage",
          "label": "Per page",
          "type": "number",
          "default": 25
        }
      ]
    }
  ]
}
