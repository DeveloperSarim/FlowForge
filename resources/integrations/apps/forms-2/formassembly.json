{
  "key": "formassembly",
  "name": "FormAssembly",
  "category": "Forms & Surveys",
  "description": "Read FormAssembly forms and export their responses.",
  "website": "https://www.formassembly.com",
  "docs_url": "https://help.formassembly.com/help/formassembly-api",
  "base_url": "https://{{ credentials.host }}/api_v1",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "host",
        "label": "Server",
        "type": "string",
        "required": true,
        "default": "app.formassembly.com",
        "placeholder": "app.formassembly.com",
        "help": "Your FormAssembly address without https://, e.g. app.formassembly.com or yourcompany.tfaforms.net."
      },
      {
        "key": "token",
        "label": "Access token",
        "type": "password",
        "required": true,
        "help": "FormAssembly > Developer > Developer Tools > OAuth Apps: create an app and copy an access token."
      }
    ]
  },
  "actions": [
    {
      "key": "list_forms",
      "name": "List forms",
      "description": "Get your forms.",
      "method": "GET",
      "endpoint": "/forms/index.json",
      "inputs": []
    },
    {
      "key": "get_form",
      "name": "Get a form",
      "description": "Get one form's details.",
      "method": "GET",
      "endpoint": "/forms/view/{{ inputs.form_id }}.json",
      "inputs": [
        {
          "key": "form_id",
          "label": "Form ID",
          "type": "string",
          "required": true,
          "help": "The number in the form's address."
        }
      ]
    },
    {
      "key": "export_responses",
      "name": "Export responses",
      "description": "Get a form's responses.",
      "method": "GET",
      "endpoint": "/responses/export/{{ inputs.form_id }}.json",
      "query": {
        "date_from": "{{ inputs.date_from }}",
        "date_to": "{{ inputs.date_to }}"
      },
      "inputs": [
        {
          "key": "form_id",
          "label": "Form ID",
          "type": "string",
          "required": true
        },
        {
          "key": "date_from",
          "label": "From date",
          "type": "string",
          "help": "YYYY-MM-DD"
        },
        {
          "key": "date_to",
          "label": "To date",
          "type": "string",
          "help": "YYYY-MM-DD"
        }
      ]
    }
  ]
}
