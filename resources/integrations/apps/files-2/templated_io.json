{
  "key": "templated_io",
  "name": "Templated",
  "category": "Files & Documents",
  "description": "Render images, PDFs and videos from Templated templates.",
  "brand": "templated",
  "website": "https://templated.io",
  "docs_url": "https://templated.io/docs/",
  "base_url": "https://api.templated.io/v1",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Dashboard > API Integration."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "create_render",
      "name": "Create render",
      "method": "POST",
      "endpoint": "/render",
      "body": {
        "template": "{{ inputs.template }}",
        "layers": "{{ inputs.layers }}",
        "format": "{{ inputs.format }}",
        "name": "{{ inputs.name }}",
        "webhook_url": "{{ inputs.webhook_url }}"
      },
      "timeout": 120,
      "inputs": [
        {
          "key": "template",
          "label": "Template ID",
          "type": "string",
          "required": true
        },
        {
          "key": "layers",
          "label": "Layers",
          "type": "json",
          "placeholder": "{\"title\": {\"text\": \"Hello\"}, \"photo\": {\"image_url\": \"https://...\"}}"
        },
        {
          "key": "format",
          "label": "Format",
          "type": "select",
          "options": [
            {
              "value": "jpg",
              "label": "JPG"
            },
            {
              "value": "png",
              "label": "PNG"
            },
            {
              "value": "webp",
              "label": "WebP"
            },
            {
              "value": "pdf",
              "label": "PDF"
            },
            {
              "value": "mp4",
              "label": "MP4"
            }
          ]
        },
        {
          "key": "name",
          "label": "Render name",
          "type": "string"
        },
        {
          "key": "webhook_url",
          "label": "Webhook URL",
          "type": "string"
        }
      ]
    },
    {
      "key": "get_render",
      "name": "Get render",
      "method": "GET",
      "endpoint": "/render/{{ inputs.render_id }}",
      "inputs": [
        {
          "key": "render_id",
          "label": "Render ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_templates",
      "name": "List templates",
      "method": "GET",
      "endpoint": "/templates",
      "query": {
        "query": "{{ inputs.query }}",
        "page": "{{ inputs.page }}",
        "limit": "{{ inputs.limit }}"
      },
      "inputs": [
        {
          "key": "query",
          "label": "Search",
          "type": "string"
        },
        {
          "key": "page",
          "label": "Page",
          "type": "number"
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number"
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Render completed",
      "type": "webhook",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
