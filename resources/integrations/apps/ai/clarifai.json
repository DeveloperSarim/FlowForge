{
  "key": "clarifai",
  "name": "Clarifai",
  "category": "AI",
  "description": "Run Clarifai vision and text models on your inputs.",
  "brand": "clarifai",
  "website": "https://www.clarifai.com",
  "docs_url": "https://docs.clarifai.com",
  "base_url": "https://api.clarifai.com/v2",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "Authorization",
    "prefix": "Key ",
    "fields": [
      {
        "key": "api_key",
        "label": "Personal access token",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "predict_image",
      "name": "Predict on image URL",
      "method": "POST",
      "endpoint": "/users/{{ inputs.user_id }}/apps/{{ inputs.app_id }}/models/{{ inputs.model_id }}/outputs",
      "body": {
        "inputs": [
          {
            "data": {
              "image": {
                "url": "{{ inputs.image_url }}"
              }
            }
          }
        ]
      },
      "output_fields": {
        "concepts": "outputs.0.data.concepts"
      },
      "inputs": [
        {
          "key": "image_url",
          "label": "Image URL",
          "type": "string",
          "required": true
        },
        {
          "key": "user_id",
          "label": "Model owner",
          "type": "string",
          "required": true,
          "default": "clarifai"
        },
        {
          "key": "app_id",
          "label": "App ID",
          "type": "string",
          "required": true,
          "default": "main"
        },
        {
          "key": "model_id",
          "label": "Model ID",
          "type": "string",
          "required": true,
          "default": "general-image-recognition"
        }
      ]
    },
    {
      "key": "predict_text",
      "name": "Predict on text",
      "method": "POST",
      "endpoint": "/users/{{ inputs.user_id }}/apps/{{ inputs.app_id }}/models/{{ inputs.model_id }}/outputs",
      "body": {
        "inputs": [
          {
            "data": {
              "text": {
                "raw": "{{ inputs.text }}"
              }
            }
          }
        ]
      },
      "inputs": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "required": true
        },
        {
          "key": "user_id",
          "label": "Model owner",
          "type": "string",
          "required": true
        },
        {
          "key": "app_id",
          "label": "App ID",
          "type": "string",
          "required": true
        },
        {
          "key": "model_id",
          "label": "Model ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
