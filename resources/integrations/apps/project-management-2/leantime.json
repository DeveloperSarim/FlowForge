{
  "key": "leantime",
  "name": "Leantime",
  "category": "Project Management",
  "description": "Call any Leantime JSON-RPC method (projects, tickets, timesheets).",
  "brand": "leantime",
  "website": "https://leantime.io",
  "docs_url": "https://docs.leantime.io/api/usage",
  "base_url": "{{ credentials.url }}",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "x-api-key",
      "fields": [
        {
          "key": "url",
          "label": "Leantime URL",
          "type": "string",
          "required": true,
          "placeholder": "https://leantime.example.com",
          "help": "Base URL without a trailing slash."
        },
        {
          "key": "api_key",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Company settings > API keys."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "call_method",
      "name": "Call JSON-RPC method",
      "method": "POST",
      "endpoint": "/api/jsonrpc",
      "body": {
        "jsonrpc": "2.0",
        "method": "{{ inputs.method }}",
        "params": "{{ inputs.params }}",
        "id": 1
      },
      "error_path": "error",
      "output_path": "result",
      "inputs": [
        {
          "key": "method",
          "label": "Method",
          "type": "string",
          "required": true,
          "help": "The full JSON-RPC method name from the Leantime API reference."
        },
        {
          "key": "params",
          "label": "Params",
          "type": "json"
        }
      ]
    }
  ]
}
