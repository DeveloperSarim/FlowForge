{
  "key": "youcanbookme",
  "name": "YouCanBookMe",
  "category": "Productivity",
  "description": "List YouCanBookMe booking pages and bookings.",
  "brand": "youcanbookme",
  "website": "https://youcanbook.me",
  "docs_url": "https://ycbm.capacity.com/article/838484/api-documentation",
  "base_url": "https://api.youcanbook.me/v1",
  "auth": [
    {
      "type": "basic",
      "fields": [
        {
          "key": "username",
          "label": "Account ID",
          "type": "string",
          "required": true,
          "help": "Account > Password & Security."
        },
        {
          "key": "password",
          "label": "API key",
          "type": "password",
          "required": true,
          "placeholder": "ak_…"
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_profiles",
      "name": "List booking pages",
      "method": "GET",
      "endpoint": "/profiles",
      "inputs": []
    },
    {
      "key": "list_bookings",
      "name": "List bookings",
      "method": "GET",
      "endpoint": "/{{ credentials.username }}/bookings",
      "inputs": []
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Booking notification (webhook)",
      "type": "webhook",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
