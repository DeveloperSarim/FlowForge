{
  "key": "nager_date",
  "name": "Nager.Date",
  "category": "Utilities",
  "description": "Free public holidays and long weekends for 100+ countries. No key needed.",
  "brand": "nagerdate",
  "website": "https://date.nager.at",
  "docs_url": "https://date.nager.at/Api",
  "base_url": "https://date.nager.at/api/v3",
  "actions": [
    {
      "key": "public_holidays",
      "name": "List public holidays",
      "method": "GET",
      "endpoint": "/PublicHolidays/{{ inputs.year }}/{{ inputs.country }}",
      "inputs": [
        { "key": "year", "label": "Year", "type": "number", "required": true, "placeholder": "2026" },
        { "key": "country", "label": "Country (ISO code)", "type": "string", "required": true, "placeholder": "DE" }
      ]
    },
    {
      "key": "next_public_holidays",
      "name": "Get next public holidays",
      "description": "Upcoming holidays in the next 365 days.",
      "method": "GET",
      "endpoint": "/NextPublicHolidays/{{ inputs.country }}",
      "inputs": [{ "key": "country", "label": "Country (ISO code)", "type": "string", "required": true, "placeholder": "DE" }]
    },
    {
      "key": "long_weekends",
      "name": "List long weekends",
      "method": "GET",
      "endpoint": "/LongWeekend/{{ inputs.year }}/{{ inputs.country }}",
      "inputs": [
        { "key": "year", "label": "Year", "type": "number", "required": true, "placeholder": "2026" },
        { "key": "country", "label": "Country (ISO code)", "type": "string", "required": true, "placeholder": "DE" }
      ]
    },
    {
      "key": "available_countries",
      "name": "List supported countries",
      "method": "GET",
      "endpoint": "/AvailableCountries",
      "inputs": []
    }
  ]
}
