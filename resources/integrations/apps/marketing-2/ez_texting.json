{
  "key": "ez_texting",
  "name": "EZ Texting",
  "category": "Marketing & Email",
  "description": "Send SMS messages and add contacts to your EZ Texting groups.",
  "brand": "eztexting",
  "website": "https://www.eztexting.com",
  "docs_url": "https://developers.eztexting.com/",
  "base_url": "https://a.eztexting.com/v1",
  "auth": { "type": "basic", "fields": [
    { "key": "username", "label": "EZ Texting username", "type": "string", "required": true },
    { "key": "password", "label": "Password", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "send_message",
      "name": "Send message",
      "method": "POST",
      "endpoint": "/messages",
      "body": { "message": "{{ inputs.message }}", "toNumbers": "{{ inputs.to_numbers }}", "groupIds": "{{ inputs.group_ids }}" },
      "inputs": [
        { "key": "message", "label": "Message", "type": "text", "required": true },
        { "key": "to_numbers", "label": "Phone numbers", "type": "list" },
        { "key": "group_ids", "label": "Group IDs", "type": "list" }
      ]
    },
    {
      "key": "create_contact",
      "name": "Create contact",
      "method": "POST",
      "endpoint": "/contacts",
      "body": {
        "phoneNumber": "{{ inputs.phone_number }}",
        "firstName": "{{ inputs.first_name }}",
        "lastName": "{{ inputs.last_name }}",
        "email": "{{ inputs.email }}",
        "groupIds": "{{ inputs.group_ids }}"
      },
      "inputs": [
        { "key": "phone_number", "label": "Phone number", "type": "string", "required": true },
        { "key": "first_name", "label": "First name", "type": "string" },
        { "key": "last_name", "label": "Last name", "type": "string" },
        { "key": "email", "label": "Email", "type": "string" },
        { "key": "group_ids", "label": "Group IDs", "type": "list" }
      ]
    }
  ]
}
