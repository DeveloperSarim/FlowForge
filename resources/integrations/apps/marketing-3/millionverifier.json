{
  "key": "millionverifier",
  "name": "MillionVerifier",
  "category": "Marketing & Email",
  "description": "Check if an email address is valid before you send to it.",
  "website": "https://www.millionverifier.com",
  "docs_url": "https://developer.millionverifier.com/",
  "base_url": "https://api.millionverifier.com/api/v3",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "api",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "MillionVerifier → API → create an API key and copy it."
      }
    ]
  },
  "actions": [
    {
      "key": "verify",
      "name": "Verify email",
      "description": "Returns ok, invalid, catch_all, disposable and more.",
      "method": "GET",
      "endpoint": "/",
      "query": {
        "email": "{{ inputs.email }}"
      },
      "output_fields": {
        "result": "result",
        "quality": "quality",
        "free": "free",
        "role": "role",
        "credits": "credits"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true,
          "help": "The contact's email address."
        }
      ]
    },
    {
      "key": "credits",
      "name": "Check credits",
      "description": "How many verification credits are left.",
      "method": "GET",
      "endpoint": "/credits",
      "output_fields": {
        "credits": "credits"
      },
      "inputs": []
    }
  ]
}
