{
  "key": "orshot",
  "name": "Orshot",
  "category": "Files & Documents",
  "description": "Render images, PDFs and videos from Orshot Studio templates.",
  "brand": "orshot",
  "website": "https://orshot.com",
  "docs_url": "https://orshot.com/docs/api-reference",
  "base_url": "https://api.orshot.com/v1",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Workspace settings > API key."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "render_template",
      "name": "Render studio template",
      "method": "POST",
      "endpoint": "/studio/render",
      "body": {
        "templateId": "{{ inputs.template_id }}",
        "modifications": "{{ inputs.modifications }}",
        "response": {
          "type": "{{ inputs.response_type }}",
          "format": "{{ inputs.format }}"
        }
      },
      "timeout": 120,
      "inputs": [
        {
          "key": "template_id",
          "label": "Template ID",
          "type": "number",
          "required": true
        },
        {
          "key": "modifications",
          "label": "Modifications",
          "type": "keyvalue",
          "help": "Parameter ID = value."
        },
        {
          "key": "response_type",
          "label": "Return as",
          "type": "select",
          "options": [
            {
              "value": "url",
              "label": "URL"
            },
            {
              "value": "base64",
              "label": "Base64"
            },
            {
              "value": "binary",
              "label": "Binary"
            }
          ],
          "default": "url"
        },
        {
          "key": "format",
          "label": "Format",
          "type": "select",
          "options": [
            {
              "value": "png",
              "label": "PNG"
            },
            {
              "value": "jpg",
              "label": "JPG"
            },
            {
              "value": "webp",
              "label": "WebP"
            },
            {
              "value": "pdf",
              "label": "PDF"
            }
          ]
        }
      ]
    },
    {
      "key": "list_templates",
      "name": "List studio templates",
      "method": "GET",
      "endpoint": "/studio/templates/all",
      "query": {
        "search": "{{ inputs.search }}",
        "page": "{{ inputs.page }}",
        "limit": "{{ inputs.limit }}"
      },
      "inputs": [
        {
          "key": "search",
          "label": "Search",
          "type": "string"
        },
        {
          "key": "page",
          "label": "Page",
          "type": "number"
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number"
        }
      ]
    },
    {
      "key": "get_template",
      "name": "Get studio template",
      "method": "GET",
      "endpoint": "/studio/templates/{{ inputs.template_id }}",
      "inputs": [
        {
          "key": "template_id",
          "label": "Template ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
