{
  "key": "serpwow",
  "name": "SerpWow",
  "category": "Ads & SEO",
  "description": "Google, Bing and other search results as JSON for rank tracking.",
  "website": "https://serpwow.com",
  "docs_url": "https://docs.trajectdata.com/serpwow/search-api/overview",
  "base_url": "https://api.serpwow.com",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "api_key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "SerpWow dashboard → copy your API key."
      }
    ]
  },
  "actions": [
    {
      "key": "search",
      "name": "Search",
      "description": "Live search results.",
      "method": "GET",
      "endpoint": "/live/search",
      "query": {
        "q": "{{ inputs.q }}",
        "location": "{{ inputs.location }}",
        "engine": "{{ inputs.engine }}",
        "num": "{{ inputs.num }}"
      },
      "output_fields": {
        "results": "organic_results",
        "first_title": "organic_results.0.title",
        "first_link": "organic_results.0.link"
      },
      "inputs": [
        {
          "key": "q",
          "label": "Search query",
          "type": "string",
          "required": true
        },
        {
          "key": "location",
          "label": "Location",
          "type": "string",
          "help": "e.g. \"United States\" or \"Austin,Texas\". Leave empty for default."
        },
        {
          "key": "engine",
          "label": "Search engine",
          "type": "select",
          "default": "google",
          "options": [
            {
              "value": "google",
              "label": "Google"
            },
            {
              "value": "bing",
              "label": "Bing"
            },
            {
              "value": "yahoo",
              "label": "Yahoo"
            },
            {
              "value": "baidu",
              "label": "Baidu"
            }
          ]
        },
        {
          "key": "num",
          "label": "Results",
          "type": "number",
          "default": 10
        }
      ]
    },
    {
      "key": "account",
      "name": "Get account",
      "description": "Credits used and left.",
      "method": "GET",
      "endpoint": "/account",
      "output_fields": {
        "credits_remaining": "account_info.credits_remaining",
        "plan": "account_info.plan"
      },
      "inputs": []
    }
  ]
}
