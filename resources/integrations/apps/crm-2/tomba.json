{
  "key": "tomba",
  "name": "Tomba",
  "category": "CRM & Sales",
  "description": "Find professional emails by name, domain or LinkedIn profile.",
  "brand": "tomba",
  "website": "https://tomba.io",
  "docs_url": "https://docs.tomba.io",
  "base_url": "https://api.tomba.io/v1",
  "headers": { "X-Tomba-Secret": "{{ credentials.secret }}" },
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "X-Tomba-Key",
    "fields": [
      { "key": "api_key", "label": "API key", "type": "password", "required": true, "help": "Starts with ta_" },
      { "key": "secret", "label": "Secret key", "type": "password", "required": true, "help": "Starts with ts_" }
    ]
  },
  "actions": [
    {
      "key": "find_email",
      "name": "Find email",
      "method": "GET",
      "endpoint": "/email-finder",
      "output_path": "data",
      "query": {
        "domain": "{{ inputs.domain }}",
        "company": "{{ inputs.company }}",
        "first_name": "{{ inputs.first_name }}",
        "last_name": "{{ inputs.last_name }}",
        "full_name": "{{ inputs.full_name }}"
      },
      "inputs": [
        { "key": "domain", "label": "Company domain", "type": "string" },
        { "key": "company", "label": "Company name", "type": "string", "help": "Instead of the domain" },
        { "key": "first_name", "label": "First name", "type": "string" },
        { "key": "last_name", "label": "Last name", "type": "string" },
        { "key": "full_name", "label": "Full name", "type": "string", "help": "Instead of first + last name" }
      ]
    },
    {
      "key": "find_email_by_linkedin",
      "name": "Find email from LinkedIn",
      "method": "GET",
      "endpoint": "/linkedin",
      "output_path": "data",
      "query": { "url": "{{ inputs.url }}" },
      "inputs": [{ "key": "url", "label": "LinkedIn profile URL", "type": "string", "required": true }]
    },
    {
      "key": "domain_search",
      "name": "Domain search",
      "description": "Lists email addresses found for a domain.",
      "method": "GET",
      "endpoint": "/domain-search",
      "output_path": "data",
      "query": { "domain": "{{ inputs.domain }}" },
      "inputs": [{ "key": "domain", "label": "Domain", "type": "string", "required": true, "placeholder": "stripe.com" }]
    }
  ]
}
