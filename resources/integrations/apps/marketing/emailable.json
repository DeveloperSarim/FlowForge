{
  "key": "emailable",
  "name": "Emailable",
  "category": "Marketing & Email",
  "description": "Verify email addresses and check credits.",
  "brand": "emailable",
  "website": "https://emailable.com",
  "docs_url": "https://emailable.com/docs/api/",
  "base_url": "https://api.emailable.com/v1",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "api_key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "verify",
      "name": "Verify email",
      "method": "GET",
      "endpoint": "/verify",
      "query": {
        "email": "{{ inputs.email }}",
        "smtp": "{{ inputs.smtp }}"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "smtp",
          "label": "SMTP check",
          "type": "boolean",
          "default": true
        }
      ]
    },
    {
      "key": "account",
      "name": "Get account",
      "method": "GET",
      "endpoint": "/account",
      "inputs": []
    }
  ]
}
