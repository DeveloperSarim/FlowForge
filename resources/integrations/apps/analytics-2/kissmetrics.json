{
  "key": "kissmetrics",
  "name": "Kissmetrics",
  "category": "Analytics",
  "description": "Record events and alias people in Kissmetrics via the tracking API.",
  "brand": "kissmetrics",
  "website": "https://www.kissmetrics.io",
  "docs_url": "https://support.kissmetrics.io",
  "base_url": "https://trk.kissmetrics.com",
  "auth": { "type": "api_key", "in": "query", "name": "_k", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true, "help": "Product settings → API key." }
  ] },
  "actions": [
    {
      "key": "record_event",
      "name": "Record event",
      "method": "GET",
      "endpoint": "/e",
      "query": { "_p": "{{ inputs.person }}", "_n": "{{ inputs.event }}" },
      "inputs": [
        { "key": "person", "label": "Person (email or ID)", "type": "string", "required": true },
        { "key": "event", "label": "Event name", "type": "string", "required": true }
      ]
    },
    {
      "key": "alias",
      "name": "Alias person",
      "description": "Links two identities (e.g. anonymous ID and email) as one person.",
      "method": "GET",
      "endpoint": "/a",
      "query": { "_p": "{{ inputs.person }}", "_n": "{{ inputs.other }}" },
      "inputs": [
        { "key": "person", "label": "Identity", "type": "string", "required": true },
        { "key": "other", "label": "Other identity", "type": "string", "required": true }
      ]
    }
  ]
}
