{
  "key": "leadfeeder",
  "name": "Leadfeeder",
  "category": "CRM & Sales",
  "description": "Pull website visits and identified visiting companies from Leadfeeder by Dealfront.",
  "brand": "leadfeeder",
  "website": "https://www.leadfeeder.com",
  "docs_url": "https://docs.leadfeeder.com/api/",
  "base_url": "https://api.leadfeeder.com",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "X-Api-Key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "list_accounts",
      "name": "List accounts",
      "method": "GET",
      "endpoint": "/v1/accounts",
      "inputs": []
    },
    {
      "key": "list_web_visits",
      "name": "List web visits",
      "method": "POST",
      "endpoint": "/v1/web-visits",
      "query": {
        "account_id": "{{ inputs.account_id }}",
        "page[size]": "{{ inputs.page_size }}",
        "include": "company"
      },
      "body": {
        "start_date": "{{ inputs.start_date }}",
        "end_date": "{{ inputs.end_date }}"
      },
      "inputs": [
        {
          "key": "account_id",
          "label": "Account ID",
          "type": "string",
          "required": true
        },
        {
          "key": "start_date",
          "label": "Start date",
          "type": "string",
          "required": true,
          "placeholder": "2026-01-01"
        },
        {
          "key": "end_date",
          "label": "End date",
          "type": "string",
          "required": true,
          "placeholder": "2026-01-31"
        },
        {
          "key": "page_size",
          "label": "Page size",
          "type": "number",
          "default": 100
        }
      ]
    },
    {
      "key": "list_visiting_companies",
      "name": "List visiting companies",
      "method": "GET",
      "endpoint": "/v1/web-visits/companies",
      "query": {
        "account_id": "{{ inputs.account_id }}",
        "start_date": "{{ inputs.start_date }}",
        "end_date": "{{ inputs.end_date }}"
      },
      "inputs": [
        {
          "key": "account_id",
          "label": "Account ID",
          "type": "string",
          "required": true
        },
        {
          "key": "start_date",
          "label": "Start date",
          "type": "string",
          "required": true,
          "placeholder": "2026-01-01"
        },
        {
          "key": "end_date",
          "label": "End date",
          "type": "string",
          "required": true,
          "placeholder": "2026-01-31"
        }
      ]
    }
  ]
}
