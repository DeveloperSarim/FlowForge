{
  "key": "telegram",
  "name": "Telegram",
  "category": "Communication",
  "description": "Send messages from a Telegram bot.",
  "base_url": "https://api.telegram.org/bot{{ credentials.api_key }}",
  "auth": { "type": "api_key", "fields": [{ "key": "api_key", "label": "Bot token (from @BotFather)", "type": "password", "required": true }] },
  "actions": [
    {
      "key": "send_message",
      "name": "Send message",
      "method": "POST",
      "endpoint": "/sendMessage",
      "output_path": "result",
      "body": { "chat_id": "{{ inputs.chat_id }}", "text": "{{ inputs.text }}", "parse_mode": "{{ inputs.parse_mode }}" },
      "inputs": [
        { "key": "chat_id", "label": "Chat ID", "type": "string", "required": true },
        { "key": "text", "label": "Text", "type": "text", "required": true },
        { "key": "parse_mode", "label": "Formatting", "type": "select", "options": [
          { "value": "", "label": "Plain" }, { "value": "HTML", "label": "HTML" }, { "value": "MarkdownV2", "label": "MarkdownV2" }
        ] }
      ]
    }
  ]
}
