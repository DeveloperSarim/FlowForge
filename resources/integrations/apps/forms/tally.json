{
  "key": "tally",
  "name": "Tally",
  "category": "Forms & Surveys",
  "description": "Get new Tally submissions and list forms and responses.",
  "brand": "tally",
  "website": "https://tally.so",
  "docs_url": "https://developers.tally.so/",
  "popular": true,
  "base_url": "https://api.tally.so",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Settings > API keys"
      }
    ]
  },
  "actions": [
    {
      "key": "list_forms",
      "name": "List forms",
      "method": "GET",
      "endpoint": "/forms",
      "query": {
        "page": "{{ inputs.page }}"
      },
      "inputs": [
        {
          "key": "page",
          "label": "Page",
          "type": "number"
        }
      ]
    },
    {
      "key": "get_form",
      "name": "Get form",
      "method": "GET",
      "endpoint": "/forms/{{ inputs.form_id }}",
      "inputs": [
        {
          "key": "form_id",
          "label": "Form ID",
          "type": "string",
          "required": true,
          "help": "The id in the form URL: tally.so/r/<ID>"
        }
      ]
    },
    {
      "key": "list_submissions",
      "name": "List submissions",
      "method": "GET",
      "endpoint": "/forms/{{ inputs.form_id }}/submissions",
      "query": {
        "filter": "{{ inputs.filter }}",
        "page": "{{ inputs.page }}"
      },
      "inputs": [
        {
          "key": "form_id",
          "label": "Form ID",
          "type": "string",
          "required": true
        },
        {
          "key": "filter",
          "label": "Filter",
          "type": "select",
          "default": "completed",
          "options": [
            {
              "value": "all",
              "label": "All"
            },
            {
              "value": "completed",
              "label": "Completed"
            },
            {
              "value": "partial",
              "label": "Partial"
            }
          ]
        },
        {
          "key": "page",
          "label": "Page",
          "type": "number"
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "new_submission",
      "name": "New submission (webhook)",
      "type": "webhook",
      "description": "Form > Integrations > Webhooks > Connect, then paste this URL.",
      "data_path": "data",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
