{
  "key": "on24",
  "name": "ON24",
  "category": "Events & Webinars",
  "description": "List ON24 webinars with their registrants and attendees.",
  "brand": "on24",
  "website": "https://www.on24.com",
  "docs_url": "https://apidoc.on24.com",
  "base_url": "https://api.on24.com/v2/client/{{ credentials.client_id }}",
  "headers": {
    "accessTokenSecret": "{{ credentials.access_token_secret }}"
  },
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "accessTokenKey",
      "fields": [
        {
          "key": "client_id",
          "label": "Client ID",
          "type": "string",
          "required": true,
          "help": "ON24 Enterprise > Account > API tokens."
        },
        {
          "key": "api_key",
          "label": "Access token key",
          "type": "password",
          "required": true
        },
        {
          "key": "access_token_secret",
          "label": "Access token secret",
          "type": "password",
          "required": true
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_events",
      "name": "List webinars",
      "method": "GET",
      "endpoint": "/event",
      "inputs": []
    },
    {
      "key": "list_registrants",
      "name": "List event registrants",
      "method": "GET",
      "endpoint": "/event/{{ inputs.event_id }}/registrant",
      "inputs": [
        {
          "key": "event_id",
          "label": "Event ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_attendees",
      "name": "List event attendees",
      "method": "GET",
      "endpoint": "/event/{{ inputs.event_id }}/attendee",
      "inputs": [
        {
          "key": "event_id",
          "label": "Event ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
