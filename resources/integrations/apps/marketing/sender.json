{
  "key": "sender",
  "name": "Sender",
  "category": "Marketing & Email",
  "description": "Add or update subscribers, look them up and list groups.",
  "brand": "sender",
  "website": "https://www.sender.net",
  "docs_url": "https://api.sender.net/",
  "base_url": "https://api.sender.net/v2",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API access token",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "upsert_subscriber",
      "name": "Add or update subscriber",
      "method": "POST",
      "endpoint": "/subscribers",
      "output_path": "data",
      "body": {
        "email": "{{ inputs.email }}",
        "firstname": "{{ inputs.first_name }}",
        "lastname": "{{ inputs.last_name }}",
        "groups": "{{ inputs.groups }}",
        "fields": "{{ inputs.fields }}",
        "trigger_automation": "{{ inputs.trigger_automation }}"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "first_name",
          "label": "First name",
          "type": "string"
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "groups",
          "label": "Group IDs",
          "type": "list"
        },
        {
          "key": "fields",
          "label": "Custom fields",
          "type": "keyvalue",
          "help": "{$field} → value"
        },
        {
          "key": "trigger_automation",
          "label": "Trigger automations",
          "type": "boolean",
          "default": true
        }
      ]
    },
    {
      "key": "get_subscriber",
      "name": "Get subscriber",
      "method": "GET",
      "endpoint": "/subscribers/{{ inputs.email }}",
      "output_path": "data",
      "inputs": [
        {
          "key": "email",
          "label": "Email or subscriber ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_groups",
      "name": "List groups",
      "method": "GET",
      "endpoint": "/groups",
      "output_path": "data",
      "inputs": []
    }
  ]
}
