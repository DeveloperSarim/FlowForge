{
  "key": "sortly",
  "name": "Sortly",
  "category": "E-commerce",
  "description": "List, look up and create inventory items and folders in Sortly.",
  "brand": "sortly",
  "website": "https://www.sortly.com",
  "docs_url": "https://sortlyapi.docs.apiary.io",
  "base_url": "https://api.sortly.co/api/v1",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Sortly > Settings > API (Ultra and Enterprise plans)."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_items",
      "name": "List items",
      "method": "GET",
      "endpoint": "/items",
      "query": {
        "folder_id": "{{ inputs.folder_id }}",
        "per_page": "{{ inputs.per_page }}",
        "page": "{{ inputs.page }}"
      },
      "output_path": "data",
      "inputs": [
        {
          "key": "folder_id",
          "label": "Folder ID",
          "type": "string",
          "help": "Blank = top level."
        },
        {
          "key": "per_page",
          "label": "Per page",
          "type": "number",
          "default": 50
        },
        {
          "key": "page",
          "label": "Page",
          "type": "number"
        }
      ]
    },
    {
      "key": "get_item",
      "name": "Get item",
      "method": "GET",
      "endpoint": "/items/{{ inputs.item_id }}",
      "output_path": "data",
      "inputs": [
        {
          "key": "item_id",
          "label": "Item ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "create_item",
      "name": "Create item",
      "method": "POST",
      "endpoint": "/items",
      "body": {
        "name": "{{ inputs.name }}",
        "type": "{{ inputs.type }}",
        "parent_id": "{{ inputs.parent_id }}",
        "quantity": "{{ inputs.quantity }}",
        "min_quantity": "{{ inputs.min_quantity }}",
        "price": "{{ inputs.price }}",
        "notes": "{{ inputs.notes }}"
      },
      "output_path": "data",
      "inputs": [
        {
          "key": "name",
          "label": "Name",
          "type": "string",
          "required": true
        },
        {
          "key": "type",
          "label": "Type",
          "type": "select",
          "options": [
            {
              "value": "item",
              "label": "Item"
            },
            {
              "value": "folder",
              "label": "Folder"
            }
          ],
          "default": "item",
          "required": true
        },
        {
          "key": "parent_id",
          "label": "Folder ID",
          "type": "string"
        },
        {
          "key": "quantity",
          "label": "Quantity",
          "type": "number"
        },
        {
          "key": "min_quantity",
          "label": "Min quantity",
          "type": "number"
        },
        {
          "key": "price",
          "label": "Price",
          "type": "number"
        },
        {
          "key": "notes",
          "label": "Notes",
          "type": "text"
        }
      ]
    }
  ]
}
