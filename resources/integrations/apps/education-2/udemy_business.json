{
  "key": "udemy_business",
  "name": "Udemy Business",
  "category": "Education",
  "description": "Read your company's Udemy Business courses, learners and learning activity.",
  "website": "https://business.udemy.com",
  "docs_url": "https://business.udemy.com/udemy-business-api-docs/",
  "base_url": "https://{{ credentials.subdomain }}.udemy.com/api-2.0/organizations/{{ credentials.account_id }}",
  "auth": {
    "type": "basic",
    "fields": [
      {
        "key": "subdomain",
        "label": "Subdomain",
        "type": "string",
        "required": true,
        "placeholder": "yourcompany",
        "help": "The first part of your Udemy Business address: yourcompany.udemy.com"
      },
      {
        "key": "account_id",
        "label": "Account ID",
        "type": "string",
        "required": true,
        "help": "Udemy Business > Manage > Settings > API: the Account ID."
      },
      {
        "key": "username",
        "label": "Client ID",
        "type": "string",
        "required": true,
        "help": "Same page: the Client ID."
      },
      {
        "key": "password",
        "label": "Client secret",
        "type": "password",
        "required": true,
        "help": "Same page: the Client secret."
      }
    ]
  },
  "actions": [
    {
      "key": "list_courses",
      "name": "List courses",
      "description": "Get courses available to your organization.",
      "method": "GET",
      "endpoint": "/courses/list/",
      "query": {
        "page": "{{ inputs.page }}",
        "page_size": "{{ inputs.page_size }}"
      },
      "output_fields": {
        "courses": "results",
        "next": "next"
      },
      "inputs": [
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "default": 1
        },
        {
          "key": "page_size",
          "label": "Page size",
          "type": "number",
          "default": 50
        }
      ]
    },
    {
      "key": "list_users",
      "name": "List users",
      "description": "Get your learners.",
      "method": "GET",
      "endpoint": "/users/list/",
      "query": {
        "page": "{{ inputs.page }}",
        "page_size": "{{ inputs.page_size }}"
      },
      "output_fields": {
        "users": "results",
        "next": "next"
      },
      "inputs": [
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "default": 1
        },
        {
          "key": "page_size",
          "label": "Page size",
          "type": "number",
          "default": 50
        }
      ]
    },
    {
      "key": "user_progress",
      "name": "User course progress",
      "description": "Get course progress for your learners.",
      "method": "GET",
      "endpoint": "/analytics/user-progress/",
      "query": {
        "page": "{{ inputs.page }}",
        "page_size": "{{ inputs.page_size }}"
      },
      "output_fields": {
        "progress": "results",
        "next": "next"
      },
      "inputs": [
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "default": 1
        },
        {
          "key": "page_size",
          "label": "Page size",
          "type": "number",
          "default": 50
        }
      ]
    },
    {
      "key": "user_activity",
      "name": "User activity",
      "description": "Get learning activity for your learners.",
      "method": "GET",
      "endpoint": "/analytics/user-activity/",
      "query": {
        "page": "{{ inputs.page }}",
        "page_size": "{{ inputs.page_size }}"
      },
      "output_fields": {
        "activity": "results",
        "next": "next"
      },
      "inputs": [
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "default": 1
        },
        {
          "key": "page_size",
          "label": "Page size",
          "type": "number",
          "default": 50
        }
      ]
    }
  ]
}
