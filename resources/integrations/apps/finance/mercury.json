{
  "key": "mercury",
  "name": "Mercury",
  "category": "Payments & Finance",
  "description": "Read Mercury bank accounts, balances, transactions and recipients.",
  "brand": "mercury",
  "website": "https://mercury.com",
  "docs_url": "https://docs.mercury.com/reference/getting-started-with-your-api",
  "base_url": "https://api.mercury.com/api/v1",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "API token",
          "type": "password",
          "required": true,
          "help": "Settings > Tokens (read-only or read/write)."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_accounts",
      "name": "List accounts",
      "method": "GET",
      "endpoint": "/accounts",
      "output_path": "accounts",
      "inputs": []
    },
    {
      "key": "get_account",
      "name": "Get account",
      "method": "GET",
      "endpoint": "/account/{{ inputs.account_id }}",
      "inputs": [
        {
          "key": "account_id",
          "label": "Account ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_transactions",
      "name": "List transactions",
      "method": "GET",
      "endpoint": "/account/{{ inputs.account_id }}/transactions",
      "output_path": "transactions",
      "query": {
        "start": "{{ inputs.start }}",
        "end": "{{ inputs.end }}",
        "status": "{{ inputs.status }}",
        "limit": "{{ inputs.limit }}"
      },
      "inputs": [
        {
          "key": "account_id",
          "label": "Account ID",
          "type": "string",
          "required": true
        },
        {
          "key": "start",
          "label": "Start date",
          "type": "string",
          "placeholder": "2025-01-01"
        },
        {
          "key": "end",
          "label": "End date",
          "type": "string"
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "options": [
            {
              "value": "pending",
              "label": "Pending"
            },
            {
              "value": "sent",
              "label": "Sent"
            },
            {
              "value": "cancelled",
              "label": "Cancelled"
            },
            {
              "value": "failed",
              "label": "Failed"
            }
          ]
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 100
        }
      ]
    },
    {
      "key": "list_recipients",
      "name": "List recipients",
      "method": "GET",
      "endpoint": "/recipients",
      "output_path": "recipients",
      "inputs": []
    }
  ],
  "triggers": []
}
