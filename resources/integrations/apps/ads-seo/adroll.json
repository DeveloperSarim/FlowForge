{
  "key": "adroll",
  "name": "AdRoll",
  "category": "Ads & SEO",
  "description": "Get your AdRoll organization, advertisables and their campaigns.",
  "brand": "adroll",
  "website": "https://www.adroll.com",
  "docs_url": "https://developers.nextroll.com/docs/crud-api/reference.html",
  "base_url": "https://services.adroll.com/api/v1",
  "auth": {
    "type": "oauth2",
    "authorize_url": "https://services.adroll.com/auth/authorize",
    "token_url": "https://services.adroll.com/auth/token",
    "scopes": ["all"],
    "fields": [{ "key": "client_id", "label": "Client ID (API key)", "type": "string", "required": true, "help": "Also sent as the apikey query parameter that every AdRoll call requires." }]
  },
  "actions": [
    {
      "key": "get_organization",
      "name": "Get organization",
      "method": "GET",
      "endpoint": "/organization/get",
      "query": { "apikey": "{{ credentials.client_id }}" },
      "output_path": "results",
      "inputs": []
    },
    {
      "key": "list_advertisables",
      "name": "List advertisables",
      "method": "GET",
      "endpoint": "/organization/get_advertisables",
      "query": { "apikey": "{{ credentials.client_id }}" },
      "output_path": "results",
      "inputs": []
    },
    {
      "key": "list_campaigns",
      "name": "List campaigns",
      "method": "GET",
      "endpoint": "/advertisable/get_campaigns",
      "query": { "apikey": "{{ credentials.client_id }}", "advertisable": "{{ inputs.advertisable_eid }}" },
      "output_path": "results",
      "inputs": [{ "key": "advertisable_eid", "label": "Advertisable EID", "type": "string", "required": true }]
    }
  ]
}
