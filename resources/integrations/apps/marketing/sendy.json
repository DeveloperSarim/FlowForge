{
  "key": "sendy",
  "name": "Sendy",
  "category": "Marketing & Email",
  "description": "Subscribe, unsubscribe and check subscribers (self-hosted Sendy).",
  "brand": "sendy",
  "website": "https://sendy.co",
  "docs_url": "https://sendy.co/api",
  "base_url": "{{ credentials.url }}",
  "auth": {
    "type": "api_key",
    "fields": [
      {
        "key": "url",
        "label": "Sendy URL",
        "type": "string",
        "required": true,
        "placeholder": "https://sendy.example.com",
        "help": "No trailing slash."
      },
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "subscribe",
      "name": "Subscribe",
      "description": "Returns \"1\" on success.",
      "method": "POST",
      "endpoint": "/subscribe",
      "body_format": "form",
      "body": {
        "api_key": "{{ credentials.api_key }}",
        "list": "{{ inputs.list }}",
        "email": "{{ inputs.email }}",
        "name": "{{ inputs.name }}",
        "gdpr": "{{ inputs.gdpr }}",
        "silent": "{{ inputs.silent }}",
        "boolean": "true"
      },
      "inputs": [
        {
          "key": "list",
          "label": "List ID",
          "type": "string",
          "required": true,
          "help": "The encrypted list ID from View all lists."
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "name",
          "label": "Name",
          "type": "string"
        },
        {
          "key": "gdpr",
          "label": "GDPR consent given",
          "type": "select",
          "options": [
            {
              "value": "true",
              "label": "Yes"
            }
          ]
        },
        {
          "key": "silent",
          "label": "Skip double opt-in",
          "type": "select",
          "options": [
            {
              "value": "true",
              "label": "Yes"
            }
          ]
        }
      ]
    },
    {
      "key": "unsubscribe",
      "name": "Unsubscribe",
      "method": "POST",
      "endpoint": "/unsubscribe",
      "body_format": "form",
      "body": {
        "api_key": "{{ credentials.api_key }}",
        "list": "{{ inputs.list }}",
        "email": "{{ inputs.email }}",
        "boolean": "true"
      },
      "inputs": [
        {
          "key": "list",
          "label": "List ID",
          "type": "string",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "subscription_status",
      "name": "Get subscription status",
      "method": "POST",
      "endpoint": "/api/subscribers/subscription-status.php",
      "body_format": "form",
      "body": {
        "api_key": "{{ credentials.api_key }}",
        "list_id": "{{ inputs.list_id }}",
        "email": "{{ inputs.email }}"
      },
      "inputs": [
        {
          "key": "list_id",
          "label": "List ID",
          "type": "string",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "subscriber_count",
      "name": "Get active subscriber count",
      "method": "POST",
      "endpoint": "/api/subscribers/active-subscriber-count.php",
      "body_format": "form",
      "body": {
        "api_key": "{{ credentials.api_key }}",
        "list_id": "{{ inputs.list_id }}"
      },
      "inputs": [
        {
          "key": "list_id",
          "label": "List ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
