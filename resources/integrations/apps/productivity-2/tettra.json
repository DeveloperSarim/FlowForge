{
  "key": "tettra",
  "name": "Tettra",
  "category": "Productivity",
  "description": "Create Tettra pages and search your team knowledge base.",
  "brand": "tettra",
  "website": "https://tettra.com",
  "docs_url": "https://support.tettra.com/pages-2",
  "base_url": "https://app.tettra.co/api/teams/{{ credentials.team_id }}",
  "auth": [
    {
      "type": "api_key",
      "fields": [
        {
          "key": "team_id",
          "label": "Team ID",
          "type": "string",
          "required": true,
          "help": "The number in your Tettra API settings / team URLs."
        },
        {
          "key": "api_key",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Settings > API (Scaling and Professional plans). It is sent in the request, not a header."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "create_page",
      "name": "Create page",
      "method": "POST",
      "endpoint": "/pages",
      "body": {
        "api_key": "{{ credentials.api_key }}",
        "title": "{{ inputs.title }}",
        "body": "{{ inputs.body }}",
        "category_id": "{{ inputs.category_id }}",
        "subcategory_id": "{{ inputs.subcategory_id }}"
      },
      "inputs": [
        {
          "key": "title",
          "label": "Title",
          "type": "string",
          "required": true
        },
        {
          "key": "body",
          "label": "Body (HTML)",
          "type": "text",
          "required": true
        },
        {
          "key": "category_id",
          "label": "Category ID",
          "type": "string"
        },
        {
          "key": "subcategory_id",
          "label": "Subcategory ID",
          "type": "string"
        }
      ]
    },
    {
      "key": "search",
      "name": "Search pages",
      "method": "GET",
      "endpoint": "/search",
      "query": {
        "api_key": "{{ credentials.api_key }}",
        "query": "{{ inputs.query }}"
      },
      "inputs": [
        {
          "key": "query",
          "label": "Search term",
          "type": "string",
          "help": "Leave empty for the most recent pages."
        }
      ]
    },
    {
      "key": "suggest_page",
      "name": "Suggest a new page",
      "method": "POST",
      "endpoint": "/suggestions",
      "body": {
        "api_key": "{{ credentials.api_key }}",
        "title": "{{ inputs.title }}",
        "description": "{{ inputs.description }}"
      },
      "inputs": [
        {
          "key": "title",
          "label": "Title",
          "type": "string",
          "required": true
        },
        {
          "key": "description",
          "label": "Description",
          "type": "text"
        }
      ]
    }
  ]
}
