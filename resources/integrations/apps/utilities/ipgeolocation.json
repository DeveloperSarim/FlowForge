{
  "key": "ipgeolocation",
  "name": "IPGeolocation.io",
  "category": "Utilities",
  "description": "Geolocate IP addresses and get the time in any time zone.",
  "brand": "ipgeolocation",
  "website": "https://ipgeolocation.io",
  "docs_url": "https://ipgeolocation.io/documentation.html",
  "base_url": "https://api.ipgeolocation.io",
  "auth": { "type": "api_key", "in": "query", "name": "apiKey", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "lookup_ip",
      "name": "Look up IP address",
      "method": "GET",
      "endpoint": "/ipgeo",
      "query": { "ip": "{{ inputs.ip }}", "fields": "{{ inputs.fields }}", "lang": "{{ inputs.lang }}" },
      "inputs": [
        { "key": "ip", "label": "IP address or domain", "type": "string", "required": true, "placeholder": "8.8.8.8" },
        { "key": "fields", "label": "Fields", "type": "string", "placeholder": "geo,time_zone,currency", "help": "Comma-separated. Leave empty for all." },
        { "key": "lang", "label": "Language", "type": "string", "placeholder": "en" }
      ]
    },
    {
      "key": "get_timezone",
      "name": "Get time zone info",
      "description": "Current time for a time zone name, location or IP.",
      "method": "GET",
      "endpoint": "/timezone",
      "query": { "tz": "{{ inputs.tz }}", "location": "{{ inputs.location }}", "lat": "{{ inputs.lat }}", "long": "{{ inputs.long }}", "ip": "{{ inputs.ip }}" },
      "inputs": [
        { "key": "tz", "label": "Time zone", "type": "string", "placeholder": "America/New_York" },
        { "key": "location", "label": "Location", "type": "string", "placeholder": "London, UK" },
        { "key": "lat", "label": "Latitude", "type": "number" },
        { "key": "long", "label": "Longitude", "type": "number" },
        { "key": "ip", "label": "IP address", "type": "string", "help": "Fill one of: time zone, location, lat/long or IP." }
      ]
    }
  ]
}
