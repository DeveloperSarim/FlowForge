{
  "key": "open_meteo",
  "name": "Open-Meteo",
  "category": "Utilities",
  "description": "Free weather forecasts and place geocoding, no API key needed.",
  "brand": "open-meteo",
  "website": "https://open-meteo.com",
  "docs_url": "https://open-meteo.com/en/docs",
  "base_url": "https://api.open-meteo.com/v1",
  "actions": [
    {
      "key": "forecast",
      "name": "Get weather forecast",
      "method": "GET",
      "endpoint": "/forecast",
      "query": {
        "latitude": "{{ inputs.latitude }}", "longitude": "{{ inputs.longitude }}", "current": "{{ inputs.current }}",
        "hourly": "{{ inputs.hourly }}", "daily": "{{ inputs.daily }}", "timezone": "{{ inputs.timezone }}",
        "forecast_days": "{{ inputs.forecast_days }}", "temperature_unit": "{{ inputs.temperature_unit }}"
      },
      "inputs": [
        { "key": "latitude", "label": "Latitude", "type": "number", "required": true },
        { "key": "longitude", "label": "Longitude", "type": "number", "required": true },
        { "key": "current", "label": "Current variables", "type": "string", "default": "temperature_2m,relative_humidity_2m,precipitation,weather_code,wind_speed_10m", "help": "Comma-separated." },
        { "key": "hourly", "label": "Hourly variables", "type": "string", "placeholder": "temperature_2m,precipitation_probability" },
        { "key": "daily", "label": "Daily variables", "type": "string", "placeholder": "temperature_2m_max,temperature_2m_min,precipitation_sum" },
        { "key": "timezone", "label": "Time zone", "type": "string", "default": "auto", "help": "Required for daily variables. 'auto' uses the location's zone." },
        { "key": "forecast_days", "label": "Forecast days", "type": "number", "default": 7, "help": "0 to 16." },
        { "key": "temperature_unit", "label": "Temperature unit", "type": "select", "default": "celsius", "options": [{ "value": "celsius", "label": "Celsius" }, { "value": "fahrenheit", "label": "Fahrenheit" }] }
      ]
    },
    {
      "key": "search_location",
      "name": "Find coordinates of a place",
      "method": "GET",
      "endpoint": "https://geocoding-api.open-meteo.com/v1/search",
      "query": { "name": "{{ inputs.name }}", "count": "{{ inputs.count }}", "language": "{{ inputs.language }}" },
      "output_path": "results",
      "inputs": [
        { "key": "name", "label": "Place name", "type": "string", "required": true, "placeholder": "Berlin" },
        { "key": "count", "label": "Max results", "type": "number", "default": 5 },
        { "key": "language", "label": "Language", "type": "string", "placeholder": "en" }
      ]
    }
  ]
}
