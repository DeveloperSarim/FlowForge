{
  "key": "savvycal",
  "name": "SavvyCal",
  "category": "Productivity",
  "description": "List and read events booked through SavvyCal.",
  "brand": "savvycal",
  "website": "https://savvycal.com",
  "docs_url": "https://developers.savvycal.com",
  "base_url": "https://api.savvycal.com/v1",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "Personal access token",
          "type": "password",
          "required": true,
          "placeholder": "pt_secret_…",
          "help": "Settings > Developers."
        }
      ]
    },
    {
      "type": "oauth2",
      "authorize_url": "https://savvycal.com/oauth/authorize",
      "token_url": "https://savvycal.com/oauth/token"
    }
  ],
  "actions": [
    {
      "key": "list_events",
      "name": "List events",
      "method": "GET",
      "endpoint": "/events",
      "inputs": []
    },
    {
      "key": "get_event",
      "name": "Get event",
      "method": "GET",
      "endpoint": "/events/{{ inputs.event_id }}",
      "inputs": [
        {
          "key": "event_id",
          "label": "Event ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "Add this URL under Settings > Webhooks.",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
