{
  "key": "instatus",
  "name": "Instatus",
  "category": "Customer Support",
  "description": "Call the Instatus API and react to status page webhooks.",
  "brand": "instatus",
  "website": "https://instatus.com",
  "docs_url": "https://instatus.com/help/api",
  "base_url": "https://api.instatus.com",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "User settings > Developer settings"
      }
    ]
  },
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "Add this URL as a webhook subscriber on your status page.",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ],
  "actions": []
}
