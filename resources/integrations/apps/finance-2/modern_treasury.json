{
  "key": "modern_treasury",
  "name": "Modern Treasury",
  "category": "Payments & Finance",
  "description": "Create payment orders and counterparties and list payments in Modern Treasury.",
  "brand": "moderntreasury",
  "website": "https://www.moderntreasury.com",
  "docs_url": "https://docs.moderntreasury.com/platform/reference",
  "base_url": "https://app.moderntreasury.com/api",
  "auth": [
    {
      "type": "basic",
      "fields": [
        {
          "key": "username",
          "label": "Organization ID",
          "type": "string",
          "required": true,
          "help": "Developers > API keys."
        },
        {
          "key": "password",
          "label": "API key",
          "type": "password",
          "required": true
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "create_payment_order",
      "name": "Create payment order",
      "method": "POST",
      "endpoint": "/payment_orders",
      "body": {
        "type": "{{ inputs.type }}",
        "amount": "{{ inputs.amount }}",
        "direction": "{{ inputs.direction }}",
        "currency": "{{ inputs.currency }}",
        "originating_account_id": "{{ inputs.originating_account_id }}",
        "receiving_account_id": "{{ inputs.receiving_account_id }}",
        "description": "{{ inputs.description }}",
        "statement_descriptor": "{{ inputs.statement_descriptor }}",
        "metadata": "{{ inputs.metadata }}"
      },
      "inputs": [
        {
          "key": "type",
          "label": "Type",
          "type": "select",
          "options": [
            {
              "value": "ach",
              "label": "ACH"
            },
            {
              "value": "wire",
              "label": "Wire"
            },
            {
              "value": "rtp",
              "label": "RTP"
            },
            {
              "value": "book",
              "label": "Book"
            },
            {
              "value": "check",
              "label": "Check"
            },
            {
              "value": "sepa",
              "label": "SEPA"
            }
          ],
          "required": true
        },
        {
          "key": "amount",
          "label": "Amount (cents)",
          "type": "number",
          "required": true
        },
        {
          "key": "direction",
          "label": "Direction",
          "type": "select",
          "options": [
            {
              "value": "credit",
              "label": "Credit (send money)"
            },
            {
              "value": "debit",
              "label": "Debit (pull money)"
            }
          ],
          "required": true
        },
        {
          "key": "currency",
          "label": "Currency",
          "type": "string",
          "default": "USD"
        },
        {
          "key": "originating_account_id",
          "label": "Internal account ID",
          "type": "string",
          "required": true
        },
        {
          "key": "receiving_account_id",
          "label": "Receiving external account ID",
          "type": "string",
          "required": true
        },
        {
          "key": "description",
          "label": "Description",
          "type": "string"
        },
        {
          "key": "statement_descriptor",
          "label": "Statement descriptor",
          "type": "string"
        },
        {
          "key": "metadata",
          "label": "Metadata",
          "type": "keyvalue"
        }
      ]
    },
    {
      "key": "get_payment_order",
      "name": "Get payment order",
      "method": "GET",
      "endpoint": "/payment_orders/{{ inputs.payment_order_id }}",
      "inputs": [
        {
          "key": "payment_order_id",
          "label": "Payment order ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_payment_orders",
      "name": "List payment orders",
      "method": "GET",
      "endpoint": "/payment_orders",
      "query": {
        "status": "{{ inputs.status }}",
        "counterparty_id": "{{ inputs.counterparty_id }}",
        "per_page": "{{ inputs.per_page }}"
      },
      "inputs": [
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "options": [
            {
              "value": "pending",
              "label": "Pending"
            },
            {
              "value": "approved",
              "label": "Approved"
            },
            {
              "value": "processing",
              "label": "Processing"
            },
            {
              "value": "sent",
              "label": "Sent"
            },
            {
              "value": "completed",
              "label": "Completed"
            },
            {
              "value": "returned",
              "label": "Returned"
            },
            {
              "value": "failed",
              "label": "Failed"
            },
            {
              "value": "cancelled",
              "label": "Cancelled"
            }
          ]
        },
        {
          "key": "counterparty_id",
          "label": "Counterparty ID",
          "type": "string"
        },
        {
          "key": "per_page",
          "label": "Per page",
          "type": "number",
          "default": 25
        }
      ]
    },
    {
      "key": "create_counterparty",
      "name": "Create counterparty",
      "method": "POST",
      "endpoint": "/counterparties",
      "body": {
        "name": "{{ inputs.name }}",
        "email": "{{ inputs.email }}",
        "send_remittance_advice": "{{ inputs.send_remittance_advice }}",
        "accounts": "{{ inputs.accounts }}",
        "metadata": "{{ inputs.metadata }}"
      },
      "inputs": [
        {
          "key": "name",
          "label": "Name",
          "type": "string",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string"
        },
        {
          "key": "send_remittance_advice",
          "label": "Send remittance advice",
          "type": "boolean"
        },
        {
          "key": "accounts",
          "label": "Bank accounts",
          "type": "json",
          "placeholder": "[{\"account_details\": [{\"account_number\": \"123456789\"}], \"routing_details\": [{\"routing_number\": \"021000021\", \"routing_number_type\": \"aba\"}]}]"
        },
        {
          "key": "metadata",
          "label": "Metadata",
          "type": "keyvalue"
        }
      ]
    },
    {
      "key": "list_counterparties",
      "name": "Find counterparties",
      "method": "GET",
      "endpoint": "/counterparties",
      "query": {
        "name": "{{ inputs.name }}",
        "email": "{{ inputs.email }}"
      },
      "inputs": [
        {
          "key": "name",
          "label": "Name",
          "type": "string"
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string"
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "Developers > Webhooks: add an endpoint with this URL.",
      "data_path": "data",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
