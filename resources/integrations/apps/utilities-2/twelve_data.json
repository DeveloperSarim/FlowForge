{
  "key": "twelve_data",
  "name": "Twelve Data",
  "category": "Utilities",
  "description": "Stock, forex and crypto prices, quotes, time series and currency conversion.",
  "brand": "twelvedata",
  "website": "https://twelvedata.com",
  "docs_url": "https://twelvedata.com/docs",
  "base_url": "https://api.twelvedata.com",
  "auth": { "type": "api_key", "in": "header", "name": "Authorization", "prefix": "apikey ", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "price",
      "name": "Get latest price",
      "method": "GET",
      "endpoint": "/price",
      "query": { "symbol": "{{ inputs.symbol }}" },
      "error_path": "message",
      "inputs": [{ "key": "symbol", "label": "Symbol", "type": "string", "required": true, "placeholder": "AAPL or EUR/USD or BTC/USD" }]
    },
    {
      "key": "quote",
      "name": "Get quote",
      "method": "GET",
      "endpoint": "/quote",
      "query": { "symbol": "{{ inputs.symbol }}", "interval": "{{ inputs.interval }}" },
      "error_path": "message",
      "inputs": [
        { "key": "symbol", "label": "Symbol", "type": "string", "required": true },
        { "key": "interval", "label": "Interval", "type": "string", "placeholder": "1day" }
      ]
    },
    {
      "key": "time_series",
      "name": "Get time series",
      "method": "GET",
      "endpoint": "/time_series",
      "query": { "symbol": "{{ inputs.symbol }}", "interval": "{{ inputs.interval }}", "outputsize": "{{ inputs.outputsize }}", "start_date": "{{ inputs.start_date }}", "end_date": "{{ inputs.end_date }}" },
      "error_path": "message",
      "inputs": [
        { "key": "symbol", "label": "Symbol", "type": "string", "required": true },
        { "key": "interval", "label": "Interval", "type": "select", "required": true, "default": "1day", "options": [
          { "value": "1min", "label": "1 min" }, { "value": "5min", "label": "5 min" }, { "value": "15min", "label": "15 min" }, { "value": "30min", "label": "30 min" },
          { "value": "1h", "label": "1 hour" }, { "value": "4h", "label": "4 hours" }, { "value": "1day", "label": "1 day" }, { "value": "1week", "label": "1 week" }, { "value": "1month", "label": "1 month" }
        ] },
        { "key": "outputsize", "label": "Number of points", "type": "number" },
        { "key": "start_date", "label": "Start date", "type": "string" },
        { "key": "end_date", "label": "End date", "type": "string" }
      ]
    },
    {
      "key": "exchange_rate",
      "name": "Get exchange rate",
      "method": "GET",
      "endpoint": "/exchange_rate",
      "query": { "symbol": "{{ inputs.symbol }}" },
      "error_path": "message",
      "inputs": [{ "key": "symbol", "label": "Currency pair", "type": "string", "required": true, "placeholder": "USD/JPY" }]
    },
    {
      "key": "currency_conversion",
      "name": "Convert currency",
      "method": "GET",
      "endpoint": "/currency_conversion",
      "query": { "symbol": "{{ inputs.symbol }}", "amount": "{{ inputs.amount }}" },
      "error_path": "message",
      "inputs": [
        { "key": "symbol", "label": "Currency pair", "type": "string", "required": true, "placeholder": "USD/EUR" },
        { "key": "amount", "label": "Amount", "type": "number", "required": true }
      ]
    },
    {
      "key": "symbol_search",
      "name": "Search symbols",
      "method": "GET",
      "endpoint": "/symbol_search",
      "query": { "symbol": "{{ inputs.symbol }}", "outputsize": "{{ inputs.outputsize }}" },
      "error_path": "message",
      "inputs": [
        { "key": "symbol", "label": "Search", "type": "string", "required": true },
        { "key": "outputsize", "label": "Max results", "type": "number" }
      ]
    }
  ]
}
