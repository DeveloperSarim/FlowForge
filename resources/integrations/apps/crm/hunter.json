{
  "key": "hunter",
  "name": "Hunter",
  "category": "CRM & Sales",
  "description": "Find and verify professional email addresses.",
  "brand": "hunter",
  "website": "https://hunter.io",
  "docs_url": "https://hunter.io/api-documentation/v2",
  "base_url": "https://api.hunter.io/v2",
  "auth": [
    {
      "type": "api_key",
      "in": "query",
      "name": "api_key",
      "fields": [
        {
          "key": "api_key",
          "label": "API key",
          "type": "password",
          "required": true
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "email_finder",
      "name": "Find email",
      "method": "GET",
      "endpoint": "/email-finder",
      "query": {
        "domain": "{{ inputs.domain }}",
        "first_name": "{{ inputs.first_name }}",
        "last_name": "{{ inputs.last_name }}",
        "full_name": "{{ inputs.full_name }}"
      },
      "output_path": "data",
      "inputs": [
        {
          "key": "domain",
          "label": "Domain",
          "type": "string",
          "required": true,
          "placeholder": "stripe.com"
        },
        {
          "key": "first_name",
          "label": "First name",
          "type": "string"
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "full_name",
          "label": "Full name",
          "type": "string"
        }
      ]
    },
    {
      "key": "email_verifier",
      "name": "Verify email",
      "method": "GET",
      "endpoint": "/email-verifier",
      "query": {
        "email": "{{ inputs.email }}"
      },
      "output_path": "data",
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "domain_search",
      "name": "Domain search",
      "method": "GET",
      "endpoint": "/domain-search",
      "query": {
        "domain": "{{ inputs.domain }}",
        "limit": "{{ inputs.limit }}",
        "type": "{{ inputs.type }}"
      },
      "output_path": "data",
      "inputs": [
        {
          "key": "domain",
          "label": "Domain",
          "type": "string",
          "required": true
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 10
        },
        {
          "key": "type",
          "label": "Type",
          "type": "select",
          "options": [
            {
              "value": "personal",
              "label": "Personal"
            },
            {
              "value": "generic",
              "label": "Generic"
            }
          ]
        }
      ]
    },
    {
      "key": "email_count",
      "name": "Email count",
      "method": "GET",
      "endpoint": "/email-count",
      "query": {
        "domain": "{{ inputs.domain }}"
      },
      "output_path": "data",
      "inputs": [
        {
          "key": "domain",
          "label": "Domain",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "create_lead",
      "name": "Create lead",
      "method": "POST",
      "endpoint": "/leads",
      "body": {
        "email": "{{ inputs.email }}",
        "first_name": "{{ inputs.first_name }}",
        "last_name": "{{ inputs.last_name }}",
        "company": "{{ inputs.company }}",
        "leads_list_id": "{{ inputs.leads_list_id }}"
      },
      "output_path": "data",
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "first_name",
          "label": "First name",
          "type": "string"
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "company",
          "label": "Company",
          "type": "string"
        },
        {
          "key": "leads_list_id",
          "label": "Leads list ID",
          "type": "number"
        }
      ]
    }
  ]
}
