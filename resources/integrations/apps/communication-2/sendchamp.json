{
  "key": "sendchamp",
  "name": "Sendchamp",
  "category": "Communication",
  "description": "Send SMS across Africa with Sendchamp.",
  "brand": "sendchamp",
  "website": "https://www.sendchamp.com",
  "docs_url": "https://sendchamp.readme.io/reference/send-sms-api",
  "base_url": "https://api.sendchamp.com/api/v1",
  "auth": [
    { "type": "bearer", "fields": [{ "key": "token", "label": "Public access key", "type": "password", "required": true, "help": "Dashboard → Account Settings → API Keys & Webhooks." }] }
  ],
  "actions": [
    {
      "key": "send_sms",
      "name": "Send SMS",
      "method": "POST",
      "endpoint": "/sms/send",
      "body": {
        "to": "{{ inputs.to }}",
        "message": "{{ inputs.message }}",
        "sender_name": "{{ inputs.sender_name }}",
        "route": "{{ inputs.route }}"
      },
      "inputs": [
        { "key": "to", "label": "To", "type": "list", "required": true, "placeholder": "2348012345678" },
        { "key": "message", "label": "Message", "type": "text", "required": true },
        { "key": "sender_name", "label": "Sender name", "type": "string", "required": true, "help": "An approved sender ID." },
        { "key": "route", "label": "Route", "type": "select", "default": "dnd", "options": [
          { "value": "dnd", "label": "DND" }, { "value": "non_dnd", "label": "Non-DND" }, { "value": "international", "label": "International" }
        ] }
      ]
    }
  ]
}
