{
  "key": "serpapi",
  "name": "SerpApi",
  "category": "AI",
  "description": "Get Google and other search engine results as JSON.",
  "brand": "serpapi",
  "website": "https://serpapi.com",
  "docs_url": "https://serpapi.com/search-api",
  "base_url": "https://serpapi.com",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "api_key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "search",
      "name": "Search",
      "method": "GET",
      "endpoint": "/search.json",
      "query": {
        "engine": "{{ inputs.engine }}",
        "q": "{{ inputs.q }}",
        "location": "{{ inputs.location }}",
        "hl": "{{ inputs.hl }}",
        "gl": "{{ inputs.gl }}",
        "num": "{{ inputs.num }}"
      },
      "inputs": [
        {
          "key": "q",
          "label": "Query",
          "type": "string",
          "required": true
        },
        {
          "key": "engine",
          "label": "Engine",
          "type": "string",
          "required": true,
          "default": "google",
          "help": "google, bing, google_news, youtube, ..."
        },
        {
          "key": "location",
          "label": "Location",
          "type": "string",
          "placeholder": "Austin, Texas"
        },
        {
          "key": "hl",
          "label": "Language",
          "type": "string",
          "placeholder": "en"
        },
        {
          "key": "gl",
          "label": "Country",
          "type": "string",
          "placeholder": "us"
        },
        {
          "key": "num",
          "label": "Results",
          "type": "number"
        }
      ]
    },
    {
      "key": "get_account",
      "name": "Get account",
      "method": "GET",
      "endpoint": "/account.json",
      "inputs": []
    }
  ]
}
