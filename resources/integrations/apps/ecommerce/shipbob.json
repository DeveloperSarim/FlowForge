{
  "key": "shipbob",
  "name": "ShipBob",
  "category": "E-commerce",
  "description": "Look up channels and products in ShipBob fulfillment; other calls via API.",
  "brand": "shipbob",
  "website": "https://www.shipbob.com",
  "docs_url": "https://developer.shipbob.com/",
  "base_url": "https://{{ credentials.environment }}",
  "headers": {
    "shipbob_channel_id": "{{ credentials.channel_id }}"
  },
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "Personal access token",
          "type": "password",
          "required": true,
          "help": "Integrations > API Tokens in the ShipBob dashboard."
        },
        {
          "key": "environment",
          "label": "Environment",
          "type": "select",
          "required": true,
          "default": "api.shipbob.com",
          "options": [
            {
              "value": "api.shipbob.com",
              "label": "Production"
            },
            {
              "value": "sandbox-api.shipbob.com",
              "label": "Sandbox"
            }
          ]
        },
        {
          "key": "channel_id",
          "label": "Channel ID",
          "type": "string",
          "required": false,
          "help": "Needed to create orders/products. Find it with \"List channels\"."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_channels",
      "name": "List channels",
      "method": "GET",
      "endpoint": "/2026-07/channel",
      "inputs": []
    },
    {
      "key": "search_products",
      "name": "Search products",
      "method": "GET",
      "endpoint": "/2026-07/product",
      "query": {
        "search": "{{ inputs.search }}"
      },
      "inputs": [
        {
          "key": "search",
          "label": "Search (SKU or name)",
          "type": "string",
          "required": true
        }
      ]
    }
  ],
  "triggers": []
}
