{
  "key": "teachworks",
  "name": "Teachworks",
  "category": "Education",
  "description": "Tutoring and lesson-school management: students, lessons and teachers in Teachworks.",
  "website": "https://teachworks.com",
  "docs_url": "https://teachworks.com/api-documentation",
  "base_url": "https://api.teachworks.com/v1",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "Authorization",
    "prefix": "Token token=",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Teachworks > Settings > Integrations > API: copy the API token."
      }
    ]
  },
  "actions": [
    {
      "key": "list_students",
      "name": "List students",
      "description": "Get your students.",
      "method": "GET",
      "endpoint": "/students",
      "query": {
        "page": "{{ inputs.page }}",
        "per_page": "{{ inputs.per_page }}"
      },
      "output_fields": {
        "ids": "*.id",
        "names": "*.first_name"
      },
      "inputs": [
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "default": 1
        },
        {
          "key": "per_page",
          "label": "Per page",
          "type": "number",
          "default": 50
        }
      ]
    },
    {
      "key": "list_lessons",
      "name": "List lessons",
      "description": "Get lessons.",
      "method": "GET",
      "endpoint": "/lessons",
      "query": {
        "page": "{{ inputs.page }}",
        "per_page": "{{ inputs.per_page }}"
      },
      "output_fields": {
        "ids": "*.id"
      },
      "inputs": [
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "default": 1
        },
        {
          "key": "per_page",
          "label": "Per page",
          "type": "number",
          "default": 50
        }
      ]
    },
    {
      "key": "list_employees",
      "name": "List teachers and staff",
      "description": "Get your employees.",
      "method": "GET",
      "endpoint": "/employees",
      "query": {
        "page": "{{ inputs.page }}"
      },
      "output_fields": {
        "ids": "*.id"
      },
      "inputs": [
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "default": 1
        }
      ]
    }
  ]
}
