{
  "key": "tidio",
  "name": "Tidio",
  "category": "Customer Support",
  "description": "Call the Tidio OpenAPI with your client ID and secret.",
  "brand": "tidio",
  "website": "https://www.tidio.com",
  "docs_url": "https://developers.tidio.com/",
  "base_url": "https://api.tidio.com",
  "headers": {
    "Accept": "application/json; version=1",
    "X-Tidio-Openapi-Client-Id": "{{ credentials.client_id }}",
    "X-Tidio-Openapi-Client-Secret": "{{ credentials.api_key }}"
  },
  "auth": {
    "type": "api_key",
    "fields": [
      {
        "key": "client_id",
        "label": "Client ID",
        "type": "string",
        "required": true,
        "help": "Settings > Developer > OpenAPI"
      },
      {
        "key": "api_key",
        "label": "Client secret",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [],
  "triggers": []
}
