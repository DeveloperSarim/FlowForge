{
  "key": "happyfox",
  "name": "HappyFox",
  "category": "Customer Support",
  "description": "Create and fetch HappyFox Help Desk tickets.",
  "brand": "happyfox",
  "website": "https://www.happyfox.com",
  "base_url": "https://{{ credentials.domain }}/api/1.1/json",
  "auth": {
    "type": "basic",
    "fields": [
      {
        "key": "domain",
        "label": "Help desk domain",
        "type": "string",
        "required": true,
        "placeholder": "yourcompany.happyfox.com"
      },
      {
        "key": "username",
        "label": "API key",
        "type": "string",
        "required": true,
        "help": "Manage > Integrations > API"
      },
      {
        "key": "password",
        "label": "Auth code",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "create_ticket",
      "name": "Create ticket",
      "method": "POST",
      "endpoint": "/tickets/",
      "body": {
        "subject": "{{ inputs.subject }}",
        "text": "{{ inputs.text }}",
        "category": "{{ inputs.category }}",
        "priority": "{{ inputs.priority }}",
        "name": "{{ inputs.name }}",
        "email": "{{ inputs.email }}"
      },
      "inputs": [
        {
          "key": "category",
          "label": "Category ID",
          "type": "number",
          "required": true,
          "help": "Use List categories to find it."
        },
        {
          "key": "priority",
          "label": "Priority ID",
          "type": "number",
          "required": true
        },
        {
          "key": "subject",
          "label": "Subject",
          "type": "string",
          "required": true
        },
        {
          "key": "text",
          "label": "Message",
          "type": "text",
          "required": true
        },
        {
          "key": "name",
          "label": "Contact name",
          "type": "string",
          "required": true
        },
        {
          "key": "email",
          "label": "Contact email",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "get_ticket",
      "name": "Get ticket",
      "method": "GET",
      "endpoint": "/ticket/{{ inputs.ticket_id }}/",
      "inputs": [
        {
          "key": "ticket_id",
          "label": "Ticket ID",
          "type": "number",
          "required": true
        }
      ]
    },
    {
      "key": "list_categories",
      "name": "List categories",
      "method": "GET",
      "endpoint": "/categories/",
      "inputs": []
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "Add this URL as a webhook in Manage > Integrations > Webhooks.",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
