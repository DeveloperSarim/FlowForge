{
  "key": "beamer",
  "name": "Beamer",
  "category": "Customer Support",
  "description": "Publish product update posts to your Beamer changelog.",
  "brand": "beamer",
  "website": "https://www.getbeamer.com",
  "docs_url": "https://www.getbeamer.com/api",
  "base_url": "https://api.getbeamer.com/v0",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "Beamer-Api-Key",
    "fields": [{ "key": "api_key", "label": "API key", "type": "password", "required": true }]
  },
  "actions": [
    {
      "key": "create_post",
      "name": "Create post",
      "method": "POST",
      "endpoint": "/posts",
      "body": {
        "title": ["{{ inputs.title }}"],
        "content": ["{{ inputs.content }}"],
        "category": "{{ inputs.category }}",
        "publish": "{{ inputs.publish }}"
      },
      "inputs": [
        { "key": "title", "label": "Title", "type": "string", "required": true },
        { "key": "content", "label": "Content (HTML)", "type": "text", "required": true },
        { "key": "category", "label": "Category", "type": "string", "placeholder": "new" },
        { "key": "publish", "label": "Publish now", "type": "boolean", "default": true }
      ]
    },
    {
      "key": "get_post",
      "name": "Get post",
      "method": "GET",
      "endpoint": "/posts/{{ inputs.post_id }}",
      "inputs": [{ "key": "post_id", "label": "Post ID", "type": "string", "required": true }]
    }
  ]
}
