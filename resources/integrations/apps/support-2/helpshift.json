{
  "key": "helpshift",
  "name": "Helpshift",
  "category": "Customer Support",
  "description": "Look up in-app support issues in Helpshift.",
  "brand": "helpshift",
  "website": "https://www.helpshift.com",
  "docs_url": "https://developers.helpshift.com/rest-api/",
  "base_url": "https://api.helpshift.com/v1/{{ credentials.domain }}",
  "auth": {
    "type": "basic",
    "fields": [
      { "key": "domain", "label": "Domain", "type": "string", "required": true, "placeholder": "yourcompany", "help": "The part before .helpshift.com" },
      { "key": "username", "label": "API key", "type": "password", "required": true },
      { "key": "password", "label": "Password", "type": "password", "required": false, "default": "", "help": "Leave empty." }
    ]
  },
  "actions": [
    {
      "key": "get_issue",
      "name": "Get issue",
      "method": "GET",
      "endpoint": "/issues/{{ inputs.issue_id }}",
      "inputs": [{ "key": "issue_id", "label": "Issue ID", "type": "string", "required": true }]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "Add this URL as a webhook in the Helpshift dashboard.",
      "inputs": [{ "key": "sample_payload", "label": "Test payload (JSON)", "type": "json" }]
    }
  ]
}
