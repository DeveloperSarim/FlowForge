{
  "key": "edlink",
  "name": "Edlink",
  "category": "Education",
  "description": "One API for many school LMS and SIS systems: classes, people and courses.",
  "website": "https://ed.link",
  "docs_url": "https://ed.link/docs/api/v2.0/",
  "base_url": "https://ed.link/api/v2",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "Integration access token",
        "type": "password",
        "required": true,
        "help": "Edlink dashboard > Integrations: open the integration and copy its access token."
      }
    ]
  },
  "actions": [
    {
      "key": "list_classes",
      "name": "List classes",
      "description": "Get classes.",
      "method": "GET",
      "endpoint": "/graph/classes",
      "query": {
        "$first": "{{ inputs.first }}",
        "$after": "{{ inputs.after }}"
      },
      "output_fields": {
        "classes": "$data",
        "next": "$next"
      },
      "inputs": [
        {
          "key": "first",
          "label": "Max results",
          "type": "number",
          "default": 50
        },
        {
          "key": "after",
          "label": "Next page cursor",
          "type": "string"
        }
      ]
    },
    {
      "key": "list_people",
      "name": "List people",
      "description": "Get students and teachers.",
      "method": "GET",
      "endpoint": "/graph/people",
      "query": {
        "$first": "{{ inputs.first }}",
        "$after": "{{ inputs.after }}"
      },
      "output_fields": {
        "people": "$data",
        "next": "$next"
      },
      "inputs": [
        {
          "key": "first",
          "label": "Max results",
          "type": "number",
          "default": 50
        },
        {
          "key": "after",
          "label": "Next page cursor",
          "type": "string"
        }
      ]
    },
    {
      "key": "list_courses",
      "name": "List courses",
      "description": "Get courses.",
      "method": "GET",
      "endpoint": "/graph/courses",
      "query": {
        "$first": "{{ inputs.first }}",
        "$after": "{{ inputs.after }}"
      },
      "output_fields": {
        "courses": "$data",
        "next": "$next"
      },
      "inputs": [
        {
          "key": "first",
          "label": "Max results",
          "type": "number",
          "default": 50
        },
        {
          "key": "after",
          "label": "Next page cursor",
          "type": "string"
        }
      ]
    },
    {
      "key": "list_schools",
      "name": "List schools",
      "description": "Get schools.",
      "method": "GET",
      "endpoint": "/graph/schools",
      "query": {
        "$first": "{{ inputs.first }}"
      },
      "output_fields": {
        "schools": "$data"
      },
      "inputs": [
        {
          "key": "first",
          "label": "Max results",
          "type": "number",
          "default": 50
        }
      ]
    }
  ]
}
