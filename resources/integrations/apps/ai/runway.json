{
  "key": "runway",
  "name": "Runway",
  "category": "AI",
  "description": "Generate videos from images and images from text with Runway Gen-4.",
  "brand": "runway",
  "website": "https://runwayml.com",
  "docs_url": "https://docs.dev.runwayml.com/api",
  "base_url": "https://api.dev.runwayml.com/v1",
  "headers": {
    "X-Runway-Version": "2024-11-06"
  },
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "image_to_video",
      "name": "Image to video",
      "description": "Starts a task; poll it with Get task.",
      "method": "POST",
      "endpoint": "/image_to_video",
      "body": {
        "model": "{{ inputs.model }}",
        "promptImage": "{{ inputs.image_url }}",
        "promptText": "{{ inputs.prompt }}",
        "ratio": "{{ inputs.ratio }}",
        "duration": "{{ inputs.duration }}"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "default": "gen4_turbo"
        },
        {
          "key": "image_url",
          "label": "Image URL",
          "type": "string",
          "required": true
        },
        {
          "key": "prompt",
          "label": "Prompt",
          "type": "text"
        },
        {
          "key": "ratio",
          "label": "Ratio",
          "type": "string",
          "required": true,
          "default": "1280:720"
        },
        {
          "key": "duration",
          "label": "Duration (seconds)",
          "type": "number",
          "placeholder": "5"
        }
      ]
    },
    {
      "key": "text_to_image",
      "name": "Text to image",
      "description": "Starts a task; poll it with Get task.",
      "method": "POST",
      "endpoint": "/text_to_image",
      "body": {
        "model": "{{ inputs.model }}",
        "promptText": "{{ inputs.prompt }}",
        "ratio": "{{ inputs.ratio }}"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "default": "gen4_image"
        },
        {
          "key": "prompt",
          "label": "Prompt",
          "type": "text",
          "required": true
        },
        {
          "key": "ratio",
          "label": "Ratio",
          "type": "string",
          "required": true,
          "default": "1920:1080"
        }
      ]
    },
    {
      "key": "get_task",
      "name": "Get task",
      "method": "GET",
      "endpoint": "/tasks/{{ inputs.task_id }}",
      "output_fields": {
        "url": "output.0"
      },
      "inputs": [
        {
          "key": "task_id",
          "label": "Task ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "cancel_task",
      "name": "Cancel or delete task",
      "method": "DELETE",
      "endpoint": "/tasks/{{ inputs.task_id }}",
      "inputs": [
        {
          "key": "task_id",
          "label": "Task ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
