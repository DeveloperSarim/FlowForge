{
  "key": "webinargeek",
  "name": "WebinarGeek",
  "category": "Events & Webinars",
  "description": "List webinars and broadcasts and subscribe people to WebinarGeek webinars.",
  "brand": "webinargeek",
  "website": "https://www.webinargeek.com",
  "docs_url": "https://webinargeek.docs.apiary.io",
  "base_url": "https://app.webinargeek.com/api/v2",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "Api-Token",
      "fields": [
        {
          "key": "api_key",
          "label": "API token",
          "type": "password",
          "required": true,
          "help": "Settings > Integrations > API."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "get_account",
      "name": "Get account",
      "method": "GET",
      "endpoint": "/account",
      "inputs": []
    },
    {
      "key": "list_webinars",
      "name": "List webinars",
      "method": "GET",
      "endpoint": "/webinars",
      "query": {
        "include_past": "{{ inputs.include_past }}",
        "type": "{{ inputs.type }}",
        "per_page": "{{ inputs.per_page }}"
      },
      "output_path": "webinars",
      "inputs": [
        {
          "key": "include_past",
          "label": "Include past",
          "type": "boolean"
        },
        {
          "key": "type",
          "label": "Type",
          "type": "select",
          "options": [
            {
              "value": "live",
              "label": "Live"
            },
            {
              "value": "automated",
              "label": "Automated"
            },
            {
              "value": "ondemand",
              "label": "On demand"
            }
          ]
        },
        {
          "key": "per_page",
          "label": "Per page",
          "type": "number",
          "default": 50
        }
      ]
    },
    {
      "key": "get_webinar",
      "name": "Get webinar",
      "method": "GET",
      "endpoint": "/webinars/{{ inputs.webinar_id }}",
      "inputs": [
        {
          "key": "webinar_id",
          "label": "Webinar ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_broadcasts",
      "name": "List broadcasts",
      "method": "GET",
      "endpoint": "/broadcasts",
      "query": {
        "per_page": "{{ inputs.per_page }}"
      },
      "inputs": [
        {
          "key": "per_page",
          "label": "Per page",
          "type": "number",
          "default": 50
        }
      ]
    },
    {
      "key": "subscribe",
      "name": "Subscribe to broadcast",
      "method": "POST",
      "endpoint": "/broadcasts/{{ inputs.broadcast_id }}/subscriptions",
      "body": {
        "firstname": "{{ inputs.firstname }}",
        "email": "{{ inputs.email }}",
        "surname": "{{ inputs.surname }}",
        "company": "{{ inputs.company }}",
        "job_title": "{{ inputs.job_title }}",
        "phone": "{{ inputs.phone }}",
        "external_id": "{{ inputs.external_id }}",
        "extra_fields": "{{ inputs.extra_fields }}"
      },
      "inputs": [
        {
          "key": "broadcast_id",
          "label": "Broadcast ID",
          "type": "string",
          "required": true
        },
        {
          "key": "firstname",
          "label": "First name",
          "type": "string",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "surname",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "company",
          "label": "Company",
          "type": "string"
        },
        {
          "key": "job_title",
          "label": "Job title",
          "type": "string"
        },
        {
          "key": "phone",
          "label": "Phone",
          "type": "string"
        },
        {
          "key": "external_id",
          "label": "External ID",
          "type": "string"
        },
        {
          "key": "extra_fields",
          "label": "Extra fields",
          "type": "keyvalue"
        }
      ]
    },
    {
      "key": "list_subscriptions",
      "name": "List subscriptions",
      "description": "Newest first.",
      "method": "GET",
      "endpoint": "/subscriptions",
      "query": {
        "order": "created_at",
        "sort": "desc",
        "per_page": "{{ inputs.per_page }}"
      },
      "inputs": [
        {
          "key": "per_page",
          "label": "Per page",
          "type": "number",
          "default": 50
        }
      ]
    }
  ]
}
