{
  "key": "serper_dev",
  "name": "Serper",
  "category": "Ads & SEO",
  "description": "Fast Google Search, News, Images and Places results as JSON.",
  "brand": "serper",
  "website": "https://serper.dev",
  "docs_url": "https://serper.dev/playground",
  "base_url": "https://google.serper.dev",
  "auth": { "type": "api_key", "in": "header", "name": "X-API-KEY" },
  "actions": [
    {
      "key": "search",
      "name": "Search Google",
      "method": "POST",
      "endpoint": "/search",
      "body": { "q": "{{ inputs.q }}", "gl": "{{ inputs.gl }}", "hl": "{{ inputs.hl }}", "location": "{{ inputs.location }}", "num": "{{ inputs.num }}", "page": "{{ inputs.page }}", "tbs": "{{ inputs.tbs }}" },
      "output_path": "organic",
      "inputs": [
        { "key": "q", "label": "Search query", "type": "string", "required": true },
        { "key": "gl", "label": "Country code", "type": "string", "placeholder": "us" },
        { "key": "hl", "label": "Language code", "type": "string", "placeholder": "en" },
        { "key": "location", "label": "Location", "type": "string", "placeholder": "Austin, Texas, United States" },
        { "key": "num", "label": "Results", "type": "number", "default": 10 },
        { "key": "page", "label": "Page", "type": "number", "default": 1 },
        { "key": "tbs", "label": "Time filter", "type": "select", "options": [
          { "value": "qdr:h", "label": "Past hour" }, { "value": "qdr:d", "label": "Past 24 hours" }, { "value": "qdr:w", "label": "Past week" },
          { "value": "qdr:m", "label": "Past month" }, { "value": "qdr:y", "label": "Past year" }
        ] }
      ]
    },
    {
      "key": "news",
      "name": "Search news",
      "method": "POST",
      "endpoint": "/news",
      "body": { "q": "{{ inputs.q }}", "gl": "{{ inputs.gl }}", "hl": "{{ inputs.hl }}", "num": "{{ inputs.num }}" },
      "output_path": "news",
      "inputs": [
        { "key": "q", "label": "Search query", "type": "string", "required": true },
        { "key": "gl", "label": "Country code", "type": "string", "placeholder": "us" },
        { "key": "hl", "label": "Language code", "type": "string", "placeholder": "en" },
        { "key": "num", "label": "Results", "type": "number", "default": 10 }
      ]
    },
    {
      "key": "images",
      "name": "Search images",
      "method": "POST",
      "endpoint": "/images",
      "body": { "q": "{{ inputs.q }}", "gl": "{{ inputs.gl }}", "num": "{{ inputs.num }}" },
      "output_path": "images",
      "inputs": [
        { "key": "q", "label": "Search query", "type": "string", "required": true },
        { "key": "gl", "label": "Country code", "type": "string", "placeholder": "us" },
        { "key": "num", "label": "Results", "type": "number", "default": 10 }
      ]
    },
    {
      "key": "places",
      "name": "Search places",
      "method": "POST",
      "endpoint": "/places",
      "body": { "q": "{{ inputs.q }}", "gl": "{{ inputs.gl }}", "location": "{{ inputs.location }}" },
      "output_path": "places",
      "inputs": [
        { "key": "q", "label": "Search query", "type": "string", "required": true, "placeholder": "coffee shops" },
        { "key": "gl", "label": "Country code", "type": "string", "placeholder": "us" },
        { "key": "location", "label": "Location", "type": "string", "placeholder": "Austin, Texas, United States" }
      ]
    }
  ]
}
