{
  "key": "siliconflow",
  "name": "SiliconFlow",
  "category": "AI",
  "description": "Chat, embed text and generate images with open models on SiliconFlow.",
  "brand": "siliconflow",
  "website": "https://www.siliconflow.com",
  "docs_url": "https://docs.siliconflow.com/en/api-reference/chat-completions/chat-completions",
  "base_url": "https://{{ credentials.host }}/v1",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "host",
        "label": "Platform",
        "type": "select",
        "required": true,
        "default": "api.siliconflow.com",
        "options": [
          {
            "value": "api.siliconflow.com",
            "label": "International (siliconflow.com)"
          },
          {
            "value": "api.siliconflow.cn",
            "label": "China (siliconflow.cn)"
          }
        ]
      },
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "chat_completion",
      "name": "Chat completion",
      "description": "Send a prompt and get the reply as {{ steps.<id>.text }}.",
      "method": "POST",
      "endpoint": "/chat/completions",
      "timeout": 300,
      "body": {
        "model": "{{ inputs.model }}",
        "messages": [
          {
            "role": "system",
            "content": "{{ inputs.system }}"
          },
          {
            "role": "user",
            "content": "{{ inputs.prompt }}"
          }
        ],
        "temperature": "{{ inputs.temperature }}",
        "max_tokens": "{{ inputs.max_tokens }}"
      },
      "output_fields": {
        "text": "choices.0.message.content"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "default": "Qwen/Qwen3-32B"
        },
        {
          "key": "prompt",
          "label": "Prompt",
          "type": "text",
          "required": true
        },
        {
          "key": "system",
          "label": "System prompt",
          "type": "text",
          "required": true,
          "default": "You are a helpful assistant.",
          "help": "Sent as the system message."
        },
        {
          "key": "temperature",
          "label": "Temperature",
          "type": "number",
          "placeholder": "0.7"
        },
        {
          "key": "max_tokens",
          "label": "Max output tokens",
          "type": "number"
        }
      ]
    },
    {
      "key": "create_embedding",
      "name": "Create embedding",
      "description": "Turn text into a vector, available as {{ steps.<id>.embedding }}.",
      "method": "POST",
      "endpoint": "/embeddings",
      "body": {
        "model": "{{ inputs.model }}",
        "input": "{{ inputs.input }}"
      },
      "output_fields": {
        "embedding": "data.0.embedding"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "default": "BAAI/bge-m3"
        },
        {
          "key": "input",
          "label": "Text",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "key": "generate_image",
      "name": "Generate image",
      "description": "Image URLs expire after one hour.",
      "method": "POST",
      "endpoint": "/images/generations",
      "timeout": 300,
      "body": {
        "model": "{{ inputs.model }}",
        "prompt": "{{ inputs.prompt }}",
        "image_size": "{{ inputs.image_size }}"
      },
      "output_fields": {
        "url": "images.0.url"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "default": "black-forest-labs/FLUX.2-pro"
        },
        {
          "key": "prompt",
          "label": "Prompt",
          "type": "text",
          "required": true
        },
        {
          "key": "image_size",
          "label": "Image size",
          "type": "string",
          "placeholder": "1024x1024"
        }
      ]
    }
  ]
}
