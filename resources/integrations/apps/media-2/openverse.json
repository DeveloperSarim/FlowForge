{
  "key": "openverse",
  "name": "Openverse",
  "category": "Video & Media",
  "description": "Search free, openly licensed images and audio from Openverse (no account).",
  "website": "https://openverse.org",
  "docs_url": "https://api.openverse.org/v1/",
  "base_url": "https://api.openverse.org/v1",
  "auth": {
    "type": "none"
  },
  "actions": [
    {
      "key": "search_images",
      "name": "Search images",
      "description": "Find openly licensed images.",
      "method": "GET",
      "endpoint": "/images/",
      "query": {
        "q": "{{ inputs.q }}",
        "license_type": "{{ inputs.license_type }}",
        "page_size": "{{ inputs.page_size }}"
      },
      "output_fields": {
        "images": "results",
        "urls": "results.*.url",
        "titles": "results.*.title",
        "creators": "results.*.creator",
        "licenses": "results.*.license"
      },
      "inputs": [
        {
          "key": "q",
          "label": "Search",
          "type": "string",
          "required": true
        },
        {
          "key": "license_type",
          "label": "License type",
          "type": "select",
          "default": "all-cc",
          "options": [
            {
              "value": "all-cc",
              "label": "Any Creative Commons"
            },
            {
              "value": "commercial",
              "label": "Commercial use"
            },
            {
              "value": "modification",
              "label": "Allows modification"
            }
          ]
        },
        {
          "key": "page_size",
          "label": "Results",
          "type": "number",
          "default": 20
        }
      ]
    },
    {
      "key": "search_audio",
      "name": "Search audio",
      "description": "Find openly licensed audio.",
      "method": "GET",
      "endpoint": "/audio/",
      "query": {
        "q": "{{ inputs.q }}",
        "page_size": "{{ inputs.page_size }}"
      },
      "output_fields": {
        "audio": "results",
        "urls": "results.*.url",
        "titles": "results.*.title"
      },
      "inputs": [
        {
          "key": "q",
          "label": "Search",
          "type": "string",
          "required": true
        },
        {
          "key": "page_size",
          "label": "Results",
          "type": "number",
          "default": 20
        }
      ]
    },
    {
      "key": "get_image",
      "name": "Get an image",
      "description": "Get one image's details and attribution.",
      "method": "GET",
      "endpoint": "/images/{{ inputs.image_id }}/",
      "output_fields": {
        "url": "url",
        "title": "title",
        "creator": "creator",
        "license": "license",
        "attribution": "attribution"
      },
      "inputs": [
        {
          "key": "image_id",
          "label": "Image ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
