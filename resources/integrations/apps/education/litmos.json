{
  "key": "litmos",
  "name": "SAP Litmos",
  "category": "Education",
  "description": "Look up Litmos users and courses.",
  "brand": "sap",
  "website": "https://www.litmos.com",
  "docs_url": "https://support.litmos.com",
  "base_url": "https://api.litmos.com/v1.svc",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "apikey",
      "fields": [
        {
          "key": "api_key",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "My profile & settings > API key."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_users",
      "name": "List users",
      "method": "GET",
      "endpoint": "/users",
      "query": {
        "source": "flowforge",
        "format": "json",
        "search": "{{ inputs.search }}"
      },
      "inputs": [
        {
          "key": "search",
          "label": "Search",
          "type": "string"
        }
      ]
    },
    {
      "key": "get_user",
      "name": "Get user",
      "method": "GET",
      "endpoint": "/users/{{ inputs.user_id }}",
      "query": {
        "source": "flowforge",
        "format": "json"
      },
      "inputs": [
        {
          "key": "user_id",
          "label": "User ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_courses",
      "name": "List courses",
      "method": "GET",
      "endpoint": "/courses",
      "query": {
        "source": "flowforge",
        "format": "json"
      },
      "inputs": []
    }
  ]
}
