{
  "key": "resend",
  "name": "Resend",
  "category": "Marketing & Email",
  "description": "Send transactional email and look up sent messages.",
  "brand": "resend",
  "website": "https://resend.com",
  "docs_url": "https://resend.com/docs/api-reference/introduction",
  "popular": true,
  "base_url": "https://api.resend.com",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key (re_…)",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "send_email",
      "name": "Send email",
      "method": "POST",
      "endpoint": "/emails",
      "body": {
        "from": "{{ inputs.from }}",
        "to": "{{ inputs.to }}",
        "subject": "{{ inputs.subject }}",
        "html": "{{ inputs.html }}",
        "text": "{{ inputs.text }}",
        "cc": "{{ inputs.cc }}",
        "bcc": "{{ inputs.bcc }}",
        "reply_to": "{{ inputs.reply_to }}",
        "scheduled_at": "{{ inputs.scheduled_at }}"
      },
      "inputs": [
        {
          "key": "from",
          "label": "From",
          "type": "string",
          "required": true,
          "placeholder": "Acme <onboarding@yourdomain.com>"
        },
        {
          "key": "to",
          "label": "To",
          "type": "list",
          "required": true
        },
        {
          "key": "subject",
          "label": "Subject",
          "type": "string",
          "required": true
        },
        {
          "key": "html",
          "label": "HTML",
          "type": "text"
        },
        {
          "key": "text",
          "label": "Plain text",
          "type": "text"
        },
        {
          "key": "cc",
          "label": "Cc",
          "type": "list"
        },
        {
          "key": "bcc",
          "label": "Bcc",
          "type": "list"
        },
        {
          "key": "reply_to",
          "label": "Reply-to",
          "type": "string"
        },
        {
          "key": "scheduled_at",
          "label": "Schedule for",
          "type": "string",
          "help": "ISO 8601 or natural language, e.g. \"in 1 hour\"."
        }
      ]
    },
    {
      "key": "get_email",
      "name": "Get email",
      "method": "GET",
      "endpoint": "/emails/{{ inputs.email_id }}",
      "inputs": [
        {
          "key": "email_id",
          "label": "Email ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "Webhooks (email.sent, email.delivered, email.bounced…).",
      "data_path": "data",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
