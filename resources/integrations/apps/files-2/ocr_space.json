{
  "key": "ocr_space",
  "name": "OCR.space",
  "category": "Files & Documents",
  "description": "Extract text from images and PDFs with the OCR.space API.",
  "brand": "ocrspace",
  "website": "https://ocr.space",
  "docs_url": "https://ocr.space/ocrapi",
  "base_url": "https://api.ocr.space",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "apikey"
    }
  ],
  "actions": [
    {
      "key": "ocr",
      "name": "Extract text",
      "method": "POST",
      "endpoint": "/parse/image",
      "body_format": "form",
      "timeout": 120,
      "error_path": "ErrorMessage",
      "body": {
        "url": "{{ inputs.url }}",
        "base64Image": "{{ inputs.base64_image }}",
        "language": "{{ inputs.language }}",
        "OCREngine": "{{ inputs.engine }}",
        "isTable": "{{ inputs.is_table }}",
        "scale": "{{ inputs.scale }}",
        "detectOrientation": "{{ inputs.detect_orientation }}",
        "filetype": "{{ inputs.filetype }}"
      },
      "output_fields": {
        "text": "ParsedResults.*.ParsedText"
      },
      "inputs": [
        {
          "key": "url",
          "label": "File URL",
          "type": "string",
          "help": "Image or PDF URL. Use this or Base64 image."
        },
        {
          "key": "base64_image",
          "label": "Base64 image",
          "type": "text",
          "placeholder": "data:image/png;base64,..."
        },
        {
          "key": "language",
          "label": "Language",
          "type": "string",
          "placeholder": "eng",
          "help": "3-letter code; engine 2 auto-detects."
        },
        {
          "key": "engine",
          "label": "OCR engine",
          "type": "select",
          "options": [
            {
              "value": "1",
              "label": "Engine 1"
            },
            {
              "value": "2",
              "label": "Engine 2"
            },
            {
              "value": "3",
              "label": "Engine 3"
            }
          ]
        },
        {
          "key": "is_table",
          "label": "Keep table layout",
          "type": "select",
          "options": [
            {
              "value": "true",
              "label": "Yes"
            },
            {
              "value": "false",
              "label": "No"
            }
          ]
        },
        {
          "key": "scale",
          "label": "Upscale image",
          "type": "select",
          "options": [
            {
              "value": "true",
              "label": "Yes"
            },
            {
              "value": "false",
              "label": "No"
            }
          ]
        },
        {
          "key": "detect_orientation",
          "label": "Auto-rotate",
          "type": "select",
          "options": [
            {
              "value": "true",
              "label": "Yes"
            },
            {
              "value": "false",
              "label": "No"
            }
          ]
        },
        {
          "key": "filetype",
          "label": "File type",
          "type": "string",
          "placeholder": "PDF",
          "help": "Override detection: PDF, GIF, PNG, JPG, TIF, BMP."
        }
      ]
    }
  ]
}
