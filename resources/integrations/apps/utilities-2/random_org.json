{
  "key": "random_org",
  "name": "RANDOM.ORG",
  "category": "Utilities",
  "description": "True random integers, decimals, strings and UUIDs from atmospheric noise.",
  "brand": "randomorg",
  "website": "https://www.random.org",
  "docs_url": "https://api.random.org/json-rpc/4/basic",
  "base_url": "https://api.random.org/json-rpc/4",
  "auth": { "type": "api_key", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true, "help": "From api.random.org/dashboard. Sent as params.apiKey in each JSON-RPC call." }
  ] },
  "actions": [
    {
      "key": "generate_integers",
      "name": "Generate integers",
      "method": "POST",
      "endpoint": "/invoke",
      "body": { "jsonrpc": "2.0", "method": "generateIntegers", "id": 1, "params": { "apiKey": "{{ credentials.api_key }}", "n": "{{ inputs.n }}", "min": "{{ inputs.min }}", "max": "{{ inputs.max }}", "replacement": "{{ inputs.replacement }}" } },
      "error_path": "error",
      "output_path": "result.random.data",
      "inputs": [
        { "key": "n", "label": "How many", "type": "number", "required": true, "default": 1 },
        { "key": "min", "label": "Minimum", "type": "number", "required": true, "default": 1 },
        { "key": "max", "label": "Maximum", "type": "number", "required": true, "default": 100 },
        { "key": "replacement", "label": "Allow duplicates", "type": "boolean", "help": "Default: yes." }
      ]
    },
    {
      "key": "generate_decimals",
      "name": "Generate decimal fractions",
      "description": "Uniform random numbers between 0 and 1.",
      "method": "POST",
      "endpoint": "/invoke",
      "body": { "jsonrpc": "2.0", "method": "generateDecimalFractions", "id": 1, "params": { "apiKey": "{{ credentials.api_key }}", "n": "{{ inputs.n }}", "decimalPlaces": "{{ inputs.decimal_places }}" } },
      "error_path": "error",
      "output_path": "result.random.data",
      "inputs": [
        { "key": "n", "label": "How many", "type": "number", "required": true, "default": 1 },
        { "key": "decimal_places", "label": "Decimal places", "type": "number", "required": true, "default": 4 }
      ]
    },
    {
      "key": "generate_strings",
      "name": "Generate strings",
      "method": "POST",
      "endpoint": "/invoke",
      "body": { "jsonrpc": "2.0", "method": "generateStrings", "id": 1, "params": { "apiKey": "{{ credentials.api_key }}", "n": "{{ inputs.n }}", "length": "{{ inputs.length }}", "characters": "{{ inputs.characters }}", "replacement": "{{ inputs.replacement }}" } },
      "error_path": "error",
      "output_path": "result.random.data",
      "inputs": [
        { "key": "n", "label": "How many", "type": "number", "required": true, "default": 1 },
        { "key": "length", "label": "Length", "type": "number", "required": true, "default": 12 },
        { "key": "characters", "label": "Allowed characters", "type": "string", "required": true, "default": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789" },
        { "key": "replacement", "label": "Allow duplicates", "type": "boolean" }
      ]
    },
    {
      "key": "generate_uuids",
      "name": "Generate UUIDs",
      "method": "POST",
      "endpoint": "/invoke",
      "body": { "jsonrpc": "2.0", "method": "generateUUIDs", "id": 1, "params": { "apiKey": "{{ credentials.api_key }}", "n": "{{ inputs.n }}" } },
      "error_path": "error",
      "output_path": "result.random.data",
      "inputs": [{ "key": "n", "label": "How many", "type": "number", "required": true, "default": 1 }]
    },
    {
      "key": "get_usage",
      "name": "Get usage",
      "method": "POST",
      "endpoint": "/invoke",
      "body": { "jsonrpc": "2.0", "method": "getUsage", "id": 1, "params": { "apiKey": "{{ credentials.api_key }}" } },
      "error_path": "error",
      "output_path": "result",
      "inputs": []
    }
  ]
}
