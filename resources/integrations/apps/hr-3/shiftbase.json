{
  "key": "shiftbase",
  "name": "Shiftbase",
  "category": "HR & Recruiting",
  "description": "Read employees, rosters, departments and timesheets from Shiftbase scheduling.",
  "website": "https://www.shiftbase.com",
  "docs_url": "https://developer.shiftbase.com/",
  "base_url": "https://api.shiftbase.com/api",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "Authorization",
    "prefix": "API ",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "In Shiftbase open Settings → Integrations → API → create a key and copy it."
      }
    ]
  },
  "actions": [
    {
      "key": "list_employees",
      "name": "List employees",
      "description": "List employees.",
      "method": "GET",
      "endpoint": "/employees",
      "output_fields": {
        "employees": "data",
        "first_id": "data.0.Employee.id",
        "first_name": "data.0.Employee.first_name",
        "first_email": "data.0.Employee.email"
      },
      "inputs": []
    },
    {
      "key": "list_departments",
      "name": "List departments",
      "description": "List departments.",
      "method": "GET",
      "endpoint": "/departments",
      "output_fields": {
        "departments": "data",
        "first_id": "data.0.Department.id",
        "first_name": "data.0.Department.name"
      },
      "inputs": []
    },
    {
      "key": "list_shifts",
      "name": "List shifts",
      "description": "List rostered shifts in a date range.",
      "method": "GET",
      "endpoint": "/rosters",
      "query": {
        "min_date": "{{ inputs.from }}",
        "max_date": "{{ inputs.to }}"
      },
      "output_fields": {
        "shifts": "data",
        "first_id": "data.0.Roster.id",
        "first_date": "data.0.Roster.date"
      },
      "inputs": [
        {
          "key": "from",
          "label": "From date",
          "type": "string",
          "required": true,
          "help": "YYYY-MM-DD"
        },
        {
          "key": "to",
          "label": "To date",
          "type": "string",
          "required": true,
          "help": "YYYY-MM-DD"
        }
      ]
    },
    {
      "key": "list_timesheets",
      "name": "List timesheets",
      "description": "List worked hours in a date range.",
      "method": "GET",
      "endpoint": "/timesheets",
      "query": {
        "min_date": "{{ inputs.from }}",
        "max_date": "{{ inputs.to }}"
      },
      "output_fields": {
        "timesheets": "data",
        "first_id": "data.0.Timesheet.id",
        "first_total": "data.0.Timesheet.total"
      },
      "inputs": [
        {
          "key": "from",
          "label": "From date",
          "type": "string",
          "required": true,
          "help": "YYYY-MM-DD"
        },
        {
          "key": "to",
          "label": "To date",
          "type": "string",
          "required": true,
          "help": "YYYY-MM-DD"
        }
      ]
    }
  ]
}
