{
  "key": "runn",
  "name": "Runn",
  "category": "Project Management",
  "description": "List Runn people, projects and clients for resource planning.",
  "brand": "runn",
  "website": "https://www.runn.io",
  "docs_url": "https://developer.runn.io/docs",
  "base_url": "https://api.runn.io",
  "headers": {
    "Accept-Version": "1.0.0"
  },
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "API token",
          "type": "password",
          "required": true,
          "help": "Settings > API (admins only)."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_people",
      "name": "List people",
      "method": "GET",
      "endpoint": "/people",
      "inputs": []
    },
    {
      "key": "list_projects",
      "name": "List projects",
      "method": "GET",
      "endpoint": "/projects",
      "inputs": []
    },
    {
      "key": "list_clients",
      "name": "List clients",
      "method": "GET",
      "endpoint": "/clients",
      "inputs": []
    }
  ]
}
