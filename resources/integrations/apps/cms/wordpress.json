{
  "key": "wordpress",
  "name": "WordPress",
  "category": "CMS & Websites",
  "description": "Create and update posts and pages, list posts and media.",
  "brand": "wordpress",
  "website": "https://wordpress.org",
  "docs_url": "https://developer.wordpress.org/rest-api/reference/",
  "popular": true,
  "base_url": "{{ credentials.site_url }}/wp-json/wp/v2",
  "auth": [
    {
      "type": "basic",
      "fields": [
        {
          "key": "site_url",
          "label": "Site URL",
          "type": "string",
          "required": true,
          "placeholder": "https://example.com",
          "help": "No trailing slash."
        },
        {
          "key": "username",
          "label": "Username",
          "type": "string",
          "required": true
        },
        {
          "key": "password",
          "label": "Application password",
          "type": "password",
          "required": true,
          "help": "Users > Profile > Application Passwords (WordPress 5.6+)."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "create_post",
      "name": "Create post",
      "method": "POST",
      "endpoint": "/posts",
      "body": {
        "title": "{{ inputs.title }}",
        "content": "{{ inputs.content }}",
        "status": "{{ inputs.status }}",
        "excerpt": "{{ inputs.excerpt }}",
        "slug": "{{ inputs.slug }}",
        "categories": "{{ inputs.categories }}",
        "tags": "{{ inputs.tags }}",
        "featured_media": "{{ inputs.featured_media }}",
        "date": "{{ inputs.date }}"
      },
      "inputs": [
        {
          "key": "title",
          "label": "Title",
          "type": "string",
          "required": true
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "options": [
            {
              "value": "draft",
              "label": "Draft"
            },
            {
              "value": "publish",
              "label": "Published"
            },
            {
              "value": "pending",
              "label": "Pending review"
            },
            {
              "value": "private",
              "label": "Private"
            },
            {
              "value": "future",
              "label": "Scheduled"
            }
          ],
          "default": "draft"
        },
        {
          "key": "content",
          "label": "Content (HTML)",
          "type": "text"
        },
        {
          "key": "excerpt",
          "label": "Excerpt",
          "type": "text"
        },
        {
          "key": "slug",
          "label": "Slug",
          "type": "string"
        },
        {
          "key": "categories",
          "label": "Category IDs",
          "type": "list"
        },
        {
          "key": "tags",
          "label": "Tag IDs",
          "type": "list"
        },
        {
          "key": "featured_media",
          "label": "Featured image (media ID)",
          "type": "number"
        },
        {
          "key": "date",
          "label": "Publish date",
          "type": "string",
          "placeholder": "2024-05-01T09:00:00",
          "help": "Site timezone. Use with status Scheduled."
        }
      ]
    },
    {
      "key": "update_post",
      "name": "Update post",
      "method": "POST",
      "endpoint": "/posts/{{ inputs.post_id }}",
      "body": {
        "title": "{{ inputs.title }}",
        "content": "{{ inputs.content }}",
        "status": "{{ inputs.status }}",
        "excerpt": "{{ inputs.excerpt }}",
        "slug": "{{ inputs.slug }}",
        "categories": "{{ inputs.categories }}",
        "tags": "{{ inputs.tags }}",
        "featured_media": "{{ inputs.featured_media }}",
        "date": "{{ inputs.date }}"
      },
      "inputs": [
        {
          "key": "post_id",
          "label": "Post ID",
          "type": "number",
          "required": true
        },
        {
          "key": "title",
          "label": "Title",
          "type": "string"
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "options": [
            {
              "value": "draft",
              "label": "Draft"
            },
            {
              "value": "publish",
              "label": "Published"
            },
            {
              "value": "pending",
              "label": "Pending review"
            },
            {
              "value": "private",
              "label": "Private"
            },
            {
              "value": "future",
              "label": "Scheduled"
            }
          ]
        },
        {
          "key": "content",
          "label": "Content (HTML)",
          "type": "text"
        },
        {
          "key": "excerpt",
          "label": "Excerpt",
          "type": "text"
        },
        {
          "key": "slug",
          "label": "Slug",
          "type": "string"
        },
        {
          "key": "categories",
          "label": "Category IDs",
          "type": "list"
        },
        {
          "key": "tags",
          "label": "Tag IDs",
          "type": "list"
        },
        {
          "key": "featured_media",
          "label": "Featured image (media ID)",
          "type": "number"
        },
        {
          "key": "date",
          "label": "Publish date",
          "type": "string",
          "placeholder": "2024-05-01T09:00:00",
          "help": "Site timezone. Use with status Scheduled."
        }
      ]
    },
    {
      "key": "get_post",
      "name": "Get post",
      "method": "GET",
      "endpoint": "/posts/{{ inputs.post_id }}",
      "inputs": [
        {
          "key": "post_id",
          "label": "Post ID",
          "type": "number",
          "required": true
        }
      ]
    },
    {
      "key": "list_posts",
      "name": "List posts",
      "method": "GET",
      "endpoint": "/posts",
      "query": {
        "search": "{{ inputs.search }}",
        "status": "{{ inputs.status }}",
        "categories": "{{ inputs.categories }}",
        "per_page": "{{ inputs.per_page }}",
        "orderby": "date",
        "order": "desc"
      },
      "inputs": [
        {
          "key": "search",
          "label": "Search",
          "type": "string"
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "options": [
            {
              "value": "draft",
              "label": "Draft"
            },
            {
              "value": "publish",
              "label": "Published"
            },
            {
              "value": "pending",
              "label": "Pending review"
            },
            {
              "value": "private",
              "label": "Private"
            },
            {
              "value": "future",
              "label": "Scheduled"
            }
          ]
        },
        {
          "key": "categories",
          "label": "Category ID",
          "type": "string"
        },
        {
          "key": "per_page",
          "label": "Max results",
          "type": "number",
          "default": 10
        }
      ]
    },
    {
      "key": "create_page",
      "name": "Create page",
      "method": "POST",
      "endpoint": "/pages",
      "body": {
        "title": "{{ inputs.title }}",
        "content": "{{ inputs.content }}",
        "status": "{{ inputs.status }}",
        "slug": "{{ inputs.slug }}",
        "parent": "{{ inputs.parent }}"
      },
      "inputs": [
        {
          "key": "title",
          "label": "Title",
          "type": "string",
          "required": true
        },
        {
          "key": "content",
          "label": "Content (HTML)",
          "type": "text"
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "options": [
            {
              "value": "draft",
              "label": "Draft"
            },
            {
              "value": "publish",
              "label": "Published"
            },
            {
              "value": "pending",
              "label": "Pending review"
            },
            {
              "value": "private",
              "label": "Private"
            },
            {
              "value": "future",
              "label": "Scheduled"
            }
          ],
          "default": "draft"
        },
        {
          "key": "slug",
          "label": "Slug",
          "type": "string"
        },
        {
          "key": "parent",
          "label": "Parent page ID",
          "type": "number"
        }
      ]
    },
    {
      "key": "list_media",
      "name": "List media",
      "method": "GET",
      "endpoint": "/media",
      "query": {
        "search": "{{ inputs.search }}",
        "media_type": "{{ inputs.media_type }}",
        "per_page": "{{ inputs.per_page }}"
      },
      "inputs": [
        {
          "key": "search",
          "label": "Search",
          "type": "string"
        },
        {
          "key": "media_type",
          "label": "Type",
          "type": "select",
          "options": [
            {
              "value": "image",
              "label": "Image"
            },
            {
              "value": "video",
              "label": "Video"
            },
            {
              "value": "audio",
              "label": "Audio"
            },
            {
              "value": "application",
              "label": "Documents"
            }
          ]
        },
        {
          "key": "per_page",
          "label": "Max results",
          "type": "number",
          "default": 10
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "new_post",
      "name": "New post",
      "type": "polling",
      "method": "GET",
      "endpoint": "/posts",
      "query": {
        "status": "{{ inputs.status }}",
        "orderby": "date",
        "order": "desc",
        "per_page": 20
      },
      "id_field": "id",
      "inputs": [
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "options": [
            {
              "value": "draft",
              "label": "Draft"
            },
            {
              "value": "publish",
              "label": "Published"
            },
            {
              "value": "pending",
              "label": "Pending review"
            },
            {
              "value": "private",
              "label": "Private"
            },
            {
              "value": "future",
              "label": "Scheduled"
            }
          ],
          "default": "publish"
        },
        {
          "key": "poll_interval",
          "label": "Check every (minutes)",
          "type": "number",
          "default": 5
        }
      ]
    }
  ]
}
