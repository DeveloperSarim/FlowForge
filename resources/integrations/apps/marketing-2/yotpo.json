{
  "key": "yotpo",
  "name": "Yotpo",
  "category": "Marketing & Email",
  "description": "Retrieve your store's Yotpo product and site reviews.",
  "brand": "yotpo",
  "website": "https://www.yotpo.com",
  "docs_url": "https://apidocs.yotpo.com/",
  "base_url": "https://api.yotpo.com",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "utoken",
    "fields": [
      { "key": "app_key", "label": "App key (store ID)", "type": "string", "required": true },
      { "key": "api_key", "label": "utoken", "type": "password", "required": true,
        "help": "POST https://api.yotpo.com/oauth/token with client_id = app key, client_secret = secret key, grant_type = client_credentials." }
    ]
  },
  "actions": [
    {
      "key": "list_reviews",
      "name": "List reviews",
      "method": "GET",
      "endpoint": "/v1/apps/{{ credentials.app_key }}/reviews",
      "query": { "count": "{{ inputs.count }}", "page": "{{ inputs.page }}", "since_date": "{{ inputs.since_date }}" },
      "output_path": "reviews",
      "inputs": [
        { "key": "count", "label": "Per page (max 100)", "type": "number", "default": 100 },
        { "key": "page", "label": "Page", "type": "number", "default": 1 },
        { "key": "since_date", "label": "Created since (ISO 8601)", "type": "string" }
      ]
    }
  ]
}
