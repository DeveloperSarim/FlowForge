{
  "key": "retently",
  "name": "Retently",
  "category": "Forms & Surveys",
  "description": "Call the Retently API and trigger on new NPS/CSAT feedback.",
  "brand": "retently",
  "website": "https://www.retently.com",
  "docs_url": "https://www.retently.com/api/",
  "base_url": "https://app.retently.com/api/v2",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "Authorization",
    "prefix": "api_key=",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Settings > API"
      }
    ]
  },
  "triggers": [
    {
      "key": "new_feedback",
      "name": "New feedback (webhook)",
      "type": "webhook",
      "description": "Settings > Integrations > Webhooks, paste this URL.",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ],
  "actions": []
}
