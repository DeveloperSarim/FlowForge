{
  "key": "webpushr",
  "name": "Webpushr",
  "category": "Communication",
  "description": "Send web push notifications to all subscribers, a segment or one subscriber.",
  "brand": "webpushr",
  "website": "https://www.webpushr.com",
  "docs_url": "https://docs.webpushr.com/introduction-to-rest-api",
  "base_url": "https://api.webpushr.com/v1",
  "headers": { "webpushrAuthToken": "{{ credentials.auth_token }}" },
  "auth": [
    { "type": "api_key", "in": "header", "name": "webpushrKey", "fields": [
      { "key": "api_key", "label": "REST API key", "type": "password", "required": true, "help": "Dashboard → Integration → REST API Keys." },
      { "key": "auth_token", "label": "Authentication token", "type": "password", "required": true }
    ] }
  ],
  "actions": [
    {
      "key": "send_to_all",
      "name": "Send to all subscribers",
      "method": "POST",
      "endpoint": "/notification/send/all",
      "body": { "title": "{{ inputs.title }}", "message": "{{ inputs.message }}", "target_url": "{{ inputs.target_url }}", "icon": "{{ inputs.icon }}", "image": "{{ inputs.image }}" },
      "inputs": [
        { "key": "title", "label": "Title", "type": "string", "required": true },
        { "key": "message", "label": "Message", "type": "text", "required": true },
        { "key": "target_url", "label": "Target URL", "type": "string", "required": true },
        { "key": "icon", "label": "Icon URL", "type": "string" },
        { "key": "image", "label": "Image URL", "type": "string" }
      ]
    },
    {
      "key": "send_to_segment",
      "name": "Send to segments",
      "method": "POST",
      "endpoint": "/notification/send/segment",
      "body": { "title": "{{ inputs.title }}", "message": "{{ inputs.message }}", "target_url": "{{ inputs.target_url }}", "segment": "{{ inputs.segment }}" },
      "inputs": [
        { "key": "segment", "label": "Segment IDs", "type": "list", "required": true },
        { "key": "title", "label": "Title", "type": "string", "required": true },
        { "key": "message", "label": "Message", "type": "text", "required": true },
        { "key": "target_url", "label": "Target URL", "type": "string", "required": true }
      ]
    },
    {
      "key": "send_to_subscriber",
      "name": "Send to subscriber",
      "method": "POST",
      "endpoint": "/notification/send/sid",
      "body": { "title": "{{ inputs.title }}", "message": "{{ inputs.message }}", "target_url": "{{ inputs.target_url }}", "sid": "{{ inputs.sid }}" },
      "inputs": [
        { "key": "sid", "label": "Subscriber ID", "type": "string", "required": true },
        { "key": "title", "label": "Title", "type": "string", "required": true },
        { "key": "message", "label": "Message", "type": "text", "required": true },
        { "key": "target_url", "label": "Target URL", "type": "string", "required": true }
      ]
    }
  ]
}
