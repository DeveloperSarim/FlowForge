{
  "key": "klipfolio",
  "name": "Klipfolio",
  "category": "Analytics",
  "description": "List Klipfolio data sources and queue them for refresh.",
  "brand": "klipfolio",
  "website": "https://www.klipfolio.com",
  "docs_url": "https://support.klipfolio.com",
  "base_url": "https://app.klipfolio.com/api/1.0",
  "auth": { "type": "api_key", "in": "header", "name": "kf-api-key", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true, "help": "Your user profile → API key." }
  ] },
  "actions": [
    {
      "key": "get_profile",
      "name": "Get my profile",
      "method": "GET",
      "endpoint": "/profile",
      "inputs": []
    },
    {
      "key": "list_datasources",
      "name": "List data sources",
      "method": "GET",
      "endpoint": "/datasources",
      "inputs": []
    },
    {
      "key": "refresh_datasources",
      "name": "Refresh data sources",
      "description": "Queues the given data sources for refresh.",
      "method": "POST",
      "endpoint": "/datasources/@/refresh",
      "body": { "datasources": "{{ inputs.datasource_ids }}" },
      "inputs": [{ "key": "datasource_ids", "label": "Data source IDs", "type": "list", "required": true }]
    }
  ]
}
