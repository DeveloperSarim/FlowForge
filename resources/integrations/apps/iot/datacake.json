{
  "key": "datacake",
  "name": "Datacake",
  "category": "IoT & Smart Home",
  "description": "Query Datacake devices, workspaces and measurements with GraphQL.",
  "brand": "datacake",
  "website": "https://datacake.co",
  "docs_url": "https://docs.datacake.de/api",
  "base_url": "https://api.datacake.co",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "Authorization",
      "prefix": "Token ",
      "fields": [
        { "key": "api_key", "label": "API token", "type": "password", "required": true, "help": "Account settings > API token (or create an API user in the workspace)." }
      ]
    }
  ],
  "actions": [
    {
      "key": "graphql_query",
      "name": "Run GraphQL query",
      "description": "Explore the schema in the GraphiQL explorer at api.datacake.co/graphql/.",
      "method": "POST",
      "endpoint": "/graphql/",
      "body": { "query": "{{ inputs.query }}", "variables": "{{ inputs.variables }}" },
      "error_path": "errors.0.message",
      "output_path": "data",
      "inputs": [
        { "key": "query", "label": "Query", "type": "code", "required": true, "placeholder": "query { user { id email } }" },
        { "key": "variables", "label": "Variables", "type": "json" }
      ]
    }
  ]
}
