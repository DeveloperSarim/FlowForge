{
  "key": "letta",
  "name": "Letta",
  "category": "AI",
  "description": "Message stateful Letta agents and list them.",
  "brand": "letta",
  "website": "https://www.letta.com",
  "docs_url": "https://docs.letta.com/api-reference/overview",
  "base_url": "{{ credentials.base_url }}/v1",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "base_url",
        "label": "Server URL",
        "type": "string",
        "required": true,
        "default": "https://api.letta.com",
        "help": "https://api.letta.com for Letta Cloud, or your self-hosted server URL."
      },
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Leave any value for a self-hosted server without auth."
      }
    ]
  },
  "actions": [
    {
      "key": "send_message",
      "name": "Send message",
      "method": "POST",
      "endpoint": "/agents/{{ inputs.agent_id }}/messages",
      "timeout": 300,
      "body": {
        "input": "{{ inputs.message }}",
        "streaming": false
      },
      "inputs": [
        {
          "key": "agent_id",
          "label": "Agent ID",
          "type": "string",
          "required": true,
          "placeholder": "agent-..."
        },
        {
          "key": "message",
          "label": "Message",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "key": "list_agents",
      "name": "List agents",
      "method": "GET",
      "endpoint": "/agents/",
      "query": {
        "name": "{{ inputs.name }}",
        "limit": "{{ inputs.limit }}"
      },
      "inputs": [
        {
          "key": "name",
          "label": "Name",
          "type": "string"
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50
        }
      ]
    }
  ]
}
