{
  "key": "openrouter",
  "name": "OpenRouter",
  "category": "AI",
  "description": "One API key for chat with hundreds of models from many providers.",
  "brand": "openrouter",
  "website": "https://openrouter.ai",
  "docs_url": "https://openrouter.ai/docs/api-reference/overview",
  "base_url": "https://openrouter.ai/api/v1",
  "headers": {
    "X-Title": "FlowForge"
  },
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "chat_completion",
      "name": "Chat completion",
      "description": "Send a prompt and get the reply as {{ steps.<id>.text }}.",
      "method": "POST",
      "endpoint": "/chat/completions",
      "timeout": 300,
      "body": {
        "model": "{{ inputs.model }}",
        "messages": [
          {
            "role": "system",
            "content": "{{ inputs.system }}"
          },
          {
            "role": "user",
            "content": "{{ inputs.prompt }}"
          }
        ],
        "temperature": "{{ inputs.temperature }}",
        "max_tokens": "{{ inputs.max_tokens }}"
      },
      "output_fields": {
        "text": "choices.0.message.content"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "default": "openrouter/auto",
          "help": "Any model slug, e.g. openai/gpt-5-mini or anthropic/claude-sonnet-4.5."
        },
        {
          "key": "prompt",
          "label": "Prompt",
          "type": "text",
          "required": true
        },
        {
          "key": "system",
          "label": "System prompt",
          "type": "text",
          "required": true,
          "default": "You are a helpful assistant.",
          "help": "Sent as the system message."
        },
        {
          "key": "temperature",
          "label": "Temperature",
          "type": "number",
          "placeholder": "0.7"
        },
        {
          "key": "max_tokens",
          "label": "Max output tokens",
          "type": "number"
        }
      ]
    },
    {
      "key": "get_credits",
      "name": "Get credits",
      "method": "GET",
      "endpoint": "/credits",
      "output_path": "data",
      "inputs": []
    }
  ]
}
