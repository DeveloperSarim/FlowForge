{
  "key": "rescuetime",
  "name": "RescueTime",
  "category": "Productivity",
  "description": "Pull RescueTime productivity data and daily summaries.",
  "brand": "rescuetime",
  "website": "https://www.rescuetime.com",
  "docs_url": "https://www.rescuetime.com/anapi/setup/documentation",
  "base_url": "https://www.rescuetime.com/anapi",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "rescuetime.com/anapi/manage"
      }
    ]
  },
  "actions": [
    {
      "key": "get_analytic_data",
      "name": "Get analytic data",
      "method": "GET",
      "endpoint": "/data",
      "query": {
        "format": "json",
        "perspective": "{{ inputs.perspective }}",
        "resolution_time": "{{ inputs.resolution_time }}",
        "restrict_kind": "{{ inputs.restrict_kind }}",
        "restrict_begin": "{{ inputs.restrict_begin }}",
        "restrict_end": "{{ inputs.restrict_end }}",
        "restrict_thing": "{{ inputs.restrict_thing }}"
      },
      "inputs": [
        {
          "key": "perspective",
          "label": "Perspective",
          "type": "select",
          "default": "rank",
          "options": [
            {
              "value": "rank",
              "label": "Ranked totals"
            },
            {
              "value": "interval",
              "label": "Over time"
            }
          ]
        },
        {
          "key": "resolution_time",
          "label": "Resolution",
          "type": "select",
          "default": "day",
          "options": [
            {
              "value": "month",
              "label": "month"
            },
            {
              "value": "week",
              "label": "week"
            },
            {
              "value": "day",
              "label": "day"
            },
            {
              "value": "hour",
              "label": "hour"
            },
            {
              "value": "minute",
              "label": "minute"
            }
          ]
        },
        {
          "key": "restrict_kind",
          "label": "Group by",
          "type": "select",
          "default": "activity",
          "options": [
            {
              "value": "overview",
              "label": "overview"
            },
            {
              "value": "category",
              "label": "category"
            },
            {
              "value": "activity",
              "label": "activity"
            },
            {
              "value": "productivity",
              "label": "productivity"
            },
            {
              "value": "efficiency",
              "label": "efficiency"
            },
            {
              "value": "document",
              "label": "document"
            }
          ]
        },
        {
          "key": "restrict_begin",
          "label": "From",
          "type": "string",
          "placeholder": "2026-10-01"
        },
        {
          "key": "restrict_end",
          "label": "To",
          "type": "string",
          "placeholder": "2026-10-12"
        },
        {
          "key": "restrict_thing",
          "label": "Only this activity/category",
          "type": "string"
        }
      ]
    },
    {
      "key": "get_daily_summary",
      "name": "Get daily summaries",
      "description": "Productivity pulse and time totals for recent days.",
      "method": "GET",
      "endpoint": "/daily_summary_feed",
      "inputs": []
    }
  ]
}
