{
  "key": "wave",
  "name": "Wave",
  "category": "Payments & Finance",
  "description": "Query and update Wave accounting data through its GraphQL API.",
  "brand": "wave",
  "website": "https://www.waveapps.com",
  "docs_url": "https://developer.waveapps.com/hc/en-us/articles/360019968212-API-Reference",
  "base_url": "https://gql.waveapps.com",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "Access token",
          "type": "password",
          "required": true,
          "help": "Full access token from your application in the Wave developer portal."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "graphql",
      "name": "Run GraphQL query",
      "method": "POST",
      "endpoint": "/graphql/public",
      "error_path": "errors",
      "body": {
        "query": "{{ inputs.query }}",
        "variables": "{{ inputs.variables }}"
      },
      "inputs": [
        {
          "key": "query",
          "label": "Query",
          "type": "code",
          "required": true,
          "placeholder": "query { user { id defaultEmail } }"
        },
        {
          "key": "variables",
          "label": "Variables",
          "type": "json"
        }
      ]
    },
    {
      "key": "list_businesses",
      "name": "List businesses",
      "method": "POST",
      "endpoint": "/graphql/public",
      "error_path": "errors",
      "output_path": "data.businesses.edges",
      "body": {
        "query": "query { businesses(page: 1, pageSize: 50) { edges { node { id name isPersonal currency { code } } } } }"
      },
      "inputs": []
    }
  ],
  "triggers": []
}
