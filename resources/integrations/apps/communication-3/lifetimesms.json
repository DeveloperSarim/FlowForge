{
  "key": "lifetimesms",
  "name": "Lifetimesms",
  "category": "Communication",
  "description": "Send branded SMS and OTPs in Pakistan with Lifetimesms and check balance.",
  "website": "https://lifetimesms.com",
  "docs_url": "https://lifetimesms.com/api-documentation",
  "base_url": "https://lifetimesms.com",
  "auth": {
    "type": "api_key",
    "fields": [
      {
        "key": "api_key",
        "label": "API token",
        "type": "password",
        "required": true,
        "help": "Lifetimesms dashboard → API → API Token."
      },
      {
        "key": "api_secret",
        "label": "API secret",
        "type": "password",
        "required": true,
        "help": "Shown next to the API token."
      }
    ]
  },
  "actions": [
    {
      "key": "send_sms",
      "name": "Send SMS",
      "method": "POST",
      "endpoint": "/json",
      "body": {
        "api_token": "{{ credentials.api_key }}",
        "api_secret": "{{ credentials.api_secret }}",
        "to": "{{ inputs.to }}",
        "from": "{{ inputs.from }}",
        "message": "{{ inputs.message }}",
        "type": "{{ inputs.type }}",
        "date": "{{ inputs.date }}",
        "time": "{{ inputs.time }}"
      },
      "body_format": "form",
      "inputs": [
        {
          "key": "to",
          "label": "To",
          "type": "string",
          "required": true,
          "placeholder": "923001234567",
          "help": "Comma separate several numbers."
        },
        {
          "key": "from",
          "label": "Brand / masking",
          "type": "string",
          "required": true,
          "default": "SMS Alert"
        },
        {
          "key": "message",
          "label": "Message",
          "type": "text",
          "required": true
        },
        {
          "key": "type",
          "label": "Urdu / Unicode",
          "type": "select",
          "default": "",
          "options": [
            {
              "value": "",
              "label": "No"
            },
            {
              "value": "unicode",
              "label": "Yes"
            }
          ]
        },
        {
          "key": "date",
          "label": "Schedule date",
          "type": "string",
          "placeholder": "25-12-2026"
        },
        {
          "key": "time",
          "label": "Schedule time",
          "type": "string",
          "placeholder": "10:30:00"
        }
      ]
    },
    {
      "key": "send_otp",
      "name": "Send OTP",
      "method": "POST",
      "endpoint": "/otp",
      "body": {
        "api_token": "{{ credentials.api_key }}",
        "api_secret": "{{ credentials.api_secret }}",
        "to": "{{ inputs.to }}",
        "from": "{{ inputs.from }}",
        "event_id": "{{ inputs.event_id }}",
        "data": "{{ inputs.data }}"
      },
      "body_format": "form",
      "inputs": [
        {
          "key": "to",
          "label": "To",
          "type": "string",
          "required": true,
          "placeholder": "923001234567"
        },
        {
          "key": "from",
          "label": "Brand / masking",
          "type": "string",
          "required": true
        },
        {
          "key": "event_id",
          "label": "Event ID",
          "type": "string",
          "required": true,
          "help": "The OTP event set up in your Lifetimesms dashboard."
        },
        {
          "key": "data",
          "label": "Variables (JSON)",
          "type": "text",
          "placeholder": "{\"code\":\"1234\"}"
        }
      ]
    },
    {
      "key": "get_balance",
      "name": "Check balance",
      "method": "POST",
      "endpoint": "/balance-inquiry",
      "body": {
        "api_token": "{{ credentials.api_key }}",
        "api_secret": "{{ credentials.api_secret }}"
      },
      "body_format": "form",
      "inputs": []
    },
    {
      "key": "get_delivery",
      "name": "Check delivery",
      "method": "POST",
      "endpoint": "/delivery-inquiry",
      "body": {
        "api_token": "{{ credentials.api_key }}",
        "api_secret": "{{ credentials.api_secret }}",
        "messageid": "{{ inputs.messageid }}"
      },
      "body_format": "form",
      "inputs": [
        {
          "key": "messageid",
          "label": "Message ID(s)",
          "type": "string",
          "required": true,
          "help": "Comma separate several IDs."
        }
      ]
    }
  ]
}
