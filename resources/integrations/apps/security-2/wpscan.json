{
  "key": "wpscan",
  "name": "WPScan",
  "category": "Security & IT",
  "description": "Look up known vulnerabilities in WordPress core, plugins and themes.",
  "brand": "wpscan",
  "website": "https://wpscan.com",
  "docs_url": "https://wpscan.com/docs/api/v3/",
  "base_url": "https://wpscan.com/api/v3",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "Authorization",
    "prefix": "Token token=",
    "fields": [
      {
        "key": "api_key",
        "label": "API token",
        "type": "password",
        "required": true,
        "help": "wpscan.com → sign in → Profile → API token."
      }
    ]
  },
  "actions": [
    {
      "key": "check_plugin",
      "name": "Check plugin",
      "description": "List known vulnerabilities of a plugin.",
      "method": "GET",
      "endpoint": "/plugins/{{ inputs.slug }}",
      "output_fields": {
        "latest_version": "*.latest_version",
        "vulnerability_titles": "*.vulnerabilities.*.title"
      },
      "inputs": [
        {
          "key": "slug",
          "label": "Plugin slug",
          "type": "string",
          "required": true,
          "placeholder": "contact-form-7",
          "help": "From the plugin's wordpress.org URL."
        }
      ]
    },
    {
      "key": "check_theme",
      "name": "Check theme",
      "description": "List known vulnerabilities of a theme.",
      "method": "GET",
      "endpoint": "/themes/{{ inputs.slug }}",
      "output_fields": {
        "latest_version": "*.latest_version",
        "vulnerability_titles": "*.vulnerabilities.*.title"
      },
      "inputs": [
        {
          "key": "slug",
          "label": "Theme slug",
          "type": "string",
          "required": true,
          "placeholder": "twentytwentyfour"
        }
      ]
    },
    {
      "key": "check_wordpress",
      "name": "Check WordPress version",
      "description": "List known vulnerabilities of a WordPress core version.",
      "method": "GET",
      "endpoint": "/wordpresses/{{ inputs.version }}",
      "output_fields": {
        "status": "*.status",
        "vulnerability_titles": "*.vulnerabilities.*.title"
      },
      "inputs": [
        {
          "key": "version",
          "label": "Version without dots",
          "type": "string",
          "required": true,
          "placeholder": "643",
          "help": "E.g. 643 for WordPress 6.4.3."
        }
      ]
    },
    {
      "key": "get_status",
      "name": "Get API status",
      "description": "See your plan and remaining API requests.",
      "method": "GET",
      "endpoint": "/status",
      "output_fields": {
        "plan": "plan",
        "requests_remaining": "requests_remaining"
      },
      "inputs": []
    }
  ]
}
