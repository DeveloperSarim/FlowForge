{
  "key": "vercel_ai_gateway",
  "name": "Vercel AI Gateway",
  "category": "AI",
  "description": "One API key for hundreds of AI models, with budgets, fallbacks and usage tracking.",
  "brand": "vercel",
  "website": "https://vercel.com/ai-gateway",
  "docs_url": "https://vercel.com/docs/ai-gateway/openai-compat",
  "base_url": "https://ai-gateway.vercel.sh/v1",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Vercel dashboard → AI Gateway → API Keys → Create key."
      }
    ]
  },
  "actions": [
    {
      "key": "chat_completion",
      "name": "Chat completion",
      "description": "Send a prompt and get the model's reply as text.",
      "method": "POST",
      "endpoint": "/chat/completions",
      "timeout": 300,
      "body": {
        "model": "{{ inputs.model }}",
        "messages": [
          {
            "$if": "{{ inputs.system }}",
            "role": "system",
            "content": "{{ inputs.system }}"
          },
          {
            "role": "user",
            "content": "{{ inputs.prompt }}"
          }
        ],
        "temperature": "{{ inputs.temperature }}",
        "max_tokens": "{{ inputs.max_tokens }}"
      },
      "output_fields": {
        "text": "choices.0.message.content"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "help": "provider/model, e.g. openai/gpt-4o-mini or anthropic/claude-sonnet-4. See List models.",
          "default": "openai/gpt-4o-mini"
        },
        {
          "key": "prompt",
          "label": "Prompt",
          "type": "text",
          "required": true
        },
        {
          "key": "system",
          "label": "System prompt",
          "type": "text",
          "help": "Optional instructions for how the model should behave."
        },
        {
          "key": "temperature",
          "label": "Temperature",
          "type": "number",
          "placeholder": "0.7",
          "help": "0 = focused, 1 = creative. Leave blank for the default."
        },
        {
          "key": "max_tokens",
          "label": "Max output tokens",
          "type": "number"
        }
      ]
    },
    {
      "key": "create_embedding",
      "name": "Create embedding",
      "description": "Turn text into a vector for search or similarity.",
      "method": "POST",
      "endpoint": "/embeddings",
      "body": {
        "model": "{{ inputs.model }}",
        "input": "{{ inputs.input }}"
      },
      "output_fields": {
        "embedding": "data.0.embedding"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "help": "provider/model of an embedding model.",
          "default": "openai/text-embedding-3-small"
        },
        {
          "key": "input",
          "label": "Text",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "key": "list_models",
      "name": "List models",
      "description": "List the models you can use.",
      "method": "GET",
      "endpoint": "/models",
      "output_fields": {
        "models": "data.*.id"
      },
      "inputs": []
    },
    {
      "key": "get_credits",
      "name": "Get credit balance",
      "description": "Show the remaining AI Gateway credit balance.",
      "method": "GET",
      "endpoint": "/credits",
      "output_fields": {
        "balance": "balance",
        "total_used": "total_used"
      },
      "inputs": []
    }
  ]
}
