{
  "key": "musicbrainz",
  "name": "MusicBrainz",
  "category": "Video & Media",
  "description": "Search the open MusicBrainz music database for artists, releases and recordings.",
  "website": "https://musicbrainz.org",
  "docs_url": "https://musicbrainz.org/doc/MusicBrainz_API",
  "base_url": "https://musicbrainz.org/ws/2",
  "headers": {
    "User-Agent": "FlowForge/1.0 (https://github.com)"
  },
  "auth": {
    "type": "none"
  },
  "actions": [
    {
      "key": "search_artists",
      "name": "Search artists",
      "description": "Find artists by name.",
      "method": "GET",
      "endpoint": "/artist",
      "query": {
        "query": "{{ inputs.query }}",
        "limit": "{{ inputs.limit }}",
        "fmt": "json"
      },
      "output_fields": {
        "ids": "artists.*.id",
        "names": "artists.*.name"
      },
      "inputs": [
        {
          "key": "query",
          "label": "Search",
          "type": "string",
          "required": true
        },
        {
          "key": "limit",
          "label": "Max results",
          "type": "number",
          "default": 10
        }
      ]
    },
    {
      "key": "search_releases",
      "name": "Search releases",
      "description": "Find albums and singles.",
      "method": "GET",
      "endpoint": "/release",
      "query": {
        "query": "{{ inputs.query }}",
        "limit": "{{ inputs.limit }}",
        "fmt": "json"
      },
      "output_fields": {
        "ids": "releases.*.id",
        "titles": "releases.*.title"
      },
      "inputs": [
        {
          "key": "query",
          "label": "Search",
          "type": "string",
          "required": true,
          "help": "e.g. release:\"Abbey Road\" AND artist:Beatles"
        },
        {
          "key": "limit",
          "label": "Max results",
          "type": "number",
          "default": 10
        }
      ]
    },
    {
      "key": "search_recordings",
      "name": "Search recordings",
      "description": "Find songs.",
      "method": "GET",
      "endpoint": "/recording",
      "query": {
        "query": "{{ inputs.query }}",
        "limit": "{{ inputs.limit }}",
        "fmt": "json"
      },
      "output_fields": {
        "ids": "recordings.*.id",
        "titles": "recordings.*.title"
      },
      "inputs": [
        {
          "key": "query",
          "label": "Search",
          "type": "string",
          "required": true
        },
        {
          "key": "limit",
          "label": "Max results",
          "type": "number",
          "default": 10
        }
      ]
    },
    {
      "key": "get_artist",
      "name": "Get an artist",
      "description": "Get an artist by MusicBrainz ID.",
      "method": "GET",
      "endpoint": "/artist/{{ inputs.mbid }}",
      "query": {
        "inc": "{{ inputs.inc }}",
        "fmt": "json"
      },
      "output_fields": {
        "name": "name",
        "country": "country"
      },
      "inputs": [
        {
          "key": "mbid",
          "label": "MusicBrainz ID",
          "type": "string",
          "required": true,
          "help": "The id from Search artists."
        },
        {
          "key": "inc",
          "label": "Include",
          "type": "string",
          "help": "e.g. url-rels or release-groups"
        }
      ]
    }
  ]
}
