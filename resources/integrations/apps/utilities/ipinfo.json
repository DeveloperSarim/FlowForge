{
  "key": "ipinfo",
  "name": "IPinfo",
  "category": "Utilities",
  "description": "Look up location, ASN and company details for IP addresses.",
  "brand": "ipinfo",
  "website": "https://ipinfo.io",
  "docs_url": "https://ipinfo.io/developers",
  "base_url": "https://ipinfo.io",
  "auth": { "type": "bearer", "fields": [
    { "key": "token", "label": "Access token", "type": "password", "required": true, "help": "From ipinfo.io/account/token." }
  ] },
  "actions": [
    {
      "key": "lookup_ip",
      "name": "Look up IP address",
      "method": "GET",
      "endpoint": "/{{ inputs.ip }}/json",
      "inputs": [{ "key": "ip", "label": "IP address", "type": "string", "required": true, "placeholder": "8.8.8.8" }]
    },
    {
      "key": "batch_lookup",
      "name": "Look up many IPs",
      "description": "Batch lookup of up to 1000 IPs in one request.",
      "method": "POST",
      "endpoint": "/batch",
      "body": "{{ inputs.ips }}",
      "inputs": [{ "key": "ips", "label": "IP addresses", "type": "list", "required": true, "help": "An IP, or IP/field such as 8.8.8.8/country, per row." }]
    }
  ]
}
