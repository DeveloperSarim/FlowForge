{
  "key": "mem",
  "name": "Mem",
  "category": "Productivity",
  "description": "Save notes to Mem from your workflows.",
  "brand": "mem",
  "website": "https://mem.ai",
  "docs_url": "https://docs.mem.ai/api-reference/notes/create-note",
  "base_url": "https://api.mem.ai/v2",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Mem settings > API."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "create_note",
      "name": "Create note",
      "method": "POST",
      "endpoint": "/notes",
      "body": {
        "content": "{{ inputs.content }}",
        "collection_titles": "{{ inputs.collection_titles }}"
      },
      "inputs": [
        {
          "key": "content",
          "label": "Content (Markdown)",
          "type": "text",
          "required": true,
          "help": "The first line becomes the note title."
        },
        {
          "key": "collection_titles",
          "label": "Collections (by title)",
          "type": "list"
        }
      ]
    }
  ]
}
