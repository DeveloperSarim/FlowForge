{
  "key": "pushsafer",
  "name": "Pushsafer",
  "category": "Communication",
  "description": "Send push notifications to iOS, Android and desktop devices with Pushsafer.",
  "brand": "pushsafer",
  "website": "https://www.pushsafer.com",
  "docs_url": "https://www.pushsafer.com/en/pushapi",
  "base_url": "https://www.pushsafer.com",
  "auth": [
    { "type": "api_key", "fields": [{ "key": "api_key", "label": "Private or alias key", "type": "password", "required": true }] }
  ],
  "actions": [
    {
      "key": "send_notification",
      "name": "Send notification",
      "method": "POST",
      "endpoint": "/api",
      "body_format": "form",
      "body": {
        "k": "{{ credentials.api_key }}",
        "m": "{{ inputs.message }}",
        "t": "{{ inputs.title }}",
        "d": "{{ inputs.device }}",
        "s": "{{ inputs.sound }}",
        "i": "{{ inputs.icon }}",
        "c": "{{ inputs.color }}",
        "u": "{{ inputs.url }}",
        "ut": "{{ inputs.url_title }}",
        "pr": "{{ inputs.priority }}"
      },
      "error_path": "error",
      "inputs": [
        { "key": "message", "label": "Message", "type": "text", "required": true },
        { "key": "title", "label": "Title", "type": "string" },
        { "key": "device", "label": "Device or group ID", "type": "string", "help": "Empty or \"a\" sends to all devices." },
        { "key": "sound", "label": "Sound number", "type": "number" },
        { "key": "icon", "label": "Icon number", "type": "number" },
        { "key": "color", "label": "Icon colour (hex)", "type": "string", "placeholder": "#FF0000" },
        { "key": "url", "label": "URL", "type": "string" },
        { "key": "url_title", "label": "URL title", "type": "string" },
        { "key": "priority", "label": "Priority", "type": "select", "options": [
          { "value": "", "label": "Device default" }, { "value": "-2", "label": "Lowest" }, { "value": "-1", "label": "Low" },
          { "value": "0", "label": "Normal" }, { "value": "1", "label": "High" }, { "value": "2", "label": "Highest" }
        ] }
      ]
    }
  ]
}
