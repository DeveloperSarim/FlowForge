{
  "key": "agile_crm",
  "name": "Agile CRM",
  "category": "CRM & Sales",
  "description": "Create and look up contacts in Agile CRM.",
  "brand": "agilecrm",
  "website": "https://www.agilecrm.com",
  "docs_url": "https://github.com/agilecrm/rest-api",
  "base_url": "https://{{ credentials.domain }}.agilecrm.com/dev/api",
  "auth": [
    {
      "type": "basic",
      "fields": [
        {
          "key": "domain",
          "label": "Domain",
          "type": "string",
          "required": true,
          "placeholder": "yourcompany",
          "help": "The part before .agilecrm.com."
        },
        {
          "key": "username",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "password",
          "label": "REST API key",
          "type": "password",
          "required": true,
          "help": "Admin settings > Developers & API."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "create_contact",
      "name": "Create contact",
      "method": "POST",
      "endpoint": "/contacts",
      "body": {
        "tags": "{{ inputs.tags }}",
        "properties": [
          {
            "type": "SYSTEM",
            "name": "email",
            "value": "{{ inputs.email }}"
          },
          {
            "type": "SYSTEM",
            "name": "first_name",
            "value": "{{ inputs.first_name }}"
          },
          {
            "type": "SYSTEM",
            "name": "last_name",
            "value": "{{ inputs.last_name }}"
          }
        ]
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "first_name",
          "label": "First name",
          "type": "string",
          "required": true
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string",
          "required": true
        },
        {
          "key": "tags",
          "label": "Tags",
          "type": "list"
        }
      ]
    },
    {
      "key": "get_contact_by_email",
      "name": "Find contact by email",
      "method": "GET",
      "endpoint": "/contacts/search/email/{{ inputs.email }}",
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "get_contact",
      "name": "Get contact",
      "method": "GET",
      "endpoint": "/contacts/{{ inputs.contact_id }}",
      "inputs": [
        {
          "key": "contact_id",
          "label": "Contact ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
