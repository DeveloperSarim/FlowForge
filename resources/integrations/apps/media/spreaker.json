{
  "key": "spreaker",
  "name": "Spreaker",
  "category": "Video & Media",
  "description": "Read your Spreaker profile, shows and episodes.",
  "brand": "spreaker",
  "website": "https://www.spreaker.com",
  "docs_url": "https://developers.spreaker.com/api/",
  "base_url": "https://api.spreaker.com/v2",
  "auth": [
    { "type": "oauth2", "authorize_url": "https://www.spreaker.com/oauth2/authorize", "token_url": "https://api.spreaker.com/oauth2/token", "scopes": ["basic"] },
    { "type": "bearer", "fields": [{ "key": "token", "label": "Access token", "type": "password", "required": true }] }
  ],
  "actions": [
    {
      "key": "get_me",
      "name": "Get my profile",
      "method": "GET",
      "endpoint": "/me",
      "output_path": "response.user",
      "inputs": []
    },
    {
      "key": "list_user_shows",
      "name": "List a user's shows",
      "method": "GET",
      "endpoint": "/users/{{ inputs.user_id }}/shows",
      "output_path": "response",
      "inputs": [{ "key": "user_id", "label": "User ID", "type": "string", "required": true }]
    },
    {
      "key": "get_show",
      "name": "Get show",
      "method": "GET",
      "endpoint": "/shows/{{ inputs.show_id }}",
      "output_path": "response.show",
      "inputs": [{ "key": "show_id", "label": "Show ID", "type": "string", "required": true }]
    },
    {
      "key": "list_show_episodes",
      "name": "List show episodes",
      "method": "GET",
      "endpoint": "/shows/{{ inputs.show_id }}/episodes",
      "output_path": "response",
      "inputs": [{ "key": "show_id", "label": "Show ID", "type": "string", "required": true }]
    },
    {
      "key": "get_episode",
      "name": "Get episode",
      "method": "GET",
      "endpoint": "/episodes/{{ inputs.episode_id }}",
      "output_path": "response.episode",
      "inputs": [{ "key": "episode_id", "label": "Episode ID", "type": "string", "required": true }]
    }
  ]
}
