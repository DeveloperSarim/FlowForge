{
  "key": "craftmypdf",
  "name": "CraftMyPDF",
  "category": "Files & Documents",
  "description": "Generate PDFs from drag-and-drop templates and JSON data.",
  "brand": "craftmypdf",
  "website": "https://craftmypdf.com",
  "docs_url": "https://craftmypdf.com/docs/index.html",
  "base_url": "https://api.craftmypdf.com/v1",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "X-API-KEY"
    }
  ],
  "actions": [
    {
      "key": "create_pdf",
      "name": "Create PDF",
      "method": "POST",
      "endpoint": "/create",
      "body": {
        "template_id": "{{ inputs.template_id }}",
        "data": "{{ inputs.data }}",
        "export_type": "json",
        "expiration": "{{ inputs.expiration }}",
        "output_file": "{{ inputs.output_file }}"
      },
      "output_fields": {
        "url": "file"
      },
      "inputs": [
        {
          "key": "template_id",
          "label": "Template ID",
          "type": "string",
          "required": true
        },
        {
          "key": "data",
          "label": "Data (JSON)",
          "type": "json",
          "required": true
        },
        {
          "key": "output_file",
          "label": "File name",
          "type": "string",
          "placeholder": "invoice.pdf"
        },
        {
          "key": "expiration",
          "label": "Link expires after (minutes)",
          "type": "number",
          "default": 60
        }
      ]
    },
    {
      "key": "list_templates",
      "name": "List templates",
      "method": "GET",
      "endpoint": "/list-templates",
      "query": {
        "limit": "{{ inputs.limit }}"
      },
      "inputs": [
        {
          "key": "limit",
          "label": "Max results",
          "type": "number",
          "default": 100
        }
      ]
    }
  ]
}
