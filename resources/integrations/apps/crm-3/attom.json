{
  "key": "attom",
  "name": "ATTOM",
  "category": "CRM & Sales",
  "description": "Look up US property details, owners, sales and value estimates for real-estate leads.",
  "website": "https://www.attomdata.com",
  "docs_url": "https://api.developer.attomdata.com/docs",
  "base_url": "https://api.gateway.attomdata.com/propertyapi/v1.0.0",
  "headers": {
    "Accept": "application/json"
  },
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "APIKey",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Sign in at developer.attomdata.com, open your app and copy the API key."
      }
    ]
  },
  "actions": [
    {
      "key": "property_by_address",
      "name": "Find property by address",
      "description": "Finds a property and its ATTOM ID.",
      "method": "GET",
      "endpoint": "/property/address",
      "query": {
        "address1": "{{ inputs.address1 }}",
        "address2": "{{ inputs.address2 }}"
      },
      "output_fields": {
        "attom_id": "property.0.identifier.attomId",
        "address": "property.0.address.oneLine",
        "status_code": "status.code"
      },
      "inputs": [
        {
          "key": "address1",
          "label": "Street address",
          "type": "string",
          "required": true,
          "placeholder": "468 Sequoia Dr"
        },
        {
          "key": "address2",
          "label": "City, State ZIP",
          "type": "string",
          "required": true,
          "placeholder": "Smyrna, DE 19977"
        }
      ]
    },
    {
      "key": "property_detail",
      "name": "Property details",
      "description": "Gets size, rooms, year built, owner and last sale for an address.",
      "method": "GET",
      "endpoint": "/property/detail",
      "query": {
        "address1": "{{ inputs.address1 }}",
        "address2": "{{ inputs.address2 }}"
      },
      "output_fields": {
        "property": "property.0",
        "attom_id": "property.0.identifier.attomId",
        "bedrooms": "property.0.building.rooms.beds",
        "year_built": "property.0.summary.yearbuilt",
        "status_code": "status.code"
      },
      "inputs": [
        {
          "key": "address1",
          "label": "Street address",
          "type": "string",
          "required": true,
          "placeholder": "468 Sequoia Dr"
        },
        {
          "key": "address2",
          "label": "City, State ZIP",
          "type": "string",
          "required": true,
          "placeholder": "Smyrna, DE 19977"
        }
      ]
    },
    {
      "key": "home_value",
      "name": "Home value estimate",
      "description": "Gets ATTOM's automated value (AVM) for an address.",
      "method": "GET",
      "endpoint": "/attomavm/detail",
      "query": {
        "address1": "{{ inputs.address1 }}",
        "address2": "{{ inputs.address2 }}"
      },
      "output_fields": {
        "property": "property.0",
        "value": "property.0.avm.amount.value",
        "value_low": "property.0.avm.amount.low",
        "value_high": "property.0.avm.amount.high",
        "status_code": "status.code"
      },
      "inputs": [
        {
          "key": "address1",
          "label": "Street address",
          "type": "string",
          "required": true,
          "placeholder": "468 Sequoia Dr"
        },
        {
          "key": "address2",
          "label": "City, State ZIP",
          "type": "string",
          "required": true,
          "placeholder": "Smyrna, DE 19977"
        }
      ]
    }
  ]
}
