{
  "key": "cloudflare_workers_ai",
  "name": "Cloudflare Workers AI",
  "category": "AI",
  "description": "Run chat and embedding models on Cloudflare's network.",
  "brand": "cloudflare",
  "website": "https://developers.cloudflare.com/workers-ai/",
  "docs_url": "https://developers.cloudflare.com/workers-ai/configuration/open-ai-compatibility/",
  "base_url": "https://api.cloudflare.com/client/v4/accounts/{{ credentials.account_id }}/ai",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "account_id",
        "label": "Account ID",
        "type": "string",
        "required": true,
        "help": "Dashboard → Account home → Account ID."
      },
      {
        "key": "token",
        "label": "API token",
        "type": "password",
        "required": true,
        "help": "Needs the Workers AI permission."
      }
    ]
  },
  "actions": [
    {
      "key": "chat_completion",
      "name": "Chat completion",
      "description": "Send a prompt and get the reply as {{ steps.<id>.text }}.",
      "method": "POST",
      "endpoint": "/v1/chat/completions",
      "timeout": 300,
      "body": {
        "model": "{{ inputs.model }}",
        "messages": [
          {
            "role": "system",
            "content": "{{ inputs.system }}"
          },
          {
            "role": "user",
            "content": "{{ inputs.prompt }}"
          }
        ],
        "temperature": "{{ inputs.temperature }}",
        "max_tokens": "{{ inputs.max_tokens }}"
      },
      "output_fields": {
        "text": "choices.0.message.content"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "default": "@cf/meta/llama-3.1-8b-instruct"
        },
        {
          "key": "prompt",
          "label": "Prompt",
          "type": "text",
          "required": true
        },
        {
          "key": "system",
          "label": "System prompt",
          "type": "text",
          "required": true,
          "default": "You are a helpful assistant.",
          "help": "Sent as the system message."
        },
        {
          "key": "temperature",
          "label": "Temperature",
          "type": "number",
          "placeholder": "0.7"
        },
        {
          "key": "max_tokens",
          "label": "Max output tokens",
          "type": "number"
        }
      ]
    },
    {
      "key": "create_embedding",
      "name": "Create embedding",
      "description": "Turn text into a vector, available as {{ steps.<id>.embedding }}.",
      "method": "POST",
      "endpoint": "/v1/embeddings",
      "body": {
        "model": "{{ inputs.model }}",
        "input": "{{ inputs.input }}"
      },
      "output_fields": {
        "embedding": "data.0.embedding"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "default": "@cf/baai/bge-large-en-v1.5"
        },
        {
          "key": "input",
          "label": "Text",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "key": "search_models",
      "name": "Search models",
      "method": "GET",
      "endpoint": "/models/search",
      "query": {
        "search": "{{ inputs.search }}",
        "task": "{{ inputs.task }}"
      },
      "output_path": "result",
      "inputs": [
        {
          "key": "search",
          "label": "Search",
          "type": "string"
        },
        {
          "key": "task",
          "label": "Task",
          "type": "string",
          "placeholder": "Text Generation"
        }
      ]
    }
  ]
}
