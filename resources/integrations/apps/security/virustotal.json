{
  "key": "virustotal",
  "name": "VirusTotal",
  "category": "Security & IT",
  "description": "Scan URLs and look up file hashes, domains and IP addresses.",
  "brand": "virustotal",
  "website": "https://www.virustotal.com",
  "docs_url": "https://docs.virustotal.com/reference/overview",
  "popular": true,
  "base_url": "https://www.virustotal.com/api/v3",
  "auth": { "type": "api_key", "in": "header", "name": "x-apikey", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true, "help": "Your profile → API key." }
  ] },
  "actions": [
    {
      "key": "scan_url",
      "name": "Scan URL",
      "description": "Submits a URL; poll Get analysis with the returned ID.",
      "method": "POST",
      "endpoint": "/urls",
      "body_format": "form",
      "body": { "url": "{{ inputs.url }}" },
      "output_path": "data",
      "inputs": [{ "key": "url", "label": "URL", "type": "string", "required": true }]
    },
    {
      "key": "get_analysis",
      "name": "Get analysis",
      "method": "GET",
      "endpoint": "/analyses/{{ inputs.analysis_id }}",
      "output_path": "data",
      "inputs": [{ "key": "analysis_id", "label": "Analysis ID", "type": "string", "required": true }]
    },
    {
      "key": "get_file_report",
      "name": "Get file report",
      "method": "GET",
      "endpoint": "/files/{{ inputs.hash }}",
      "output_path": "data",
      "inputs": [{ "key": "hash", "label": "File hash", "type": "string", "required": true, "help": "MD5, SHA-1 or SHA-256." }]
    },
    {
      "key": "get_url_report",
      "name": "Get URL report",
      "method": "GET",
      "endpoint": "/urls/{{ inputs.url_id }}",
      "output_path": "data",
      "inputs": [{ "key": "url_id", "label": "URL identifier", "type": "string", "required": true, "help": "SHA-256 of the URL, or the URL in unpadded base64url." }]
    },
    {
      "key": "get_domain_report",
      "name": "Get domain report",
      "method": "GET",
      "endpoint": "/domains/{{ inputs.domain }}",
      "output_path": "data",
      "inputs": [{ "key": "domain", "label": "Domain", "type": "string", "required": true, "placeholder": "example.com" }]
    },
    {
      "key": "get_ip_report",
      "name": "Get IP address report",
      "method": "GET",
      "endpoint": "/ip_addresses/{{ inputs.ip }}",
      "output_path": "data",
      "inputs": [{ "key": "ip", "label": "IP address", "type": "string", "required": true }]
    }
  ]
}
