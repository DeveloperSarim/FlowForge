{
  "key": "tutor_lms",
  "name": "Tutor LMS",
  "category": "Education",
  "description": "List Tutor LMS courses and enroll students (Pro).",
  "brand": "tutorlms",
  "website": "https://tutorlms.com",
  "docs_url": "https://docs.themeum.com/tutor-lms/",
  "base_url": "{{ credentials.site_url }}/wp-json/tutor/v1",
  "auth": [
    {
      "type": "basic",
      "fields": [
        {
          "key": "site_url",
          "label": "WordPress site URL",
          "type": "string",
          "required": true,
          "placeholder": "https://academy.example.com",
          "help": "No trailing slash."
        },
        {
          "key": "username",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Tutor LMS > Tools > Rest API > Add new (v2.6+)."
        },
        {
          "key": "password",
          "label": "API secret",
          "type": "password",
          "required": true
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_courses",
      "name": "List courses",
      "method": "GET",
      "endpoint": "/courses",
      "inputs": []
    },
    {
      "key": "get_course",
      "name": "Get course",
      "method": "GET",
      "endpoint": "/courses/{{ inputs.course_id }}",
      "inputs": [
        {
          "key": "course_id",
          "label": "Course ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "enroll_student",
      "name": "Enroll student (Pro)",
      "method": "POST",
      "endpoint": "/enrollments",
      "body": {
        "user_id": "{{ inputs.user_id }}",
        "course_id": "{{ inputs.course_id }}"
      },
      "inputs": [
        {
          "key": "user_id",
          "label": "User ID",
          "type": "number",
          "required": true
        },
        {
          "key": "course_id",
          "label": "Course ID",
          "type": "number",
          "required": true
        }
      ]
    },
    {
      "key": "list_student_courses",
      "name": "List student courses",
      "method": "GET",
      "endpoint": "/students/{{ inputs.student_id }}/courses",
      "inputs": [
        {
          "key": "student_id",
          "label": "Student ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
