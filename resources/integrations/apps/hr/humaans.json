{
  "key": "humaans",
  "name": "Humaans",
  "category": "HR & Recruiting",
  "description": "List and read employee profiles in Humaans.",
  "brand": "humaans",
  "website": "https://humaans.io",
  "docs_url": "https://docs.humaans.io/api/",
  "base_url": "https://app.humaans.io/api",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "API access token",
          "type": "password",
          "required": true,
          "help": "Settings > API access tokens."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_people",
      "name": "List people",
      "method": "GET",
      "endpoint": "/people",
      "query": {
        "email": "{{ inputs.email }}",
        "$limit": "{{ inputs.limit }}"
      },
      "output_path": "data",
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string"
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 100
        }
      ]
    },
    {
      "key": "get_person",
      "name": "Get person",
      "method": "GET",
      "endpoint": "/people/{{ inputs.person_id }}",
      "inputs": [
        {
          "key": "person_id",
          "label": "Person ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
