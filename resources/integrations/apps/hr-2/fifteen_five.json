{
  "key": "fifteen_five",
  "name": "15Five",
  "category": "HR & Recruiting",
  "description": "List users, check-ins and High Fives, and send High Fives in 15Five.",
  "brand": "15five",
  "website": "https://www.15five.com",
  "docs_url": "https://my.15five.com/api/public/",
  "base_url": "https://my.15five.com/api/public",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "Authorization",
      "fields": [
        {
          "key": "api_key",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Settings > Integrations > API keys (admin)."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_users",
      "name": "List users",
      "method": "GET",
      "endpoint": "/user/",
      "inputs": []
    },
    {
      "key": "get_user",
      "name": "Get user",
      "method": "GET",
      "endpoint": "/user/{{ inputs.user_id }}/",
      "inputs": [
        {
          "key": "user_id",
          "label": "User ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_reports",
      "name": "List check-ins",
      "method": "GET",
      "endpoint": "/report/",
      "inputs": []
    },
    {
      "key": "list_high_fives",
      "name": "List High Fives",
      "method": "GET",
      "endpoint": "/high-five/",
      "inputs": []
    },
    {
      "key": "create_high_five",
      "name": "Send High Five",
      "method": "POST",
      "endpoint": "/high-five/",
      "body": {
        "creator_id": "{{ inputs.creator_id }}",
        "text": "{{ inputs.text }}"
      },
      "inputs": [
        {
          "key": "creator_id",
          "label": "Sender user ID",
          "type": "string",
          "required": true
        },
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "required": true,
          "help": "Mention people with @first.last."
        }
      ]
    }
  ]
}
