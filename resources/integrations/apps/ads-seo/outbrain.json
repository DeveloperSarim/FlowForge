{
  "key": "outbrain",
  "name": "Outbrain",
  "category": "Ads & SEO",
  "description": "List marketers and campaigns and turn Outbrain Amplify campaigns on or off.",
  "brand": "outbrain",
  "website": "https://www.outbrain.com",
  "docs_url": "https://amplifyv01.docs.apiary.io/",
  "base_url": "https://api.outbrain.com/amplify/v0.1",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "OB-TOKEN-V1",
    "fields": [{ "key": "api_key", "label": "OB-TOKEN-V1 token", "type": "password", "required": true,
      "help": "Call GET https://api.outbrain.com/amplify/v0.1/login with your Outbrain username/password (Basic auth). The token lasts 30 days." }]
  },
  "actions": [
    {
      "key": "list_marketers",
      "name": "List marketers",
      "method": "GET",
      "endpoint": "/marketers",
      "output_path": "marketers",
      "inputs": []
    },
    {
      "key": "list_campaigns",
      "name": "List campaigns",
      "method": "GET",
      "endpoint": "/marketers/{{ inputs.marketer_id }}/campaigns",
      "output_path": "campaigns",
      "inputs": [{ "key": "marketer_id", "label": "Marketer ID", "type": "string", "required": true }]
    },
    {
      "key": "get_campaign",
      "name": "Get campaign",
      "method": "GET",
      "endpoint": "/campaigns/{{ inputs.campaign_id }}",
      "inputs": [{ "key": "campaign_id", "label": "Campaign ID", "type": "string", "required": true }]
    },
    {
      "key": "set_campaign_enabled",
      "name": "Enable or pause campaign",
      "method": "PUT",
      "endpoint": "/campaigns/{{ inputs.campaign_id }}",
      "body": { "enabled": "{{ inputs.enabled }}" },
      "inputs": [
        { "key": "campaign_id", "label": "Campaign ID", "type": "string", "required": true },
        { "key": "enabled", "label": "Enabled", "type": "boolean", "required": true, "default": true }
      ]
    }
  ]
}
