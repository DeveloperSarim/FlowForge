{
  "key": "scrapingdog",
  "name": "Scrapingdog",
  "category": "Ads & SEO",
  "description": "Scrape any web page through rotating proxies or get Google results as JSON.",
  "brand": "scrapingdog",
  "website": "https://www.scrapingdog.com",
  "docs_url": "https://docs.scrapingdog.com/",
  "base_url": "https://api.scrapingdog.com",
  "auth": { "type": "api_key", "in": "query", "name": "api_key" },
  "actions": [
    {
      "key": "google_search",
      "name": "Search Google",
      "method": "GET",
      "endpoint": "/google",
      "query": { "query": "{{ inputs.query }}", "results": "{{ inputs.results }}", "country": "{{ inputs.country }}", "page": "{{ inputs.page }}" },
      "timeout": 60,
      "inputs": [
        { "key": "query", "label": "Search query", "type": "string", "required": true },
        { "key": "results", "label": "Results (max 100)", "type": "number", "default": 10 },
        { "key": "country", "label": "Country code", "type": "string", "placeholder": "us" },
        { "key": "page", "label": "Page (0-based)", "type": "number", "default": 0 }
      ]
    },
    {
      "key": "scrape",
      "name": "Scrape page",
      "description": "Returns the page HTML.",
      "method": "GET",
      "endpoint": "/scrape",
      "query": { "url": "{{ inputs.url }}", "dynamic": "{{ inputs.dynamic }}" },
      "timeout": 90,
      "inputs": [
        { "key": "url", "label": "URL", "type": "string", "required": true },
        { "key": "dynamic", "label": "Render JavaScript", "type": "select", "default": "false", "options": [
          { "value": "false", "label": "No (1 credit)" }, { "value": "true", "label": "Yes (headless browser)" }
        ] }
      ]
    }
  ]
}
