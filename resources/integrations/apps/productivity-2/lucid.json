{
  "key": "lucid",
  "name": "Lucid",
  "category": "Productivity",
  "description": "Search, read and create Lucidchart and Lucidspark documents.",
  "brand": "lucid",
  "website": "https://lucid.co",
  "docs_url": "https://developer.lucid.co/reference/overview",
  "base_url": "https://api.lucid.co",
  "headers": {
    "Lucid-Api-Version": "1"
  },
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Admin > App integration > API keys."
        }
      ]
    },
    {
      "type": "oauth2",
      "authorize_url": "https://lucid.app/oauth2/authorize",
      "token_url": "https://api.lucid.co/oauth2/token",
      "scopes": [
        "lucidchart.document.content",
        "lucidspark.document.content",
        "offline_access"
      ]
    }
  ],
  "actions": [
    {
      "key": "search_documents",
      "name": "Search documents",
      "method": "POST",
      "endpoint": "/documents/search",
      "body": {
        "keywords": "{{ inputs.keywords }}",
        "product": "{{ inputs.product }}",
        "lastModifiedAfter": "{{ inputs.last_modified_after }}",
        "excludeTrashed": "{{ inputs.exclude_trashed }}"
      },
      "inputs": [
        {
          "key": "keywords",
          "label": "Keywords",
          "type": "string"
        },
        {
          "key": "product",
          "label": "Products",
          "type": "list",
          "placeholder": "lucidchart",
          "help": "lucidchart, lucidspark and/or lucidscale."
        },
        {
          "key": "last_modified_after",
          "label": "Modified after",
          "type": "string",
          "placeholder": "2026-10-01T00:00:00Z"
        },
        {
          "key": "exclude_trashed",
          "label": "Exclude trashed",
          "type": "boolean"
        }
      ]
    },
    {
      "key": "get_document",
      "name": "Get document",
      "method": "GET",
      "endpoint": "/documents/{{ inputs.document_id }}",
      "inputs": [
        {
          "key": "document_id",
          "label": "Document ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "create_document",
      "name": "Create document",
      "method": "POST",
      "endpoint": "/documents",
      "body": {
        "title": "{{ inputs.title }}",
        "product": "{{ inputs.product }}",
        "parent": "{{ inputs.parent }}"
      },
      "inputs": [
        {
          "key": "title",
          "label": "Title",
          "type": "string",
          "required": true
        },
        {
          "key": "product",
          "label": "Product",
          "type": "select",
          "required": true,
          "default": "lucidchart",
          "options": [
            {
              "value": "lucidchart",
              "label": "Lucidchart"
            },
            {
              "value": "lucidspark",
              "label": "Lucidspark"
            }
          ]
        },
        {
          "key": "parent",
          "label": "Folder ID",
          "type": "number"
        }
      ]
    }
  ]
}
