{
  "key": "baremetrics",
  "name": "Baremetrics",
  "category": "Analytics",
  "description": "Read SaaS metrics like MRR and churn, plus sources and customers.",
  "brand": "baremetrics",
  "website": "https://baremetrics.com",
  "docs_url": "https://developers.baremetrics.com/reference",
  "base_url": "https://api.baremetrics.com/v1",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "Live API key",
        "type": "password",
        "required": true,
        "help": "Settings > API."
      }
    ]
  },
  "actions": [
    {
      "key": "get_account",
      "name": "Get account",
      "method": "GET",
      "endpoint": "/account",
      "output_path": "account",
      "inputs": []
    },
    {
      "key": "list_sources",
      "name": "List sources",
      "method": "GET",
      "endpoint": "/sources",
      "output_path": "sources",
      "inputs": []
    },
    {
      "key": "get_summary",
      "name": "Get metrics summary",
      "description": "All headline metrics (MRR, ARR, churn, LTV...) per day in a range.",
      "method": "GET",
      "endpoint": "/metrics",
      "query": {
        "start_date": "{{ inputs.start_date }}",
        "end_date": "{{ inputs.end_date }}"
      },
      "inputs": [
        {
          "key": "start_date",
          "label": "Start (YYYY-MM-DD)",
          "type": "string",
          "required": true
        },
        {
          "key": "end_date",
          "label": "End (YYYY-MM-DD)",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "get_metric",
      "name": "Get metric",
      "method": "GET",
      "endpoint": "/metrics/{{ inputs.metric }}",
      "query": {
        "start_date": "{{ inputs.start_date }}",
        "end_date": "{{ inputs.end_date }}"
      },
      "inputs": [
        {
          "key": "metric",
          "label": "Metric",
          "type": "string",
          "required": true,
          "placeholder": "mrr",
          "help": "e.g. mrr, arr, ltv, arpu, user_churn, revenue_churn, active_customers, net_revenue"
        },
        {
          "key": "start_date",
          "label": "Start (YYYY-MM-DD)",
          "type": "string",
          "required": true
        },
        {
          "key": "end_date",
          "label": "End (YYYY-MM-DD)",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_customers",
      "name": "List customers",
      "method": "GET",
      "endpoint": "/{{ inputs.source_id }}/customers",
      "output_path": "customers",
      "inputs": [
        {
          "key": "source_id",
          "label": "Source ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
