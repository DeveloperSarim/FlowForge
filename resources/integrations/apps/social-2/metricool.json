{
  "key": "metricool",
  "name": "Metricool",
  "category": "Social Media",
  "description": "List your Metricool brands; schedule posts and pull analytics via API calls.",
  "brand": "metricool",
  "website": "https://metricool.com",
  "docs_url": "https://app.metricool.com/resources/apidocs/index.html",
  "base_url": "https://app.metricool.com/api",
  "auth": { "type": "api_key", "in": "header", "name": "X-Mc-Auth", "fields": [
    { "key": "api_key", "label": "API token", "type": "password", "required": true, "help": "Account settings > API (Advanced/Custom plans)." },
    { "key": "user_id", "label": "User ID", "type": "string", "required": true, "help": "userId in the app URL. Every request also needs blogId (the brand)." }
  ] },
  "actions": [
    {
      "key": "list_brands",
      "name": "List brands",
      "description": "Brands you manage, each with its blogId.",
      "method": "GET",
      "endpoint": "/admin/simpleProfiles",
      "query": { "userId": "{{ credentials.user_id }}" },
      "inputs": []
    }
  ]
}
