{
  "key": "feathery",
  "name": "Feathery",
  "category": "Forms & Surveys",
  "description": "Read Feathery forms and submissions, and manage the people who fill them in.",
  "website": "https://www.feathery.io",
  "docs_url": "https://docs.feathery.io/api-reference",
  "base_url": "https://api.feathery.io/api",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "Authorization",
    "prefix": "Token ",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Feathery > Settings > API Keys: copy your key."
      }
    ]
  },
  "actions": [
    {
      "key": "list_forms",
      "name": "List forms",
      "description": "Get your Feathery forms.",
      "method": "GET",
      "endpoint": "/form/",
      "inputs": []
    },
    {
      "key": "list_submissions",
      "name": "List submissions",
      "description": "Get submissions of a form.",
      "method": "GET",
      "endpoint": "/form/submission/",
      "query": {
        "form_id": "{{ inputs.form_id }}",
        "start_time": "{{ inputs.start_time }}"
      },
      "inputs": [
        {
          "key": "form_id",
          "label": "Form ID",
          "type": "string",
          "required": true,
          "help": "Open the form in Feathery; the ID is in the address."
        },
        {
          "key": "start_time",
          "label": "From date",
          "type": "string",
          "help": "ISO date, e.g. 2025-01-31T00:00:00Z."
        }
      ]
    },
    {
      "key": "list_users",
      "name": "List users",
      "description": "Get the people who have started a form.",
      "method": "GET",
      "endpoint": "/user/",
      "inputs": []
    }
  ]
}
