{
  "key": "flowise",
  "name": "Flowise",
  "category": "AI",
  "description": "Send messages to Flowise chatflows and agentflows.",
  "brand": "flowise",
  "website": "https://flowiseai.com",
  "docs_url": "https://docs.flowiseai.com/api-reference/prediction",
  "base_url": "{{ credentials.base_url }}/api/v1",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "base_url",
        "label": "Flowise URL",
        "type": "string",
        "required": true,
        "default": "https://cloud.flowiseai.com",
        "help": "Your Flowise Cloud or self-hosted URL, without a trailing slash."
      },
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Flowise → API Keys (only checked if the flow is protected)."
      }
    ]
  },
  "actions": [
    {
      "key": "predict",
      "name": "Send message",
      "description": "The reply is {{ steps.<id>.text }}.",
      "method": "POST",
      "endpoint": "/prediction/{{ inputs.flow_id }}",
      "timeout": 300,
      "body": {
        "question": "{{ inputs.question }}",
        "overrideConfig": "{{ inputs.override_config }}"
      },
      "inputs": [
        {
          "key": "flow_id",
          "label": "Flow ID",
          "type": "string",
          "required": true
        },
        {
          "key": "question",
          "label": "Message",
          "type": "text",
          "required": true
        },
        {
          "key": "override_config",
          "label": "Override config (JSON)",
          "type": "json",
          "placeholder": "{\"sessionId\": \"user-123\"}"
        }
      ]
    }
  ]
}
