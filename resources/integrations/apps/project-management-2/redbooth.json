{
  "key": "redbooth",
  "name": "Redbooth",
  "category": "Project Management",
  "description": "Create Redbooth tasks, list projects and tasks, and comment.",
  "brand": "redbooth",
  "website": "https://redbooth.com",
  "docs_url": "https://redbooth.com/api/",
  "base_url": "https://redbooth.com/api/3",
  "auth": [
    {
      "type": "oauth2",
      "authorize_url": "https://redbooth.com/oauth2/authorize",
      "token_url": "https://redbooth.com/oauth2/token",
      "scopes": []
    }
  ],
  "actions": [
    {
      "key": "list_projects",
      "name": "List projects",
      "method": "GET",
      "endpoint": "/projects",
      "inputs": []
    },
    {
      "key": "list_task_lists",
      "name": "List task lists",
      "method": "GET",
      "endpoint": "/task_lists",
      "query": {
        "project_id": "{{ inputs.project_id }}"
      },
      "inputs": [
        {
          "key": "project_id",
          "label": "Project ID",
          "type": "number",
          "required": true
        }
      ]
    },
    {
      "key": "list_tasks",
      "name": "List tasks",
      "method": "GET",
      "endpoint": "/tasks",
      "query": {
        "project_id": "{{ inputs.project_id }}",
        "task_list_id": "{{ inputs.task_list_id }}"
      },
      "inputs": [
        {
          "key": "project_id",
          "label": "Project ID",
          "type": "number"
        },
        {
          "key": "task_list_id",
          "label": "Task list ID",
          "type": "number"
        }
      ]
    },
    {
      "key": "create_task",
      "name": "Create task",
      "method": "POST",
      "endpoint": "/tasks",
      "body": {
        "project_id": "{{ inputs.project_id }}",
        "task_list_id": "{{ inputs.task_list_id }}",
        "name": "{{ inputs.name }}",
        "description": "{{ inputs.description }}",
        "due_on": "{{ inputs.due_on }}"
      },
      "inputs": [
        {
          "key": "project_id",
          "label": "Project ID",
          "type": "number",
          "required": true
        },
        {
          "key": "task_list_id",
          "label": "Task list ID",
          "type": "number",
          "required": true
        },
        {
          "key": "name",
          "label": "Name",
          "type": "string",
          "required": true
        },
        {
          "key": "description",
          "label": "Description",
          "type": "text"
        },
        {
          "key": "due_on",
          "label": "Due date",
          "type": "string",
          "placeholder": "2026-10-20"
        }
      ]
    },
    {
      "key": "add_comment",
      "name": "Comment on task",
      "method": "POST",
      "endpoint": "/comments",
      "body": {
        "target_type": "Task",
        "target_id": "{{ inputs.task_id }}",
        "body": "{{ inputs.body }}"
      },
      "inputs": [
        {
          "key": "task_id",
          "label": "Task ID",
          "type": "number",
          "required": true
        },
        {
          "key": "body",
          "label": "Comment",
          "type": "text",
          "required": true
        }
      ]
    }
  ]
}
