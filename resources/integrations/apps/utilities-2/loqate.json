{
  "key": "loqate",
  "name": "Loqate",
  "category": "Utilities",
  "description": "Search and retrieve full, formatted addresses worldwide.",
  "brand": "loqate",
  "website": "https://www.loqate.com",
  "docs_url": "https://docs.loqate.com/api-reference/introduction",
  "base_url": "https://api.addressy.com",
  "auth": { "type": "api_key", "in": "query", "name": "Key", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true, "placeholder": "AA11-AA11-AA11-AA11" }
  ] },
  "actions": [
    {
      "key": "find_address",
      "name": "Find addresses",
      "description": "Returns matches; items of Type \"Address\" can be retrieved, others are containers to search inside.",
      "method": "GET",
      "endpoint": "/Capture/Interactive/Find/v1.10/json3.ws",
      "query": { "Text": "{{ inputs.text }}", "Container": "{{ inputs.container }}", "Countries": "{{ inputs.countries }}", "Limit": "{{ inputs.limit }}", "Language": "{{ inputs.language }}" },
      "error_path": "Items.0.Error",
      "output_path": "Items",
      "inputs": [
        { "key": "text", "label": "Search text", "type": "string", "required": true, "placeholder": "Herons Way, Chester" },
        { "key": "container", "label": "Container ID", "type": "string", "help": "Id of a non-address result to drill into." },
        { "key": "countries", "label": "Countries", "type": "string", "placeholder": "GB,US" },
        { "key": "limit", "label": "Limit", "type": "number" },
        { "key": "language", "label": "Language", "type": "string", "placeholder": "en" }
      ]
    },
    {
      "key": "retrieve_address",
      "name": "Retrieve address",
      "method": "GET",
      "endpoint": "/Capture/Interactive/Retrieve/v1.20/json3.ws",
      "query": { "Id": "{{ inputs.id }}" },
      "error_path": "Items.0.Error",
      "output_path": "Items",
      "inputs": [{ "key": "id", "label": "Address ID", "type": "string", "required": true, "help": "Id of an Address item from Find addresses." }]
    }
  ]
}
