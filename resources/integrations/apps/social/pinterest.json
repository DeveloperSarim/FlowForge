{
  "key": "pinterest",
  "name": "Pinterest",
  "category": "Social Media",
  "description": "Create pins and boards and list board pins.",
  "brand": "pinterest",
  "website": "https://www.pinterest.com",
  "docs_url": "https://developers.pinterest.com/docs/api/v5/",
  "base_url": "https://api.pinterest.com/v5",
  "auth": { "type": "bearer", "fields": [{ "key": "token", "label": "Access token", "type": "password", "required": true,
    "help": "From your Pinterest app (boards:read, boards:write, pins:read, pins:write). In-app OAuth isn't offered because Pinterest's token endpoint needs Basic auth." }] },
  "actions": [
    {
      "key": "create_pin",
      "name": "Create pin",
      "method": "POST",
      "endpoint": "/pins",
      "body": {
        "board_id": "{{ inputs.board_id }}",
        "title": "{{ inputs.title }}",
        "description": "{{ inputs.description }}",
        "link": "{{ inputs.link }}",
        "alt_text": "{{ inputs.alt_text }}",
        "media_source": { "source_type": "image_url", "url": "{{ inputs.image_url }}" }
      },
      "inputs": [
        { "key": "board_id", "label": "Board ID", "type": "string", "required": true },
        { "key": "image_url", "label": "Image URL", "type": "string", "required": true },
        { "key": "title", "label": "Title", "type": "string" },
        { "key": "description", "label": "Description", "type": "text" },
        { "key": "link", "label": "Destination link", "type": "string" },
        { "key": "alt_text", "label": "Alt text", "type": "string" }
      ]
    },
    {
      "key": "get_pin",
      "name": "Get pin",
      "method": "GET",
      "endpoint": "/pins/{{ inputs.pin_id }}",
      "inputs": [{ "key": "pin_id", "label": "Pin ID", "type": "string", "required": true }]
    },
    {
      "key": "list_boards",
      "name": "List boards",
      "method": "GET",
      "endpoint": "/boards",
      "query": { "page_size": "{{ inputs.page_size }}" },
      "output_path": "items",
      "inputs": [{ "key": "page_size", "label": "Page size (1-250)", "type": "number", "default": 25 }]
    },
    {
      "key": "create_board",
      "name": "Create board",
      "method": "POST",
      "endpoint": "/boards",
      "body": { "name": "{{ inputs.name }}", "description": "{{ inputs.description }}", "privacy": "{{ inputs.privacy }}" },
      "inputs": [
        { "key": "name", "label": "Name", "type": "string", "required": true },
        { "key": "description", "label": "Description", "type": "string" },
        { "key": "privacy", "label": "Privacy", "type": "select", "default": "PUBLIC", "options": [
          { "value": "PUBLIC", "label": "Public" }, { "value": "PROTECTED", "label": "Protected" }, { "value": "SECRET", "label": "Secret" }
        ] }
      ]
    },
    {
      "key": "list_board_pins",
      "name": "List pins on board",
      "method": "GET",
      "endpoint": "/boards/{{ inputs.board_id }}/pins",
      "query": { "page_size": "{{ inputs.page_size }}" },
      "output_path": "items",
      "inputs": [
        { "key": "board_id", "label": "Board ID", "type": "string", "required": true },
        { "key": "page_size", "label": "Page size (1-250)", "type": "number", "default": 25 }
      ]
    }
  ]
}
