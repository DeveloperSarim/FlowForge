{
  "key": "dixa",
  "name": "Dixa",
  "category": "Customer Support",
  "description": "Create and get end users, read conversations and add notes in Dixa.",
  "brand": "dixa",
  "website": "https://www.dixa.com",
  "docs_url": "https://docs.dixa.io/",
  "base_url": "https://dev.dixa.io/v1",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "Authorization",
    "fields": [
      {
        "key": "api_key",
        "label": "API token",
        "type": "password",
        "required": true,
        "help": "Settings > Integrations > API Tokens (Dixa API)"
      }
    ]
  },
  "actions": [
    {
      "key": "create_end_user",
      "name": "Create end user",
      "method": "POST",
      "endpoint": "/endusers",
      "output_path": "data",
      "body": {
        "displayName": "{{ inputs.display_name }}",
        "email": "{{ inputs.email }}",
        "phoneNumber": "{{ inputs.phone }}",
        "externalId": "{{ inputs.external_id }}"
      },
      "inputs": [
        {
          "key": "display_name",
          "label": "Name",
          "type": "string"
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string"
        },
        {
          "key": "phone",
          "label": "Phone",
          "type": "string"
        },
        {
          "key": "external_id",
          "label": "External ID",
          "type": "string"
        }
      ]
    },
    {
      "key": "get_end_user",
      "name": "Get end user",
      "method": "GET",
      "endpoint": "/endusers/{{ inputs.user_id }}",
      "output_path": "data",
      "inputs": [
        {
          "key": "user_id",
          "label": "End user ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "get_conversation",
      "name": "Get conversation",
      "method": "GET",
      "endpoint": "/conversations/{{ inputs.conversation_id }}",
      "output_path": "data",
      "inputs": [
        {
          "key": "conversation_id",
          "label": "Conversation ID",
          "type": "number",
          "required": true
        }
      ]
    },
    {
      "key": "add_note",
      "name": "Add internal note",
      "method": "POST",
      "endpoint": "/conversations/{{ inputs.conversation_id }}/notes",
      "output_path": "data",
      "body": {
        "message": "{{ inputs.message }}"
      },
      "inputs": [
        {
          "key": "conversation_id",
          "label": "Conversation ID",
          "type": "number",
          "required": true
        },
        {
          "key": "message",
          "label": "Note",
          "type": "text",
          "required": true
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "Add this URL in Settings > Integrations > Webhooks.",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
