{
  "key": "bark",
  "name": "Bark",
  "category": "Communication",
  "description": "Send push notifications to an iPhone running the Bark app.",
  "brand": "bark",
  "website": "https://bark.day.app",
  "docs_url": "https://bark.day.app/#/en-us/tutorial",
  "base_url": "{{ credentials.server_url }}",
  "auth": [
    { "type": "api_key", "fields": [
      { "key": "server_url", "label": "Server URL", "type": "string", "required": true, "default": "https://api.day.app", "help": "The official server, or your self-hosted bark-server. No trailing slash." },
      { "key": "api_key", "label": "Device key", "type": "password", "required": true, "help": "The key in the URL shown in the Bark app." }
    ] }
  ],
  "actions": [
    {
      "key": "send_push",
      "name": "Send push notification",
      "method": "POST",
      "endpoint": "/push",
      "body": {
        "device_key": "{{ credentials.api_key }}",
        "title": "{{ inputs.title }}",
        "subtitle": "{{ inputs.subtitle }}",
        "body": "{{ inputs.body }}",
        "group": "{{ inputs.group }}",
        "url": "{{ inputs.url }}",
        "sound": "{{ inputs.sound }}",
        "icon": "{{ inputs.icon }}",
        "level": "{{ inputs.level }}"
      },
      "inputs": [
        { "key": "body", "label": "Message", "type": "text", "required": true },
        { "key": "title", "label": "Title", "type": "string" },
        { "key": "subtitle", "label": "Subtitle", "type": "string" },
        { "key": "group", "label": "Group", "type": "string" },
        { "key": "url", "label": "Open URL on tap", "type": "string" },
        { "key": "sound", "label": "Sound", "type": "string", "placeholder": "minuet" },
        { "key": "icon", "label": "Icon URL", "type": "string" },
        { "key": "level", "label": "Interruption level", "type": "select", "options": [
          { "value": "", "label": "Default (active)" }, { "value": "timeSensitive", "label": "Time sensitive" },
          { "value": "passive", "label": "Passive" }, { "value": "critical", "label": "Critical" }
        ] }
      ]
    }
  ]
}
