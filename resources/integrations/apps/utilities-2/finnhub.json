{
  "key": "finnhub",
  "name": "Finnhub",
  "category": "Utilities",
  "description": "Real-time stock quotes, company profiles, symbol search and market news.",
  "brand": "finnhub",
  "website": "https://finnhub.io",
  "docs_url": "https://finnhub.io/docs/api",
  "base_url": "https://finnhub.io/api/v1",
  "auth": { "type": "api_key", "in": "header", "name": "X-Finnhub-Token", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "quote",
      "name": "Get quote",
      "method": "GET",
      "endpoint": "/quote",
      "query": { "symbol": "{{ inputs.symbol }}" },
      "inputs": [{ "key": "symbol", "label": "Symbol", "type": "string", "required": true, "placeholder": "AAPL" }]
    },
    {
      "key": "company_profile",
      "name": "Get company profile",
      "method": "GET",
      "endpoint": "/stock/profile2",
      "query": { "symbol": "{{ inputs.symbol }}" },
      "inputs": [{ "key": "symbol", "label": "Symbol", "type": "string", "required": true }]
    },
    {
      "key": "symbol_search",
      "name": "Search symbols",
      "method": "GET",
      "endpoint": "/search",
      "query": { "q": "{{ inputs.q }}", "exchange": "{{ inputs.exchange }}" },
      "inputs": [
        { "key": "q", "label": "Query", "type": "string", "required": true, "placeholder": "apple" },
        { "key": "exchange", "label": "Exchange", "type": "string", "placeholder": "US" }
      ]
    },
    {
      "key": "company_news",
      "name": "Get company news",
      "method": "GET",
      "endpoint": "/company-news",
      "query": { "symbol": "{{ inputs.symbol }}", "from": "{{ inputs.from }}", "to": "{{ inputs.to }}" },
      "inputs": [
        { "key": "symbol", "label": "Symbol", "type": "string", "required": true },
        { "key": "from", "label": "From", "type": "string", "required": true, "placeholder": "2025-06-01" },
        { "key": "to", "label": "To", "type": "string", "required": true, "placeholder": "2025-06-07" }
      ]
    },
    {
      "key": "market_news",
      "name": "Get market news",
      "method": "GET",
      "endpoint": "/news",
      "query": { "category": "{{ inputs.category }}", "minId": "{{ inputs.min_id }}" },
      "inputs": [
        { "key": "category", "label": "Category", "type": "select", "required": true, "default": "general", "options": [
          { "value": "general", "label": "General" }, { "value": "forex", "label": "Forex" }, { "value": "crypto", "label": "Crypto" }, { "value": "merger", "label": "Mergers" }
        ] },
        { "key": "min_id", "label": "Only newer than ID", "type": "number" }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Finnhub webhook",
      "description": "Register this URL in the Finnhub dashboard (Webhooks) for earnings, news and price events.",
      "type": "webhook",
      "inputs": [{ "key": "sample_payload", "label": "Test payload (JSON)", "type": "json" }]
    }
  ]
}
