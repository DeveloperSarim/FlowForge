{
  "key": "transifex",
  "name": "Transifex",
  "category": "Utilities",
  "description": "List organizations, projects and resources and track translation progress.",
  "brand": "transifex",
  "website": "https://www.transifex.com",
  "docs_url": "https://developers.transifex.com/reference/api-introduction",
  "base_url": "https://rest.api.transifex.com",
  "headers": { "Accept": "application/vnd.api+json", "Content-Type": "application/vnd.api+json" },
  "auth": { "type": "bearer", "fields": [
    { "key": "token", "label": "API token", "type": "password", "required": true, "help": "User settings → API token." }
  ] },
  "actions": [
    {
      "key": "list_organizations",
      "name": "List organizations",
      "method": "GET",
      "endpoint": "/organizations",
      "output_path": "data",
      "inputs": []
    },
    {
      "key": "list_projects",
      "name": "List projects",
      "method": "GET",
      "endpoint": "/projects",
      "query": { "filter[organization]": "{{ inputs.organization }}" },
      "output_path": "data",
      "inputs": [{ "key": "organization", "label": "Organization ID", "type": "string", "required": true, "placeholder": "o:acme" }]
    },
    {
      "key": "list_resources",
      "name": "List resources",
      "method": "GET",
      "endpoint": "/resources",
      "query": { "filter[project]": "{{ inputs.project }}" },
      "output_path": "data",
      "inputs": [{ "key": "project", "label": "Project ID", "type": "string", "required": true, "placeholder": "o:acme:p:website" }]
    },
    {
      "key": "language_stats",
      "name": "Get translation progress",
      "description": "Translated / reviewed word and string counts per resource and language.",
      "method": "GET",
      "endpoint": "/resource_language_stats",
      "query": { "filter[project]": "{{ inputs.project }}", "filter[language]": "{{ inputs.language }}" },
      "output_path": "data",
      "inputs": [
        { "key": "project", "label": "Project ID", "type": "string", "required": true, "placeholder": "o:acme:p:website" },
        { "key": "language", "label": "Language", "type": "string", "placeholder": "l:fr" }
      ]
    }
  ]
}
