{
  "key": "serpstack",
  "name": "serpstack",
  "category": "Ads & SEO",
  "description": "Get Google search results (organic, ads, news, images) as JSON.",
  "brand": "serpstack",
  "website": "https://serpstack.com",
  "docs_url": "https://serpstack.com/documentation",
  "base_url": "https://api.serpstack.com",
  "auth": { "type": "api_key", "in": "query", "name": "access_key", "fields": [{ "key": "api_key", "label": "Access key", "type": "password", "required": true }] },
  "actions": [
    {
      "key": "search",
      "name": "Search Google",
      "method": "GET",
      "endpoint": "/search",
      "query": {
        "query": "{{ inputs.query }}",
        "type": "{{ inputs.type }}",
        "location": "{{ inputs.location }}",
        "gl": "{{ inputs.gl }}",
        "hl": "{{ inputs.hl }}",
        "device": "{{ inputs.device }}",
        "num": "{{ inputs.num }}",
        "page": "{{ inputs.page }}"
      },
      "error_path": "error",
      "inputs": [
        { "key": "query", "label": "Search query", "type": "string", "required": true },
        { "key": "type", "label": "Search type", "type": "select", "default": "web", "options": [
          { "value": "web", "label": "Web" }, { "value": "news", "label": "News" }, { "value": "images", "label": "Images" },
          { "value": "videos", "label": "Videos" }, { "value": "shopping", "label": "Shopping" }
        ] },
        { "key": "location", "label": "Location", "type": "string", "placeholder": "New York,New York,United States" },
        { "key": "gl", "label": "Country code", "type": "string", "placeholder": "us" },
        { "key": "hl", "label": "Language code", "type": "string", "placeholder": "en" },
        { "key": "device", "label": "Device", "type": "select", "default": "desktop", "options": [
          { "value": "desktop", "label": "Desktop" }, { "value": "mobile", "label": "Mobile" }, { "value": "tablet", "label": "Tablet" }
        ] },
        { "key": "num", "label": "Results per page", "type": "number", "default": 10 },
        { "key": "page", "label": "Page", "type": "number", "default": 1 }
      ]
    }
  ]
}
