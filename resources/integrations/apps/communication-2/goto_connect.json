{
  "key": "goto_connect",
  "name": "GoTo Connect",
  "category": "Communication",
  "description": "Send SMS from your GoTo Connect business phone numbers.",
  "brand": "goto",
  "website": "https://www.goto.com/connect",
  "docs_url": "https://developer.goto.com/GoToConnect",
  "base_url": "https://api.goto.com",
  "auth": [
    {
      "type": "oauth2",
      "authorize_url": "https://authentication.logmeininc.com/oauth/authorize",
      "token_url": "https://authentication.logmeininc.com/oauth/token",
      "client_auth": "basic",
      "scopes": ["messaging.v1.send"]
    }
  ],
  "actions": [
    {
      "key": "send_sms",
      "name": "Send SMS",
      "method": "POST",
      "endpoint": "/messaging/v1/messages",
      "body": {
        "ownerPhoneNumber": "{{ inputs.owner_phone_number }}",
        "contactPhoneNumbers": "{{ inputs.contact_phone_numbers }}",
        "body": "{{ inputs.body }}"
      },
      "inputs": [
        { "key": "owner_phone_number", "label": "From (your GoTo number, E.164)", "type": "string", "required": true, "placeholder": "+15145550100", "help": "Must be SMS-enabled and assigned to the authorizing user." },
        { "key": "contact_phone_numbers", "label": "To (E.164)", "type": "list", "required": true },
        { "key": "body", "label": "Message", "type": "text", "required": true }
      ]
    }
  ]
}
