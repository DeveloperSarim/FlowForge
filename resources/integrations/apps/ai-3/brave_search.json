{
  "key": "brave_search",
  "name": "Brave Search",
  "category": "AI",
  "description": "Independent web, news, image and video search results for AI apps and agents.",
  "brand": "brave",
  "website": "https://brave.com/search/api",
  "docs_url": "https://api-dashboard.search.brave.com/app/documentation",
  "base_url": "https://api.search.brave.com/res/v1",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "X-Subscription-Token",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "api-dashboard.search.brave.com → API Keys → Add API key."
      }
    ]
  },
  "actions": [
    {
      "key": "web_search",
      "name": "Web search",
      "description": "Search the web and get titles, links and snippets.",
      "method": "GET",
      "endpoint": "/web/search",
      "query": {
        "q": "{{ inputs.q }}",
        "count": "{{ inputs.count }}",
        "country": "{{ inputs.country }}",
        "search_lang": "{{ inputs.search_lang }}",
        "freshness": "{{ inputs.freshness }}",
        "safesearch": "{{ inputs.safesearch }}"
      },
      "output_fields": {
        "results": "web.results",
        "top_url": "web.results.0.url",
        "top_title": "web.results.0.title",
        "top_snippet": "web.results.0.description"
      },
      "inputs": [
        {
          "key": "q",
          "label": "Search query",
          "type": "string",
          "required": true
        },
        {
          "key": "count",
          "label": "Results",
          "type": "number",
          "default": 10
        },
        {
          "key": "country",
          "label": "Country",
          "type": "string",
          "placeholder": "US"
        },
        {
          "key": "search_lang",
          "label": "Language",
          "type": "string",
          "placeholder": "en"
        },
        {
          "key": "freshness",
          "label": "Freshness",
          "type": "select",
          "options": [
            {
              "value": "pd",
              "label": "Past day"
            },
            {
              "value": "pw",
              "label": "Past week"
            },
            {
              "value": "pm",
              "label": "Past month"
            },
            {
              "value": "py",
              "label": "Past year"
            }
          ]
        },
        {
          "key": "safesearch",
          "label": "Safe search",
          "type": "select",
          "options": [
            {
              "value": "off",
              "label": "Off"
            },
            {
              "value": "moderate",
              "label": "Moderate"
            },
            {
              "value": "strict",
              "label": "Strict"
            }
          ]
        }
      ]
    },
    {
      "key": "news_search",
      "name": "News search",
      "description": "Find recent news articles.",
      "method": "GET",
      "endpoint": "/news/search",
      "query": {
        "q": "{{ inputs.q }}",
        "count": "{{ inputs.count }}",
        "country": "{{ inputs.country }}",
        "search_lang": "{{ inputs.search_lang }}",
        "freshness": "{{ inputs.freshness }}"
      },
      "output_fields": {
        "results": "results",
        "top_url": "results.0.url"
      },
      "inputs": [
        {
          "key": "q",
          "label": "Search query",
          "type": "string",
          "required": true
        },
        {
          "key": "count",
          "label": "Results",
          "type": "number",
          "default": 10
        },
        {
          "key": "country",
          "label": "Country",
          "type": "string",
          "placeholder": "US"
        },
        {
          "key": "search_lang",
          "label": "Language",
          "type": "string",
          "placeholder": "en"
        },
        {
          "key": "freshness",
          "label": "Freshness",
          "type": "select",
          "options": [
            {
              "value": "pd",
              "label": "Past day"
            },
            {
              "value": "pw",
              "label": "Past week"
            },
            {
              "value": "pm",
              "label": "Past month"
            },
            {
              "value": "py",
              "label": "Past year"
            }
          ]
        }
      ]
    },
    {
      "key": "image_search",
      "name": "Image search",
      "description": "Find images.",
      "method": "GET",
      "endpoint": "/images/search",
      "query": {
        "q": "{{ inputs.q }}",
        "count": "{{ inputs.count }}",
        "country": "{{ inputs.country }}",
        "search_lang": "{{ inputs.search_lang }}"
      },
      "output_fields": {
        "results": "results",
        "image_urls": "results.*.properties.url"
      },
      "inputs": [
        {
          "key": "q",
          "label": "Search query",
          "type": "string",
          "required": true
        },
        {
          "key": "count",
          "label": "Results",
          "type": "number",
          "default": 10
        },
        {
          "key": "country",
          "label": "Country",
          "type": "string",
          "placeholder": "US"
        },
        {
          "key": "search_lang",
          "label": "Language",
          "type": "string",
          "placeholder": "en"
        }
      ]
    },
    {
      "key": "video_search",
      "name": "Video search",
      "description": "Find videos.",
      "method": "GET",
      "endpoint": "/videos/search",
      "query": {
        "q": "{{ inputs.q }}",
        "count": "{{ inputs.count }}",
        "country": "{{ inputs.country }}",
        "search_lang": "{{ inputs.search_lang }}",
        "freshness": "{{ inputs.freshness }}"
      },
      "output_fields": {
        "results": "results",
        "top_url": "results.0.url"
      },
      "inputs": [
        {
          "key": "q",
          "label": "Search query",
          "type": "string",
          "required": true
        },
        {
          "key": "count",
          "label": "Results",
          "type": "number",
          "default": 10
        },
        {
          "key": "country",
          "label": "Country",
          "type": "string",
          "placeholder": "US"
        },
        {
          "key": "search_lang",
          "label": "Language",
          "type": "string",
          "placeholder": "en"
        },
        {
          "key": "freshness",
          "label": "Freshness",
          "type": "select",
          "options": [
            {
              "value": "pd",
              "label": "Past day"
            },
            {
              "value": "pw",
              "label": "Past week"
            },
            {
              "value": "pm",
              "label": "Past month"
            },
            {
              "value": "py",
              "label": "Past year"
            }
          ]
        }
      ]
    }
  ]
}
