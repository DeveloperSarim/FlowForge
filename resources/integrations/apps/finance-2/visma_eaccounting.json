{
  "key": "visma_eaccounting",
  "name": "Visma eAccounting",
  "category": "Payments & Finance",
  "description": "Look up customers, customer invoices and articles in Visma eAccounting / eEkonomi.",
  "brand": "visma",
  "website": "https://www.visma.com/eaccounting",
  "docs_url": "https://developer.vismaonline.com",
  "base_url": "https://eaccountingapi.vismaonline.com/v2",
  "auth": [
    {
      "type": "oauth2",
      "authorize_url": "https://identity.vismaonline.com/connect/authorize",
      "token_url": "https://identity.vismaonline.com/connect/token",
      "client_auth": "basic",
      "scopes": [
        "ea:api",
        "offline_access",
        "ea:sales_readonly",
        "ea:accounting_readonly"
      ]
    }
  ],
  "actions": [
    {
      "key": "list_customers",
      "name": "List customers",
      "method": "GET",
      "endpoint": "/customers",
      "query": {
        "$filter": "{{ inputs.filter }}",
        "$pagesize": "{{ inputs.pagesize }}"
      },
      "output_path": "Data",
      "inputs": [
        {
          "key": "filter",
          "label": "Filter (OData)",
          "type": "string",
          "placeholder": "EmailAddress eq 'ana@example.com'"
        },
        {
          "key": "pagesize",
          "label": "Page size",
          "type": "number",
          "default": 50
        }
      ]
    },
    {
      "key": "get_customer",
      "name": "Get customer",
      "method": "GET",
      "endpoint": "/customers/{{ inputs.customer_id }}",
      "inputs": [
        {
          "key": "customer_id",
          "label": "Customer ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_customer_invoices",
      "name": "List customer invoices",
      "method": "GET",
      "endpoint": "/customerinvoices",
      "query": {
        "$filter": "{{ inputs.filter }}",
        "$orderby": "InvoiceDate desc",
        "$pagesize": "{{ inputs.pagesize }}"
      },
      "output_path": "Data",
      "inputs": [
        {
          "key": "filter",
          "label": "Filter (OData)",
          "type": "string",
          "placeholder": "CustomerId eq 'GUID'"
        },
        {
          "key": "pagesize",
          "label": "Page size",
          "type": "number",
          "default": 50
        }
      ]
    },
    {
      "key": "get_customer_invoice",
      "name": "Get customer invoice",
      "method": "GET",
      "endpoint": "/customerinvoices/{{ inputs.invoice_id }}",
      "inputs": [
        {
          "key": "invoice_id",
          "label": "Invoice ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_articles",
      "name": "List articles",
      "method": "GET",
      "endpoint": "/articles",
      "query": {
        "$filter": "{{ inputs.filter }}",
        "$pagesize": "{{ inputs.pagesize }}"
      },
      "output_path": "Data",
      "inputs": [
        {
          "key": "filter",
          "label": "Filter (OData)",
          "type": "string",
          "placeholder": "Number eq '100'"
        },
        {
          "key": "pagesize",
          "label": "Page size",
          "type": "number",
          "default": 50
        }
      ]
    }
  ]
}
