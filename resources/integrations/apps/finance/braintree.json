{
  "key": "braintree",
  "name": "Braintree",
  "category": "Payments & Finance",
  "description": "Query and mutate your Braintree gateway through its GraphQL API.",
  "brand": "braintree",
  "website": "https://www.braintreepayments.com",
  "docs_url": "https://graphql.braintreepayments.com/",
  "base_url": "https://{{ credentials.environment }}",
  "headers": {
    "Braintree-Version": "2019-01-01"
  },
  "auth": [
    {
      "type": "basic",
      "fields": [
        {
          "key": "environment",
          "label": "Environment",
          "type": "select",
          "required": true,
          "default": "payments.braintree-api.com",
          "options": [
            {
              "value": "payments.braintree-api.com",
              "label": "Production"
            },
            {
              "value": "payments.sandbox.braintree-api.com",
              "label": "Sandbox"
            }
          ]
        },
        {
          "key": "username",
          "label": "Public key",
          "type": "string",
          "required": true,
          "help": "Settings > API > API keys."
        },
        {
          "key": "password",
          "label": "Private key",
          "type": "password",
          "required": true
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "graphql",
      "name": "Run GraphQL query",
      "method": "POST",
      "endpoint": "/graphql",
      "error_path": "errors",
      "body": {
        "query": "{{ inputs.query }}",
        "variables": "{{ inputs.variables }}"
      },
      "inputs": [
        {
          "key": "query",
          "label": "Query",
          "type": "code",
          "required": true,
          "placeholder": "query { ping }"
        },
        {
          "key": "variables",
          "label": "Variables",
          "type": "json"
        }
      ]
    }
  ],
  "triggers": []
}
