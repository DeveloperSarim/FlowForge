{
  "key": "scale_serp",
  "name": "Scale SERP",
  "category": "Ads & SEO",
  "description": "Real-time Google search results: web, news, images and places.",
  "website": "https://www.scaleserp.com",
  "docs_url": "https://docs.trajectdata.com/scaleserp/search-api/overview",
  "base_url": "https://api.scaleserp.com",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "api_key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Scale SERP dashboard → copy your API key."
      }
    ]
  },
  "actions": [
    {
      "key": "search",
      "name": "Search",
      "description": "Google results for a keyword.",
      "method": "GET",
      "endpoint": "/search",
      "query": {
        "q": "{{ inputs.q }}",
        "location": "{{ inputs.location }}",
        "search_type": "{{ inputs.search_type }}",
        "num": "{{ inputs.num }}"
      },
      "output_fields": {
        "results": "organic_results",
        "first_title": "organic_results.0.title",
        "first_link": "organic_results.0.link",
        "total": "search_information.total_results"
      },
      "inputs": [
        {
          "key": "q",
          "label": "Search query",
          "type": "string",
          "required": true
        },
        {
          "key": "location",
          "label": "Location",
          "type": "string",
          "help": "e.g. \"United States\" or \"Austin,Texas\". Leave empty for default."
        },
        {
          "key": "search_type",
          "label": "Type",
          "type": "select",
          "default": "",
          "options": [
            {
              "value": "",
              "label": "Web"
            },
            {
              "value": "news",
              "label": "News"
            },
            {
              "value": "images",
              "label": "Images"
            },
            {
              "value": "videos",
              "label": "Videos"
            },
            {
              "value": "places",
              "label": "Places"
            }
          ]
        },
        {
          "key": "num",
          "label": "Results",
          "type": "number",
          "default": 10
        }
      ]
    },
    {
      "key": "account",
      "name": "Get account",
      "description": "Credits used and left.",
      "method": "GET",
      "endpoint": "/account",
      "output_fields": {
        "plan": "account_info.plan",
        "credits_used": "account_info.credits_used",
        "credits_limit": "account_info.credits_limit"
      },
      "inputs": []
    }
  ]
}
