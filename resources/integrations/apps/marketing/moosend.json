{
  "key": "moosend",
  "name": "Moosend",
  "category": "Marketing & Email",
  "description": "Subscribe, find and unsubscribe mailing list members.",
  "brand": "moosend",
  "website": "https://moosend.com",
  "docs_url": "https://moosendapp.docs.apiary.io/",
  "base_url": "https://api.moosend.com/v3",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "apikey",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "subscribe",
      "name": "Add or update subscriber",
      "method": "POST",
      "endpoint": "/subscribers/{{ inputs.list_id }}/subscribe.json",
      "output_path": "Context",
      "body": {
        "Email": "{{ inputs.email }}",
        "Name": "{{ inputs.name }}",
        "CustomFields": "{{ inputs.custom_fields }}"
      },
      "inputs": [
        {
          "key": "list_id",
          "label": "Mailing list ID",
          "type": "string",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "name",
          "label": "Name",
          "type": "string"
        },
        {
          "key": "custom_fields",
          "label": "Custom fields",
          "type": "list",
          "placeholder": "Age=25"
        }
      ]
    },
    {
      "key": "get_subscriber",
      "name": "Get subscriber by email",
      "method": "GET",
      "endpoint": "/subscribers/{{ inputs.list_id }}/view.json",
      "query": {
        "Email": "{{ inputs.email }}"
      },
      "output_path": "Context",
      "inputs": [
        {
          "key": "list_id",
          "label": "Mailing list ID",
          "type": "string",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "unsubscribe",
      "name": "Unsubscribe from list",
      "method": "POST",
      "endpoint": "/subscribers/{{ inputs.list_id }}/unsubscribe.json",
      "body": {
        "Email": "{{ inputs.email }}"
      },
      "inputs": [
        {
          "key": "list_id",
          "label": "Mailing list ID",
          "type": "string",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_lists",
      "name": "List mailing lists",
      "method": "GET",
      "endpoint": "/lists.json",
      "output_path": "Context",
      "inputs": []
    }
  ]
}
