{
  "key": "redtrack",
  "name": "RedTrack",
  "category": "Ads & SEO",
  "description": "Ad tracking: pull campaigns, offers and performance reports.",
  "website": "https://www.redtrack.io",
  "docs_url": "https://help.redtrack.io/en/articles/4349437-api",
  "base_url": "https://api.redtrack.io",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "api_key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "RedTrack → Settings → General → API Key (or your profile) → copy it."
      }
    ]
  },
  "actions": [
    {
      "key": "list_campaigns",
      "name": "List campaigns",
      "description": "Your tracking campaigns.",
      "method": "GET",
      "endpoint": "/campaigns",
      "output_fields": {
        "campaigns": "$"
      },
      "inputs": []
    },
    {
      "key": "list_offers",
      "name": "List offers",
      "description": "Your offers.",
      "method": "GET",
      "endpoint": "/offers",
      "output_fields": {
        "offers": "$"
      },
      "inputs": []
    },
    {
      "key": "report",
      "name": "Campaign report",
      "description": "Clicks, conversions, cost and revenue per campaign for a date range.",
      "method": "GET",
      "endpoint": "/report",
      "query": {
        "date_from": "{{ inputs.date_from }}",
        "date_to": "{{ inputs.date_to }}",
        "group": "{{ inputs.group }}"
      },
      "output_fields": {
        "rows": "$"
      },
      "inputs": [
        {
          "key": "date_from",
          "label": "From",
          "type": "string",
          "required": true,
          "placeholder": "2026-01-01"
        },
        {
          "key": "date_to",
          "label": "To",
          "type": "string",
          "required": true,
          "placeholder": "2026-01-31"
        },
        {
          "key": "group",
          "label": "Group by",
          "type": "select",
          "default": "campaign",
          "options": [
            {
              "value": "campaign",
              "label": "Campaign"
            },
            {
              "value": "offer",
              "label": "Offer"
            },
            {
              "value": "date",
              "label": "Date"
            },
            {
              "value": "source",
              "label": "Traffic source"
            }
          ]
        }
      ]
    }
  ]
}
