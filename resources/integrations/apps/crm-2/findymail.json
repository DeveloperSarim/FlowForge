{
  "key": "findymail",
  "name": "Findymail",
  "category": "CRM & Sales",
  "description": "Find and verify B2B emails and phone numbers from names or LinkedIn profiles.",
  "brand": "findymail",
  "website": "https://www.findymail.com",
  "docs_url": "https://app.findymail.com/docs/",
  "base_url": "https://app.findymail.com/api",
  "auth": {
    "type": "bearer",
    "fields": [{ "key": "token", "label": "API key", "type": "password", "required": true }]
  },
  "actions": [
    {
      "key": "find_email_by_name",
      "name": "Find email from name",
      "method": "POST",
      "endpoint": "/search/name",
      "output_path": "contact",
      "body": { "name": "{{ inputs.name }}", "domain": "{{ inputs.domain }}" },
      "inputs": [
        { "key": "name", "label": "Full name", "type": "string", "required": true },
        { "key": "domain", "label": "Company domain or name", "type": "string", "required": true, "placeholder": "stripe.com" }
      ]
    },
    {
      "key": "find_email_by_linkedin",
      "name": "Find email from LinkedIn",
      "method": "POST",
      "endpoint": "/search/business-profile",
      "output_path": "contact",
      "body": { "linkedin_url": "{{ inputs.linkedin_url }}" },
      "inputs": [{ "key": "linkedin_url", "label": "LinkedIn profile URL", "type": "string", "required": true }]
    },
    {
      "key": "find_phone",
      "name": "Find phone",
      "method": "POST",
      "endpoint": "/search/phone",
      "body": { "linkedin_url": "{{ inputs.linkedin_url }}" },
      "inputs": [{ "key": "linkedin_url", "label": "LinkedIn profile URL", "type": "string", "required": true }]
    },
    {
      "key": "verify_email",
      "name": "Verify email",
      "method": "POST",
      "endpoint": "/verify",
      "body": { "email": "{{ inputs.email }}" },
      "inputs": [{ "key": "email", "label": "Email", "type": "string", "required": true }]
    }
  ]
}
