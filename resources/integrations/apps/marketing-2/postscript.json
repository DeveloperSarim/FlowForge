{
  "key": "postscript",
  "name": "Postscript",
  "category": "Marketing & Email",
  "description": "Add SMS subscribers to your Shopify store's Postscript account and look them up.",
  "brand": "postscript",
  "website": "https://postscript.io",
  "docs_url": "https://developers.postscript.io/",
  "base_url": "https://api.postscript.io/api/v2",
  "auth": { "type": "bearer", "fields": [{ "key": "token", "label": "Private API key", "type": "password", "required": true, "help": "Postscript > Settings > API." }] },
  "actions": [
    {
      "key": "create_subscriber",
      "name": "Create subscriber",
      "description": "Subscribes a phone number through a keyword (sends the keyword's opt-in flow).",
      "method": "POST",
      "endpoint": "/subscribers",
      "body": {
        "phone_number": "{{ inputs.phone_number }}",
        "keyword": "{{ inputs.keyword }}",
        "email": "{{ inputs.email }}",
        "tags": "{{ inputs.tags }}",
        "properties": "{{ inputs.properties }}"
      },
      "inputs": [
        { "key": "phone_number", "label": "Phone number", "type": "string", "required": true, "placeholder": "+15005550006" },
        { "key": "keyword", "label": "Keyword", "type": "string", "required": true, "placeholder": "WELCOME" },
        { "key": "email", "label": "Email", "type": "string" },
        { "key": "tags", "label": "Tags", "type": "list" },
        { "key": "properties", "label": "Custom properties", "type": "keyvalue" }
      ]
    },
    {
      "key": "get_subscriber",
      "name": "Get subscriber",
      "method": "GET",
      "endpoint": "/subscribers/{{ inputs.subscriber_id }}",
      "inputs": [{ "key": "subscriber_id", "label": "Subscriber ID", "type": "string", "required": true }]
    }
  ]
}
