{
  "key": "osticket",
  "name": "osTicket",
  "category": "Customer Support",
  "description": "Open tickets in a self-hosted osTicket help desk.",
  "brand": "osticket",
  "website": "https://osticket.com",
  "docs_url": "https://docs.osticket.com/en/latest/Developer%20Documentation/API/Tickets.html",
  "base_url": "{{ credentials.base_url }}/api",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "X-API-Key",
    "fields": [
      { "key": "base_url", "label": "osTicket URL", "type": "string", "required": true, "placeholder": "https://support.example.com", "help": "Where osTicket is installed, without a trailing slash" },
      { "key": "api_key", "label": "API key", "type": "password", "required": true, "help": "Admin panel > Manage > API Keys. Keys are tied to the IP address of this FlowForge server." }
    ]
  },
  "actions": [
    {
      "key": "create_ticket",
      "name": "Create ticket",
      "description": "Returns the new ticket number.",
      "method": "POST",
      "endpoint": "/tickets.json",
      "body": {
        "name": "{{ inputs.name }}",
        "email": "{{ inputs.email }}",
        "phone": "{{ inputs.phone }}",
        "subject": "{{ inputs.subject }}",
        "message": "{{ inputs.message }}",
        "topicId": "{{ inputs.topic_id }}",
        "alert": "{{ inputs.alert }}",
        "autorespond": "{{ inputs.autorespond }}",
        "source": "API"
      },
      "inputs": [
        { "key": "name", "label": "Name", "type": "string", "required": true },
        { "key": "email", "label": "Email", "type": "string", "required": true },
        { "key": "phone", "label": "Phone", "type": "string" },
        { "key": "subject", "label": "Subject", "type": "string", "required": true },
        { "key": "message", "label": "Message", "type": "text", "required": true },
        { "key": "topic_id", "label": "Help topic ID", "type": "number" },
        { "key": "alert", "label": "Alert staff", "type": "boolean", "default": true },
        { "key": "autorespond", "label": "Send auto-response", "type": "boolean", "default": true }
      ]
    }
  ]
}
