{
  "key": "wecom",
  "name": "WeCom",
  "category": "Communication",
  "description": "Post text, Markdown and news messages to a WeCom (WeChat Work) group via a group bot.",
  "brand": "wechat",
  "website": "https://work.weixin.qq.com",
  "docs_url": "https://developer.work.weixin.qq.com/document/path/91770",
  "popular": true,
  "actions": [
    {
      "key": "send_text",
      "name": "Send text message",
      "method": "POST",
      "endpoint": "{{ inputs.webhook_url }}",
      "error_path": "errcode",
      "body": {
        "msgtype": "text",
        "text": { "content": "{{ inputs.content }}", "mentioned_list": "{{ inputs.mentioned_list }}", "mentioned_mobile_list": "{{ inputs.mentioned_mobile_list }}" }
      },
      "inputs": [
        { "key": "webhook_url", "label": "Group bot webhook URL", "type": "password", "required": true, "placeholder": "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=…", "help": "Group chat → … → Add Group Bot → copy the webhook URL." },
        { "key": "content", "label": "Message", "type": "text", "required": true },
        { "key": "mentioned_list", "label": "Mention user IDs", "type": "list", "help": "WeCom user IDs, or @all." },
        { "key": "mentioned_mobile_list", "label": "Mention phone numbers", "type": "list" }
      ]
    },
    {
      "key": "send_markdown",
      "name": "Send Markdown message",
      "method": "POST",
      "endpoint": "{{ inputs.webhook_url }}",
      "error_path": "errcode",
      "body": { "msgtype": "markdown", "markdown": { "content": "{{ inputs.content }}" } },
      "inputs": [
        { "key": "webhook_url", "label": "Group bot webhook URL", "type": "password", "required": true },
        { "key": "content", "label": "Markdown", "type": "text", "required": true, "help": "Mention a user with <@userid>." }
      ]
    },
    {
      "key": "send_news",
      "name": "Send news (link card)",
      "method": "POST",
      "endpoint": "{{ inputs.webhook_url }}",
      "error_path": "errcode",
      "body": {
        "msgtype": "news",
        "news": { "articles": [{ "title": "{{ inputs.title }}", "description": "{{ inputs.description }}", "url": "{{ inputs.url }}", "picurl": "{{ inputs.picurl }}" }] }
      },
      "inputs": [
        { "key": "webhook_url", "label": "Group bot webhook URL", "type": "password", "required": true },
        { "key": "title", "label": "Title", "type": "string", "required": true },
        { "key": "description", "label": "Description", "type": "text" },
        { "key": "url", "label": "Link URL", "type": "string", "required": true },
        { "key": "picurl", "label": "Image URL", "type": "string" }
      ]
    }
  ]
}
