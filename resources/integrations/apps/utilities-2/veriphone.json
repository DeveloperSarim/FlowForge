{
  "key": "veriphone",
  "name": "Veriphone",
  "category": "Utilities",
  "description": "Validate phone numbers and get carrier, line type and formats.",
  "brand": "veriphone",
  "website": "https://veriphone.io",
  "docs_url": "https://veriphone.io/docs/v2",
  "base_url": "https://api.veriphone.io/v2",
  "auth": { "type": "api_key", "in": "query", "name": "key", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "verify_phone",
      "name": "Verify phone number",
      "method": "GET",
      "endpoint": "/verify",
      "query": { "phone": "{{ inputs.phone }}", "default_country": "{{ inputs.default_country }}" },
      "inputs": [
        { "key": "phone", "label": "Phone number", "type": "string", "required": true, "placeholder": "+49 15123577723" },
        { "key": "default_country", "label": "Default country", "type": "string", "placeholder": "DE", "help": "ISO code used when the number has no country prefix." }
      ]
    }
  ]
}
