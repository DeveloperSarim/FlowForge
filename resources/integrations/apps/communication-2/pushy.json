{
  "key": "pushy",
  "name": "Pushy",
  "category": "Communication",
  "description": "Send push notifications to devices or topics with Pushy.",
  "brand": "pushy",
  "website": "https://pushy.me",
  "docs_url": "https://pushy.me/docs/api/send-notifications",
  "base_url": "https://api.pushy.me",
  "auth": [
    { "type": "api_key", "in": "query", "name": "api_key", "fields": [{ "key": "api_key", "label": "Secret API key", "type": "password", "required": true }] }
  ],
  "actions": [
    {
      "key": "send_push",
      "name": "Send push notification",
      "method": "POST",
      "endpoint": "/push",
      "body": {
        "to": "{{ inputs.to }}",
        "data": "{{ inputs.data }}",
        "notification": { "title": "{{ inputs.title }}", "body": "{{ inputs.body }}", "badge": "{{ inputs.badge }}", "sound": "{{ inputs.sound }}" },
        "time_to_live": "{{ inputs.time_to_live }}"
      },
      "inputs": [
        { "key": "to", "label": "Device token or topic", "type": "string", "required": true, "placeholder": "/topics/news", "help": "A device token, or /topics/<name>." },
        { "key": "title", "label": "Title (iOS)", "type": "string" },
        { "key": "body", "label": "Message (iOS)", "type": "text" },
        { "key": "data", "label": "Data payload (JSON)", "type": "json", "required": true, "placeholder": "{\"message\":\"Hello World!\"}", "help": "Delivered to your app (Android shows what your app renders from it)." },
        { "key": "badge", "label": "Badge (iOS)", "type": "number" },
        { "key": "sound", "label": "Sound (iOS)", "type": "string", "placeholder": "ping.aiff" },
        { "key": "time_to_live", "label": "Time to live (seconds)", "type": "number" }
      ]
    }
  ]
}
