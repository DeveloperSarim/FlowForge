{
  "key": "simplecast",
  "name": "Simplecast",
  "category": "Video & Media",
  "description": "Read podcasts and episodes from your Simplecast account.",
  "brand": "simplecast",
  "website": "https://simplecast.com",
  "docs_url": "https://apidocs.simplecast.com",
  "base_url": "https://api.simplecast.com",
  "auth": { "type": "bearer", "fields": [
    { "key": "token", "label": "API key", "type": "password", "required": true, "help": "Account Settings > Private Apps / API key." }
  ] },
  "actions": [
    {
      "key": "list_podcasts",
      "name": "List podcasts",
      "method": "GET",
      "endpoint": "/podcasts",
      "inputs": []
    },
    {
      "key": "list_episodes",
      "name": "List episodes",
      "method": "GET",
      "endpoint": "/podcasts/{{ inputs.podcast_id }}/episodes",
      "inputs": [{ "key": "podcast_id", "label": "Podcast ID", "type": "string", "required": true }]
    },
    {
      "key": "get_episode",
      "name": "Get episode",
      "method": "GET",
      "endpoint": "/episodes/{{ inputs.episode_id }}",
      "inputs": [{ "key": "episode_id", "label": "Episode ID", "type": "string", "required": true }]
    }
  ]
}
