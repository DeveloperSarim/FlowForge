{
  "key": "lm_studio",
  "name": "LM Studio",
  "category": "AI",
  "description": "Chat with models loaded in LM Studio's local server.",
  "brand": "lmstudio",
  "website": "https://lmstudio.ai",
  "docs_url": "https://lmstudio.ai/docs/app/api/endpoints/openai",
  "base_url": "{{ credentials.base_url }}",
  "headers": {
    "Authorization": "Bearer {{ credentials.api_key }}"
  },
  "auth": {
    "type": "api_key",
    "fields": [
      {
        "key": "base_url",
        "label": "Server URL",
        "type": "string",
        "required": true,
        "default": "http://localhost:1234/v1",
        "help": "LM Studio server URL including /v1. For a server on this machine or your private network (localhost, 192.168.x.x), first set FLOWFORGE_ALLOW_PRIVATE_NETWORK=true in .env."
      },
      {
        "key": "api_key",
        "label": "API key (optional)",
        "type": "password",
        "required": false,
        "help": "Only needed when the server sits behind an authenticating proxy or cloud endpoint."
      }
    ]
  },
  "actions": [
    {
      "key": "chat_completion",
      "name": "Chat completion",
      "description": "Send a prompt and get the reply as {{ steps.<id>.text }}.",
      "method": "POST",
      "endpoint": "/chat/completions",
      "timeout": 300,
      "body": {
        "model": "{{ inputs.model }}",
        "messages": [
          {
            "role": "system",
            "content": "{{ inputs.system }}"
          },
          {
            "role": "user",
            "content": "{{ inputs.prompt }}"
          }
        ],
        "temperature": "{{ inputs.temperature }}",
        "max_tokens": "{{ inputs.max_tokens }}"
      },
      "output_fields": {
        "text": "choices.0.message.content"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "help": "The model identifier shown in LM Studio."
        },
        {
          "key": "prompt",
          "label": "Prompt",
          "type": "text",
          "required": true
        },
        {
          "key": "system",
          "label": "System prompt",
          "type": "text",
          "required": true,
          "default": "You are a helpful assistant.",
          "help": "Sent as the system message."
        },
        {
          "key": "temperature",
          "label": "Temperature",
          "type": "number",
          "placeholder": "0.7"
        },
        {
          "key": "max_tokens",
          "label": "Max output tokens",
          "type": "number"
        }
      ]
    },
    {
      "key": "create_embedding",
      "name": "Create embedding",
      "description": "Turn text into a vector, available as {{ steps.<id>.embedding }}.",
      "method": "POST",
      "endpoint": "/embeddings",
      "body": {
        "model": "{{ inputs.model }}",
        "input": "{{ inputs.input }}"
      },
      "output_fields": {
        "embedding": "data.0.embedding"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "placeholder": "text-embedding-nomic-embed-text-v1.5"
        },
        {
          "key": "input",
          "label": "Text",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "key": "list_models",
      "name": "List models",
      "method": "GET",
      "endpoint": "/models",
      "inputs": []
    }
  ]
}
