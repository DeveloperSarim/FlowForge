{
  "key": "zoho_projects",
  "name": "Zoho Projects",
  "category": "Project Management",
  "description": "Create and list tasks and projects in Zoho Projects (US data center).",
  "brand": "zoho",
  "website": "https://www.zoho.com/projects/",
  "docs_url": "https://www.zoho.com/projects/help/rest-api/zohoprojectsapi.html",
  "base_url": "https://projectsapi.zoho.com/restapi",
  "auth": {
    "type": "oauth2",
    "authorize_url": "https://accounts.zoho.com/oauth/v2/auth",
    "token_url": "https://accounts.zoho.com/oauth/v2/token",
    "scopes": [
      "ZohoProjects.portals.READ",
      "ZohoProjects.projects.ALL",
      "ZohoProjects.tasks.ALL"
    ],
    "scope_separator": ",",
    "authorize_params": {
      "access_type": "offline",
      "prompt": "consent"
    },
    "token_type": "Zoho-oauthtoken"
  },
  "actions": [
    {
      "key": "list_portals",
      "name": "List portals",
      "method": "GET",
      "endpoint": "/portals/",
      "output_path": "portals",
      "inputs": []
    },
    {
      "key": "list_projects",
      "name": "List projects",
      "method": "GET",
      "endpoint": "/portal/{{ inputs.portal_id }}/projects/",
      "output_path": "projects",
      "inputs": [
        {
          "key": "portal_id",
          "label": "Portal ID",
          "type": "string",
          "required": true,
          "help": "From List portals (id_string)."
        }
      ]
    },
    {
      "key": "create_task",
      "name": "Create task",
      "method": "POST",
      "endpoint": "/portal/{{ inputs.portal_id }}/projects/{{ inputs.project_id }}/tasks/",
      "body_format": "form",
      "body": {
        "name": "{{ inputs.name }}",
        "description": "{{ inputs.description }}",
        "start_date": "{{ inputs.start_date }}",
        "end_date": "{{ inputs.end_date }}",
        "priority": "{{ inputs.priority }}",
        "person_responsible": "{{ inputs.person_responsible }}"
      },
      "output_path": "tasks",
      "inputs": [
        {
          "key": "portal_id",
          "label": "Portal ID",
          "type": "string",
          "required": true,
          "help": "From List portals (id_string)."
        },
        {
          "key": "project_id",
          "label": "Project ID",
          "type": "string",
          "required": true
        },
        {
          "key": "name",
          "label": "Name",
          "type": "string",
          "required": true
        },
        {
          "key": "description",
          "label": "Description",
          "type": "text"
        },
        {
          "key": "start_date",
          "label": "Start date",
          "type": "string",
          "placeholder": "10-12-2026",
          "help": "MM-DD-YYYY"
        },
        {
          "key": "end_date",
          "label": "Due date",
          "type": "string",
          "placeholder": "10-19-2026"
        },
        {
          "key": "priority",
          "label": "Priority",
          "type": "select",
          "options": [
            {
              "value": "None",
              "label": "None"
            },
            {
              "value": "Low",
              "label": "Low"
            },
            {
              "value": "Medium",
              "label": "Medium"
            },
            {
              "value": "High",
              "label": "High"
            }
          ]
        },
        {
          "key": "person_responsible",
          "label": "Owner user IDs",
          "type": "string",
          "placeholder": "2060758,2060759"
        }
      ]
    },
    {
      "key": "list_tasks",
      "name": "List tasks",
      "method": "GET",
      "endpoint": "/portal/{{ inputs.portal_id }}/projects/{{ inputs.project_id }}/tasks/",
      "output_path": "tasks",
      "inputs": [
        {
          "key": "portal_id",
          "label": "Portal ID",
          "type": "string",
          "required": true,
          "help": "From List portals (id_string)."
        },
        {
          "key": "project_id",
          "label": "Project ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
