{
  "key": "pixabay",
  "name": "Pixabay",
  "category": "Utilities",
  "description": "Search royalty-free images, illustrations, vectors and videos.",
  "brand": "pixabay",
  "website": "https://pixabay.com",
  "docs_url": "https://pixabay.com/api/docs/",
  "base_url": "https://pixabay.com/api",
  "auth": { "type": "api_key", "in": "query", "name": "key", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true, "help": "Shown on pixabay.com/api/docs/ when logged in." }
  ] },
  "actions": [
    {
      "key": "search_images",
      "name": "Search images",
      "method": "GET",
      "endpoint": "/",
      "query": { "q": "{{ inputs.q }}", "image_type": "{{ inputs.image_type }}", "orientation": "{{ inputs.orientation }}", "category": "{{ inputs.category }}", "order": "{{ inputs.order }}", "safesearch": "{{ inputs.safesearch }}", "per_page": "{{ inputs.per_page }}", "page": "{{ inputs.page }}" },
      "output_path": "hits",
      "inputs": [
        { "key": "q", "label": "Search", "type": "string", "placeholder": "yellow flowers" },
        { "key": "image_type", "label": "Type", "type": "select", "default": "all", "options": [
          { "value": "all", "label": "All" }, { "value": "photo", "label": "Photo" }, { "value": "illustration", "label": "Illustration" }, { "value": "vector", "label": "Vector" }
        ] },
        { "key": "orientation", "label": "Orientation", "type": "select", "default": "all", "options": [
          { "value": "all", "label": "All" }, { "value": "horizontal", "label": "Horizontal" }, { "value": "vertical", "label": "Vertical" }
        ] },
        { "key": "category", "label": "Category", "type": "string", "placeholder": "nature" },
        { "key": "order", "label": "Sort", "type": "select", "default": "popular", "options": [{ "value": "popular", "label": "Popular" }, { "value": "latest", "label": "Latest" }] },
        { "key": "safesearch", "label": "Safe search", "type": "select", "default": "true", "options": [{ "value": "true", "label": "On" }, { "value": "false", "label": "Off" }] },
        { "key": "per_page", "label": "Per page", "type": "number", "default": 20, "help": "3 to 200." },
        { "key": "page", "label": "Page", "type": "number" }
      ]
    },
    {
      "key": "search_videos",
      "name": "Search videos",
      "method": "GET",
      "endpoint": "/videos/",
      "query": { "q": "{{ inputs.q }}", "video_type": "{{ inputs.video_type }}", "order": "{{ inputs.order }}", "safesearch": "{{ inputs.safesearch }}", "per_page": "{{ inputs.per_page }}", "page": "{{ inputs.page }}" },
      "output_path": "hits",
      "inputs": [
        { "key": "q", "label": "Search", "type": "string" },
        { "key": "video_type", "label": "Type", "type": "select", "default": "all", "options": [
          { "value": "all", "label": "All" }, { "value": "film", "label": "Film" }, { "value": "animation", "label": "Animation" }
        ] },
        { "key": "order", "label": "Sort", "type": "select", "default": "popular", "options": [{ "value": "popular", "label": "Popular" }, { "value": "latest", "label": "Latest" }] },
        { "key": "safesearch", "label": "Safe search", "type": "select", "default": "true", "options": [{ "value": "true", "label": "On" }, { "value": "false", "label": "Off" }] },
        { "key": "per_page", "label": "Per page", "type": "number", "default": 20 },
        { "key": "page", "label": "Page", "type": "number" }
      ]
    }
  ]
}
