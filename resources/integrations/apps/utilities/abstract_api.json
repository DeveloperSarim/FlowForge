{
  "key": "abstract_api",
  "name": "Abstract API",
  "category": "Utilities",
  "description": "Validate email addresses and phone numbers.",
  "brand": "abstractapi",
  "website": "https://www.abstractapi.com",
  "docs_url": "https://docs.abstractapi.com",
  "base_url": "https://emailvalidation.abstractapi.com/v1",
  "auth": { "type": "api_key", "fields": [
    { "key": "api_key", "label": "Email Validation API key", "type": "password", "required": false, "help": "Each Abstract API has its own key. Fill the ones you use." },
    { "key": "phone_api_key", "label": "Phone Validation API key", "type": "password", "required": false }
  ] },
  "actions": [
    {
      "key": "validate_email",
      "name": "Validate email",
      "description": "Checks format, MX records, SMTP and disposable/free providers.",
      "method": "GET",
      "endpoint": "/",
      "query": { "api_key": "{{ credentials.api_key }}", "email": "{{ inputs.email }}" },
      "inputs": [{ "key": "email", "label": "Email", "type": "string", "required": true }]
    },
    {
      "key": "validate_phone",
      "name": "Validate phone number",
      "description": "Checks validity, line type, carrier and country.",
      "method": "GET",
      "endpoint": "https://phonevalidation.abstractapi.com/v1/",
      "query": { "api_key": "{{ credentials.phone_api_key }}", "phone": "{{ inputs.phone }}", "country": "{{ inputs.country }}" },
      "inputs": [
        { "key": "phone", "label": "Phone number", "type": "string", "required": true, "placeholder": "14152007986", "help": "Include the country code, or set Country." },
        { "key": "country", "label": "Country (ISO code)", "type": "string", "placeholder": "US" }
      ]
    }
  ]
}
