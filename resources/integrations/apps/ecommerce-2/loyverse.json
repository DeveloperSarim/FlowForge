{
  "key": "loyverse",
  "name": "Loyverse",
  "category": "E-commerce",
  "description": "Read receipts and items and create or find customers in Loyverse POS.",
  "brand": "loyverse",
  "website": "https://loyverse.com",
  "docs_url": "https://developer.loyverse.com/docs/",
  "base_url": "https://api.loyverse.com/v1.0",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "Access token",
          "type": "password",
          "required": true,
          "help": "Back Office > Settings > Access tokens."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_receipts",
      "name": "List receipts",
      "method": "GET",
      "endpoint": "/receipts",
      "query": {
        "limit": "{{ inputs.limit }}",
        "created_at_min": "{{ inputs.created_at_min }}",
        "store_id": "{{ inputs.store_id }}"
      },
      "output_path": "receipts",
      "inputs": [
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "help": "Max 250."
        },
        {
          "key": "created_at_min",
          "label": "Created after",
          "type": "string",
          "placeholder": "2026-01-31T00:00:00.000Z"
        },
        {
          "key": "store_id",
          "label": "Store ID",
          "type": "string"
        }
      ]
    },
    {
      "key": "get_receipt",
      "name": "Get receipt",
      "method": "GET",
      "endpoint": "/receipts/{{ inputs.receipt_number }}",
      "inputs": [
        {
          "key": "receipt_number",
          "label": "Receipt number",
          "type": "string",
          "required": true,
          "placeholder": "1-1001"
        }
      ]
    },
    {
      "key": "list_items",
      "name": "List items",
      "method": "GET",
      "endpoint": "/items",
      "query": {
        "limit": "{{ inputs.limit }}"
      },
      "output_path": "items",
      "inputs": [
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50
        }
      ]
    },
    {
      "key": "find_customers",
      "name": "Find customers",
      "method": "GET",
      "endpoint": "/customers",
      "query": {
        "email": "{{ inputs.email }}",
        "limit": "{{ inputs.limit }}"
      },
      "output_path": "customers",
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string"
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50
        }
      ]
    },
    {
      "key": "create_customer",
      "name": "Create or update customer",
      "description": "Pass an existing customer ID to update it.",
      "method": "POST",
      "endpoint": "/customers",
      "body": {
        "id": "{{ inputs.customer_id }}",
        "name": "{{ inputs.name }}",
        "email": "{{ inputs.email }}",
        "phone_number": "{{ inputs.phone }}",
        "customer_code": "{{ inputs.customer_code }}",
        "note": "{{ inputs.note }}"
      },
      "inputs": [
        {
          "key": "name",
          "label": "Name",
          "type": "string",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string"
        },
        {
          "key": "phone",
          "label": "Phone",
          "type": "string"
        },
        {
          "key": "customer_code",
          "label": "Customer code",
          "type": "string"
        },
        {
          "key": "note",
          "label": "Note",
          "type": "text"
        },
        {
          "key": "customer_id",
          "label": "Existing customer ID",
          "type": "string"
        }
      ]
    }
  ]
}
