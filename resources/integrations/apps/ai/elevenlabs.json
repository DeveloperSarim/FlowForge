{
  "key": "elevenlabs",
  "name": "ElevenLabs",
  "category": "AI",
  "description": "Turn text into lifelike speech and manage voices.",
  "brand": "elevenlabs",
  "website": "https://elevenlabs.io",
  "docs_url": "https://elevenlabs.io/docs/api-reference",
  "popular": true,
  "base_url": "https://api.elevenlabs.io/v1",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "xi-api-key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "text_to_speech",
      "name": "Text to speech",
      "description": "Audio comes back base64-encoded as {{ steps.<id>.audio_base64 }}.",
      "method": "POST",
      "endpoint": "/text-to-speech/{{ inputs.voice_id }}/with-timestamps",
      "timeout": 300,
      "query": {
        "output_format": "{{ inputs.output_format }}"
      },
      "body": {
        "text": "{{ inputs.text }}",
        "model_id": "{{ inputs.model_id }}",
        "language_code": "{{ inputs.language_code }}"
      },
      "output_fields": {
        "audio_base64": "audio_base64"
      },
      "inputs": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "required": true
        },
        {
          "key": "voice_id",
          "label": "Voice ID",
          "type": "string",
          "required": true,
          "default": "JBFqnCBsd6RMkjVDRZzb",
          "help": "From List voices."
        },
        {
          "key": "model_id",
          "label": "Model",
          "type": "string",
          "default": "eleven_multilingual_v2"
        },
        {
          "key": "output_format",
          "label": "Output format",
          "type": "string",
          "default": "mp3_44100_128"
        },
        {
          "key": "language_code",
          "label": "Language code",
          "type": "string",
          "placeholder": "en"
        }
      ]
    },
    {
      "key": "list_voices",
      "name": "List voices",
      "method": "GET",
      "endpoint": "/voices",
      "inputs": []
    },
    {
      "key": "list_history",
      "name": "List history",
      "method": "GET",
      "endpoint": "/history",
      "query": {
        "page_size": "{{ inputs.page_size }}"
      },
      "inputs": [
        {
          "key": "page_size",
          "label": "Page size",
          "type": "number"
        }
      ]
    },
    {
      "key": "get_subscription",
      "name": "Get subscription",
      "method": "GET",
      "endpoint": "/user/subscription",
      "inputs": []
    }
  ]
}
