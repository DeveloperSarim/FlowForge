{
  "key": "cin7",
  "name": "Cin7 Core",
  "category": "E-commerce",
  "description": "Look up products, stock levels, sales and customers in Cin7 Core.",
  "brand": "cin7",
  "website": "https://www.cin7.com",
  "docs_url": "https://dearinventory.docs.apiary.io",
  "base_url": "https://inventory.dearsystems.com/ExternalApi/v2",
  "headers": {
    "api-auth-accountid": "{{ credentials.account_id }}",
    "api-auth-applicationkey": "{{ credentials.api_key }}"
  },
  "auth": [
    {
      "type": "api_key",
      "fields": [
        {
          "key": "account_id",
          "label": "Account ID",
          "type": "string",
          "required": true,
          "help": "Integrations > API > add an application."
        },
        {
          "key": "api_key",
          "label": "Application key",
          "type": "password",
          "required": true
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_products",
      "name": "List products",
      "method": "GET",
      "endpoint": "/Product",
      "query": {
        "Page": "{{ inputs.page }}",
        "Limit": "{{ inputs.limit }}",
        "Name": "{{ inputs.name }}",
        "Sku": "{{ inputs.sku }}"
      },
      "output_path": "Products",
      "inputs": [
        {
          "key": "name",
          "label": "Name",
          "type": "string"
        },
        {
          "key": "sku",
          "label": "SKU",
          "type": "string"
        },
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "default": 1
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 100
        }
      ]
    },
    {
      "key": "get_stock",
      "name": "Get stock availability",
      "method": "GET",
      "endpoint": "/ref/productavailability",
      "query": {
        "Sku": "{{ inputs.sku }}",
        "Location": "{{ inputs.location }}",
        "Page": "{{ inputs.page }}",
        "Limit": "{{ inputs.limit }}"
      },
      "output_path": "ProductAvailabilityList",
      "inputs": [
        {
          "key": "sku",
          "label": "SKU",
          "type": "string"
        },
        {
          "key": "location",
          "label": "Location",
          "type": "string"
        },
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "default": 1
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 100
        }
      ]
    },
    {
      "key": "list_sales",
      "name": "List sales",
      "method": "GET",
      "endpoint": "/SaleList",
      "query": {
        "Search": "{{ inputs.search }}",
        "UpdatedSince": "{{ inputs.updated_since }}",
        "Page": "{{ inputs.page }}",
        "Limit": "{{ inputs.limit }}"
      },
      "output_path": "SaleList",
      "inputs": [
        {
          "key": "search",
          "label": "Search",
          "type": "string"
        },
        {
          "key": "updated_since",
          "label": "Updated since",
          "type": "string",
          "placeholder": "2026-01-31T00:00:00Z"
        },
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "default": 1
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 100
        }
      ]
    },
    {
      "key": "get_sale",
      "name": "Get sale",
      "method": "GET",
      "endpoint": "/Sale",
      "query": {
        "ID": "{{ inputs.sale_id }}"
      },
      "inputs": [
        {
          "key": "sale_id",
          "label": "Sale ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_customers",
      "name": "List customers",
      "method": "GET",
      "endpoint": "/Customer",
      "query": {
        "Name": "{{ inputs.name }}",
        "Page": "{{ inputs.page }}",
        "Limit": "{{ inputs.limit }}"
      },
      "output_path": "CustomerList",
      "inputs": [
        {
          "key": "name",
          "label": "Name",
          "type": "string"
        },
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "default": 1
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 100
        }
      ]
    }
  ]
}
