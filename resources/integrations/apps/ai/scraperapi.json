{
  "key": "scraperapi",
  "name": "ScraperAPI",
  "category": "AI",
  "description": "Fetch web pages through ScraperAPI's proxy and rendering pool.",
  "brand": "scraperapi",
  "website": "https://www.scraperapi.com",
  "docs_url": "https://docs.scraperapi.com",
  "base_url": "https://api.scraperapi.com",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "api_key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "scrape",
      "name": "Scrape URL",
      "method": "GET",
      "endpoint": "/",
      "timeout": 120,
      "query": {
        "url": "{{ inputs.url }}",
        "render": "{{ inputs.render }}",
        "country_code": "{{ inputs.country_code }}"
      },
      "inputs": [
        {
          "key": "url",
          "label": "URL",
          "type": "string",
          "required": true
        },
        {
          "key": "render",
          "label": "Render JavaScript",
          "type": "select",
          "options": [
            {
              "value": "false",
              "label": "No"
            },
            {
              "value": "true",
              "label": "Yes"
            }
          ]
        },
        {
          "key": "country_code",
          "label": "Country code",
          "type": "string",
          "placeholder": "us"
        }
      ]
    },
    {
      "key": "get_account",
      "name": "Get account",
      "method": "GET",
      "endpoint": "/account",
      "inputs": []
    }
  ]
}
