{
  "key": "aweber",
  "name": "AWeber",
  "category": "Marketing & Email",
  "description": "Add, update, tag and unsubscribe list subscribers.",
  "brand": "aweber",
  "website": "https://www.aweber.com",
  "docs_url": "https://api.aweber.com/",
  "base_url": "https://api.aweber.com/1.0",
  "auth": {
    "type": "oauth2",
    "authorize_url": "https://auth.aweber.com/oauth2/authorize",
    "token_url": "https://auth.aweber.com/oauth2/token",
    "scopes": [
      "account.read",
      "list.read",
      "list.write",
      "subscriber.read",
      "subscriber.write",
      "email.read"
    ]
  },
  "actions": [
    {
      "key": "add_subscriber",
      "name": "Add subscriber",
      "method": "POST",
      "endpoint": "/accounts/{{ inputs.account_id }}/lists/{{ inputs.list_id }}/subscribers",
      "body": {
        "email": "{{ inputs.email }}",
        "name": "{{ inputs.name }}",
        "tags": "{{ inputs.tags }}",
        "custom_fields": "{{ inputs.custom_fields }}"
      },
      "inputs": [
        {
          "key": "account_id",
          "label": "Account ID",
          "type": "string",
          "required": true,
          "help": "Run \"List accounts\" to find it."
        },
        {
          "key": "list_id",
          "label": "List ID",
          "type": "string",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "name",
          "label": "Name",
          "type": "string"
        },
        {
          "key": "tags",
          "label": "Tags",
          "type": "list"
        },
        {
          "key": "custom_fields",
          "label": "Custom fields",
          "type": "keyvalue"
        }
      ]
    },
    {
      "key": "find_subscriber",
      "name": "Find subscriber in list",
      "method": "GET",
      "endpoint": "/accounts/{{ inputs.account_id }}/lists/{{ inputs.list_id }}/subscribers",
      "query": {
        "ws.op": "find",
        "email": "{{ inputs.email }}"
      },
      "output_path": "entries",
      "inputs": [
        {
          "key": "account_id",
          "label": "Account ID",
          "type": "string",
          "required": true,
          "help": "Run \"List accounts\" to find it."
        },
        {
          "key": "list_id",
          "label": "List ID",
          "type": "string",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "update_subscriber",
      "name": "Update subscriber (tags / unsubscribe)",
      "method": "PATCH",
      "endpoint": "/accounts/{{ inputs.account_id }}/lists/{{ inputs.list_id }}/subscribers",
      "query": {
        "subscriber_email": "{{ inputs.email }}"
      },
      "body": {
        "status": "{{ inputs.status }}",
        "tags": {
          "add": "{{ inputs.add_tags }}",
          "remove": "{{ inputs.remove_tags }}"
        }
      },
      "inputs": [
        {
          "key": "account_id",
          "label": "Account ID",
          "type": "string",
          "required": true,
          "help": "Run \"List accounts\" to find it."
        },
        {
          "key": "list_id",
          "label": "List ID",
          "type": "string",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "options": [
            {
              "value": "subscribed",
              "label": "Subscribed"
            },
            {
              "value": "unsubscribed",
              "label": "Unsubscribed"
            }
          ]
        },
        {
          "key": "add_tags",
          "label": "Add tags",
          "type": "list"
        },
        {
          "key": "remove_tags",
          "label": "Remove tags",
          "type": "list"
        }
      ]
    },
    {
      "key": "list_accounts",
      "name": "List accounts",
      "method": "GET",
      "endpoint": "/accounts",
      "output_path": "entries",
      "inputs": []
    },
    {
      "key": "list_lists",
      "name": "List lists",
      "method": "GET",
      "endpoint": "/accounts/{{ inputs.account_id }}/lists",
      "output_path": "entries",
      "inputs": [
        {
          "key": "account_id",
          "label": "Account ID",
          "type": "string",
          "required": true,
          "help": "Run \"List accounts\" to find it."
        }
      ]
    }
  ]
}
