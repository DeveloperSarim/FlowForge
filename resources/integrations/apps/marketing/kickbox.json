{
  "key": "kickbox",
  "name": "Kickbox",
  "category": "Marketing & Email",
  "description": "Verify email addresses.",
  "brand": "kickbox",
  "website": "https://kickbox.com",
  "docs_url": "https://docs.kickbox.com/docs/single-verification-api",
  "base_url": "https://api.kickbox.com/v2",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "apikey",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "verify",
      "name": "Verify email",
      "method": "GET",
      "endpoint": "/verify",
      "query": {
        "email": "{{ inputs.email }}",
        "timeout": "{{ inputs.timeout_ms }}"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "timeout_ms",
          "label": "Timeout (ms)",
          "type": "number",
          "placeholder": "6000"
        }
      ]
    }
  ]
}
