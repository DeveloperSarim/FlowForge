{
  "key": "phoneburner",
  "name": "PhoneBurner",
  "category": "CRM & Sales",
  "description": "Add contacts to your PhoneBurner power dialer and look them up.",
  "website": "https://www.phoneburner.com",
  "docs_url": "https://www.phoneburner.com/developer/route_list",
  "base_url": "https://www.phoneburner.com/rest/1",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "Personal access token",
        "type": "password",
        "required": true,
        "help": "In PhoneBurner go to My Account → Settings → API / Personal Access Tokens and create a token."
      }
    ]
  },
  "actions": [
    {
      "key": "create_contact",
      "name": "Create contact",
      "method": "POST",
      "endpoint": "/contacts",
      "body": {
        "first_name": "{{ inputs.first_name }}",
        "last_name": "{{ inputs.last_name }}",
        "email": "{{ inputs.email }}",
        "phone": "{{ inputs.phone }}",
        "phone_type": "{{ inputs.phone_type }}",
        "address1": "{{ inputs.address1 }}",
        "city": "{{ inputs.city }}",
        "state": "{{ inputs.state }}",
        "zip": "{{ inputs.zip }}",
        "country": "{{ inputs.country }}",
        "notes": "{{ inputs.notes }}",
        "category_id": "{{ inputs.category_id }}",
        "tags": "{{ inputs.tags }}"
      },
      "output_fields": {
        "contact_id": "contacts.contacts.contact_user_id"
      },
      "inputs": [
        {
          "key": "first_name",
          "label": "First name",
          "type": "string"
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string"
        },
        {
          "key": "phone",
          "label": "Phone",
          "type": "string"
        },
        {
          "key": "phone_type",
          "label": "Phone type",
          "type": "select",
          "default": "3",
          "options": [
            {
              "value": "1",
              "label": "Home"
            },
            {
              "value": "2",
              "label": "Work"
            },
            {
              "value": "3",
              "label": "Mobile"
            },
            {
              "value": "5",
              "label": "Other"
            }
          ]
        },
        {
          "key": "address1",
          "label": "Address",
          "type": "string"
        },
        {
          "key": "city",
          "label": "City",
          "type": "string"
        },
        {
          "key": "state",
          "label": "State",
          "type": "string"
        },
        {
          "key": "zip",
          "label": "ZIP code",
          "type": "string"
        },
        {
          "key": "country",
          "label": "Country",
          "type": "string"
        },
        {
          "key": "notes",
          "label": "Notes",
          "type": "text"
        },
        {
          "key": "category_id",
          "label": "Folder ID",
          "type": "number",
          "help": "Run \"List folders\" to find it. Empty = default folder."
        },
        {
          "key": "tags",
          "label": "Tags",
          "type": "list"
        }
      ]
    },
    {
      "key": "update_contact",
      "name": "Update contact",
      "method": "PUT",
      "endpoint": "/contacts/{{ inputs.contact_id }}",
      "body": {
        "first_name": "{{ inputs.first_name }}",
        "last_name": "{{ inputs.last_name }}",
        "email": "{{ inputs.email }}",
        "phone": "{{ inputs.phone }}",
        "phone_type": "{{ inputs.phone_type }}",
        "address1": "{{ inputs.address1 }}",
        "city": "{{ inputs.city }}",
        "state": "{{ inputs.state }}",
        "zip": "{{ inputs.zip }}",
        "country": "{{ inputs.country }}",
        "notes": "{{ inputs.notes }}"
      },
      "inputs": [
        {
          "key": "contact_id",
          "label": "Contact ID",
          "type": "string",
          "required": true
        },
        {
          "key": "first_name",
          "label": "First name",
          "type": "string"
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string"
        },
        {
          "key": "phone",
          "label": "Phone",
          "type": "string"
        },
        {
          "key": "phone_type",
          "label": "Phone type",
          "type": "select",
          "default": "3",
          "options": [
            {
              "value": "1",
              "label": "Home"
            },
            {
              "value": "2",
              "label": "Work"
            },
            {
              "value": "3",
              "label": "Mobile"
            },
            {
              "value": "5",
              "label": "Other"
            }
          ]
        },
        {
          "key": "address1",
          "label": "Address",
          "type": "string"
        },
        {
          "key": "city",
          "label": "City",
          "type": "string"
        },
        {
          "key": "state",
          "label": "State",
          "type": "string"
        },
        {
          "key": "zip",
          "label": "ZIP code",
          "type": "string"
        },
        {
          "key": "country",
          "label": "Country",
          "type": "string"
        },
        {
          "key": "notes",
          "label": "Notes",
          "type": "text"
        }
      ]
    },
    {
      "key": "get_contact",
      "name": "Get contact",
      "method": "GET",
      "endpoint": "/contacts/{{ inputs.contact_id }}",
      "inputs": [
        {
          "key": "contact_id",
          "label": "Contact ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "find_contact",
      "name": "Find contact by email",
      "method": "GET",
      "endpoint": "/contacts",
      "query": {
        "email_address": "{{ inputs.email }}"
      },
      "output_fields": {
        "contact_id": "contacts.contacts.0.contact_user_id",
        "contacts": "contacts.contacts"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "delete_contact",
      "name": "Delete contact",
      "description": "Moves the contact to the trash.",
      "method": "DELETE",
      "endpoint": "/contacts/{{ inputs.contact_id }}",
      "inputs": [
        {
          "key": "contact_id",
          "label": "Contact ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_folders",
      "name": "List folders",
      "description": "Lists your contact folders and their IDs.",
      "method": "GET",
      "endpoint": "/folders",
      "inputs": []
    }
  ],
  "triggers": [
    {
      "key": "new_contact",
      "name": "New contact",
      "type": "polling",
      "method": "GET",
      "endpoint": "/contacts",
      "query": {
        "sort_order": "DESC",
        "page_size": 50
      },
      "items_path": "contacts.contacts",
      "id_field": "contact_user_id",
      "inputs": [
        {
          "key": "poll_interval",
          "label": "Check every (minutes)",
          "type": "number",
          "default": 5
        }
      ]
    }
  ]
}
