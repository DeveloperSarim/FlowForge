{
  "key": "social_blade",
  "name": "Social Blade",
  "category": "Social Media",
  "description": "Get follower, view and growth statistics for YouTube, TikTok, Instagram and Twitch.",
  "website": "https://socialblade.com",
  "docs_url": "https://socialblade.com/developers/docs",
  "base_url": "https://matrix.sbapis.com/b",
  "headers": {
    "clientid": "{{ credentials.client_id }}"
  },
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "token",
    "fields": [
      {
        "key": "client_id",
        "label": "Client ID",
        "type": "string",
        "required": true,
        "help": "socialblade.com → Developers → Console → Client ID."
      },
      {
        "key": "api_key",
        "label": "Access token",
        "type": "password",
        "required": true,
        "help": "Shown next to the Client ID in the Developer Console."
      }
    ]
  },
  "actions": [
    {
      "key": "youtube_statistics",
      "name": "Get YouTube statistics",
      "description": "Costs 1 credit per account (free to re-read for 30 days).",
      "method": "GET",
      "endpoint": "/youtube/statistics",
      "query": {
        "query": "{{ inputs.query }}",
        "history": "{{ inputs.history }}"
      },
      "error_path": "status.error",
      "output_fields": {
        "id": "data.id.id",
        "username": "data.id.username",
        "display_name": "data.id.display_name",
        "daily": "data.daily",
        "credits_left": "info.credits.available",
        "subscribers": "data.statistics.total.subscribers",
        "views": "data.statistics.total.views",
        "uploads": "data.statistics.total.uploads"
      },
      "inputs": [
        {
          "key": "query",
          "label": "Account",
          "type": "string",
          "required": true,
          "placeholder": "@mrbeast",
          "help": "Username, @handle or channel ID."
        },
        {
          "key": "history",
          "label": "History",
          "type": "select",
          "default": "default",
          "options": [
            {
              "value": "default",
              "label": "Last 30 days"
            },
            {
              "value": "extended",
              "label": "Extended (more credits)"
            },
            {
              "value": "archive",
              "label": "Archive (more credits)"
            }
          ]
        }
      ]
    },
    {
      "key": "tiktok_statistics",
      "name": "Get TikTok statistics",
      "description": "Costs 1 credit per account (free to re-read for 30 days).",
      "method": "GET",
      "endpoint": "/tiktok/statistics",
      "query": {
        "query": "{{ inputs.query }}",
        "history": "{{ inputs.history }}"
      },
      "error_path": "status.error",
      "output_fields": {
        "id": "data.id.id",
        "username": "data.id.username",
        "display_name": "data.id.display_name",
        "daily": "data.daily",
        "credits_left": "info.credits.available",
        "followers": "data.statistics.total.followers",
        "following": "data.statistics.total.following",
        "likes": "data.statistics.total.likes",
        "uploads": "data.statistics.total.uploads"
      },
      "inputs": [
        {
          "key": "query",
          "label": "Account",
          "type": "string",
          "required": true,
          "placeholder": "@mrbeast",
          "help": "Username, @handle or channel ID."
        },
        {
          "key": "history",
          "label": "History",
          "type": "select",
          "default": "default",
          "options": [
            {
              "value": "default",
              "label": "Last 30 days"
            },
            {
              "value": "extended",
              "label": "Extended (more credits)"
            },
            {
              "value": "archive",
              "label": "Archive (more credits)"
            }
          ]
        }
      ]
    },
    {
      "key": "instagram_statistics",
      "name": "Get Instagram statistics",
      "description": "Costs 1 credit per account (free to re-read for 30 days).",
      "method": "GET",
      "endpoint": "/instagram/statistics",
      "query": {
        "query": "{{ inputs.query }}",
        "history": "{{ inputs.history }}"
      },
      "error_path": "status.error",
      "output_fields": {
        "id": "data.id.id",
        "username": "data.id.username",
        "display_name": "data.id.display_name",
        "daily": "data.daily",
        "credits_left": "info.credits.available",
        "followers": "data.statistics.total.followers",
        "following": "data.statistics.total.following",
        "media": "data.statistics.total.media",
        "engagement_rate": "data.statistics.total.engagement_rate"
      },
      "inputs": [
        {
          "key": "query",
          "label": "Account",
          "type": "string",
          "required": true,
          "placeholder": "@mrbeast",
          "help": "Username, @handle or channel ID."
        },
        {
          "key": "history",
          "label": "History",
          "type": "select",
          "default": "default",
          "options": [
            {
              "value": "default",
              "label": "Last 30 days"
            },
            {
              "value": "extended",
              "label": "Extended (more credits)"
            },
            {
              "value": "archive",
              "label": "Archive (more credits)"
            }
          ]
        }
      ]
    },
    {
      "key": "other_statistics",
      "name": "Get Twitch or Facebook statistics",
      "method": "GET",
      "endpoint": "/{{ inputs.platform }}/statistics",
      "query": {
        "query": "{{ inputs.query }}",
        "history": "{{ inputs.history }}"
      },
      "error_path": "status.error",
      "output_fields": {
        "id": "data.id.id",
        "username": "data.id.username",
        "display_name": "data.id.display_name",
        "daily": "data.daily",
        "credits_left": "info.credits.available",
        "totals": "data.statistics.total"
      },
      "inputs": [
        {
          "key": "platform",
          "label": "Platform",
          "type": "select",
          "required": true,
          "default": "twitch",
          "options": [
            {
              "value": "twitch",
              "label": "Twitch"
            },
            {
              "value": "facebook",
              "label": "Facebook"
            }
          ]
        },
        {
          "key": "query",
          "label": "Account",
          "type": "string",
          "required": true,
          "placeholder": "@mrbeast",
          "help": "Username, @handle or channel ID."
        },
        {
          "key": "history",
          "label": "History",
          "type": "select",
          "default": "default",
          "options": [
            {
              "value": "default",
              "label": "Last 30 days"
            },
            {
              "value": "extended",
              "label": "Extended (more credits)"
            },
            {
              "value": "archive",
              "label": "Archive (more credits)"
            }
          ]
        }
      ]
    },
    {
      "key": "top_list",
      "name": "Get top accounts",
      "description": "First page is free.",
      "method": "GET",
      "endpoint": "/{{ inputs.platform }}/top",
      "query": {
        "query": "{{ inputs.query }}",
        "page": "0"
      },
      "error_path": "status.error",
      "output_fields": {
        "accounts": "data"
      },
      "inputs": [
        {
          "key": "platform",
          "label": "Platform",
          "type": "select",
          "required": true,
          "default": "youtube",
          "options": [
            {
              "value": "youtube",
              "label": "YouTube"
            },
            {
              "value": "tiktok",
              "label": "TikTok"
            },
            {
              "value": "instagram",
              "label": "Instagram"
            },
            {
              "value": "twitch",
              "label": "Twitch"
            },
            {
              "value": "facebook",
              "label": "Facebook"
            }
          ]
        },
        {
          "key": "query",
          "label": "Ranked by",
          "type": "string",
          "required": true,
          "default": "followers",
          "help": "e.g. subscribers or views for YouTube, followers for the others."
        }
      ]
    }
  ]
}
