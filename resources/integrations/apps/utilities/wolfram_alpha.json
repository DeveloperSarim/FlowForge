{
  "key": "wolfram_alpha",
  "name": "Wolfram|Alpha",
  "category": "Utilities",
  "description": "Ask computational questions: math, units, science, facts and data.",
  "brand": "wolfram",
  "website": "https://www.wolframalpha.com",
  "docs_url": "https://products.wolframalpha.com/api/documentation",
  "base_url": "https://api.wolframalpha.com",
  "auth": { "type": "api_key", "in": "query", "name": "appid", "fields": [
    { "key": "api_key", "label": "AppID", "type": "password", "required": true, "help": "From developer.wolframalpha.com → My Apps. Each API type needs its own enabled AppID." }
  ] },
  "actions": [
    {
      "key": "short_answer",
      "name": "Get short answer",
      "description": "A single line of plain text, e.g. \"How far is Los Angeles from New York?\".",
      "method": "GET",
      "endpoint": "/v1/result",
      "query": { "i": "{{ inputs.question }}", "units": "{{ inputs.units }}" },
      "inputs": [
        { "key": "question", "label": "Question", "type": "string", "required": true },
        { "key": "units", "label": "Units", "type": "select", "options": [{ "value": "", "label": "Default" }, { "value": "metric", "label": "Metric" }, { "value": "imperial", "label": "Imperial" }] }
      ]
    },
    {
      "key": "llm_query",
      "name": "Query for LLMs",
      "description": "Text result formatted for AI agents (LLM API).",
      "method": "GET",
      "endpoint": "/v1/llm-api",
      "query": { "input": "{{ inputs.input }}", "maxchars": "{{ inputs.maxchars }}" },
      "inputs": [
        { "key": "input", "label": "Query", "type": "string", "required": true },
        { "key": "maxchars", "label": "Max characters", "type": "number", "default": 6800 }
      ]
    },
    {
      "key": "full_results",
      "name": "Get full results",
      "description": "All result pods as JSON plain text (Full Results API).",
      "method": "GET",
      "endpoint": "/v2/query",
      "query": { "input": "{{ inputs.input }}", "output": "json", "format": "plaintext", "units": "{{ inputs.units }}" },
      "output_path": "queryresult",
      "timeout": 60,
      "inputs": [
        { "key": "input", "label": "Query", "type": "string", "required": true },
        { "key": "units", "label": "Units", "type": "select", "options": [{ "value": "", "label": "Default" }, { "value": "metric", "label": "Metric" }, { "value": "nonmetric", "label": "Non-metric" }] }
      ]
    }
  ]
}
