{
  "key": "meistertask",
  "name": "MeisterTask",
  "category": "Project Management",
  "description": "Create, update and comment on MeisterTask tasks.",
  "brand": "meistertask",
  "website": "https://www.meistertask.com",
  "docs_url": "https://developers.meistertask.com/reference",
  "base_url": "https://www.meistertask.com/api",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "Personal access token",
        "type": "password",
        "required": true,
        "help": "developers.meistertask.com > Personal access tokens."
      }
    ]
  },
  "actions": [
    {
      "key": "list_projects",
      "name": "List projects",
      "method": "GET",
      "endpoint": "/projects",
      "inputs": []
    },
    {
      "key": "list_sections",
      "name": "List sections",
      "method": "GET",
      "endpoint": "/projects/{{ inputs.project_id }}/sections",
      "inputs": [
        {
          "key": "project_id",
          "label": "Project ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "create_task",
      "name": "Create task",
      "method": "POST",
      "endpoint": "/sections/{{ inputs.section_id }}/tasks",
      "body": {
        "name": "{{ inputs.name }}",
        "notes": "{{ inputs.notes }}",
        "assigned_to_id": "{{ inputs.assigned_to_id }}",
        "due": "{{ inputs.due }}"
      },
      "inputs": [
        {
          "key": "section_id",
          "label": "Section ID",
          "type": "string",
          "required": true
        },
        {
          "key": "name",
          "label": "Name",
          "type": "string",
          "required": true
        },
        {
          "key": "notes",
          "label": "Notes",
          "type": "text"
        },
        {
          "key": "assigned_to_id",
          "label": "Assignee person ID",
          "type": "number"
        },
        {
          "key": "due",
          "label": "Due",
          "type": "string",
          "placeholder": "2026-10-12T17:00:00Z"
        }
      ]
    },
    {
      "key": "get_task",
      "name": "Get task",
      "method": "GET",
      "endpoint": "/tasks/{{ inputs.task_id }}",
      "inputs": [
        {
          "key": "task_id",
          "label": "Task ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "update_task",
      "name": "Update task",
      "method": "PUT",
      "endpoint": "/tasks/{{ inputs.task_id }}",
      "body": {
        "name": "{{ inputs.name }}",
        "notes": "{{ inputs.notes }}",
        "section_id": "{{ inputs.section_id }}",
        "status": "{{ inputs.status }}",
        "due": "{{ inputs.due }}"
      },
      "inputs": [
        {
          "key": "task_id",
          "label": "Task ID",
          "type": "string",
          "required": true
        },
        {
          "key": "name",
          "label": "Name",
          "type": "string"
        },
        {
          "key": "notes",
          "label": "Notes",
          "type": "text"
        },
        {
          "key": "section_id",
          "label": "Move to section ID",
          "type": "number"
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "options": [
            {
              "value": "1",
              "label": "Open"
            },
            {
              "value": "2",
              "label": "Completed"
            }
          ]
        },
        {
          "key": "due",
          "label": "Due",
          "type": "string"
        }
      ]
    },
    {
      "key": "add_comment",
      "name": "Add comment",
      "method": "POST",
      "endpoint": "/tasks/{{ inputs.task_id }}/comments",
      "body": {
        "text": "{{ inputs.text }}"
      },
      "inputs": [
        {
          "key": "task_id",
          "label": "Task ID",
          "type": "string",
          "required": true
        },
        {
          "key": "text",
          "label": "Comment (Markdown)",
          "type": "text",
          "required": true
        }
      ]
    }
  ]
}
