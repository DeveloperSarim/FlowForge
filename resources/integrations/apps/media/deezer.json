{
  "key": "deezer",
  "name": "Deezer",
  "category": "Video & Media",
  "description": "Search Deezer's catalogue and look up tracks, albums, artists and charts.",
  "brand": "deezer",
  "website": "https://www.deezer.com",
  "docs_url": "https://developers.deezer.com/api",
  "base_url": "https://api.deezer.com",
  "auth": { "type": "none" },
  "actions": [
    {
      "key": "search_tracks",
      "name": "Search tracks",
      "method": "GET",
      "endpoint": "/search",
      "error_path": "error",
      "query": { "q": "{{ inputs.q }}", "limit": "{{ inputs.limit }}" },
      "inputs": [
        { "key": "q", "label": "Query", "type": "string", "required": true, "placeholder": "daft punk", "help": "Supports filters like artist:\"daft punk\" track:\"harder\"." },
        { "key": "limit", "label": "Limit", "type": "number", "default": 25 }
      ]
    },
    {
      "key": "search_artists",
      "name": "Search artists",
      "method": "GET",
      "endpoint": "/search/artist",
      "error_path": "error",
      "query": { "q": "{{ inputs.q }}", "limit": "{{ inputs.limit }}" },
      "inputs": [
        { "key": "q", "label": "Query", "type": "string", "required": true, "placeholder": "daft punk" },
        { "key": "limit", "label": "Limit", "type": "number", "default": 25 }
      ]
    },
    {
      "key": "search_albums",
      "name": "Search albums",
      "method": "GET",
      "endpoint": "/search/album",
      "error_path": "error",
      "query": { "q": "{{ inputs.q }}", "limit": "{{ inputs.limit }}" },
      "inputs": [
        { "key": "q", "label": "Query", "type": "string", "required": true, "placeholder": "discovery" },
        { "key": "limit", "label": "Limit", "type": "number", "default": 25 }
      ]
    },
    {
      "key": "get_track",
      "name": "Get track",
      "method": "GET",
      "endpoint": "/track/{{ inputs.track_id }}",
      "error_path": "error",
      "inputs": [{ "key": "track_id", "label": "Track ID", "type": "string", "required": true, "placeholder": "3135556" }]
    },
    {
      "key": "get_album",
      "name": "Get album",
      "method": "GET",
      "endpoint": "/album/{{ inputs.album_id }}",
      "error_path": "error",
      "inputs": [{ "key": "album_id", "label": "Album ID", "type": "string", "required": true, "placeholder": "302127" }]
    },
    {
      "key": "get_artist_top_tracks",
      "name": "Get artist top tracks",
      "method": "GET",
      "endpoint": "/artist/{{ inputs.artist_id }}/top",
      "error_path": "error",
      "query": { "limit": "{{ inputs.limit }}" },
      "inputs": [
        { "key": "artist_id", "label": "Artist ID", "type": "string", "required": true, "placeholder": "27" },
        { "key": "limit", "label": "Limit", "type": "number", "default": 10 }
      ]
    },
    {
      "key": "get_chart",
      "name": "Get charts",
      "description": "Top tracks, albums, artists and playlists.",
      "method": "GET",
      "endpoint": "/chart/0",
      "error_path": "error",
      "inputs": []
    }
  ]
}
