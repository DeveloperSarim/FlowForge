{
  "key": "dub",
  "name": "Dub",
  "category": "Utilities",
  "description": "Create and manage branded short links and track clicks, leads and sales.",
  "website": "https://dub.co",
  "docs_url": "https://dub.co/docs/api-reference/introduction",
  "base_url": "https://api.dub.co",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "app.dub.co → Settings → API Keys → Create (starts with dub_)."
      }
    ]
  },
  "actions": [
    {
      "key": "create_link",
      "name": "Create short link",
      "description": "Shorten a URL.",
      "method": "POST",
      "endpoint": "/links",
      "body": {
        "url": "{{ inputs.url }}",
        "domain": "{{ inputs.domain }}",
        "key": "{{ inputs.key }}",
        "title": "{{ inputs.title }}",
        "description": "{{ inputs.description }}",
        "tagNames": "{{ inputs.tag_names }}",
        "externalId": "{{ inputs.external_id }}",
        "expiresAt": "{{ inputs.expires_at }}",
        "utm_source": "{{ inputs.utm_source }}",
        "utm_medium": "{{ inputs.utm_medium }}",
        "utm_campaign": "{{ inputs.utm_campaign }}",
        "comments": "{{ inputs.comments }}"
      },
      "output_fields": {
        "id": "id",
        "short_link": "shortLink",
        "qr_code_url": "qrCode",
        "clicks": "clicks"
      },
      "inputs": [
        {
          "key": "url",
          "label": "Destination URL",
          "type": "string",
          "required": true
        },
        {
          "key": "domain",
          "label": "Domain",
          "type": "string",
          "placeholder": "dub.sh",
          "help": "Leave empty to use your workspace's default domain."
        },
        {
          "key": "key",
          "label": "Custom slug",
          "type": "string",
          "placeholder": "summer-sale",
          "help": "The part after the domain. Random if empty."
        },
        {
          "key": "title",
          "label": "Preview title",
          "type": "string"
        },
        {
          "key": "description",
          "label": "Preview description",
          "type": "text"
        },
        {
          "key": "tag_names",
          "label": "Tags",
          "type": "list"
        },
        {
          "key": "external_id",
          "label": "Your own ID",
          "type": "string",
          "help": "Optional ID from your system, to find the link later."
        },
        {
          "key": "expires_at",
          "label": "Expires at",
          "type": "string",
          "placeholder": "2026-12-31T23:59:59Z"
        },
        {
          "key": "utm_source",
          "label": "UTM source",
          "type": "string"
        },
        {
          "key": "utm_medium",
          "label": "UTM medium",
          "type": "string"
        },
        {
          "key": "utm_campaign",
          "label": "UTM campaign",
          "type": "string"
        },
        {
          "key": "comments",
          "label": "Notes",
          "type": "text"
        }
      ]
    },
    {
      "key": "upsert_link",
      "name": "Create or get short link",
      "description": "Return the existing short link for this URL, or create one.",
      "method": "POST",
      "endpoint": "/links/upsert",
      "body": {
        "url": "{{ inputs.url }}",
        "domain": "{{ inputs.domain }}",
        "key": "{{ inputs.key }}",
        "title": "{{ inputs.title }}",
        "description": "{{ inputs.description }}",
        "tagNames": "{{ inputs.tag_names }}",
        "externalId": "{{ inputs.external_id }}",
        "expiresAt": "{{ inputs.expires_at }}",
        "utm_source": "{{ inputs.utm_source }}",
        "utm_medium": "{{ inputs.utm_medium }}",
        "utm_campaign": "{{ inputs.utm_campaign }}",
        "comments": "{{ inputs.comments }}"
      },
      "output_fields": {
        "id": "id",
        "short_link": "shortLink",
        "qr_code_url": "qrCode",
        "clicks": "clicks"
      },
      "inputs": [
        {
          "key": "url",
          "label": "Destination URL",
          "type": "string",
          "required": true
        },
        {
          "key": "domain",
          "label": "Domain",
          "type": "string",
          "placeholder": "dub.sh",
          "help": "Leave empty to use your workspace's default domain."
        },
        {
          "key": "key",
          "label": "Custom slug",
          "type": "string",
          "placeholder": "summer-sale",
          "help": "The part after the domain. Random if empty."
        },
        {
          "key": "title",
          "label": "Preview title",
          "type": "string"
        },
        {
          "key": "description",
          "label": "Preview description",
          "type": "text"
        },
        {
          "key": "tag_names",
          "label": "Tags",
          "type": "list"
        },
        {
          "key": "external_id",
          "label": "Your own ID",
          "type": "string",
          "help": "Optional ID from your system, to find the link later."
        },
        {
          "key": "expires_at",
          "label": "Expires at",
          "type": "string",
          "placeholder": "2026-12-31T23:59:59Z"
        },
        {
          "key": "utm_source",
          "label": "UTM source",
          "type": "string"
        },
        {
          "key": "utm_medium",
          "label": "UTM medium",
          "type": "string"
        },
        {
          "key": "utm_campaign",
          "label": "UTM campaign",
          "type": "string"
        },
        {
          "key": "comments",
          "label": "Notes",
          "type": "text"
        }
      ]
    },
    {
      "key": "get_link",
      "name": "Get link",
      "description": "Find one link by ID, by domain + slug, or by your own ID.",
      "method": "GET",
      "endpoint": "/links/info",
      "query": {
        "linkId": "{{ inputs.link_id }}",
        "domain": "{{ inputs.domain }}",
        "key": "{{ inputs.key }}",
        "externalId": "{{ inputs.external_id }}"
      },
      "output_fields": {
        "id": "id",
        "short_link": "shortLink",
        "qr_code_url": "qrCode",
        "clicks": "clicks"
      },
      "inputs": [
        {
          "key": "link_id",
          "label": "Link ID",
          "type": "string"
        },
        {
          "key": "domain",
          "label": "Domain",
          "type": "string"
        },
        {
          "key": "key",
          "label": "Slug",
          "type": "string",
          "help": "With Domain, e.g. dub.sh + summer-sale."
        },
        {
          "key": "external_id",
          "label": "Your own ID",
          "type": "string"
        }
      ]
    },
    {
      "key": "update_link",
      "name": "Update link",
      "description": "Change a link's destination, slug, tags or expiry.",
      "method": "PATCH",
      "endpoint": "/links/{{ inputs.link_id }}",
      "body": {
        "url": "{{ inputs.url }}",
        "key": "{{ inputs.key }}",
        "title": "{{ inputs.title }}",
        "tagNames": "{{ inputs.tag_names }}",
        "expiresAt": "{{ inputs.expires_at }}"
      },
      "output_fields": {
        "id": "id",
        "short_link": "shortLink",
        "qr_code_url": "qrCode",
        "clicks": "clicks"
      },
      "inputs": [
        {
          "key": "link_id",
          "label": "Link ID",
          "type": "string",
          "required": true
        },
        {
          "key": "url",
          "label": "New destination URL",
          "type": "string"
        },
        {
          "key": "key",
          "label": "New slug",
          "type": "string"
        },
        {
          "key": "title",
          "label": "Preview title",
          "type": "string"
        },
        {
          "key": "tag_names",
          "label": "Tags",
          "type": "list"
        },
        {
          "key": "expires_at",
          "label": "Expires at",
          "type": "string"
        }
      ]
    },
    {
      "key": "delete_link",
      "name": "Delete link",
      "description": "Delete a short link.",
      "method": "DELETE",
      "endpoint": "/links/{{ inputs.link_id }}",
      "inputs": [
        {
          "key": "link_id",
          "label": "Link ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_links",
      "name": "List links",
      "description": "List the links in your workspace, newest first.",
      "method": "GET",
      "endpoint": "/links",
      "query": {
        "search": "{{ inputs.search }}",
        "domain": "{{ inputs.domain }}",
        "pageSize": "{{ inputs.page_size }}"
      },
      "inputs": [
        {
          "key": "search",
          "label": "Search",
          "type": "string",
          "help": "Matches the slug and destination URL."
        },
        {
          "key": "domain",
          "label": "Domain",
          "type": "string"
        },
        {
          "key": "page_size",
          "label": "How many",
          "type": "number",
          "default": 50
        }
      ]
    },
    {
      "key": "get_link_stats",
      "name": "Get click stats",
      "description": "Total clicks, leads and sales for a link or the workspace (Pro plan).",
      "method": "GET",
      "endpoint": "/analytics",
      "query": {
        "event": "composite",
        "groupBy": "count",
        "linkId": "{{ inputs.link_id }}",
        "interval": "{{ inputs.interval }}"
      },
      "output_fields": {
        "clicks": "clicks",
        "leads": "leads",
        "sales": "sales",
        "sale_amount_cents": "saleAmount"
      },
      "inputs": [
        {
          "key": "link_id",
          "label": "Link ID",
          "type": "string",
          "help": "Leave empty for the whole workspace."
        },
        {
          "key": "interval",
          "label": "Period",
          "type": "select",
          "default": "30d",
          "options": [
            {
              "value": "24h",
              "label": "Last 24 hours"
            },
            {
              "value": "7d",
              "label": "Last 7 days"
            },
            {
              "value": "30d",
              "label": "Last 30 days"
            },
            {
              "value": "90d",
              "label": "Last 90 days"
            },
            {
              "value": "1y",
              "label": "Last year"
            },
            {
              "value": "all",
              "label": "All time"
            }
          ]
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "new_link",
      "name": "New link",
      "type": "polling",
      "description": "A short link was created in the workspace.",
      "method": "GET",
      "endpoint": "/links",
      "query": {
        "pageSize": 50
      },
      "id_field": "id",
      "inputs": [
        {
          "key": "poll_interval",
          "label": "Check every (minutes)",
          "type": "number",
          "default": 5
        }
      ]
    }
  ]
}
