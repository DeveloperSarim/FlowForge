{
  "key": "apostrophe",
  "name": "ApostropheCMS",
  "category": "CMS & Websites",
  "description": "Create, update, publish and list pieces through the Apostrophe REST API.",
  "brand": "apostrophe",
  "website": "https://apostrophecms.com",
  "docs_url": "https://docs.apostrophecms.org/reference/api/pieces.html",
  "base_url": "{{ credentials.base_url }}/api/v1",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "Authorization",
      "prefix": "ApiKey ",
      "fields": [
        {
          "key": "base_url",
          "label": "Site URL",
          "type": "string",
          "required": true,
          "placeholder": "https://www.example.com",
          "help": "No trailing slash."
        },
        {
          "key": "api_key",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Configured in @apostrophecms/express apiKeys."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_pieces",
      "name": "List pieces",
      "method": "GET",
      "endpoint": "/{{ inputs.piece_type }}",
      "query": {
        "page": "{{ inputs.page }}"
      },
      "inputs": [
        {
          "key": "piece_type",
          "label": "Piece type",
          "type": "string",
          "required": true,
          "placeholder": "article"
        },
        {
          "key": "page",
          "label": "Page",
          "type": "number"
        }
      ]
    },
    {
      "key": "get_piece",
      "name": "Get piece",
      "method": "GET",
      "endpoint": "/{{ inputs.piece_type }}/{{ inputs.id }}",
      "inputs": [
        {
          "key": "piece_type",
          "label": "Piece type",
          "type": "string",
          "required": true
        },
        {
          "key": "id",
          "label": "Piece _id",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "create_piece",
      "name": "Create piece",
      "method": "POST",
      "endpoint": "/{{ inputs.piece_type }}",
      "body": "{{ inputs.data }}",
      "inputs": [
        {
          "key": "piece_type",
          "label": "Piece type",
          "type": "string",
          "required": true
        },
        {
          "key": "data",
          "label": "Fields",
          "type": "json",
          "required": true,
          "placeholder": "{\"title\": \"Hello\", \"slug\": \"hello\"}"
        }
      ]
    },
    {
      "key": "update_piece",
      "name": "Update piece",
      "method": "PATCH",
      "endpoint": "/{{ inputs.piece_type }}/{{ inputs.id }}",
      "body": "{{ inputs.data }}",
      "inputs": [
        {
          "key": "piece_type",
          "label": "Piece type",
          "type": "string",
          "required": true
        },
        {
          "key": "id",
          "label": "Piece _id",
          "type": "string",
          "required": true
        },
        {
          "key": "data",
          "label": "Changed fields",
          "type": "json",
          "required": true
        }
      ]
    },
    {
      "key": "publish_piece",
      "name": "Publish piece",
      "method": "POST",
      "endpoint": "/{{ inputs.piece_type }}/{{ inputs.id }}/publish",
      "inputs": [
        {
          "key": "piece_type",
          "label": "Piece type",
          "type": "string",
          "required": true
        },
        {
          "key": "id",
          "label": "Piece _id",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "delete_piece",
      "name": "Delete piece",
      "method": "DELETE",
      "endpoint": "/{{ inputs.piece_type }}/{{ inputs.id }}",
      "inputs": [
        {
          "key": "piece_type",
          "label": "Piece type",
          "type": "string",
          "required": true
        },
        {
          "key": "id",
          "label": "Piece _id",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
