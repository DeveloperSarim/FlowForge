{
  "key": "se_ranking",
  "name": "SE Ranking",
  "category": "Ads & SEO",
  "description": "List rank-tracking projects, their keywords and daily search positions.",
  "brand": "seranking",
  "website": "https://seranking.com",
  "docs_url": "https://seranking.com/api.html",
  "base_url": "https://api4.seranking.com",
  "auth": { "type": "api_key", "in": "header", "name": "Authorization", "prefix": "Token ", "fields": [{ "key": "api_key", "label": "Project API key", "type": "password", "required": true, "help": "Settings > API." }] },
  "actions": [
    {
      "key": "list_projects",
      "name": "List projects",
      "method": "GET",
      "endpoint": "/sites",
      "inputs": []
    },
    {
      "key": "list_keywords",
      "name": "List project keywords",
      "method": "GET",
      "endpoint": "/sites/{{ inputs.site_id }}/keywords",
      "inputs": [{ "key": "site_id", "label": "Project (site) ID", "type": "string", "required": true }]
    },
    {
      "key": "get_positions",
      "name": "Get keyword positions",
      "method": "GET",
      "endpoint": "/sites/{{ inputs.site_id }}/positions",
      "query": { "date_from": "{{ inputs.date_from }}", "date_to": "{{ inputs.date_to }}", "site_engine_id": "{{ inputs.site_engine_id }}" },
      "inputs": [
        { "key": "site_id", "label": "Project (site) ID", "type": "string", "required": true },
        { "key": "date_from", "label": "From (YYYY-MM-DD)", "type": "string" },
        { "key": "date_to", "label": "To (YYYY-MM-DD)", "type": "string" },
        { "key": "site_engine_id", "label": "Search engine ID", "type": "string", "help": "Limit to one of the project's search engines." }
      ]
    }
  ]
}
