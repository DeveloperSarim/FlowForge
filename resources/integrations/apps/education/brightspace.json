{
  "key": "brightspace",
  "name": "D2L Brightspace",
  "category": "Education",
  "description": "Call the Brightspace Learning Platform APIs (users, enrollments, grades).",
  "brand": "d2l",
  "website": "https://www.d2l.com/brightspace/",
  "docs_url": "https://docs.valence.desire2learn.com/reference.html",
  "base_url": "https://{{ credentials.host }}/d2l/api",
  "auth": [
    {
      "type": "oauth2",
      "authorize_url": "https://auth.brightspace.com/oauth2/auth",
      "token_url": "https://auth.brightspace.com/core/connect/token",
      "scopes": [
        "{{ credentials.scopes }}"
      ],
      "fields": [
        {
          "key": "host",
          "label": "Brightspace host",
          "type": "string",
          "required": true,
          "placeholder": "school.brightspace.com"
        },
        {
          "key": "scopes",
          "label": "Scopes",
          "type": "string",
          "required": true,
          "placeholder": "users:userdata:read enrollment:orgunit:read",
          "help": "Space-separated, exactly as registered on your OAuth2 app."
        }
      ]
    }
  ],
  "actions": []
}
