{
  "key": "line_works",
  "name": "LINE WORKS",
  "category": "Communication",
  "description": "Send bot messages to LINE WORKS users and channels, and list users.",
  "brand": "line",
  "website": "https://line-works.com",
  "docs_url": "https://developers.worksmobile.com/en/docs/api",
  "base_url": "https://www.worksapis.com/v1.0",
  "auth": [
    {
      "type": "oauth2",
      "authorize_url": "https://auth.worksmobile.com/oauth2/v2.0/authorize",
      "token_url": "https://auth.worksmobile.com/oauth2/v2.0/token",
      "scopes": ["bot", "user.read"]
    }
  ],
  "actions": [
    {
      "key": "send_to_user",
      "name": "Send bot message to user",
      "method": "POST",
      "endpoint": "/bots/{{ inputs.bot_id }}/users/{{ inputs.user_id }}/messages",
      "body": { "content": { "type": "text", "text": "{{ inputs.text }}" } },
      "inputs": [
        { "key": "bot_id", "label": "Bot ID", "type": "string", "required": true, "help": "Developer Console → Bot. The bot must be added to your domain." },
        { "key": "user_id", "label": "User ID or email", "type": "string", "required": true },
        { "key": "text", "label": "Message", "type": "text", "required": true }
      ]
    },
    {
      "key": "send_to_channel",
      "name": "Send bot message to channel",
      "method": "POST",
      "endpoint": "/bots/{{ inputs.bot_id }}/channels/{{ inputs.channel_id }}/messages",
      "body": { "content": { "type": "text", "text": "{{ inputs.text }}" } },
      "inputs": [
        { "key": "bot_id", "label": "Bot ID", "type": "string", "required": true },
        { "key": "channel_id", "label": "Channel ID", "type": "string", "required": true, "help": "Invite the bot to the group chat first." },
        { "key": "text", "label": "Message", "type": "text", "required": true }
      ]
    },
    {
      "key": "list_users",
      "name": "List users",
      "method": "GET",
      "endpoint": "/users",
      "query": { "count": "{{ inputs.count }}" },
      "output_path": "users",
      "inputs": [
        { "key": "count", "label": "Page size", "type": "number", "default": 100 }
      ]
    }
  ]
}
