{
  "key": "pixeldrain",
  "name": "Pixeldrain",
  "category": "Files & Documents",
  "description": "File sharing: list your files and lists, read file info, delete files.",
  "website": "https://pixeldrain.com",
  "docs_url": "https://pixeldrain.com/api",
  "base_url": "https://pixeldrain.com/api",
  "auth": {
    "type": "basic",
    "fields": [
      {
        "key": "username",
        "label": "Username",
        "type": "string",
        "default": "",
        "help": "Leave empty."
      },
      {
        "key": "password",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "pixeldrain.com/user/api_keys → create a key."
      }
    ]
  },
  "actions": [
    {
      "key": "list_files",
      "name": "List files",
      "description": "Your uploaded files.",
      "method": "GET",
      "endpoint": "/user/files",
      "output_fields": {
        "names": "files.*.name",
        "ids": "files.*.id"
      },
      "inputs": []
    },
    {
      "key": "get_file_info",
      "name": "Get file info",
      "description": "Name, size and downloads.",
      "method": "GET",
      "endpoint": "/file/{{ inputs.id }}/info",
      "output_fields": {
        "name": "name",
        "size": "size",
        "views": "views",
        "downloads": "downloads"
      },
      "inputs": [
        {
          "key": "id",
          "label": "File ID",
          "type": "string",
          "required": true,
          "help": "The code in the pixeldrain.com/u/<ID> link."
        }
      ]
    },
    {
      "key": "delete_file",
      "name": "Delete file",
      "description": "Permanently delete a file.",
      "method": "DELETE",
      "endpoint": "/file/{{ inputs.id }}",
      "inputs": [
        {
          "key": "id",
          "label": "File ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_lists",
      "name": "List collections",
      "description": "Your file lists.",
      "method": "GET",
      "endpoint": "/user/lists",
      "output_fields": {
        "titles": "lists.*.title",
        "ids": "lists.*.id"
      },
      "inputs": []
    }
  ]
}
