{
  "key": "affinity",
  "name": "Affinity",
  "category": "CRM & Sales",
  "description": "Add people, organizations, notes and list entries in Affinity.",
  "brand": "affinity",
  "website": "https://www.affinity.co",
  "docs_url": "https://api-docs.affinity.co/",
  "base_url": "https://api.affinity.co",
  "auth": [
    {
      "type": "basic",
      "fields": [
        {
          "key": "username",
          "label": "Username",
          "type": "string",
          "required": false,
          "default": "",
          "help": "Leave empty."
        },
        {
          "key": "password",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Settings > API."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "create_person",
      "name": "Create person",
      "method": "POST",
      "endpoint": "/persons",
      "body": {
        "first_name": "{{ inputs.first_name }}",
        "last_name": "{{ inputs.last_name }}",
        "emails": "{{ inputs.emails }}"
      },
      "inputs": [
        {
          "key": "first_name",
          "label": "First name",
          "type": "string",
          "required": true
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string",
          "required": true
        },
        {
          "key": "emails",
          "label": "Emails",
          "type": "list",
          "required": true
        }
      ]
    },
    {
      "key": "search_persons",
      "name": "Search persons",
      "method": "GET",
      "endpoint": "/persons",
      "query": {
        "term": "{{ inputs.term }}"
      },
      "output_path": "persons",
      "inputs": [
        {
          "key": "term",
          "label": "Name or email",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "create_organization",
      "name": "Create organization",
      "method": "POST",
      "endpoint": "/organizations",
      "body": {
        "name": "{{ inputs.name }}",
        "domain": "{{ inputs.domain }}"
      },
      "inputs": [
        {
          "key": "name",
          "label": "Name",
          "type": "string",
          "required": true
        },
        {
          "key": "domain",
          "label": "Domain",
          "type": "string",
          "placeholder": "acme.com"
        }
      ]
    },
    {
      "key": "create_note",
      "name": "Create note",
      "method": "POST",
      "endpoint": "/notes",
      "body": {
        "content": "{{ inputs.content }}",
        "person_ids": "{{ inputs.person_ids }}",
        "organization_ids": "{{ inputs.organization_ids }}"
      },
      "inputs": [
        {
          "key": "content",
          "label": "Content",
          "type": "text",
          "required": true
        },
        {
          "key": "person_ids",
          "label": "Person IDs",
          "type": "json",
          "placeholder": "[123]"
        },
        {
          "key": "organization_ids",
          "label": "Organization IDs",
          "type": "json",
          "placeholder": "[456]"
        }
      ]
    },
    {
      "key": "add_list_entry",
      "name": "Add to list",
      "method": "POST",
      "endpoint": "/lists/{{ inputs.list_id }}/list-entries",
      "body": {
        "entity_id": "{{ inputs.entity_id }}"
      },
      "inputs": [
        {
          "key": "list_id",
          "label": "List ID",
          "type": "string",
          "required": true
        },
        {
          "key": "entity_id",
          "label": "Person / organization ID",
          "type": "number",
          "required": true
        }
      ]
    }
  ]
}
