{
  "key": "postgrest",
  "name": "PostgREST",
  "category": "Databases",
  "description": "Select, insert, upsert, update and delete Postgres rows through a PostgREST server.",
  "brand": "postgresql",
  "website": "https://postgrest.org",
  "docs_url": "https://docs.postgrest.org/en/stable/references/api.html",
  "base_url": "{{ credentials.base_url }}",
  "auth": { "type": "bearer", "fields": [
    { "key": "base_url", "label": "PostgREST URL", "type": "string", "required": true, "placeholder": "https://api.example.com", "help": "No trailing slash." },
    { "key": "token", "label": "JWT", "type": "password", "required": true, "help": "Signed with your jwt-secret; its role claim picks the Postgres role (e.g. {\"role\": \"web_user\"})." }
  ] },
  "actions": [
    {
      "key": "select_rows",
      "name": "Select rows",
      "method": "GET",
      "endpoint": "/{{ inputs.table }}",
      "query": { "select": "{{ inputs.select }}", "and": "{{ inputs.filter }}", "order": "{{ inputs.order }}", "limit": "{{ inputs.limit }}", "offset": "{{ inputs.offset }}" },
      "inputs": [
        { "key": "table", "label": "Table or view", "type": "string", "required": true },
        { "key": "select", "label": "Columns", "type": "string", "default": "*", "placeholder": "id,name,orders(total)" },
        { "key": "filter", "label": "Filter", "type": "string", "placeholder": "(status.eq.active,age.gte.18)", "help": "Conditions in parentheses, comma = AND. Operators: eq, neq, gt, gte, lt, lte, like, ilike, is, in.(a,b)." },
        { "key": "order", "label": "Order by", "type": "string", "placeholder": "created_at.desc" },
        { "key": "limit", "label": "Limit", "type": "number", "default": 100 },
        { "key": "offset", "label": "Offset", "type": "number" }
      ]
    },
    {
      "key": "insert_rows",
      "name": "Insert rows",
      "method": "POST",
      "endpoint": "/{{ inputs.table }}",
      "headers": { "Prefer": "return=representation" },
      "body": "{{ inputs.rows }}",
      "inputs": [
        { "key": "table", "label": "Table", "type": "string", "required": true },
        { "key": "rows", "label": "Row or rows (JSON)", "type": "json", "required": true, "placeholder": "{ \"name\": \"Ada\" }", "help": "One object, or an array of objects with the same keys." }
      ]
    },
    {
      "key": "upsert_rows",
      "name": "Upsert rows",
      "method": "POST",
      "endpoint": "/{{ inputs.table }}",
      "query": { "on_conflict": "{{ inputs.on_conflict }}" },
      "headers": { "Prefer": "return=representation,resolution=merge-duplicates" },
      "body": "{{ inputs.rows }}",
      "inputs": [
        { "key": "table", "label": "Table", "type": "string", "required": true },
        { "key": "rows", "label": "Row or rows (JSON)", "type": "json", "required": true },
        { "key": "on_conflict", "label": "Conflict column(s)", "type": "string", "placeholder": "email", "help": "A unique column; defaults to the primary key." }
      ]
    },
    {
      "key": "update_rows",
      "name": "Update rows",
      "method": "PATCH",
      "endpoint": "/{{ inputs.table }}",
      "query": { "and": "{{ inputs.filter }}" },
      "headers": { "Prefer": "return=representation" },
      "body": "{{ inputs.values }}",
      "inputs": [
        { "key": "table", "label": "Table", "type": "string", "required": true },
        { "key": "filter", "label": "Which rows", "type": "string", "required": true, "placeholder": "(id.eq.42)" },
        { "key": "values", "label": "New values (JSON)", "type": "json", "required": true }
      ]
    },
    {
      "key": "delete_rows",
      "name": "Delete rows",
      "method": "DELETE",
      "endpoint": "/{{ inputs.table }}",
      "query": { "and": "{{ inputs.filter }}" },
      "headers": { "Prefer": "return=representation" },
      "inputs": [
        { "key": "table", "label": "Table", "type": "string", "required": true },
        { "key": "filter", "label": "Which rows", "type": "string", "required": true, "placeholder": "(id.eq.42)" }
      ]
    },
    {
      "key": "call_function",
      "name": "Call function (RPC)",
      "method": "POST",
      "endpoint": "/rpc/{{ inputs.function }}",
      "body": "{{ inputs.args }}",
      "inputs": [
        { "key": "function", "label": "Function name", "type": "string", "required": true },
        { "key": "args", "label": "Arguments (JSON)", "type": "json" }
      ]
    }
  ],
  "triggers": [
    {
      "key": "new_row",
      "name": "New row",
      "type": "polling",
      "method": "GET",
      "endpoint": "/{{ inputs.table }}",
      "query": { "order": "{{ inputs.order_column }}.desc", "limit": 50 },
      "id_field": "id",
      "inputs": [
        { "key": "table", "label": "Table", "type": "string", "required": true, "help": "Needs an id column." },
        { "key": "order_column", "label": "Newest-first column", "type": "string", "required": true, "default": "id" },
        { "key": "poll_interval", "label": "Check every (minutes)", "type": "number", "default": 5 }
      ]
    }
  ]
}
