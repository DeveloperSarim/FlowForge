{
  "key": "docraptor",
  "name": "DocRaptor",
  "category": "Files & Documents",
  "description": "Convert HTML to PDF or Excel with the Prince engine.",
  "brand": "docraptor",
  "website": "https://docraptor.com",
  "docs_url": "https://docraptor.com/documentation/api",
  "base_url": "https://api.docraptor.com",
  "auth": [
    {
      "type": "basic",
      "fields": [
        {
          "key": "username",
          "label": "API key",
          "type": "password",
          "required": true
        },
        {
          "key": "password",
          "label": "Password",
          "type": "password",
          "required": false,
          "default": "",
          "help": "Leave empty."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "create_document",
      "name": "Create document",
      "description": "Starts an async conversion; poll Get status for the download URL.",
      "method": "POST",
      "endpoint": "/async_docs",
      "body": {
        "name": "{{ inputs.name }}",
        "document_type": "{{ inputs.document_type }}",
        "document_content": "{{ inputs.html }}",
        "document_url": "{{ inputs.url }}",
        "test": "{{ inputs.test }}"
      },
      "inputs": [
        {
          "key": "html",
          "label": "HTML",
          "type": "code",
          "help": "Or set Document URL."
        },
        {
          "key": "url",
          "label": "Document URL",
          "type": "string"
        },
        {
          "key": "document_type",
          "label": "Output",
          "type": "select",
          "options": [
            {
              "value": "pdf",
              "label": "PDF"
            },
            {
              "value": "xlsx",
              "label": "Excel (xlsx)"
            },
            {
              "value": "xls",
              "label": "Excel (xls)"
            }
          ],
          "required": true,
          "default": "pdf"
        },
        {
          "key": "name",
          "label": "Name",
          "type": "string"
        },
        {
          "key": "test",
          "label": "Test mode (watermarked, free)",
          "type": "boolean",
          "default": true
        }
      ]
    },
    {
      "key": "get_status",
      "name": "Get status",
      "method": "GET",
      "endpoint": "/status/{{ inputs.status_id }}",
      "inputs": [
        {
          "key": "status_id",
          "label": "Status ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
