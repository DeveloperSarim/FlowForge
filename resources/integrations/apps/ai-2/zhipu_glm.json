{
  "key": "zhipu_glm",
  "name": "Z.ai (Zhipu GLM)",
  "category": "AI",
  "description": "Chat with GLM models and generate images on Z.ai / BigModel.",
  "brand": "zai",
  "website": "https://z.ai",
  "docs_url": "https://docs.z.ai/api-reference/llm/chat-completion",
  "base_url": "https://{{ credentials.host }}/api/paas/v4",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "host",
        "label": "Platform",
        "type": "select",
        "required": true,
        "default": "api.z.ai",
        "options": [
          {
            "value": "api.z.ai",
            "label": "International (z.ai)"
          },
          {
            "value": "open.bigmodel.cn",
            "label": "China (bigmodel.cn)"
          }
        ]
      },
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "chat_completion",
      "name": "Chat completion",
      "description": "Send a prompt and get the reply as {{ steps.<id>.text }}.",
      "method": "POST",
      "endpoint": "/chat/completions",
      "timeout": 300,
      "body": {
        "model": "{{ inputs.model }}",
        "messages": [
          {
            "role": "system",
            "content": "{{ inputs.system }}"
          },
          {
            "role": "user",
            "content": "{{ inputs.prompt }}"
          }
        ],
        "temperature": "{{ inputs.temperature }}",
        "max_tokens": "{{ inputs.max_tokens }}"
      },
      "output_fields": {
        "text": "choices.0.message.content"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "default": "glm-5.3"
        },
        {
          "key": "prompt",
          "label": "Prompt",
          "type": "text",
          "required": true
        },
        {
          "key": "system",
          "label": "System prompt",
          "type": "text",
          "required": true,
          "default": "You are a helpful assistant.",
          "help": "Sent as the system message."
        },
        {
          "key": "temperature",
          "label": "Temperature",
          "type": "number",
          "placeholder": "0.7"
        },
        {
          "key": "max_tokens",
          "label": "Max output tokens",
          "type": "number"
        }
      ]
    },
    {
      "key": "generate_image",
      "name": "Generate image",
      "method": "POST",
      "endpoint": "/images/generations",
      "timeout": 300,
      "body": {
        "model": "{{ inputs.model }}",
        "prompt": "{{ inputs.prompt }}",
        "size": "{{ inputs.size }}"
      },
      "output_fields": {
        "url": "data.0.url"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "default": "glm-image"
        },
        {
          "key": "prompt",
          "label": "Prompt",
          "type": "text",
          "required": true
        },
        {
          "key": "size",
          "label": "Size",
          "type": "string",
          "placeholder": "1280x1280"
        }
      ]
    }
  ]
}
