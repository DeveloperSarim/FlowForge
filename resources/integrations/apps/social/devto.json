{
  "key": "devto",
  "name": "DEV Community",
  "category": "Social Media",
  "description": "Publish and update articles on dev.to and list your posts.",
  "brand": "devdotto",
  "website": "https://dev.to",
  "docs_url": "https://developers.forem.com/api/v1",
  "base_url": "https://dev.to/api",
  "headers": {
    "Accept": "application/vnd.forem.api-v1+json"
  },
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "api-key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "dev.to Settings > Extensions > DEV Community API Keys."
      }
    ]
  },
  "actions": [
    {
      "key": "create_article",
      "name": "Create article",
      "method": "POST",
      "endpoint": "/articles",
      "body": {
        "article": {
          "title": "{{ inputs.title }}",
          "body_markdown": "{{ inputs.body_markdown }}",
          "published": "{{ inputs.published }}",
          "tags": "{{ inputs.tags }}",
          "series": "{{ inputs.series }}",
          "canonical_url": "{{ inputs.canonical_url }}",
          "description": "{{ inputs.description }}",
          "main_image": "{{ inputs.main_image }}"
        }
      },
      "inputs": [
        {
          "key": "title",
          "label": "Title",
          "type": "string",
          "required": true
        },
        {
          "key": "body_markdown",
          "label": "Body (Markdown)",
          "type": "text",
          "required": true
        },
        {
          "key": "published",
          "label": "Publish now",
          "type": "boolean",
          "default": false
        },
        {
          "key": "tags",
          "label": "Tags (max 4)",
          "type": "list"
        },
        {
          "key": "series",
          "label": "Series",
          "type": "string"
        },
        {
          "key": "canonical_url",
          "label": "Canonical URL",
          "type": "string"
        },
        {
          "key": "description",
          "label": "Description",
          "type": "string"
        },
        {
          "key": "main_image",
          "label": "Cover image URL",
          "type": "string"
        }
      ]
    },
    {
      "key": "update_article",
      "name": "Update article",
      "method": "PUT",
      "endpoint": "/articles/{{ inputs.id }}",
      "body": {
        "article": {
          "title": "{{ inputs.title }}",
          "body_markdown": "{{ inputs.body_markdown }}",
          "published": "{{ inputs.published }}",
          "tags": "{{ inputs.tags }}",
          "description": "{{ inputs.description }}"
        }
      },
      "inputs": [
        {
          "key": "id",
          "label": "Article ID",
          "type": "number",
          "required": true
        },
        {
          "key": "title",
          "label": "Title",
          "type": "string"
        },
        {
          "key": "body_markdown",
          "label": "Body (Markdown)",
          "type": "text"
        },
        {
          "key": "published",
          "label": "Published",
          "type": "select",
          "help": "Leave empty to keep the current state.",
          "options": [
            {
              "value": "true",
              "label": "Published"
            },
            {
              "value": "false",
              "label": "Draft"
            }
          ]
        },
        {
          "key": "tags",
          "label": "Tags",
          "type": "list"
        },
        {
          "key": "description",
          "label": "Description",
          "type": "string"
        }
      ]
    },
    {
      "key": "get_article",
      "name": "Get article",
      "method": "GET",
      "endpoint": "/articles/{{ inputs.id }}",
      "inputs": [
        {
          "key": "id",
          "label": "Article ID",
          "type": "number",
          "required": true
        }
      ]
    },
    {
      "key": "list_my_articles",
      "name": "List my articles",
      "description": "Published, draft and scheduled articles of the key owner.",
      "method": "GET",
      "endpoint": "/articles/me/all",
      "query": {
        "page": "{{ inputs.page }}",
        "per_page": "{{ inputs.per_page }}"
      },
      "inputs": [
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "default": 1
        },
        {
          "key": "per_page",
          "label": "Per page (max 1000)",
          "type": "number",
          "default": 30
        }
      ]
    }
  ]
}
