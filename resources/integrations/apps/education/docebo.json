{
  "key": "docebo",
  "name": "Docebo",
  "category": "Education",
  "description": "List and create users in Docebo Learn.",
  "brand": "docebo",
  "website": "https://www.docebo.com",
  "docs_url": "https://help.docebo.com",
  "base_url": "https://{{ credentials.domain }}",
  "auth": [
    {
      "type": "oauth2",
      "authorize_url": "https://{{ credentials.domain }}/oauth2/authorize",
      "token_url": "https://{{ credentials.domain }}/oauth2/token",
      "scopes": [
        "api"
      ],
      "fields": [
        {
          "key": "domain",
          "label": "Platform domain",
          "type": "string",
          "required": true,
          "placeholder": "acme.docebosaas.com",
          "help": "Admin menu > API and SSO > API credentials: add an OAuth2 app here."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_users",
      "name": "List users",
      "method": "GET",
      "endpoint": "/manage/v1/user",
      "query": {
        "search_text": "{{ inputs.search_text }}",
        "page_size": "{{ inputs.page_size }}"
      },
      "inputs": [
        {
          "key": "search_text",
          "label": "Search",
          "type": "string"
        },
        {
          "key": "page_size",
          "label": "Per page",
          "type": "number",
          "default": 50
        }
      ]
    },
    {
      "key": "create_user",
      "name": "Create user",
      "method": "POST",
      "endpoint": "/manage/v1/user",
      "body": {
        "userid": "{{ inputs.userid }}",
        "email": "{{ inputs.email }}",
        "password": "{{ inputs.password }}",
        "firstname": "{{ inputs.firstname }}",
        "lastname": "{{ inputs.lastname }}"
      },
      "inputs": [
        {
          "key": "userid",
          "label": "Username",
          "type": "string",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "password",
          "label": "Password",
          "type": "password",
          "required": true
        },
        {
          "key": "firstname",
          "label": "First name",
          "type": "string"
        },
        {
          "key": "lastname",
          "label": "Last name",
          "type": "string"
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "Superadmins: Webhooks app > Add webhook with this URL.",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
