{
  "key": "loops",
  "name": "Loops",
  "category": "Marketing & Email",
  "description": "Manage contacts, send events and transactional email.",
  "brand": "loops",
  "website": "https://loops.so",
  "docs_url": "https://loops.so/docs/api-reference",
  "base_url": "https://app.loops.so/api/v1",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "create_contact",
      "name": "Create contact",
      "method": "POST",
      "endpoint": "/contacts/create",
      "body": {
        "email": "{{ inputs.email }}",
        "firstName": "{{ inputs.first_name }}",
        "lastName": "{{ inputs.last_name }}",
        "userGroup": "{{ inputs.user_group }}",
        "userId": "{{ inputs.user_id }}",
        "source": "{{ inputs.source }}"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "first_name",
          "label": "First name",
          "type": "string"
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "user_group",
          "label": "User group",
          "type": "string"
        },
        {
          "key": "user_id",
          "label": "User ID",
          "type": "string"
        },
        {
          "key": "source",
          "label": "Source",
          "type": "string"
        }
      ]
    },
    {
      "key": "update_contact",
      "name": "Update or create contact",
      "description": "Set Subscribed to false to unsubscribe.",
      "method": "PUT",
      "endpoint": "/contacts/update",
      "body": {
        "email": "{{ inputs.email }}",
        "firstName": "{{ inputs.first_name }}",
        "lastName": "{{ inputs.last_name }}",
        "subscribed": "{{ inputs.subscribed }}",
        "userGroup": "{{ inputs.user_group }}"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "first_name",
          "label": "First name",
          "type": "string"
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "subscribed",
          "label": "Subscribed",
          "type": "boolean"
        },
        {
          "key": "user_group",
          "label": "User group",
          "type": "string"
        }
      ]
    },
    {
      "key": "find_contact",
      "name": "Find contact",
      "method": "GET",
      "endpoint": "/contacts/find",
      "query": {
        "email": "{{ inputs.email }}"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "delete_contact",
      "name": "Delete contact",
      "method": "POST",
      "endpoint": "/contacts/delete",
      "body": {
        "email": "{{ inputs.email }}"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "send_event",
      "name": "Send event",
      "method": "POST",
      "endpoint": "/events/send",
      "body": {
        "email": "{{ inputs.email }}",
        "eventName": "{{ inputs.event_name }}",
        "eventProperties": "{{ inputs.event_properties }}"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "event_name",
          "label": "Event name",
          "type": "string",
          "required": true
        },
        {
          "key": "event_properties",
          "label": "Event properties",
          "type": "json"
        }
      ]
    },
    {
      "key": "send_transactional",
      "name": "Send transactional email",
      "method": "POST",
      "endpoint": "/transactional",
      "body": {
        "transactionalId": "{{ inputs.transactional_id }}",
        "email": "{{ inputs.email }}",
        "dataVariables": "{{ inputs.data_variables }}",
        "addToAudience": "{{ inputs.add_to_audience }}"
      },
      "inputs": [
        {
          "key": "transactional_id",
          "label": "Transactional ID",
          "type": "string",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "data_variables",
          "label": "Data variables",
          "type": "json"
        },
        {
          "key": "add_to_audience",
          "label": "Add to audience",
          "type": "boolean",
          "default": false
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "Settings → Webhooks (contact.created, email.delivered…).",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
