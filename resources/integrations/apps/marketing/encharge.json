{
  "key": "encharge",
  "name": "Encharge",
  "category": "Marketing & Email",
  "description": "Create or update people and tag them.",
  "brand": "encharge",
  "website": "https://encharge.io",
  "docs_url": "https://docs.encharge.io/",
  "base_url": "https://api.encharge.io/v1",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "X-Encharge-Token",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "upsert_person",
      "name": "Create or update person",
      "method": "POST",
      "endpoint": "/people",
      "body": {
        "email": "{{ inputs.email }}",
        "firstName": "{{ inputs.first_name }}",
        "lastName": "{{ inputs.last_name }}",
        "userId": "{{ inputs.user_id }}",
        "tags": "{{ inputs.tags }}"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "first_name",
          "label": "First name",
          "type": "string"
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "user_id",
          "label": "User ID",
          "type": "string"
        },
        {
          "key": "tags",
          "label": "Tags",
          "type": "string",
          "help": "Comma-separated."
        }
      ]
    },
    {
      "key": "add_tag",
      "name": "Add tags",
      "method": "POST",
      "endpoint": "/tags",
      "body": {
        "email": "{{ inputs.email }}",
        "tag": "{{ inputs.tag }}"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "tag",
          "label": "Tags",
          "type": "string",
          "required": true,
          "help": "Comma-separated."
        }
      ]
    }
  ]
}
