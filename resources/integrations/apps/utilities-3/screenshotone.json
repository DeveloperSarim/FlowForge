{
  "key": "screenshotone",
  "name": "ScreenshotOne",
  "category": "Utilities",
  "description": "Take website screenshots, render HTML to images and save web pages as PDF.",
  "website": "https://screenshotone.com",
  "docs_url": "https://screenshotone.com/docs/getting-started/",
  "base_url": "https://api.screenshotone.com",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "X-Access-Key",
    "fields": [
      {
        "key": "api_key",
        "label": "Access key",
        "type": "password",
        "required": true,
        "help": "ScreenshotOne dashboard → Access → copy the Access key."
      }
    ]
  },
  "actions": [
    {
      "key": "take_screenshot",
      "name": "Take screenshot",
      "description": "Screenshot a web page and get a link to the image.",
      "method": "GET",
      "endpoint": "/take",
      "query": {
        "url": "{{ inputs.url }}",
        "format": "{{ inputs.format }}",
        "full_page": "{{ inputs.full_page }}",
        "viewport_width": "{{ inputs.viewport_width }}",
        "viewport_height": "{{ inputs.viewport_height }}",
        "delay": "{{ inputs.delay }}",
        "block_ads": "{{ inputs.block_ads }}",
        "block_cookie_banners": "{{ inputs.block_cookie_banners }}",
        "selector": "{{ inputs.selector }}",
        "response_type": "json"
      },
      "output_fields": {
        "image_url": "screenshot_url"
      },
      "timeout": 120,
      "inputs": [
        {
          "key": "url",
          "label": "Page URL",
          "type": "string",
          "required": true,
          "placeholder": "https://example.com"
        },
        {
          "key": "format",
          "label": "Image format",
          "type": "select",
          "default": "png",
          "options": [
            {
              "value": "png",
              "label": "PNG"
            },
            {
              "value": "jpg",
              "label": "JPG"
            },
            {
              "value": "webp",
              "label": "WebP"
            }
          ]
        },
        {
          "key": "full_page",
          "label": "Capture the full page",
          "type": "boolean",
          "default": false
        },
        {
          "key": "viewport_width",
          "label": "Viewport width (px)",
          "type": "number",
          "default": 1280
        },
        {
          "key": "viewport_height",
          "label": "Viewport height (px)",
          "type": "number",
          "default": 1024
        },
        {
          "key": "delay",
          "label": "Wait before capture (seconds)",
          "type": "number",
          "default": 0
        },
        {
          "key": "block_ads",
          "label": "Block ads",
          "type": "boolean",
          "default": true
        },
        {
          "key": "block_cookie_banners",
          "label": "Hide cookie banners",
          "type": "boolean",
          "default": true
        },
        {
          "key": "selector",
          "label": "Only capture this element (CSS selector)",
          "type": "string",
          "placeholder": "#pricing",
          "help": "Leave empty to capture the page."
        }
      ]
    },
    {
      "key": "render_html",
      "name": "Render HTML to image",
      "description": "Turn your own HTML (e.g. a certificate or social card) into an image.",
      "method": "POST",
      "endpoint": "/take",
      "body": {
        "html": "{{ inputs.html }}",
        "format": "{{ inputs.format }}",
        "full_page": "{{ inputs.full_page }}",
        "viewport_width": "{{ inputs.viewport_width }}",
        "viewport_height": "{{ inputs.viewport_height }}",
        "response_type": "json"
      },
      "output_fields": {
        "image_url": "screenshot_url"
      },
      "timeout": 120,
      "inputs": [
        {
          "key": "html",
          "label": "HTML",
          "type": "text",
          "required": true,
          "placeholder": "<h1>Hello</h1>"
        },
        {
          "key": "format",
          "label": "Image format",
          "type": "select",
          "default": "png",
          "options": [
            {
              "value": "png",
              "label": "PNG"
            },
            {
              "value": "jpg",
              "label": "JPG"
            },
            {
              "value": "webp",
              "label": "WebP"
            }
          ]
        },
        {
          "key": "full_page",
          "label": "Capture the full page",
          "type": "boolean",
          "default": false
        },
        {
          "key": "viewport_width",
          "label": "Viewport width (px)",
          "type": "number",
          "default": 1280
        },
        {
          "key": "viewport_height",
          "label": "Viewport height (px)",
          "type": "number",
          "default": 1024
        }
      ]
    },
    {
      "key": "save_as_pdf",
      "name": "Save page as PDF",
      "description": "Save a web page as a PDF and get a link to the file.",
      "method": "GET",
      "endpoint": "/take",
      "query": {
        "url": "{{ inputs.url }}",
        "format": "pdf",
        "pdf_paper_format": "{{ inputs.pdf_paper_format }}",
        "pdf_landscape": "{{ inputs.pdf_landscape }}",
        "pdf_print_background": "true",
        "response_type": "json"
      },
      "output_fields": {
        "pdf_url": "screenshot_url"
      },
      "timeout": 120,
      "inputs": [
        {
          "key": "url",
          "label": "Page URL",
          "type": "string",
          "required": true,
          "placeholder": "https://example.com"
        },
        {
          "key": "pdf_paper_format",
          "label": "Paper size",
          "type": "select",
          "default": "a4",
          "options": [
            {
              "value": "a4",
              "label": "A4"
            },
            {
              "value": "letter",
              "label": "Letter"
            },
            {
              "value": "legal",
              "label": "Legal"
            }
          ]
        },
        {
          "key": "pdf_landscape",
          "label": "Landscape",
          "type": "boolean",
          "default": false
        }
      ]
    }
  ]
}
