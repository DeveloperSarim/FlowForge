{
  "key": "freshcaller",
  "name": "Freshcaller",
  "category": "Communication",
  "description": "List and fetch calls and users in Freshcaller (Freshdesk Contact Center).",
  "brand": "freshworks",
  "website": "https://www.freshworks.com/freshdesk/contact-center/",
  "docs_url": "https://developers.freshcaller.com/api/",
  "base_url": "https://{{ credentials.domain }}.freshcaller.com/api/v1",
  "auth": [
    { "type": "api_key", "in": "header", "name": "X-Api-Auth", "fields": [
      { "key": "domain", "label": "Subdomain", "type": "string", "required": true, "placeholder": "yourcompany", "help": "The part before .freshcaller.com." },
      { "key": "api_key", "label": "API key", "type": "password", "required": true, "help": "Profile → Profile Settings → API key." }
    ] }
  ],
  "actions": [
    {
      "key": "list_calls",
      "name": "List calls",
      "method": "GET",
      "endpoint": "/calls",
      "query": { "per_page": "{{ inputs.per_page }}", "page": "{{ inputs.page }}" },
      "output_path": "calls",
      "inputs": [
        { "key": "per_page", "label": "Per page", "type": "number", "default": 50 },
        { "key": "page", "label": "Page", "type": "number" }
      ]
    },
    {
      "key": "get_call",
      "name": "Get call",
      "method": "GET",
      "endpoint": "/calls/{{ inputs.call_id }}",
      "output_path": "call",
      "inputs": [
        { "key": "call_id", "label": "Call ID", "type": "string", "required": true }
      ]
    },
    {
      "key": "list_users",
      "name": "List users",
      "method": "GET",
      "endpoint": "/users",
      "output_path": "users",
      "inputs": []
    }
  ]
}
