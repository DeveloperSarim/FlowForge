{
  "key": "motherduck",
  "name": "MotherDuck",
  "category": "Databases",
  "description": "Administer MotherDuck users, access tokens and Duckling settings.",
  "brand": "motherduck",
  "website": "https://motherduck.com",
  "docs_url": "https://motherduck.com/docs/sql-reference/rest-api/motherduck-rest-api/",
  "base_url": "https://api.motherduck.com/v1",
  "auth": { "type": "bearer", "fields": [
    { "key": "token", "label": "Access token", "type": "password", "required": true, "help": "A read/write token of an organization Admin (Settings → Access Tokens)." }
  ] },
  "actions": [
    {
      "key": "list_users",
      "name": "List users",
      "method": "GET",
      "endpoint": "/users",
      "inputs": []
    },
    {
      "key": "list_user_tokens",
      "name": "List a user's tokens",
      "method": "GET",
      "endpoint": "/users/{{ inputs.username }}/tokens",
      "inputs": [{ "key": "username", "label": "Username", "type": "string", "required": true }]
    },
    {
      "key": "get_duckling_config",
      "name": "Get Duckling configuration",
      "method": "GET",
      "endpoint": "/users/{{ inputs.username }}/instances",
      "inputs": [{ "key": "username", "label": "Username", "type": "string", "required": true }]
    },
    {
      "key": "active_accounts",
      "name": "Get active accounts",
      "method": "GET",
      "endpoint": "/active_accounts",
      "inputs": []
    }
  ]
}
