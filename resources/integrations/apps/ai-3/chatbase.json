{
  "key": "chatbase",
  "name": "Chatbase",
  "category": "AI",
  "description": "Chat with your Chatbase AI agent and pull its conversations and leads.",
  "website": "https://www.chatbase.co",
  "docs_url": "https://www.chatbase.co/docs/api-reference",
  "base_url": "https://www.chatbase.co/api/v1",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Chatbase → Workspace settings → API keys → Create API key."
      }
    ]
  },
  "actions": [
    {
      "key": "chat",
      "name": "Send message",
      "description": "Ask the chatbot a question and get its answer.",
      "method": "POST",
      "endpoint": "/chat",
      "timeout": 120,
      "body": {
        "chatbotId": "{{ inputs.chatbot_id }}",
        "messages": [
          {
            "role": "user",
            "content": "{{ inputs.message }}"
          }
        ],
        "conversationId": "{{ inputs.conversation_id }}",
        "temperature": "{{ inputs.temperature }}",
        "stream": false
      },
      "output_fields": {
        "text": "text"
      },
      "inputs": [
        {
          "key": "chatbot_id",
          "label": "Chatbot ID",
          "type": "string",
          "required": true,
          "help": "Chatbase → your chatbot → Settings → General → Chatbot ID."
        },
        {
          "key": "message",
          "label": "Message",
          "type": "text",
          "required": true
        },
        {
          "key": "conversation_id",
          "label": "Conversation ID",
          "type": "string",
          "help": "Optional. Set it to save and continue a conversation."
        },
        {
          "key": "temperature",
          "label": "Temperature",
          "type": "number"
        }
      ]
    },
    {
      "key": "list_chatbots",
      "name": "List chatbots",
      "description": "List the chatbots in your workspace.",
      "method": "GET",
      "endpoint": "/get-chatbots",
      "output_fields": {
        "chatbots": "chatbots"
      },
      "inputs": []
    },
    {
      "key": "get_conversations",
      "name": "Get conversations",
      "description": "List the chatbot's conversations with all messages.",
      "method": "GET",
      "endpoint": "/get-conversations",
      "query": {
        "chatbotId": "{{ inputs.chatbot_id }}",
        "startDate": "{{ inputs.start_date }}",
        "endDate": "{{ inputs.end_date }}",
        "page": "{{ inputs.page }}",
        "size": "{{ inputs.size }}"
      },
      "output_fields": {
        "conversations": "data"
      },
      "inputs": [
        {
          "key": "chatbot_id",
          "label": "Chatbot ID",
          "type": "string",
          "required": true,
          "help": "Chatbase → your chatbot → Settings → General → Chatbot ID."
        },
        {
          "key": "start_date",
          "label": "From",
          "type": "string",
          "placeholder": "2025-01-01"
        },
        {
          "key": "end_date",
          "label": "To",
          "type": "string",
          "placeholder": "2025-12-31"
        },
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "default": 1
        },
        {
          "key": "size",
          "label": "Per page",
          "type": "number",
          "default": 20
        }
      ]
    },
    {
      "key": "get_leads",
      "name": "Get leads",
      "description": "List the names, emails and phones the chatbot collected.",
      "method": "GET",
      "endpoint": "/get-leads",
      "query": {
        "chatbotId": "{{ inputs.chatbot_id }}",
        "startDate": "{{ inputs.start_date }}",
        "endDate": "{{ inputs.end_date }}",
        "page": "{{ inputs.page }}",
        "size": "{{ inputs.size }}"
      },
      "output_fields": {
        "leads": "collectedCustomers"
      },
      "inputs": [
        {
          "key": "chatbot_id",
          "label": "Chatbot ID",
          "type": "string",
          "required": true,
          "help": "Chatbase → your chatbot → Settings → General → Chatbot ID."
        },
        {
          "key": "start_date",
          "label": "From",
          "type": "string",
          "placeholder": "2025-01-01"
        },
        {
          "key": "end_date",
          "label": "To",
          "type": "string",
          "placeholder": "2025-12-31"
        },
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "default": 1
        },
        {
          "key": "size",
          "label": "Per page",
          "type": "number",
          "default": 20
        }
      ]
    }
  ]
}
