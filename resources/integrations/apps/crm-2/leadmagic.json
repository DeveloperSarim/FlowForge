{
  "key": "leadmagic",
  "name": "LeadMagic",
  "category": "CRM & Sales",
  "description": "Find work emails and mobile numbers, and validate emails.",
  "brand": "leadmagic",
  "website": "https://leadmagic.io",
  "docs_url": "https://leadmagic.io/docs",
  "base_url": "https://api.leadmagic.io/v1",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "X-API-Key",
    "fields": [{ "key": "api_key", "label": "API key", "type": "password", "required": true }]
  },
  "actions": [
    {
      "key": "find_email",
      "name": "Find email",
      "method": "POST",
      "endpoint": "/people/email-finder",
      "body": {
        "first_name": "{{ inputs.first_name }}",
        "last_name": "{{ inputs.last_name }}",
        "full_name": "{{ inputs.full_name }}",
        "domain": "{{ inputs.domain }}",
        "company_name": "{{ inputs.company_name }}"
      },
      "inputs": [
        { "key": "first_name", "label": "First name", "type": "string" },
        { "key": "last_name", "label": "Last name", "type": "string" },
        { "key": "full_name", "label": "Full name", "type": "string", "help": "Instead of first + last name" },
        { "key": "domain", "label": "Company domain", "type": "string" },
        { "key": "company_name", "label": "Company name", "type": "string", "help": "Instead of the domain" }
      ]
    },
    {
      "key": "find_email_from_profile",
      "name": "Find email from LinkedIn",
      "method": "POST",
      "endpoint": "/people/b2b-profile-email",
      "body": { "profile_url": "{{ inputs.profile_url }}" },
      "inputs": [{ "key": "profile_url", "label": "LinkedIn profile URL", "type": "string", "required": true }]
    },
    {
      "key": "find_mobile",
      "name": "Find mobile number",
      "method": "POST",
      "endpoint": "/people/mobile-finder",
      "body": { "profile_url": "{{ inputs.profile_url }}", "work_email": "{{ inputs.work_email }}", "personal_email": "{{ inputs.personal_email }}" },
      "inputs": [
        { "key": "profile_url", "label": "LinkedIn profile URL", "type": "string" },
        { "key": "work_email", "label": "Work email", "type": "string" },
        { "key": "personal_email", "label": "Personal email", "type": "string" }
      ]
    },
    {
      "key": "validate_email",
      "name": "Validate email",
      "method": "POST",
      "endpoint": "/people/email-validation",
      "body": { "email": "{{ inputs.email }}" },
      "inputs": [{ "key": "email", "label": "Email", "type": "string", "required": true }]
    }
  ]
}
