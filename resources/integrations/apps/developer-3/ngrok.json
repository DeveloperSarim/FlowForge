{
  "key": "ngrok",
  "name": "ngrok",
  "category": "Developer Tools",
  "description": "List ngrok tunnels and endpoints and manage reserved domains.",
  "brand": "ngrok",
  "website": "https://ngrok.com",
  "docs_url": "https://ngrok.com/docs/api/",
  "base_url": "https://api.ngrok.com",
  "headers": {
    "Ngrok-Version": "2"
  },
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "ngrok dashboard → API Keys → Add API key (this is not your agent authtoken)."
      }
    ]
  },
  "actions": [
    {
      "key": "list_tunnels",
      "name": "List tunnels",
      "description": "List tunnels that are online right now.",
      "method": "GET",
      "endpoint": "/tunnels",
      "output_fields": {
        "tunnels": "tunnels"
      },
      "inputs": []
    },
    {
      "key": "list_endpoints",
      "name": "List endpoints",
      "description": "List active endpoints.",
      "method": "GET",
      "endpoint": "/endpoints",
      "output_fields": {
        "endpoints": "endpoints"
      },
      "inputs": []
    },
    {
      "key": "list_agent_sessions",
      "name": "List agent sessions",
      "description": "List connected ngrok agents.",
      "method": "GET",
      "endpoint": "/tunnel_sessions",
      "output_fields": {
        "sessions": "tunnel_sessions"
      },
      "inputs": []
    },
    {
      "key": "list_reserved_domains",
      "name": "List reserved domains",
      "description": "List your reserved domains.",
      "method": "GET",
      "endpoint": "/reserved_domains",
      "output_fields": {
        "domains": "reserved_domains"
      },
      "inputs": []
    },
    {
      "key": "create_reserved_domain",
      "name": "Reserve domain",
      "description": "Reserve a domain for your tunnels.",
      "method": "POST",
      "endpoint": "/reserved_domains",
      "body": {
        "domain": "{{ inputs.domain }}",
        "description": "{{ inputs.description }}"
      },
      "output_fields": {
        "id": "id",
        "domain": "domain"
      },
      "inputs": [
        {
          "key": "domain",
          "label": "Domain",
          "type": "string",
          "required": true,
          "placeholder": "myapp.ngrok.app"
        },
        {
          "key": "description",
          "label": "Description",
          "type": "string"
        }
      ]
    },
    {
      "key": "delete_reserved_domain",
      "name": "Delete reserved domain",
      "description": "Release a reserved domain.",
      "method": "DELETE",
      "endpoint": "/reserved_domains/{{ inputs.id }}",
      "inputs": [
        {
          "key": "id",
          "label": "Reserved domain ID",
          "type": "string",
          "required": true,
          "help": "Starts with rd_; use List reserved domains."
        }
      ]
    }
  ]
}
