{
  "key": "redis_cloud",
  "name": "Redis Cloud",
  "category": "Databases",
  "description": "Inspect Redis Cloud subscriptions, databases and async task status.",
  "brand": "redis",
  "website": "https://redis.io/cloud/",
  "docs_url": "https://redis.io/docs/latest/operate/rc/api/",
  "base_url": "https://api.redislabs.com/v1",
  "headers": { "x-api-secret-key": "{{ credentials.secret_key }}" },
  "auth": { "type": "api_key", "in": "header", "name": "x-api-key", "fields": [
    { "key": "api_key", "label": "Account key", "type": "password", "required": true, "help": "Access Management → API Keys." },
    { "key": "secret_key", "label": "User (secret) key", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "list_subscriptions",
      "name": "List Pro subscriptions",
      "method": "GET",
      "endpoint": "/subscriptions",
      "inputs": []
    },
    {
      "key": "list_essentials_subscriptions",
      "name": "List Essentials subscriptions",
      "method": "GET",
      "endpoint": "/fixed/subscriptions",
      "inputs": []
    },
    {
      "key": "list_databases",
      "name": "List databases",
      "method": "GET",
      "endpoint": "/subscriptions/{{ inputs.subscription_id }}/databases",
      "inputs": [{ "key": "subscription_id", "label": "Subscription ID", "type": "number", "required": true }]
    },
    {
      "key": "get_database",
      "name": "Get database",
      "method": "GET",
      "endpoint": "/subscriptions/{{ inputs.subscription_id }}/databases/{{ inputs.database_id }}",
      "inputs": [
        { "key": "subscription_id", "label": "Subscription ID", "type": "number", "required": true },
        { "key": "database_id", "label": "Database ID", "type": "number", "required": true }
      ]
    },
    {
      "key": "get_task",
      "name": "Get task status",
      "method": "GET",
      "endpoint": "/tasks/{{ inputs.task_id }}",
      "inputs": [{ "key": "task_id", "label": "Task ID", "type": "string", "required": true }]
    }
  ]
}
