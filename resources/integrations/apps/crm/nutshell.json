{
  "key": "nutshell",
  "name": "Nutshell",
  "category": "CRM & Sales",
  "description": "Search and create contacts through Nutshell's JSON-RPC API.",
  "brand": "nutshell",
  "website": "https://www.nutshell.com",
  "docs_url": "https://developers.nutshell.com/",
  "base_url": "https://app.nutshell.com/api/v1",
  "auth": [
    {
      "type": "basic",
      "fields": [
        {
          "key": "username",
          "label": "Email or company domain",
          "type": "string",
          "required": true
        },
        {
          "key": "password",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Setup > API keys."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "search_contacts",
      "name": "Search contacts",
      "method": "POST",
      "endpoint": "/json",
      "body": {
        "id": "flowforge",
        "method": "searchContacts",
        "params": {
          "string": "{{ inputs.string }}",
          "limit": "{{ inputs.limit }}"
        }
      },
      "error_path": "error",
      "output_path": "result",
      "inputs": [
        {
          "key": "string",
          "label": "Search",
          "type": "string",
          "required": true
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 10
        }
      ]
    },
    {
      "key": "new_contact",
      "name": "Create contact",
      "method": "POST",
      "endpoint": "/json",
      "body": {
        "id": "flowforge",
        "method": "newContact",
        "params": {
          "contact": {
            "name": "{{ inputs.name }}",
            "email": "{{ inputs.email }}"
          }
        }
      },
      "error_path": "error",
      "output_path": "result",
      "inputs": [
        {
          "key": "name",
          "label": "Name",
          "type": "string",
          "required": true
        },
        {
          "key": "email",
          "label": "Emails",
          "type": "list"
        }
      ]
    }
  ]
}
