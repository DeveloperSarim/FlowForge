{
  "key": "swapcard",
  "name": "Swapcard",
  "category": "Events & Webinars",
  "description": "Query and update Swapcard events, people and exhibitors with GraphQL.",
  "brand": "swapcard",
  "website": "https://www.swapcard.com",
  "docs_url": "https://swapcard.dev",
  "base_url": "https://developer.swapcard.com",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "Authorization",
      "fields": [
        {
          "key": "api_key",
          "label": "Access token",
          "type": "password",
          "required": true,
          "help": "Event Studio > Integrations > API access token."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "event_admin_graphql",
      "name": "Run Event Admin GraphQL",
      "method": "POST",
      "endpoint": "/event-admin/graphql",
      "body": {
        "query": "{{ inputs.query }}",
        "variables": "{{ inputs.variables }}"
      },
      "error_path": "errors.0.message",
      "output_path": "data",
      "inputs": [
        {
          "key": "query",
          "label": "Query",
          "type": "code",
          "required": true,
          "placeholder": "query EventById($eventId: ID!) { event(id: $eventId) { id title beginsAt endsAt } }"
        },
        {
          "key": "variables",
          "label": "Variables",
          "type": "json"
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "Add this URL as a webhook in Swapcard Studio.",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
