{
  "key": "judge_me",
  "name": "Judge.me",
  "category": "Marketing & Email",
  "description": "List and fetch product reviews and products from Judge.me.",
  "brand": "judgeme",
  "website": "https://judge.me",
  "docs_url": "https://judge.me/api/docs",
  "base_url": "https://judge.me/api/v1",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "api_token",
    "fields": [
      {
        "key": "shop_domain",
        "label": "Shop domain",
        "type": "string",
        "required": true,
        "placeholder": "your-store.myshopify.com"
      },
      {
        "key": "api_key",
        "label": "Private API token",
        "type": "password",
        "required": true,
        "help": "Judge.me > Settings > Integrations > View API token (private)."
      }
    ]
  },
  "actions": [
    {
      "key": "list_reviews",
      "name": "List reviews",
      "method": "GET",
      "endpoint": "/reviews",
      "query": {
        "shop_domain": "{{ credentials.shop_domain }}",
        "per_page": "{{ inputs.per_page }}",
        "page": "{{ inputs.page }}",
        "rating": "{{ inputs.rating }}",
        "product_id": "{{ inputs.product_id }}"
      },
      "output_path": "reviews",
      "inputs": [
        {
          "key": "per_page",
          "label": "Per page (max 100)",
          "type": "number",
          "default": 10
        },
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "default": 1
        },
        {
          "key": "rating",
          "label": "Rating",
          "type": "number"
        },
        {
          "key": "product_id",
          "label": "Judge.me product ID",
          "type": "string"
        }
      ]
    },
    {
      "key": "get_review",
      "name": "Get review",
      "method": "GET",
      "endpoint": "/reviews/{{ inputs.review_id }}",
      "query": {
        "shop_domain": "{{ credentials.shop_domain }}"
      },
      "output_path": "review",
      "inputs": [
        {
          "key": "review_id",
          "label": "Review ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_products",
      "name": "List products",
      "method": "GET",
      "endpoint": "/products",
      "query": {
        "shop_domain": "{{ credentials.shop_domain }}",
        "per_page": "{{ inputs.per_page }}",
        "page": "{{ inputs.page }}"
      },
      "output_path": "products",
      "inputs": [
        {
          "key": "per_page",
          "label": "Per page (max 100)",
          "type": "number",
          "default": 10
        },
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "default": 1
        }
      ]
    }
  ]
}