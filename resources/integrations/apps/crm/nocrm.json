{
  "key": "nocrm",
  "name": "noCRM.io",
  "category": "CRM & Sales",
  "description": "Create and read leads in noCRM.io.",
  "brand": "nocrm",
  "website": "https://www.nocrm.io",
  "docs_url": "https://www.nocrm.io/api",
  "base_url": "https://{{ credentials.subdomain }}.nocrm.io/api/v2",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "X-API-KEY",
      "fields": [
        {
          "key": "subdomain",
          "label": "Subdomain",
          "type": "string",
          "required": true,
          "placeholder": "yourcompany"
        },
        {
          "key": "api_key",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Admin panel > Integrations > API."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "create_lead",
      "name": "Create lead",
      "method": "POST",
      "endpoint": "/leads",
      "body": {
        "title": "{{ inputs.title }}",
        "description": "{{ inputs.description }}",
        "user_id": "{{ inputs.user_id }}",
        "tags": "{{ inputs.tags }}"
      },
      "inputs": [
        {
          "key": "title",
          "label": "Title",
          "type": "string",
          "required": true
        },
        {
          "key": "description",
          "label": "Description",
          "type": "text",
          "help": "One 'Field: value' per line fills lead fields."
        },
        {
          "key": "user_id",
          "label": "Assign to (user ID or email)",
          "type": "string"
        },
        {
          "key": "tags",
          "label": "Tags",
          "type": "list"
        }
      ]
    },
    {
      "key": "get_lead",
      "name": "Get lead",
      "method": "GET",
      "endpoint": "/leads/{{ inputs.lead_id }}",
      "inputs": [
        {
          "key": "lead_id",
          "label": "Lead ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
