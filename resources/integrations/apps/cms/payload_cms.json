{
  "key": "payload_cms",
  "name": "Payload CMS",
  "category": "CMS & Websites",
  "description": "Find, create, update and delete documents in a Payload collection.",
  "brand": "payloadcms",
  "website": "https://payloadcms.com",
  "docs_url": "https://payloadcms.com/docs/rest-api/overview",
  "base_url": "{{ credentials.base_url }}/api",
  "headers": {
    "Authorization": "{{ credentials.auth_collection }} API-Key {{ credentials.api_key }}"
  },
  "auth": [
    {
      "type": "api_key",
      "fields": [
        {
          "key": "base_url",
          "label": "Payload URL",
          "type": "string",
          "required": true,
          "placeholder": "https://cms.example.com",
          "help": "No trailing slash."
        },
        {
          "key": "auth_collection",
          "label": "Auth collection slug",
          "type": "string",
          "required": true,
          "default": "users",
          "help": "The collection with useAPIKey enabled."
        },
        {
          "key": "api_key",
          "label": "API key",
          "type": "password",
          "required": true
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "find_documents",
      "name": "Find documents",
      "method": "GET",
      "endpoint": "/{{ inputs.collection }}",
      "output_path": "docs",
      "query": {
        "where": "{{ inputs.where }}",
        "sort": "{{ inputs.sort }}",
        "limit": "{{ inputs.limit }}",
        "depth": "{{ inputs.depth }}"
      },
      "inputs": [
        {
          "key": "collection",
          "label": "Collection slug",
          "type": "string",
          "required": true,
          "placeholder": "posts"
        },
        {
          "key": "where",
          "label": "Where (JSON)",
          "type": "json",
          "placeholder": "{ \"status\": { \"equals\": \"published\" } }"
        },
        {
          "key": "sort",
          "label": "Sort",
          "type": "string",
          "placeholder": "-createdAt"
        },
        {
          "key": "limit",
          "label": "Max documents",
          "type": "number",
          "default": 10
        },
        {
          "key": "depth",
          "label": "Depth",
          "type": "number"
        }
      ]
    },
    {
      "key": "get_document",
      "name": "Get document",
      "method": "GET",
      "endpoint": "/{{ inputs.collection }}/{{ inputs.id }}",
      "query": {
        "depth": "{{ inputs.depth }}"
      },
      "inputs": [
        {
          "key": "collection",
          "label": "Collection slug",
          "type": "string",
          "required": true,
          "placeholder": "posts"
        },
        {
          "key": "id",
          "label": "Document ID",
          "type": "string",
          "required": true
        },
        {
          "key": "depth",
          "label": "Depth",
          "type": "number"
        }
      ]
    },
    {
      "key": "create_document",
      "name": "Create document",
      "method": "POST",
      "endpoint": "/{{ inputs.collection }}",
      "body": "{{ inputs.data }}",
      "output_path": "doc",
      "inputs": [
        {
          "key": "collection",
          "label": "Collection slug",
          "type": "string",
          "required": true,
          "placeholder": "posts"
        },
        {
          "key": "data",
          "label": "Fields (JSON)",
          "type": "json",
          "required": true,
          "placeholder": "{ \"title\": \"Hello\" }"
        }
      ]
    },
    {
      "key": "update_document",
      "name": "Update document",
      "method": "PATCH",
      "endpoint": "/{{ inputs.collection }}/{{ inputs.id }}",
      "body": "{{ inputs.data }}",
      "output_path": "doc",
      "inputs": [
        {
          "key": "collection",
          "label": "Collection slug",
          "type": "string",
          "required": true,
          "placeholder": "posts"
        },
        {
          "key": "id",
          "label": "Document ID",
          "type": "string",
          "required": true
        },
        {
          "key": "data",
          "label": "Fields (JSON)",
          "type": "json",
          "required": true,
          "placeholder": "{ \"title\": \"Hello\" }"
        }
      ]
    },
    {
      "key": "delete_document",
      "name": "Delete document",
      "method": "DELETE",
      "endpoint": "/{{ inputs.collection }}/{{ inputs.id }}",
      "inputs": [
        {
          "key": "collection",
          "label": "Collection slug",
          "type": "string",
          "required": true,
          "placeholder": "posts"
        },
        {
          "key": "id",
          "label": "Document ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
