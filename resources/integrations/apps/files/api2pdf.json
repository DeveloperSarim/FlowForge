{
  "key": "api2pdf",
  "name": "Api2Pdf",
  "category": "Files & Documents",
  "description": "Convert HTML, URLs and Office files to PDF and merge PDFs.",
  "brand": "api2pdf",
  "website": "https://www.api2pdf.com",
  "docs_url": "https://www.api2pdf.com/documentation/v2",
  "base_url": "https://v2.api2pdf.com",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "Authorization"
    }
  ],
  "actions": [
    {
      "key": "html_to_pdf",
      "name": "HTML to PDF",
      "method": "POST",
      "endpoint": "/chrome/pdf/html",
      "error_path": "Error",
      "body": {
        "html": "{{ inputs.html }}",
        "fileName": "{{ inputs.file_name }}",
        "options": "{{ inputs.options }}"
      },
      "inputs": [
        {
          "key": "html",
          "label": "HTML",
          "type": "code",
          "required": true
        },
        {
          "key": "file_name",
          "label": "File name",
          "type": "string",
          "placeholder": "document.pdf"
        },
        {
          "key": "options",
          "label": "Chrome options (JSON)",
          "type": "json",
          "placeholder": "{ \"landscape\": true }"
        }
      ]
    },
    {
      "key": "url_to_pdf",
      "name": "URL to PDF",
      "method": "POST",
      "endpoint": "/chrome/pdf/url",
      "error_path": "Error",
      "body": {
        "url": "{{ inputs.url }}",
        "fileName": "{{ inputs.file_name }}"
      },
      "inputs": [
        {
          "key": "url",
          "label": "Page URL",
          "type": "string",
          "required": true
        },
        {
          "key": "file_name",
          "label": "File name",
          "type": "string",
          "placeholder": "document.pdf"
        }
      ]
    },
    {
      "key": "office_to_pdf",
      "name": "Office file to PDF",
      "method": "POST",
      "endpoint": "/libreoffice/any-to-pdf",
      "error_path": "Error",
      "body": {
        "url": "{{ inputs.url }}",
        "fileName": "{{ inputs.file_name }}"
      },
      "inputs": [
        {
          "key": "url",
          "label": "File URL",
          "type": "string",
          "required": true,
          "help": "Word, Excel, PowerPoint, images..."
        },
        {
          "key": "file_name",
          "label": "File name",
          "type": "string",
          "placeholder": "document.pdf"
        }
      ]
    },
    {
      "key": "merge_pdfs",
      "name": "Merge PDFs",
      "method": "POST",
      "endpoint": "/pdfsharp/merge",
      "error_path": "Error",
      "body": {
        "urls": "{{ inputs.urls }}",
        "fileName": "{{ inputs.file_name }}"
      },
      "inputs": [
        {
          "key": "urls",
          "label": "PDF URLs",
          "type": "list",
          "required": true
        },
        {
          "key": "file_name",
          "label": "File name",
          "type": "string",
          "placeholder": "document.pdf"
        }
      ]
    }
  ]
}
