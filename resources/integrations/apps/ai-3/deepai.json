{
  "key": "deepai",
  "name": "DeepAI",
  "category": "AI",
  "description": "Generate and edit images: text to image, AI photo editor, background remover.",
  "website": "https://deepai.org",
  "docs_url": "https://deepai.org/docs",
  "base_url": "https://api.deepai.org/api",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "api-key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "deepai.org → Dashboard → API key."
      }
    ]
  },
  "actions": [
    {
      "key": "text_to_image",
      "name": "Generate image",
      "description": "Create an image from a text description.",
      "method": "POST",
      "endpoint": "/text2img",
      "timeout": 120,
      "body_format": "form",
      "body": {
        "text": "{{ inputs.text }}",
        "width": "{{ inputs.width }}",
        "height": "{{ inputs.height }}"
      },
      "output_fields": {
        "image_url": "output_url",
        "id": "id"
      },
      "inputs": [
        {
          "key": "text",
          "label": "Prompt",
          "type": "text",
          "required": true
        },
        {
          "key": "width",
          "label": "Width (px)",
          "type": "number",
          "placeholder": "512"
        },
        {
          "key": "height",
          "label": "Height (px)",
          "type": "number",
          "placeholder": "512"
        }
      ]
    },
    {
      "key": "edit_image",
      "name": "Edit image with prompt",
      "description": "Change an image by describing the edit.",
      "method": "POST",
      "endpoint": "/image-editor",
      "timeout": 120,
      "body_format": "form",
      "body": {
        "image": "{{ inputs.image }}",
        "text": "{{ inputs.text }}"
      },
      "output_fields": {
        "image_url": "output_url",
        "id": "id"
      },
      "inputs": [
        {
          "key": "image",
          "label": "Image URL",
          "type": "string",
          "required": true
        },
        {
          "key": "text",
          "label": "Instruction",
          "type": "text",
          "required": true,
          "placeholder": "make it look like winter"
        }
      ]
    },
    {
      "key": "remove_background",
      "name": "Remove background",
      "description": "Cut out the subject of a photo.",
      "method": "POST",
      "endpoint": "/background-remover",
      "timeout": 120,
      "body_format": "form",
      "body": {
        "image": "{{ inputs.image }}"
      },
      "output_fields": {
        "image_url": "output_url",
        "id": "id"
      },
      "inputs": [
        {
          "key": "image",
          "label": "Image URL",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "colorize",
      "name": "Colorise photo",
      "description": "Add colour to a black-and-white photo.",
      "method": "POST",
      "endpoint": "/colorizer",
      "timeout": 120,
      "body_format": "form",
      "body": {
        "image": "{{ inputs.image }}"
      },
      "output_fields": {
        "image_url": "output_url",
        "id": "id"
      },
      "inputs": [
        {
          "key": "image",
          "label": "Image URL",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
