{
  "key": "unifonic",
  "name": "Unifonic",
  "category": "Communication",
  "description": "Send SMS across the Middle East with Unifonic.",
  "brand": "unifonic",
  "website": "https://www.unifonic.com",
  "docs_url": "https://docs.unifonic.com/docs/sms-api",
  "base_url": "https://el.cloud.unifonic.com/rest",
  "auth": [
    { "type": "api_key", "fields": [{ "key": "api_key", "label": "AppSid", "type": "password", "required": true, "help": "Unifonic Console → SMS → Applications." }] }
  ],
  "actions": [
    {
      "key": "send_sms",
      "name": "Send SMS",
      "method": "POST",
      "endpoint": "/SMS/messages",
      "body_format": "form",
      "body": {
        "AppSid": "{{ credentials.api_key }}",
        "SenderID": "{{ inputs.sender_id }}",
        "Recipient": "{{ inputs.recipient }}",
        "Body": "{{ inputs.body }}",
        "responseType": "JSON"
      },
      "inputs": [
        { "key": "recipient", "label": "Recipient (international, no +)", "type": "string", "required": true, "placeholder": "966505980169", "help": "Comma-separate several numbers." },
        { "key": "sender_id", "label": "Sender ID", "type": "string", "required": true },
        { "key": "body", "label": "Message", "type": "text", "required": true }
      ]
    }
  ]
}
