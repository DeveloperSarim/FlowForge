{
  "key": "product_hunt",
  "name": "Product Hunt",
  "category": "Social Media",
  "description": "Query launches, makers, topics and votes with the GraphQL API.",
  "brand": "producthunt",
  "website": "https://www.producthunt.com",
  "docs_url": "https://api.producthunt.com/v2/docs",
  "base_url": "https://api.producthunt.com/v2/api",
  "auth": [
    { "type": "bearer", "fields": [{ "key": "token", "label": "Developer token", "type": "password", "required": true, "help": "From producthunt.com/v2/oauth/applications." }] },
    { "type": "oauth2", "authorize_url": "https://api.producthunt.com/v2/oauth/authorize", "token_url": "https://api.producthunt.com/v2/oauth/token", "scopes": ["public", "private"] }
  ],
  "actions": [
    {
      "key": "graphql",
      "name": "Run GraphQL query",
      "method": "POST",
      "endpoint": "/graphql",
      "body": { "query": "{{ inputs.query }}", "variables": "{{ inputs.variables }}" },
      "error_path": "errors",
      "output_path": "data",
      "inputs": [
        { "key": "query", "label": "Query", "type": "code", "required": true, "placeholder": "{ posts(first: 10, order: NEWEST) { edges { node { id name tagline url votesCount } } } }" },
        { "key": "variables", "label": "Variables", "type": "json" }
      ]
    }
  ]
}
