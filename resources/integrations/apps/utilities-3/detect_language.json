{
  "key": "detect_language",
  "name": "Detect Language",
  "category": "Utilities",
  "description": "Detect which language a text is written in, for one text or many at once.",
  "website": "https://detectlanguage.com",
  "docs_url": "https://detectlanguage.com/documentation",
  "base_url": "https://ws.detectlanguage.com/v3",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "detectlanguage.com → Sign in → Dashboard → API key."
      }
    ]
  },
  "actions": [
    {
      "key": "detect",
      "name": "Detect language",
      "description": "Get the most likely language code and a confidence score.",
      "method": "POST",
      "endpoint": "/detect",
      "body": {
        "q": "{{ inputs.text }}"
      },
      "output_fields": {
        "language": "0.language",
        "score": "0.score",
        "candidates": "0"
      },
      "inputs": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "key": "detect_batch",
      "name": "Detect language of many texts",
      "description": "Detect the language of several texts in one request.",
      "method": "POST",
      "endpoint": "/detect-batch",
      "body": {
        "q": "{{ inputs.texts }}"
      },
      "output_fields": {
        "first_language": "0.0.language"
      },
      "inputs": [
        {
          "key": "texts",
          "label": "Texts",
          "type": "list",
          "required": true,
          "help": "One text per row."
        }
      ]
    },
    {
      "key": "list_languages",
      "name": "List languages",
      "description": "Supported languages and their codes.",
      "method": "GET",
      "endpoint": "/languages",
      "inputs": []
    },
    {
      "key": "account_status",
      "name": "Account status",
      "description": "Requests used today and your plan limits.",
      "method": "GET",
      "endpoint": "/account/status",
      "output_fields": {
        "requests_today": "requests",
        "daily_limit": "daily_requests_limit",
        "plan": "plan",
        "status": "status"
      },
      "inputs": []
    }
  ]
}
