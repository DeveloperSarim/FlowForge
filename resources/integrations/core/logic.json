{
  "key": "logic",
  "name": "Logic",
  "icon": "git-branch",
  "category": "Flow control",
  "description": "Branch or stop a run based on conditions.",
  "actions": [
    {
      "key": "if",
      "output": ["result"],
      "name": "If / Else",
      "description": "Continue down the true or false path.",
      "handler": "if",
      "outputs": ["true", "false"],
      "inputs": [
        { "key": "conditions", "label": "Conditions", "type": "conditions", "required": true },
        { "key": "combinator", "label": "Match", "type": "select", "default": "all", "options": [
          { "value": "all", "label": "All conditions (AND)" }, { "value": "any", "label": "Any condition (OR)" }
        ] }
      ]
    },
    {
      "key": "filter",
      "output": ["passed"],
      "name": "Filter",
      "description": "Stop this path unless the conditions pass.",
      "handler": "filter",
      "inputs": [
        { "key": "conditions", "label": "Conditions", "type": "conditions", "required": true },
        { "key": "combinator", "label": "Match", "type": "select", "default": "all", "options": [
          { "value": "all", "label": "All conditions (AND)" }, { "value": "any", "label": "Any condition (OR)" }
        ] }
      ]
    }
  ]
}
