{
  "key": "locationiq",
  "name": "LocationIQ",
  "category": "Utilities",
  "description": "Forward and reverse geocoding and address autocomplete.",
  "brand": "locationiq",
  "website": "https://locationiq.com",
  "docs_url": "https://docs.locationiq.com",
  "base_url": "{{ credentials.api_host }}/v1",
  "auth": { "type": "api_key", "in": "query", "name": "key", "fields": [
    { "key": "api_key", "label": "Access token", "type": "password", "required": true },
    { "key": "api_host", "label": "Region", "type": "select", "required": true, "default": "https://us1.locationiq.com", "options": [
      { "value": "https://us1.locationiq.com", "label": "US" }, { "value": "https://eu1.locationiq.com", "label": "Europe" }
    ] }
  ] },
  "actions": [
    {
      "key": "search",
      "name": "Geocode address",
      "method": "GET",
      "endpoint": "/search",
      "query": { "q": "{{ inputs.q }}", "countrycodes": "{{ inputs.countrycodes }}", "limit": "{{ inputs.limit }}", "format": "json" },
      "inputs": [
        { "key": "q", "label": "Address", "type": "string", "required": true },
        { "key": "countrycodes", "label": "Country codes", "type": "string", "placeholder": "us,ca" },
        { "key": "limit", "label": "Limit", "type": "number" }
      ]
    },
    {
      "key": "reverse",
      "name": "Reverse geocode",
      "method": "GET",
      "endpoint": "/reverse",
      "query": { "lat": "{{ inputs.lat }}", "lon": "{{ inputs.lon }}", "format": "json" },
      "inputs": [
        { "key": "lat", "label": "Latitude", "type": "number", "required": true },
        { "key": "lon", "label": "Longitude", "type": "number", "required": true }
      ]
    },
    {
      "key": "autocomplete",
      "name": "Autocomplete address",
      "method": "GET",
      "endpoint": "https://api.locationiq.com/v1/autocomplete",
      "query": { "q": "{{ inputs.q }}", "countrycodes": "{{ inputs.countrycodes }}", "limit": "{{ inputs.limit }}" },
      "inputs": [
        { "key": "q", "label": "Partial address", "type": "string", "required": true },
        { "key": "countrycodes", "label": "Country codes", "type": "string", "placeholder": "us" },
        { "key": "limit", "label": "Limit", "type": "number" }
      ]
    }
  ]
}
