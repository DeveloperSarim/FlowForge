{
  "key": "here",
  "name": "HERE",
  "category": "Utilities",
  "description": "Geocode addresses, reverse geocode coordinates and discover places.",
  "brand": "here",
  "website": "https://www.here.com",
  "docs_url": "https://www.here.com/docs/bundle/geocoding-and-search-api-developer-guide/page/README.html",
  "base_url": "https://geocode.search.hereapi.com/v1",
  "auth": { "type": "api_key", "in": "query", "name": "apiKey", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true, "help": "From platform.here.com → Access manager." }
  ] },
  "actions": [
    {
      "key": "geocode",
      "name": "Geocode address",
      "method": "GET",
      "endpoint": "/geocode",
      "query": { "q": "{{ inputs.q }}", "in": "{{ inputs.in }}", "limit": "{{ inputs.limit }}", "lang": "{{ inputs.lang }}" },
      "output_path": "items",
      "inputs": [
        { "key": "q", "label": "Address", "type": "string", "required": true, "placeholder": "Invalidenstr 117, Berlin" },
        { "key": "in", "label": "Country filter", "type": "string", "placeholder": "countryCode:DEU" },
        { "key": "limit", "label": "Max results", "type": "number", "default": 5 },
        { "key": "lang", "label": "Language", "type": "string", "placeholder": "en-US" }
      ]
    },
    {
      "key": "reverse_geocode",
      "name": "Reverse geocode",
      "method": "GET",
      "endpoint": "https://revgeocode.search.hereapi.com/v1/revgeocode",
      "query": { "at": "{{ inputs.at }}", "limit": "{{ inputs.limit }}", "lang": "{{ inputs.lang }}" },
      "output_path": "items",
      "inputs": [
        { "key": "at", "label": "Coordinates (lat,lng)", "type": "string", "required": true, "placeholder": "52.5308,13.3847" },
        { "key": "limit", "label": "Max results", "type": "number", "default": 1 },
        { "key": "lang", "label": "Language", "type": "string", "placeholder": "en-US" }
      ]
    },
    {
      "key": "discover",
      "name": "Search places",
      "description": "Free-text place search near a position.",
      "method": "GET",
      "endpoint": "https://discover.search.hereapi.com/v1/discover",
      "query": { "q": "{{ inputs.q }}", "at": "{{ inputs.at }}", "limit": "{{ inputs.limit }}", "lang": "{{ inputs.lang }}" },
      "output_path": "items",
      "inputs": [
        { "key": "q", "label": "Search text", "type": "string", "required": true, "placeholder": "coffee" },
        { "key": "at", "label": "Near (lat,lng)", "type": "string", "required": true, "placeholder": "52.5308,13.3847" },
        { "key": "limit", "label": "Max results", "type": "number", "default": 10 },
        { "key": "lang", "label": "Language", "type": "string", "placeholder": "en-US" }
      ]
    }
  ]
}
