{
  "key": "vtiger",
  "name": "Vtiger CRM",
  "category": "CRM & Sales",
  "description": "Query, read and create records in Vtiger CRM.",
  "brand": "vtiger",
  "website": "https://www.vtiger.com",
  "docs_url": "https://help.vtiger.com/article/147111249-Rest-API-Manual",
  "base_url": "{{ credentials.instance_url }}/restapi/v1/vtiger/default",
  "auth": [
    {
      "type": "basic",
      "fields": [
        {
          "key": "instance_url",
          "label": "Instance URL",
          "type": "string",
          "required": true,
          "placeholder": "https://yourcompany.od2.vtiger.com",
          "help": "No trailing slash."
        },
        {
          "key": "username",
          "label": "Username",
          "type": "string",
          "required": true
        },
        {
          "key": "password",
          "label": "Access key",
          "type": "password",
          "required": true,
          "help": "My Preferences > User Management > Access Key."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "query",
      "name": "Query records",
      "method": "GET",
      "endpoint": "/query",
      "query": {
        "query": "{{ inputs.query }}"
      },
      "output_path": "result",
      "inputs": [
        {
          "key": "query",
          "label": "Query",
          "type": "code",
          "required": true,
          "placeholder": "SELECT * FROM Contacts WHERE email = 'a@b.com';"
        }
      ]
    },
    {
      "key": "retrieve",
      "name": "Get record",
      "method": "GET",
      "endpoint": "/retrieve",
      "query": {
        "id": "{{ inputs.id }}"
      },
      "output_path": "result",
      "inputs": [
        {
          "key": "id",
          "label": "Record ID",
          "type": "string",
          "required": true,
          "placeholder": "12x34"
        }
      ]
    },
    {
      "key": "create",
      "name": "Create record",
      "method": "POST",
      "endpoint": "/create",
      "body_format": "form",
      "body": {
        "elementType": "{{ inputs.element_type }}",
        "element": "{{ inputs.element }}"
      },
      "output_path": "result",
      "inputs": [
        {
          "key": "element_type",
          "label": "Module",
          "type": "string",
          "required": true,
          "default": "Contacts"
        },
        {
          "key": "element",
          "label": "Fields (JSON)",
          "type": "code",
          "required": true,
          "placeholder": "{\"lastname\": \"Smith\", \"assigned_user_id\": \"19x1\"}"
        }
      ]
    }
  ]
}
