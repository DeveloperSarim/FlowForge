{
  "key": "blynk",
  "name": "Blynk",
  "category": "IoT & Smart Home",
  "description": "Read and write Blynk device datastreams and check if a device is online.",
  "brand": "blynk",
  "website": "https://blynk.io",
  "docs_url": "https://docs.blynk.io/en/blynk.cloud/device-https-api",
  "base_url": "https://{{ credentials.server }}/external/api",
  "auth": [
    {
      "type": "api_key",
      "in": "query",
      "name": "token",
      "fields": [
        { "key": "server", "label": "Server", "type": "select", "required": true, "default": "blynk.cloud", "options": [
          { "value": "blynk.cloud", "label": "blynk.cloud (auto)" }, { "value": "fra1.blynk.cloud", "label": "Frankfurt (fra1)" },
          { "value": "lon1.blynk.cloud", "label": "London (lon1)" }, { "value": "ny3.blynk.cloud", "label": "New York (ny3)" },
          { "value": "sgp1.blynk.cloud", "label": "Singapore (sgp1)" }, { "value": "blr1.blynk.cloud", "label": "Bangalore (blr1)" }
        ], "help": "Your region is shown at the bottom right of the Blynk console." },
        { "key": "api_key", "label": "Device auth token", "type": "password", "required": true, "help": "Device > Device info > BLYNK_AUTH_TOKEN. One credential per device." }
      ]
    }
  ],
  "actions": [
    {
      "key": "get_value",
      "name": "Get datastream value",
      "method": "GET",
      "endpoint": "/get",
      "query": { "dataStreamId": "{{ inputs.datastream_id }}" },
      "inputs": [
        { "key": "datastream_id", "label": "Datastream ID", "type": "number", "required": true, "help": "The numeric datastream ID, e.g. 1 for V1." }
      ]
    },
    {
      "key": "update_value",
      "name": "Update datastream value",
      "method": "GET",
      "endpoint": "/update",
      "query": { "dataStreamId": "{{ inputs.datastream_id }}", "value": "{{ inputs.value }}" },
      "inputs": [
        { "key": "datastream_id", "label": "Datastream ID", "type": "number", "required": true },
        { "key": "value", "label": "Value", "type": "string", "required": true }
      ]
    },
    {
      "key": "is_connected",
      "name": "Is device online",
      "description": "Returns true or false.",
      "method": "GET",
      "endpoint": "/isHardwareConnected",
      "inputs": []
    }
  ]
}
