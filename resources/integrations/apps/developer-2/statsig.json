{
  "key": "statsig",
  "name": "Statsig",
  "category": "Developer Tools",
  "description": "Enable or disable feature gates and list gates, experiments and dynamic configs.",
  "brand": "statsig",
  "website": "https://www.statsig.com",
  "docs_url": "https://docs.statsig.com/console-api/introduction",
  "base_url": "https://statsigapi.net/console/v1",
  "auth": { "type": "api_key", "in": "header", "name": "STATSIG-API-KEY", "fields": [
    { "key": "api_key", "label": "Console API key", "type": "password", "required": true, "help": "Project settings → Keys & Environments → Console API keys." }
  ] },
  "actions": [
    {
      "key": "enable_gate",
      "name": "Enable gate",
      "method": "PUT",
      "endpoint": "/gates/{{ inputs.gate_id }}/enable",
      "inputs": [{ "key": "gate_id", "label": "Gate ID", "type": "string", "required": true }]
    },
    {
      "key": "disable_gate",
      "name": "Disable gate",
      "method": "PUT",
      "endpoint": "/gates/{{ inputs.gate_id }}/disable",
      "inputs": [{ "key": "gate_id", "label": "Gate ID", "type": "string", "required": true }]
    },
    {
      "key": "get_gate",
      "name": "Get gate",
      "method": "GET",
      "endpoint": "/gates/{{ inputs.gate_id }}",
      "output_path": "data",
      "inputs": [{ "key": "gate_id", "label": "Gate ID", "type": "string", "required": true }]
    },
    {
      "key": "list_gates",
      "name": "List gates",
      "method": "GET",
      "endpoint": "/gates",
      "output_path": "data",
      "inputs": []
    },
    {
      "key": "list_experiments",
      "name": "List experiments",
      "method": "GET",
      "endpoint": "/experiments",
      "output_path": "data",
      "inputs": []
    },
    {
      "key": "list_dynamic_configs",
      "name": "List dynamic configs",
      "method": "GET",
      "endpoint": "/dynamic_configs",
      "output_path": "data",
      "inputs": []
    }
  ]
}
