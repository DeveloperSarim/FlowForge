{
  "key": "telesign",
  "name": "Telesign",
  "category": "Communication",
  "description": "Send SMS alerts, OTPs and marketing texts and check their status.",
  "brand": "telesign",
  "website": "https://www.telesign.com",
  "docs_url": "https://developer.telesign.com/enterprise/reference/sendsms",
  "base_url": "https://rest-api.telesign.com/v1",
  "auth": [
    {
      "type": "basic",
      "fields": [
        { "key": "username", "label": "Customer ID", "type": "string", "required": true },
        { "key": "password", "label": "API key", "type": "password", "required": true }
      ]
    }
  ],
  "actions": [
    {
      "key": "send_sms",
      "name": "Send SMS",
      "method": "POST",
      "endpoint": "/messaging",
      "body_format": "form",
      "body": { "phone_number": "{{ inputs.phone_number }}", "message": "{{ inputs.message }}", "message_type": "{{ inputs.message_type }}" },
      "inputs": [
        { "key": "phone_number", "label": "To", "type": "string", "required": true, "placeholder": "15555551234", "help": "Country code + number, digits only." },
        { "key": "message", "label": "Message", "type": "text", "required": true },
        { "key": "message_type", "label": "Message type", "type": "select", "required": true, "default": "ARN", "options": [
          { "value": "ARN", "label": "Alert / notification" }, { "value": "OTP", "label": "One-time passcode" }, { "value": "MKT", "label": "Marketing" }
        ] }
      ]
    },
    {
      "key": "get_status",
      "name": "Get message status",
      "method": "GET",
      "endpoint": "/messaging/{{ inputs.reference_id }}",
      "inputs": [{ "key": "reference_id", "label": "Reference ID", "type": "string", "required": true }]
    }
  ]
}
