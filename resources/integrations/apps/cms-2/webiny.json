{
  "key": "webiny",
  "name": "Webiny",
  "category": "CMS & Websites",
  "description": "Read and manage Webiny Headless CMS content with GraphQL.",
  "brand": "webiny",
  "website": "https://www.webiny.com",
  "docs_url": "https://www.webiny.com/docs/headless-cms/basics/graphql-api",
  "base_url": "{{ credentials.api_url }}",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "api_url",
          "label": "API URL",
          "type": "string",
          "required": true,
          "placeholder": "https://d1234.cloudfront.net",
          "help": "The API URL from `webiny info`, no trailing slash."
        },
        {
          "key": "token",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Settings > Access Management > API Keys."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "read_query",
      "name": "Query published content",
      "method": "POST",
      "endpoint": "/cms/read/{{ inputs.locale }}",
      "body": {
        "query": "{{ inputs.query }}",
        "variables": "{{ inputs.variables }}"
      },
      "inputs": [
        {
          "key": "locale",
          "label": "Locale",
          "type": "string",
          "required": true,
          "default": "en-US"
        },
        {
          "key": "query",
          "label": "Query",
          "type": "code",
          "required": true,
          "placeholder": "query { listArticles { data { id title } } }"
        },
        {
          "key": "variables",
          "label": "Variables",
          "type": "json"
        }
      ]
    },
    {
      "key": "manage_query",
      "name": "Run Manage API query",
      "description": "Creates, updates and publishes entries (drafts included).",
      "method": "POST",
      "endpoint": "/cms/manage/{{ inputs.locale }}",
      "body": {
        "query": "{{ inputs.query }}",
        "variables": "{{ inputs.variables }}"
      },
      "inputs": [
        {
          "key": "locale",
          "label": "Locale",
          "type": "string",
          "required": true,
          "default": "en-US"
        },
        {
          "key": "query",
          "label": "Query or mutation",
          "type": "code",
          "required": true
        },
        {
          "key": "variables",
          "label": "Variables",
          "type": "json"
        }
      ]
    }
  ]
}
