{
  "key": "ortto",
  "name": "Ortto",
  "category": "Marketing & Email",
  "description": "Create or update people in your Ortto customer data.",
  "brand": "ortto",
  "website": "https://ortto.com",
  "docs_url": "https://help.ortto.com/developer/latest/api-reference/",
  "base_url": "https://{{ credentials.host }}/v1",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "X-Api-Key",
    "fields": [
      {
        "key": "host",
        "label": "Region",
        "type": "select",
        "required": true,
        "default": "api.ap3api.com",
        "options": [
          {
            "value": "api.ap3api.com",
            "label": "Default"
          },
          {
            "value": "api.eu.ap3api.com",
            "label": "EU"
          },
          {
            "value": "api.au.ap3api.com",
            "label": "Australia"
          }
        ]
      },
      {
        "key": "api_key",
        "label": "Private API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "merge_person",
      "name": "Create or update person",
      "method": "POST",
      "endpoint": "/person/merge",
      "body": {
        "people": [
          {
            "fields": {
              "str::email": "{{ inputs.email }}",
              "str::first": "{{ inputs.first_name }}",
              "str::last": "{{ inputs.last_name }}"
            },
            "tags": "{{ inputs.tags }}"
          }
        ],
        "merge_by": [
          "str::email"
        ]
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "first_name",
          "label": "First name",
          "type": "string"
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "tags",
          "label": "Tags",
          "type": "list"
        }
      ]
    }
  ]
}
