{
  "key": "json2video",
  "name": "JSON2Video",
  "category": "Video & Media",
  "description": "Render videos from JSON movie definitions or saved templates.",
  "brand": "json2video",
  "website": "https://json2video.com",
  "docs_url": "https://json2video.com/docs/v2/",
  "base_url": "https://api.json2video.com/v2",
  "auth": { "type": "api_key", "in": "header", "name": "x-api-key" },
  "actions": [
    {
      "key": "create_movie",
      "name": "Create movie",
      "description": "Starts rendering a movie; returns a project ID.",
      "method": "POST",
      "endpoint": "/movies",
      "body": "{{ inputs.movie }}",
      "inputs": [
        { "key": "movie", "label": "Movie (JSON)", "type": "json", "required": true, "placeholder": "{\"resolution\":\"full-hd\",\"scenes\":[{\"elements\":[{\"type\":\"text\",\"text\":\"Hello\",\"duration\":5}]}]}" }
      ]
    },
    {
      "key": "render_template",
      "name": "Render template",
      "method": "POST",
      "endpoint": "/movies",
      "body": { "template": "{{ inputs.template_id }}", "variables": "{{ inputs.variables }}" },
      "inputs": [
        { "key": "template_id", "label": "Template ID", "type": "string", "required": true },
        { "key": "variables", "label": "Variables", "type": "keyvalue" }
      ]
    },
    {
      "key": "get_movie_status",
      "name": "Get movie status",
      "description": "Status and download URL once done.",
      "method": "GET",
      "endpoint": "/movies",
      "query": { "project": "{{ inputs.project_id }}" },
      "inputs": [{ "key": "project_id", "label": "Project ID", "type": "string", "required": true }]
    }
  ]
}
