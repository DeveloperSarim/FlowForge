{
  "key": "valueserp",
  "name": "VALUE SERP",
  "category": "Ads & SEO",
  "description": "Google web, news, image, video, shopping and places results as JSON.",
  "brand": "valueserp",
  "website": "https://www.valueserp.com",
  "docs_url": "https://docs.trajectdata.com/valueserp",
  "base_url": "https://api.valueserp.com",
  "auth": { "type": "api_key", "in": "query", "name": "api_key" },
  "actions": [
    {
      "key": "search",
      "name": "Search Google",
      "method": "GET",
      "endpoint": "/search",
      "query": {
        "q": "{{ inputs.q }}",
        "search_type": "{{ inputs.search_type }}",
        "location": "{{ inputs.location }}",
        "gl": "{{ inputs.gl }}",
        "hl": "{{ inputs.hl }}",
        "google_domain": "{{ inputs.google_domain }}",
        "num": "{{ inputs.num }}",
        "page": "{{ inputs.page }}"
      },
      "inputs": [
        { "key": "q", "label": "Search query", "type": "string", "required": true },
        { "key": "search_type", "label": "Search type", "type": "select", "options": [
          { "value": "news", "label": "News" }, { "value": "images", "label": "Images" }, { "value": "videos", "label": "Videos" },
          { "value": "shopping", "label": "Shopping" }, { "value": "places", "label": "Places" }
        ], "help": "Leave empty for regular web results." },
        { "key": "location", "label": "Location", "type": "string", "placeholder": "Austin,Texas,United States" },
        { "key": "gl", "label": "Country code", "type": "string", "placeholder": "us" },
        { "key": "hl", "label": "Language code", "type": "string", "placeholder": "en" },
        { "key": "google_domain", "label": "Google domain", "type": "string", "placeholder": "google.com" },
        { "key": "num", "label": "Results", "type": "number", "default": 10 },
        { "key": "page", "label": "Page", "type": "number", "default": 1 }
      ]
    },
    {
      "key": "get_account",
      "name": "Get account usage",
      "method": "GET",
      "endpoint": "/account",
      "inputs": []
    }
  ]
}
