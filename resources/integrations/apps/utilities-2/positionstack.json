{
  "key": "positionstack",
  "name": "positionstack",
  "category": "Utilities",
  "description": "Forward and reverse geocoding for addresses and coordinates.",
  "brand": "positionstack",
  "website": "https://positionstack.com",
  "docs_url": "https://positionstack.com/documentation",
  "base_url": "https://api.positionstack.com/v1",
  "auth": { "type": "api_key", "in": "query", "name": "access_key", "fields": [
    { "key": "api_key", "label": "Access key", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "forward",
      "name": "Geocode address",
      "method": "GET",
      "endpoint": "/forward",
      "query": { "query": "{{ inputs.query }}", "country": "{{ inputs.country }}", "region": "{{ inputs.region }}", "limit": "{{ inputs.limit }}" },
      "error_path": "error",
      "inputs": [
        { "key": "query", "label": "Address", "type": "string", "required": true, "placeholder": "1600 Pennsylvania Ave NW, Washington DC" },
        { "key": "country", "label": "Country", "type": "string", "placeholder": "US" },
        { "key": "region", "label": "Region", "type": "string" },
        { "key": "limit", "label": "Limit", "type": "number" }
      ]
    },
    {
      "key": "reverse",
      "name": "Reverse geocode",
      "method": "GET",
      "endpoint": "/reverse",
      "query": { "query": "{{ inputs.query }}", "limit": "{{ inputs.limit }}" },
      "error_path": "error",
      "inputs": [
        { "key": "query", "label": "Coordinates or IP", "type": "string", "required": true, "placeholder": "40.7638435,-73.9729691" },
        { "key": "limit", "label": "Limit", "type": "number" }
      ]
    }
  ]
}
