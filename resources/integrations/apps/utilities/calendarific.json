{
  "key": "calendarific",
  "name": "Calendarific",
  "category": "Utilities",
  "description": "Public, religious and observance holidays for 230+ countries.",
  "brand": "calendarific",
  "website": "https://calendarific.com",
  "docs_url": "https://calendarific.com/api-documentation",
  "base_url": "https://calendarific.com/api/v2",
  "auth": { "type": "api_key", "in": "query", "name": "api_key", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "list_holidays",
      "name": "List holidays",
      "method": "GET",
      "endpoint": "/holidays",
      "query": { "country": "{{ inputs.country }}", "year": "{{ inputs.year }}", "month": "{{ inputs.month }}", "day": "{{ inputs.day }}", "type": "{{ inputs.type }}" },
      "output_path": "response.holidays",
      "inputs": [
        { "key": "country", "label": "Country (ISO code)", "type": "string", "required": true, "placeholder": "US" },
        { "key": "year", "label": "Year", "type": "number", "required": true, "placeholder": "2026" },
        { "key": "month", "label": "Month", "type": "number" },
        { "key": "day", "label": "Day", "type": "number" },
        { "key": "type", "label": "Type", "type": "select", "options": [
          { "value": "", "label": "All" }, { "value": "national", "label": "National" }, { "value": "local", "label": "Local" },
          { "value": "religious", "label": "Religious" }, { "value": "observance", "label": "Observance" }
        ] }
      ]
    },
    {
      "key": "list_countries",
      "name": "List countries",
      "method": "GET",
      "endpoint": "/countries",
      "output_path": "response.countries",
      "inputs": []
    }
  ]
}
