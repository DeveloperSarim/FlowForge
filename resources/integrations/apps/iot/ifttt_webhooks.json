{
  "key": "ifttt_webhooks",
  "name": "IFTTT Webhooks",
  "category": "IoT & Smart Home",
  "description": "Fire IFTTT Webhooks events to run your applets and smart-home actions.",
  "brand": "ifttt",
  "website": "https://ifttt.com/maker_webhooks",
  "docs_url": "https://help.ifttt.com/hc/en-us/articles/115010230347-Webhooks-service-FAQ",
  "base_url": "https://maker.ifttt.com",
  "auth": [
    {
      "type": "api_key",
      "fields": [
        { "key": "api_key", "label": "Webhooks key", "type": "password", "required": true, "help": "ifttt.com/maker_webhooks > Documentation shows your key." }
      ]
    }
  ],
  "actions": [
    {
      "key": "trigger_event",
      "name": "Trigger event",
      "description": "Fires an event with up to three values (value1-value3) for your applet.",
      "method": "POST",
      "endpoint": "/trigger/{{ inputs.event }}/with/key/{{ credentials.api_key }}",
      "body": { "value1": "{{ inputs.value1 }}", "value2": "{{ inputs.value2 }}", "value3": "{{ inputs.value3 }}" },
      "inputs": [
        { "key": "event", "label": "Event name", "type": "string", "required": true, "placeholder": "front_door_opened" },
        { "key": "value1", "label": "Value 1", "type": "string" },
        { "key": "value2", "label": "Value 2", "type": "string" },
        { "key": "value3", "label": "Value 3", "type": "string" }
      ]
    },
    {
      "key": "trigger_event_json",
      "name": "Trigger event with JSON",
      "description": "Fires an event with an arbitrary JSON payload (for applets using JsonPayload / filter code).",
      "method": "POST",
      "endpoint": "/trigger/{{ inputs.event }}/json/with/key/{{ credentials.api_key }}",
      "body": "{{ inputs.payload }}",
      "inputs": [
        { "key": "event", "label": "Event name", "type": "string", "required": true },
        { "key": "payload", "label": "Payload", "type": "json", "required": true }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Applet web request",
      "type": "webhook",
      "description": "Use the Webhooks \"Make a web request\" action in an applet and point it at this URL.",
      "inputs": [
        { "key": "sample_payload", "label": "Test payload (JSON)", "type": "json" }
      ]
    }
  ]
}
