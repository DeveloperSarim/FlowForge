{
  "key": "criteo",
  "name": "Criteo",
  "category": "Ads & SEO",
  "description": "List your Criteo advertisers and pull campaign statistics reports.",
  "brand": "criteo",
  "website": "https://www.criteo.com",
  "docs_url": "https://developers.criteo.com/marketing-solutions/docs",
  "base_url": "https://api.criteo.com/{{ credentials.api_version }}",
  "auth": {
    "type": "oauth2",
    "authorize_url": "https://consent.criteo.com/request",
    "token_url": "https://api.criteo.com/oauth2/token",
    "fields": [
      {
        "key": "api_version",
        "label": "API version",
        "type": "string",
        "required": true,
        "default": "2026-01",
        "help": "Criteo ships a version each quarter (YYYY-MM) and supports it for about a year; bump it when yours is retired."
      }
    ]
  },
  "actions": [
    {
      "key": "list_advertisers",
      "name": "List advertisers",
      "description": "Advertisers this app was granted access to.",
      "method": "GET",
      "endpoint": "/advertisers/me",
      "output_path": "data",
      "inputs": []
    },
    {
      "key": "get_statistics",
      "name": "Get statistics report",
      "method": "POST",
      "endpoint": "/statistics/report",
      "body": {
        "advertiserIds": "{{ inputs.advertiser_ids }}",
        "startDate": "{{ inputs.start_date }}",
        "endDate": "{{ inputs.end_date }}",
        "dimensions": "{{ inputs.dimensions }}",
        "metrics": "{{ inputs.metrics }}",
        "currency": "{{ inputs.currency }}",
        "timezone": "{{ inputs.timezone }}",
        "format": "json"
      },
      "inputs": [
        {
          "key": "advertiser_ids",
          "label": "Advertiser IDs (comma-separated)",
          "type": "string",
          "required": true
        },
        {
          "key": "start_date",
          "label": "Start date (YYYY-MM-DD)",
          "type": "string",
          "required": true
        },
        {
          "key": "end_date",
          "label": "End date (YYYY-MM-DD)",
          "type": "string",
          "required": true
        },
        {
          "key": "dimensions",
          "label": "Dimensions",
          "type": "list",
          "required": true,
          "placeholder": "AdsetId",
          "help": "e.g. AdsetId, CampaignId, Day, Month, Os, Device."
        },
        {
          "key": "metrics",
          "label": "Metrics",
          "type": "list",
          "required": true,
          "placeholder": "Clicks",
          "help": "e.g. Clicks, Displays, AdvertiserCost, SalesAllClientAttribution."
        },
        {
          "key": "currency",
          "label": "Currency",
          "type": "string",
          "default": "USD"
        },
        {
          "key": "timezone",
          "label": "Time zone",
          "type": "string",
          "placeholder": "Europe/Paris"
        }
      ]
    }
  ]
}