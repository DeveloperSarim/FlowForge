{
  "key": "sendcloud",
  "name": "Sendcloud",
  "category": "E-commerce",
  "description": "Create parcels and shipping labels and list shipping methods.",
  "brand": "sendcloud",
  "website": "https://www.sendcloud.com",
  "docs_url": "https://api.sendcloud.dev/docs/sendcloud-public-api/",
  "base_url": "https://panel.sendcloud.sc/api/v2",
  "auth": [
    {
      "type": "basic",
      "fields": [
        {
          "key": "username",
          "label": "Public key",
          "type": "string",
          "required": true,
          "help": "Settings > Integrations > Sendcloud API."
        },
        {
          "key": "password",
          "label": "Secret key",
          "type": "password",
          "required": true
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "create_parcel",
      "name": "Create parcel",
      "method": "POST",
      "endpoint": "/parcels",
      "output_path": "parcel",
      "body": {
        "parcel": {
          "name": "{{ inputs.name }}",
          "company_name": "{{ inputs.company_name }}",
          "address": "{{ inputs.address }}",
          "house_number": "{{ inputs.house_number }}",
          "city": "{{ inputs.city }}",
          "postal_code": "{{ inputs.postal_code }}",
          "country": "{{ inputs.country }}",
          "telephone": "{{ inputs.telephone }}",
          "email": "{{ inputs.email }}",
          "order_number": "{{ inputs.order_number }}",
          "weight": "{{ inputs.weight }}",
          "request_label": "{{ inputs.request_label }}",
          "shipment": "{{ inputs.shipment }}"
        }
      },
      "inputs": [
        {
          "key": "name",
          "label": "Recipient name",
          "type": "string",
          "required": true
        },
        {
          "key": "company_name",
          "label": "Company",
          "type": "string"
        },
        {
          "key": "address",
          "label": "Street",
          "type": "string",
          "required": true
        },
        {
          "key": "house_number",
          "label": "House number",
          "type": "string"
        },
        {
          "key": "city",
          "label": "City",
          "type": "string",
          "required": true
        },
        {
          "key": "postal_code",
          "label": "Postal code",
          "type": "string",
          "required": true
        },
        {
          "key": "country",
          "label": "Country (ISO 2)",
          "type": "string",
          "required": true,
          "placeholder": "NL"
        },
        {
          "key": "telephone",
          "label": "Phone",
          "type": "string"
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string"
        },
        {
          "key": "order_number",
          "label": "Order number",
          "type": "string"
        },
        {
          "key": "weight",
          "label": "Weight (kg)",
          "type": "string",
          "placeholder": "1.5"
        },
        {
          "key": "request_label",
          "label": "Create label now",
          "type": "boolean"
        },
        {
          "key": "shipment",
          "label": "Shipping method",
          "type": "json",
          "placeholder": "{\"id\": 8}"
        }
      ]
    },
    {
      "key": "get_parcel",
      "name": "Get parcel",
      "method": "GET",
      "endpoint": "/parcels/{{ inputs.parcel_id }}",
      "output_path": "parcel",
      "inputs": [
        {
          "key": "parcel_id",
          "label": "Parcel ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_shipping_methods",
      "name": "List shipping methods",
      "method": "GET",
      "endpoint": "/shipping_methods",
      "output_path": "shipping_methods",
      "inputs": []
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "Settings > Integrations > your API integration > enable webhooks and paste this URL.",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
