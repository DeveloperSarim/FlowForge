{
  "key": "clicksend",
  "name": "ClickSend",
  "category": "Communication",
  "description": "Send SMS and read inbound SMS and account details from ClickSend.",
  "brand": "clicksend",
  "website": "https://www.clicksend.com",
  "docs_url": "https://developers.clicksend.com/docs/rest/v3/",
  "base_url": "https://rest.clicksend.com/v3",
  "auth": [
    {
      "type": "basic",
      "fields": [
        { "key": "username", "label": "Username", "type": "string", "required": true },
        { "key": "password", "label": "API key", "type": "password", "required": true }
      ]
    }
  ],
  "actions": [
    {
      "key": "send_sms",
      "name": "Send SMS",
      "method": "POST",
      "endpoint": "/sms/send",
      "body": { "messages": [{ "source": "flowforge", "to": "{{ inputs.to }}", "from": "{{ inputs.from }}", "body": "{{ inputs.body }}", "schedule": "{{ inputs.schedule }}" }] },
      "output_path": "data",
      "inputs": [
        { "key": "to", "label": "To", "type": "string", "required": true, "placeholder": "+61411111111" },
        { "key": "from", "label": "From (sender ID)", "type": "string" },
        { "key": "body", "label": "Message", "type": "text", "required": true },
        { "key": "schedule", "label": "Send at (Unix timestamp)", "type": "number" }
      ]
    },
    {
      "key": "list_inbound_sms",
      "name": "List inbound SMS",
      "method": "GET",
      "endpoint": "/sms/inbound",
      "output_path": "data.data",
      "inputs": []
    },
    {
      "key": "get_account",
      "name": "Get account (balance)",
      "method": "GET",
      "endpoint": "/account",
      "output_path": "data",
      "inputs": []
    }
  ]
}
