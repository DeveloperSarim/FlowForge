{
  "key": "getform",
  "name": "Getform",
  "category": "Forms & Surveys",
  "description": "Read Getform submissions and trigger on new ones.",
  "brand": "getform",
  "website": "https://getform.io",
  "docs_url": "https://docs.getform.io/",
  "base_url": "https://api.getform.io/v1",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "token",
    "fields": [
      {
        "key": "api_key",
        "label": "API token",
        "type": "password",
        "required": true,
        "help": "Form > Settings > API"
      }
    ]
  },
  "actions": [
    {
      "key": "list_submissions",
      "name": "List submissions",
      "method": "GET",
      "endpoint": "/forms/{{ inputs.form_id }}",
      "query": {
        "page": "{{ inputs.page }}"
      },
      "inputs": [
        {
          "key": "form_id",
          "label": "Form endpoint ID",
          "type": "string",
          "required": true,
          "help": "The id in getform.io/f/<ID>"
        },
        {
          "key": "page",
          "label": "Page",
          "type": "number"
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "new_submission",
      "name": "New submission (webhook)",
      "type": "webhook",
      "description": "Form > Automations > Webhook, paste this URL.",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
