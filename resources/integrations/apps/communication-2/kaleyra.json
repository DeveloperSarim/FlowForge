{
  "key": "kaleyra",
  "name": "Kaleyra",
  "category": "Communication",
  "description": "Send SMS (including India DLT templates) through Kaleyra.",
  "brand": "kaleyra",
  "website": "https://www.kaleyra.com",
  "docs_url": "https://developers.kaleyra.io/docs/send-an-sms",
  "base_url": "https://{{ credentials.host }}/v1/{{ credentials.sid }}",
  "auth": [
    { "type": "api_key", "in": "header", "name": "api-key", "fields": [
      { "key": "host", "label": "API domain", "type": "string", "required": true, "default": "api.kaleyra.io", "help": "Use the API domain shown in your Kaleyra console if it differs." },
      { "key": "sid", "label": "SID", "type": "string", "required": true },
      { "key": "api_key", "label": "API key", "type": "password", "required": true }
    ] }
  ],
  "actions": [
    {
      "key": "send_sms",
      "name": "Send SMS",
      "method": "POST",
      "endpoint": "/messages",
      "body_format": "form",
      "body": {
        "to": "{{ inputs.to }}",
        "sender": "{{ inputs.sender }}",
        "type": "{{ inputs.type }}",
        "body": "{{ inputs.body }}",
        "template_id": "{{ inputs.template_id }}"
      },
      "inputs": [
        { "key": "to", "label": "To (with country code)", "type": "string", "required": true, "placeholder": "+919876543210" },
        { "key": "sender", "label": "Sender ID", "type": "string", "required": true },
        { "key": "body", "label": "Message", "type": "text", "required": true },
        { "key": "type", "label": "Message type", "type": "select", "default": "DEFAULT", "options": [
          { "value": "DEFAULT", "label": "Default" }, { "value": "TXN", "label": "Transactional" },
          { "value": "MKT", "label": "Promotional" }, { "value": "OTP", "label": "OTP" }
        ] },
        { "key": "template_id", "label": "DLT template ID", "type": "string", "help": "Required for messages to India." }
      ]
    }
  ]
}
