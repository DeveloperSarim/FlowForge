{
  "key": "arkesel",
  "name": "Arkesel",
  "category": "Communication",
  "description": "Send SMS in Ghana and across Africa with Arkesel.",
  "brand": "arkesel",
  "website": "https://arkesel.com",
  "docs_url": "https://developers.arkesel.com",
  "base_url": "https://sms.arkesel.com/api/v2",
  "auth": [
    { "type": "api_key", "in": "header", "name": "api-key", "fields": [{ "key": "api_key", "label": "API key", "type": "password", "required": true, "help": "Dashboard → SMS API." }] }
  ],
  "actions": [
    {
      "key": "send_sms",
      "name": "Send SMS",
      "method": "POST",
      "endpoint": "/sms/send",
      "body": {
        "sender": "{{ inputs.sender }}",
        "message": "{{ inputs.message }}",
        "recipients": "{{ inputs.recipients }}",
        "scheduled_date": "{{ inputs.scheduled_date }}"
      },
      "inputs": [
        { "key": "sender", "label": "Sender ID", "type": "string", "required": true, "help": "Max 11 characters." },
        { "key": "message", "label": "Message", "type": "text", "required": true },
        { "key": "recipients", "label": "Recipients", "type": "list", "required": true, "placeholder": "233544919953" },
        { "key": "scheduled_date", "label": "Schedule for", "type": "string", "placeholder": "2026-12-31 07:00 AM" }
      ]
    }
  ]
}
