{
  "key": "carbone",
  "name": "Carbone",
  "category": "Files & Documents",
  "description": "Render PDF, DOCX and XLSX reports from Carbone templates and JSON data.",
  "brand": "carbone",
  "website": "https://carbone.io",
  "docs_url": "https://carbone.io/api-reference.html",
  "base_url": "https://api.carbone.io",
  "headers": {
    "carbone-version": "5"
  },
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Carbone account > API keys (test or production)."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "render",
      "name": "Render report",
      "description": "Returns a renderId; download it from /render/{renderId}.",
      "method": "POST",
      "endpoint": "/render/{{ inputs.template_id }}",
      "body": {
        "data": "{{ inputs.data }}",
        "convertTo": "{{ inputs.convert_to }}"
      },
      "timeout": 120,
      "inputs": [
        {
          "key": "template_id",
          "label": "Template ID",
          "type": "string",
          "required": true
        },
        {
          "key": "data",
          "label": "Data",
          "type": "json",
          "required": true
        },
        {
          "key": "convert_to",
          "label": "Convert to",
          "type": "string",
          "placeholder": "pdf",
          "help": "pdf, docx, xlsx, odt ... Leave empty to keep the template format."
        }
      ]
    }
  ]
}
