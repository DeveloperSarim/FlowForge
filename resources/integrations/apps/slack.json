{
  "key": "slack",
  "name": "Slack",
  "category": "Communication",
  "description": "Post messages to channels with a Slack bot token.",
  "base_url": "https://slack.com/api",
  "auth": { "type": "bearer", "fields": [{ "key": "token", "label": "Bot User OAuth Token (xoxb-…)", "type": "password", "required": true }] },
  "actions": [
    {
      "key": "post_message",
      "name": "Post message",
      "method": "POST",
      "endpoint": "/chat.postMessage",
      "error_path": "error",
      "body": { "channel": "{{ inputs.channel }}", "text": "{{ inputs.text }}", "thread_ts": "{{ inputs.thread_ts }}", "unfurl_links": "{{ inputs.unfurl_links }}" },
      "inputs": [
        { "key": "channel", "label": "Channel", "type": "string", "required": true, "placeholder": "#general or C0123456", "help": "Invite the bot to the channel first." },
        { "key": "text", "label": "Message", "type": "text", "required": true },
        { "key": "thread_ts", "label": "Reply in thread (ts)", "type": "string" },
        { "key": "unfurl_links", "label": "Unfurl links", "type": "boolean", "default": true }
      ]
    },
    {
      "key": "lookup_user",
      "name": "Find user by email",
      "method": "GET",
      "endpoint": "/users.lookupByEmail",
      "error_path": "error",
      "query": { "email": "{{ inputs.email }}" },
      "output_path": "user",
      "inputs": [{ "key": "email", "label": "Email", "type": "string", "required": true }]
    }
  ]
}
