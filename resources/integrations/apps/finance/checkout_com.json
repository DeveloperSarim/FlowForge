{
  "key": "checkout_com",
  "name": "Checkout.com",
  "category": "Payments & Finance",
  "description": "Create payment links, look up payments and issue refunds.",
  "brand": "checkout.com",
  "website": "https://www.checkout.com",
  "docs_url": "https://api-reference.checkout.com/",
  "base_url": "https://{{ credentials.environment }}",
  "idempotency_header": "Cko-Idempotency-Key",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "environment",
          "label": "Environment",
          "type": "select",
          "required": true,
          "default": "api.checkout.com",
          "options": [
            {
              "value": "api.checkout.com",
              "label": "Live"
            },
            {
              "value": "api.sandbox.checkout.com",
              "label": "Sandbox"
            }
          ]
        },
        {
          "key": "token",
          "label": "Secret key",
          "type": "password",
          "required": true,
          "help": "Dashboard > Developers > Keys (sk_…)."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "create_payment_link",
      "name": "Create payment link",
      "method": "POST",
      "endpoint": "/payment-links",
      "output_fields": {
        "url": "_links.redirect.href"
      },
      "body": {
        "amount": "{{ inputs.amount }}",
        "currency": "{{ inputs.currency }}",
        "reference": "{{ inputs.reference }}",
        "description": "{{ inputs.description }}",
        "billing": {
          "address": {
            "country": "{{ inputs.country }}"
          }
        },
        "customer": {
          "email": "{{ inputs.email }}",
          "name": "{{ inputs.name }}"
        },
        "return_url": "{{ inputs.return_url }}"
      },
      "inputs": [
        {
          "key": "amount",
          "label": "Amount (minor units)",
          "type": "number",
          "required": true
        },
        {
          "key": "currency",
          "label": "Currency",
          "type": "string",
          "required": true,
          "default": "GBP"
        },
        {
          "key": "reference",
          "label": "Reference",
          "type": "string"
        },
        {
          "key": "description",
          "label": "Description",
          "type": "string"
        },
        {
          "key": "country",
          "label": "Billing country (ISO 2)",
          "type": "string",
          "required": true,
          "placeholder": "GB"
        },
        {
          "key": "email",
          "label": "Customer email",
          "type": "string"
        },
        {
          "key": "name",
          "label": "Customer name",
          "type": "string"
        },
        {
          "key": "return_url",
          "label": "Return URL",
          "type": "string"
        }
      ]
    },
    {
      "key": "get_payment",
      "name": "Get payment",
      "method": "GET",
      "endpoint": "/payments/{{ inputs.payment_id }}",
      "inputs": [
        {
          "key": "payment_id",
          "label": "Payment ID",
          "type": "string",
          "required": true,
          "placeholder": "pay_…"
        }
      ]
    },
    {
      "key": "refund_payment",
      "name": "Refund payment",
      "method": "POST",
      "endpoint": "/payments/{{ inputs.payment_id }}/refunds",
      "body": {
        "amount": "{{ inputs.amount }}",
        "reference": "{{ inputs.reference }}"
      },
      "inputs": [
        {
          "key": "payment_id",
          "label": "Payment ID",
          "type": "string",
          "required": true
        },
        {
          "key": "amount",
          "label": "Amount (minor units)",
          "type": "number",
          "help": "Blank = full refund."
        },
        {
          "key": "reference",
          "label": "Reference",
          "type": "string"
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "Dashboard > Developers > Workflows/Webhooks: add this URL as a webhook action.",
      "data_path": "data",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
