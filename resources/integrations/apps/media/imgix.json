{
  "key": "imgix",
  "name": "imgix",
  "category": "Video & Media",
  "description": "Purge cached images and read sources from the imgix Management API.",
  "brand": "imgix",
  "website": "https://www.imgix.com",
  "docs_url": "https://docs.imgix.com/apis/management",
  "base_url": "https://api.imgix.com/api/v1",
  "headers": { "Accept": "application/vnd.api+json", "Content-Type": "application/vnd.api+json" },
  "auth": { "type": "bearer", "fields": [{ "key": "token", "label": "API key", "type": "password", "required": true, "help": "Dashboard > API Keys." }] },
  "actions": [
    {
      "key": "purge_image",
      "name": "Purge image",
      "description": "Clears an image from the imgix cache.",
      "method": "POST",
      "endpoint": "/purge",
      "body": { "data": { "attributes": { "url": "{{ inputs.url }}" }, "type": "purges" } },
      "inputs": [{ "key": "url", "label": "Image URL", "type": "string", "required": true, "placeholder": "https://your-source.imgix.net/image.jpg" }]
    },
    {
      "key": "list_sources",
      "name": "List sources",
      "method": "GET",
      "endpoint": "/sources",
      "output_path": "data",
      "inputs": []
    },
    {
      "key": "get_source",
      "name": "Get source",
      "method": "GET",
      "endpoint": "/sources/{{ inputs.source_id }}",
      "output_path": "data",
      "inputs": [{ "key": "source_id", "label": "Source ID", "type": "string", "required": true }]
    }
  ]
}
