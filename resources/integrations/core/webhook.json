{
  "key": "webhook",
  "name": "Webhook",
  "icon": "webhook",
  "category": "Triggers",
  "description": "Start a run whenever an HTTP request hits this workflow's unique URL.",
  "triggers": [
    {
      "key": "catch",
      "name": "Catch webhook",
      "type": "webhook",
      "inputs": [
        { "key": "method", "label": "HTTP method", "type": "select", "default": "ANY", "options": [
          { "value": "ANY", "label": "Any method" }, { "value": "GET", "label": "GET" }, { "value": "POST", "label": "POST" },
          { "value": "PUT", "label": "PUT" }, { "value": "PATCH", "label": "PATCH" }, { "value": "DELETE", "label": "DELETE" }
        ] },
        { "key": "sample_payload", "label": "Test payload (JSON)", "type": "json", "help": "Used by \"Test workflow\". Leave empty to use the last request captured while the workflow was inactive." }
      ]
    }
  ]
}
