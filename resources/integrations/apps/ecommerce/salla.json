{
  "key": "salla",
  "name": "Salla",
  "category": "E-commerce",
  "description": "Read orders, products and customers from a Salla store.",
  "brand": "salla",
  "website": "https://salla.sa",
  "docs_url": "https://docs.salla.dev/",
  "base_url": "https://api.salla.dev/admin/v2",
  "auth": [
    {
      "type": "oauth2",
      "authorize_url": "https://accounts.salla.sa/oauth2/auth",
      "token_url": "https://accounts.salla.sa/oauth2/token",
      "scopes": [
        "offline_access"
      ]
    }
  ],
  "actions": [
    {
      "key": "list_orders",
      "name": "List orders",
      "method": "GET",
      "endpoint": "/orders",
      "output_path": "data",
      "query": {
        "page": "{{ inputs.page }}",
        "per_page": "{{ inputs.per_page }}"
      },
      "inputs": [
        {
          "key": "page",
          "label": "Page",
          "type": "number"
        },
        {
          "key": "per_page",
          "label": "Per page",
          "type": "number",
          "default": 15
        }
      ]
    },
    {
      "key": "get_order",
      "name": "Get order",
      "method": "GET",
      "endpoint": "/orders/{{ inputs.order_id }}",
      "output_path": "data",
      "inputs": [
        {
          "key": "order_id",
          "label": "Order ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_products",
      "name": "List products",
      "method": "GET",
      "endpoint": "/products",
      "output_path": "data",
      "query": {
        "keyword": "{{ inputs.keyword }}"
      },
      "inputs": [
        {
          "key": "keyword",
          "label": "Keyword",
          "type": "string"
        }
      ]
    },
    {
      "key": "list_customers",
      "name": "List customers",
      "method": "GET",
      "endpoint": "/customers",
      "output_path": "data",
      "query": {
        "keyword": "{{ inputs.keyword }}"
      },
      "inputs": [
        {
          "key": "keyword",
          "label": "Keyword",
          "type": "string",
          "help": "Name, email or mobile."
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "In the Salla Partners portal, set this URL as your app webhook and pick events.",
      "data_path": "data",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
