{
  "key": "meetup",
  "name": "Meetup",
  "category": "Events & Webinars",
  "description": "Query and manage Meetup groups, events and RSVPs with the GraphQL API.",
  "brand": "meetup",
  "website": "https://www.meetup.com",
  "docs_url": "https://www.meetup.com/api/guide/",
  "base_url": "https://api.meetup.com",
  "auth": [
    {
      "type": "oauth2",
      "authorize_url": "https://secure.meetup.com/oauth2/authorize",
      "token_url": "https://secure.meetup.com/oauth2/access"
    }
  ],
  "actions": [
    {
      "key": "graphql",
      "name": "Run GraphQL query",
      "description": "Explore queries and mutations in the Meetup API playground.",
      "method": "POST",
      "endpoint": "/gql-ext",
      "body": {
        "query": "{{ inputs.query }}",
        "variables": "{{ inputs.variables }}"
      },
      "error_path": "errors.0.message",
      "output_path": "data",
      "inputs": [
        {
          "key": "query",
          "label": "Query",
          "type": "code",
          "required": true,
          "placeholder": "query { self { id name email } }"
        },
        {
          "key": "variables",
          "label": "Variables",
          "type": "json"
        }
      ]
    }
  ]
}
