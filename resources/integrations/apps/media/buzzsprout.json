{
  "key": "buzzsprout",
  "name": "Buzzsprout",
  "category": "Video & Media",
  "description": "Create, update and list podcast episodes on Buzzsprout.",
  "brand": "buzzsprout",
  "website": "https://www.buzzsprout.com",
  "docs_url": "https://github.com/buzzsprout/buzzsprout-api",
  "popular": true,
  "base_url": "https://www.buzzsprout.com/api/{{ credentials.podcast_id }}",
  "auth": { "type": "api_key", "in": "header", "name": "Authorization", "prefix": "Token token=", "fields": [
    { "key": "podcast_id", "label": "Podcast ID", "type": "string", "required": true, "help": "Shown under Podcast Settings > API Access." },
    { "key": "api_key", "label": "API token", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "list_episodes",
      "name": "List episodes",
      "method": "GET",
      "endpoint": "/episodes.json",
      "inputs": []
    },
    {
      "key": "get_episode",
      "name": "Get episode",
      "method": "GET",
      "endpoint": "/episodes/{{ inputs.episode_id }}.json",
      "inputs": [{ "key": "episode_id", "label": "Episode ID", "type": "string", "required": true }]
    },
    {
      "key": "create_episode",
      "name": "Create episode",
      "method": "POST",
      "endpoint": "/episodes.json",
      "body": {
        "title": "{{ inputs.title }}", "description": "{{ inputs.description }}", "summary": "{{ inputs.summary }}", "artist": "{{ inputs.artist }}",
        "tags": "{{ inputs.tags }}", "audio_url": "{{ inputs.audio_url }}", "artwork_url": "{{ inputs.artwork_url }}", "published_at": "{{ inputs.published_at }}",
        "season_number": "{{ inputs.season_number }}", "episode_number": "{{ inputs.episode_number }}", "explicit": "{{ inputs.explicit }}", "private": "{{ inputs.private }}",
        "email_user_after_audio_processed": "{{ inputs.email_when_processed }}"
      },
      "inputs": [
        { "key": "title", "label": "Title", "type": "string", "required": true },
        { "key": "audio_url", "label": "Audio file URL", "type": "string", "placeholder": "https://example.com/episode.mp3" },
        { "key": "description", "label": "Description (HTML allowed)", "type": "text" },
        { "key": "summary", "label": "Summary", "type": "text" },
        { "key": "artist", "label": "Artist", "type": "string" },
        { "key": "tags", "label": "Tags (comma-separated)", "type": "string" },
        { "key": "artwork_url", "label": "Artwork URL", "type": "string" },
        { "key": "published_at", "label": "Publish at (ISO 8601)", "type": "string", "placeholder": "2026-12-01T09:00:00-05:00", "help": "Leave empty to keep it as a draft." },
        { "key": "season_number", "label": "Season", "type": "number" },
        { "key": "episode_number", "label": "Episode number", "type": "number" },
        { "key": "explicit", "label": "Explicit", "type": "boolean" },
        { "key": "private", "label": "Private", "type": "boolean" },
        { "key": "email_when_processed", "label": "Email me when audio is processed", "type": "boolean" }
      ]
    },
    {
      "key": "update_episode",
      "name": "Update episode",
      "method": "PUT",
      "endpoint": "/episodes/{{ inputs.episode_id }}.json",
      "body": { "title": "{{ inputs.title }}", "description": "{{ inputs.description }}", "summary": "{{ inputs.summary }}", "tags": "{{ inputs.tags }}", "published_at": "{{ inputs.published_at }}", "private": "{{ inputs.private }}" },
      "inputs": [
        { "key": "episode_id", "label": "Episode ID", "type": "string", "required": true },
        { "key": "title", "label": "Title", "type": "string" },
        { "key": "description", "label": "Description", "type": "text" },
        { "key": "summary", "label": "Summary", "type": "text" },
        { "key": "tags", "label": "Tags (comma-separated)", "type": "string" },
        { "key": "published_at", "label": "Publish at (ISO 8601)", "type": "string" },
        { "key": "private", "label": "Private", "type": "boolean" }
      ]
    }
  ]
}
