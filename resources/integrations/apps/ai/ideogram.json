{
  "key": "ideogram",
  "name": "Ideogram",
  "category": "AI",
  "description": "Generate images with strong text rendering.",
  "brand": "ideogram",
  "website": "https://ideogram.ai",
  "docs_url": "https://developer.ideogram.ai/api-reference",
  "base_url": "https://api.ideogram.ai",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "Api-Key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "generate_image",
      "name": "Generate image",
      "method": "POST",
      "endpoint": "/generate",
      "timeout": 120,
      "body": {
        "image_request": {
          "prompt": "{{ inputs.prompt }}",
          "model": "{{ inputs.model }}",
          "aspect_ratio": "{{ inputs.aspect_ratio }}",
          "magic_prompt_option": "{{ inputs.magic_prompt }}"
        }
      },
      "output_fields": {
        "url": "data.0.url"
      },
      "inputs": [
        {
          "key": "prompt",
          "label": "Prompt",
          "type": "text",
          "required": true
        },
        {
          "key": "model",
          "label": "Model",
          "type": "select",
          "options": [
            {
              "value": "V_2",
              "label": "V2"
            },
            {
              "value": "V_2_TURBO",
              "label": "V2 Turbo"
            },
            {
              "value": "V_2A",
              "label": "V2a"
            },
            {
              "value": "V_2A_TURBO",
              "label": "V2a Turbo"
            }
          ],
          "default": "V_2"
        },
        {
          "key": "aspect_ratio",
          "label": "Aspect ratio",
          "type": "string",
          "placeholder": "ASPECT_1_1",
          "help": "e.g. ASPECT_16_9, ASPECT_9_16."
        },
        {
          "key": "magic_prompt",
          "label": "Magic prompt",
          "type": "select",
          "options": [
            {
              "value": "AUTO",
              "label": "Auto"
            },
            {
              "value": "ON",
              "label": "On"
            },
            {
              "value": "OFF",
              "label": "Off"
            }
          ]
        }
      ]
    }
  ]
}
