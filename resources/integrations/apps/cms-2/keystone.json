{
  "key": "keystone",
  "name": "Keystone",
  "category": "CMS & Websites",
  "description": "Query and mutate a self-hosted Keystone 6 GraphQL API.",
  "brand": "keystone",
  "website": "https://keystonejs.com",
  "docs_url": "https://keystonejs.com/docs/graphql/overview",
  "base_url": "{{ credentials.base_url }}",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "base_url",
          "label": "Keystone URL",
          "type": "string",
          "required": true,
          "placeholder": "https://admin.example.com",
          "help": "No trailing slash."
        },
        {
          "key": "token",
          "label": "Session token",
          "type": "password",
          "required": false,
          "help": "Optional. The session token from authenticateUserWithPassword, for lists that need a signed-in user."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "graphql_query",
      "name": "Run GraphQL query",
      "description": "Runs a GraphQL query or mutation.",
      "method": "POST",
      "endpoint": "/api/graphql",
      "body": {
        "query": "{{ inputs.query }}",
        "variables": "{{ inputs.variables }}"
      },
      "inputs": [
        {
          "key": "query",
          "label": "Query",
          "type": "code",
          "required": true,
          "placeholder": "query { ... }"
        },
        {
          "key": "variables",
          "label": "Variables",
          "type": "json"
        }
      ]
    }
  ]
}
