{
  "key": "anvil",
  "name": "Anvil",
  "category": "Files & Documents",
  "description": "Run Anvil GraphQL queries for e-sign packets, workflows and PDF fills.",
  "brand": "anvil",
  "website": "https://www.useanvil.com",
  "docs_url": "https://www.useanvil.com/docs/api/getting-started",
  "base_url": "https://app.useanvil.com/api/v1",
  "auth": [
    {
      "type": "basic",
      "fields": [
        {
          "key": "username",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Organization settings > API settings."
        },
        {
          "key": "password",
          "label": "Password",
          "type": "password",
          "required": false,
          "help": "Leave empty."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "graphql_query",
      "name": "Run GraphQL query",
      "description": "Runs a query or mutation against the Anvil GraphQL API.",
      "method": "POST",
      "endpoint": "https://graphql.useanvil.com/",
      "body": {
        "query": "{{ inputs.query }}",
        "variables": "{{ inputs.variables }}"
      },
      "inputs": [
        {
          "key": "query",
          "label": "Query",
          "type": "code",
          "required": true,
          "placeholder": "query { ... }"
        },
        {
          "key": "variables",
          "label": "Variables",
          "type": "json"
        }
      ]
    }
  ]
}
