{
  "key": "debounce",
  "name": "DeBounce",
  "category": "Marketing & Email",
  "description": "Check if an email address is valid, disposable or a spam trap.",
  "website": "https://debounce.io",
  "docs_url": "https://developers.debounce.io/reference",
  "base_url": "https://api.debounce.io/v1",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "api",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "DeBounce → API → copy your Public API key."
      }
    ]
  },
  "actions": [
    {
      "key": "verify",
      "name": "Verify email",
      "description": "Single email validation.",
      "method": "GET",
      "endpoint": "/",
      "query": {
        "email": "{{ inputs.email }}"
      },
      "output_fields": {
        "result": "debounce.result",
        "reason": "debounce.reason",
        "code": "debounce.code",
        "role": "debounce.role",
        "free_email": "debounce.free_email",
        "did_you_mean": "debounce.did_you_mean",
        "balance": "balance"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true,
          "help": "The contact's email address."
        }
      ]
    },
    {
      "key": "balance",
      "name": "Check balance",
      "description": "Remaining credits.",
      "method": "GET",
      "endpoint": "/balance/",
      "output_fields": {
        "balance": "balance"
      },
      "inputs": []
    }
  ]
}
