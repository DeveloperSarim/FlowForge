{
  "key": "upload_post",
  "name": "Upload-Post",
  "category": "Social Media",
  "description": "Post text, photos or videos to TikTok, Instagram, YouTube, X and more via Upload-Post.",
  "website": "https://www.upload-post.com",
  "docs_url": "https://docs.upload-post.com/",
  "base_url": "https://api.upload-post.com/api",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "Authorization",
    "prefix": "Apikey ",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "app.upload-post.com → API Keys → Generate."
      }
    ]
  },
  "actions": [
    {
      "key": "post_text",
      "name": "Post text",
      "method": "POST",
      "endpoint": "/upload_text",
      "body": {
        "user": "{{ inputs.user }}",
        "platform[]": "{{ inputs.platform }}",
        "title": "{{ inputs.title }}",
        "scheduled_date": "{{ inputs.scheduled_date }}",
        "first_comment": "{{ inputs.first_comment }}",
        "link_url": "{{ inputs.link_url }}",
        "facebook_page_id": "{{ inputs.facebook_page_id }}"
      },
      "body_format": "form",
      "output_fields": {
        "success": "success",
        "results": "results",
        "request_id": "request_id",
        "job_id": "job_id"
      },
      "inputs": [
        {
          "key": "user",
          "label": "Profile",
          "type": "string",
          "required": true,
          "help": "The profile name you created in Upload-Post (see 'List profiles')."
        },
        {
          "key": "platform",
          "label": "Platform",
          "type": "select",
          "required": true,
          "default": "linkedin",
          "options": [
            {
              "value": "linkedin",
              "label": "LinkedIn"
            },
            {
              "value": "x",
              "label": "X (Twitter)"
            },
            {
              "value": "facebook",
              "label": "Facebook"
            },
            {
              "value": "threads",
              "label": "Threads"
            },
            {
              "value": "bluesky",
              "label": "Bluesky"
            }
          ]
        },
        {
          "key": "title",
          "label": "Post text",
          "type": "text",
          "required": true
        },
        {
          "key": "scheduled_date",
          "label": "Schedule for",
          "type": "string",
          "placeholder": "2026-12-01T09:00:00Z",
          "help": "Leave blank to post now."
        },
        {
          "key": "first_comment",
          "label": "First comment",
          "type": "string"
        },
        {
          "key": "link_url",
          "label": "Link URL",
          "type": "string"
        },
        {
          "key": "facebook_page_id",
          "label": "Facebook page ID",
          "type": "string",
          "help": "Only for Facebook, if the profile has several pages."
        }
      ]
    },
    {
      "key": "post_photo",
      "name": "Post photo",
      "method": "POST",
      "endpoint": "/upload_photos",
      "body": {
        "user": "{{ inputs.user }}",
        "platform[]": "{{ inputs.platform }}",
        "photos[]": "{{ inputs.photo }}",
        "title": "{{ inputs.title }}",
        "scheduled_date": "{{ inputs.scheduled_date }}"
      },
      "body_format": "form",
      "output_fields": {
        "success": "success",
        "results": "results",
        "request_id": "request_id",
        "job_id": "job_id"
      },
      "inputs": [
        {
          "key": "user",
          "label": "Profile",
          "type": "string",
          "required": true,
          "help": "The profile name you created in Upload-Post (see 'List profiles')."
        },
        {
          "key": "platform",
          "label": "Platform",
          "type": "select",
          "required": true,
          "default": "instagram",
          "options": [
            {
              "value": "instagram",
              "label": "Instagram"
            },
            {
              "value": "facebook",
              "label": "Facebook"
            },
            {
              "value": "tiktok",
              "label": "TikTok"
            },
            {
              "value": "x",
              "label": "X (Twitter)"
            },
            {
              "value": "linkedin",
              "label": "LinkedIn"
            },
            {
              "value": "threads",
              "label": "Threads"
            },
            {
              "value": "pinterest",
              "label": "Pinterest"
            },
            {
              "value": "bluesky",
              "label": "Bluesky"
            }
          ]
        },
        {
          "key": "photo",
          "label": "Photo URL",
          "type": "string",
          "required": true,
          "help": "Public link to the image."
        },
        {
          "key": "title",
          "label": "Caption",
          "type": "text"
        },
        {
          "key": "scheduled_date",
          "label": "Schedule for",
          "type": "string",
          "placeholder": "2026-12-01T09:00:00Z",
          "help": "Leave blank to post now."
        }
      ]
    },
    {
      "key": "post_video",
      "name": "Post video",
      "method": "POST",
      "endpoint": "/upload",
      "body": {
        "user": "{{ inputs.user }}",
        "platform[]": "{{ inputs.platform }}",
        "video": "{{ inputs.video }}",
        "title": "{{ inputs.title }}",
        "scheduled_date": "{{ inputs.scheduled_date }}"
      },
      "body_format": "form",
      "timeout": 180,
      "output_fields": {
        "success": "success",
        "results": "results",
        "request_id": "request_id",
        "job_id": "job_id"
      },
      "inputs": [
        {
          "key": "user",
          "label": "Profile",
          "type": "string",
          "required": true,
          "help": "The profile name you created in Upload-Post (see 'List profiles')."
        },
        {
          "key": "platform",
          "label": "Platform",
          "type": "select",
          "required": true,
          "default": "tiktok",
          "options": [
            {
              "value": "tiktok",
              "label": "TikTok"
            },
            {
              "value": "instagram",
              "label": "Instagram"
            },
            {
              "value": "youtube",
              "label": "YouTube"
            },
            {
              "value": "facebook",
              "label": "Facebook"
            },
            {
              "value": "x",
              "label": "X (Twitter)"
            },
            {
              "value": "linkedin",
              "label": "LinkedIn"
            },
            {
              "value": "threads",
              "label": "Threads"
            },
            {
              "value": "pinterest",
              "label": "Pinterest"
            },
            {
              "value": "bluesky",
              "label": "Bluesky"
            }
          ]
        },
        {
          "key": "video",
          "label": "Video URL",
          "type": "string",
          "required": true,
          "help": "Public link to the video file."
        },
        {
          "key": "title",
          "label": "Title / caption",
          "type": "text",
          "required": true
        },
        {
          "key": "scheduled_date",
          "label": "Schedule for",
          "type": "string",
          "placeholder": "2026-12-01T09:00:00Z",
          "help": "Leave blank to post now."
        }
      ]
    },
    {
      "key": "get_status",
      "name": "Get upload status",
      "method": "GET",
      "endpoint": "/uploadposts/status",
      "query": {
        "request_id": "{{ inputs.request_id }}",
        "job_id": "{{ inputs.job_id }}"
      },
      "inputs": [
        {
          "key": "request_id",
          "label": "Request ID",
          "type": "string",
          "help": "request_id from an upload."
        },
        {
          "key": "job_id",
          "label": "Job ID",
          "type": "string",
          "help": "job_id from a scheduled upload."
        }
      ]
    },
    {
      "key": "list_profiles",
      "name": "List profiles",
      "method": "GET",
      "endpoint": "/uploadposts/users",
      "output_fields": {
        "profiles": "profiles",
        "usernames": "profiles.*.username"
      },
      "inputs": []
    },
    {
      "key": "get_history",
      "name": "Get upload history",
      "method": "GET",
      "endpoint": "/uploadposts/history",
      "query": {
        "limit": "{{ inputs.limit }}"
      },
      "output_fields": {
        "history": "history",
        "latest_url": "history.0.post_url",
        "latest_platform": "history.0.platform"
      },
      "inputs": [
        {
          "key": "limit",
          "label": "Max results",
          "type": "select",
          "default": "20",
          "options": [
            {
              "value": "10",
              "label": "10"
            },
            {
              "value": "20",
              "label": "20"
            },
            {
              "value": "50",
              "label": "50"
            },
            {
              "value": "100",
              "label": "100"
            }
          ]
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Upload event",
      "type": "webhook",
      "description": "Add this URL in Upload-Post → Notifications (e.g. upload_completed).",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
