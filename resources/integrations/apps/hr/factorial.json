{
  "key": "factorial",
  "name": "Factorial",
  "category": "HR & Recruiting",
  "description": "Call the Factorial HR API with an API key or OAuth.",
  "brand": "factorial",
  "website": "https://factorialhr.com",
  "docs_url": "https://apidoc.factorialhr.com/",
  "base_url": "https://api.factorialhr.com/api",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "x-api-key",
      "fields": [
        {
          "key": "api_key",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Settings > API keys."
        }
      ]
    },
    {
      "type": "oauth2",
      "authorize_url": "https://api.factorialhr.com/oauth/authorize",
      "token_url": "https://api.factorialhr.com/oauth/token",
      "scopes": []
    }
  ]
}
