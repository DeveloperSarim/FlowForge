{
  "key": "productboard",
  "name": "Productboard",
  "category": "Project Management",
  "description": "Send customer feedback notes to Productboard.",
  "brand": "productboard",
  "website": "https://www.productboard.com",
  "docs_url": "https://developer.productboard.com/reference",
  "base_url": "https://api.productboard.com",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "Access token",
        "type": "password",
        "required": true,
        "help": "Workspace settings > Integrations > Public API."
      }
    ]
  },
  "actions": [
    {
      "key": "create_note",
      "name": "Create note",
      "description": "Adds a feedback note to the Insights inbox.",
      "method": "POST",
      "endpoint": "/v2/notes",
      "body": {
        "data": {
          "type": "textNote",
          "fields": {
            "name": "{{ inputs.name }}",
            "content": "{{ inputs.content }}"
          },
          "relationships": "{{ inputs.relationships }}"
        }
      },
      "output_path": "data",
      "inputs": [
        {
          "key": "name",
          "label": "Title",
          "type": "string",
          "required": true
        },
        {
          "key": "content",
          "label": "Content",
          "type": "text"
        },
        {
          "key": "relationships",
          "label": "Relationships (JSON)",
          "type": "json",
          "placeholder": "[{ \"type\": \"customer\", \"target\": { \"type\": \"user\", \"email\": \"jane@acme.com\" } }]"
        }
      ]
    },
    {
      "key": "get_note",
      "name": "Get note",
      "method": "GET",
      "endpoint": "/v2/notes/{{ inputs.note_id }}",
      "output_path": "data",
      "inputs": [
        {
          "key": "note_id",
          "label": "Note ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
