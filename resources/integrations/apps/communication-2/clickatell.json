{
  "key": "clickatell",
  "name": "Clickatell",
  "category": "Communication",
  "description": "Send SMS or WhatsApp messages with the Clickatell One API.",
  "brand": "clickatell",
  "website": "https://www.clickatell.com",
  "docs_url": "https://docs.clickatell.com/channels/one-api/one-api-reference/",
  "base_url": "https://platform.clickatell.com",
  "auth": [
    { "type": "api_key", "in": "header", "name": "Authorization", "fields": [{ "key": "api_key", "label": "API key", "type": "password", "required": true, "help": "Portal → Channels → your integration → API key." }] }
  ],
  "actions": [
    {
      "key": "send_message",
      "name": "Send message",
      "method": "POST",
      "endpoint": "/v1/message",
      "body": {
        "messages": [{
          "channel": "{{ inputs.channel }}",
          "to": "{{ inputs.to }}",
          "content": "{{ inputs.content }}",
          "from": "{{ inputs.from }}"
        }]
      },
      "inputs": [
        { "key": "channel", "label": "Channel", "type": "select", "default": "sms", "options": [
          { "value": "sms", "label": "SMS" }, { "value": "whatsapp", "label": "WhatsApp" }
        ] },
        { "key": "to", "label": "To (international, no +)", "type": "string", "required": true, "placeholder": "27999000001" },
        { "key": "content", "label": "Message", "type": "text", "required": true },
        { "key": "from", "label": "From", "type": "string", "help": "Your two-way number or sender ID, if configured." }
      ]
    }
  ]
}
