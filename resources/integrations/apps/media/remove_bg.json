{
  "key": "remove_bg",
  "name": "remove.bg",
  "category": "Video & Media",
  "description": "Remove the background from an image URL and get the result as base64.",
  "brand": "removebg",
  "website": "https://www.remove.bg",
  "docs_url": "https://www.remove.bg/api",
  "popular": true,
  "base_url": "https://api.remove.bg/v1.0",
  "auth": { "type": "api_key", "in": "header", "name": "X-Api-Key" },
  "actions": [
    {
      "key": "remove_background",
      "name": "Remove background",
      "description": "Returns data.result_b64 (base64 image) plus foreground position.",
      "method": "POST",
      "endpoint": "/removebg",
      "headers": { "Accept": "application/json" },
      "output_path": "data",
      "timeout": 90,
      "body": {
        "image_url": "{{ inputs.image_url }}", "size": "{{ inputs.size }}", "type": "{{ inputs.type }}", "format": "{{ inputs.format }}",
        "bg_color": "{{ inputs.bg_color }}", "bg_image_url": "{{ inputs.bg_image_url }}", "crop": "{{ inputs.crop }}"
      },
      "inputs": [
        { "key": "image_url", "label": "Image URL", "type": "string", "required": true },
        { "key": "size", "label": "Size", "type": "select", "default": "auto", "options": [
          { "value": "auto", "label": "Auto (highest available)" }, { "value": "preview", "label": "Preview (0.25 MP)" }, { "value": "full", "label": "Full" }, { "value": "50MP", "label": "50 MP" }
        ] },
        { "key": "type", "label": "Foreground type", "type": "select", "options": [
          { "value": "", "label": "Auto-detect" }, { "value": "person", "label": "Person" }, { "value": "product", "label": "Product" }, { "value": "car", "label": "Car" },
          { "value": "animal", "label": "Animal" }, { "value": "graphic", "label": "Graphic" }, { "value": "transportation", "label": "Transportation" }
        ] },
        { "key": "format", "label": "Format", "type": "select", "default": "png", "options": [
          { "value": "png", "label": "PNG" }, { "value": "jpg", "label": "JPG" }, { "value": "webp", "label": "WebP" }, { "value": "auto", "label": "Auto" }
        ] },
        { "key": "bg_color", "label": "Background colour", "type": "string", "placeholder": "ffffff" },
        { "key": "bg_image_url", "label": "Background image URL", "type": "string" },
        { "key": "crop", "label": "Crop empty regions", "type": "boolean" }
      ]
    },
    {
      "key": "get_account",
      "name": "Get account credits",
      "method": "GET",
      "endpoint": "/account",
      "output_path": "data",
      "inputs": []
    }
  ]
}
