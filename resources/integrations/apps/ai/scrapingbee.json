{
  "key": "scrapingbee",
  "name": "ScrapingBee",
  "category": "AI",
  "description": "Scrape any web page with headless browsers and rotating proxies.",
  "brand": "scrapingbee",
  "website": "https://www.scrapingbee.com",
  "docs_url": "https://www.scrapingbee.com/documentation/",
  "base_url": "https://app.scrapingbee.com/api/v1",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "api_key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "scrape",
      "name": "Scrape URL",
      "method": "GET",
      "endpoint": "/",
      "timeout": 120,
      "query": {
        "url": "{{ inputs.url }}",
        "render_js": "{{ inputs.render_js }}",
        "premium_proxy": "{{ inputs.premium_proxy }}",
        "country_code": "{{ inputs.country_code }}"
      },
      "inputs": [
        {
          "key": "url",
          "label": "URL",
          "type": "string",
          "required": true
        },
        {
          "key": "render_js",
          "label": "Render JavaScript",
          "type": "select",
          "options": [
            {
              "value": "true",
              "label": "Yes"
            },
            {
              "value": "false",
              "label": "No"
            }
          ],
          "default": "true"
        },
        {
          "key": "premium_proxy",
          "label": "Premium proxy",
          "type": "select",
          "options": [
            {
              "value": "false",
              "label": "No"
            },
            {
              "value": "true",
              "label": "Yes"
            }
          ]
        },
        {
          "key": "country_code",
          "label": "Country code",
          "type": "string",
          "placeholder": "us",
          "help": "Requires premium proxy."
        }
      ]
    },
    {
      "key": "get_usage",
      "name": "Get usage",
      "method": "GET",
      "endpoint": "/usage",
      "inputs": []
    }
  ]
}
