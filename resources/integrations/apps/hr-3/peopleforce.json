{
  "key": "peopleforce",
  "name": "PeopleForce",
  "category": "HR & Recruiting",
  "description": "Read employees, leave requests, vacancies and candidates from PeopleForce HR.",
  "website": "https://peopleforce.io",
  "docs_url": "https://developer.peopleforce.io/",
  "base_url": "https://app.peopleforce.io/api/public/v1",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "X-API-KEY",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "In PeopleForce open Settings → API (account owner or admin) → Generate new key."
      }
    ]
  },
  "actions": [
    {
      "key": "list_employees",
      "name": "List employees",
      "description": "List employees.",
      "method": "GET",
      "endpoint": "/employees",
      "query": {
        "page": "{{ inputs.page }}"
      },
      "output_fields": {
        "employees": "data",
        "first_id": "data.0.id",
        "first_name": "data.0.first_name",
        "first_email": "data.0.email"
      },
      "inputs": [
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "default": 1
        }
      ]
    },
    {
      "key": "get_employee",
      "name": "Get employee",
      "description": "Read one employee.",
      "method": "GET",
      "endpoint": "/employees/{{ inputs.employee_id }}",
      "output_fields": {
        "first_name": "data.first_name",
        "last_name": "data.last_name",
        "email": "data.email",
        "position": "data.position.name"
      },
      "inputs": [
        {
          "key": "employee_id",
          "label": "Employee ID",
          "type": "number",
          "required": true
        }
      ]
    },
    {
      "key": "list_leave_requests",
      "name": "List leave requests",
      "description": "List time-off requests.",
      "method": "GET",
      "endpoint": "/leave_requests",
      "query": {
        "page": "{{ inputs.page }}"
      },
      "output_fields": {
        "requests": "data",
        "first_id": "data.0.id",
        "first_status": "data.0.state"
      },
      "inputs": [
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "default": 1
        }
      ]
    },
    {
      "key": "list_vacancies",
      "name": "List vacancies",
      "description": "List open jobs in recruitment.",
      "method": "GET",
      "endpoint": "/recruitment/vacancies",
      "query": {
        "page": "{{ inputs.page }}"
      },
      "output_fields": {
        "vacancies": "data",
        "first_id": "data.0.id",
        "first_title": "data.0.title"
      },
      "inputs": [
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "default": 1
        }
      ]
    },
    {
      "key": "list_candidates",
      "name": "List candidates",
      "description": "List recruitment candidates.",
      "method": "GET",
      "endpoint": "/recruitment/candidates",
      "query": {
        "page": "{{ inputs.page }}"
      },
      "output_fields": {
        "candidates": "data",
        "first_id": "data.0.id",
        "first_name": "data.0.full_name"
      },
      "inputs": [
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "default": 1
        }
      ]
    }
  ]
}
