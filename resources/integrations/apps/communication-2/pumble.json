{
  "key": "pumble",
  "name": "Pumble",
  "category": "Communication",
  "description": "Post messages to a Pumble channel through an incoming webhook.",
  "brand": "pumble",
  "website": "https://pumble.com",
  "docs_url": "https://pumble.com/help/integrations/add-pumble-apps/incoming-webhooks-for-pumble/",
  "actions": [
    {
      "key": "send_message",
      "name": "Send webhook message",
      "method": "POST",
      "endpoint": "{{ inputs.webhook_url }}",
      "body": { "text": "{{ inputs.text }}" },
      "inputs": [
        { "key": "webhook_url", "label": "Incoming webhook URL", "type": "password", "required": true, "help": "Pumble → Integrations → Incoming Webhooks → add one for the channel and copy its URL." },
        { "key": "text", "label": "Message", "type": "text", "required": true, "help": "Supports Pumble Markdown." }
      ]
    }
  ]
}
