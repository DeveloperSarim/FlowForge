{
  "key": "scaleway",
  "name": "Scaleway",
  "category": "Developer Tools",
  "description": "List, start, stop and reboot Scaleway instances and read DNS records.",
  "brand": "scaleway",
  "website": "https://www.scaleway.com",
  "docs_url": "https://www.scaleway.com/en/developers/api/",
  "base_url": "https://api.scaleway.com",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "X-Auth-Token",
    "fields": [
      {
        "key": "api_key",
        "label": "Secret key",
        "type": "password",
        "required": true,
        "help": "Scaleway console → IAM → API keys → Generate API key; copy the Secret key."
      }
    ]
  },
  "actions": [
    {
      "key": "list_servers",
      "name": "List instances",
      "description": "List the instances in a zone.",
      "method": "GET",
      "endpoint": "/instance/v1/zones/{{ inputs.zone }}/servers",
      "query": {
        "name": "{{ inputs.name }}"
      },
      "output_fields": {
        "servers": "servers"
      },
      "inputs": [
        {
          "key": "zone",
          "label": "Zone",
          "type": "select",
          "required": true,
          "default": "fr-par-1",
          "options": [
            {
              "value": "fr-par-1",
              "label": "Paris 1"
            },
            {
              "value": "fr-par-2",
              "label": "Paris 2"
            },
            {
              "value": "fr-par-3",
              "label": "Paris 3"
            },
            {
              "value": "nl-ams-1",
              "label": "Amsterdam 1"
            },
            {
              "value": "nl-ams-2",
              "label": "Amsterdam 2"
            },
            {
              "value": "nl-ams-3",
              "label": "Amsterdam 3"
            },
            {
              "value": "pl-waw-1",
              "label": "Warsaw 1"
            },
            {
              "value": "pl-waw-2",
              "label": "Warsaw 2"
            },
            {
              "value": "pl-waw-3",
              "label": "Warsaw 3"
            }
          ]
        },
        {
          "key": "name",
          "label": "Name filter",
          "type": "string"
        }
      ]
    },
    {
      "key": "get_server",
      "name": "Get instance",
      "description": "Get an instance's state and IP address.",
      "method": "GET",
      "endpoint": "/instance/v1/zones/{{ inputs.zone }}/servers/{{ inputs.server_id }}",
      "output_fields": {
        "name": "server.name",
        "state": "server.state",
        "public_ip": "server.public_ips.0.address"
      },
      "inputs": [
        {
          "key": "zone",
          "label": "Zone",
          "type": "select",
          "required": true,
          "default": "fr-par-1",
          "options": [
            {
              "value": "fr-par-1",
              "label": "Paris 1"
            },
            {
              "value": "fr-par-2",
              "label": "Paris 2"
            },
            {
              "value": "fr-par-3",
              "label": "Paris 3"
            },
            {
              "value": "nl-ams-1",
              "label": "Amsterdam 1"
            },
            {
              "value": "nl-ams-2",
              "label": "Amsterdam 2"
            },
            {
              "value": "nl-ams-3",
              "label": "Amsterdam 3"
            },
            {
              "value": "pl-waw-1",
              "label": "Warsaw 1"
            },
            {
              "value": "pl-waw-2",
              "label": "Warsaw 2"
            },
            {
              "value": "pl-waw-3",
              "label": "Warsaw 3"
            }
          ]
        },
        {
          "key": "server_id",
          "label": "Instance ID",
          "type": "string",
          "required": true,
          "help": "Use List instances."
        }
      ]
    },
    {
      "key": "server_action",
      "name": "Power on / off / reboot",
      "description": "Power on, power off or reboot an instance.",
      "method": "POST",
      "endpoint": "/instance/v1/zones/{{ inputs.zone }}/servers/{{ inputs.server_id }}/action",
      "body": {
        "action": "{{ inputs.action }}"
      },
      "output_fields": {
        "task_id": "task.id",
        "status": "task.status"
      },
      "inputs": [
        {
          "key": "zone",
          "label": "Zone",
          "type": "select",
          "required": true,
          "default": "fr-par-1",
          "options": [
            {
              "value": "fr-par-1",
              "label": "Paris 1"
            },
            {
              "value": "fr-par-2",
              "label": "Paris 2"
            },
            {
              "value": "fr-par-3",
              "label": "Paris 3"
            },
            {
              "value": "nl-ams-1",
              "label": "Amsterdam 1"
            },
            {
              "value": "nl-ams-2",
              "label": "Amsterdam 2"
            },
            {
              "value": "nl-ams-3",
              "label": "Amsterdam 3"
            },
            {
              "value": "pl-waw-1",
              "label": "Warsaw 1"
            },
            {
              "value": "pl-waw-2",
              "label": "Warsaw 2"
            },
            {
              "value": "pl-waw-3",
              "label": "Warsaw 3"
            }
          ]
        },
        {
          "key": "server_id",
          "label": "Instance ID",
          "type": "string",
          "required": true,
          "help": "Use List instances."
        },
        {
          "key": "action",
          "label": "Action",
          "type": "select",
          "required": true,
          "default": "reboot",
          "options": [
            {
              "value": "poweron",
              "label": "Power on"
            },
            {
              "value": "poweroff",
              "label": "Power off"
            },
            {
              "value": "reboot",
              "label": "Reboot"
            },
            {
              "value": "stop_in_place",
              "label": "Stop in place"
            }
          ]
        }
      ]
    },
    {
      "key": "list_ips",
      "name": "List flexible IPs",
      "description": "List flexible IP addresses in a zone.",
      "method": "GET",
      "endpoint": "/instance/v1/zones/{{ inputs.zone }}/ips",
      "output_fields": {
        "ips": "ips"
      },
      "inputs": [
        {
          "key": "zone",
          "label": "Zone",
          "type": "select",
          "required": true,
          "default": "fr-par-1",
          "options": [
            {
              "value": "fr-par-1",
              "label": "Paris 1"
            },
            {
              "value": "fr-par-2",
              "label": "Paris 2"
            },
            {
              "value": "fr-par-3",
              "label": "Paris 3"
            },
            {
              "value": "nl-ams-1",
              "label": "Amsterdam 1"
            },
            {
              "value": "nl-ams-2",
              "label": "Amsterdam 2"
            },
            {
              "value": "nl-ams-3",
              "label": "Amsterdam 3"
            },
            {
              "value": "pl-waw-1",
              "label": "Warsaw 1"
            },
            {
              "value": "pl-waw-2",
              "label": "Warsaw 2"
            },
            {
              "value": "pl-waw-3",
              "label": "Warsaw 3"
            }
          ]
        }
      ]
    },
    {
      "key": "list_dns_records",
      "name": "List DNS records",
      "description": "List the records of a DNS zone hosted at Scaleway.",
      "method": "GET",
      "endpoint": "/domain/v2beta1/dns-zones/{{ inputs.dns_zone }}/records",
      "output_fields": {
        "records": "records"
      },
      "inputs": [
        {
          "key": "dns_zone",
          "label": "DNS zone",
          "type": "string",
          "required": true,
          "placeholder": "example.com"
        }
      ]
    }
  ]
}
