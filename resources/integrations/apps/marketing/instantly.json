{
  "key": "instantly",
  "name": "Instantly",
  "category": "Marketing & Email",
  "description": "Add leads to cold email campaigns and list campaigns (API v2).",
  "brand": "instantly",
  "website": "https://instantly.ai",
  "docs_url": "https://developer.instantly.ai/",
  "base_url": "https://api.instantly.ai/api/v2",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key (v2)",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "add_lead",
      "name": "Add lead",
      "method": "POST",
      "endpoint": "/leads",
      "body": {
        "campaign": "{{ inputs.campaign_id }}",
        "email": "{{ inputs.email }}",
        "first_name": "{{ inputs.first_name }}",
        "last_name": "{{ inputs.last_name }}",
        "company_name": "{{ inputs.company_name }}",
        "personalization": "{{ inputs.personalization }}",
        "custom_variables": "{{ inputs.custom_variables }}"
      },
      "inputs": [
        {
          "key": "campaign_id",
          "label": "Campaign ID",
          "type": "string",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "first_name",
          "label": "First name",
          "type": "string"
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "company_name",
          "label": "Company",
          "type": "string"
        },
        {
          "key": "personalization",
          "label": "Personalization",
          "type": "text"
        },
        {
          "key": "custom_variables",
          "label": "Custom variables",
          "type": "keyvalue"
        }
      ]
    },
    {
      "key": "list_campaigns",
      "name": "List campaigns",
      "method": "GET",
      "endpoint": "/campaigns",
      "query": {
        "limit": 100
      },
      "output_path": "items",
      "inputs": []
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "Settings → Integrations → Webhooks (reply_received, email_opened…).",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
