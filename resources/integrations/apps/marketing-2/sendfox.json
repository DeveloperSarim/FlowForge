{
  "key": "sendfox",
  "name": "SendFox",
  "category": "Marketing & Email",
  "description": "Add contacts to SendFox lists, find contacts and unsubscribe them.",
  "brand": "sendfox",
  "website": "https://sendfox.com",
  "docs_url": "https://help.sendfox.com/article/278-endpoints",
  "base_url": "https://api.sendfox.com",
  "auth": { "type": "bearer", "fields": [{ "key": "token", "label": "Personal access token", "type": "password", "required": true, "help": "Account > API > Personal access tokens." }] },
  "actions": [
    {
      "key": "create_contact",
      "name": "Add contact",
      "method": "POST",
      "endpoint": "/contacts",
      "body": { "email": "{{ inputs.email }}", "first_name": "{{ inputs.first_name }}", "last_name": "{{ inputs.last_name }}", "lists": "{{ inputs.lists }}" },
      "inputs": [
        { "key": "email", "label": "Email", "type": "string", "required": true },
        { "key": "first_name", "label": "First name", "type": "string" },
        { "key": "last_name", "label": "Last name", "type": "string" },
        { "key": "lists", "label": "List IDs", "type": "list" }
      ]
    },
    {
      "key": "find_contact",
      "name": "Find contact by email",
      "method": "GET",
      "endpoint": "/contacts",
      "query": { "email": "{{ inputs.email }}" },
      "output_path": "data",
      "inputs": [{ "key": "email", "label": "Email", "type": "string", "required": true }]
    },
    {
      "key": "unsubscribe",
      "name": "Unsubscribe contact",
      "method": "PATCH",
      "endpoint": "/unsubscribe",
      "body": { "email": "{{ inputs.email }}" },
      "inputs": [{ "key": "email", "label": "Email", "type": "string", "required": true }]
    },
    {
      "key": "list_lists",
      "name": "List lists",
      "method": "GET",
      "endpoint": "/lists",
      "output_path": "data",
      "inputs": []
    }
  ]
}
