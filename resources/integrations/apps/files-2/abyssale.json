{
  "key": "abyssale",
  "name": "Abyssale",
  "category": "Files & Documents",
  "description": "Generate marketing images and banners from Abyssale designs.",
  "brand": "abyssale",
  "website": "https://www.abyssale.com",
  "docs_url": "https://developers.abyssale.com/",
  "base_url": "https://api.abyssale.com",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "x-api-key"
    }
  ],
  "actions": [
    {
      "key": "generate_image",
      "name": "Generate image",
      "method": "POST",
      "endpoint": "/banner-builder/{{ inputs.design_id }}/generate",
      "body": {
        "template_format_name": "{{ inputs.template_format_name }}",
        "elements": "{{ inputs.elements }}"
      },
      "timeout": 120,
      "inputs": [
        {
          "key": "design_id",
          "label": "Design ID",
          "type": "string",
          "required": true
        },
        {
          "key": "template_format_name",
          "label": "Format name",
          "type": "string",
          "placeholder": "facebook-post"
        },
        {
          "key": "elements",
          "label": "Elements",
          "type": "json",
          "required": true,
          "placeholder": "{\"title\": {\"payload\": \"Summer sale\"}}"
        }
      ]
    },
    {
      "key": "generate_async",
      "name": "Generate formats (async)",
      "method": "POST",
      "endpoint": "/async/banner-builder/{{ inputs.design_id }}/generate",
      "body": {
        "template_format_names": "{{ inputs.template_format_names }}",
        "elements": "{{ inputs.elements }}",
        "callback_url": "{{ inputs.callback_url }}"
      },
      "inputs": [
        {
          "key": "design_id",
          "label": "Design ID",
          "type": "string",
          "required": true
        },
        {
          "key": "template_format_names",
          "label": "Format names",
          "type": "list"
        },
        {
          "key": "elements",
          "label": "Elements",
          "type": "json",
          "required": true
        },
        {
          "key": "callback_url",
          "label": "Callback URL",
          "type": "string"
        }
      ]
    },
    {
      "key": "list_designs",
      "name": "List designs",
      "method": "GET",
      "endpoint": "/designs",
      "inputs": []
    },
    {
      "key": "get_design",
      "name": "Get design",
      "method": "GET",
      "endpoint": "/designs/{{ inputs.design_id }}",
      "inputs": [
        {
          "key": "design_id",
          "label": "Design ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "get_banner",
      "name": "Get generated file",
      "method": "GET",
      "endpoint": "/banners/{{ inputs.banner_id }}",
      "inputs": [
        {
          "key": "banner_id",
          "label": "Banner ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Generation completed",
      "type": "webhook",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
