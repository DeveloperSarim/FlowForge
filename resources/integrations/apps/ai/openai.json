{
  "key": "openai",
  "name": "OpenAI",
  "category": "AI",
  "description": "Chat with GPT models, create embeddings and images, moderate text.",
  "brand": "openai",
  "website": "https://openai.com",
  "docs_url": "https://platform.openai.com/docs/api-reference",
  "popular": true,
  "base_url": "https://api.openai.com/v1",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true,
        "placeholder": "sk-..."
      }
    ]
  },
  "actions": [
    {
      "key": "chat_completion",
      "name": "Chat completion",
      "description": "Send a prompt and get the reply as {{ steps.<id>.text }}.",
      "method": "POST",
      "endpoint": "/chat/completions",
      "timeout": 300,
      "body": {
        "model": "{{ inputs.model }}",
        "messages": [
          {
            "role": "system",
            "content": "{{ inputs.system }}"
          },
          {
            "role": "user",
            "content": "{{ inputs.prompt }}"
          }
        ],
        "temperature": "{{ inputs.temperature }}",
        "max_completion_tokens": "{{ inputs.max_tokens }}"
      },
      "output_fields": {
        "text": "choices.0.message.content"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "default": "gpt-5-mini",
          "help": "Reasoning models (gpt-5, o-series) ignore or reject temperature; leave it blank."
        },
        {
          "key": "prompt",
          "label": "Prompt",
          "type": "text",
          "required": true
        },
        {
          "key": "system",
          "label": "System prompt",
          "type": "text",
          "required": true,
          "default": "You are a helpful assistant.",
          "help": "Sent as the system message."
        },
        {
          "key": "temperature",
          "label": "Temperature",
          "type": "number",
          "placeholder": "0.7"
        },
        {
          "key": "max_tokens",
          "label": "Max output tokens",
          "type": "number"
        }
      ]
    },
    {
      "key": "create_embedding",
      "name": "Create embedding",
      "description": "Turn text into a vector, available as {{ steps.<id>.embedding }}.",
      "method": "POST",
      "endpoint": "/embeddings",
      "body": {
        "model": "{{ inputs.model }}",
        "input": "{{ inputs.input }}"
      },
      "output_fields": {
        "embedding": "data.0.embedding"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "default": "text-embedding-3-small"
        },
        {
          "key": "input",
          "label": "Text",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "key": "generate_image",
      "name": "Generate image",
      "method": "POST",
      "endpoint": "/images/generations",
      "timeout": 300,
      "body": {
        "model": "{{ inputs.model }}",
        "prompt": "{{ inputs.prompt }}",
        "size": "{{ inputs.size }}",
        "quality": "{{ inputs.quality }}",
        "n": "{{ inputs.n }}"
      },
      "output_fields": {
        "b64_json": "data.0.b64_json",
        "url": "data.0.url"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "default": "gpt-image-1"
        },
        {
          "key": "prompt",
          "label": "Prompt",
          "type": "text",
          "required": true
        },
        {
          "key": "size",
          "label": "Size",
          "type": "string",
          "placeholder": "1024x1024",
          "help": "gpt-image-1: 1024x1024, 1536x1024, 1024x1536 or auto."
        },
        {
          "key": "quality",
          "label": "Quality",
          "type": "string",
          "placeholder": "auto",
          "help": "gpt-image-1: low, medium, high, auto. dall-e-3: standard, hd."
        },
        {
          "key": "n",
          "label": "Number of images",
          "type": "number"
        }
      ]
    },
    {
      "key": "moderate",
      "name": "Moderate text",
      "description": "Check text against OpenAI's usage policies.",
      "method": "POST",
      "endpoint": "/moderations",
      "body": {
        "model": "{{ inputs.model }}",
        "input": "{{ inputs.input }}"
      },
      "output_fields": {
        "flagged": "results.0.flagged"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "default": "omni-moderation-latest"
        },
        {
          "key": "input",
          "label": "Text",
          "type": "text",
          "required": true
        }
      ]
    }
  ]
}
