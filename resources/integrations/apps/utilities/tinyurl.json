{
  "key": "tinyurl",
  "name": "TinyURL",
  "category": "Utilities",
  "description": "Shorten URLs with optional custom aliases and tags.",
  "brand": "tinyurl",
  "website": "https://tinyurl.com",
  "docs_url": "https://tinyurl.com/app/dev",
  "base_url": "https://api.tinyurl.com",
  "auth": { "type": "bearer", "fields": [
    { "key": "token", "label": "API token", "type": "password", "required": true, "help": "tinyurl.com/app/settings/api" }
  ] },
  "actions": [
    {
      "key": "create_link",
      "name": "Shorten URL",
      "method": "POST",
      "endpoint": "/create",
      "body": { "url": "{{ inputs.url }}", "domain": "{{ inputs.domain }}", "alias": "{{ inputs.alias }}", "tags": "{{ inputs.tags }}", "expires_at": "{{ inputs.expires_at }}", "description": "{{ inputs.description }}" },
      "output_path": "data",
      "inputs": [
        { "key": "url", "label": "Long URL", "type": "string", "required": true },
        { "key": "alias", "label": "Custom alias", "type": "string" },
        { "key": "domain", "label": "Domain", "type": "string", "placeholder": "tinyurl.com" },
        { "key": "tags", "label": "Tags", "type": "list" },
        { "key": "expires_at", "label": "Expires at", "type": "string", "placeholder": "2026-12-31 23:59:59" },
        { "key": "description", "label": "Description", "type": "string" }
      ]
    },
    {
      "key": "get_link",
      "name": "Get link",
      "method": "GET",
      "endpoint": "/alias/{{ inputs.domain }}/{{ inputs.alias }}",
      "output_path": "data",
      "inputs": [
        { "key": "domain", "label": "Domain", "type": "string", "required": true, "default": "tinyurl.com" },
        { "key": "alias", "label": "Alias", "type": "string", "required": true }
      ]
    }
  ]
}
