{
  "key": "keywords_everywhere",
  "name": "Keywords Everywhere",
  "category": "Ads & SEO",
  "description": "Search volume, CPC and competition for keywords.",
  "brand": "keywordseverywhere",
  "website": "https://keywordseverywhere.com",
  "docs_url": "https://api.keywordseverywhere.com/docs/",
  "base_url": "https://api.keywordseverywhere.com/v1",
  "auth": { "type": "bearer", "fields": [{ "key": "token", "label": "API key", "type": "password", "required": true }] },
  "actions": [
    {
      "key": "get_keyword_data",
      "name": "Get keyword data",
      "method": "POST",
      "endpoint": "/get_keyword_data",
      "body_format": "form",
      "body": { "kw": "{{ inputs.keywords }}", "country": "{{ inputs.country }}", "currency": "{{ inputs.currency }}", "dataSource": "{{ inputs.data_source }}" },
      "output_path": "data",
      "inputs": [
        { "key": "keywords", "label": "Keywords (max 100)", "type": "list", "required": true },
        { "key": "country", "label": "Country code", "type": "string", "placeholder": "us", "help": "Empty = global." },
        { "key": "currency", "label": "Currency", "type": "string", "default": "USD" },
        { "key": "data_source", "label": "Data source", "type": "select", "default": "gkp", "options": [
          { "value": "gkp", "label": "Google Keyword Planner" }, { "value": "cli", "label": "Clickstream" }
        ] }
      ]
    },
    {
      "key": "get_credits",
      "name": "Get credit balance",
      "method": "GET",
      "endpoint": "/account/credits",
      "inputs": []
    }
  ]
}
