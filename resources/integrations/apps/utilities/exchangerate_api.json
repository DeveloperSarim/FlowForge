{
  "key": "exchangerate_api",
  "name": "ExchangeRate-API",
  "category": "Utilities",
  "description": "Latest currency exchange rates and currency pair conversions.",
  "brand": "exchangerate-api",
  "website": "https://www.exchangerate-api.com",
  "docs_url": "https://www.exchangerate-api.com/docs/overview",
  "base_url": "https://v6.exchangerate-api.com/v6/{{ credentials.api_key }}",
  "auth": { "type": "api_key", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "latest_rates",
      "name": "Get latest rates",
      "method": "GET",
      "endpoint": "/latest/{{ inputs.base }}",
      "error_path": "error-type",
      "inputs": [{ "key": "base", "label": "Base currency", "type": "string", "required": true, "default": "USD" }]
    },
    {
      "key": "convert",
      "name": "Convert currency",
      "description": "Rate between two currencies and the converted amount.",
      "method": "GET",
      "endpoint": "/pair/{{ inputs.from }}/{{ inputs.to }}/{{ inputs.amount }}",
      "error_path": "error-type",
      "inputs": [
        { "key": "from", "label": "From currency", "type": "string", "required": true, "placeholder": "USD" },
        { "key": "to", "label": "To currency", "type": "string", "required": true, "placeholder": "EUR" },
        { "key": "amount", "label": "Amount", "type": "number", "required": true, "default": 1 }
      ]
    },
    {
      "key": "supported_codes",
      "name": "List supported currencies",
      "method": "GET",
      "endpoint": "/codes",
      "error_path": "error-type",
      "output_path": "supported_codes",
      "inputs": []
    }
  ]
}
