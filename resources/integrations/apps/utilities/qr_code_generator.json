{
  "key": "qr_code_generator",
  "name": "QR Code Generator (goQR.me)",
  "category": "Utilities",
  "description": "Create QR codes as SVG and decode QR codes from image URLs. No key needed.",
  "brand": "goqr",
  "website": "https://goqr.me/api/",
  "docs_url": "https://goqr.me/api/doc/",
  "base_url": "https://api.qrserver.com/v1",
  "actions": [
    {
      "key": "create_qr_code",
      "name": "Create QR code (SVG)",
      "description": "Returns the QR code as SVG markup.",
      "method": "GET",
      "endpoint": "/create-qr-code/",
      "query": { "data": "{{ inputs.data }}", "size": "{{ inputs.size }}", "format": "svg", "color": "{{ inputs.color }}", "bgcolor": "{{ inputs.bgcolor }}", "ecc": "{{ inputs.ecc }}", "margin": "{{ inputs.margin }}" },
      "inputs": [
        { "key": "data", "label": "Content", "type": "string", "required": true, "placeholder": "https://example.com" },
        { "key": "size", "label": "Size", "type": "string", "default": "300x300" },
        { "key": "color", "label": "Color (hex, no #)", "type": "string", "placeholder": "000000" },
        { "key": "bgcolor", "label": "Background (hex, no #)", "type": "string", "placeholder": "ffffff" },
        { "key": "ecc", "label": "Error correction", "type": "select", "default": "L", "options": [
          { "value": "L", "label": "Low (7%)" }, { "value": "M", "label": "Medium (15%)" }, { "value": "Q", "label": "Quartile (25%)" }, { "value": "H", "label": "High (30%)" }
        ] },
        { "key": "margin", "label": "Margin (px)", "type": "number" }
      ]
    },
    {
      "key": "read_qr_code",
      "name": "Read QR code",
      "description": "Decodes a QR code from an image URL.",
      "method": "GET",
      "endpoint": "/read-qr-code/",
      "query": { "fileurl": "{{ inputs.fileurl }}" },
      "inputs": [{ "key": "fileurl", "label": "Image URL", "type": "string", "required": true }]
    }
  ]
}
