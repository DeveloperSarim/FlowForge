{
  "key": "simple_analytics",
  "name": "Simple Analytics",
  "category": "Analytics",
  "description": "Fetch pageviews, visitors, top pages and histograms for a website.",
  "brand": "simpleanalytics",
  "website": "https://www.simpleanalytics.com",
  "docs_url": "https://docs.simpleanalytics.com/api/stats",
  "base_url": "https://simpleanalytics.com",
  "headers": { "User-Id": "{{ credentials.user_id }}" },
  "auth": { "type": "api_key", "in": "header", "name": "Api-Key", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true, "help": "Account settings > API keys (sa_api_key_…)." },
    { "key": "user_id", "label": "User ID", "type": "string", "help": "Only needed for admin endpoints; shown next to your API key." }
  ] },
  "actions": [
    {
      "key": "get_stats",
      "name": "Get stats",
      "method": "GET",
      "endpoint": "/{{ inputs.hostname }}.json",
      "query": { "version": "6", "fields": "{{ inputs.fields }}", "start": "{{ inputs.start }}", "end": "{{ inputs.end }}", "timezone": "{{ inputs.timezone }}", "limit": "{{ inputs.limit }}" },
      "inputs": [
        { "key": "hostname", "label": "Website hostname", "type": "string", "required": true, "placeholder": "example.com" },
        { "key": "fields", "label": "Fields", "type": "string", "required": true, "default": "pageviews,visitors", "help": "pageviews, visitors, histogram, pages, referrers, countries, seconds_on_page …" },
        { "key": "start", "label": "Start (YYYY-MM-DD)", "type": "string" },
        { "key": "end", "label": "End (YYYY-MM-DD)", "type": "string" },
        { "key": "timezone", "label": "Time zone", "type": "string", "placeholder": "Europe/Amsterdam" },
        { "key": "limit", "label": "Limit (1-1000)", "type": "number" }
      ]
    }
  ]
}
