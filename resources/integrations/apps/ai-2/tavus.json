{
  "key": "tavus",
  "name": "Tavus",
  "category": "AI",
  "description": "Create AI avatar videos from your Tavus replicas.",
  "brand": "tavus",
  "website": "https://www.tavus.io",
  "docs_url": "https://docs.tavus.io/api-reference",
  "base_url": "https://tavusapi.com/v2",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "x-api-key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "create_video",
      "name": "Create video",
      "method": "POST",
      "endpoint": "/videos",
      "body": {
        "replica_id": "{{ inputs.replica_id }}",
        "script": "{{ inputs.script }}",
        "audio_url": "{{ inputs.audio_url }}",
        "video_name": "{{ inputs.video_name }}",
        "background_url": "{{ inputs.background_url }}",
        "callback_url": "{{ inputs.callback_url }}"
      },
      "inputs": [
        {
          "key": "replica_id",
          "label": "Replica ID",
          "type": "string",
          "required": true
        },
        {
          "key": "script",
          "label": "Script",
          "type": "text",
          "help": "Text to speak. Use this or Audio URL."
        },
        {
          "key": "audio_url",
          "label": "Audio URL",
          "type": "string",
          "help": "Public .wav or .mp3 to lip-sync instead of a script."
        },
        {
          "key": "video_name",
          "label": "Video name",
          "type": "string"
        },
        {
          "key": "background_url",
          "label": "Background website URL",
          "type": "string"
        },
        {
          "key": "callback_url",
          "label": "Callback URL",
          "type": "string",
          "help": "Tavus posts here when the video is ready."
        }
      ]
    },
    {
      "key": "get_video",
      "name": "Get video",
      "method": "GET",
      "endpoint": "/videos/{{ inputs.video_id }}",
      "inputs": [
        {
          "key": "video_id",
          "label": "Video ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_replicas",
      "name": "List replicas",
      "method": "GET",
      "endpoint": "/faces",
      "inputs": []
    }
  ]
}
