{
  "key": "shipcloud",
  "name": "shipcloud",
  "category": "E-commerce",
  "description": "German multi-carrier shipping: labels, quotes, shipments and tracking.",
  "website": "https://www.shipcloud.io",
  "docs_url": "https://developers.shipcloud.io/reference/",
  "base_url": "https://api.shipcloud.io/v1",
  "auth": {
    "type": "basic",
    "fields": [
      {
        "key": "username",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "shipcloud → Account → API key (sandbox key for tests, live key for real labels)."
      },
      {
        "key": "password",
        "label": "Password",
        "type": "password",
        "required": false,
        "default": "",
        "help": "Leave blank."
      }
    ]
  },
  "actions": [
    {
      "key": "create_shipment",
      "name": "Create shipment (label)",
      "description": "Create a shipment and get the label and tracking link.",
      "method": "POST",
      "endpoint": "/shipments",
      "body": {
        "carrier": "{{ inputs.carrier }}",
        "service": "{{ inputs.service }}",
        "reference_number": "{{ inputs.reference }}",
        "notification_email": "{{ inputs.notification_email }}",
        "create_shipping_label": true,
        "from": {
          "company": "{{ inputs.from_company }}",
          "last_name": "{{ inputs.from_name }}",
          "street": "{{ inputs.from_street }}",
          "street_no": "{{ inputs.from_street_no }}",
          "zip_code": "{{ inputs.from_zip }}",
          "city": "{{ inputs.from_city }}",
          "country": "{{ inputs.from_country }}"
        },
        "to": {
          "company": "{{ inputs.to_company }}",
          "last_name": "{{ inputs.to_name }}",
          "street": "{{ inputs.to_street }}",
          "street_no": "{{ inputs.to_street_no }}",
          "zip_code": "{{ inputs.to_zip }}",
          "city": "{{ inputs.to_city }}",
          "country": "{{ inputs.to_country }}",
          "email": "{{ inputs.to_email }}"
        },
        "package": {
          "weight": "{{ inputs.weight }}",
          "length": "{{ inputs.length }}",
          "width": "{{ inputs.width }}",
          "height": "{{ inputs.height }}"
        }
      },
      "output_fields": {
        "id": "id",
        "tracking_number": "carrier_tracking_no",
        "tracking_url": "tracking_url",
        "label_url": "label_url",
        "price": "price"
      },
      "inputs": [
        {
          "key": "carrier",
          "label": "Carrier",
          "type": "select",
          "required": true,
          "default": "dhl",
          "options": [
            {
              "value": "dhl",
              "label": "dhl"
            },
            {
              "value": "dpd",
              "label": "dpd"
            },
            {
              "value": "gls",
              "label": "gls"
            },
            {
              "value": "hermes",
              "label": "hermes"
            },
            {
              "value": "ups",
              "label": "ups"
            },
            {
              "value": "dhl_express",
              "label": "dhl_express"
            },
            {
              "value": "go",
              "label": "go"
            },
            {
              "value": "angel",
              "label": "angel"
            }
          ]
        },
        {
          "key": "service",
          "label": "Service",
          "type": "string",
          "default": "standard"
        },
        {
          "key": "weight",
          "label": "Weight (kg)",
          "type": "number",
          "required": true
        },
        {
          "key": "length",
          "label": "Length (cm)",
          "type": "number",
          "required": true
        },
        {
          "key": "width",
          "label": "Width (cm)",
          "type": "number",
          "required": true
        },
        {
          "key": "height",
          "label": "Height (cm)",
          "type": "number",
          "required": true
        },
        {
          "key": "reference",
          "label": "Your reference",
          "type": "string"
        },
        {
          "key": "notification_email",
          "label": "Send tracking emails to",
          "type": "string"
        },
        {
          "key": "from_company",
          "label": "Sender company",
          "type": "string"
        },
        {
          "key": "from_name",
          "label": "Sender name",
          "type": "string",
          "required": true
        },
        {
          "key": "from_street",
          "label": "Sender street",
          "type": "string",
          "required": true
        },
        {
          "key": "from_street_no",
          "label": "Sender house no.",
          "type": "string",
          "required": true
        },
        {
          "key": "from_zip",
          "label": "Sender postcode",
          "type": "string",
          "required": true
        },
        {
          "key": "from_city",
          "label": "Sender city",
          "type": "string",
          "required": true
        },
        {
          "key": "from_country",
          "label": "Sender country",
          "type": "string",
          "required": true,
          "default": "DE"
        },
        {
          "key": "to_company",
          "label": "Recipient company",
          "type": "string"
        },
        {
          "key": "to_name",
          "label": "Recipient name",
          "type": "string",
          "required": true
        },
        {
          "key": "to_street",
          "label": "Recipient street",
          "type": "string",
          "required": true
        },
        {
          "key": "to_street_no",
          "label": "Recipient house no.",
          "type": "string",
          "required": true
        },
        {
          "key": "to_zip",
          "label": "Recipient postcode",
          "type": "string",
          "required": true
        },
        {
          "key": "to_city",
          "label": "Recipient city",
          "type": "string",
          "required": true
        },
        {
          "key": "to_country",
          "label": "Recipient country",
          "type": "string",
          "required": true,
          "default": "DE"
        },
        {
          "key": "to_email",
          "label": "Recipient email",
          "type": "string"
        }
      ]
    },
    {
      "key": "get_quote",
      "name": "Get quote",
      "description": "Price for a shipment with a carrier and service.",
      "method": "POST",
      "endpoint": "/shipment_quotes",
      "body": {
        "carrier": "{{ inputs.carrier }}",
        "service": "{{ inputs.service }}",
        "from": {
          "zip_code": "{{ inputs.from_zip }}",
          "country": "{{ inputs.from_country }}",
          "street": "{{ inputs.from_street }}",
          "street_no": "{{ inputs.from_street_no }}",
          "city": "{{ inputs.from_city }}"
        },
        "to": {
          "zip_code": "{{ inputs.to_zip }}",
          "country": "{{ inputs.to_country }}",
          "street": "{{ inputs.to_street }}",
          "street_no": "{{ inputs.to_street_no }}",
          "city": "{{ inputs.to_city }}"
        },
        "package": {
          "weight": "{{ inputs.weight }}",
          "length": "{{ inputs.length }}",
          "width": "{{ inputs.width }}",
          "height": "{{ inputs.height }}"
        }
      },
      "output_fields": {
        "price": "shipment_quote.price"
      },
      "inputs": [
        {
          "key": "carrier",
          "label": "Carrier",
          "type": "select",
          "required": true,
          "default": "dhl",
          "options": [
            {
              "value": "dhl",
              "label": "dhl"
            },
            {
              "value": "dpd",
              "label": "dpd"
            },
            {
              "value": "gls",
              "label": "gls"
            },
            {
              "value": "hermes",
              "label": "hermes"
            },
            {
              "value": "ups",
              "label": "ups"
            },
            {
              "value": "dhl_express",
              "label": "dhl_express"
            },
            {
              "value": "go",
              "label": "go"
            },
            {
              "value": "angel",
              "label": "angel"
            }
          ]
        },
        {
          "key": "service",
          "label": "Service",
          "type": "string",
          "default": "standard"
        },
        {
          "key": "weight",
          "label": "Weight (kg)",
          "type": "number",
          "required": true
        },
        {
          "key": "length",
          "label": "Length (cm)",
          "type": "number",
          "required": true
        },
        {
          "key": "width",
          "label": "Width (cm)",
          "type": "number",
          "required": true
        },
        {
          "key": "height",
          "label": "Height (cm)",
          "type": "number",
          "required": true
        },
        {
          "key": "from_street",
          "label": "From street",
          "type": "string",
          "required": true
        },
        {
          "key": "from_street_no",
          "label": "From house no.",
          "type": "string",
          "required": true
        },
        {
          "key": "from_zip",
          "label": "From postcode",
          "type": "string",
          "required": true
        },
        {
          "key": "from_city",
          "label": "From city",
          "type": "string",
          "required": true
        },
        {
          "key": "from_country",
          "label": "From country",
          "type": "string",
          "required": true,
          "default": "DE"
        },
        {
          "key": "to_street",
          "label": "To street",
          "type": "string",
          "required": true
        },
        {
          "key": "to_street_no",
          "label": "To house no.",
          "type": "string",
          "required": true
        },
        {
          "key": "to_zip",
          "label": "To postcode",
          "type": "string",
          "required": true
        },
        {
          "key": "to_city",
          "label": "To city",
          "type": "string",
          "required": true
        },
        {
          "key": "to_country",
          "label": "To country",
          "type": "string",
          "required": true,
          "default": "DE"
        }
      ]
    },
    {
      "key": "get_shipment",
      "name": "Get shipment",
      "description": "A shipment's tracking and label.",
      "method": "GET",
      "endpoint": "/shipments/{{ inputs.id }}",
      "output_fields": {
        "tracking_number": "carrier_tracking_no",
        "tracking_url": "tracking_url",
        "label_url": "label_url",
        "status": "packages.0.tracking_events.0.status"
      },
      "inputs": [
        {
          "key": "id",
          "label": "Shipment ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_shipments",
      "name": "List shipments",
      "description": "Your shipments, optionally filtered.",
      "method": "GET",
      "endpoint": "/shipments",
      "query": {
        "carrier": "{{ inputs.carrier }}",
        "reference_number": "{{ inputs.reference }}",
        "carrier_tracking_no": "{{ inputs.tracking_number }}"
      },
      "output_fields": {
        "shipments": "shipments"
      },
      "inputs": [
        {
          "key": "carrier",
          "label": "Carrier",
          "type": "string"
        },
        {
          "key": "reference",
          "label": "Your reference",
          "type": "string"
        },
        {
          "key": "tracking_number",
          "label": "Tracking number",
          "type": "string"
        }
      ]
    },
    {
      "key": "delete_shipment",
      "name": "Delete shipment",
      "description": "Delete a shipment and void its label (where the carrier allows).",
      "method": "DELETE",
      "endpoint": "/shipments/{{ inputs.id }}",
      "inputs": [
        {
          "key": "id",
          "label": "Shipment ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "create_tracker",
      "name": "Track a parcel",
      "description": "Follow a parcel shipped outside shipcloud.",
      "method": "POST",
      "endpoint": "/trackers",
      "body": {
        "carrier_tracking_no": "{{ inputs.tracking_number }}",
        "carrier": "{{ inputs.carrier }}"
      },
      "output_fields": {
        "id": "id",
        "status": "status"
      },
      "inputs": [
        {
          "key": "tracking_number",
          "label": "Tracking number",
          "type": "string",
          "required": true
        },
        {
          "key": "carrier",
          "label": "Carrier",
          "type": "select",
          "required": true,
          "default": "dhl",
          "options": [
            {
              "value": "dhl",
              "label": "dhl"
            },
            {
              "value": "dpd",
              "label": "dpd"
            },
            {
              "value": "gls",
              "label": "gls"
            },
            {
              "value": "hermes",
              "label": "hermes"
            },
            {
              "value": "ups",
              "label": "ups"
            },
            {
              "value": "dhl_express",
              "label": "dhl_express"
            }
          ]
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Shipment status",
      "type": "webhook",
      "description": "shipcloud → Webhooks → Add webhook, paste this URL.",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
