{
  "key": "ntfy",
  "name": "ntfy",
  "category": "Communication",
  "description": "Publish push notifications to an ntfy topic on ntfy.sh or your own server.",
  "brand": "ntfy",
  "website": "https://ntfy.sh",
  "docs_url": "https://docs.ntfy.sh/publish/",
  "base_url": "https://ntfy.sh",
  "auth": [
    { "type": "none" },
    { "type": "bearer", "fields": [{ "key": "token", "label": "Access token (tk_…)", "type": "password", "required": true }] },
    { "type": "basic" }
  ],
  "actions": [
    {
      "key": "publish",
      "name": "Send notification",
      "description": "Public topics on ntfy.sh need no credential; anyone who knows the topic name can read it.",
      "method": "POST",
      "endpoint": "{{ inputs.server_url }}",
      "body": {
        "topic": "{{ inputs.topic }}",
        "message": "{{ inputs.message }}",
        "title": "{{ inputs.title }}",
        "tags": "{{ inputs.tags }}",
        "priority": "{{ inputs.priority }}",
        "click": "{{ inputs.click }}",
        "markdown": "{{ inputs.markdown }}"
      },
      "inputs": [
        { "key": "server_url", "label": "Server URL", "type": "string", "required": true, "default": "https://ntfy.sh", "help": "Your self-hosted ntfy URL, or https://ntfy.sh." },
        { "key": "topic", "label": "Topic", "type": "string", "required": true },
        { "key": "message", "label": "Message", "type": "text", "required": true },
        { "key": "title", "label": "Title", "type": "string" },
        { "key": "tags", "label": "Tags / emojis", "type": "list", "placeholder": "warning" },
        { "key": "priority", "label": "Priority (1-5)", "type": "number", "default": 3, "help": "1 = min, 3 = default, 5 = urgent." },
        { "key": "click", "label": "Open URL on click", "type": "string" },
        { "key": "markdown", "label": "Render Markdown", "type": "boolean", "default": false }
      ]
    }
  ]
}
