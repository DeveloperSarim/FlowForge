{
  "key": "unstructured",
  "name": "Unstructured",
  "category": "AI",
  "description": "Run Unstructured workflows and track their jobs.",
  "brand": "unstructured",
  "website": "https://unstructured.io",
  "docs_url": "https://docs.unstructured.io/api-reference/workflow/overview",
  "base_url": "https://platform.unstructuredapp.io/api/v1",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "unstructured-api-key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "list_workflows",
      "name": "List workflows",
      "method": "GET",
      "endpoint": "/workflows/",
      "query": {
        "name": "{{ inputs.name }}",
        "status": "{{ inputs.status }}"
      },
      "inputs": [
        {
          "key": "name",
          "label": "Name",
          "type": "string"
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "options": [
            {
              "value": "active",
              "label": "Active"
            },
            {
              "value": "inactive",
              "label": "Inactive"
            }
          ]
        }
      ]
    },
    {
      "key": "run_workflow",
      "name": "Run workflow",
      "method": "POST",
      "endpoint": "/workflows/{{ inputs.workflow_id }}/run",
      "inputs": [
        {
          "key": "workflow_id",
          "label": "Workflow ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_jobs",
      "name": "List jobs",
      "method": "GET",
      "endpoint": "/jobs/",
      "query": {
        "workflow_id": "{{ inputs.workflow_id }}",
        "status": "{{ inputs.status }}"
      },
      "inputs": [
        {
          "key": "workflow_id",
          "label": "Workflow ID",
          "type": "string"
        },
        {
          "key": "status",
          "label": "Status",
          "type": "string",
          "placeholder": "COMPLETED"
        }
      ]
    },
    {
      "key": "get_job",
      "name": "Get job",
      "method": "GET",
      "endpoint": "/jobs/{{ inputs.job_id }}",
      "inputs": [
        {
          "key": "job_id",
          "label": "Job ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
