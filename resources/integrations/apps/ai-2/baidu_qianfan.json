{
  "key": "baidu_qianfan",
  "name": "Baidu Qianfan",
  "category": "AI",
  "description": "Chat with ERNIE and other models hosted on Baidu AI Cloud Qianfan.",
  "brand": "baidu",
  "website": "https://cloud.baidu.com/product/wenxinworkshop.html",
  "docs_url": "https://cloud.baidu.com/doc/qianfan-api/s/3m7of64lb",
  "base_url": "https://qianfan.baidubce.com/v2",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Qianfan console → API Key (starts with bce-v3/)."
      }
    ]
  },
  "actions": [
    {
      "key": "chat_completion",
      "name": "Chat completion",
      "description": "Send a prompt and get the reply as {{ steps.<id>.text }}.",
      "method": "POST",
      "endpoint": "/chat/completions",
      "timeout": 300,
      "body": {
        "model": "{{ inputs.model }}",
        "messages": [
          {
            "role": "system",
            "content": "{{ inputs.system }}"
          },
          {
            "role": "user",
            "content": "{{ inputs.prompt }}"
          }
        ],
        "temperature": "{{ inputs.temperature }}",
        "max_completion_tokens": "{{ inputs.max_tokens }}"
      },
      "output_fields": {
        "text": "choices.0.message.content"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "default": "deepseek-v3.1-250821",
          "help": "Any model ID from the Qianfan model list, e.g. an ERNIE model."
        },
        {
          "key": "prompt",
          "label": "Prompt",
          "type": "text",
          "required": true
        },
        {
          "key": "system",
          "label": "System prompt",
          "type": "text",
          "required": true,
          "default": "You are a helpful assistant.",
          "help": "Sent as the system message."
        },
        {
          "key": "temperature",
          "label": "Temperature",
          "type": "number",
          "placeholder": "0.7"
        },
        {
          "key": "max_tokens",
          "label": "Max output tokens",
          "type": "number"
        }
      ]
    }
  ]
}
