{
  "key": "shift4shop",
  "name": "Shift4Shop",
  "category": "E-commerce",
  "description": "List and look up orders, products and customers in a Shift4Shop store.",
  "brand": "shift4shop",
  "website": "https://www.shift4shop.com",
  "docs_url": "https://apirest.3dcart.com/Help",
  "base_url": "https://apirest.3dcart.com/3dCartWebAPI/v2",
  "headers": {
    "SecureURL": "{{ credentials.secure_url }}",
    "PrivateKey": "{{ credentials.private_key }}",
    "Token": "{{ credentials.api_key }}"
  },
  "auth": [
    {
      "type": "api_key",
      "fields": [
        {
          "key": "secure_url",
          "label": "Store secure URL",
          "type": "string",
          "required": true,
          "placeholder": "https://mystore.3dcartstores.com"
        },
        {
          "key": "private_key",
          "label": "App private key",
          "type": "password",
          "required": true,
          "help": "Shown on your app in the Shift4Shop Developer Center."
        },
        {
          "key": "api_key",
          "label": "Store token",
          "type": "password",
          "required": true,
          "help": "Issued when the store authorizes your REST API app."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_orders",
      "name": "List orders",
      "method": "GET",
      "endpoint": "/Orders",
      "query": {
        "limit": "{{ inputs.limit }}",
        "offset": "{{ inputs.offset }}",
        "orderstatus": "{{ inputs.order_status }}",
        "datestart": "{{ inputs.date_start }}",
        "dateend": "{{ inputs.date_end }}",
        "invoicenumber": "{{ inputs.invoice_number }}"
      },
      "inputs": [
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50
        },
        {
          "key": "offset",
          "label": "Offset",
          "type": "number"
        },
        {
          "key": "order_status",
          "label": "Order status ID",
          "type": "number",
          "help": "1 = New, 2 = Processing, 4 = Shipped, 5 = Cancelled, 7 = Unpaid."
        },
        {
          "key": "date_start",
          "label": "From date",
          "type": "string",
          "placeholder": "01/31/2026"
        },
        {
          "key": "date_end",
          "label": "To date",
          "type": "string",
          "placeholder": "02/28/2026"
        },
        {
          "key": "invoice_number",
          "label": "Invoice number",
          "type": "string"
        }
      ]
    },
    {
      "key": "get_order",
      "name": "Get order",
      "method": "GET",
      "endpoint": "/Orders/{{ inputs.order_id }}",
      "inputs": [
        {
          "key": "order_id",
          "label": "Order ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_products",
      "name": "List products",
      "method": "GET",
      "endpoint": "/Products",
      "query": {
        "limit": "{{ inputs.limit }}",
        "offset": "{{ inputs.offset }}",
        "sku": "{{ inputs.sku }}"
      },
      "inputs": [
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50
        },
        {
          "key": "offset",
          "label": "Offset",
          "type": "number"
        },
        {
          "key": "sku",
          "label": "SKU",
          "type": "string"
        }
      ]
    },
    {
      "key": "list_customers",
      "name": "Find customers",
      "method": "GET",
      "endpoint": "/Customers",
      "query": {
        "email": "{{ inputs.email }}",
        "limit": "{{ inputs.limit }}",
        "offset": "{{ inputs.offset }}"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string"
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50
        },
        {
          "key": "offset",
          "label": "Offset",
          "type": "number"
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "Add this URL as a webhook in your Shift4Shop store admin and pick the events to send.",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
