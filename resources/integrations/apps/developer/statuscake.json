{
  "key": "statuscake",
  "name": "StatusCake",
  "category": "Developer Tools",
  "description": "List, create, pause and delete uptime tests.",
  "brand": "statuscake",
  "website": "https://www.statuscake.com",
  "docs_url": "https://developers.statuscake.com/api/",
  "base_url": "https://api.statuscake.com/v1",
  "auth": { "type": "bearer", "fields": [{ "key": "token", "label": "API token", "type": "password", "required": true, "help": "Account settings → API keys." }] },
  "actions": [
    {
      "key": "list_uptime_tests",
      "name": "List uptime tests",
      "method": "GET",
      "endpoint": "/uptime",
      "query": { "status": "{{ inputs.status }}", "limit": 100 },
      "output_path": "data",
      "inputs": [{ "key": "status", "label": "Status", "type": "select", "options": [{ "value": "up", "label": "Up" }, { "value": "down", "label": "Down" }] }]
    },
    {
      "key": "get_uptime_test",
      "name": "Get uptime test",
      "method": "GET",
      "endpoint": "/uptime/{{ inputs.test_id }}",
      "output_path": "data",
      "inputs": [{ "key": "test_id", "label": "Test ID", "type": "string", "required": true }]
    },
    {
      "key": "create_uptime_test",
      "name": "Create uptime test",
      "method": "POST",
      "endpoint": "/uptime",
      "body_format": "form",
      "body": { "name": "{{ inputs.name }}", "test_type": "{{ inputs.test_type }}", "website_url": "{{ inputs.website_url }}", "check_rate": "{{ inputs.check_rate }}" },
      "inputs": [
        { "key": "name", "label": "Name", "type": "string", "required": true },
        { "key": "test_type", "label": "Type", "type": "select", "required": true, "default": "HTTP", "options": [
          { "value": "HTTP", "label": "HTTP" }, { "value": "HEAD", "label": "HEAD" }, { "value": "TCP", "label": "TCP" }, { "value": "PING", "label": "Ping" }, { "value": "DNS", "label": "DNS" }
        ] },
        { "key": "website_url", "label": "URL or host", "type": "string", "required": true },
        { "key": "check_rate", "label": "Check rate", "type": "select", "required": true, "default": "300", "options": [
          { "value": "60", "label": "1 minute" }, { "value": "300", "label": "5 minutes" }, { "value": "900", "label": "15 minutes" }, { "value": "1800", "label": "30 minutes" }, { "value": "3600", "label": "1 hour" }
        ] }
      ]
    },
    {
      "key": "pause_uptime_test",
      "name": "Pause / resume uptime test",
      "method": "PUT",
      "endpoint": "/uptime/{{ inputs.test_id }}",
      "body_format": "form",
      "body": { "paused": "{{ inputs.paused }}" },
      "inputs": [
        { "key": "test_id", "label": "Test ID", "type": "string", "required": true },
        { "key": "paused", "label": "State", "type": "select", "required": true, "default": "true", "options": [{ "value": "true", "label": "Pause" }, { "value": "false", "label": "Resume" }] }
      ]
    },
    {
      "key": "delete_uptime_test",
      "name": "Delete uptime test",
      "method": "DELETE",
      "endpoint": "/uptime/{{ inputs.test_id }}",
      "inputs": [{ "key": "test_id", "label": "Test ID", "type": "string", "required": true }]
    }
  ],
  "triggers": [
    {
      "key": "alert_webhook",
      "name": "Alert webhook",
      "type": "webhook",
      "inputs": [{ "key": "sample_payload", "label": "Test payload (JSON)", "type": "json" }]
    }
  ]
}
