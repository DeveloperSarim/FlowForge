{
  "key": "tmetric",
  "name": "TMetric",
  "category": "Productivity",
  "description": "Log TMetric time entries.",
  "brand": "tmetric",
  "website": "https://tmetric.com",
  "docs_url": "https://app.tmetric.com/api-docs/",
  "base_url": "https://app.tmetric.com/api/v3",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "API token",
          "type": "password",
          "required": true,
          "help": "My profile > Get new API token."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "get_current_user",
      "name": "Get current user",
      "method": "GET",
      "endpoint": "/user",
      "inputs": []
    },
    {
      "key": "create_time_entry",
      "name": "Create time entry",
      "method": "POST",
      "endpoint": "/accounts/{{ inputs.account_id }}/timeentries",
      "body": {
        "startTime": "{{ inputs.start_time }}",
        "endTime": "{{ inputs.end_time }}",
        "note": "{{ inputs.note }}",
        "isBillable": "{{ inputs.is_billable }}",
        "...": "{{ inputs.extra }}"
      },
      "inputs": [
        {
          "key": "account_id",
          "label": "Account (workspace) ID",
          "type": "string",
          "required": true
        },
        {
          "key": "start_time",
          "label": "Start",
          "type": "string",
          "required": true,
          "placeholder": "2026-10-12T09:00:00"
        },
        {
          "key": "end_time",
          "label": "End",
          "type": "string",
          "placeholder": "2026-10-12T10:30:00"
        },
        {
          "key": "note",
          "label": "Note",
          "type": "string"
        },
        {
          "key": "is_billable",
          "label": "Billable",
          "type": "boolean"
        },
        {
          "key": "extra",
          "label": "Extra fields",
          "type": "json",
          "help": "Any other time entry fields, e.g. {\"project\": {\"id\": 123}}."
        }
      ]
    }
  ]
}
