{
  "key": "deel",
  "name": "Deel",
  "category": "HR & Recruiting",
  "description": "List and read contracts and people in Deel.",
  "brand": "deel",
  "website": "https://www.deel.com",
  "docs_url": "https://developer.deel.com/docs",
  "base_url": "https://api.letsdeel.com/rest/v2",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "API token",
          "type": "password",
          "required": true,
          "help": "Apps & Integrations > Developer Center > API tokens."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_contracts",
      "name": "List contracts",
      "method": "GET",
      "endpoint": "/contracts",
      "query": {
        "limit": "{{ inputs.limit }}"
      },
      "output_path": "data",
      "inputs": [
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50
        }
      ]
    },
    {
      "key": "get_contract",
      "name": "Get contract",
      "method": "GET",
      "endpoint": "/contracts/{{ inputs.contract_id }}",
      "output_path": "data",
      "inputs": [
        {
          "key": "contract_id",
          "label": "Contract ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_people",
      "name": "List people",
      "method": "GET",
      "endpoint": "/people",
      "query": {
        "limit": "{{ inputs.limit }}"
      },
      "output_path": "data",
      "inputs": [
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50
        }
      ]
    },
    {
      "key": "get_person",
      "name": "Get person",
      "method": "GET",
      "endpoint": "/people/{{ inputs.worker_id }}",
      "output_path": "data",
      "inputs": [
        {
          "key": "worker_id",
          "label": "Worker ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "data_path": "data",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
