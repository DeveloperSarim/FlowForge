{
  "key": "quire",
  "name": "Quire",
  "category": "Project Management",
  "description": "Create Quire tasks, list projects and tasks, and comment.",
  "brand": "quire",
  "website": "https://quire.io",
  "docs_url": "https://quire.io/dev/api/",
  "base_url": "https://quire.io/api",
  "auth": [
    {
      "type": "oauth2",
      "authorize_url": "https://quire.io/oauth",
      "token_url": "https://quire.io/oauth/token",
      "scopes": []
    }
  ],
  "actions": [
    {
      "key": "get_me",
      "name": "Get current user",
      "method": "GET",
      "endpoint": "/user/id/me",
      "inputs": []
    },
    {
      "key": "list_projects",
      "name": "List projects",
      "method": "GET",
      "endpoint": "/project/list",
      "inputs": []
    },
    {
      "key": "list_tasks",
      "name": "List root tasks",
      "method": "GET",
      "endpoint": "/task/list/id/{{ inputs.project_id }}",
      "inputs": [
        {
          "key": "project_id",
          "label": "Project ID",
          "type": "string",
          "required": true,
          "placeholder": "my-project"
        }
      ]
    },
    {
      "key": "create_task",
      "name": "Create task",
      "method": "POST",
      "endpoint": "/task/id/{{ inputs.project_id }}",
      "body": {
        "name": "{{ inputs.name }}",
        "description": "{{ inputs.description }}",
        "due": "{{ inputs.due }}"
      },
      "inputs": [
        {
          "key": "project_id",
          "label": "Project ID",
          "type": "string",
          "required": true,
          "placeholder": "my-project"
        },
        {
          "key": "name",
          "label": "Name",
          "type": "string",
          "required": true
        },
        {
          "key": "description",
          "label": "Description (Markdown)",
          "type": "text"
        },
        {
          "key": "due",
          "label": "Due date",
          "type": "string",
          "placeholder": "2026-10-20"
        }
      ]
    },
    {
      "key": "add_comment",
      "name": "Add comment",
      "method": "POST",
      "endpoint": "/comment/id/{{ inputs.project_id }}/{{ inputs.task_id }}",
      "body": {
        "description": "{{ inputs.description }}"
      },
      "inputs": [
        {
          "key": "project_id",
          "label": "Project ID",
          "type": "string",
          "required": true,
          "placeholder": "my-project"
        },
        {
          "key": "task_id",
          "label": "Task ID",
          "type": "number",
          "required": true
        },
        {
          "key": "description",
          "label": "Comment (Markdown)",
          "type": "text",
          "required": true
        }
      ]
    }
  ]
}
