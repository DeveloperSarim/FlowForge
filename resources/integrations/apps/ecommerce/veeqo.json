{
  "key": "veeqo",
  "name": "Veeqo",
  "category": "E-commerce",
  "description": "Read orders and products from Veeqo inventory and shipping.",
  "brand": "veeqo",
  "website": "https://www.veeqo.com",
  "docs_url": "https://developers.veeqo.com/",
  "base_url": "https://api.veeqo.com",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "x-api-key",
      "fields": [
        {
          "key": "api_key",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Settings > Users > your user > Refresh API key."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_orders",
      "name": "List orders",
      "method": "GET",
      "endpoint": "/orders",
      "query": {
        "status": "{{ inputs.status }}",
        "created_at_min": "{{ inputs.created_at_min }}",
        "page_size": "{{ inputs.page_size }}",
        "page": "{{ inputs.page }}"
      },
      "inputs": [
        {
          "key": "status",
          "label": "Status",
          "type": "string",
          "placeholder": "awaiting_fulfillment"
        },
        {
          "key": "created_at_min",
          "label": "Created after",
          "type": "string",
          "placeholder": "2025-01-01 00:00:00"
        },
        {
          "key": "page_size",
          "label": "Page size",
          "type": "number",
          "default": 25
        },
        {
          "key": "page",
          "label": "Page",
          "type": "number"
        }
      ]
    },
    {
      "key": "get_order",
      "name": "Get order",
      "method": "GET",
      "endpoint": "/orders/{{ inputs.order_id }}",
      "inputs": [
        {
          "key": "order_id",
          "label": "Order ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_products",
      "name": "List products",
      "method": "GET",
      "endpoint": "/products",
      "query": {
        "query": "{{ inputs.query }}",
        "page_size": "{{ inputs.page_size }}"
      },
      "inputs": [
        {
          "key": "query",
          "label": "Search",
          "type": "string"
        },
        {
          "key": "page_size",
          "label": "Page size",
          "type": "number",
          "default": 25
        }
      ]
    },
    {
      "key": "get_product",
      "name": "Get product",
      "method": "GET",
      "endpoint": "/products/{{ inputs.product_id }}",
      "inputs": [
        {
          "key": "product_id",
          "label": "Product ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ],
  "triggers": []
}
