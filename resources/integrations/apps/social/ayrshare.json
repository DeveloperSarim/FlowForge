{
  "key": "ayrshare",
  "name": "Ayrshare",
  "category": "Social Media",
  "description": "Publish or schedule one post to many social networks at once.",
  "brand": "ayrshare",
  "website": "https://www.ayrshare.com",
  "docs_url": "https://www.ayrshare.com/docs/apis/post/post",
  "base_url": "https://api.ayrshare.com/api",
  "auth": { "type": "bearer", "fields": [{ "key": "token", "label": "API key", "type": "password", "required": true }] },
  "actions": [
    {
      "key": "publish_post",
      "name": "Publish post",
      "method": "POST",
      "endpoint": "/post",
      "headers": { "Profile-Key": "{{ inputs.profile_key }}" },
      "body": { "post": "{{ inputs.post }}", "platforms": "{{ inputs.platforms }}", "mediaUrls": "{{ inputs.media_urls }}", "scheduleDate": "{{ inputs.schedule_date }}" },
      "inputs": [
        { "key": "post", "label": "Text", "type": "text", "required": true },
        { "key": "platforms", "label": "Platforms", "type": "list", "required": true, "placeholder": "twitter", "help": "e.g. facebook, instagram, linkedin, twitter, threads, bluesky, tiktok, youtube, pinterest" },
        { "key": "media_urls", "label": "Media URLs (https)", "type": "list" },
        { "key": "schedule_date", "label": "Schedule at (UTC)", "type": "string", "placeholder": "2026-07-08T12:30:00Z" },
        { "key": "profile_key", "label": "User profile key", "type": "string", "help": "Only when posting for a Business-plan user profile." }
      ]
    },
    {
      "key": "delete_post",
      "name": "Delete post",
      "method": "DELETE",
      "endpoint": "/post",
      "body": { "id": "{{ inputs.id }}" },
      "inputs": [{ "key": "id", "label": "Ayrshare post ID", "type": "string", "required": true }]
    },
    {
      "key": "get_history",
      "name": "Get post history",
      "method": "GET",
      "endpoint": "/history",
      "query": { "lastRecords": "{{ inputs.last_records }}", "lastDays": "{{ inputs.last_days }}" },
      "inputs": [
        { "key": "last_records", "label": "Last N records", "type": "number" },
        { "key": "last_days", "label": "Last N days", "type": "number", "default": 30 }
      ]
    },
    {
      "key": "get_user",
      "name": "Get account and linked networks",
      "method": "GET",
      "endpoint": "/user",
      "inputs": []
    }
  ]
}
