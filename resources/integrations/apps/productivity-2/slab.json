{
  "key": "slab",
  "name": "Slab",
  "category": "Productivity",
  "description": "Query your Slab knowledge base through its GraphQL API.",
  "brand": "slab",
  "website": "https://slab.com",
  "docs_url": "https://studio.apollographql.com/public/Slab/home",
  "base_url": "https://api.slab.com",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "Authorization",
      "fields": [
        {
          "key": "api_key",
          "label": "API token",
          "type": "password",
          "required": true,
          "help": "Team settings > Developer (Business and Enterprise plans)."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "run_graphql",
      "name": "Run GraphQL query",
      "method": "POST",
      "endpoint": "/v1/graphql",
      "description": "Runs any query or mutation against the GraphQL API.",
      "body": {
        "query": "{{ inputs.query }}",
        "variables": "{{ inputs.variables }}"
      },
      "error_path": "errors",
      "inputs": [
        {
          "key": "query",
          "label": "Query or mutation",
          "type": "code",
          "required": true
        },
        {
          "key": "variables",
          "label": "Variables",
          "type": "json"
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
