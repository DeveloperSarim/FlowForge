{
  "key": "woopra",
  "name": "Woopra",
  "category": "Analytics",
  "description": "Track custom events and identify visitors in a Woopra project.",
  "brand": "woopra",
  "website": "https://www.woopra.com",
  "docs_url": "https://docs.woopra.com/reference/intro-http-tracking",
  "base_url": "https://www.woopra.com",
  "auth": [
    { "type": "none" },
    { "type": "basic", "fields": [
      { "key": "username", "label": "App ID", "type": "string", "required": true, "help": "Only needed for the REST API (Make an API call). Tracking needs no credential." },
      { "key": "password", "label": "Secret key", "type": "password", "required": true }
    ] }
  ],
  "actions": [
    {
      "key": "track_event",
      "name": "Track event",
      "method": "GET",
      "endpoint": "/track/ce/",
      "query": { "host": "{{ inputs.project }}", "event": "{{ inputs.event }}", "cv_email": "{{ inputs.email }}", "cv_id": "{{ inputs.visitor_id }}", "cookie": "{{ inputs.cookie }}", "timestamp": "{{ inputs.timestamp }}" },
      "inputs": [
        { "key": "project", "label": "Project (domain)", "type": "string", "required": true, "help": "Your Woopra project name, usually your domain." },
        { "key": "event", "label": "Event name", "type": "string", "required": true },
        { "key": "email", "label": "Visitor email", "type": "string", "help": "Give an email, visitor ID or cookie." },
        { "key": "visitor_id", "label": "Visitor ID", "type": "string" },
        { "key": "cookie", "label": "Cookie", "type": "string" },
        { "key": "timestamp", "label": "Timestamp (ms)", "type": "number" }
      ]
    },
    {
      "key": "identify",
      "name": "Identify visitor",
      "method": "GET",
      "endpoint": "/track/identify/",
      "query": { "host": "{{ inputs.project }}", "cv_email": "{{ inputs.email }}", "cv_name": "{{ inputs.name }}", "cv_company": "{{ inputs.company }}", "cv_id": "{{ inputs.visitor_id }}", "cookie": "{{ inputs.cookie }}" },
      "inputs": [
        { "key": "project", "label": "Project (domain)", "type": "string", "required": true },
        { "key": "email", "label": "Email", "type": "string" },
        { "key": "name", "label": "Name", "type": "string" },
        { "key": "company", "label": "Company", "type": "string" },
        { "key": "visitor_id", "label": "Visitor ID", "type": "string" },
        { "key": "cookie", "label": "Cookie", "type": "string" }
      ]
    }
  ]
}
