{
  "key": "pushcut",
  "name": "Pushcut",
  "category": "Communication",
  "description": "Trigger Pushcut notifications on your iPhone and list devices and notifications.",
  "brand": "pushcut",
  "website": "https://www.pushcut.io",
  "docs_url": "https://www.pushcut.io/webapi",
  "base_url": "https://api.pushcut.io/v1",
  "auth": [
    { "type": "api_key", "in": "header", "name": "API-Key", "fields": [{ "key": "api_key", "label": "API key", "type": "password", "required": true, "help": "Pushcut app → Account → Add API key." }] }
  ],
  "actions": [
    {
      "key": "send_notification",
      "name": "Send notification",
      "method": "POST",
      "endpoint": "/notifications/{{ inputs.notification }}",
      "body": { "title": "{{ inputs.title }}", "text": "{{ inputs.text }}", "input": "{{ inputs.input }}", "devices": "{{ inputs.devices }}" },
      "inputs": [
        { "key": "notification", "label": "Notification name", "type": "string", "required": true, "help": "A notification defined in the Pushcut app." },
        { "key": "title", "label": "Title override", "type": "string" },
        { "key": "text", "label": "Text override", "type": "text" },
        { "key": "input", "label": "Input for actions", "type": "string", "help": "Passed to the notification's shortcut/automation actions." },
        { "key": "devices", "label": "Only these devices", "type": "list" }
      ]
    },
    {
      "key": "list_notifications",
      "name": "List notifications",
      "method": "GET",
      "endpoint": "/notifications",
      "inputs": []
    },
    {
      "key": "list_devices",
      "name": "List devices",
      "method": "GET",
      "endpoint": "/devices",
      "inputs": []
    }
  ]
}
