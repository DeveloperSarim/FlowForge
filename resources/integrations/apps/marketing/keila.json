{
  "key": "keila",
  "name": "Keila",
  "category": "Marketing & Email",
  "description": "Create contacts and list campaigns (open-source newsletter tool).",
  "brand": "keila",
  "website": "https://www.keila.io",
  "docs_url": "https://www.keila.io/docs/api",
  "base_url": "{{ credentials.url }}/api/v1",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "url",
        "label": "Keila URL",
        "type": "string",
        "required": true,
        "default": "https://app.keila.io",
        "help": "No trailing slash. Your own host if self-hosted."
      },
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "create_contact",
      "name": "Create contact",
      "method": "POST",
      "endpoint": "/contacts",
      "output_path": "data",
      "body": {
        "data": {
          "email": "{{ inputs.email }}",
          "first_name": "{{ inputs.first_name }}",
          "last_name": "{{ inputs.last_name }}",
          "data": "{{ inputs.data }}"
        }
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "first_name",
          "label": "First name",
          "type": "string"
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "data",
          "label": "Custom data",
          "type": "json"
        }
      ]
    },
    {
      "key": "list_campaigns",
      "name": "List campaigns",
      "method": "GET",
      "endpoint": "/campaigns",
      "output_path": "data",
      "inputs": []
    }
  ]
}
