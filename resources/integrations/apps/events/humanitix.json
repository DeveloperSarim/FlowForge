{
  "key": "humanitix",
  "name": "Humanitix",
  "category": "Events & Webinars",
  "description": "List Humanitix events, orders and tickets and check tickets in.",
  "brand": "humanitix",
  "website": "https://humanitix.com",
  "docs_url": "https://humanitix.stoplight.io",
  "base_url": "https://api.humanitix.com/v1",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "x-api-key",
      "fields": [
        {
          "key": "api_key",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Account > Advanced > API key."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_events",
      "name": "List events",
      "method": "GET",
      "endpoint": "/events",
      "query": {
        "page": "{{ inputs.page }}",
        "pageSize": "{{ inputs.page_size }}",
        "inFutureOnly": "{{ inputs.in_future_only }}",
        "since": "{{ inputs.since }}"
      },
      "output_path": "events",
      "inputs": [
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "required": true,
          "default": 1
        },
        {
          "key": "page_size",
          "label": "Per page",
          "type": "number",
          "default": 100
        },
        {
          "key": "in_future_only",
          "label": "Future events only",
          "type": "boolean"
        },
        {
          "key": "since",
          "label": "Changed since",
          "type": "string",
          "placeholder": "2026-10-01T00:00:00Z"
        }
      ]
    },
    {
      "key": "get_event",
      "name": "Get event",
      "method": "GET",
      "endpoint": "/events/{{ inputs.event_id }}",
      "inputs": [
        {
          "key": "event_id",
          "label": "Event ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_orders",
      "name": "List orders",
      "method": "GET",
      "endpoint": "/events/{{ inputs.event_id }}/orders",
      "query": {
        "page": "{{ inputs.page }}",
        "pageSize": "{{ inputs.page_size }}",
        "since": "{{ inputs.since }}"
      },
      "output_path": "orders",
      "inputs": [
        {
          "key": "event_id",
          "label": "Event ID",
          "type": "string",
          "required": true
        },
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "required": true,
          "default": 1
        },
        {
          "key": "page_size",
          "label": "Per page",
          "type": "number",
          "default": 100
        },
        {
          "key": "since",
          "label": "Changed since",
          "type": "string"
        }
      ]
    },
    {
      "key": "list_tickets",
      "name": "List tickets",
      "method": "GET",
      "endpoint": "/events/{{ inputs.event_id }}/tickets",
      "query": {
        "page": "{{ inputs.page }}",
        "pageSize": "{{ inputs.page_size }}",
        "since": "{{ inputs.since }}"
      },
      "output_path": "tickets",
      "inputs": [
        {
          "key": "event_id",
          "label": "Event ID",
          "type": "string",
          "required": true
        },
        {
          "key": "page",
          "label": "Page",
          "type": "number",
          "required": true,
          "default": 1
        },
        {
          "key": "page_size",
          "label": "Per page",
          "type": "number",
          "default": 100
        },
        {
          "key": "since",
          "label": "Changed since",
          "type": "string"
        }
      ]
    },
    {
      "key": "check_in_ticket",
      "name": "Check in ticket",
      "method": "POST",
      "endpoint": "/events/{{ inputs.event_id }}/tickets/{{ inputs.ticket_id }}/check-in",
      "inputs": [
        {
          "key": "event_id",
          "label": "Event ID",
          "type": "string",
          "required": true
        },
        {
          "key": "ticket_id",
          "label": "Ticket ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
