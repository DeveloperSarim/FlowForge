{
  "key": "similarweb",
  "name": "Similarweb",
  "category": "Ads & SEO",
  "description": "Website visits, engagement and global rank for any domain.",
  "brand": "similarweb",
  "website": "https://www.similarweb.com",
  "docs_url": "https://developers.similarweb.com/docs/similarweb-web-traffic-api",
  "base_url": "https://api.similarweb.com",
  "auth": { "type": "api_key", "in": "query", "name": "api_key" },
  "actions": [
    {
      "key": "get_visits",
      "name": "Get visits",
      "method": "GET",
      "endpoint": "/v1/website/{{ inputs.domain }}/total-traffic-and-engagement/visits",
      "query": {
        "start_date": "{{ inputs.start_date }}",
        "end_date": "{{ inputs.end_date }}",
        "country": "{{ inputs.country }}",
        "granularity": "{{ inputs.granularity }}",
        "main_domain_only": "{{ inputs.main_domain_only }}",
        "format": "json"
      },
      "output_path": "visits",
      "inputs": [
        { "key": "domain", "label": "Domain", "type": "string", "required": true, "placeholder": "example.com" },
        { "key": "start_date", "label": "Start month (YYYY-MM)", "type": "string", "required": true },
        { "key": "end_date", "label": "End month (YYYY-MM)", "type": "string", "required": true },
        { "key": "country", "label": "Country", "type": "string", "default": "world", "help": "world or a 2-letter country code." },
        { "key": "granularity", "label": "Granularity", "type": "select", "default": "monthly", "options": [
          { "value": "monthly", "label": "Monthly" }, { "value": "weekly", "label": "Weekly" }, { "value": "daily", "label": "Daily" }
        ] },
        { "key": "main_domain_only", "label": "Main domain only", "type": "select", "default": "false", "options": [
          { "value": "false", "label": "No, include subdomains" }, { "value": "true", "label": "Yes" }
        ] }
      ]
    },
    {
      "key": "get_rank",
      "name": "Get global rank",
      "method": "GET",
      "endpoint": "/v1/similar-rank/{{ inputs.domain }}/rank",
      "inputs": [{ "key": "domain", "label": "Domain", "type": "string", "required": true, "placeholder": "example.com" }]
    }
  ]
}
