{
  "key": "bing_webmaster_tools",
  "name": "Bing Webmaster Tools",
  "category": "Analytics",
  "description": "Submit URLs to Bing and read search queries, clicks and traffic stats.",
  "website": "https://www.bing.com/webmasters",
  "docs_url": "https://learn.microsoft.com/en-us/bingwebmaster/getting-access",
  "base_url": "https://ssl.bing.com/webmaster/api.svc/json",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "apikey",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Bing Webmaster Tools → Settings (gear) → API access → API Key → Generate API Key."
      }
    ]
  },
  "actions": [
    {
      "key": "list_sites",
      "name": "List sites",
      "description": "Sites in your Bing Webmaster account.",
      "method": "GET",
      "endpoint": "/GetUserSites",
      "output_fields": {
        "sites": "d",
        "urls": "d.*.Url"
      },
      "inputs": []
    },
    {
      "key": "submit_url",
      "name": "Submit URL",
      "description": "Ask Bing to crawl a new or updated page.",
      "method": "POST",
      "endpoint": "/SubmitUrl",
      "body": {
        "siteUrl": "{{ inputs.site_url }}",
        "url": "{{ inputs.url }}"
      },
      "inputs": [
        {
          "key": "site_url",
          "label": "Site URL",
          "type": "string",
          "required": true,
          "placeholder": "https://www.example.com/",
          "help": "Exactly as verified in Bing Webmaster Tools."
        },
        {
          "key": "url",
          "label": "Page URL",
          "type": "string",
          "required": true,
          "placeholder": "https://www.example.com/new-post"
        }
      ]
    },
    {
      "key": "submit_url_batch",
      "name": "Submit URLs (batch)",
      "description": "Submit several URLs at once.",
      "method": "POST",
      "endpoint": "/SubmitUrlBatch",
      "body": {
        "siteUrl": "{{ inputs.site_url }}",
        "urlList": "{{ inputs.urls }}"
      },
      "inputs": [
        {
          "key": "site_url",
          "label": "Site URL",
          "type": "string",
          "required": true,
          "placeholder": "https://www.example.com/",
          "help": "Exactly as verified in Bing Webmaster Tools."
        },
        {
          "key": "urls",
          "label": "Page URLs",
          "type": "list",
          "required": true
        }
      ]
    },
    {
      "key": "get_url_quota",
      "name": "Get URL submission quota",
      "description": "How many URLs you can still submit today and this month.",
      "method": "GET",
      "endpoint": "/GetUrlSubmissionQuota",
      "query": {
        "siteUrl": "{{ inputs.site_url }}"
      },
      "output_fields": {
        "daily_quota": "d.DailyQuota",
        "monthly_quota": "d.MonthlyQuota"
      },
      "inputs": [
        {
          "key": "site_url",
          "label": "Site URL",
          "type": "string",
          "required": true,
          "placeholder": "https://www.example.com/",
          "help": "Exactly as verified in Bing Webmaster Tools."
        }
      ]
    },
    {
      "key": "get_query_stats",
      "name": "Get search query stats",
      "description": "Top search queries with impressions and clicks.",
      "method": "GET",
      "endpoint": "/GetQueryStats",
      "query": {
        "siteUrl": "{{ inputs.site_url }}"
      },
      "output_fields": {
        "queries": "d"
      },
      "inputs": [
        {
          "key": "site_url",
          "label": "Site URL",
          "type": "string",
          "required": true,
          "placeholder": "https://www.example.com/",
          "help": "Exactly as verified in Bing Webmaster Tools."
        }
      ]
    },
    {
      "key": "get_page_stats",
      "name": "Get page stats",
      "description": "Top pages with impressions and clicks.",
      "method": "GET",
      "endpoint": "/GetPageStats",
      "query": {
        "siteUrl": "{{ inputs.site_url }}"
      },
      "output_fields": {
        "pages": "d"
      },
      "inputs": [
        {
          "key": "site_url",
          "label": "Site URL",
          "type": "string",
          "required": true,
          "placeholder": "https://www.example.com/",
          "help": "Exactly as verified in Bing Webmaster Tools."
        }
      ]
    },
    {
      "key": "get_traffic_stats",
      "name": "Get traffic stats",
      "description": "Daily impressions and clicks from Bing.",
      "method": "GET",
      "endpoint": "/GetRankAndTrafficStats",
      "query": {
        "siteUrl": "{{ inputs.site_url }}"
      },
      "output_fields": {
        "stats": "d"
      },
      "inputs": [
        {
          "key": "site_url",
          "label": "Site URL",
          "type": "string",
          "required": true,
          "placeholder": "https://www.example.com/",
          "help": "Exactly as verified in Bing Webmaster Tools."
        }
      ]
    }
  ]
}
