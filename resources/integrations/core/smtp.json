{
  "key": "smtp",
  "name": "Email (SMTP)",
  "icon": "mail",
  "category": "Core",
  "description": "Send email through any SMTP server.",
  "auth": { "type": "smtp" },
  "actions": [
    {
      "key": "send",
      "output": ["message_id", "to", "subject"],
      "name": "Send email",
      "handler": "smtp",
      "inputs": [
        { "key": "to", "label": "To", "type": "string", "required": true, "placeholder": "ada@example.com, grace@example.com" },
        { "key": "cc", "label": "CC", "type": "string" },
        { "key": "bcc", "label": "BCC", "type": "string" },
        { "key": "reply_to", "label": "Reply-To", "type": "string" },
        { "key": "subject", "label": "Subject", "type": "string", "required": true },
        { "key": "format", "label": "Format", "type": "select", "default": "html", "options": [
          { "value": "html", "label": "HTML" }, { "value": "text", "label": "Plain text" }
        ] },
        { "key": "body", "label": "Body", "type": "text", "required": true }
      ]
    }
  ]
}
