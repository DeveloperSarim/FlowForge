{
  "key": "crelate",
  "name": "Crelate",
  "category": "HR & Recruiting",
  "description": "Read and add contacts, jobs and applications in the Crelate recruiting CRM.",
  "website": "https://www.crelate.com",
  "docs_url": "https://developer.crelate.com/",
  "base_url": "https://app.crelate.com/api3",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "api_key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "In Crelate open Settings → Integrations → API Keys → create a key and copy it."
      }
    ]
  },
  "actions": [
    {
      "key": "list_contacts",
      "name": "List contacts",
      "description": "List candidates and contacts.",
      "method": "GET",
      "endpoint": "/contacts",
      "query": {
        "limit": "{{ inputs.limit }}",
        "offset": "{{ inputs.offset }}"
      },
      "output_fields": {
        "contacts": "Data",
        "first_id": "Data.0.Id",
        "first_name": "Data.0.FirstName"
      },
      "inputs": [
        {
          "key": "limit",
          "label": "How many",
          "type": "number",
          "default": 50
        },
        {
          "key": "offset",
          "label": "Start at",
          "type": "number",
          "default": 0
        }
      ]
    },
    {
      "key": "get_contact",
      "name": "Get contact",
      "description": "Read one contact.",
      "method": "GET",
      "endpoint": "/contacts/{{ inputs.id }}",
      "output_fields": {
        "id": "Id",
        "first_name": "FirstName",
        "last_name": "LastName"
      },
      "inputs": [
        {
          "key": "id",
          "label": "Contact ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_jobs",
      "name": "List jobs",
      "description": "List jobs.",
      "method": "GET",
      "endpoint": "/jobs",
      "query": {
        "limit": "{{ inputs.limit }}",
        "offset": "{{ inputs.offset }}"
      },
      "output_fields": {
        "jobs": "Data",
        "first_id": "Data.0.Id",
        "first_name": "Data.0.JobTitle"
      },
      "inputs": [
        {
          "key": "limit",
          "label": "How many",
          "type": "number",
          "default": 50
        },
        {
          "key": "offset",
          "label": "Start at",
          "type": "number",
          "default": 0
        }
      ]
    },
    {
      "key": "list_applications",
      "name": "List applications",
      "description": "List job applications.",
      "method": "GET",
      "endpoint": "/applications",
      "query": {
        "limit": "{{ inputs.limit }}",
        "offset": "{{ inputs.offset }}"
      },
      "output_fields": {
        "applications": "Data",
        "first_id": "Data.0.Id"
      },
      "inputs": [
        {
          "key": "limit",
          "label": "How many",
          "type": "number",
          "default": 50
        },
        {
          "key": "offset",
          "label": "Start at",
          "type": "number",
          "default": 0
        }
      ]
    }
  ]
}
