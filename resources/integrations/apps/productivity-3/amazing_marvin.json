{
  "key": "amazing_marvin",
  "name": "Amazing Marvin",
  "category": "Productivity",
  "description": "Personal task manager: add tasks and read what is due today.",
  "website": "https://amazingmarvin.com",
  "docs_url": "https://github.com/amazing-marvin/amazing-marvin-api-docs",
  "base_url": "https://serv.amazingmarvin.com/api",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "X-API-Token",
    "fields": [
      {
        "key": "api_key",
        "label": "API token",
        "type": "password",
        "required": true,
        "help": "Marvin → Settings → Strategies & Features → API → API Token."
      }
    ]
  },
  "actions": [
    {
      "key": "add_task",
      "name": "Add task",
      "description": "Create a task (inbox, or on a day/category).",
      "method": "POST",
      "endpoint": "/addTask",
      "body": {
        "title": "{{ inputs.title }}",
        "day": "{{ inputs.day }}",
        "parentId": "{{ inputs.parent_id }}",
        "note": "{{ inputs.note }}",
        "timeEstimate": "{{ inputs.time_estimate }}"
      },
      "output_fields": {
        "id": "_id",
        "title": "title"
      },
      "inputs": [
        {
          "key": "title",
          "label": "Title",
          "type": "string",
          "required": true
        },
        {
          "key": "day",
          "label": "Day",
          "type": "string",
          "placeholder": "2025-01-31",
          "help": "Leave empty for the inbox."
        },
        {
          "key": "parent_id",
          "label": "Category or project ID",
          "type": "string",
          "help": "Use \"List categories\". Leave empty for the inbox."
        },
        {
          "key": "note",
          "label": "Note",
          "type": "text"
        },
        {
          "key": "time_estimate",
          "label": "Time estimate (milliseconds)",
          "type": "number",
          "help": "30 minutes = 1800000."
        }
      ]
    },
    {
      "key": "today_items",
      "name": "Today's items",
      "description": "Tasks and projects scheduled for today.",
      "method": "GET",
      "endpoint": "/todayItems",
      "output_fields": {
        "titles": "*.title",
        "ids": "*._id"
      },
      "inputs": []
    },
    {
      "key": "due_items",
      "name": "Due items",
      "description": "Tasks that are due or overdue.",
      "method": "GET",
      "endpoint": "/dueItems",
      "output_fields": {
        "titles": "*.title",
        "ids": "*._id"
      },
      "inputs": []
    },
    {
      "key": "list_categories",
      "name": "List categories",
      "description": "Your categories and projects.",
      "method": "GET",
      "endpoint": "/categories",
      "output_fields": {
        "titles": "*.title",
        "ids": "*._id"
      },
      "inputs": []
    },
    {
      "key": "list_labels",
      "name": "List labels",
      "description": "Your labels.",
      "method": "GET",
      "endpoint": "/labels",
      "output_fields": {
        "titles": "*.title",
        "ids": "*._id"
      },
      "inputs": []
    }
  ]
}
