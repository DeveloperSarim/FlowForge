{
  "key": "ipdata",
  "name": "ipdata",
  "category": "Utilities",
  "description": "IP geolocation, ASN, company and threat intelligence lookups.",
  "brand": "ipdata",
  "website": "https://ipdata.co",
  "docs_url": "https://docs.ipdata.co",
  "base_url": "https://api.ipdata.co",
  "auth": { "type": "api_key", "in": "query", "name": "api-key", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true, "help": "From dashboard.ipdata.co." }
  ] },
  "actions": [
    {
      "key": "lookup_ip",
      "name": "Look up IP address",
      "method": "GET",
      "endpoint": "/{{ inputs.ip }}",
      "query": { "fields": "{{ inputs.fields }}" },
      "inputs": [
        { "key": "ip", "label": "IP address", "type": "string", "required": true, "placeholder": "8.8.8.8" },
        { "key": "fields", "label": "Only these fields", "type": "string", "placeholder": "ip,country_name,city,threat", "help": "Comma-separated. Leave empty for everything." }
      ]
    },
    {
      "key": "bulk_lookup",
      "name": "Look up many IPs",
      "description": "Up to 100 IP addresses in one request.",
      "method": "POST",
      "endpoint": "/bulk",
      "query": { "fields": "{{ inputs.fields }}" },
      "body": "{{ inputs.ips }}",
      "inputs": [
        { "key": "ips", "label": "IP addresses", "type": "list", "required": true },
        { "key": "fields", "label": "Only these fields", "type": "string", "placeholder": "ip,country_name,city" }
      ]
    }
  ]
}
