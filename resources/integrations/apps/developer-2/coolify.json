{
  "key": "coolify",
  "name": "Coolify",
  "category": "Developer Tools",
  "description": "Deploy, start, stop and restart applications on your Coolify instance.",
  "brand": "coolify",
  "website": "https://coolify.io",
  "docs_url": "https://coolify.io/docs/api-reference/authorization",
  "base_url": "{{ credentials.base_url }}/api/v1",
  "auth": { "type": "bearer", "fields": [
    { "key": "base_url", "label": "Coolify URL", "type": "string", "required": true, "placeholder": "https://coolify.example.com", "help": "Your instance (or https://app.coolify.io for Coolify Cloud), without a trailing slash." },
    { "key": "token", "label": "API token", "type": "password", "required": true, "help": "Keys & Tokens → API tokens. Enable the API in Settings first." }
  ] },
  "actions": [
    {
      "key": "deploy",
      "name": "Deploy",
      "description": "Deploys resources by UUID or tag.",
      "method": "GET",
      "endpoint": "/deploy",
      "query": { "uuid": "{{ inputs.uuid }}", "tag": "{{ inputs.tag }}", "force": "{{ inputs.force }}" },
      "inputs": [
        { "key": "uuid", "label": "Resource UUID(s)", "type": "string", "help": "Comma-separated. Use either UUIDs or tags." },
        { "key": "tag", "label": "Tag name(s)", "type": "string", "help": "Comma-separated." },
        { "key": "force", "label": "Force rebuild (no cache)", "type": "boolean" }
      ]
    },
    {
      "key": "list_applications",
      "name": "List applications",
      "method": "GET",
      "endpoint": "/applications",
      "inputs": []
    },
    {
      "key": "get_application",
      "name": "Get application",
      "method": "GET",
      "endpoint": "/applications/{{ inputs.uuid }}",
      "inputs": [{ "key": "uuid", "label": "Application UUID", "type": "string", "required": true }]
    },
    {
      "key": "start_application",
      "name": "Start application",
      "method": "GET",
      "endpoint": "/applications/{{ inputs.uuid }}/start",
      "query": { "force": "{{ inputs.force }}" },
      "inputs": [
        { "key": "uuid", "label": "Application UUID", "type": "string", "required": true },
        { "key": "force", "label": "Force rebuild", "type": "boolean" }
      ]
    },
    {
      "key": "stop_application",
      "name": "Stop application",
      "method": "GET",
      "endpoint": "/applications/{{ inputs.uuid }}/stop",
      "inputs": [{ "key": "uuid", "label": "Application UUID", "type": "string", "required": true }]
    },
    {
      "key": "restart_application",
      "name": "Restart application",
      "method": "GET",
      "endpoint": "/applications/{{ inputs.uuid }}/restart",
      "inputs": [{ "key": "uuid", "label": "Application UUID", "type": "string", "required": true }]
    }
  ]
}
