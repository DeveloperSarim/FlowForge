{
  "key": "gotify",
  "name": "Gotify",
  "category": "Communication",
  "description": "Send push messages to your self-hosted Gotify server.",
  "brand": "gotify",
  "website": "https://gotify.net",
  "docs_url": "https://gotify.net/api-docs",
  "base_url": "{{ credentials.server_url }}",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "X-Gotify-Key",
      "fields": [
        { "key": "server_url", "label": "Server URL", "type": "string", "required": true, "placeholder": "https://gotify.example.com", "help": "No trailing slash." },
        { "key": "api_key", "label": "Application token", "type": "password", "required": true, "help": "Apps > Create application." }
      ]
    }
  ],
  "actions": [
    {
      "key": "create_message",
      "name": "Send message",
      "method": "POST",
      "endpoint": "/message",
      "body": { "title": "{{ inputs.title }}", "message": "{{ inputs.message }}", "priority": "{{ inputs.priority }}" },
      "inputs": [
        { "key": "title", "label": "Title", "type": "string" },
        { "key": "message", "label": "Message", "type": "text", "required": true },
        { "key": "priority", "label": "Priority (0-10)", "type": "number", "default": 5 }
      ]
    }
  ]
}
