{
  "key": "http",
  "name": "HTTP Request",
  "icon": "globe",
  "category": "Core",
  "description": "Call any REST API or send an outbound webhook.",
  "auth": [
    { "type": "none" },
    { "type": "bearer" },
    { "type": "basic" },
    { "type": "api_key", "in": "header", "name": "X-API-Key" }
  ],
  "actions": [
    {
      "key": "request",
      "name": "Send HTTP request",
      "method": "{{ inputs.method }}",
      "endpoint": "{{ inputs.url }}",
      "query": "{{ inputs.query }}",
      "headers": "{{ inputs.headers }}",
      "body": "{{ inputs.body }}",
      "body_format": "{{ inputs.body_format }}",
      "inputs": [
        { "key": "method", "label": "Method", "type": "select", "default": "GET", "required": true, "options": [
          { "value": "GET", "label": "GET" }, { "value": "POST", "label": "POST" }, { "value": "PUT", "label": "PUT" },
          { "value": "PATCH", "label": "PATCH" }, { "value": "DELETE", "label": "DELETE" }
        ] },
        { "key": "url", "label": "URL", "type": "string", "required": true, "placeholder": "https://api.example.com/v1/items" },
        { "key": "query", "label": "Query parameters", "type": "keyvalue" },
        { "key": "headers", "label": "Headers", "type": "keyvalue" },
        { "key": "body_format", "label": "Body format", "type": "select", "default": "json", "options": [
          { "value": "json", "label": "JSON" }, { "value": "form", "label": "Form URL-encoded" }
        ] },
        { "key": "body", "label": "Body", "type": "json", "placeholder": "{\n  \"email\": \"{{ steps.trigger.data.email }}\"\n}" }
      ]
    }
  ]
}
