{
  "key": "sessionize",
  "name": "Sessionize",
  "category": "Events & Webinars",
  "description": "Read your conference's accepted sessions, speakers and schedule from Sessionize.",
  "website": "https://sessionize.com",
  "docs_url": "https://sessionize.com/playbook/api",
  "base_url": "https://sessionize.com/api/v2/{{ credentials.api_id }}/view",
  "auth": {
    "type": "none",
    "fields": [
      {
        "key": "api_id",
        "label": "API endpoint ID",
        "type": "string",
        "required": true,
        "placeholder": "abc123xyz",
        "help": "Sessionize > your event > API / Embed > create an endpoint and copy the ID from its URL: sessionize.com/api/v2/<ID>/view/All."
      }
    ]
  },
  "actions": [
    {
      "key": "get_all",
      "name": "Get everything",
      "description": "Sessions, speakers, categories and rooms.",
      "method": "GET",
      "endpoint": "/All",
      "output_fields": {
        "sessions": "sessions",
        "speakers": "speakers",
        "categories": "categories",
        "rooms": "rooms"
      },
      "inputs": []
    },
    {
      "key": "get_sessions",
      "name": "Get sessions",
      "description": "Get accepted sessions.",
      "method": "GET",
      "endpoint": "/Sessions",
      "output_fields": {
        "groups": "*.sessions"
      },
      "inputs": []
    },
    {
      "key": "get_speakers",
      "name": "Get speakers",
      "description": "Get accepted speakers.",
      "method": "GET",
      "endpoint": "/Speakers",
      "output_fields": {
        "names": "*.fullName",
        "ids": "*.id"
      },
      "inputs": []
    },
    {
      "key": "get_schedule",
      "name": "Get schedule grid",
      "description": "Get the schedule by day and room.",
      "method": "GET",
      "endpoint": "/GridSmart",
      "inputs": []
    }
  ]
}
