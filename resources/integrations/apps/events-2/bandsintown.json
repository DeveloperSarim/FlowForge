{
  "key": "bandsintown",
  "name": "Bandsintown",
  "category": "Events & Webinars",
  "description": "Look up artists and their upcoming concerts on Bandsintown.",
  "website": "https://www.bandsintown.com",
  "docs_url": "https://app.swaggerhub.com/apis/Bandsintown/PublicAPI/3.0.0",
  "base_url": "https://rest.bandsintown.com",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "app_id",
    "fields": [
      {
        "key": "api_key",
        "label": "App ID",
        "type": "string",
        "required": true,
        "help": "Your Bandsintown app ID: request one at manager.bandsintown.com/support/api-installation."
      }
    ]
  },
  "actions": [
    {
      "key": "artist_events",
      "name": "Artist events",
      "description": "Get an artist's upcoming (or past) events.",
      "method": "GET",
      "endpoint": "/artists/{{ inputs.artist }}/events",
      "query": {
        "date": "{{ inputs.date }}"
      },
      "output_fields": {
        "events": "*",
        "venues": "*.venue.name",
        "dates": "*.datetime",
        "urls": "*.url"
      },
      "inputs": [
        {
          "key": "artist",
          "label": "Artist name",
          "type": "string",
          "required": true
        },
        {
          "key": "date",
          "label": "Date range",
          "type": "string",
          "default": "upcoming",
          "help": "upcoming, past, all, or 2025-01-01,2025-12-31."
        }
      ]
    },
    {
      "key": "get_artist",
      "name": "Get an artist",
      "description": "Get an artist's profile.",
      "method": "GET",
      "endpoint": "/artists/{{ inputs.artist }}",
      "output_fields": {
        "name": "name",
        "url": "url",
        "followers": "tracker_count",
        "upcoming": "upcoming_event_count"
      },
      "inputs": [
        {
          "key": "artist",
          "label": "Artist name",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
