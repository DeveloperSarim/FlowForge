{
  "key": "wikipedia",
  "name": "Wikipedia",
  "category": "Utilities",
  "description": "Search articles, get page summaries and \"on this day\" events. No key needed.",
  "brand": "wikipedia",
  "website": "https://www.wikipedia.org",
  "docs_url": "https://www.mediawiki.org/wiki/API:REST_API",
  "base_url": "https://en.wikipedia.org",
  "actions": [
    {
      "key": "search_pages",
      "name": "Search articles",
      "method": "GET",
      "endpoint": "https://{{ inputs.language }}.wikipedia.org/w/rest.php/v1/search/page",
      "query": { "q": "{{ inputs.q }}", "limit": "{{ inputs.limit }}" },
      "output_path": "pages",
      "inputs": [
        { "key": "q", "label": "Search", "type": "string", "required": true, "placeholder": "solar eclipse" },
        { "key": "limit", "label": "Max results", "type": "number", "default": 10, "help": "Max 100." },
        { "key": "language", "label": "Wikipedia language", "type": "string", "required": true, "default": "en", "placeholder": "en" }
      ]
    },
    {
      "key": "get_summary",
      "name": "Get page summary",
      "description": "Title, short description, intro text and thumbnail.",
      "method": "GET",
      "endpoint": "https://{{ inputs.language }}.wikipedia.org/api/rest_v1/page/summary/{{ inputs.title }}",
      "inputs": [
        { "key": "title", "label": "Page title", "type": "string", "required": true, "placeholder": "Albert_Einstein", "help": "Use underscores instead of spaces." },
        { "key": "language", "label": "Wikipedia language", "type": "string", "required": true, "default": "en", "placeholder": "en" }
      ]
    },
    {
      "key": "on_this_day",
      "name": "Get on this day",
      "description": "Events, births, deaths and holidays for a calendar date.",
      "method": "GET",
      "endpoint": "https://{{ inputs.language }}.wikipedia.org/api/rest_v1/feed/onthisday/{{ inputs.type }}/{{ inputs.month }}/{{ inputs.day }}",
      "inputs": [
        { "key": "type", "label": "Type", "type": "select", "required": true, "default": "selected", "options": [
          { "value": "selected", "label": "Selected events" }, { "value": "events", "label": "All events" }, { "value": "births", "label": "Births" },
          { "value": "deaths", "label": "Deaths" }, { "value": "holidays", "label": "Holidays" }, { "value": "all", "label": "Everything" }
        ] },
        { "key": "month", "label": "Month (MM)", "type": "string", "required": true, "placeholder": "07" },
        { "key": "day", "label": "Day (DD)", "type": "string", "required": true, "placeholder": "20" },
        { "key": "language", "label": "Wikipedia language", "type": "string", "required": true, "default": "en", "placeholder": "en" }
      ]
    }
  ]
}
