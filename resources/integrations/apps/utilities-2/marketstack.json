{
  "key": "marketstack",
  "name": "marketstack",
  "category": "Utilities",
  "description": "End-of-day stock prices for tickers on global exchanges.",
  "brand": "marketstack",
  "website": "https://marketstack.com",
  "docs_url": "https://marketstack.com/documentation_v2",
  "base_url": "https://api.marketstack.com/v2",
  "auth": { "type": "api_key", "in": "query", "name": "access_key", "fields": [
    { "key": "api_key", "label": "Access key", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "eod",
      "name": "Get end-of-day prices",
      "method": "GET",
      "endpoint": "/eod",
      "query": { "symbols": "{{ inputs.symbols }}", "date_from": "{{ inputs.date_from }}", "date_to": "{{ inputs.date_to }}", "sort": "{{ inputs.sort }}", "limit": "{{ inputs.limit }}" },
      "error_path": "error",
      "inputs": [
        { "key": "symbols", "label": "Symbols", "type": "string", "required": true, "placeholder": "AAPL,MSFT" },
        { "key": "date_from", "label": "From", "type": "string", "placeholder": "2025-01-01" },
        { "key": "date_to", "label": "To", "type": "string" },
        { "key": "sort", "label": "Sort", "type": "select", "options": [{ "value": "DESC", "label": "Newest first" }, { "value": "ASC", "label": "Oldest first" }] },
        { "key": "limit", "label": "Limit", "type": "number" }
      ]
    },
    {
      "key": "eod_latest",
      "name": "Get latest end-of-day prices",
      "method": "GET",
      "endpoint": "/eod/latest",
      "query": { "symbols": "{{ inputs.symbols }}" },
      "error_path": "error",
      "inputs": [{ "key": "symbols", "label": "Symbols", "type": "string", "required": true, "placeholder": "AAPL,MSFT" }]
    }
  ]
}
