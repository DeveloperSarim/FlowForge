{
  "key": "prepr",
  "name": "Prepr",
  "category": "CMS & Websites",
  "description": "Query Prepr CMS content with the GraphQL API.",
  "brand": "prepr",
  "website": "https://prepr.io",
  "docs_url": "https://docs.prepr.io/graphql-api",
  "base_url": "https://graphql.prepr.io",
  "auth": [
    {
      "type": "api_key",
      "fields": [
        {
          "key": "api_key",
          "label": "Access token",
          "type": "password",
          "required": true,
          "help": "Settings > Access tokens."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "graphql_query",
      "name": "Run GraphQL query",
      "description": "Runs a GraphQL query or mutation.",
      "method": "POST",
      "endpoint": "/{{ credentials.api_key }}",
      "body": {
        "query": "{{ inputs.query }}",
        "variables": "{{ inputs.variables }}"
      },
      "inputs": [
        {
          "key": "query",
          "label": "Query",
          "type": "code",
          "required": true,
          "placeholder": "query { ... }"
        },
        {
          "key": "variables",
          "label": "Variables",
          "type": "json"
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
