{
  "key": "typeform-to-sheets",
  "name": "Save Typeform responses to Google Sheets",
  "description": "Every new Typeform response becomes a row in your spreadsheet.",
  "category": "Forms",
  "featured": true,
  "graph": {
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger",
        "position": {
          "x": 0,
          "y": 200
        },
        "data": {
          "integration": "typeform",
          "trigger": "new_response_webhook",
          "label": "New response",
          "config": {}
        }
      },
      {
        "id": "step_1",
        "type": "action",
        "position": {
          "x": 240,
          "y": 200
        },
        "data": {
          "integration": "google_sheets",
          "action": "append_row",
          "label": "Append row",
          "config": {
            "spreadsheet_id": "",
            "range": "Sheet1",
            "values": [
              "{{ steps.trigger.data.submitted_at }}",
              "{{ steps.trigger.data.answers.0.text }}",
              "{{ steps.trigger.data.answers.1.email }}"
            ]
          }
        }
      }
    ],
    "edges": [
      {
        "id": "e-trigger-step_1",
        "source": "trigger",
        "target": "step_1",
        "sourceHandle": null
      }
    ]
  }
}