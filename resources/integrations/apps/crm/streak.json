{
  "key": "streak",
  "name": "Streak",
  "category": "CRM & Sales",
  "description": "Create and find boxes in your Streak pipelines.",
  "brand": "streak",
  "website": "https://www.streak.com",
  "docs_url": "https://streak.readme.io/",
  "base_url": "https://api.streak.com/api",
  "auth": [
    {
      "type": "basic",
      "fields": [
        {
          "key": "username",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Gmail > Streak > Integrations > Streak API."
        },
        {
          "key": "password",
          "label": "Password",
          "type": "password",
          "required": false,
          "default": "",
          "help": "Leave empty."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_pipelines",
      "name": "List pipelines",
      "method": "GET",
      "endpoint": "/v1/pipelines",
      "inputs": []
    },
    {
      "key": "create_box",
      "name": "Create box",
      "method": "POST",
      "endpoint": "/v2/pipelines/{{ inputs.pipeline_key }}/boxes",
      "body": {
        "name": "{{ inputs.name }}",
        "stageKey": "{{ inputs.stage_key }}",
        "notes": "{{ inputs.notes }}"
      },
      "inputs": [
        {
          "key": "pipeline_key",
          "label": "Pipeline key",
          "type": "string",
          "required": true
        },
        {
          "key": "name",
          "label": "Name",
          "type": "string",
          "required": true
        },
        {
          "key": "stage_key",
          "label": "Stage key",
          "type": "string"
        },
        {
          "key": "notes",
          "label": "Notes",
          "type": "text"
        }
      ]
    },
    {
      "key": "get_box",
      "name": "Get box",
      "method": "GET",
      "endpoint": "/v1/boxes/{{ inputs.box_key }}",
      "inputs": [
        {
          "key": "box_key",
          "label": "Box key",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "search",
      "name": "Search",
      "method": "GET",
      "endpoint": "/v1/search",
      "query": {
        "query": "{{ inputs.query }}"
      },
      "inputs": [
        {
          "key": "query",
          "label": "Query",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
