{
  "key": "yandex_translate",
  "name": "Yandex Translate",
  "category": "Utilities",
  "description": "Translate text and detect its language with Yandex Cloud Translate.",
  "brand": "yandex",
  "website": "https://yandex.cloud/en/services/translate",
  "docs_url": "https://yandex.cloud/en/docs/translate/api-ref/",
  "base_url": "https://translate.api.cloud.yandex.net/translate/v2",
  "auth": { "type": "api_key", "in": "header", "name": "Authorization", "prefix": "Api-Key ", "fields": [
    { "key": "api_key", "label": "Service account API key", "type": "password", "required": true, "help": "Create a service account with the ai.translate.user role, then an API key for it." }
  ] },
  "actions": [
    {
      "key": "translate",
      "name": "Translate text",
      "method": "POST",
      "endpoint": "/translate",
      "body": { "texts": "{{ inputs.texts }}", "targetLanguageCode": "{{ inputs.target_language }}", "sourceLanguageCode": "{{ inputs.source_language }}", "format": "{{ inputs.format }}" },
      "output_fields": { "text": "translations.*.text" },
      "inputs": [
        { "key": "texts", "label": "Texts", "type": "list", "required": true },
        { "key": "target_language", "label": "Target language", "type": "string", "required": true, "placeholder": "en" },
        { "key": "source_language", "label": "Source language", "type": "string", "help": "Leave empty to auto-detect." },
        { "key": "format", "label": "Format", "type": "select", "options": [{ "value": "PLAIN_TEXT", "label": "Plain text" }, { "value": "HTML", "label": "HTML" }] }
      ]
    },
    {
      "key": "detect_language",
      "name": "Detect language",
      "method": "POST",
      "endpoint": "/detect",
      "body": { "text": "{{ inputs.text }}", "languageCodeHints": "{{ inputs.hints }}" },
      "inputs": [
        { "key": "text", "label": "Text", "type": "text", "required": true },
        { "key": "hints", "label": "Likely languages", "type": "list" }
      ]
    }
  ]
}
