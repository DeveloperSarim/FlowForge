{
  "key": "bland_ai",
  "name": "Bland AI",
  "category": "AI",
  "description": "Send AI phone calls and get transcripts from Bland.",
  "brand": "bland",
  "website": "https://www.bland.ai",
  "docs_url": "https://docs.bland.ai/api-v1/post/calls",
  "base_url": "https://api.bland.ai/v1",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "authorization",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "send_call",
      "name": "Send call",
      "method": "POST",
      "endpoint": "/calls",
      "body": {
        "phone_number": "{{ inputs.phone_number }}",
        "task": "{{ inputs.task }}",
        "pathway_id": "{{ inputs.pathway_id }}",
        "first_sentence": "{{ inputs.first_sentence }}",
        "voice": "{{ inputs.voice }}",
        "from": "{{ inputs.from }}",
        "max_duration": "{{ inputs.max_duration }}",
        "webhook": "{{ inputs.webhook }}",
        "request_data": "{{ inputs.request_data }}"
      },
      "inputs": [
        {
          "key": "phone_number",
          "label": "Phone number",
          "type": "string",
          "required": true,
          "placeholder": "+14155550123"
        },
        {
          "key": "task",
          "label": "Task / prompt",
          "type": "text",
          "help": "What the agent should do. Use this or a pathway."
        },
        {
          "key": "pathway_id",
          "label": "Pathway ID",
          "type": "string"
        },
        {
          "key": "first_sentence",
          "label": "First sentence",
          "type": "string"
        },
        {
          "key": "voice",
          "label": "Voice",
          "type": "string"
        },
        {
          "key": "from",
          "label": "From number",
          "type": "string",
          "help": "A Bland number you own."
        },
        {
          "key": "max_duration",
          "label": "Max duration (minutes)",
          "type": "number"
        },
        {
          "key": "webhook",
          "label": "Webhook URL",
          "type": "string",
          "help": "Bland posts the call result here when the call ends."
        },
        {
          "key": "request_data",
          "label": "Variables",
          "type": "keyvalue"
        }
      ]
    },
    {
      "key": "get_call",
      "name": "Get call details",
      "method": "GET",
      "endpoint": "/calls/{{ inputs.call_id }}",
      "inputs": [
        {
          "key": "call_id",
          "label": "Call ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Call completed",
      "type": "webhook",
      "description": "Use this URL as the call's Webhook URL.",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
