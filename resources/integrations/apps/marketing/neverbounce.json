{
  "key": "neverbounce",
  "name": "NeverBounce",
  "category": "Marketing & Email",
  "description": "Verify single email addresses and check account credits.",
  "brand": "neverbounce",
  "website": "https://neverbounce.com",
  "docs_url": "https://developers.neverbounce.com/reference/",
  "base_url": "https://api.neverbounce.com/v4",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "verify",
      "name": "Verify email",
      "method": "GET",
      "endpoint": "/single/check",
      "query": {
        "email": "{{ inputs.email }}",
        "address_info": "{{ inputs.address_info }}"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "address_info",
          "label": "Include address info",
          "type": "boolean",
          "default": false
        }
      ]
    },
    {
      "key": "account_info",
      "name": "Get account info",
      "method": "GET",
      "endpoint": "/account/info",
      "inputs": []
    }
  ]
}
