{
  "key": "detectlanguage",
  "name": "Detect Language API",
  "category": "AI",
  "description": "Detect the language of any text, 216 languages supported.",
  "website": "https://detectlanguage.com",
  "docs_url": "https://detectlanguage.com/documentation",
  "base_url": "https://ws.detectlanguage.com/v3",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "detectlanguage.com → sign in → your API key is on the account page."
      }
    ]
  },
  "actions": [
    {
      "key": "detect",
      "name": "Detect language",
      "description": "Detect the language of a text.",
      "method": "POST",
      "endpoint": "/detect",
      "body": {
        "q": "{{ inputs.q }}"
      },
      "output_fields": {
        "language": "0.language",
        "score": "0.score",
        "candidates": "*.language"
      },
      "inputs": [
        {
          "key": "q",
          "label": "Text",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "key": "account_status",
      "name": "Get account status",
      "description": "See today's usage and plan limits.",
      "method": "GET",
      "endpoint": "/account/status",
      "output_fields": {
        "requests": "requests",
        "daily_requests_limit": "daily_requests_limit",
        "plan": "plan",
        "status": "status"
      },
      "inputs": []
    },
    {
      "key": "list_languages",
      "name": "List languages",
      "description": "List supported languages.",
      "method": "GET",
      "endpoint": "/languages",
      "output_fields": {
        "codes": "*.code"
      },
      "inputs": []
    }
  ]
}
