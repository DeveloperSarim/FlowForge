{
  "key": "kayako",
  "name": "Kayako",
  "category": "Customer Support",
  "description": "Call the Kayako REST API with your agent login.",
  "brand": "kayako",
  "website": "https://kayako.com",
  "docs_url": "https://developer.kayako.com/api/v1/reference/introduction/",
  "base_url": "https://{{ credentials.subdomain }}.kayako.com/api/v1",
  "auth": {
    "type": "basic",
    "fields": [
      {
        "key": "subdomain",
        "label": "Subdomain",
        "type": "string",
        "required": true,
        "placeholder": "yourcompany",
        "help": "The part before .kayako.com"
      },
      {
        "key": "username",
        "label": "Agent email",
        "type": "string",
        "required": true
      },
      {
        "key": "password",
        "label": "Password",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [],
  "triggers": []
}
