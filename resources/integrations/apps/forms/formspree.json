{
  "key": "formspree",
  "name": "Formspree",
  "category": "Forms & Surveys",
  "description": "Submit to a Formspree form and trigger on new submissions.",
  "brand": "formspree",
  "website": "https://formspree.io",
  "docs_url": "https://help.formspree.io/",
  "base_url": "https://formspree.io",
  "actions": [
    {
      "key": "submit_form",
      "name": "Submit form",
      "method": "POST",
      "endpoint": "/f/{{ inputs.form_id }}",
      "body": "{{ inputs.fields }}",
      "inputs": [
        {
          "key": "form_id",
          "label": "Form ID",
          "type": "string",
          "required": true,
          "help": "The id in your endpoint: formspree.io/f/<ID>"
        },
        {
          "key": "fields",
          "label": "Fields",
          "type": "keyvalue",
          "required": true,
          "help": "Include an 'email' field to set the reply-to address."
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "new_submission",
      "name": "New submission (webhook)",
      "type": "webhook",
      "description": "Form > Plugins > Webhook, paste this URL.",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
