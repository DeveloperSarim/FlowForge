{
  "key": "refersion",
  "name": "Refersion",
  "category": "Marketing & Email",
  "description": "Create, look up and list affiliates in Refersion.",
  "brand": "refersion",
  "website": "https://www.refersion.com",
  "docs_url": "https://www.refersion.dev/reference",
  "base_url": "https://api.refersion.com/v2",
  "headers": { "Refersion-Public-Key": "{{ credentials.api_key }}", "Refersion-Secret-Key": "{{ credentials.secret_key }}" },
  "auth": { "type": "api_key", "fields": [
    { "key": "api_key", "label": "Public key", "type": "password", "required": true, "help": "Account > Settings > Refersion API." },
    { "key": "secret_key", "label": "Secret key", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "create_affiliate",
      "name": "Create affiliate",
      "method": "POST",
      "endpoint": "/affiliate/new",
      "body": {
        "first_name": "{{ inputs.first_name }}",
        "last_name": "{{ inputs.last_name }}",
        "email": "{{ inputs.email }}",
        "company": "{{ inputs.company }}",
        "offer_id": "{{ inputs.offer_id }}"
      },
      "inputs": [
        { "key": "first_name", "label": "First name", "type": "string", "required": true },
        { "key": "last_name", "label": "Last name", "type": "string", "required": true },
        { "key": "email", "label": "Email", "type": "string", "required": true },
        { "key": "company", "label": "Company", "type": "string" },
        { "key": "offer_id", "label": "Offer ID", "type": "string", "help": "Empty = your default offer." }
      ]
    },
    {
      "key": "get_affiliate",
      "name": "Get affiliate",
      "method": "POST",
      "endpoint": "/affiliate/get",
      "body": { "id": "{{ inputs.affiliate_id }}" },
      "inputs": [{ "key": "affiliate_id", "label": "Affiliate ID", "type": "string", "required": true }]
    },
    {
      "key": "list_affiliates",
      "name": "List affiliates",
      "method": "POST",
      "endpoint": "/affiliate/list",
      "body": { "page": "{{ inputs.page }}", "limit": "{{ inputs.limit }}" },
      "inputs": [
        { "key": "page", "label": "Page", "type": "number", "default": 1 },
        { "key": "limit", "label": "Limit (max 100)", "type": "number", "default": 100 }
      ]
    }
  ]
}
