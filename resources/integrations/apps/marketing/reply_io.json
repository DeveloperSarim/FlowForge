{
  "key": "reply_io",
  "name": "Reply.io",
  "category": "Marketing & Email",
  "description": "Add contacts, push them to sequences and remove them.",
  "brand": "replyio",
  "website": "https://reply.io",
  "docs_url": "https://apidocs.reply.io/",
  "base_url": "https://api.reply.io/v1",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "X-Api-Key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "create_contact",
      "name": "Create or update contact",
      "method": "POST",
      "endpoint": "/people",
      "body": {
        "email": "{{ inputs.email }}",
        "firstName": "{{ inputs.first_name }}",
        "lastName": "{{ inputs.last_name }}",
        "company": "{{ inputs.company }}",
        "title": "{{ inputs.title }}"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "first_name",
          "label": "First name",
          "type": "string",
          "required": true
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "company",
          "label": "Company",
          "type": "string"
        },
        {
          "key": "title",
          "label": "Title",
          "type": "string"
        }
      ]
    },
    {
      "key": "push_to_sequence",
      "name": "Add contact to sequence",
      "description": "Creates/updates the contact and pushes it into a sequence.",
      "method": "POST",
      "endpoint": "/actions/addandpushtocampaign",
      "body": {
        "campaignId": "{{ inputs.campaign_id }}",
        "email": "{{ inputs.email }}",
        "firstName": "{{ inputs.first_name }}",
        "lastName": "{{ inputs.last_name }}",
        "company": "{{ inputs.company }}"
      },
      "inputs": [
        {
          "key": "campaign_id",
          "label": "Sequence (campaign) ID",
          "type": "number",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "first_name",
          "label": "First name",
          "type": "string",
          "required": true
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "company",
          "label": "Company",
          "type": "string"
        }
      ]
    },
    {
      "key": "remove_from_all",
      "name": "Remove contact from all sequences",
      "method": "POST",
      "endpoint": "/actions/removepersonfromallcampaigns",
      "body": {
        "email": "{{ inputs.email }}"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_campaigns",
      "name": "List sequences",
      "method": "GET",
      "endpoint": "/campaigns",
      "inputs": []
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "description": "Settings → Webhooks (email_replied, contact_finished…).",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
