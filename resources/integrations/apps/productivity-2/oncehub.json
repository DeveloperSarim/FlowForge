{
  "key": "oncehub",
  "name": "OnceHub",
  "category": "Productivity",
  "description": "Look up OnceHub bookings, booking calendars and users.",
  "brand": "oncehub",
  "website": "https://www.oncehub.com",
  "docs_url": "https://help.oncehub.com/developers/api/",
  "base_url": "https://api.oncehub.com/v2",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "API-Key",
      "fields": [
        {
          "key": "api_key",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Profile > API & Webhooks integration."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_bookings",
      "name": "List bookings",
      "method": "GET",
      "endpoint": "/bookings",
      "inputs": []
    },
    {
      "key": "get_booking",
      "name": "Get booking",
      "method": "GET",
      "endpoint": "/bookings/{{ inputs.booking_id }}",
      "inputs": [
        {
          "key": "booking_id",
          "label": "Booking ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_booking_calendars",
      "name": "List booking calendars",
      "method": "GET",
      "endpoint": "/booking-calendars",
      "inputs": []
    },
    {
      "key": "list_users",
      "name": "List users",
      "method": "GET",
      "endpoint": "/users",
      "inputs": []
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Booking event (webhook)",
      "type": "webhook",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
