{
  "key": "knock",
  "name": "Knock",
  "category": "Communication",
  "description": "Trigger Knock notification workflows and identify users.",
  "brand": "knock",
  "website": "https://knock.app",
  "docs_url": "https://docs.knock.app/reference",
  "base_url": "https://api.knock.app/v1",
  "auth": [
    { "type": "bearer", "fields": [{ "key": "token", "label": "Secret API key (sk_…)", "type": "password", "required": true }] }
  ],
  "actions": [
    {
      "key": "trigger_workflow",
      "name": "Trigger workflow",
      "method": "POST",
      "endpoint": "/workflows/{{ inputs.workflow_key }}/trigger",
      "body": { "recipients": "{{ inputs.recipients }}", "actor": "{{ inputs.actor }}", "data": "{{ inputs.data }}", "tenant": "{{ inputs.tenant }}" },
      "inputs": [
        { "key": "workflow_key", "label": "Workflow key", "type": "string", "required": true },
        { "key": "recipients", "label": "Recipient user IDs", "type": "list", "required": true },
        { "key": "actor", "label": "Actor user ID", "type": "string" },
        { "key": "data", "label": "Data (JSON)", "type": "json" },
        { "key": "tenant", "label": "Tenant ID", "type": "string" }
      ]
    },
    {
      "key": "identify_user",
      "name": "Identify (upsert) user",
      "method": "PUT",
      "endpoint": "/users/{{ inputs.user_id }}",
      "body": { "name": "{{ inputs.name }}", "email": "{{ inputs.email }}", "phone_number": "{{ inputs.phone_number }}" },
      "inputs": [
        { "key": "user_id", "label": "User ID", "type": "string", "required": true },
        { "key": "name", "label": "Name", "type": "string" },
        { "key": "email", "label": "Email", "type": "string" },
        { "key": "phone_number", "label": "Phone (E.164)", "type": "string" }
      ]
    },
    {
      "key": "get_user",
      "name": "Get user",
      "method": "GET",
      "endpoint": "/users/{{ inputs.user_id }}",
      "inputs": [{ "key": "user_id", "label": "User ID", "type": "string", "required": true }]
    }
  ]
}
