{
  "key": "convex",
  "name": "Convex",
  "category": "Databases",
  "description": "Call Convex query, mutation and action functions over the HTTP API.",
  "brand": "convex",
  "website": "https://www.convex.dev",
  "docs_url": "https://docs.convex.dev/http-api/",
  "base_url": "{{ credentials.api_key }}/api",
  "auth": [
    { "type": "api_key", "fields": [
      { "key": "api_key", "label": "Deployment URL", "type": "string", "required": true, "placeholder": "https://happy-otter-123.convex.cloud", "help": "Public functions need only this. To call as a signed-in user, pick the Access token method." }
    ] },
    { "type": "bearer", "fields": [
      { "key": "api_key", "label": "Deployment URL", "type": "string", "required": true, "placeholder": "https://happy-otter-123.convex.cloud" },
      { "key": "token", "label": "User auth token (JWT)", "type": "password", "required": true, "help": "For functions that check ctx.auth." }
    ] }
  ],
  "actions": [
    {
      "key": "run_query",
      "name": "Run query",
      "method": "POST",
      "endpoint": "/query",
      "headers": { "Content-Type": "application/json" },
      "body": "{\"path\": \"{{ inputs.path }}\", \"args\": {{ inputs.args }}, \"format\": \"json\"}",
      "error_path": "errorMessage",
      "output_path": "value",
      "inputs": [
        { "key": "path", "label": "Function", "type": "string", "required": true, "placeholder": "messages:list" },
        { "key": "args", "label": "Arguments (JSON object)", "type": "code", "required": true, "default": "{}", "help": "Must be a JSON object; {} for none." }
      ]
    },
    {
      "key": "run_mutation",
      "name": "Run mutation",
      "method": "POST",
      "endpoint": "/mutation",
      "headers": { "Content-Type": "application/json" },
      "body": "{\"path\": \"{{ inputs.path }}\", \"args\": {{ inputs.args }}, \"format\": \"json\"}",
      "error_path": "errorMessage",
      "output_path": "value",
      "inputs": [
        { "key": "path", "label": "Function", "type": "string", "required": true, "placeholder": "messages:send" },
        { "key": "args", "label": "Arguments (JSON object)", "type": "code", "required": true, "default": "{}", "help": "Must be a JSON object; {} for none." }
      ]
    },
    {
      "key": "run_action",
      "name": "Run action",
      "method": "POST",
      "endpoint": "/action",
      "timeout": 120,
      "headers": { "Content-Type": "application/json" },
      "body": "{\"path\": \"{{ inputs.path }}\", \"args\": {{ inputs.args }}, \"format\": \"json\"}",
      "error_path": "errorMessage",
      "output_path": "value",
      "inputs": [
        { "key": "path", "label": "Function", "type": "string", "required": true, "placeholder": "emails:sendWelcome" },
        { "key": "args", "label": "Arguments (JSON object)", "type": "code", "required": true, "default": "{}", "help": "Must be a JSON object; {} for none." }
      ]
    }
  ]
}
