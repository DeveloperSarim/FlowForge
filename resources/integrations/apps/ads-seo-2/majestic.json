{
  "key": "majestic",
  "name": "Majestic",
  "category": "Ads & SEO",
  "description": "Backlink data: Trust Flow, Citation Flow, backlinks and referring domains.",
  "website": "https://majestic.com",
  "docs_url": "https://developer-support.majestic.com/api/",
  "base_url": "https://api.majestic.com",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "app_api_key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Majestic → Account → API → copy your API key."
      }
    ]
  },
  "actions": [
    {
      "key": "index_item_info",
      "name": "Get domain metrics",
      "description": "Trust Flow, Citation Flow, backlink and referring-domain counts.",
      "method": "GET",
      "endpoint": "/api/json",
      "query": {
        "cmd": "GetIndexItemInfo",
        "items": "1",
        "item0": "{{ inputs.domain }}",
        "datasource": "fresh"
      },
      "output_fields": {
        "status": "Code",
        "trust_flow": "DataTables.Results.Data.0.TrustFlow",
        "citation_flow": "DataTables.Results.Data.0.CitationFlow",
        "backlinks": "DataTables.Results.Data.0.ExtBackLinks",
        "referring_domains": "DataTables.Results.Data.0.RefDomains"
      },
      "inputs": [
        {
          "key": "domain",
          "label": "Domain or URL",
          "type": "string",
          "required": true,
          "placeholder": "example.com"
        }
      ]
    },
    {
      "key": "backlinks",
      "name": "Get backlinks",
      "description": "Top backlinks pointing at a domain or URL.",
      "method": "GET",
      "endpoint": "/api/json",
      "query": {
        "cmd": "GetBackLinkData",
        "items": "1",
        "item0": "{{ inputs.domain }}",
        "datasource": "fresh",
        "Count": "{{ inputs.count }}",
        "Mode": "0"
      },
      "output_fields": {
        "status": "Code",
        "backlinks": "DataTables.BackLinks.Data"
      },
      "inputs": [
        {
          "key": "domain",
          "label": "Domain or URL",
          "type": "string",
          "required": true,
          "placeholder": "example.com"
        },
        {
          "key": "count",
          "label": "How many",
          "type": "number",
          "default": 50
        }
      ]
    },
    {
      "key": "referring_domains",
      "name": "Get referring domains",
      "description": "Domains that link to the target.",
      "method": "GET",
      "endpoint": "/api/json",
      "query": {
        "cmd": "GetRefDomains",
        "items": "1",
        "item0": "{{ inputs.domain }}",
        "datasource": "fresh",
        "Count": "{{ inputs.count }}"
      },
      "output_fields": {
        "status": "Code",
        "domains": "DataTables.Results.Data"
      },
      "inputs": [
        {
          "key": "domain",
          "label": "Domain or URL",
          "type": "string",
          "required": true,
          "placeholder": "example.com"
        },
        {
          "key": "count",
          "label": "How many",
          "type": "number",
          "default": 50
        }
      ]
    }
  ]
}
