{
  "key": "recraft",
  "name": "Recraft",
  "category": "AI",
  "description": "Generate raster and vector images with Recraft models.",
  "brand": "recraft",
  "website": "https://www.recraft.ai",
  "docs_url": "https://www.recraft.ai/docs/api-reference/endpoints",
  "base_url": "https://external.api.recraft.ai/v1",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API token",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "generate_image",
      "name": "Generate image",
      "method": "POST",
      "endpoint": "/images/generations",
      "timeout": 300,
      "body": {
        "prompt": "{{ inputs.prompt }}",
        "model": "{{ inputs.model }}",
        "style": "{{ inputs.style }}",
        "size": "{{ inputs.size }}",
        "n": "{{ inputs.n }}"
      },
      "output_fields": {
        "url": "data.0.url"
      },
      "inputs": [
        {
          "key": "prompt",
          "label": "Prompt",
          "type": "text",
          "required": true
        },
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "placeholder": "recraftv4_1",
          "help": "Defaults to Recraft's latest model."
        },
        {
          "key": "style",
          "label": "Style",
          "type": "string",
          "placeholder": "realistic_image"
        },
        {
          "key": "size",
          "label": "Size",
          "type": "string",
          "placeholder": "1024x1024"
        },
        {
          "key": "n",
          "label": "Number of images",
          "type": "number"
        }
      ]
    },
    {
      "key": "get_account",
      "name": "Get account",
      "description": "Returns your credit balance.",
      "method": "GET",
      "endpoint": "/users/me",
      "inputs": []
    }
  ]
}
