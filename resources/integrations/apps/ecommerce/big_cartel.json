{
  "key": "big_cartel",
  "name": "Big Cartel",
  "category": "E-commerce",
  "description": "Read orders and products from your Big Cartel store.",
  "brand": "bigcartel",
  "website": "https://www.bigcartel.com",
  "docs_url": "https://developers.bigcartel.com/api/v1",
  "base_url": "https://api.bigcartel.com/v1/accounts/{{ credentials.account_id }}",
  "headers": {
    "Accept": "application/vnd.api+json",
    "Content-Type": "application/vnd.api+json",
    "User-Agent": "FlowForge/1.0 (https://{{ credentials.username }}.bigcartel.com)"
  },
  "auth": [
    {
      "type": "basic",
      "fields": [
        {
          "key": "username",
          "label": "Store subdomain",
          "type": "string",
          "required": true,
          "placeholder": "mystore",
          "help": "The part before .bigcartel.com."
        },
        {
          "key": "password",
          "label": "Store admin password",
          "type": "password",
          "required": true
        },
        {
          "key": "account_id",
          "label": "Account ID",
          "type": "string",
          "required": true,
          "help": "Find it by calling GET https://api.bigcartel.com/v1/accounts with these credentials."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_orders",
      "name": "List orders",
      "method": "GET",
      "endpoint": "/orders",
      "output_path": "data",
      "inputs": []
    },
    {
      "key": "get_order",
      "name": "Get order",
      "method": "GET",
      "endpoint": "/orders/{{ inputs.order_id }}",
      "output_path": "data",
      "inputs": [
        {
          "key": "order_id",
          "label": "Order ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_products",
      "name": "List products",
      "method": "GET",
      "endpoint": "/products",
      "output_path": "data",
      "inputs": []
    }
  ],
  "triggers": []
}
