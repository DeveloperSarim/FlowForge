{
  "key": "fly_io",
  "name": "Fly.io",
  "category": "Developer Tools",
  "description": "List, start, stop and restart Fly Machines.",
  "brand": "flydotio",
  "website": "https://fly.io",
  "docs_url": "https://fly.io/docs/machines/api/",
  "base_url": "https://api.machines.dev/v1",
  "auth": { "type": "api_key", "in": "header", "name": "Authorization", "fields": [
    { "key": "api_key", "label": "Token (full Authorization value)", "type": "password", "required": true,
      "help": "Paste the token exactly as printed by fly tokens create (it starts with \"FlyV1 \"). For an older personal token, enter \"Bearer <token>\"." }
  ] },
  "actions": [
    {
      "key": "list_machines",
      "name": "List machines",
      "method": "GET",
      "endpoint": "/apps/{{ inputs.app }}/machines",
      "inputs": [{ "key": "app", "label": "App name", "type": "string", "required": true }]
    },
    {
      "key": "get_machine",
      "name": "Get machine",
      "method": "GET",
      "endpoint": "/apps/{{ inputs.app }}/machines/{{ inputs.machine_id }}",
      "inputs": [
        { "key": "app", "label": "App name", "type": "string", "required": true },
        { "key": "machine_id", "label": "Machine ID", "type": "string", "required": true }
      ]
    },
    {
      "key": "machine_action",
      "name": "Start / stop / restart machine",
      "method": "POST",
      "endpoint": "/apps/{{ inputs.app }}/machines/{{ inputs.machine_id }}/{{ inputs.action }}",
      "inputs": [
        { "key": "app", "label": "App name", "type": "string", "required": true },
        { "key": "machine_id", "label": "Machine ID", "type": "string", "required": true },
        { "key": "action", "label": "Action", "type": "select", "required": true, "default": "restart", "options": [
          { "value": "start", "label": "Start" }, { "value": "stop", "label": "Stop" }, { "value": "restart", "label": "Restart" }, { "value": "suspend", "label": "Suspend" }
        ] }
      ]
    }
  ]
}
