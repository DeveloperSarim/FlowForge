{
  "key": "recruiterflow",
  "name": "Recruiterflow",
  "category": "HR & Recruiting",
  "description": "Read jobs and candidates from the Recruiterflow recruiting CRM.",
  "website": "https://recruiterflow.com",
  "docs_url": "https://recruiterflow.com/api",
  "base_url": "https://recruiterflow.com/api/external",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "RF-Api-Key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "In Recruiterflow open Settings → Integrations → API → generate a key and copy it."
      }
    ]
  },
  "actions": [
    {
      "key": "list_jobs",
      "name": "List jobs",
      "description": "List jobs.",
      "method": "GET",
      "endpoint": "/job/list",
      "query": {
        "current_page": "{{ inputs.current_page }}",
        "items_per_page": 50
      },
      "output_fields": {
        "jobs": "data",
        "first_id": "data.0.id",
        "first_name": "data.0.name"
      },
      "inputs": [
        {
          "key": "current_page",
          "label": "Page",
          "type": "number",
          "default": 1
        }
      ]
    },
    {
      "key": "get_job",
      "name": "Get job",
      "description": "Read one job.",
      "method": "GET",
      "endpoint": "/job/details",
      "query": {
        "id": "{{ inputs.id }}"
      },
      "output_fields": {
        "name": "data.name",
        "status": "data.status"
      },
      "inputs": [
        {
          "key": "id",
          "label": "Job ID",
          "type": "number",
          "required": true
        }
      ]
    },
    {
      "key": "list_candidates",
      "name": "List candidates",
      "description": "List candidates.",
      "method": "GET",
      "endpoint": "/candidate/list",
      "query": {
        "current_page": "{{ inputs.current_page }}",
        "items_per_page": 50
      },
      "output_fields": {
        "candidates": "data",
        "first_id": "data.0.id",
        "first_name": "data.0.name"
      },
      "inputs": [
        {
          "key": "current_page",
          "label": "Page",
          "type": "number",
          "default": 1
        }
      ]
    },
    {
      "key": "get_candidate",
      "name": "Get candidate",
      "description": "Read one candidate.",
      "method": "GET",
      "endpoint": "/candidate/details",
      "query": {
        "id": "{{ inputs.id }}"
      },
      "output_fields": {
        "name": "data.name",
        "email": "data.email"
      },
      "inputs": [
        {
          "key": "id",
          "label": "Candidate ID",
          "type": "number",
          "required": true
        }
      ]
    }
  ]
}
