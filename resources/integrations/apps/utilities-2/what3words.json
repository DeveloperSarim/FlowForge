{
  "key": "what3words",
  "name": "what3words",
  "category": "Utilities",
  "description": "Convert between ///three.word.addresses and coordinates, with autosuggest.",
  "brand": "what3words",
  "website": "https://what3words.com",
  "docs_url": "https://developer.what3words.com/public-api/docs",
  "base_url": "https://api.what3words.com/v3",
  "auth": { "type": "api_key", "in": "header", "name": "X-Api-Key", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "convert_to_coordinates",
      "name": "3 words to coordinates",
      "method": "GET",
      "endpoint": "/convert-to-coordinates",
      "query": { "words": "{{ inputs.words }}" },
      "inputs": [{ "key": "words", "label": "what3words address", "type": "string", "required": true, "placeholder": "filled.count.soap" }]
    },
    {
      "key": "convert_to_3wa",
      "name": "Coordinates to 3 words",
      "method": "GET",
      "endpoint": "/convert-to-3wa",
      "query": { "coordinates": "{{ inputs.coordinates }}", "language": "{{ inputs.language }}" },
      "inputs": [
        { "key": "coordinates", "label": "Coordinates (lat,lng)", "type": "string", "required": true, "placeholder": "51.520847,-0.195521" },
        { "key": "language", "label": "Language", "type": "string", "placeholder": "en" }
      ]
    },
    {
      "key": "autosuggest",
      "name": "Autosuggest",
      "description": "Suggest valid 3 word addresses for partial or mistyped input.",
      "method": "GET",
      "endpoint": "/autosuggest",
      "query": { "input": "{{ inputs.input }}", "focus": "{{ inputs.focus }}", "clip-to-country": "{{ inputs.clip_to_country }}", "n-results": "{{ inputs.n_results }}" },
      "inputs": [
        { "key": "input", "label": "Input", "type": "string", "required": true, "placeholder": "filled.count.so" },
        { "key": "focus", "label": "Focus (lat,lng)", "type": "string" },
        { "key": "clip_to_country", "label": "Only these countries", "type": "string", "placeholder": "GB,US" },
        { "key": "n_results", "label": "Number of results", "type": "number" }
      ]
    },
    {
      "key": "available_languages",
      "name": "List languages",
      "method": "GET",
      "endpoint": "/available-languages",
      "inputs": []
    }
  ]
}
