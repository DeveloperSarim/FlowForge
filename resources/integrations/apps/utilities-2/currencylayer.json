{
  "key": "currencylayer",
  "name": "currencylayer",
  "category": "Utilities",
  "description": "Live and historical exchange rates and currency conversion.",
  "brand": "currencylayer",
  "website": "https://currencylayer.com",
  "docs_url": "https://currencylayer.com/documentation",
  "base_url": "https://api.currencylayer.com",
  "auth": { "type": "api_key", "in": "query", "name": "access_key", "fields": [
    { "key": "api_key", "label": "Access key", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "live",
      "name": "Get live rates",
      "method": "GET",
      "endpoint": "/live",
      "query": { "source": "{{ inputs.source }}", "currencies": "{{ inputs.currencies }}" },
      "error_path": "error",
      "inputs": [
        { "key": "source", "label": "Source currency", "type": "string", "placeholder": "USD", "help": "Changing the source needs a paid plan." },
        { "key": "currencies", "label": "Only these currencies", "type": "string", "placeholder": "EUR,GBP" }
      ]
    },
    {
      "key": "historical",
      "name": "Get rates on a date",
      "method": "GET",
      "endpoint": "/historical",
      "query": { "date": "{{ inputs.date }}", "source": "{{ inputs.source }}", "currencies": "{{ inputs.currencies }}" },
      "error_path": "error",
      "inputs": [
        { "key": "date", "label": "Date", "type": "string", "required": true, "placeholder": "2025-01-31" },
        { "key": "source", "label": "Source currency", "type": "string" },
        { "key": "currencies", "label": "Only these currencies", "type": "string" }
      ]
    },
    {
      "key": "convert",
      "name": "Convert currency",
      "method": "GET",
      "endpoint": "/convert",
      "query": { "from": "{{ inputs.from }}", "to": "{{ inputs.to }}", "amount": "{{ inputs.amount }}", "date": "{{ inputs.date }}" },
      "error_path": "error",
      "inputs": [
        { "key": "from", "label": "From", "type": "string", "required": true },
        { "key": "to", "label": "To", "type": "string", "required": true },
        { "key": "amount", "label": "Amount", "type": "number", "required": true },
        { "key": "date", "label": "Historical date", "type": "string" }
      ]
    },
    {
      "key": "timeframe",
      "name": "Get rates for a period",
      "method": "GET",
      "endpoint": "/timeframe",
      "query": { "start_date": "{{ inputs.start_date }}", "end_date": "{{ inputs.end_date }}", "source": "{{ inputs.source }}", "currencies": "{{ inputs.currencies }}" },
      "error_path": "error",
      "inputs": [
        { "key": "start_date", "label": "Start date", "type": "string", "required": true },
        { "key": "end_date", "label": "End date", "type": "string", "required": true },
        { "key": "source", "label": "Source currency", "type": "string" },
        { "key": "currencies", "label": "Only these currencies", "type": "string" }
      ]
    },
    {
      "key": "list",
      "name": "List currencies",
      "method": "GET",
      "endpoint": "/list",
      "error_path": "error",
      "inputs": []
    }
  ]
}
