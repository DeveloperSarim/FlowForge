{
  "key": "moonshot_kimi",
  "name": "Kimi (Moonshot AI)",
  "category": "AI",
  "description": "Chat with Kimi models from Moonshot AI.",
  "brand": "moonshot",
  "website": "https://www.moonshot.ai",
  "docs_url": "https://platform.kimi.ai/docs/api/chat",
  "base_url": "https://{{ credentials.host }}/v1",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "host",
        "label": "Platform",
        "type": "select",
        "required": true,
        "default": "api.moonshot.ai",
        "options": [
          {
            "value": "api.moonshot.ai",
            "label": "Global (platform.kimi.ai)"
          },
          {
            "value": "api.moonshot.cn",
            "label": "China (platform.moonshot.cn)"
          }
        ]
      },
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "chat_completion",
      "name": "Chat completion",
      "description": "Send a prompt and get the reply as {{ steps.<id>.text }}.",
      "method": "POST",
      "endpoint": "/chat/completions",
      "timeout": 300,
      "body": {
        "model": "{{ inputs.model }}",
        "messages": [
          {
            "role": "system",
            "content": "{{ inputs.system }}"
          },
          {
            "role": "user",
            "content": "{{ inputs.prompt }}"
          }
        ],
        "temperature": "{{ inputs.temperature }}",
        "max_completion_tokens": "{{ inputs.max_tokens }}"
      },
      "output_fields": {
        "text": "choices.0.message.content"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "default": "kimi-k3"
        },
        {
          "key": "prompt",
          "label": "Prompt",
          "type": "text",
          "required": true
        },
        {
          "key": "system",
          "label": "System prompt",
          "type": "text",
          "required": true,
          "default": "You are a helpful assistant.",
          "help": "Sent as the system message."
        },
        {
          "key": "temperature",
          "label": "Temperature",
          "type": "number",
          "placeholder": "0.7"
        },
        {
          "key": "max_tokens",
          "label": "Max output tokens",
          "type": "number"
        }
      ]
    },
    {
      "key": "list_models",
      "name": "List models",
      "method": "GET",
      "endpoint": "/models",
      "inputs": []
    }
  ]
}
