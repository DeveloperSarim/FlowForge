{
  "key": "postman",
  "name": "Postman",
  "category": "Developer Tools",
  "description": "Read workspaces, collections and environments, and run monitors.",
  "brand": "postman",
  "website": "https://www.postman.com",
  "docs_url": "https://learning.postman.com/docs/developer/postman-api/intro-api/",
  "base_url": "https://api.getpostman.com",
  "auth": { "type": "api_key", "in": "header", "name": "X-Api-Key", "fields": [{ "key": "api_key", "label": "Postman API key", "type": "password", "required": true, "help": "Settings → API keys." }] },
  "actions": [
    {
      "key": "list_workspaces",
      "name": "List workspaces",
      "method": "GET",
      "endpoint": "/workspaces",
      "output_path": "workspaces",
      "inputs": []
    },
    {
      "key": "list_collections",
      "name": "List collections",
      "method": "GET",
      "endpoint": "/collections",
      "query": { "workspace": "{{ inputs.workspace_id }}" },
      "output_path": "collections",
      "inputs": [{ "key": "workspace_id", "label": "Workspace ID", "type": "string" }]
    },
    {
      "key": "get_collection",
      "name": "Get collection",
      "method": "GET",
      "endpoint": "/collections/{{ inputs.collection_id }}",
      "output_path": "collection",
      "inputs": [{ "key": "collection_id", "label": "Collection ID or UID", "type": "string", "required": true }]
    },
    {
      "key": "list_environments",
      "name": "List environments",
      "method": "GET",
      "endpoint": "/environments",
      "query": { "workspace": "{{ inputs.workspace_id }}" },
      "output_path": "environments",
      "inputs": [{ "key": "workspace_id", "label": "Workspace ID", "type": "string" }]
    },
    {
      "key": "get_environment",
      "name": "Get environment",
      "method": "GET",
      "endpoint": "/environments/{{ inputs.environment_id }}",
      "output_path": "environment",
      "inputs": [{ "key": "environment_id", "label": "Environment ID or UID", "type": "string", "required": true }]
    },
    {
      "key": "run_monitor",
      "name": "Run monitor",
      "description": "Runs a monitor now and returns its results.",
      "method": "POST",
      "endpoint": "/monitors/{{ inputs.monitor_id }}/run",
      "timeout": 300,
      "inputs": [{ "key": "monitor_id", "label": "Monitor ID or UID", "type": "string", "required": true }]
    }
  ]
}
