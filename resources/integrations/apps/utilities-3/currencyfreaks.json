{
  "key": "currencyfreaks",
  "name": "CurrencyFreaks",
  "category": "Utilities",
  "description": "Latest and historical exchange rates, conversions and fluctuation reports.",
  "website": "https://currencyfreaks.com",
  "docs_url": "https://currencyfreaks.com/documentation.html",
  "base_url": "https://api.currencyfreaks.com/v2.0",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "apikey",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "currencyfreaks.com → Dashboard → API key."
      }
    ]
  },
  "actions": [
    {
      "key": "latest_rates",
      "name": "Latest exchange rates",
      "description": "Current rates from the base currency.",
      "method": "GET",
      "endpoint": "/rates/latest",
      "query": {
        "base": "{{ inputs.base }}",
        "symbols": "{{ inputs.symbols }}"
      },
      "output_fields": {
        "date": "date",
        "base": "base",
        "rates": "rates"
      },
      "inputs": [
        {
          "key": "base",
          "label": "Base currency",
          "type": "string",
          "default": "USD"
        },
        {
          "key": "symbols",
          "label": "Only these currencies",
          "type": "string",
          "placeholder": "EUR,GBP,PKR"
        }
      ]
    },
    {
      "key": "historical_rates",
      "name": "Historical exchange rates",
      "description": "Rates on a past date.",
      "method": "GET",
      "endpoint": "/rates/historical",
      "query": {
        "date": "{{ inputs.date }}",
        "base": "{{ inputs.base }}",
        "symbols": "{{ inputs.symbols }}"
      },
      "output_fields": {
        "date": "date",
        "rates": "rates"
      },
      "inputs": [
        {
          "key": "date",
          "label": "Date (YYYY-MM-DD)",
          "type": "string",
          "required": true
        },
        {
          "key": "base",
          "label": "Base currency",
          "type": "string",
          "default": "USD"
        },
        {
          "key": "symbols",
          "label": "Only these currencies",
          "type": "string"
        }
      ]
    },
    {
      "key": "convert",
      "name": "Convert amount",
      "description": "Convert an amount at today's rate (paid plans).",
      "method": "GET",
      "endpoint": "/convert/latest",
      "query": {
        "from": "{{ inputs.from }}",
        "to": "{{ inputs.to }}",
        "amount": "{{ inputs.amount }}"
      },
      "output_fields": {
        "converted_amount": "convertedAmount",
        "rate": "rate"
      },
      "inputs": [
        {
          "key": "from",
          "label": "From currency",
          "type": "string",
          "required": true,
          "default": "USD"
        },
        {
          "key": "to",
          "label": "To currency",
          "type": "string",
          "required": true,
          "placeholder": "EUR"
        },
        {
          "key": "amount",
          "label": "Amount",
          "type": "number",
          "required": true
        }
      ]
    },
    {
      "key": "convert_historical",
      "name": "Convert amount on a past date",
      "description": "Convert an amount at a historical rate (paid plans).",
      "method": "GET",
      "endpoint": "/convert/historical",
      "query": {
        "date": "{{ inputs.date }}",
        "from": "{{ inputs.from }}",
        "to": "{{ inputs.to }}",
        "amount": "{{ inputs.amount }}"
      },
      "output_fields": {
        "converted_amount": "convertedAmount",
        "rate": "rate"
      },
      "inputs": [
        {
          "key": "date",
          "label": "Date (YYYY-MM-DD)",
          "type": "string",
          "required": true
        },
        {
          "key": "from",
          "label": "From currency",
          "type": "string",
          "required": true,
          "default": "USD"
        },
        {
          "key": "to",
          "label": "To currency",
          "type": "string",
          "required": true
        },
        {
          "key": "amount",
          "label": "Amount",
          "type": "number",
          "required": true
        }
      ]
    },
    {
      "key": "fluctuation",
      "name": "Rate fluctuation",
      "description": "How much currencies changed between two dates.",
      "method": "GET",
      "endpoint": "/fluctuation",
      "query": {
        "startDate": "{{ inputs.start_date }}",
        "endDate": "{{ inputs.end_date }}",
        "base": "{{ inputs.base }}",
        "symbols": "{{ inputs.symbols }}"
      },
      "inputs": [
        {
          "key": "start_date",
          "label": "Start date (YYYY-MM-DD)",
          "type": "string",
          "required": true
        },
        {
          "key": "end_date",
          "label": "End date (YYYY-MM-DD)",
          "type": "string",
          "required": true
        },
        {
          "key": "base",
          "label": "Base currency",
          "type": "string",
          "default": "USD"
        },
        {
          "key": "symbols",
          "label": "Currencies",
          "type": "string",
          "placeholder": "EUR,GBP"
        }
      ]
    }
  ]
}
