{
  "key": "htmlcsstoimage",
  "name": "HTML/CSS to Image",
  "category": "Files & Documents",
  "description": "Render HTML/CSS or a web page into a PNG/JPG image URL.",
  "brand": "htmlcsstoimage",
  "website": "https://htmlcsstoimage.com",
  "docs_url": "https://docs.htmlcsstoimage.com/",
  "base_url": "https://hcti.io/v1",
  "auth": [
    {
      "type": "basic",
      "fields": [
        {
          "key": "username",
          "label": "User ID",
          "type": "string",
          "required": true
        },
        {
          "key": "password",
          "label": "API key",
          "type": "password",
          "required": true
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "create_image",
      "name": "Create image",
      "method": "POST",
      "endpoint": "/image",
      "body": {
        "html": "{{ inputs.html }}",
        "css": "{{ inputs.css }}",
        "google_fonts": "{{ inputs.google_fonts }}",
        "url": "{{ inputs.url }}",
        "selector": "{{ inputs.selector }}",
        "viewport_width": "{{ inputs.viewport_width }}",
        "viewport_height": "{{ inputs.viewport_height }}",
        "device_scale": "{{ inputs.device_scale }}"
      },
      "inputs": [
        {
          "key": "html",
          "label": "HTML",
          "type": "code",
          "help": "Or set URL to screenshot a page."
        },
        {
          "key": "css",
          "label": "CSS",
          "type": "code"
        },
        {
          "key": "url",
          "label": "Page URL",
          "type": "string"
        },
        {
          "key": "google_fonts",
          "label": "Google fonts",
          "type": "string",
          "placeholder": "Roboto|Open Sans"
        },
        {
          "key": "selector",
          "label": "Crop to CSS selector",
          "type": "string"
        },
        {
          "key": "viewport_width",
          "label": "Viewport width",
          "type": "number"
        },
        {
          "key": "viewport_height",
          "label": "Viewport height",
          "type": "number"
        },
        {
          "key": "device_scale",
          "label": "Device scale",
          "type": "number",
          "placeholder": "2"
        }
      ]
    },
    {
      "key": "delete_image",
      "name": "Delete image",
      "method": "DELETE",
      "endpoint": "/image/{{ inputs.image_id }}",
      "inputs": [
        {
          "key": "image_id",
          "label": "Image ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
