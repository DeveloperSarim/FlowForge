{
  "key": "pushalert",
  "name": "PushAlert",
  "category": "Communication",
  "description": "Send web push notifications to your PushAlert subscribers.",
  "brand": "pushalert",
  "website": "https://pushalert.co",
  "docs_url": "https://pushalert.co/documentation",
  "base_url": "https://api.pushalert.co/rest/v1",
  "auth": [
    { "type": "api_key", "in": "header", "name": "Authorization", "prefix": "api_key=", "fields": [{ "key": "api_key", "label": "REST API key", "type": "password", "required": true, "help": "Dashboard → Settings → REST API Key." }] }
  ],
  "actions": [
    {
      "key": "send_notification",
      "name": "Send notification",
      "method": "POST",
      "endpoint": "/send",
      "body_format": "form",
      "body": {
        "title": "{{ inputs.title }}",
        "message": "{{ inputs.message }}",
        "url": "{{ inputs.url }}",
        "icon": "{{ inputs.icon }}",
        "large_image": "{{ inputs.large_image }}",
        "subscriber": "{{ inputs.subscriber }}"
      },
      "inputs": [
        { "key": "title", "label": "Title", "type": "string", "required": true },
        { "key": "message", "label": "Message", "type": "text", "required": true },
        { "key": "url", "label": "Target URL", "type": "string", "required": true },
        { "key": "icon", "label": "Icon URL", "type": "string" },
        { "key": "large_image", "label": "Large image URL", "type": "string" },
        { "key": "subscriber", "label": "Only this subscriber ID", "type": "string", "help": "Leave empty to send to all subscribers." }
      ]
    }
  ]
}
