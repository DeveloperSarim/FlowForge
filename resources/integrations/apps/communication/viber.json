{
  "key": "viber",
  "name": "Viber",
  "category": "Communication",
  "description": "Send messages from a Viber bot and look up subscriber details.",
  "brand": "viber",
  "website": "https://www.viber.com",
  "docs_url": "https://developers.viber.com/docs/api/rest-bot-api/",
  "base_url": "https://chatapi.viber.com/pa",
  "auth": [
    { "type": "api_key", "in": "header", "name": "X-Viber-Auth-Token", "fields": [{ "key": "api_key", "label": "Bot auth token", "type": "password", "required": true }] }
  ],
  "actions": [
    {
      "key": "send_message",
      "name": "Send text message",
      "method": "POST",
      "endpoint": "/send_message",
      "error_path": "status",
      "body": {
        "receiver": "{{ inputs.receiver }}",
        "min_api_version": 1,
        "sender": { "name": "{{ inputs.sender_name }}", "avatar": "{{ inputs.sender_avatar }}" },
        "type": "text",
        "text": "{{ inputs.text }}"
      },
      "inputs": [
        { "key": "receiver", "label": "Receiver (user ID)", "type": "string", "required": true, "help": "The subscriber's Viber user ID from a webhook event." },
        { "key": "sender_name", "label": "Sender name", "type": "string", "required": true },
        { "key": "sender_avatar", "label": "Sender avatar URL", "type": "string" },
        { "key": "text", "label": "Message", "type": "text", "required": true }
      ]
    },
    {
      "key": "get_user_details",
      "name": "Get user details",
      "method": "POST",
      "endpoint": "/get_user_details",
      "error_path": "status",
      "body": { "id": "{{ inputs.user_id }}" },
      "output_path": "user",
      "inputs": [{ "key": "user_id", "label": "User ID", "type": "string", "required": true }]
    }
  ]
}
