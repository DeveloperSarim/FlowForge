{
  "key": "mapbox",
  "name": "Mapbox",
  "category": "Utilities",
  "description": "Forward and reverse geocoding with the Mapbox Geocoding API.",
  "brand": "mapbox",
  "website": "https://www.mapbox.com",
  "docs_url": "https://docs.mapbox.com/api/search/geocoding/",
  "base_url": "https://api.mapbox.com",
  "auth": { "type": "api_key", "in": "query", "name": "access_token", "fields": [
    { "key": "api_key", "label": "Access token", "type": "password", "required": true, "help": "A pk.… or sk.… token from account.mapbox.com/access-tokens." }
  ] },
  "actions": [
    {
      "key": "forward_geocode",
      "name": "Geocode address",
      "description": "Turns an address or place name into coordinates.",
      "method": "GET",
      "endpoint": "/search/geocode/v6/forward",
      "query": { "q": "{{ inputs.q }}", "limit": "{{ inputs.limit }}", "country": "{{ inputs.country }}", "language": "{{ inputs.language }}", "proximity": "{{ inputs.proximity }}" },
      "output_path": "features",
      "inputs": [
        { "key": "q", "label": "Search text", "type": "string", "required": true, "placeholder": "1600 Pennsylvania Ave NW, Washington DC" },
        { "key": "limit", "label": "Max results", "type": "number", "default": 5, "help": "1 to 10." },
        { "key": "country", "label": "Countries", "type": "string", "placeholder": "us,ca", "help": "ISO 3166 alpha-2 codes, comma-separated." },
        { "key": "language", "label": "Language", "type": "string", "placeholder": "en" },
        { "key": "proximity", "label": "Bias near (lon,lat)", "type": "string", "placeholder": "-73.99,40.73" }
      ]
    },
    {
      "key": "reverse_geocode",
      "name": "Reverse geocode",
      "description": "Turns coordinates into an address.",
      "method": "GET",
      "endpoint": "/search/geocode/v6/reverse",
      "query": { "longitude": "{{ inputs.longitude }}", "latitude": "{{ inputs.latitude }}", "language": "{{ inputs.language }}" },
      "output_path": "features",
      "inputs": [
        { "key": "longitude", "label": "Longitude", "type": "number", "required": true },
        { "key": "latitude", "label": "Latitude", "type": "number", "required": true },
        { "key": "language", "label": "Language", "type": "string", "placeholder": "en" }
      ]
    }
  ]
}
