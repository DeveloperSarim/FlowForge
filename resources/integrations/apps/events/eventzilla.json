{
  "key": "eventzilla",
  "name": "Eventzilla",
  "category": "Events & Webinars",
  "description": "List Eventzilla events, attendees and transactions.",
  "brand": "eventzilla",
  "website": "https://www.eventzilla.net",
  "docs_url": "https://developer.eventzilla.net",
  "base_url": "https://www.eventzillaapi.net/api/v2",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "x-api-key",
      "fields": [
        {
          "key": "api_key",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Settings > App management > API keys."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_events",
      "name": "List events",
      "method": "GET",
      "endpoint": "/events",
      "query": {
        "status": "{{ inputs.status }}",
        "limit": "{{ inputs.limit }}",
        "offset": "{{ inputs.offset }}"
      },
      "output_path": "events",
      "inputs": [
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "options": [
            {
              "value": "live",
              "label": "Live"
            },
            {
              "value": "draft",
              "label": "Draft"
            },
            {
              "value": "unpublished",
              "label": "Unpublished"
            },
            {
              "value": "completed",
              "label": "Completed"
            }
          ]
        },
        {
          "key": "limit",
          "label": "Max results",
          "type": "number",
          "default": 20
        },
        {
          "key": "offset",
          "label": "Offset",
          "type": "number"
        }
      ]
    },
    {
      "key": "get_event",
      "name": "Get event",
      "method": "GET",
      "endpoint": "/events/{{ inputs.event_id }}",
      "inputs": [
        {
          "key": "event_id",
          "label": "Event ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_attendees",
      "name": "List attendees",
      "method": "GET",
      "endpoint": "/events/{{ inputs.event_id }}/attendees",
      "query": {
        "limit": "{{ inputs.limit }}",
        "offset": "{{ inputs.offset }}"
      },
      "output_path": "attendees",
      "inputs": [
        {
          "key": "event_id",
          "label": "Event ID",
          "type": "string",
          "required": true
        },
        {
          "key": "limit",
          "label": "Max results",
          "type": "number",
          "default": 20
        },
        {
          "key": "offset",
          "label": "Offset",
          "type": "number"
        }
      ]
    },
    {
      "key": "list_transactions",
      "name": "List transactions",
      "method": "GET",
      "endpoint": "/events/{{ inputs.event_id }}/transactions",
      "inputs": [
        {
          "key": "event_id",
          "label": "Event ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
