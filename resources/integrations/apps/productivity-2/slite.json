{
  "key": "slite",
  "name": "Slite",
  "category": "Productivity",
  "description": "Create, update and search Slite notes, or ask your docs a question.",
  "brand": "slite",
  "website": "https://slite.com",
  "docs_url": "https://developers.slite.com",
  "popular": true,
  "base_url": "https://api.slite.com/v1",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Settings > API."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "create_note",
      "name": "Create note",
      "method": "POST",
      "endpoint": "/notes",
      "body": {
        "title": "{{ inputs.title }}",
        "markdown": "{{ inputs.markdown }}",
        "parentNoteId": "{{ inputs.parent_note_id }}",
        "templateId": "{{ inputs.template_id }}"
      },
      "inputs": [
        {
          "key": "title",
          "label": "Title",
          "type": "string",
          "required": true
        },
        {
          "key": "markdown",
          "label": "Content (Markdown)",
          "type": "text"
        },
        {
          "key": "parent_note_id",
          "label": "Parent note ID",
          "type": "string"
        },
        {
          "key": "template_id",
          "label": "Template ID",
          "type": "string"
        }
      ]
    },
    {
      "key": "get_note",
      "name": "Get note",
      "method": "GET",
      "endpoint": "/notes/{{ inputs.note_id }}",
      "inputs": [
        {
          "key": "note_id",
          "label": "Note ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "update_note",
      "name": "Update note",
      "method": "PUT",
      "endpoint": "/notes/{{ inputs.note_id }}",
      "body": {
        "title": "{{ inputs.title }}",
        "markdown": "{{ inputs.markdown }}"
      },
      "inputs": [
        {
          "key": "note_id",
          "label": "Note ID",
          "type": "string",
          "required": true
        },
        {
          "key": "title",
          "label": "Title",
          "type": "string"
        },
        {
          "key": "markdown",
          "label": "Content (Markdown)",
          "type": "text",
          "help": "Replaces the note content."
        }
      ]
    },
    {
      "key": "search_notes",
      "name": "Search notes",
      "method": "GET",
      "endpoint": "/search-notes",
      "query": {
        "query": "{{ inputs.query }}",
        "parentNoteId": "{{ inputs.parent_note_id }}",
        "hitsPerPage": "{{ inputs.hits_per_page }}"
      },
      "inputs": [
        {
          "key": "query",
          "label": "Search text",
          "type": "string"
        },
        {
          "key": "parent_note_id",
          "label": "Under parent note ID",
          "type": "string"
        },
        {
          "key": "hits_per_page",
          "label": "Results per page",
          "type": "number"
        }
      ]
    },
    {
      "key": "ask",
      "name": "Ask a question",
      "method": "GET",
      "endpoint": "/ask",
      "description": "Answers a natural-language question from your notes.",
      "query": {
        "question": "{{ inputs.question }}",
        "parentNoteId": "{{ inputs.parent_note_id }}",
        "wait": "true"
      },
      "timeout": 180,
      "inputs": [
        {
          "key": "question",
          "label": "Question",
          "type": "string",
          "required": true
        },
        {
          "key": "parent_note_id",
          "label": "Only notes under parent note ID",
          "type": "string"
        }
      ]
    }
  ]
}
