{
  "key": "failure-alerts-slack",
  "name": "Alert Slack when any workflow fails",
  "description": "Every failed production run posts the workflow, error and a link to the run in your ops channel.",
  "category": "Monitoring",
  "featured": true,
  "graph": {
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger",
        "position": {
          "x": 0,
          "y": 200
        },
        "data": {
          "integration": "error_trigger",
          "trigger": "workflow_failed",
          "label": "Any workflow fails",
          "config": {
            "sample_payload": "{\n  \"workflow\": { \"id\": 3, \"name\": \"Sync Shopify orders\" },\n  \"execution\": { \"id\": 120, \"error\": \"Append row: HTTP 403\", \"url\": \"https://flowforge.example.com/executions?open=120\" }\n}"
          }
        }
      },
      {
        "id": "step_1",
        "type": "action",
        "position": {
          "x": 240,
          "y": 200
        },
        "data": {
          "integration": "slack",
          "action": "post_message",
          "label": "Post to #ops",
          "config": {
            "channel": "#ops",
            "text": ":rotating_light: *{{ steps.trigger.data.workflow.name }}* failed\n> {{ steps.trigger.data.execution.error }}\n{{ steps.trigger.data.execution.url }}"
          }
        }
      }
    ],
    "edges": [
      {
        "id": "e-trigger-step_1",
        "source": "trigger",
        "target": "step_1",
        "sourceHandle": null
      }
    ]
  }
}