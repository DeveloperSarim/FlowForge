{
  "key": "omdb",
  "name": "OMDb",
  "category": "Video & Media",
  "description": "Look up movies and series by title or IMDb ID, or search the OMDb catalogue.",
  "brand": "omdb",
  "website": "https://www.omdbapi.com",
  "docs_url": "https://www.omdbapi.com/",
  "base_url": "https://www.omdbapi.com",
  "auth": { "type": "api_key", "in": "query", "name": "apikey" },
  "actions": [
    {
      "key": "get_by_title",
      "name": "Get by title",
      "method": "GET",
      "endpoint": "/",
      "error_path": "Error",
      "query": { "t": "{{ inputs.title }}", "y": "{{ inputs.year }}", "type": "{{ inputs.type }}", "plot": "{{ inputs.plot }}" },
      "inputs": [
        { "key": "title", "label": "Title", "type": "string", "required": true },
        { "key": "year", "label": "Year", "type": "string" },
        { "key": "type", "label": "Type", "type": "select", "options": [
          { "value": "", "label": "Any" }, { "value": "movie", "label": "Movie" }, { "value": "series", "label": "Series" }, { "value": "episode", "label": "Episode" }
        ] },
        { "key": "plot", "label": "Plot", "type": "select", "default": "short", "options": [
          { "value": "short", "label": "Short" }, { "value": "full", "label": "Full" }
        ] }
      ]
    },
    {
      "key": "get_by_imdb_id",
      "name": "Get by IMDb ID",
      "method": "GET",
      "endpoint": "/",
      "error_path": "Error",
      "query": { "i": "{{ inputs.imdb_id }}", "plot": "{{ inputs.plot }}" },
      "inputs": [
        { "key": "imdb_id", "label": "IMDb ID", "type": "string", "required": true, "placeholder": "tt0133093" },
        { "key": "plot", "label": "Plot", "type": "select", "default": "short", "options": [
          { "value": "short", "label": "Short" }, { "value": "full", "label": "Full" }
        ] }
      ]
    },
    {
      "key": "search",
      "name": "Search",
      "method": "GET",
      "endpoint": "/",
      "error_path": "Error",
      "output_path": "Search",
      "query": { "s": "{{ inputs.query }}", "y": "{{ inputs.year }}", "type": "{{ inputs.type }}", "page": "{{ inputs.page }}" },
      "inputs": [
        { "key": "query", "label": "Search", "type": "string", "required": true },
        { "key": "year", "label": "Year", "type": "string" },
        { "key": "type", "label": "Type", "type": "select", "options": [
          { "value": "", "label": "Any" }, { "value": "movie", "label": "Movie" }, { "value": "series", "label": "Series" }, { "value": "episode", "label": "Episode" }
        ] },
        { "key": "page", "label": "Page", "type": "number" }
      ]
    }
  ]
}
