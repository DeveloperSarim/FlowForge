{
  "key": "sarvam_ai",
  "name": "Sarvam AI",
  "category": "AI",
  "description": "Indian-language AI: translate, speak, detect language and chat in 11+ Indian languages.",
  "website": "https://www.sarvam.ai",
  "docs_url": "https://docs.sarvam.ai",
  "base_url": "https://api.sarvam.ai",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "api-subscription-key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "dashboard.sarvam.ai → API Keys → Create key."
      }
    ]
  },
  "actions": [
    {
      "key": "translate",
      "name": "Translate text",
      "description": "Translate between English and Indian languages.",
      "method": "POST",
      "endpoint": "/translate",
      "body": {
        "input": "{{ inputs.input }}",
        "source_language_code": "{{ inputs.source_language_code }}",
        "target_language_code": "{{ inputs.target_language_code }}",
        "model": "{{ inputs.model }}",
        "mode": "{{ inputs.mode }}"
      },
      "output_fields": {
        "text": "translated_text",
        "source_language": "source_language_code"
      },
      "inputs": [
        {
          "key": "input",
          "label": "Text",
          "type": "text",
          "required": true,
          "help": "Up to 1000 characters (2000 with sarvam-translate:v1)."
        },
        {
          "key": "source_language_code",
          "label": "From",
          "type": "select",
          "required": true,
          "default": "auto",
          "options": [
            {
              "value": "auto",
              "label": "Detect automatically"
            },
            {
              "value": "en-IN",
              "label": "English"
            },
            {
              "value": "hi-IN",
              "label": "Hindi"
            },
            {
              "value": "bn-IN",
              "label": "Bengali"
            },
            {
              "value": "gu-IN",
              "label": "Gujarati"
            },
            {
              "value": "kn-IN",
              "label": "Kannada"
            },
            {
              "value": "ml-IN",
              "label": "Malayalam"
            },
            {
              "value": "mr-IN",
              "label": "Marathi"
            },
            {
              "value": "od-IN",
              "label": "Odia"
            },
            {
              "value": "pa-IN",
              "label": "Punjabi"
            },
            {
              "value": "ta-IN",
              "label": "Tamil"
            },
            {
              "value": "te-IN",
              "label": "Telugu"
            }
          ]
        },
        {
          "key": "target_language_code",
          "label": "To",
          "type": "select",
          "required": true,
          "default": "hi-IN",
          "options": [
            {
              "value": "en-IN",
              "label": "English"
            },
            {
              "value": "hi-IN",
              "label": "Hindi"
            },
            {
              "value": "bn-IN",
              "label": "Bengali"
            },
            {
              "value": "gu-IN",
              "label": "Gujarati"
            },
            {
              "value": "kn-IN",
              "label": "Kannada"
            },
            {
              "value": "ml-IN",
              "label": "Malayalam"
            },
            {
              "value": "mr-IN",
              "label": "Marathi"
            },
            {
              "value": "od-IN",
              "label": "Odia"
            },
            {
              "value": "pa-IN",
              "label": "Punjabi"
            },
            {
              "value": "ta-IN",
              "label": "Tamil"
            },
            {
              "value": "te-IN",
              "label": "Telugu"
            }
          ]
        },
        {
          "key": "model",
          "label": "Model",
          "type": "select",
          "default": "mayura:v1",
          "options": [
            {
              "value": "mayura:v1",
              "label": "Mayura v1 (11 languages)"
            },
            {
              "value": "sarvam-translate:v1",
              "label": "Sarvam Translate v1 (22 languages)"
            }
          ]
        },
        {
          "key": "mode",
          "label": "Style",
          "type": "select",
          "options": [
            {
              "value": "formal",
              "label": "Formal"
            },
            {
              "value": "modern-colloquial",
              "label": "Modern colloquial"
            },
            {
              "value": "classic-colloquial",
              "label": "Classic colloquial"
            },
            {
              "value": "code-mixed",
              "label": "Code-mixed"
            }
          ]
        }
      ]
    },
    {
      "key": "text_to_speech",
      "name": "Text to speech",
      "description": "Turn text into speech. Returns WAV audio as base64.",
      "method": "POST",
      "endpoint": "/text-to-speech",
      "timeout": 120,
      "body": {
        "text": "{{ inputs.text }}",
        "language_code": "{{ inputs.language_code }}",
        "model": "{{ inputs.model }}",
        "speaker": "{{ inputs.speaker }}",
        "pace": "{{ inputs.pace }}"
      },
      "output_fields": {
        "audio_base64": "audios.0"
      },
      "inputs": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "required": true
        },
        {
          "key": "language_code",
          "label": "Language",
          "type": "select",
          "required": true,
          "default": "hi-IN",
          "options": [
            {
              "value": "en-IN",
              "label": "English"
            },
            {
              "value": "hi-IN",
              "label": "Hindi"
            },
            {
              "value": "bn-IN",
              "label": "Bengali"
            },
            {
              "value": "gu-IN",
              "label": "Gujarati"
            },
            {
              "value": "kn-IN",
              "label": "Kannada"
            },
            {
              "value": "ml-IN",
              "label": "Malayalam"
            },
            {
              "value": "mr-IN",
              "label": "Marathi"
            },
            {
              "value": "od-IN",
              "label": "Odia"
            },
            {
              "value": "pa-IN",
              "label": "Punjabi"
            },
            {
              "value": "ta-IN",
              "label": "Tamil"
            },
            {
              "value": "te-IN",
              "label": "Telugu"
            }
          ]
        },
        {
          "key": "model",
          "label": "Model",
          "type": "select",
          "default": "bulbul:v3",
          "options": [
            {
              "value": "bulbul:v3",
              "label": "Bulbul v3"
            },
            {
              "value": "bulbul:v4-flash",
              "label": "Bulbul v4 Flash"
            }
          ]
        },
        {
          "key": "speaker",
          "label": "Speaker",
          "type": "string",
          "placeholder": "shubh",
          "help": "Voice name for the chosen model, e.g. shubh, priya or neha for bulbul:v3."
        },
        {
          "key": "pace",
          "label": "Pace",
          "type": "number",
          "placeholder": "1.0"
        }
      ]
    },
    {
      "key": "identify_language",
      "name": "Identify language",
      "description": "Detect the language and script of a text.",
      "method": "POST",
      "endpoint": "/text-lid",
      "body": {
        "input": "{{ inputs.input }}"
      },
      "output_fields": {
        "language_code": "language_code",
        "script_code": "script_code"
      },
      "inputs": [
        {
          "key": "input",
          "label": "Text",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "key": "chat_completion",
      "name": "Chat completion",
      "description": "Send a prompt and get the model's reply as text.",
      "method": "POST",
      "endpoint": "/v1/chat/completions",
      "timeout": 300,
      "body": {
        "model": "{{ inputs.model }}",
        "messages": [
          {
            "$if": "{{ inputs.system }}",
            "role": "system",
            "content": "{{ inputs.system }}"
          },
          {
            "role": "user",
            "content": "{{ inputs.prompt }}"
          }
        ],
        "temperature": "{{ inputs.temperature }}",
        "max_tokens": "{{ inputs.max_tokens }}"
      },
      "output_fields": {
        "text": "choices.0.message.content"
      },
      "inputs": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": true,
          "help": "sarvam-105b or sarvam-105b-conversations.",
          "default": "sarvam-105b"
        },
        {
          "key": "prompt",
          "label": "Prompt",
          "type": "text",
          "required": true
        },
        {
          "key": "system",
          "label": "System prompt",
          "type": "text",
          "help": "Optional instructions for how the model should behave."
        },
        {
          "key": "temperature",
          "label": "Temperature",
          "type": "number",
          "placeholder": "0.7",
          "help": "0 = focused, 1 = creative. Leave blank for the default."
        },
        {
          "key": "max_tokens",
          "label": "Max output tokens",
          "type": "number"
        }
      ]
    }
  ]
}
