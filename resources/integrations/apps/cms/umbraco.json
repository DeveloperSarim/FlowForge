{
  "key": "umbraco",
  "name": "Umbraco",
  "category": "CMS & Websites",
  "description": "Query published content with the Umbraco Content Delivery API.",
  "brand": "umbraco",
  "website": "https://umbraco.com",
  "docs_url": "https://docs.umbraco.com/umbraco-cms/reference/content-delivery-api",
  "base_url": "{{ credentials.site_url }}/umbraco/delivery/api/v2",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "Api-Key",
      "fields": [
        {
          "key": "site_url",
          "label": "Site URL",
          "type": "string",
          "required": true,
          "placeholder": "https://example.com",
          "help": "No trailing slash."
        },
        {
          "key": "api_key",
          "label": "Delivery API key",
          "type": "password",
          "required": false,
          "help": "Only if the Delivery API is not public (Umbraco:CMS:DeliveryApi:ApiKey)."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "query_content",
      "name": "Query content",
      "method": "GET",
      "endpoint": "/content",
      "output_path": "items",
      "query": {
        "fetch": "{{ inputs.fetch }}",
        "filter": "{{ inputs.filter }}",
        "sort": "{{ inputs.sort }}",
        "skip": "{{ inputs.skip }}",
        "take": "{{ inputs.take }}"
      },
      "inputs": [
        {
          "key": "fetch",
          "label": "Fetch",
          "type": "string",
          "placeholder": "children:/blog/"
        },
        {
          "key": "filter",
          "label": "Filter",
          "type": "string",
          "placeholder": "contentType:article"
        },
        {
          "key": "sort",
          "label": "Sort",
          "type": "string",
          "default": "createDate:desc"
        },
        {
          "key": "skip",
          "label": "Skip",
          "type": "number"
        },
        {
          "key": "take",
          "label": "Max items",
          "type": "number",
          "default": 10
        }
      ]
    },
    {
      "key": "get_content",
      "name": "Get content by ID",
      "method": "GET",
      "endpoint": "/content/item/{{ inputs.id }}",
      "inputs": [
        {
          "key": "id",
          "label": "Content ID (GUID)",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
