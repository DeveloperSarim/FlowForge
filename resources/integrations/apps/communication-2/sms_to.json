{
  "key": "sms_to",
  "name": "SMS.to",
  "category": "Communication",
  "description": "Send SMS worldwide with SMS.to.",
  "brand": "smsto",
  "website": "https://sms.to",
  "docs_url": "https://developers.sms.to",
  "base_url": "https://api.sms.to",
  "auth": [
    { "type": "bearer", "fields": [{ "key": "token", "label": "API key", "type": "password", "required": true }] }
  ],
  "actions": [
    {
      "key": "send_sms",
      "name": "Send SMS",
      "method": "POST",
      "endpoint": "/sms/send",
      "body": {
        "to": "{{ inputs.to }}",
        "message": "{{ inputs.message }}",
        "sender_id": "{{ inputs.sender_id }}",
        "callback_url": "{{ inputs.callback_url }}"
      },
      "inputs": [
        { "key": "to", "label": "To (E.164)", "type": "string", "required": true, "placeholder": "+35799999999999" },
        { "key": "message", "label": "Message", "type": "text", "required": true },
        { "key": "sender_id", "label": "Sender ID", "type": "string" },
        { "key": "callback_url", "label": "Delivery callback URL", "type": "string" }
      ]
    }
  ]
}
