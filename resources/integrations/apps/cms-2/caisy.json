{
  "key": "caisy",
  "name": "caisy",
  "category": "CMS & Websites",
  "description": "Query and update caisy headless CMS content with GraphQL.",
  "brand": "caisy",
  "website": "https://caisy.io",
  "docs_url": "https://caisy.io/developer/docs/external-api/api-reference",
  "base_url": "https://cloud.caisy.io/api/v3/e/{{ credentials.project_id }}",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "x-caisy-apikey",
      "fields": [
        {
          "key": "project_id",
          "label": "Project ID",
          "type": "string",
          "required": true
        },
        {
          "key": "api_key",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Project settings > Development > API keys."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "graphql_query",
      "name": "Run GraphQL query",
      "description": "Runs a GraphQL query or mutation.",
      "method": "POST",
      "endpoint": "/graphql",
      "body": {
        "query": "{{ inputs.query }}",
        "variables": "{{ inputs.variables }}"
      },
      "inputs": [
        {
          "key": "query",
          "label": "Query",
          "type": "code",
          "required": true,
          "placeholder": "query { ... }"
        },
        {
          "key": "variables",
          "label": "Variables",
          "type": "json"
        }
      ]
    }
  ],
  "triggers": [
    {
      "key": "webhook_event",
      "name": "Webhook event",
      "type": "webhook",
      "inputs": [
        {
          "key": "sample_payload",
          "label": "Test payload (JSON)",
          "type": "json"
        }
      ]
    }
  ]
}
