{
  "key": "comeet",
  "name": "Comeet",
  "category": "HR & Recruiting",
  "description": "List open positions from your Comeet careers feed.",
  "brand": "comeet",
  "website": "https://www.comeet.com",
  "docs_url": "https://developers.comeet.com",
  "base_url": "https://www.comeet.co/careers-api/2.0/company/{{ credentials.company_uid }}",
  "auth": [
    {
      "type": "api_key",
      "in": "query",
      "name": "token",
      "fields": [
        {
          "key": "company_uid",
          "label": "Company UID",
          "type": "string",
          "required": true,
          "help": "Company settings > Careers website > Careers API."
        },
        {
          "key": "api_key",
          "label": "Careers API token",
          "type": "password",
          "required": true
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_positions",
      "name": "List positions",
      "description": "Published positions only.",
      "method": "GET",
      "endpoint": "/positions",
      "query": {
        "details": "{{ inputs.details }}"
      },
      "inputs": [
        {
          "key": "details",
          "label": "Include descriptions",
          "type": "boolean"
        }
      ]
    }
  ]
}
