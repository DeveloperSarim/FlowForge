{
  "key": "homerun",
  "name": "Homerun",
  "category": "HR & Recruiting",
  "description": "List vacancies and job applications and add applicants in Homerun.",
  "brand": "homerun",
  "website": "https://www.homerun.co",
  "docs_url": "https://developers.homerun.co",
  "base_url": "https://api.homerun.co/v2",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Settings > Integrations > API. Give it the scopes you need."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_vacancies",
      "name": "List vacancies",
      "method": "GET",
      "endpoint": "/vacancies",
      "query": {
        "filter[status]": "{{ inputs.status }}",
        "perPage": "{{ inputs.per_page }}"
      },
      "output_path": "data",
      "inputs": [
        {
          "key": "status",
          "label": "Status",
          "type": "string",
          "placeholder": "published"
        },
        {
          "key": "per_page",
          "label": "Per page",
          "type": "number",
          "default": 100
        }
      ]
    },
    {
      "key": "get_vacancy",
      "name": "Get vacancy",
      "method": "GET",
      "endpoint": "/vacancies/{{ inputs.vacancy_id }}",
      "output_path": "data",
      "inputs": [
        {
          "key": "vacancy_id",
          "label": "Vacancy ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_job_applications",
      "name": "List job applications",
      "method": "GET",
      "endpoint": "/job-applications",
      "query": {
        "filter[vacancy_id]": "{{ inputs.vacancy_id }}",
        "filter[stage]": "{{ inputs.stage }}",
        "perPage": "{{ inputs.per_page }}"
      },
      "output_path": "data",
      "inputs": [
        {
          "key": "vacancy_id",
          "label": "Vacancy ID",
          "type": "string"
        },
        {
          "key": "stage",
          "label": "Stage",
          "type": "string"
        },
        {
          "key": "per_page",
          "label": "Per page",
          "type": "number",
          "default": 100
        }
      ]
    },
    {
      "key": "create_job_application",
      "name": "Create job application",
      "method": "POST",
      "endpoint": "/job-applications",
      "body": {
        "first_name": "{{ inputs.first_name }}",
        "last_name": "{{ inputs.last_name }}",
        "email": "{{ inputs.email }}",
        "vacancy_id": "{{ inputs.vacancy_id }}",
        "phone_number": "{{ inputs.phone_number }}",
        "linkedin": "{{ inputs.linkedin }}"
      },
      "output_path": "data",
      "inputs": [
        {
          "key": "first_name",
          "label": "First name",
          "type": "string",
          "required": true
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "vacancy_id",
          "label": "Vacancy ID",
          "type": "string"
        },
        {
          "key": "phone_number",
          "label": "Phone number",
          "type": "string"
        },
        {
          "key": "linkedin",
          "label": "LinkedIn URL",
          "type": "string"
        }
      ]
    }
  ]
}
