{
  "key": "duda",
  "name": "Duda",
  "category": "CMS & Websites",
  "description": "Create, publish and unpublish Duda sites and add collection rows.",
  "brand": "duda",
  "website": "https://www.duda.co",
  "docs_url": "https://developer.duda.co/reference",
  "base_url": "https://api.duda.co/api",
  "auth": [
    {
      "type": "basic",
      "fields": [
        {
          "key": "username",
          "label": "API username",
          "type": "string",
          "required": true
        },
        {
          "key": "password",
          "label": "API password",
          "type": "password",
          "required": true
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "create_site",
      "name": "Create site",
      "method": "POST",
      "endpoint": "/sites/multiscreen/create",
      "body": {
        "template_id": "{{ inputs.template_id }}",
        "lang": "{{ inputs.lang }}",
        "default_domain_prefix": "{{ inputs.domain_prefix }}"
      },
      "inputs": [
        {
          "key": "template_id",
          "label": "Template ID",
          "type": "number",
          "required": true
        },
        {
          "key": "lang",
          "label": "Language",
          "type": "string",
          "placeholder": "en"
        },
        {
          "key": "domain_prefix",
          "label": "Default domain prefix",
          "type": "string"
        }
      ]
    },
    {
      "key": "get_site",
      "name": "Get site",
      "method": "GET",
      "endpoint": "/sites/multiscreen/{{ inputs.site_name }}",
      "inputs": [
        {
          "key": "site_name",
          "label": "Site name",
          "type": "string",
          "required": true,
          "help": "Duda's unique site id, e.g. a1b2c3d4."
        }
      ]
    },
    {
      "key": "publish_site",
      "name": "Publish site",
      "method": "POST",
      "endpoint": "/sites/multiscreen/publish/{{ inputs.site_name }}",
      "inputs": [
        {
          "key": "site_name",
          "label": "Site name",
          "type": "string",
          "required": true,
          "help": "Duda's unique site id, e.g. a1b2c3d4."
        }
      ]
    },
    {
      "key": "unpublish_site",
      "name": "Unpublish site",
      "method": "POST",
      "endpoint": "/sites/multiscreen/unpublish/{{ inputs.site_name }}",
      "inputs": [
        {
          "key": "site_name",
          "label": "Site name",
          "type": "string",
          "required": true,
          "help": "Duda's unique site id, e.g. a1b2c3d4."
        }
      ]
    },
    {
      "key": "add_collection_rows",
      "name": "Add collection rows",
      "method": "POST",
      "endpoint": "/sites/multiscreen/{{ inputs.site_name }}/collection/{{ inputs.collection }}/row",
      "body": "{{ inputs.rows }}",
      "inputs": [
        {
          "key": "site_name",
          "label": "Site name",
          "type": "string",
          "required": true,
          "help": "Duda's unique site id, e.g. a1b2c3d4."
        },
        {
          "key": "collection",
          "label": "Collection name",
          "type": "string",
          "required": true
        },
        {
          "key": "rows",
          "label": "Rows (JSON array)",
          "type": "json",
          "required": true,
          "placeholder": "[{ \"data\": { \"title\": \"Hello\" } }]"
        }
      ]
    }
  ]
}
