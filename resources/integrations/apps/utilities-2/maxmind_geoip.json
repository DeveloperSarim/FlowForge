{
  "key": "maxmind_geoip",
  "name": "MaxMind GeoIP",
  "category": "Utilities",
  "description": "GeoIP2 web service lookups: country, city and insights for an IP.",
  "brand": "maxmind",
  "website": "https://www.maxmind.com",
  "docs_url": "https://dev.maxmind.com/geoip/docs/web-services",
  "base_url": "https://geoip.maxmind.com/geoip/v2.1",
  "auth": { "type": "basic", "fields": [
    { "key": "username", "label": "Account ID", "type": "string", "required": true },
    { "key": "password", "label": "License key", "type": "password", "required": true, "help": "Account → Manage license keys." }
  ] },
  "actions": [
    {
      "key": "country",
      "name": "Country lookup",
      "method": "GET",
      "endpoint": "/country/{{ inputs.ip }}",
      "inputs": [{ "key": "ip", "label": "IP address", "type": "string", "required": true, "default": "me", "help": "\"me\" looks up the caller's IP." }]
    },
    {
      "key": "city",
      "name": "City lookup",
      "method": "GET",
      "endpoint": "/city/{{ inputs.ip }}",
      "inputs": [{ "key": "ip", "label": "IP address", "type": "string", "required": true, "default": "me" }]
    },
    {
      "key": "insights",
      "name": "Insights lookup",
      "description": "City data plus confidence, user type and anonymizer flags.",
      "method": "GET",
      "endpoint": "/insights/{{ inputs.ip }}",
      "inputs": [{ "key": "ip", "label": "IP address", "type": "string", "required": true, "default": "me" }]
    }
  ]
}
