{
  "key": "teamdeck",
  "name": "Teamdeck",
  "category": "Project Management",
  "description": "Book Teamdeck resources on projects and list bookings.",
  "brand": "teamdeck",
  "website": "https://teamdeck.io",
  "docs_url": "https://teamdeck.io/developers/api",
  "base_url": "https://api.teamdeck.io/v1",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "X-Api-Key",
      "fields": [
        {
          "key": "api_key",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Settings > Integrations > API keys (organization owner)."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_resources",
      "name": "List resources",
      "method": "GET",
      "endpoint": "/resources",
      "inputs": []
    },
    {
      "key": "list_projects",
      "name": "List projects",
      "method": "GET",
      "endpoint": "/projects",
      "inputs": []
    },
    {
      "key": "list_bookings",
      "name": "List bookings",
      "method": "GET",
      "endpoint": "/bookings",
      "inputs": []
    },
    {
      "key": "create_booking",
      "name": "Create booking",
      "method": "POST",
      "endpoint": "/bookings",
      "body": {
        "resource_id": "{{ inputs.resource_id }}",
        "project_id": "{{ inputs.project_id }}",
        "minutes": "{{ inputs.minutes }}",
        "start_date": "{{ inputs.start_date }}",
        "end_date": "{{ inputs.end_date }}",
        "...": "{{ inputs.extra }}"
      },
      "inputs": [
        {
          "key": "resource_id",
          "label": "Resource ID",
          "type": "number",
          "required": true
        },
        {
          "key": "project_id",
          "label": "Project ID",
          "type": "number",
          "required": true
        },
        {
          "key": "minutes",
          "label": "Minutes per day",
          "type": "number",
          "required": true
        },
        {
          "key": "start_date",
          "label": "Start date",
          "type": "string",
          "required": true,
          "placeholder": "2026-10-12"
        },
        {
          "key": "end_date",
          "label": "End date",
          "type": "string",
          "required": true,
          "placeholder": "2026-10-16"
        },
        {
          "key": "extra",
          "label": "Extra fields",
          "type": "json",
          "help": "Any other fields the API accepts, merged into the request."
        }
      ]
    }
  ]
}
