{
  "key": "stormglass",
  "name": "Stormglass",
  "category": "Utilities",
  "description": "Marine weather, tides and astronomy data for any coordinate.",
  "brand": "stormglass",
  "website": "https://stormglass.io",
  "docs_url": "https://docs.stormglass.io",
  "base_url": "https://api.stormglass.io/v2",
  "auth": { "type": "api_key", "in": "header", "name": "Authorization", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "weather_point",
      "name": "Get weather at point",
      "method": "GET",
      "endpoint": "/weather/point",
      "query": { "lat": "{{ inputs.lat }}", "lng": "{{ inputs.lng }}", "params": "{{ inputs.params }}", "start": "{{ inputs.start }}", "end": "{{ inputs.end }}", "source": "{{ inputs.source }}" },
      "inputs": [
        { "key": "lat", "label": "Latitude", "type": "number", "required": true },
        { "key": "lng", "label": "Longitude", "type": "number", "required": true },
        { "key": "params", "label": "Parameters", "type": "string", "required": true, "placeholder": "waveHeight,airTemperature,windSpeed" },
        { "key": "start", "label": "Start (UTC timestamp or ISO)", "type": "string" },
        { "key": "end", "label": "End (UTC timestamp or ISO)", "type": "string" },
        { "key": "source", "label": "Sources", "type": "string", "placeholder": "noaa,sg" }
      ]
    },
    {
      "key": "tide_extremes",
      "name": "Get tide extremes",
      "description": "High and low tide times and heights.",
      "method": "GET",
      "endpoint": "/tide/extremes/point",
      "query": { "lat": "{{ inputs.lat }}", "lng": "{{ inputs.lng }}", "start": "{{ inputs.start }}", "end": "{{ inputs.end }}" },
      "inputs": [
        { "key": "lat", "label": "Latitude", "type": "number", "required": true },
        { "key": "lng", "label": "Longitude", "type": "number", "required": true },
        { "key": "start", "label": "Start", "type": "string" },
        { "key": "end", "label": "End", "type": "string" }
      ]
    },
    {
      "key": "astronomy",
      "name": "Get astronomy data",
      "description": "Sunrise, sunset, moonrise and moon phase.",
      "method": "GET",
      "endpoint": "/astronomy/point",
      "query": { "lat": "{{ inputs.lat }}", "lng": "{{ inputs.lng }}", "start": "{{ inputs.start }}", "end": "{{ inputs.end }}" },
      "inputs": [
        { "key": "lat", "label": "Latitude", "type": "number", "required": true },
        { "key": "lng", "label": "Longitude", "type": "number", "required": true },
        { "key": "start", "label": "Start", "type": "string" },
        { "key": "end", "label": "End", "type": "string" }
      ]
    }
  ]
}
