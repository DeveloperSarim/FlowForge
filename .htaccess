# For hosts where the document root is this folder (e.g. the whole app uploaded into public_html):
# send every request into public/. If you can point the domain's document root at public/ instead, do that.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Belt and braces: never serve dotfiles (.env, .installed) from this folder.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
