{
  "key": "ahrefs",
  "name": "Ahrefs",
  "category": "Analytics",
  "description": "Domain Rating, backlink stats, organic metrics and keyword overviews.",
  "brand": "ahrefs",
  "website": "https://ahrefs.com",
  "docs_url": "https://docs.ahrefs.com/docs/api/reference/introduction",
  "base_url": "https://api.ahrefs.com/v3",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Account settings > API keys (Enterprise plan or API units)."
      }
    ]
  },
  "actions": [
    {
      "key": "domain_rating",
      "name": "Domain Rating",
      "method": "GET",
      "endpoint": "/site-explorer/domain-rating",
      "query": {
        "target": "{{ inputs.target }}",
        "date": "{{ inputs.date }}"
      },
      "inputs": [
        {
          "key": "target",
          "label": "Domain or URL",
          "type": "string",
          "required": true
        },
        {
          "key": "date",
          "label": "Date (YYYY-MM-DD)",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "backlinks_stats",
      "name": "Backlinks stats",
      "method": "GET",
      "endpoint": "/site-explorer/backlinks-stats",
      "query": {
        "target": "{{ inputs.target }}",
        "date": "{{ inputs.date }}",
        "mode": "{{ inputs.mode }}"
      },
      "inputs": [
        {
          "key": "target",
          "label": "Domain or URL",
          "type": "string",
          "required": true
        },
        {
          "key": "date",
          "label": "Date (YYYY-MM-DD)",
          "type": "string",
          "required": true
        },
        {
          "key": "mode",
          "label": "Scope",
          "type": "select",
          "default": "subdomains",
          "options": [
            {
              "value": "subdomains",
              "label": "Domain with subdomains"
            },
            {
              "value": "domain",
              "label": "Domain only"
            },
            {
              "value": "prefix",
              "label": "URL prefix"
            },
            {
              "value": "exact",
              "label": "Exact URL"
            }
          ]
        }
      ]
    },
    {
      "key": "site_metrics",
      "name": "Organic metrics",
      "description": "Organic and paid traffic, keywords and cost.",
      "method": "GET",
      "endpoint": "/site-explorer/metrics",
      "query": {
        "target": "{{ inputs.target }}",
        "date": "{{ inputs.date }}",
        "mode": "{{ inputs.mode }}",
        "country": "{{ inputs.country }}"
      },
      "inputs": [
        {
          "key": "target",
          "label": "Domain or URL",
          "type": "string",
          "required": true
        },
        {
          "key": "date",
          "label": "Date (YYYY-MM-DD)",
          "type": "string",
          "required": true
        },
        {
          "key": "mode",
          "label": "Scope",
          "type": "select",
          "default": "subdomains",
          "options": [
            {
              "value": "subdomains",
              "label": "Domain with subdomains"
            },
            {
              "value": "domain",
              "label": "Domain only"
            },
            {
              "value": "prefix",
              "label": "URL prefix"
            },
            {
              "value": "exact",
              "label": "Exact URL"
            }
          ]
        },
        {
          "key": "country",
          "label": "Country (ISO alpha-2)",
          "type": "string",
          "placeholder": "us"
        }
      ]
    },
    {
      "key": "keywords_overview",
      "name": "Keywords overview",
      "method": "GET",
      "endpoint": "/keywords-explorer/overview",
      "query": {
        "keywords": "{{ inputs.keywords }}",
        "country": "{{ inputs.country }}",
        "select": "{{ inputs.select }}"
      },
      "inputs": [
        {
          "key": "keywords",
          "label": "Keywords (comma-separated)",
          "type": "string",
          "required": true
        },
        {
          "key": "country",
          "label": "Country (ISO alpha-2)",
          "type": "string",
          "required": true,
          "default": "us"
        },
        {
          "key": "select",
          "label": "Columns",
          "type": "string",
          "required": true,
          "default": "keyword,volume,difficulty,cpc,traffic_potential"
        }
      ]
    },
    {
      "key": "limits_and_usage",
      "name": "API limits and usage",
      "method": "GET",
      "endpoint": "/subscription-info/limits-and-usage",
      "inputs": []
    }
  ]
}
