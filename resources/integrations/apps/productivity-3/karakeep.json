{
  "key": "karakeep",
  "name": "Karakeep",
  "category": "Productivity",
  "description": "Self-hosted bookmark everything app (ex-Hoarder): save links and notes, search, tag.",
  "website": "https://karakeep.app",
  "docs_url": "https://docs.karakeep.app/api/karakeep-api/",
  "base_url": "{{ credentials.base_url }}/api/v1",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "base_url",
        "label": "Karakeep URL",
        "type": "string",
        "required": true,
        "placeholder": "https://keep.example.com",
        "help": "The address of your Karakeep server, without a trailing slash."
      },
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Karakeep → User Settings → API Keys → New API Key."
      }
    ]
  },
  "actions": [
    {
      "key": "save_link",
      "name": "Save link",
      "description": "Bookmark a web page.",
      "method": "POST",
      "endpoint": "/bookmarks",
      "body": {
        "type": "link",
        "url": "{{ inputs.url }}",
        "title": "{{ inputs.title }}",
        "note": "{{ inputs.note }}"
      },
      "output_fields": {
        "id": "id",
        "title": "title"
      },
      "inputs": [
        {
          "key": "url",
          "label": "URL",
          "type": "string",
          "required": true
        },
        {
          "key": "title",
          "label": "Title",
          "type": "string"
        },
        {
          "key": "note",
          "label": "Note",
          "type": "text"
        }
      ]
    },
    {
      "key": "save_note",
      "name": "Save text note",
      "description": "Save a plain text note.",
      "method": "POST",
      "endpoint": "/bookmarks",
      "body": {
        "type": "text",
        "text": "{{ inputs.text }}",
        "title": "{{ inputs.title }}"
      },
      "output_fields": {
        "id": "id"
      },
      "inputs": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "required": true
        },
        {
          "key": "title",
          "label": "Title",
          "type": "string"
        }
      ]
    },
    {
      "key": "search_bookmarks",
      "name": "Search bookmarks",
      "description": "Full text search across your bookmarks.",
      "method": "GET",
      "endpoint": "/bookmarks/search",
      "query": {
        "q": "{{ inputs.q }}",
        "limit": "{{ inputs.limit }}"
      },
      "output_fields": {
        "ids": "bookmarks.*.id",
        "titles": "bookmarks.*.title"
      },
      "inputs": [
        {
          "key": "q",
          "label": "Search",
          "type": "string",
          "required": true
        },
        {
          "key": "limit",
          "label": "Max results",
          "type": "number",
          "default": 20
        }
      ]
    },
    {
      "key": "get_bookmark",
      "name": "Get bookmark",
      "description": "Fetch one bookmark by ID.",
      "method": "GET",
      "endpoint": "/bookmarks/{{ inputs.id }}",
      "output_fields": {
        "id": "id",
        "title": "title",
        "created": "createdAt"
      },
      "inputs": [
        {
          "key": "id",
          "label": "Bookmark ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "delete_bookmark",
      "name": "Delete bookmark",
      "description": "Delete a bookmark.",
      "method": "DELETE",
      "endpoint": "/bookmarks/{{ inputs.id }}",
      "inputs": [
        {
          "key": "id",
          "label": "Bookmark ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_lists",
      "name": "List lists",
      "description": "Your bookmark lists.",
      "method": "GET",
      "endpoint": "/lists",
      "output_fields": {
        "names": "lists.*.name",
        "ids": "lists.*.id"
      },
      "inputs": []
    }
  ],
  "triggers": [
    {
      "key": "new_bookmark",
      "name": "New bookmark",
      "type": "polling",
      "method": "GET",
      "endpoint": "/bookmarks",
      "query": {
        "limit": 20
      },
      "items_path": "bookmarks",
      "id_field": "id",
      "inputs": [
        {
          "key": "poll_interval",
          "label": "Check every (minutes)",
          "type": "number",
          "default": 5
        }
      ]
    }
  ]
}
