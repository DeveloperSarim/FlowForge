{
  "key": "fanart_tv",
  "name": "Fanart.tv",
  "category": "Video & Media",
  "description": "Fetch posters, backgrounds, logos and album art for movies, shows and music.",
  "website": "https://fanart.tv",
  "docs_url": "https://fanarttv.docs.apiary.io/",
  "base_url": "https://webservice.fanart.tv/v3",
  "auth": {
    "type": "api_key",
    "in": "query",
    "name": "api_key",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Create a free account on fanart.tv, then Your Profile > API Key."
      }
    ]
  },
  "actions": [
    {
      "key": "movie_art",
      "name": "Movie artwork",
      "description": "Artwork for a movie by TMDB or IMDb ID.",
      "method": "GET",
      "endpoint": "/movies/{{ inputs.movie_id }}",
      "output_fields": {
        "name": "name",
        "posters": "movieposter",
        "backgrounds": "moviebackground",
        "logos": "hdmovielogo"
      },
      "inputs": [
        {
          "key": "movie_id",
          "label": "TMDB or IMDb ID",
          "type": "string",
          "required": true,
          "help": "e.g. 603 or tt0133093."
        }
      ]
    },
    {
      "key": "tv_art",
      "name": "TV artwork",
      "description": "Artwork for a show by TheTVDB ID.",
      "method": "GET",
      "endpoint": "/tv/{{ inputs.tv_id }}",
      "output_fields": {
        "name": "name",
        "posters": "tvposter",
        "backgrounds": "showbackground",
        "logos": "hdtvlogo"
      },
      "inputs": [
        {
          "key": "tv_id",
          "label": "TheTVDB ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "music_art",
      "name": "Music artwork",
      "description": "Artwork for an artist by MusicBrainz ID.",
      "method": "GET",
      "endpoint": "/music/{{ inputs.artist_mbid }}",
      "output_fields": {
        "name": "name",
        "thumbs": "artistthumb",
        "backgrounds": "artistbackground",
        "albums": "albums"
      },
      "inputs": [
        {
          "key": "artist_mbid",
          "label": "MusicBrainz artist ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "latest_movies",
      "name": "Latest movie artwork",
      "description": "Movies with newly added artwork.",
      "method": "GET",
      "endpoint": "/movies/latest",
      "output_fields": {
        "ids": "*.id",
        "names": "*.name"
      },
      "inputs": []
    }
  ]
}
