{
  "key": "modernmt",
  "name": "ModernMT",
  "category": "Utilities",
  "description": "Adaptive machine translation and language detection.",
  "brand": "modernmt",
  "website": "https://www.modernmt.com",
  "docs_url": "https://www.modernmt.com/api/",
  "base_url": "https://api.modernmt.com",
  "auth": { "type": "api_key", "in": "header", "name": "MMT-ApiKey", "fields": [
    { "key": "api_key", "label": "License key", "type": "password", "required": true, "help": "ModernMT account → License." }
  ] },
  "actions": [
    {
      "key": "translate",
      "name": "Translate text",
      "method": "GET",
      "endpoint": "/translate",
      "query": { "source": "{{ inputs.source }}", "target": "{{ inputs.target }}", "q": "{{ inputs.q }}", "context_vector": "{{ inputs.context_vector }}", "hints": "{{ inputs.hints }}" },
      "output_path": "data",
      "inputs": [
        { "key": "q", "label": "Text", "type": "text", "required": true },
        { "key": "target", "label": "Target language", "type": "string", "required": true, "placeholder": "it" },
        { "key": "source", "label": "Source language", "type": "string", "help": "Leave empty to auto-detect." },
        { "key": "context_vector", "label": "Context vector", "type": "string", "placeholder": "1234:0.5,5678:0.5" },
        { "key": "hints", "label": "Memory IDs", "type": "string", "placeholder": "1234,5678" }
      ]
    },
    {
      "key": "detect_language",
      "name": "Detect language",
      "method": "GET",
      "endpoint": "/translate/detect",
      "query": { "q": "{{ inputs.q }}" },
      "output_path": "data",
      "inputs": [{ "key": "q", "label": "Text", "type": "text", "required": true }]
    },
    {
      "key": "list_languages",
      "name": "List language pairs",
      "method": "GET",
      "endpoint": "/translate/languages",
      "output_path": "data",
      "inputs": []
    }
  ]
}
