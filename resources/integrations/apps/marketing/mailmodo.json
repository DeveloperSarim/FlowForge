{
  "key": "mailmodo",
  "name": "Mailmodo",
  "category": "Marketing & Email",
  "description": "Add contacts to lists and trigger transactional campaigns.",
  "brand": "mailmodo",
  "website": "https://www.mailmodo.com",
  "docs_url": "https://www.mailmodo.com/developers/",
  "base_url": "https://api.mailmodo.com/api/v1",
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "mmApiKey",
    "fields": [
      {
        "key": "api_key",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "add_to_list",
      "name": "Add contact to list",
      "method": "POST",
      "endpoint": "/addToList",
      "body": {
        "listName": "{{ inputs.list_name }}",
        "email": "{{ inputs.email }}",
        "data": "{{ inputs.data }}"
      },
      "inputs": [
        {
          "key": "list_name",
          "label": "List name",
          "type": "string",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "data",
          "label": "Contact properties",
          "type": "keyvalue"
        }
      ]
    },
    {
      "key": "trigger_campaign",
      "name": "Send transactional campaign",
      "method": "POST",
      "endpoint": "/triggerCampaign/{{ inputs.campaign_id }}",
      "body": {
        "email": "{{ inputs.email }}",
        "data": "{{ inputs.data }}"
      },
      "inputs": [
        {
          "key": "campaign_id",
          "label": "Campaign ID",
          "type": "string",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "data",
          "label": "Personalization data",
          "type": "keyvalue"
        }
      ]
    }
  ]
}
