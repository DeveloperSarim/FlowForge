{
  "key": "plunk",
  "name": "Plunk",
  "category": "Marketing & Email",
  "description": "Track events, send email and create contacts.",
  "brand": "plunk",
  "website": "https://www.useplunk.com",
  "docs_url": "https://docs.useplunk.com/",
  "base_url": "https://api.useplunk.com/v1",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "Secret API key (sk_…)",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "track_event",
      "name": "Track event",
      "method": "POST",
      "endpoint": "/track",
      "body": {
        "event": "{{ inputs.event }}",
        "email": "{{ inputs.email }}",
        "subscribed": "{{ inputs.subscribed }}",
        "data": "{{ inputs.data }}"
      },
      "inputs": [
        {
          "key": "event",
          "label": "Event name",
          "type": "string",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "subscribed",
          "label": "Subscribed",
          "type": "boolean",
          "default": true
        },
        {
          "key": "data",
          "label": "Data",
          "type": "json"
        }
      ]
    },
    {
      "key": "send_email",
      "name": "Send email",
      "method": "POST",
      "endpoint": "/send",
      "body": {
        "to": "{{ inputs.to }}",
        "subject": "{{ inputs.subject }}",
        "body": "{{ inputs.body }}",
        "from": "{{ inputs.from }}",
        "name": "{{ inputs.name }}"
      },
      "inputs": [
        {
          "key": "to",
          "label": "To",
          "type": "string",
          "required": true
        },
        {
          "key": "subject",
          "label": "Subject",
          "type": "string",
          "required": true
        },
        {
          "key": "body",
          "label": "Body (HTML or Markdown)",
          "type": "text",
          "required": true
        },
        {
          "key": "from",
          "label": "From",
          "type": "string"
        },
        {
          "key": "name",
          "label": "From name",
          "type": "string"
        }
      ]
    },
    {
      "key": "create_contact",
      "name": "Create contact",
      "method": "POST",
      "endpoint": "/contacts",
      "body": {
        "email": "{{ inputs.email }}",
        "subscribed": "{{ inputs.subscribed }}",
        "data": "{{ inputs.data }}"
      },
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "subscribed",
          "label": "Subscribed",
          "type": "boolean",
          "default": true
        },
        {
          "key": "data",
          "label": "Data",
          "type": "json"
        }
      ]
    }
  ]
}
