{
  "key": "weatherapi",
  "name": "WeatherAPI.com",
  "category": "Utilities",
  "description": "Current weather, forecasts up to 14 days, astronomy and location search.",
  "brand": "weatherapi",
  "website": "https://www.weatherapi.com",
  "docs_url": "https://www.weatherapi.com/docs/",
  "base_url": "https://api.weatherapi.com/v1",
  "auth": { "type": "api_key", "in": "query", "name": "key", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "current_weather",
      "name": "Get current weather",
      "method": "GET",
      "endpoint": "/current.json",
      "query": { "q": "{{ inputs.q }}", "aqi": "{{ inputs.aqi }}", "lang": "{{ inputs.lang }}" },
      "inputs": [
        { "key": "q", "label": "Location", "type": "string", "required": true, "placeholder": "London", "help": "City, US zip, UK postcode, lat,lon, IP address or auto:ip." },
        { "key": "aqi", "label": "Include air quality", "type": "select", "default": "no", "options": [{ "value": "no", "label": "No" }, { "value": "yes", "label": "Yes" }] },
        { "key": "lang", "label": "Language", "type": "string", "placeholder": "en" }
      ]
    },
    {
      "key": "forecast",
      "name": "Get forecast",
      "method": "GET",
      "endpoint": "/forecast.json",
      "query": { "q": "{{ inputs.q }}", "days": "{{ inputs.days }}", "aqi": "{{ inputs.aqi }}", "alerts": "{{ inputs.alerts }}", "lang": "{{ inputs.lang }}" },
      "inputs": [
        { "key": "q", "label": "Location", "type": "string", "required": true, "placeholder": "London", "help": "City, US zip, UK postcode, lat,lon, IP address or auto:ip." },
        { "key": "days", "label": "Days", "type": "number", "default": 3, "help": "1 to 14 (depends on your plan)." },
        { "key": "aqi", "label": "Include air quality", "type": "select", "default": "no", "options": [{ "value": "no", "label": "No" }, { "value": "yes", "label": "Yes" }] },
        { "key": "alerts", "label": "Include weather alerts", "type": "select", "default": "no", "options": [{ "value": "no", "label": "No" }, { "value": "yes", "label": "Yes" }] },
        { "key": "lang", "label": "Language", "type": "string", "placeholder": "en" }
      ]
    },
    {
      "key": "astronomy",
      "name": "Get sunrise, sunset and moon",
      "method": "GET",
      "endpoint": "/astronomy.json",
      "query": { "q": "{{ inputs.q }}", "dt": "{{ inputs.dt }}" },
      "inputs": [
        { "key": "q", "label": "Location", "type": "string", "required": true, "placeholder": "London" },
        { "key": "dt", "label": "Date", "type": "string", "required": true, "placeholder": "2026-01-31" }
      ]
    },
    {
      "key": "search_locations",
      "name": "Search locations",
      "method": "GET",
      "endpoint": "/search.json",
      "query": { "q": "{{ inputs.q }}" },
      "inputs": [{ "key": "q", "label": "Search", "type": "string", "required": true, "placeholder": "Lond" }]
    }
  ]
}
