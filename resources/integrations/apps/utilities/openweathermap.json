{
  "key": "openweathermap",
  "name": "OpenWeatherMap",
  "category": "Utilities",
  "description": "Current weather, 5-day forecasts, air quality and geocoding for any place.",
  "brand": "openweathermap",
  "website": "https://openweathermap.org",
  "docs_url": "https://openweathermap.org/api",
  "popular": true,
  "base_url": "https://api.openweathermap.org",
  "auth": { "type": "api_key", "in": "query", "name": "appid", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true, "help": "From home.openweathermap.org/api_keys" }
  ] },
  "actions": [
    {
      "key": "current_weather",
      "name": "Get current weather",
      "description": "Current conditions for a city or coordinates.",
      "method": "GET",
      "endpoint": "/data/2.5/weather",
      "query": { "q": "{{ inputs.city }}", "lat": "{{ inputs.lat }}", "lon": "{{ inputs.lon }}", "units": "{{ inputs.units }}", "lang": "{{ inputs.lang }}" },
      "inputs": [
        { "key": "city", "label": "City", "type": "string", "placeholder": "London,GB", "help": "City name, optionally with a country code. Or fill latitude/longitude instead." },
        { "key": "lat", "label": "Latitude", "type": "number" },
        { "key": "lon", "label": "Longitude", "type": "number" },
        { "key": "units", "label": "Units", "type": "select", "default": "metric", "options": [
          { "value": "metric", "label": "Metric (°C, m/s)" }, { "value": "imperial", "label": "Imperial (°F, mph)" }, { "value": "standard", "label": "Standard (K)" }
        ] },
        { "key": "lang", "label": "Language", "type": "string", "placeholder": "en" }
      ]
    },
    {
      "key": "forecast",
      "name": "Get 5-day forecast",
      "description": "Forecast in 3-hour steps for the next 5 days.",
      "method": "GET",
      "endpoint": "/data/2.5/forecast",
      "query": { "q": "{{ inputs.city }}", "lat": "{{ inputs.lat }}", "lon": "{{ inputs.lon }}", "units": "{{ inputs.units }}", "cnt": "{{ inputs.cnt }}", "lang": "{{ inputs.lang }}" },
      "inputs": [
        { "key": "city", "label": "City", "type": "string", "placeholder": "London,GB", "help": "City name, optionally with a country code. Or fill latitude/longitude instead." },
        { "key": "lat", "label": "Latitude", "type": "number" },
        { "key": "lon", "label": "Longitude", "type": "number" },
        { "key": "units", "label": "Units", "type": "select", "default": "metric", "options": [
          { "value": "metric", "label": "Metric (°C, m/s)" }, { "value": "imperial", "label": "Imperial (°F, mph)" }, { "value": "standard", "label": "Standard (K)" }
        ] },
        { "key": "cnt", "label": "Number of 3-hour steps", "type": "number", "help": "Max 40. Leave empty for all." },
        { "key": "lang", "label": "Language", "type": "string", "placeholder": "en" }
      ]
    },
    {
      "key": "air_pollution",
      "name": "Get air pollution",
      "description": "Current air quality index and pollutant levels.",
      "method": "GET",
      "endpoint": "/data/2.5/air_pollution",
      "query": { "lat": "{{ inputs.lat }}", "lon": "{{ inputs.lon }}" },
      "inputs": [
        { "key": "lat", "label": "Latitude", "type": "number", "required": true },
        { "key": "lon", "label": "Longitude", "type": "number", "required": true }
      ]
    },
    {
      "key": "geocode",
      "name": "Find coordinates of a place",
      "description": "Turns a place name into latitude/longitude.",
      "method": "GET",
      "endpoint": "/geo/1.0/direct",
      "query": { "q": "{{ inputs.q }}", "limit": "{{ inputs.limit }}" },
      "inputs": [
        { "key": "q", "label": "Place", "type": "string", "required": true, "placeholder": "Paris,FR" },
        { "key": "limit", "label": "Max results", "type": "number", "default": 5 }
      ]
    }
  ]
}
