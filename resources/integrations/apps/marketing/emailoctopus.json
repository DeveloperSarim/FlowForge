{
  "key": "emailoctopus",
  "name": "EmailOctopus",
  "category": "Marketing & Email",
  "description": "Add contacts to lists and list your lists.",
  "brand": "emailoctopus",
  "website": "https://emailoctopus.com",
  "docs_url": "https://emailoctopus.com/api-documentation/v2",
  "base_url": "https://api.emailoctopus.com",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "create_contact",
      "name": "Add contact to list",
      "method": "POST",
      "endpoint": "/lists/{{ inputs.list_id }}/contacts",
      "body": {
        "email_address": "{{ inputs.email }}",
        "fields": "{{ inputs.fields }}",
        "status": "{{ inputs.status }}"
      },
      "inputs": [
        {
          "key": "list_id",
          "label": "List ID",
          "type": "string",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "fields",
          "label": "Fields",
          "type": "keyvalue",
          "help": "Field tag → value, e.g. FirstName → Ada"
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "options": [
            {
              "value": "subscribed",
              "label": "Subscribed"
            },
            {
              "value": "pending",
              "label": "Pending"
            },
            {
              "value": "unsubscribed",
              "label": "Unsubscribed"
            }
          ]
        }
      ]
    },
    {
      "key": "list_lists",
      "name": "List lists",
      "method": "GET",
      "endpoint": "/lists",
      "output_path": "data",
      "inputs": []
    }
  ]
}
