{
  "key": "opencage",
  "name": "OpenCage",
  "category": "Utilities",
  "description": "Forward and reverse geocoding built on open data.",
  "brand": "opencage",
  "website": "https://opencagedata.com",
  "docs_url": "https://opencagedata.com/api",
  "base_url": "https://api.opencagedata.com/geocode/v1",
  "auth": { "type": "api_key", "in": "query", "name": "key", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "geocode",
      "name": "Geocode address",
      "method": "GET",
      "endpoint": "/json",
      "query": { "q": "{{ inputs.q }}", "countrycode": "{{ inputs.countrycode }}", "language": "{{ inputs.language }}", "limit": "{{ inputs.limit }}", "no_annotations": 1 },
      "output_path": "results",
      "inputs": [
        { "key": "q", "label": "Address or place", "type": "string", "required": true, "placeholder": "Brandenburger Tor, Berlin" },
        { "key": "countrycode", "label": "Country codes", "type": "string", "placeholder": "de,at", "help": "ISO 3166 alpha-2, comma-separated." },
        { "key": "language", "label": "Language", "type": "string", "placeholder": "en" },
        { "key": "limit", "label": "Max results", "type": "number", "default": 5 }
      ]
    },
    {
      "key": "reverse_geocode",
      "name": "Reverse geocode",
      "method": "GET",
      "endpoint": "/json",
      "query": { "q": "{{ inputs.coordinates }}", "language": "{{ inputs.language }}", "no_annotations": 1 },
      "output_path": "results",
      "inputs": [
        { "key": "coordinates", "label": "Coordinates (lat,lng)", "type": "string", "required": true, "placeholder": "52.5163,13.3777" },
        { "key": "language", "label": "Language", "type": "string", "placeholder": "en" }
      ]
    }
  ]
}
