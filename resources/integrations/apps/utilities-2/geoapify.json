{
  "key": "geoapify",
  "name": "Geoapify",
  "category": "Utilities",
  "description": "Geocoding, reverse geocoding, address autocomplete, places search and routing.",
  "brand": "geoapify",
  "website": "https://www.geoapify.com",
  "docs_url": "https://apidocs.geoapify.com",
  "base_url": "https://api.geoapify.com",
  "auth": { "type": "api_key", "in": "query", "name": "apiKey", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true, "help": "From myprojects.geoapify.com." }
  ] },
  "actions": [
    {
      "key": "geocode",
      "name": "Geocode address",
      "method": "GET",
      "endpoint": "/v1/geocode/search",
      "query": { "text": "{{ inputs.text }}", "filter": "{{ inputs.filter }}", "lang": "{{ inputs.lang }}", "limit": "{{ inputs.limit }}", "format": "json" },
      "inputs": [
        { "key": "text", "label": "Address", "type": "string", "required": true, "placeholder": "38 Upper Montagu Street, London" },
        { "key": "filter", "label": "Filter", "type": "string", "placeholder": "countrycode:gb,ie" },
        { "key": "lang", "label": "Language", "type": "string", "placeholder": "en" },
        { "key": "limit", "label": "Limit", "type": "number" }
      ]
    },
    {
      "key": "reverse_geocode",
      "name": "Reverse geocode",
      "method": "GET",
      "endpoint": "/v1/geocode/reverse",
      "query": { "lat": "{{ inputs.lat }}", "lon": "{{ inputs.lon }}", "lang": "{{ inputs.lang }}", "format": "json" },
      "inputs": [
        { "key": "lat", "label": "Latitude", "type": "number", "required": true },
        { "key": "lon", "label": "Longitude", "type": "number", "required": true },
        { "key": "lang", "label": "Language", "type": "string" }
      ]
    },
    {
      "key": "autocomplete",
      "name": "Autocomplete address",
      "method": "GET",
      "endpoint": "/v1/geocode/autocomplete",
      "query": { "text": "{{ inputs.text }}", "filter": "{{ inputs.filter }}", "limit": "{{ inputs.limit }}", "format": "json" },
      "inputs": [
        { "key": "text", "label": "Partial address", "type": "string", "required": true },
        { "key": "filter", "label": "Filter", "type": "string", "placeholder": "countrycode:us" },
        { "key": "limit", "label": "Limit", "type": "number" }
      ]
    },
    {
      "key": "search_places",
      "name": "Search places",
      "method": "GET",
      "endpoint": "/v2/places",
      "query": { "categories": "{{ inputs.categories }}", "filter": "{{ inputs.filter }}", "bias": "{{ inputs.bias }}", "limit": "{{ inputs.limit }}" },
      "inputs": [
        { "key": "categories", "label": "Categories", "type": "string", "required": true, "placeholder": "catering.restaurant,commercial.supermarket" },
        { "key": "filter", "label": "Area filter", "type": "string", "placeholder": "circle:-0.1278,51.5074,5000", "help": "circle:lon,lat,radiusMeters or rect:lon1,lat1,lon2,lat2." },
        { "key": "bias", "label": "Bias", "type": "string", "placeholder": "proximity:-0.1278,51.5074" },
        { "key": "limit", "label": "Limit", "type": "number", "default": 20 }
      ]
    },
    {
      "key": "route",
      "name": "Calculate route",
      "method": "GET",
      "endpoint": "/v1/routing",
      "query": { "waypoints": "{{ inputs.waypoints }}", "mode": "{{ inputs.mode }}" },
      "inputs": [
        { "key": "waypoints", "label": "Waypoints", "type": "string", "required": true, "placeholder": "51.5074,-0.1278|51.4545,-2.5879", "help": "lat,lon pairs separated by |." },
        { "key": "mode", "label": "Mode", "type": "select", "default": "drive", "options": [
          { "value": "drive", "label": "Drive" }, { "value": "truck", "label": "Truck" }, { "value": "bicycle", "label": "Bicycle" },
          { "value": "walk", "label": "Walk" }, { "value": "transit", "label": "Transit" }
        ] }
      ]
    },
    {
      "key": "ip_info",
      "name": "IP geolocation",
      "method": "GET",
      "endpoint": "/v1/ipinfo",
      "query": { "ip": "{{ inputs.ip }}" },
      "inputs": [{ "key": "ip", "label": "IP address", "type": "string", "help": "Leave empty for the caller's IP." }]
    }
  ]
}
