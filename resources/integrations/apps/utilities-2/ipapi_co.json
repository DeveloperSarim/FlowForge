{
  "key": "ipapi_co",
  "name": "ipapi.co",
  "category": "Utilities",
  "description": "Look up country, city, timezone and network details for an IP address.",
  "brand": "ipapi",
  "website": "https://ipapi.co",
  "docs_url": "https://ipapi.co/api/",
  "base_url": "https://ipapi.co",
  "auth": [
    { "type": "none" },
    { "type": "api_key", "in": "query", "name": "key", "fields": [
      { "key": "api_key", "label": "API key", "type": "password", "required": true, "help": "Paid plans: from your ipapi.co account. The free tier works without a key." }
    ] }
  ],
  "actions": [
    {
      "key": "lookup_ip",
      "name": "Look up IP address",
      "method": "GET",
      "endpoint": "/{{ inputs.ip }}/json/",
      "error_path": "reason",
      "inputs": [{ "key": "ip", "label": "IP address", "type": "string", "required": true, "placeholder": "8.8.8.8" }]
    }
  ]
}
