{
  "key": "pusher_beams",
  "name": "Pusher Beams",
  "category": "Communication",
  "description": "Send web, Android and iOS push notifications to interests or users.",
  "brand": "pusher",
  "website": "https://pusher.com/beams",
  "docs_url": "https://pusher.com/docs/beams/reference/publish-api/",
  "base_url": "https://{{ credentials.instance_id }}.pushnotifications.pusher.com/publish_api/v1/instances/{{ credentials.instance_id }}",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        { "key": "instance_id", "label": "Instance ID", "type": "string", "required": true },
        { "key": "token", "label": "Primary key", "type": "password", "required": true }
      ]
    }
  ],
  "actions": [
    {
      "key": "publish_to_interests",
      "name": "Publish to interests",
      "method": "POST",
      "endpoint": "/publishes/interests",
      "body": {
        "interests": "{{ inputs.interests }}",
        "web": { "notification": { "title": "{{ inputs.title }}", "body": "{{ inputs.body }}", "deep_link": "{{ inputs.deep_link }}" } },
        "fcm": { "notification": { "title": "{{ inputs.title }}", "body": "{{ inputs.body }}" } },
        "apns": { "aps": { "alert": { "title": "{{ inputs.title }}", "body": "{{ inputs.body }}" } } }
      },
      "inputs": [
        { "key": "interests", "label": "Interests", "type": "list", "required": true, "placeholder": "hello" },
        { "key": "title", "label": "Title", "type": "string", "required": true },
        { "key": "body", "label": "Body", "type": "text", "required": true },
        { "key": "deep_link", "label": "Web click URL", "type": "string" }
      ]
    },
    {
      "key": "publish_to_users",
      "name": "Publish to users",
      "method": "POST",
      "endpoint": "/publishes/users",
      "body": {
        "users": "{{ inputs.users }}",
        "web": { "notification": { "title": "{{ inputs.title }}", "body": "{{ inputs.body }}", "deep_link": "{{ inputs.deep_link }}" } },
        "fcm": { "notification": { "title": "{{ inputs.title }}", "body": "{{ inputs.body }}" } },
        "apns": { "aps": { "alert": { "title": "{{ inputs.title }}", "body": "{{ inputs.body }}" } } }
      },
      "inputs": [
        { "key": "users", "label": "User IDs", "type": "list", "required": true },
        { "key": "title", "label": "Title", "type": "string", "required": true },
        { "key": "body", "label": "Body", "type": "text", "required": true },
        { "key": "deep_link", "label": "Web click URL", "type": "string" }
      ]
    }
  ]
}
