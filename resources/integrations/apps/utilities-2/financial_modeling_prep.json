{
  "key": "financial_modeling_prep",
  "name": "Financial Modeling Prep",
  "category": "Utilities",
  "description": "Stock quotes, company profiles, financial statements and price history.",
  "brand": "financialmodelingprep",
  "website": "https://site.financialmodelingprep.com",
  "docs_url": "https://site.financialmodelingprep.com/developer/docs",
  "base_url": "https://financialmodelingprep.com/stable",
  "auth": { "type": "api_key", "in": "query", "name": "apikey", "fields": [
    { "key": "api_key", "label": "API key", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "quote",
      "name": "Get quote",
      "method": "GET",
      "endpoint": "/quote",
      "query": { "symbol": "{{ inputs.symbol }}" },
      "error_path": "Error Message",
      "inputs": [{ "key": "symbol", "label": "Symbol", "type": "string", "required": true, "placeholder": "AAPL" }]
    },
    {
      "key": "profile",
      "name": "Get company profile",
      "method": "GET",
      "endpoint": "/profile",
      "query": { "symbol": "{{ inputs.symbol }}" },
      "error_path": "Error Message",
      "inputs": [{ "key": "symbol", "label": "Symbol", "type": "string", "required": true }]
    },
    {
      "key": "search_symbol",
      "name": "Search symbols",
      "method": "GET",
      "endpoint": "/search-symbol",
      "query": { "query": "{{ inputs.query }}", "limit": "{{ inputs.limit }}", "exchange": "{{ inputs.exchange }}" },
      "error_path": "Error Message",
      "inputs": [
        { "key": "query", "label": "Search", "type": "string", "required": true },
        { "key": "limit", "label": "Limit", "type": "number" },
        { "key": "exchange", "label": "Exchange", "type": "string", "placeholder": "NASDAQ" }
      ]
    },
    {
      "key": "income_statement",
      "name": "Get income statements",
      "method": "GET",
      "endpoint": "/income-statement",
      "query": { "symbol": "{{ inputs.symbol }}", "period": "{{ inputs.period }}", "limit": "{{ inputs.limit }}" },
      "error_path": "Error Message",
      "inputs": [
        { "key": "symbol", "label": "Symbol", "type": "string", "required": true },
        { "key": "period", "label": "Period", "type": "select", "options": [{ "value": "annual", "label": "Annual" }, { "value": "quarter", "label": "Quarterly" }] },
        { "key": "limit", "label": "Limit", "type": "number" }
      ]
    },
    {
      "key": "historical_prices",
      "name": "Get daily price history",
      "method": "GET",
      "endpoint": "/historical-price-eod/full",
      "query": { "symbol": "{{ inputs.symbol }}", "from": "{{ inputs.from }}", "to": "{{ inputs.to }}" },
      "error_path": "Error Message",
      "inputs": [
        { "key": "symbol", "label": "Symbol", "type": "string", "required": true },
        { "key": "from", "label": "From", "type": "string", "placeholder": "2025-01-01" },
        { "key": "to", "label": "To", "type": "string", "placeholder": "2025-06-30" }
      ]
    }
  ]
}
