{
  "key": "smartrecruiters",
  "name": "SmartRecruiters",
  "category": "HR & Recruiting",
  "description": "List jobs and find or add candidates in SmartRecruiters.",
  "brand": "smartrecruiters",
  "website": "https://www.smartrecruiters.com",
  "docs_url": "https://developers.smartrecruiters.com/reference",
  "base_url": "https://api.smartrecruiters.com",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "X-SmartToken",
      "fields": [
        {
          "key": "api_key",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Settings > Admin > Apps & Integrations > API."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_jobs",
      "name": "List jobs",
      "method": "GET",
      "endpoint": "/jobs",
      "query": {
        "q": "{{ inputs.q }}",
        "limit": "{{ inputs.limit }}"
      },
      "output_path": "content",
      "inputs": [
        {
          "key": "q",
          "label": "Search",
          "type": "string"
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50
        }
      ]
    },
    {
      "key": "search_candidates",
      "name": "Search candidates",
      "method": "GET",
      "endpoint": "/candidates",
      "query": {
        "q": "{{ inputs.q }}"
      },
      "output_path": "content",
      "inputs": [
        {
          "key": "q",
          "label": "Search (name or email)",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "get_candidate",
      "name": "Get candidate",
      "method": "GET",
      "endpoint": "/candidates/{{ inputs.candidate_id }}",
      "inputs": [
        {
          "key": "candidate_id",
          "label": "Candidate ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "add_candidate",
      "name": "Add candidate to job",
      "method": "POST",
      "endpoint": "/jobs/{{ inputs.job_id }}/candidates",
      "body": {
        "firstName": "{{ inputs.first_name }}",
        "lastName": "{{ inputs.last_name }}",
        "email": "{{ inputs.email }}",
        "phoneNumber": "{{ inputs.phone_number }}"
      },
      "inputs": [
        {
          "key": "job_id",
          "label": "Job ID",
          "type": "string",
          "required": true
        },
        {
          "key": "first_name",
          "label": "First name",
          "type": "string",
          "required": true
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string",
          "required": true
        },
        {
          "key": "phone_number",
          "label": "Phone",
          "type": "string"
        }
      ]
    }
  ]
}
