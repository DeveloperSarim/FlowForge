{
  "key": "ticktick",
  "name": "TickTick",
  "category": "Productivity",
  "description": "Create and complete TickTick tasks and read projects.",
  "brand": "ticktick",
  "website": "https://ticktick.com",
  "docs_url": "https://developer.ticktick.com/docs",
  "base_url": "https://api.ticktick.com/open/v1",
  "auth": [
    {
      "type": "oauth2",
      "authorize_url": "https://ticktick.com/oauth/authorize",
      "token_url": "https://ticktick.com/oauth/token",
      "scopes": [
        "tasks:read",
        "tasks:write"
      ],
      "client_auth": "basic"
    },
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "Access token",
          "type": "password",
          "required": true
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "create_task",
      "name": "Create task",
      "method": "POST",
      "endpoint": "/task",
      "body": {
        "title": "{{ inputs.title }}",
        "content": "{{ inputs.content }}",
        "projectId": "{{ inputs.project_id }}",
        "dueDate": "{{ inputs.due_date }}",
        "isAllDay": "{{ inputs.is_all_day }}",
        "timeZone": "{{ inputs.time_zone }}",
        "priority": "{{ inputs.priority }}"
      },
      "inputs": [
        {
          "key": "title",
          "label": "Title",
          "type": "string",
          "required": true
        },
        {
          "key": "content",
          "label": "Notes",
          "type": "text"
        },
        {
          "key": "project_id",
          "label": "Project ID",
          "type": "string",
          "help": "Empty = Inbox."
        },
        {
          "key": "due_date",
          "label": "Due",
          "type": "string",
          "placeholder": "2026-10-12T17:00:00+0000",
          "help": "Format yyyy-MM-dd'T'HH:mm:ssZ."
        },
        {
          "key": "is_all_day",
          "label": "All day",
          "type": "boolean"
        },
        {
          "key": "time_zone",
          "label": "Time zone",
          "type": "string",
          "placeholder": "Europe/London"
        },
        {
          "key": "priority",
          "label": "Priority",
          "type": "number",
          "help": "0 none, 1 low, 3 medium, 5 high."
        }
      ]
    },
    {
      "key": "complete_task",
      "name": "Complete task",
      "method": "POST",
      "endpoint": "/project/{{ inputs.project_id }}/task/{{ inputs.task_id }}/complete",
      "inputs": [
        {
          "key": "project_id",
          "label": "Project ID",
          "type": "string",
          "required": true
        },
        {
          "key": "task_id",
          "label": "Task ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "get_task",
      "name": "Get task",
      "method": "GET",
      "endpoint": "/project/{{ inputs.project_id }}/task/{{ inputs.task_id }}",
      "inputs": [
        {
          "key": "project_id",
          "label": "Project ID",
          "type": "string",
          "required": true
        },
        {
          "key": "task_id",
          "label": "Task ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "list_projects",
      "name": "List projects",
      "method": "GET",
      "endpoint": "/project",
      "inputs": []
    },
    {
      "key": "get_project_data",
      "name": "Get project with tasks",
      "method": "GET",
      "endpoint": "/project/{{ inputs.project_id }}/data",
      "inputs": [
        {
          "key": "project_id",
          "label": "Project ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
