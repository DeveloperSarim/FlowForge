{
  "key": "readme_io",
  "name": "ReadMe",
  "category": "Productivity",
  "description": "Read, create and update ReadMe guide pages and changelogs.",
  "brand": "readme",
  "website": "https://readme.com",
  "docs_url": "https://docs.readme.com/main/reference/api-migration-guide",
  "base_url": "https://api.readme.com/v2",
  "auth": [
    {
      "type": "bearer",
      "fields": [
        {
          "key": "token",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Project settings > API keys."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "get_project",
      "name": "Get project",
      "method": "GET",
      "endpoint": "/projects/me",
      "inputs": []
    },
    {
      "key": "get_guide",
      "name": "Get guide page",
      "method": "GET",
      "endpoint": "/branches/{{ inputs.branch }}/guides/{{ inputs.slug }}",
      "inputs": [
        {
          "key": "branch",
          "label": "Branch / version",
          "type": "string",
          "required": true,
          "default": "stable"
        },
        {
          "key": "slug",
          "label": "Page slug",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "create_guide",
      "name": "Create guide page",
      "method": "POST",
      "endpoint": "/branches/{{ inputs.branch }}/guides",
      "body": {
        "title": "{{ inputs.title }}",
        "category": {
          "uri": "{{ inputs.category_uri }}"
        },
        "content": {
          "body": "{{ inputs.body }}"
        },
        "slug": "{{ inputs.slug }}",
        "parent": {
          "uri": "{{ inputs.parent_uri }}"
        }
      },
      "inputs": [
        {
          "key": "branch",
          "label": "Branch / version",
          "type": "string",
          "required": true,
          "default": "stable"
        },
        {
          "key": "title",
          "label": "Title",
          "type": "string",
          "required": true
        },
        {
          "key": "category_uri",
          "label": "Category URI",
          "type": "string",
          "required": true,
          "placeholder": "/branches/stable/categories/guides/Getting Started"
        },
        {
          "key": "body",
          "label": "Body (Markdown)",
          "type": "text"
        },
        {
          "key": "slug",
          "label": "Slug",
          "type": "string"
        },
        {
          "key": "parent_uri",
          "label": "Parent page URI",
          "type": "string"
        }
      ]
    },
    {
      "key": "update_guide",
      "name": "Update guide page",
      "method": "PATCH",
      "endpoint": "/branches/{{ inputs.branch }}/guides/{{ inputs.slug }}",
      "body": {
        "title": "{{ inputs.title }}",
        "content": {
          "body": "{{ inputs.body }}"
        }
      },
      "inputs": [
        {
          "key": "branch",
          "label": "Branch / version",
          "type": "string",
          "required": true,
          "default": "stable"
        },
        {
          "key": "slug",
          "label": "Page slug",
          "type": "string",
          "required": true
        },
        {
          "key": "title",
          "label": "Title",
          "type": "string"
        },
        {
          "key": "body",
          "label": "Body (Markdown)",
          "type": "text"
        }
      ]
    },
    {
      "key": "list_changelogs",
      "name": "List changelogs",
      "method": "GET",
      "endpoint": "/changelogs",
      "inputs": []
    }
  ]
}
