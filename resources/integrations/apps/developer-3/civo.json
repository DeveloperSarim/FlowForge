{
  "key": "civo",
  "name": "Civo",
  "category": "Developer Tools",
  "description": "Manage Civo cloud instances and Kubernetes clusters.",
  "brand": "civo",
  "website": "https://www.civo.com",
  "docs_url": "https://www.civo.com/api",
  "base_url": "https://api.civo.com/v2",
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Civo dashboard → Settings → Profile → Security → API key."
      }
    ]
  },
  "actions": [
    {
      "key": "list_instances",
      "name": "List instances",
      "description": "List instances in a region.",
      "method": "GET",
      "endpoint": "/instances",
      "query": {
        "region": "{{ inputs.region }}"
      },
      "output_fields": {
        "instances": "items"
      },
      "inputs": [
        {
          "key": "region",
          "label": "Region",
          "type": "select",
          "required": true,
          "default": "LON1",
          "options": [
            {
              "value": "LON1",
              "label": "London"
            },
            {
              "value": "FRA1",
              "label": "Frankfurt"
            },
            {
              "value": "NYC1",
              "label": "New York"
            },
            {
              "value": "PHX1",
              "label": "Phoenix"
            },
            {
              "value": "MUM1",
              "label": "Mumbai"
            }
          ]
        }
      ]
    },
    {
      "key": "get_instance",
      "name": "Get instance",
      "description": "Get an instance's status and IP.",
      "method": "GET",
      "endpoint": "/instances/{{ inputs.instance_id }}",
      "query": {
        "region": "{{ inputs.region }}"
      },
      "output_fields": {
        "hostname": "hostname",
        "status": "status",
        "public_ip": "public_ip"
      },
      "inputs": [
        {
          "key": "region",
          "label": "Region",
          "type": "select",
          "required": true,
          "default": "LON1",
          "options": [
            {
              "value": "LON1",
              "label": "London"
            },
            {
              "value": "FRA1",
              "label": "Frankfurt"
            },
            {
              "value": "NYC1",
              "label": "New York"
            },
            {
              "value": "PHX1",
              "label": "Phoenix"
            },
            {
              "value": "MUM1",
              "label": "Mumbai"
            }
          ]
        },
        {
          "key": "instance_id",
          "label": "Instance ID",
          "type": "string",
          "required": true,
          "help": "Use List instances."
        }
      ]
    },
    {
      "key": "reboot_instance",
      "name": "Reboot instance",
      "description": "Reboot an instance.",
      "method": "POST",
      "endpoint": "/instances/{{ inputs.instance_id }}/reboots",
      "query": {
        "region": "{{ inputs.region }}"
      },
      "inputs": [
        {
          "key": "region",
          "label": "Region",
          "type": "select",
          "required": true,
          "default": "LON1",
          "options": [
            {
              "value": "LON1",
              "label": "London"
            },
            {
              "value": "FRA1",
              "label": "Frankfurt"
            },
            {
              "value": "NYC1",
              "label": "New York"
            },
            {
              "value": "PHX1",
              "label": "Phoenix"
            },
            {
              "value": "MUM1",
              "label": "Mumbai"
            }
          ]
        },
        {
          "key": "instance_id",
          "label": "Instance ID",
          "type": "string",
          "required": true,
          "help": "Use List instances."
        }
      ]
    },
    {
      "key": "stop_instance",
      "name": "Stop instance",
      "description": "Shut down an instance.",
      "method": "PUT",
      "endpoint": "/instances/{{ inputs.instance_id }}/stop",
      "query": {
        "region": "{{ inputs.region }}"
      },
      "inputs": [
        {
          "key": "region",
          "label": "Region",
          "type": "select",
          "required": true,
          "default": "LON1",
          "options": [
            {
              "value": "LON1",
              "label": "London"
            },
            {
              "value": "FRA1",
              "label": "Frankfurt"
            },
            {
              "value": "NYC1",
              "label": "New York"
            },
            {
              "value": "PHX1",
              "label": "Phoenix"
            },
            {
              "value": "MUM1",
              "label": "Mumbai"
            }
          ]
        },
        {
          "key": "instance_id",
          "label": "Instance ID",
          "type": "string",
          "required": true,
          "help": "Use List instances."
        }
      ]
    },
    {
      "key": "start_instance",
      "name": "Start instance",
      "description": "Start a stopped instance.",
      "method": "PUT",
      "endpoint": "/instances/{{ inputs.instance_id }}/start",
      "query": {
        "region": "{{ inputs.region }}"
      },
      "inputs": [
        {
          "key": "region",
          "label": "Region",
          "type": "select",
          "required": true,
          "default": "LON1",
          "options": [
            {
              "value": "LON1",
              "label": "London"
            },
            {
              "value": "FRA1",
              "label": "Frankfurt"
            },
            {
              "value": "NYC1",
              "label": "New York"
            },
            {
              "value": "PHX1",
              "label": "Phoenix"
            },
            {
              "value": "MUM1",
              "label": "Mumbai"
            }
          ]
        },
        {
          "key": "instance_id",
          "label": "Instance ID",
          "type": "string",
          "required": true,
          "help": "Use List instances."
        }
      ]
    },
    {
      "key": "list_kubernetes_clusters",
      "name": "List Kubernetes clusters",
      "description": "List Kubernetes clusters in a region.",
      "method": "GET",
      "endpoint": "/kubernetes/clusters",
      "query": {
        "region": "{{ inputs.region }}"
      },
      "output_fields": {
        "clusters": "items"
      },
      "inputs": [
        {
          "key": "region",
          "label": "Region",
          "type": "select",
          "required": true,
          "default": "LON1",
          "options": [
            {
              "value": "LON1",
              "label": "London"
            },
            {
              "value": "FRA1",
              "label": "Frankfurt"
            },
            {
              "value": "NYC1",
              "label": "New York"
            },
            {
              "value": "PHX1",
              "label": "Phoenix"
            },
            {
              "value": "MUM1",
              "label": "Mumbai"
            }
          ]
        }
      ]
    }
  ]
}
