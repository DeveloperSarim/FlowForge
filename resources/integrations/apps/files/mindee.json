{
  "key": "mindee",
  "name": "Mindee",
  "category": "Files & Documents",
  "description": "Extract data from invoices, receipts and financial documents.",
  "brand": "mindee",
  "website": "https://www.mindee.com",
  "docs_url": "https://developers.mindee.com/docs",
  "base_url": "https://api.mindee.net/v1",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "Authorization",
      "prefix": "Token "
    }
  ],
  "actions": [
    {
      "key": "parse_invoice",
      "name": "Parse invoice",
      "method": "POST",
      "endpoint": "/products/mindee/invoices/v4/predict",
      "timeout": 120,
      "body": {
        "document": "{{ inputs.document_url }}"
      },
      "output_path": "document.inference.prediction",
      "inputs": [
        {
          "key": "document_url",
          "label": "Document URL",
          "type": "string",
          "required": true,
          "help": "Public URL of a PDF or image."
        }
      ]
    },
    {
      "key": "parse_receipt",
      "name": "Parse receipt",
      "method": "POST",
      "endpoint": "/products/mindee/expense_receipts/v5/predict",
      "timeout": 120,
      "body": {
        "document": "{{ inputs.document_url }}"
      },
      "output_path": "document.inference.prediction",
      "inputs": [
        {
          "key": "document_url",
          "label": "Document URL",
          "type": "string",
          "required": true,
          "help": "Public URL of a PDF or image."
        }
      ]
    },
    {
      "key": "parse_financial_document",
      "name": "Parse financial document",
      "method": "POST",
      "endpoint": "/products/mindee/financial_document/v1/predict",
      "timeout": 120,
      "body": {
        "document": "{{ inputs.document_url }}"
      },
      "output_path": "document.inference.prediction",
      "inputs": [
        {
          "key": "document_url",
          "label": "Document URL",
          "type": "string",
          "required": true,
          "help": "Public URL of a PDF or image."
        }
      ]
    }
  ]
}
