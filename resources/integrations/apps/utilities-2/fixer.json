{
  "key": "fixer",
  "name": "Fixer",
  "category": "Utilities",
  "description": "Foreign exchange rates and currency conversion for 170 currencies.",
  "brand": "fixer",
  "website": "https://fixer.io",
  "docs_url": "https://fixer.io/documentation",
  "base_url": "https://data.fixer.io/api",
  "auth": { "type": "api_key", "in": "query", "name": "access_key", "fields": [
    { "key": "api_key", "label": "Access key", "type": "password", "required": true }
  ] },
  "actions": [
    {
      "key": "latest_rates",
      "name": "Get latest rates",
      "method": "GET",
      "endpoint": "/latest",
      "query": { "base": "{{ inputs.base }}", "symbols": "{{ inputs.symbols }}" },
      "error_path": "error",
      "inputs": [
        { "key": "base", "label": "Base currency", "type": "string", "placeholder": "EUR", "help": "Changing the base needs a paid plan." },
        { "key": "symbols", "label": "Only these currencies", "type": "string", "placeholder": "USD,GBP,JPY" }
      ]
    },
    {
      "key": "historical_rates",
      "name": "Get rates on a date",
      "method": "GET",
      "endpoint": "/{{ inputs.date }}",
      "query": { "base": "{{ inputs.base }}", "symbols": "{{ inputs.symbols }}" },
      "error_path": "error",
      "inputs": [
        { "key": "date", "label": "Date", "type": "string", "required": true, "placeholder": "2025-01-31" },
        { "key": "base", "label": "Base currency", "type": "string" },
        { "key": "symbols", "label": "Only these currencies", "type": "string" }
      ]
    },
    {
      "key": "convert",
      "name": "Convert currency",
      "method": "GET",
      "endpoint": "/convert",
      "query": { "from": "{{ inputs.from }}", "to": "{{ inputs.to }}", "amount": "{{ inputs.amount }}", "date": "{{ inputs.date }}" },
      "error_path": "error",
      "inputs": [
        { "key": "from", "label": "From", "type": "string", "required": true, "placeholder": "USD" },
        { "key": "to", "label": "To", "type": "string", "required": true, "placeholder": "EUR" },
        { "key": "amount", "label": "Amount", "type": "number", "required": true },
        { "key": "date", "label": "Historical date", "type": "string" }
      ]
    },
    {
      "key": "timeseries",
      "name": "Get rates for a period",
      "method": "GET",
      "endpoint": "/timeseries",
      "query": { "start_date": "{{ inputs.start_date }}", "end_date": "{{ inputs.end_date }}", "base": "{{ inputs.base }}", "symbols": "{{ inputs.symbols }}" },
      "error_path": "error",
      "inputs": [
        { "key": "start_date", "label": "Start date", "type": "string", "required": true },
        { "key": "end_date", "label": "End date", "type": "string", "required": true },
        { "key": "base", "label": "Base currency", "type": "string" },
        { "key": "symbols", "label": "Only these currencies", "type": "string" }
      ]
    },
    {
      "key": "symbols",
      "name": "List currencies",
      "method": "GET",
      "endpoint": "/symbols",
      "error_path": "error",
      "inputs": []
    }
  ]
}
