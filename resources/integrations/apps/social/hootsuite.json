{
  "key": "hootsuite",
  "name": "Hootsuite",
  "category": "Social Media",
  "description": "Schedule messages to your Hootsuite social profiles.",
  "brand": "hootsuite",
  "website": "https://www.hootsuite.com",
  "docs_url": "https://developer.hootsuite.com/docs/using-rest-apis",
  "base_url": "https://platform.hootsuite.com/v1",
  "auth": { "type": "bearer", "fields": [{ "key": "token", "label": "Access token", "type": "password", "required": true,
    "help": "From your Hootsuite app's OAuth flow. In-app OAuth isn't offered because Hootsuite's token endpoint uses Basic auth." }] },
  "actions": [
    {
      "key": "get_me",
      "name": "Get current member",
      "method": "GET",
      "endpoint": "/me",
      "output_path": "data",
      "inputs": []
    },
    {
      "key": "list_social_profiles",
      "name": "List social profiles",
      "method": "GET",
      "endpoint": "/socialProfiles",
      "output_path": "data",
      "inputs": []
    },
    {
      "key": "schedule_message",
      "name": "Schedule message",
      "method": "POST",
      "endpoint": "/messages",
      "body": { "text": "{{ inputs.text }}", "socialProfileIds": "{{ inputs.social_profile_ids }}", "scheduledSendTime": "{{ inputs.scheduled_send_time }}" },
      "output_path": "data",
      "inputs": [
        { "key": "text", "label": "Text", "type": "text", "required": true },
        { "key": "social_profile_ids", "label": "Social profile IDs", "type": "list", "required": true },
        { "key": "scheduled_send_time", "label": "Send at (UTC, ISO 8601 ending in Z)", "type": "string", "placeholder": "2026-03-10T15:00:00Z" }
      ]
    },
    {
      "key": "get_message",
      "name": "Get message",
      "method": "GET",
      "endpoint": "/messages/{{ inputs.message_id }}",
      "output_path": "data",
      "inputs": [{ "key": "message_id", "label": "Message ID", "type": "string", "required": true }]
    }
  ]
}
