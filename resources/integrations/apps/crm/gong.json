{
  "key": "gong",
  "name": "Gong",
  "category": "CRM & Sales",
  "description": "List calls, fetch transcripts and users from Gong.",
  "brand": "gong",
  "website": "https://www.gong.io",
  "docs_url": "https://gong.app.gong.io/settings/api/documentation",
  "base_url": "https://api.gong.io/v2",
  "auth": [
    {
      "type": "basic",
      "fields": [
        {
          "key": "username",
          "label": "Access key",
          "type": "string",
          "required": true
        },
        {
          "key": "password",
          "label": "Access key secret",
          "type": "password",
          "required": true,
          "help": "Company settings > Ecosystem > API."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_calls",
      "name": "List calls",
      "method": "GET",
      "endpoint": "/calls",
      "query": {
        "fromDateTime": "{{ inputs.from }}",
        "toDateTime": "{{ inputs.to }}"
      },
      "output_path": "calls",
      "inputs": [
        {
          "key": "from",
          "label": "From (ISO 8601)",
          "type": "string",
          "required": true,
          "placeholder": "2026-01-01T00:00:00Z"
        },
        {
          "key": "to",
          "label": "To (ISO 8601)",
          "type": "string",
          "placeholder": "2026-01-31T23:59:59Z"
        }
      ]
    },
    {
      "key": "get_call",
      "name": "Get call",
      "method": "GET",
      "endpoint": "/calls/{{ inputs.call_id }}",
      "output_path": "call",
      "inputs": [
        {
          "key": "call_id",
          "label": "Call ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "key": "get_transcripts",
      "name": "Get call transcripts",
      "method": "POST",
      "endpoint": "/calls/transcript",
      "body": {
        "filter": {
          "callIds": "{{ inputs.call_ids }}"
        }
      },
      "output_path": "callTranscripts",
      "inputs": [
        {
          "key": "call_ids",
          "label": "Call IDs",
          "type": "list",
          "required": true
        }
      ]
    },
    {
      "key": "list_users",
      "name": "List users",
      "method": "GET",
      "endpoint": "/users",
      "output_path": "users",
      "inputs": []
    }
  ]
}
