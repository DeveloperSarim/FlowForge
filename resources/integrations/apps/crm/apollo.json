{
  "key": "apollo",
  "name": "Apollo.io",
  "category": "CRM & Sales",
  "description": "Enrich people and companies, and manage Apollo contacts and accounts.",
  "brand": "apollo",
  "website": "https://www.apollo.io",
  "docs_url": "https://docs.apollo.io/reference/authentication",
  "popular": true,
  "base_url": "https://api.apollo.io/api/v1",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "X-Api-Key",
      "fields": [
        {
          "key": "api_key",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Settings > Integrations > API."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "enrich_person",
      "name": "Enrich person",
      "method": "POST",
      "endpoint": "/people/match",
      "query": {
        "email": "{{ inputs.email }}",
        "first_name": "{{ inputs.first_name }}",
        "last_name": "{{ inputs.last_name }}",
        "organization_name": "{{ inputs.organization_name }}",
        "domain": "{{ inputs.domain }}",
        "linkedin_url": "{{ inputs.linkedin_url }}"
      },
      "output_path": "person",
      "inputs": [
        {
          "key": "email",
          "label": "Email",
          "type": "string"
        },
        {
          "key": "first_name",
          "label": "First name",
          "type": "string"
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "organization_name",
          "label": "Company",
          "type": "string"
        },
        {
          "key": "domain",
          "label": "Company domain",
          "type": "string"
        },
        {
          "key": "linkedin_url",
          "label": "LinkedIn URL",
          "type": "string"
        }
      ]
    },
    {
      "key": "enrich_organization",
      "name": "Enrich organization",
      "method": "GET",
      "endpoint": "/organizations/enrich",
      "query": {
        "domain": "{{ inputs.domain }}"
      },
      "output_path": "organization",
      "inputs": [
        {
          "key": "domain",
          "label": "Domain",
          "type": "string",
          "required": true,
          "placeholder": "apollo.io"
        }
      ]
    },
    {
      "key": "create_contact",
      "name": "Create contact",
      "method": "POST",
      "endpoint": "/contacts",
      "query": {
        "first_name": "{{ inputs.first_name }}",
        "last_name": "{{ inputs.last_name }}",
        "email": "{{ inputs.email }}",
        "title": "{{ inputs.title }}",
        "organization_name": "{{ inputs.organization_name }}",
        "website_url": "{{ inputs.website_url }}"
      },
      "output_path": "contact",
      "inputs": [
        {
          "key": "first_name",
          "label": "First name",
          "type": "string"
        },
        {
          "key": "last_name",
          "label": "Last name",
          "type": "string"
        },
        {
          "key": "email",
          "label": "Email",
          "type": "string"
        },
        {
          "key": "title",
          "label": "Title",
          "type": "string"
        },
        {
          "key": "organization_name",
          "label": "Company",
          "type": "string"
        },
        {
          "key": "website_url",
          "label": "Company website",
          "type": "string"
        }
      ]
    },
    {
      "key": "search_contacts",
      "name": "Search contacts",
      "method": "POST",
      "endpoint": "/contacts/search",
      "query": {
        "q_keywords": "{{ inputs.q_keywords }}",
        "per_page": "{{ inputs.per_page }}"
      },
      "output_path": "contacts",
      "inputs": [
        {
          "key": "q_keywords",
          "label": "Keywords",
          "type": "string",
          "required": true,
          "help": "Name, email, title or company."
        },
        {
          "key": "per_page",
          "label": "Results",
          "type": "number",
          "default": 10
        }
      ]
    },
    {
      "key": "create_account",
      "name": "Create account",
      "method": "POST",
      "endpoint": "/accounts",
      "query": {
        "name": "{{ inputs.name }}",
        "domain": "{{ inputs.domain }}"
      },
      "output_path": "account",
      "inputs": [
        {
          "key": "name",
          "label": "Name",
          "type": "string",
          "required": true
        },
        {
          "key": "domain",
          "label": "Domain",
          "type": "string"
        }
      ]
    }
  ]
}
