{
  "key": "paymo",
  "name": "Paymo",
  "category": "Project Management",
  "description": "Create tasks and list projects and clients in Paymo.",
  "brand": "paymo",
  "website": "https://www.paymoapp.com",
  "docs_url": "https://github.com/paymoapp/api",
  "base_url": "https://app.paymoapp.com/api",
  "auth": {
    "type": "basic",
    "fields": [
      {
        "key": "username",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "My account > API keys."
      },
      {
        "key": "password",
        "label": "Password",
        "type": "string",
        "required": true,
        "default": "X",
        "help": "Any text, e.g. X."
      }
    ]
  },
  "actions": [
    {
      "key": "list_projects",
      "name": "List projects",
      "method": "GET",
      "endpoint": "/projects",
      "output_path": "projects",
      "inputs": []
    },
    {
      "key": "create_task",
      "name": "Create task",
      "method": "POST",
      "endpoint": "/tasks",
      "body": {
        "name": "{{ inputs.name }}",
        "project_id": "{{ inputs.project_id }}",
        "tasklist_id": "{{ inputs.tasklist_id }}",
        "description": "{{ inputs.description }}",
        "due_date": "{{ inputs.due_date }}",
        "users": "{{ inputs.users }}"
      },
      "output_path": "tasks.0",
      "inputs": [
        {
          "key": "name",
          "label": "Name",
          "type": "string",
          "required": true
        },
        {
          "key": "project_id",
          "label": "Project ID",
          "type": "number",
          "help": "Give a project or a task list."
        },
        {
          "key": "tasklist_id",
          "label": "Task list ID",
          "type": "number"
        },
        {
          "key": "description",
          "label": "Description",
          "type": "text"
        },
        {
          "key": "due_date",
          "label": "Due date",
          "type": "string",
          "placeholder": "2026-10-12"
        },
        {
          "key": "users",
          "label": "Assignee user IDs",
          "type": "json",
          "placeholder": "[204]"
        }
      ]
    },
    {
      "key": "list_clients",
      "name": "List clients",
      "method": "GET",
      "endpoint": "/clients",
      "output_path": "clients",
      "inputs": []
    }
  ]
}
