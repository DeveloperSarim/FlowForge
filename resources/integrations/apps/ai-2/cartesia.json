{
  "key": "cartesia",
  "name": "Cartesia",
  "category": "AI",
  "description": "Browse Cartesia text-to-speech voices.",
  "brand": "cartesia",
  "website": "https://cartesia.ai",
  "docs_url": "https://docs.cartesia.ai/api-reference",
  "base_url": "https://api.cartesia.ai",
  "headers": {
    "Cartesia-Version": "2026-08-14"
  },
  "auth": {
    "type": "bearer",
    "fields": [
      {
        "key": "token",
        "label": "API key",
        "type": "password",
        "required": true,
        "help": "Starts with sk_car_."
      }
    ]
  },
  "actions": [
    {
      "key": "list_voices",
      "name": "List voices",
      "method": "GET",
      "endpoint": "/voices",
      "query": {
        "q": "{{ inputs.q }}",
        "language": "{{ inputs.language }}",
        "is_owner": "{{ inputs.is_owner }}",
        "limit": "{{ inputs.limit }}"
      },
      "output_path": "data",
      "inputs": [
        {
          "key": "q",
          "label": "Search",
          "type": "string"
        },
        {
          "key": "language",
          "label": "Language",
          "type": "string",
          "placeholder": "en"
        },
        {
          "key": "is_owner",
          "label": "Only my voices",
          "type": "boolean"
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 100
        }
      ]
    },
    {
      "key": "get_voice",
      "name": "Get voice",
      "method": "GET",
      "endpoint": "/voices/{{ inputs.voice_id }}",
      "inputs": [
        {
          "key": "voice_id",
          "label": "Voice ID",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
