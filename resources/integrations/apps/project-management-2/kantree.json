{
  "key": "kantree",
  "name": "Kantree",
  "category": "Project Management",
  "description": "Create Kantree cards, read cards and post comments.",
  "brand": "kantree",
  "website": "https://kantree.io",
  "docs_url": "https://kantree.io/developers",
  "base_url": "{{ credentials.url }}/api/1.0",
  "auth": [
    {
      "type": "api_key",
      "in": "header",
      "name": "X-Api-Key",
      "fields": [
        {
          "key": "url",
          "label": "Kantree URL",
          "type": "string",
          "required": true,
          "default": "https://kantree.io",
          "help": "Enterprise customers use their own domain."
        },
        {
          "key": "api_key",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "Account settings > Developer."
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "get_me",
      "name": "Get current user",
      "method": "GET",
      "endpoint": "/me",
      "inputs": []
    },
    {
      "key": "get_card",
      "name": "Get card",
      "method": "GET",
      "endpoint": "/cards/{{ inputs.card_id }}",
      "inputs": [
        {
          "key": "card_id",
          "label": "Card ID",
          "type": "number",
          "required": true
        }
      ]
    },
    {
      "key": "create_card",
      "name": "Create card",
      "method": "POST",
      "endpoint": "/cards/{{ inputs.parent_id }}/children",
      "body": {
        "title": "{{ inputs.title }}",
        "group_id": "{{ inputs.group_id }}"
      },
      "inputs": [
        {
          "key": "parent_id",
          "label": "Parent card ID",
          "type": "number",
          "required": true,
          "help": "A project's top-level card ID, or any card to add a child."
        },
        {
          "key": "title",
          "label": "Title",
          "type": "string",
          "required": true
        },
        {
          "key": "group_id",
          "label": "Group ID",
          "type": "number"
        }
      ]
    },
    {
      "key": "add_comment",
      "name": "Add comment",
      "method": "POST",
      "endpoint": "/cards/{{ inputs.card_id }}/comments",
      "body": {
        "message": "{{ inputs.message }}"
      },
      "inputs": [
        {
          "key": "card_id",
          "label": "Card ID",
          "type": "number",
          "required": true
        },
        {
          "key": "message",
          "label": "Comment",
          "type": "text",
          "required": true
        }
      ]
    }
  ]
}
